{
  "run": "frontier-14",
  "argv": ["node", "tools/dispatch.mjs",
    "--role", "{role}", "--brief", "{brief}", "--task", "{task}",
    "--label", "{label}", "--run", "{run}", "--covers", "{covers}",
    "--timeout", "{timeout}",
    "--var", "run={run}", "--var", "i={unit}", "--var", "output={artifact}"],
  "concurrency": 5,
  "maxAttempts": 3,
  "reportIntervalMin": 20,
  "pollSec": 30
}
