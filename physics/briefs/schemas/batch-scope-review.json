{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "run": {
      "type": "string"
    },
    "batch": {
      "type": "string"
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "input_sha256": {
      "type": "string",
