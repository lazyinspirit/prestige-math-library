        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "accept",
              "repair",
              "escalate"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "decision",
          "reason"
        ]
      }
