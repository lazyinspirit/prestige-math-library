    },
    "reviewed_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewed_pages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "accept",
        "repair",
        "escalate"
      ]
    },
    "reason": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "prerequisite",
              "scope",
              "outside-batch",
              "uncertainty",
              "local"
