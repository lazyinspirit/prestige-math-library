      {
        "id": "pthm-td-constant-conductivity-neumann-existence",
        "kind": "physics-theorem",
        "domain": "physics",
        "title": "Constant-conductivity heat evolution on an insulated rectangle",
        "reference": "items/pthm-td-constant-conductivity-neumann-existence.md#statement",
        "design_state": "Complete draft carrier authored; scoped checks and independent review remain pending.",
        "dependency_level": 6,
        "deps": [
          "def-td-rectangular-local-equilibrium-fields",
