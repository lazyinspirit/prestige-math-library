      {
        "id": "lem-emg-lorentz-hodge-calculus",
        "kind": "lemma",
        "domain": "mathematics",
        "title": "Lorentzian exterior calculus and Hodge star",
        "reference": "items/lem-emg-lorentz-hodge-calculus.md#Statement",
        "design_state": "Fully authored draft with complete local argument; independent review remains pending.",
        "dependency_level": 1,
        "deps": [
