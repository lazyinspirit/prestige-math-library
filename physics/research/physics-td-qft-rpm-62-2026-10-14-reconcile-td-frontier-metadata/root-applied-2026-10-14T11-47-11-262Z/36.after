    "items": [
      {
        "id": "ex-emgmath-lorentz-star",
        "kind": "example",
        "domain": "mathematics",
        "title": "Lorentz star square and constant two-form",
        "reference": "items/ex-emgmath-lorentz-star.md#Example",
        "design_state": "Fully authored draft with complete local argument; independent review remains pending.",
        "dependency_level": 2,
        "deps": [
          "def-countable-choice",
          "def-exterior-derivative-by-the-invariant-vector-field-formula",
          "def-emg-lorentzian-forms",
          "def-gr-inverse-metric-and-musical-isomorphisms",
          "lem-emg-lorentz-hodge-calculus",
          "prop-differential-forms-form-a-graded-commutative-algebra",
          "thm-local-coordinate-formula-for-the-exterior-derivative"
        ],
        "dependency_roles": {
          "def-countable-choice": "mathematical-premise",
          "def-exterior-derivative-by-the-invariant-vector-field-formula": "mathematical-premise",
          "def-emg-lorentzian-forms": "mathematical-premise",
          "def-gr-inverse-metric-and-musical-isomorphisms": "mathematical-premise",
          "lem-emg-lorentz-hodge-calculus": "mathematical-premise",
          "prop-differential-forms-form-a-graded-commutative-algebra": "mathematical-premise",
          "thm-local-coordinate-formula-for-the-exterior-derivative": "mathematical-premise"
        },
        "inventory_expansion_required": false,
        "statement": "On $\\mathbb R^4$ take the metric $g=\\operatorname{diag}(-1,1,1,1)$, the orientation $dx^0\\wedge dx^1\\wedge dx^2\\wedge dx^3$, and the time-orientation field $N:=\\partial_0$. Then $n:=\\partial_0$ is an observer because $g(n,n)=-1$ and $g(n,N)=-1<0$. For constants $c>0$ and $E_0,B_0\\in\\mathbb R$, let\n\n$$F=-\\frac{E_0}{c}\\,dx^0\\wedge dx^1+B_0\\,dx^2\\wedge dx^3.$$\n\nThis constant two-form has\n\n$$\\star_gF=\\frac{E_0}{c}\\,dx^2\\wedge dx^3+B_0\\,dx^0\\wedge dx^1,\\qquad \\star_g^2F=-F,$$\n\n$$F_{ab}F^{ab}=2(B_0^2-E_0^2/c^2),\\qquad F\\wedge F=-\\frac{2E_0B_0}{c}\\,\\mathrm{vol}_g.$$\n\nThe calculation concerns the mathematical Lorentzian Hodge operator and a smooth two-form. It does not assert that a physical field was measured or that a Maxwell model was adopted.",
        "strategy": "Substitute the constant two-form into the proved Lorentzian star, index-raising, wedge and exterior-derivative formulas.",
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "David Tong, General Relativity, Cambridge Part III lecture notes, sections 2.4.2 and 3.1.3, equations (2.87) and (3.97)-(3.98)",
              "url": "https://www.damtp.cam.ac.uk/user/tong/gr/grhtml/S2.html",
              "locator": "Section 2.4.2, equation (2.87): two-form component convention. The example's Lorentzian star signs are supplied by the local Hodge lemma."
            },
            {
              "title": "H. S. Reall, Part III General Relativity, Cambridge, October 12 2022 revision, sections 8.1 and 8.5, equations (8.1) and (8.55)-(8.56)",
              "url": "https://www.damtp.cam.ac.uk/user/hsr1000/part3_gr_lectures.pdf",
              "locator": "Section 8.1, equation (8.1): wedge normalization; section 8.5, equations (8.55)-(8.56): Hodge star convention and Lorentzian star-square sign."
            }
          ]
        },
        "library": "mathematics",
        "proof_strategy": "direct"
      }
    ]
  }
]
