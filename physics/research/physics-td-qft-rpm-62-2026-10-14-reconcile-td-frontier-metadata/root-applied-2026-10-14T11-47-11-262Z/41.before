          "def-countable-choice": "mathematical-premise",
          "def-orthogonality-and-orthogonal-complement": "mathematical-premise",
          "lem-nrqm-composites-hilbert-tensor-construction": "mathematical-premise",
          "lem-nrqm-composites-permutation-sector-projections": "mathematical-premise"
        },
        "dependency_level": 1,
        "proof_strategy": "direct",
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
        "statement": "For a unit mode e and K=e-perp, symmetric Fock space over H is unitarily the tensor product of one-mode Fock and Fock(K), and the e-creation/annihilation maps become the one-mode ladder maps.",
        "sources": {
          "references": [
            {
              "title": "Jan Dereziński, Mathematical Introduction to Quantum Field Theory, §5.9",
              "url": "https://www.fuw.edu.pl/~derezins/qft-lectures.pdf"
            }
          ]
        }
      },
