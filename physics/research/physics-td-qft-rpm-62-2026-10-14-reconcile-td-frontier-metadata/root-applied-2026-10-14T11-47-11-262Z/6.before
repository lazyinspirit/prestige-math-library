        "dependency_level": 5,
        "inventory_expansion_required": false
      },
      {
        "id": "ex-td-noncompact-entropy-supremum-not-attained",
        "kind": "example",
        "domain": "physics",
        "title": "A concave entropy with no maximum on an open feasible interval",
        "statement": "An admitted two-system isolated compound has positive affine homogeneous entropies and a finite concave total entropy on an open fixed-total-energy partition set, but its supremum is not attained.",
        "deps": [
          "def-euclidean-inner-product",
          "def-td-equilibrium-state-domain",
          "def-td-isolated-compound-feasible-set",
          "def-td-thermal-contact-constraints",
          "lem-finite-set-has-max",
