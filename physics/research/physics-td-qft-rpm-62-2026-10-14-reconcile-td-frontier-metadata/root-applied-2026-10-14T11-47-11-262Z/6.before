        "id": "def-td-reversible-process",
        "kind": "definition",
        "domain": "physics",
        "title": "Reversible thermodynamic process record",
        "statement": "A closed process record is reversible relative to its declared boundary and protocol exactly when an admitted reverse record restores all included auxiliary states and reverses the signed boundary transfers.",
        "deps": [
          "def-td-process-and-protocol"
        ],
        "dependency_roles": {
