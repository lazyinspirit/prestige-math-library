        "id": "lem-qft-finite-mode-occupation-basis",
        "kind": "lemma",
        "domain": "mathematics",
        "library": "mathematics",
        "title": "Finite fermion-mode occupation basis",
        "dependency_level": 2,
        "deps": [
          "def-qft-fock-and-test-spaces",
          "lem-qft-fock-ccr-car",
          "def-countable-choice",
          "lem-nrqm-composites-hilbert-tensor-construction",
          "lem-nrqm-composites-permutation-sector-projections"
        ],
        "dependency_roles": {
          "def-qft-fock-and-test-spaces": "mathematical-premise",
          "lem-qft-fock-ccr-car": "mathematical-premise",
          "def-countable-choice": "mathematical-premise",
          "lem-nrqm-composites-hilbert-tensor-construction": "mathematical-premise",
          "lem-nrqm-composites-permutation-sector-projections": "mathematical-premise"
        },
        "statement": "Assume Countable Choice. Let $\\mathcal K$ be a finite-dimensional complex Hilbert space with a finite ordered orthonormal basis $(e_j)_{j\\in J}$, and use the antisymmetric Fock construction and second-variable-linear convention of [[def-qft-fock-and-test-spaces]]. Assume its fermionic operators satisfy the CAR of [[lem-qft-fock-ccr-car]]. For $S=\\{j_1<\\cdots<j_k\\}\\subseteq J$, set\n$$\\xi_S=c^\\dagger(e_{j_1})\\cdots c^\\dagger(e_{j_k})\\Omega,\\qquad \\xi_\\varnothing=\\Omega.$$\nThen $(\\xi_S)_{S\\subseteq J}$ is an orthonormal basis of $\\mathcal F_a(\\mathcal K)$. For each $j\\in J$, the bounded number operator $N_j=c^\\dagger(e_j)c(e_j)$ is an orthogonal projection and\n$$N_j\\xi_S=\\mathbf1_{j\\in S}\\xi_S.$$\nConsequently, for any partition $J=\\bigsqcup_{x\\in V}J_x$ into finite site-mode sets, $n_x=\\sum_{j\\in J_x}N_j$ is bounded self-adjoint and acts on $\\xi_S$ by the occupation count $N_x(S)=|S\\cap J_x|\\in\\{0,\\ldots,|J_x|\\}$.",
        "strategy": "direct",
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "John B. Kogut, An Introduction to Lattice Gauge Theory and Spin Systems, Reviews of Modern Physics 51 (1979)",
              "url": "https://chimera.roma1.infn.it/ENZO/FC/ESTRATTI/DUALITY/kogut1979.pdf",
              "locator": "Complete 55-page review; relevant Hamiltonian and Gauss-law treatment in §VI.C, printed pp. 694–696. The Rome1 PDF is byte-identical to the previously retrieved full text."
            },
            {
              "title": "Patrick Emonts and Erez Zohar, Gauss Law, Minimal Coupling and Fermionic PEPS for Lattice Gauge Theories, SciPost Physics Lecture Notes 12 (2020)",
              "url": "https://arxiv.org/html/1807.01294",
              "locator": "Full-text arXiv HTML rendition; §§2.1–2.4, printed pp. 3–8. The corresponding complete 32-page PDF was also retrieved and read."
            }
          ]
        },
        "physical_scope": null,
        "reference": "Local A-page prerequisite: prove the finite-mode occupation ONB and site-number spectrum used by the exact Gauss multipliers.",
        "design_state": "Added after dependency audit; complete local conditional proof from the current Fock and CAR interfaces.",
        "inventory_expansion_required": true,
        "proof_strategy": "direct"
