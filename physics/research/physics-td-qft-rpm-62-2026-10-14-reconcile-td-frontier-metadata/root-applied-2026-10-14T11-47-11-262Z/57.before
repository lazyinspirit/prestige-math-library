[
  {
    "order": 547,
    "id": "qft-x02",
    "kind": "A",
    "category": "quantum-field-theory",
    "library": "physics",
    "title": "Formal diagram coefficient-to-observable adoption",
    "companion": "qft-x02-examples",
    "requires": [
      "qft-g02",
      "qft-mx02",
