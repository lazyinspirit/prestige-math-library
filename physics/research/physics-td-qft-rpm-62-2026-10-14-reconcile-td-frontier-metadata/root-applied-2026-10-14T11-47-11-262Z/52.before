    ],
    "items": [
      {
        "id": "def-qft-example-observable-types",
        "kind": "definition",
        "domain": "physics",
        "library": "physics",
        "title": "Example observable types and scoped meanings",
        "statement": "Defines exact finite-regulator observables, finite probability laws, formal coefficient records, source-reported empirical estimates, and formulation-relative primitive/derived status with scoped SI units.",
        "deps": [
          "def-qft-framework-units",
          "def-qft-example-data"
        ],
        "dependency_roles": {
          "def-qft-framework-units": "formulation-prerequisite",
          "def-qft-example-data": "mathematical-premise"
        },
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "David Tong, Quantum Field Theory, §0.1 “Units and Scales”",
              "url": "https://www.damtp.cam.ac.uk/user/tong/qft/qfthtml/S0.html"
            },
            {
              "title": "X. Fan et al., Measurement of the Electron Magnetic Moment, Physical Review Letters 130, 071801 (2023), arXiv:2209.13084v2 (2022)",
              "url": "https://arxiv.org/html/2209.13084"
            }
          ]
        },
        "physical_scope": "Framework-local primitive/derived, unit, observable, formal-coefficient, and empirical-data distinctions for the finite regulated examples and specified formal calculations; no general continuum observable or empirical estimator is constructed.",
        "empirical_premises": [],
        "dependency_level": 1
      },
      {
        "id": "pthm-qft-example-regulated-probability-control",
        "kind": "physics-theorem",
        "domain": "physics",
        "library": "physics",
        "title": "Exact regulated transition probabilities and controlled coefficients",
        "statement": "Under AC_omega, a finite-dimensional Hermitian H0 and norm-continuous Hermitian V(t) have an exact unitary interaction evolution with Dyson tail R_N. For a supplied normalized finite projective measurement and adopted constructed-model Born rule, exact outcome probabilities are controlled by the truncated projected norm squares. The finite model also retains its exact coefficient identities, two-level warning, and occupation-cutoff CCR defect.",
        "deps": [
          "def-qft-example-observable-types",
          "def-qft-framework-units",
          "def-qft-example-data",
          "def-countable-choice",
          "def-qft-finite-bounded-kraus-instrument",
          "lem-qft-finite-instrument-normalization",
          "post-qft-constructed-model-and-measurement",
          "thm-qft-example-finite-dyson-unitarity"
        ],
        "dependency_roles": {
          "def-qft-example-observable-types": "formulation-prerequisite",
          "def-qft-framework-units": "formulation-prerequisite",
          "def-qft-example-data": "mathematical-premise",
          "def-countable-choice": "mathematical-premise",
          "def-qft-finite-bounded-kraus-instrument": "operational-prerequisite",
          "lem-qft-finite-instrument-normalization": "mathematical-premise",
          "post-qft-constructed-model-and-measurement": "physical-assumption",
          "thm-qft-example-finite-dyson-unitarity": "mathematical-premise"
        },
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "David Tong, Quantum Field Theory, Chapter 3 “Interacting Fields,” §3.1.1 “Dyson’s Formula”",
              "url": "https://www.damtp.cam.ac.uk/user/tong/qft/qfthtml/S3.html"
            },
            {
              "title": "M. Srednicki, Quantum Field Theory, author-hosted prepublication draft, §§4 and 7",
              "url": "https://web.physics.ucsb.edu/~mark/ms-qft-DRAFT.pdf"
            },
            {
              "title": "J. Watrous, The Theory of Quantum Information, author-hosted prepublication manuscript, §§2.3.1–2.3.2",
              "url": "https://cs.uwaterloo.ca/~watrous/TQI/TQI.2.pdf"
            },
            {
              "title": "R. B. Griffiths, Notes on Quantum Information Theory, complete §7",
              "url": "https://www.andrew.cmu.edu/course/33-658/qit7.pdf"
            }
          ]
        },
        "physical_scope": "Exact deductions in an explicitly constructed finite-dimensional regulated model with a supplied finite projective measurement and adopted constructed-model Born postulate; no continuum QFT, regulator removal, asymptotic scattering operator, empirical result, or sample-based inference.",
        "empirical_premises": [],
        "dependency_level": 3
      }
    ]
  },
  {
