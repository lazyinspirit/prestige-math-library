    "items": [
      {
        "id": "ex-qft-x01",
        "kind": "example",
        "domain": "physics",
        "library": "physics",
        "title": "Exact two-level transition versus its first coefficient",
        "statement": "At tau=pi hbar/(2g_E) in the exact two-level model, the transition probability is 1 while the first-order squared coefficient is pi^2/4>1; the coefficient square is not a probability.",
        "deps": [
          "pthm-qft-example-regulated-probability-control",
          "def-qft-example-data",
          "def-countable-choice"
        ],
        "dependency_roles": {
          "pthm-qft-example-regulated-probability-control": "physical-result",
          "def-qft-example-data": "mathematical-premise",
          "def-countable-choice": "mathematical-premise"
        },
        "provenance": {
          "statement": "ai-generated",
          "proof": "ai-generated"
        },
        "generation": {
          "role": "example"
        },
        "sources": {
          "references": [
            {
              "title": "David Tong, Quantum Field Theory, Chapter 3 “Interacting Fields,” §3.1.1 “Dyson’s Formula”",
              "url": "https://www.damtp.cam.ac.uk/user/tong/qft/qfthtml/S3.html"
            },
            {
              "title": "M. Srednicki, Quantum Field Theory, author-hosted prepublication draft, §§4 and 7",
              "url": "https://web.physics.ucsb.edu/~mark/ms-qft-DRAFT.pdf"
            }
          ]
        },
        "physical_scope": "One exactly constructed two-level finite Hamiltonian and its explicitly supplied projective measurement; no continuum decay or experimental data.",
        "empirical_premises": [],
        "dependency_level": 4
      },
      {
        "id": "ex-qft-x03",
        "kind": "example",
        "domain": "physics",
        "library": "physics",
        "title": "One-mode time-ordered correlator versus retarded response",
        "statement": "At t=-pi/(2omega) in the exact oscillator mode, the time-ordered correlator is -i/(2omega) and the retarded response is zero; this is a fixed-mode calculation, not a spatial-causality claim.",
        "deps": [
          "post-qft-constructed-model-and-measurement",
