          "proof": "ai-altered"
        },
        "statement": "Let a family of simple domains satisfy [[def-tdmath-forward-sector-hypotheses]], and suppose every pair has an admitted simple thermal join satisfying T1 and T2 of [[def-tdmath-thermal-contact-hypotheses]]. Then the fixed-work orientation signs from [[thm-tdmath-forward-boundary-graph]] agree throughout the family. One common affine proof-coordinate convention $u'=\\varepsilon u$, $\\varepsilon\\in\\{-1,1\\}$, therefore makes each fixed-work accessibility order increase with $u'$ and preserves the energy-sum formula for joins. This is a mathematical coordinate convention; it does not change a physical energy quantity or assert a sign of a measured temperature.",
        "dependency_level": 8
      },
      {
        "id": "lem-tdmath-thermal-class-dichotomy",
        "kind": "lemma",
        "domain": "mathematics",
        "library": "mathematics",
        "physical_scope": null,
        "title": "Thermal classes either fill the domain or split an adiabat",
        "reference": "research/plan-thermodynamics-track.md#L443-L477",
        "design_state": "Draft carrier authored; scoped checks pass; prerequisite readiness is escalated; independent mathematical review pending.",
        "dependency_level": 11,
        "deps": [
          "lem-tdmath-contact-energy-orientation",
          "def-tdmath-forward-sector-hypotheses",
          "def-tdmath-thermal-contact-hypotheses",
          "lem-tdmath-convex-function-local-lipschitz",
          "thm-tdmath-forward-boundary-graph",
          "thm-tdmath-reference-strip-gluing",
          "thm-tdmath-additive-entropy-representation",
