              "url": "https://arxiv.org/html/1807.01294"
            }
          ]
        },
        "library": "mathematics"
      },
      {
        "id": "lem-qft-lattice-physical-evolution",
        "kind": "lemma",
        "domain": "mathematics",
        "title": "Global unitary dynamics in the Gauss sector",
        "reference": "research/extended-frameworks-2026-10-03/quantum-field-theory/workers/qed/proofs.md#Q5; reserved proposed inventory, exact conditional statement authored in items/lem-qft-lattice-physical-evolution.md",
        "design_state": "reserved claim; complete conditional argument authored; Step-1 readiness escalated pending batch-37 carrier",
        "dependency_level": 5,
        "deps": [
          "def-qft-compact-lattice-gauge-data",
          "lem-qft-lattice-gauss-projection",
          "lem-qft-lattice-hamiltonian-selfadjoint",
          "thm-stone-one-parameter-unitary-groups",
          "def-axiom-of-choice"
        ],
        "dependency_roles": {
          "def-qft-compact-lattice-gauge-data": "mathematical-premise",
          "lem-qft-lattice-gauss-projection": "mathematical-premise",
          "lem-qft-lattice-hamiltonian-selfadjoint": "mathematical-premise",
          "thm-stone-one-parameter-unitary-groups": "mathematical-premise",
          "def-axiom-of-choice": "mathematical-premise"
        },
        "inventory_expansion_required": false,
        "statement": "Assume the model data of [[def-qft-compact-lattice-gauge-data]] and the Axiom of Choice. Let $H$ be the self-adjoint Hamiltonian on the exact domain supplied by [[lem-qft-lattice-hamiltonian-selfadjoint]], and let $P$ be the physical projection of [[lem-qft-lattice-gauss-projection]]. For any scalar $\\hbar>0$, the family\n$$\\mathcal U(t)=e^{-itH/\\hbar},\\qquad t\\in\\mathbb R,$$\nis a strongly continuous unitary group on $\\mathcal H_{\\rm kin}$, preserves $D(H)$, and satisfies\n$$\\lim_{h\\to0}\\frac{\\mathcal U(h)\\psi-\\psi}{h}=-\\frac{i}{\\hbar}H\\psi\\quad(\\psi\\in D(H)).$$\nIt commutes with every gauge transformation $U(\\alpha)$ and with $P$. Hence $\\mathcal H_{\\rm phys}=\\operatorname{ran}P$ is a reducing subspace and $\\mathcal U(t)|_{\\mathcal H_{\\rm phys}}$ is a strongly continuous unitary group with skew-adjoint infinitesimal generator $-iH|_{D(H)\\cap\\mathcal H_{\\rm phys}}/\\hbar$; its self-adjoint Stone operator is $-H|_{D(H)\\cap\\mathcal H_{\\rm phys}}/\\hbar$. Equivalently, the restricted physical Hamiltonian $H|_{D(H)\\cap\\mathcal H_{\\rm phys}}$ is self-adjoint. This is an exact fixed-graph result; no continuum dynamics are asserted.\n\n",
        "strategy": "direct",
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
