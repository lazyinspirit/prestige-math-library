            }
          ]
        },
        "library": "mathematics"
      },
      {
        "id": "lem-qft-lattice-local-gauss-flux",
        "kind": "lemma",
        "domain": "mathematics",
        "title": "Region charge equals boundary electric flux",
        "reference": "research/extended-frameworks-2026-10-03/quantum-field-theory/workers/qed/proofs.md#Q5; reserved proposed inventory, exact conditional statement authored in items/lem-qft-lattice-local-gauss-flux.md",
        "design_state": "reserved claim; complete conditional argument authored; Step-1 readiness escalated pending batch-37 carrier",
        "dependency_level": 5,
        "deps": [
          "def-qft-compact-lattice-gauge-data",
          "lem-qft-lattice-gauss-projection"
        ],
        "dependency_roles": {
          "def-qft-compact-lattice-gauge-data": "mathematical-premise",
          "lem-qft-lattice-gauss-projection": "mathematical-premise"
        },
        "inventory_expansion_required": false,
        "statement": "Assume the data of [[def-qft-compact-lattice-gauge-data]] and let $R\\subseteq V$. Define\n$$\\partial R=\\{e\\in E:\\text{exactly one endpoint of }e\\text{ lies in }R\\},$$\nwith $\\epsilon(e,R)=1$ when $s(e)\\in R,t(e)\\notin R$ and $\\epsilon(e,R)=-1$ when $t(e)\\in R,s(e)\\notin R$. On the domain\n$$\\mathcal D_R=\\mathcal H_{\\rm phys}\\cap\\bigcap_{e\\in\\partial R}D(E_e),$$\nthe region number $N_R=\\sum_{x\\in R}(n_x-b_xI)$ obeys the exact identity\n$$N_R\\psi=\\left(\\sum_{e\\in\\partial R}\\epsilon(e,R)E_e\\right)\\psi\\qquad(\\psi\\in\\mathcal D_R).$$\nThus for $R=V$, where $\\partial R=\\varnothing$, every physical vector has total occupation $\\sum_x n_x=\\sum_x b_x$. This finite-graph identity is exact and makes no continuum-limit claim.\n\n",
        "strategy": "direct",
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "John B. Kogut, An Introduction to Lattice Gauge Theory and Spin Systems, Reviews of Modern Physics 51 (1979), §VI.C, printed pp. 694–696",
              "url": "https://chimera.roma1.infn.it/ENZO/FC/ESTRATTI/DUALITY/kogut1979.pdf"
            },
            {
              "title": "Patrick Emonts and Erez Zohar, Gauss Law, Minimal Coupling and Fermionic PEPS for Lattice Gauge Theories, SciPost Physics Lecture Notes 12 (2020), §§2.1–2.4",
