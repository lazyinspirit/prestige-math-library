      {
        "id": "def-qft-dirac-projections",
        "kind": "definition",
        "domain": "mathematics",
        "library": "mathematics",
        "physical_scope": null,
        "title": "Dirac Clifford matrices and energy projections",
        "deps": [
          "def-qft-fock-and-test-spaces",
          "def-countable-choice",
          "def-qft-scalar-mass-shell",
          "def-sr-affine-minkowski-model",
