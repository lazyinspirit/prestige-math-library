      {
        "id": "lem-qft-dirac-projection-matrices",
        "kind": "lemma",
        "domain": "mathematics",
        "library": "mathematics",
        "physical_scope": null,
        "title": "Dirac matrix identities and orthogonal energy projections",
        "deps": [
          "def-qft-dirac-projections",
