      {
        "id": "lem-qft-free-dirac-car-locality",
        "kind": "lemma",
        "domain": "mathematics",
        "library": "mathematics",
        "physical_scope": null,
        "title": "Smeared free Dirac CAR fields and graded locality",
        "deps": [
