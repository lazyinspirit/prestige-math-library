      {
        "id": "thm-rpm-h-first-class-local-reduction",
        "kind": "theorem",
        "domain": "mathematics",
        "title": "Regular first-class constraints admit local symplectic reduction",
        "statement": "Let $(P^{2n},\\omega)$ be symplectic, and let $N=\\{\\chi_1=\\cdots=\\chi_r=0\\}$ be a regular embedded level surface with $\\{\\chi_a,\\chi_b\\}=0$ on $N$. Then $\\ker(\\omega|_N)$ is exactly the rank-$r$ distribution spanned by the restricted Hamiltonian vector fields $X_{\\chi_a}$. This distribution is involutive. Around every point of $N$, its leaves admit smooth Frobenius coordinates $(s^1,\\ldots,s^r,y^1,\\ldots,y^{2n-2r})$, and the local leaf space has a unique smooth closed nondegenerate two-form $\\omega_{\\mathrm{red}}$ whose pullback is $\\omega|_N$. Thus regular first-class constraints yield a local symplectic quotient. No global orbit-space regularity follows from these hypotheses.",
        "deps": [
          "def-countable-choice",
          "def-rpm-h-regular-constraint-system",
          "def-symplectic-form-and-symplectic-manifold",
          "def-symplectic-orthogonal-complement",
          "prop-symplectic-double-orthogonal-and-dimension-identities",
          "thm-frobenius-local-coordinate-theorem",
          "thm-smooth-dependence-of-ode-solutions-on-parameters",
          "thm-rpm-h-canonical-poisson-and-flow"
        ],
