        "dependency_level": 2,
        "proof_strategy": "direct",
        "physical_scope": "Conditional theorem under the explicit almost-regular package; not a universal theorem for singular Lagrangians.",
        "library": "physics"
      },
      {
        "id": "thm-rpm-h-second-class-dirac-bracket",
        "kind": "theorem",
        "domain": "mathematics",
        "title": "Second-class constraints and the Dirac bracket",
        "statement": "Let $(P,\\omega)$ be symplectic and let $\\chi_1,\\ldots,\\chi_{2k}$ be smooth on an open set $U$, with $C_{ab}=\\{\\chi_a,\\chi_b\\}$ invertible at every point of $U$. Write $C^{ab}$ for its inverse and $N=\\{\\chi=0\\}\\cap U$. Then $N$ is an embedded symplectic submanifold, and the bracket\n\n$$\\{F,G\\}_D=\\{F,G\\}-\\{F,\\chi_a\\}C^{ab}\\{\\chi_b,G\\}$$\n\nis the Poisson bracket of the restricted symplectic form on $N$. It is independent of ambient extensions of $F,G$, and every $\\chi_a$ is a Casimir. This is local and assumes invertibility on $U$; it does not cover singular points.",
        "deps": [
          "def-countable-choice",
          "def-rpm-h-regular-constraint-system",
          "def-symplectic-form-and-symplectic-manifold",
          "thm-smooth-functions-form-a-poisson-algebra",
          "thm-a-regular-level-set-is-an-embedded-submanifold"
