      {
        "id": "thm-rpm-h-homogeneous-legendre-degeneracy",
        "kind": "theorem",
        "domain": "mathematics",
        "title": "Positive homogeneity forces Legendre degeneracy",
        "statement": "Let $L(q,v)$ be $C^2$ on a conic open subset of a tangent bundle, and suppose $L(q,av)=aL(q,v)$ for every $a>0$ in its domain. At each nonzero $v$,\n\n$$v^iL_{v^i}=L,\\qquad L_{v^iv^j}v^i=0,\\qquad E_L:=v^iL_{v^i}-L=0.$$\n\nConsequently the velocity Hessian is singular and the fibre derivative cannot be a local diffeomorphism there; a regular Legendre equivalence theorem cannot be applied. These conclusions do not imply that the motion is static or that the Lagrangian has a specified constraint surface.",
        "deps": [
          "def-countable-choice",
          "def-rpm-h-almost-regular-legendre",
          "def-fibre-derivative-and-legendre-transform-of-a-lagrangian"
        ],
        "dependency_roles": {
          "def-countable-choice": "mathematical-premise",
          "def-rpm-h-almost-regular-legendre": "mathematical-premise",
          "def-fibre-derivative-and-legendre-transform-of-a-lagrangian": "mathematical-premise"
        },
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "Sean M. Carroll, Lecture Notes on General Relativity, complete lecture notes (arXiv:gr-qc/9712019v1)",
              "url": "https://arxiv.org/pdf/gr-qc/9712019",
              "locator": "Complete 238-page notes; Chapter 1, printed pp. 25–27, and Chapter 3, printed pp. 68–72; full relevant sections inspected."
            },
            {
              "title": "Henneaux, Teitelboim and Regge, Constrained Hamiltonian Systems, Part 1",
              "url": "https://scholarworks.iu.edu/dspace/bitstreams/0e1d11ee-2741-4da4-83ed-b7cabc0cd7d6/download",
              "locator": "Chapter I, pp. 7–11: singular Lagrangians and primary constraints."
            }
          ]
        },
        "dependency_level": 2,
        "proof_strategy": "direct",
        "physical_scope": "Pure conditional result for smooth positively homogeneous Lagrangians; it does not assert every singular system is almost regular.",
        "library": "physics"
      },
      {
        "id": "thm-rpm-h-local-legendre-and-energy-descent",
        "kind": "theorem",
        "domain": "mathematics",
        "title": "Energy descends through an almost-regular Legendre map",
        "statement": "Let $L(t,q,v)$ be smooth on an open velocity domain and let $\\mathbb FL(t,q,v)=(t,q,L_v)$ be almost regular in the sense that it is a surjective submersion onto a specified embedded image $N$ and every fibre is connected. Define $E_L=v^iL_{v^i}-L$. Then there is a unique smooth function $h:N\\to\\mathbb R$ with $E_L=h\\circ\\mathbb FL$. The assertion is local in the stated domains; no global inverse velocity map is asserted.",
        "deps": [
          "def-countable-choice",
          "def-rpm-h-almost-regular-legendre",
          "def-fibre-derivative-and-legendre-transform-of-a-lagrangian",
          "cor-local-normal-form-for-submersions"
        ],
        "dependency_roles": {
          "def-countable-choice": "mathematical-premise",
