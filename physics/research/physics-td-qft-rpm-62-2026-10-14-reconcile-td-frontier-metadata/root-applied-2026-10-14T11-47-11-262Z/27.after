          "pthm-rpm-inverse-momentum-and-work": "physical-result",
          "def-sr-total-four-momentum-and-invariant-mass": "mathematical-premise"
        },
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "dependency_level": 8,
        "sources": {
