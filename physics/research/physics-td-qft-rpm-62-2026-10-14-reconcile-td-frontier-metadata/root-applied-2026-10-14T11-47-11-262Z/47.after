      {
        "id": "lem-qft-photon-covariance-spectrum",
        "kind": "lemma",
        "domain": "mathematics",
        "library": "mathematics",
        "physical_scope": null,
        "title": "Photon quotient Lorentz representation and positive dynamics",
        "reference": "research/plan-quantum-field-theory-track.md#charged-gauge-data-and-si-natural-conventions",
        "design_state": "Assigned QFT-MG01 research interface authored as a conditional mathematical item with exact hypotheses and a complete local proof.",
        "dependency_level": 3,
        "deps": [
          "def-countable-choice",
