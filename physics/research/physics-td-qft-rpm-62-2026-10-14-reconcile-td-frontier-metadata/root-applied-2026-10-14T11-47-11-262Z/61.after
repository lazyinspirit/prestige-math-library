        "id": "pthm-qft-free-observable-domain-limits",
        "kind": "physics-theorem",
        "domain": "physics",
        "title": "Free observable domains and limits of point notation",
        "reference": "research/extended-frameworks-2026-10-03/quantum-field-theory/proposed-inventory.json#QFT-F04",
        "design_state": "Develops exact operator domains and moments, locality of the selected bounded scalar and even Dirac observable algebras, and the precise limits of Gaussian point-smearing notation. The Born interpretation is conditional on a constructed instrument; point fields and coincident products are not supplied.",
        "dependency_level": 8,
        "deps": [
          "def-qft-framework-units",
          "def-countable-choice",
          "post-qft-free-field-model",
          "post-qft-constructed-model-and-measurement",
