        },
        {
          "id": "ex-nrqm-controlled-dynamics-long-time-rwa-limitation",
          "kind": "example",
          "domain": "mathematics",
          "title": "Long-time RWA limitation",
          "dependency_level": 2,
          "deps": [
            "thm-nrqm-controlled-dynamics-rotating-wave-finite-time-error",
