          "id": "thm-cm-spring-chain-continuum-limit",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Finite-time continuum limit of the cyclic spring chain: uniform $O(a^{3/2})$ nodal and uniform interpolation convergence",
