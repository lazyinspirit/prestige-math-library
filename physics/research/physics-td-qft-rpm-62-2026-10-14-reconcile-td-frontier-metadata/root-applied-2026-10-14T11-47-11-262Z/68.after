          "id": "lem-em-exponential-character-open-set-independence",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "Distinct exponential characters are linearly independent on a nonempty open set, and the real-part grouping rule",
          "reference": "core-conditional-proofs.md#K8; scaffold-added necessary prerequisite (see research/physics-em-sr-40-2026-10-08-batch-34.notes.md)",
          "design_state": "new-local-prerequisite; complete-proof-strategy",
