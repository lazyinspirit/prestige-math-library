        {
          "id": "lem-em-global-retarded-root",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "Global existence, uniqueness and differentiability of the retarded root",
          "reference": "completed-expansion-arguments.md#R1",
          "design_state": "corrected-matching-regularity-and-open-domain-local-proof-route",
          "dependency_level": 0,
          "deps": [
            "lem-test-function-cutoffs-and-euclidean-localization",
