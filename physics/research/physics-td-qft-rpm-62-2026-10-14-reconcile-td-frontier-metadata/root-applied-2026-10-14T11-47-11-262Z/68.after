        {
          "id": "thm-tdmath-monotone-convergence",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Monotone convergence for the measure integral",
          "reference": "research/physics-td-qft-rpm-62-2026-10-14-batch-11.notes.md#item-inventory",
          "design_state": "Complete draft proof recorded; scoped checks and independent review remain pending.",
          "dependency_level": 1,
          "deps": [
            "thm-arithmetic-and-lattice-operations-preserve-measurability",
            "def-complete-ordered-field",
            "def-finite-sum",
            "def-tdmath-measure-integral"
          ],
          "justified_by": [],
          "dependency_roles": {
            "thm-arithmetic-and-lattice-operations-preserve-measurability": "mathematical-premise",
            "def-complete-ordered-field": "mathematical-premise",
            "def-finite-sum": "mathematical-premise",
            "def-tdmath-measure-integral": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "statement": "Let $(X,\\Sigma,\\mu)$ be a measure space and let $f_n:X\\to[0,\\infty]$ be measurable with $f_n\\le f_{n+1}$ and $f_n\\to f$ pointwise. Then $\\int f_n\\,d\\mu\\uparrow\\int f\\,d\\mu$, including infinite values. Also, for measurable $f,g\\ge0$, $\\int(f+g)\\,d\\mu=\\int f\\,d\\mu+\\int g\\,d\\mu$. For every $c\\ge0$, $\\int cf\\,d\\mu=c\\int f\\,d\\mu$; the integral is also linear on real integrable functions.",
          "strategy": "proof_strategy: direct; complete numbered argument is in items/thm-tdmath-monotone-convergence.md and its proof contract.",
          "provenance": {
            "statement": "literature-derived",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "Terence Tao, 245A Notes 3: Integration on Abstract Measure Spaces and the Convergence Theorems, full author-hosted lecture text",
