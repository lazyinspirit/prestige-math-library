                "url": "https://www.uomustansiriyah.edu.iq/media/lectures/9/9_2018_12_07!10_23_44_AM.pdf?download=1"
              }
            ]
          },
          "library": "mathematics",
          "proof_strategy": "direct"
        }
      ],
