        {
          "id": "def-nrqm-magnetic-and-detection-position-and-momentum-operators",
          "kind": "definition",
          "domain": "mathematics",
          "title": "Position and momentum operators on Euclidean L2",
          "reference": "local prerequisite added by this batch (closure of the reserved claims)",
          "design_state": "batch-local prerequisite; complete-conditional-argument",
          "dependency_level": 0,
          "deps": [
            "def-sobolev-space-wkp-and-its-norm",
            "def-weak-derivative-of-a-locally-integrable-function",
            "lem-weak-derivatives-are-unique-almost-everywhere",
            "def-complex-lp-and-euclidean-test-function-conventions",
