      "items": [
        {
          "id": "ex-qft-x01",
          "kind": "example",
          "domain": "physics",
          "library": "physics",
          "title": "Exact two-level transition versus its first coefficient",
          "statement": "Take $\\mathcal H=\\mathbb C^2$, $H_0=0$, $V(t)=g_E\\sigma_x$ with\n$g_E>0$ joules, dimensionless $\\lambda=1$, initial vector $e_1=(1,0)$, and\nthe two-outcome projective measurement $P=|e_2\\rangle\\langle e_2|$,\n$I-P$, where $e_2=(0,1)$. At\n$\\tau=\\pi\\hbar/(2g_E)$ seconds the exact model transition probability is\n$1$, whereas the first-order squared transition coefficient is\n$\\pi^2/4>1$. The latter is a coefficient-derived square, not a probability.\nThis is an exact constructed-model calculation, not a simulated or reported\nexperiment.",
          "deps": [
            "pthm-qft-example-regulated-probability-control",
