          "sources": {
            "references": [
              {
                "title": "D. Tong, Electromagnetism (Cambridge lecture notes, 2006-2007; current author-hosted file electro.pdf), Section 1.1, printed page 5 (PDF page 5), equation (1.2): the Lorentz force law F = q(E + rdot x B) as the declared force on a charge, with the motion then determined by Newton's equation F = m rddot; Section 5.4.1, printed page 115, for the covariant display",
                "url": "https://www.davidtong.org/pdfs/teaching/electromagnetism/electro.pdf"
              },
              {
                "title": "D. Tong, Classical Dynamics (Cambridge lecture notes, January 2015 printing), Section 1.3, printed pages 5-9 (PDF pages 11-15): external forces as declared model contributions and the open-system warning that momentum exchange with an omitted field is not covered by the particle system's pair structure",
                "url": "https://www.davidtong.org/pdfs/teaching/classical-dynamics/clas.pdf"
              },
              {
                "title": "K. K. Likharev, Essential Graduate Physics, Part CM: Classical Mechanics (title page last edited September 1, 2026), Section 1.2, chapter pages 3-4 (PDF pages 7-8): the force law and its parameters as model input, with an external force whose microscopic source is not modelled treated as declared data",
                "url": "https://essentialgraduatephysics.org/Files/CM%20merged.pdf"
