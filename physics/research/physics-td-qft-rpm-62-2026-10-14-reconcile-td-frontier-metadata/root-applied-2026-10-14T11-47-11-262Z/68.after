        {
          "id": "pthm-em-pec-monochromatic-exterior-scattering",
          "kind": "physics-theorem",
          "domain": "physics",
          "title": "Monochromatic scattering by a smooth perfect-electric-conductor obstacle",
          "reference": "exterior-scattering-arguments.md#F5",
          "design_state": "complete-exact-conditional-research-argument",
          "deps": [
            "def-em-monochromatic-source-free-phasors",
            "lem-em-phasor-real-part-calculus-and-equivalence",
