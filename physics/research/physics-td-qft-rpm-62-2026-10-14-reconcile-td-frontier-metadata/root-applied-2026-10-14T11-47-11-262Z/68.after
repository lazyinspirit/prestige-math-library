    {
      "id": "gr-connections-and-free-fall-examples",
      "title": "Connections And Free Fall — Examples",
      "kind": "B",
      "category": "general-relativity",
      "library": "physics",
      "companion": "gr-connections-and-free-fall",
      "requires": [
        "gr-connections-and-free-fall",
