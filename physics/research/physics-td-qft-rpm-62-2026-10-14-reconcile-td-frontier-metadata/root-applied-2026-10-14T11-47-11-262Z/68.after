        {
          "id": "thm-em-waveguide-spectral-completeness",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Spectral completeness of the declared PEC waveguide and cavity classes",
          "reference": "completed-expansion-arguments.md#G1-G3; core-conditional-proofs.md#K10; exterior-scattering-arguments.md#F1-F5",
          "design_state": "complete-exact-declared-branch-conditional-research-argument",
          "dependency_level": 6,
          "deps": [
            "def-axiom-of-choice",
            "def-bounded-c-k-domain-and-boundary-charts",
            "def-ck-euclidean-maps-and-diffeomorphisms",
            "def-countable-choice",
            "def-euclidean-inner-product",
            "lem-em-pec-cavity-eigenfield-boundary-regularity",
