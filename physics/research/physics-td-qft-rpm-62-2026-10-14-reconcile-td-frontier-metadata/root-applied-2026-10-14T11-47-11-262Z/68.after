        {
          "id": "thm-cm-circular-orbit-and-radial-frequency",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Circular orbits of a non-radial central-force trajectory: the critical-point condition and the squared frequency of the linearised radial equation",
          "reference": "mathematical-prerequisites.md#m9",
          "design_state": "completed-local-argument (M9 split into items; new local prerequisites recorded in the batch notes)",
          "dependency_level": 3,
          "deps": [
            "def-cm-central-force-trajectory",
            "thm-cm-central-force-polar-reduction",
