          ],
          "dependency_roles": {
            "def-em-monochromatic-source-free-phasors": "formulation-prerequisite",
            "lem-em-phasor-real-part-calculus-and-equivalence": "mathematical-premise",
            "lem-em-exterior-vector-helmholtz-mixed-boundary-existence": "mathematical-premise",
            "post-em-vacuum-maxwell": "physical-assumption",
