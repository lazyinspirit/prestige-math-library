          "id": "ex-cm-transport-of-a-translating-uniform-flow",
          "kind": "example",
          "domain": "mathematics",
          "title": "Transport of a translating rigid region: the rate integral vanishes for a travelling profile",
          "reference": "batch-8 B page; constructed from the A-page statements",
          "design_state": "completed-local-example; recorded in the batch notes",
          "dependency_level": 3,
