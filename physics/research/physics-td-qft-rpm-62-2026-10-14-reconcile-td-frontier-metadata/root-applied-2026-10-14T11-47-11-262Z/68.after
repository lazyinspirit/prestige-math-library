            "references": [
              {
                "title": "B. Zwiebach, MIT 8.05 Quantum Physics II (Fall 2013), Chapter 6 'Quantum Dynamics', Sections 3.1-3.2, printed pages 18-22 (Heisenberg operators, their properties, and the Heisenberg equation of motion)",
                "url": "https://ocw.mit.edu/courses/8-05-quantum-physics-ii-fall-2013/79a8091ef4f18d8e3ff76a097e8db33c_MIT8_05F13_Chap_06.pdf"
