          "dependency_level": 7,
          "sources": {
            "references": [
              {
                "title": "G. Teschl, Mathematical Methods in Quantum Mechanics, 1st edition 2009, Section 2.1 and Chapter 3, printed pages 55-58 and 87-100 (observables as self-adjoint operators, their spectral measures and expectation values)",
                "url": "https://www.mat.univie.ac.at/~gerald/ftp/book-schroe/schroe.pdf"
