        {
          "id": "pthm-em-motional-emf",
          "kind": "physics-theorem",
          "domain": "physics",
          "title": "Moving-loop electromotive force equals the negative flux derivative",
          "reference": "core-conditional-proofs.md#K6",
          "design_state": "complete-exact-conditional-research-argument",
          "deps": [
            "def-em-moving-circuit-geometry",
