        {
          "id": "lem-nrqm-composites-marker-overlap-contraction",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "Marker overlap contraction of the two-path cross term",
          "reference": "inventory.json#nrqm-composites-marker-overlap-contraction; proof module M27 (scaffold/mathematical-prerequisites.md)",
          "design_state": "reserved-local-prerequisite; complete-conditional-argument",
          "dependency_level": 3,
          "deps": [
            "lem-complex-lp-completeness-density-and-inner-product",
