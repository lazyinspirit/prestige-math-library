        {
          "id": "thm-cm-burgers-riemann-shock-and-rarefaction",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Riemann shock and rarefaction waves for $u_t+(u^2/2)_x=0$ are weak solutions, and the shock is an entropy solution",
