        {
          "id": "ex-td-infinite-mode-trace-divergence",
          "kind": "example",
          "domain": "physics",
          "title": "Identical bosonic modes do not have a finite infinite-mode Gibbs trace",
          "reference": "items/ex-td-infinite-mode-trace-divergence.md#example",
          "design_state": "Complete draft carrier authored; scoped checks and prerequisite acceptance remain pending.",
          "dependency_level": 8,
          "deps": [
