        {
          "id": "lem-em-point-retarded-potential-and-fields",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "Retarded Liénard-Wiechert potentials and fields of a uniformly subluminal smooth point source",
          "reference": "completed-expansion-arguments.md#R2",
