          "aliases": [
            "nrqm-controlled-dynamics-rotating-wave-finite-time-error"
          ],
          "provenance": {
            "statement": "ai-altered",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "R. Fitzpatrick, Quantum Mechanics (University of Texas at Austin, author-hosted course text), Spin Magnetic Resonance pp. 178-180 and Harmonic Perturbations pp. 181-183 (rotating-wave approximation and its finite-time validity)",
                "url": "https://farside.ph.utexas.edu/teaching/qmech/qmech.pdf"
              },
              {
                "title": "G. Teschl, Mathematical Methods in Quantum Mechanics, 1st edition 2009, Chapter 5 pp. 123-131 (unitary propagators for bounded norm-continuous generators)",
                "url": "https://www.mat.univie.ac.at/~gerald/ftp/book-schroe/schroe.pdf"
              }
            ]
          },
          "statement": "Assume the Axiom of Countable Choice ([[def-countable-choice]]). Let $H$ be a\ncomplex Hilbert space, let $A=A^*\\in\\mathcal B(H)$ and $B\\in\\mathcal B(H)$ with\n$\\omega\\in\\mathbb R\\setminus\\{0\\}$, and put (units $\\hbar=1$)\n$$H(t):=A+e^{i\\omega t}B+e^{-i\\omega t}B^*,\\qquad H_{\\mathrm{avg}}:=A .$$\nLet $U(t,s)$ and $U_{\\mathrm{avg}}(t,s)$ be the unitary propagators of\n[[thm-nrqm-controlled-dynamics-norm-dyson-series-and-uniqueness]]. Then for all\n$s\\le t$:\n$$\\bigl\\|U(t,s)-U_{\\mathrm{avg}}(t,s)\\bigr\\|\\le\\frac{4\\|B\\|}{|\\omega|} \\Bigl[1+(t-s)\\bigl(\\|A\\|+2\\|B\\|\\bigr)\\Bigr].$$\nWith $\\hbar$ restored, replace $A,B$ by $A/\\hbar,B/\\hbar$, i.e.\n$\\|U(t,s)-U_{\\mathrm{avg}}(t,s)\\|\\le\\frac{4\\|B\\|}{\\hbar|\\omega|}[1+\\frac{t-s}{\\hbar}(\\|A\\|+2\\|B\\|)]$.\n\nThe bound is linear in $t-s$; it makes no uniform-in-time claim and no claim\nabout resonance, decay or an unbounded dipole coupling.",
          "strategy": "Complete conditional argument authored on this page; see the item body for the numbered steps.",
          "inventory_expansion_required": false,
          "reference": "reserved claim of the qm-math-controlled-dynamics design reservation; complete-conditional-argument",
          "design_state": "reserved-closure; complete-conditional-argument"
        },
        {
          "id": "thm-nrqm-controlled-dynamics-simple-level-reduced-resolvent-coefficients",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Simple-level reduced-resolvent coefficients",
          "dependency_level": 3,
          "deps": [
            "lem-nrqm-controlled-dynamics-cc-arbitrary-hilbert-spectral-calculus",
            "thm-nrqm-controlled-dynamics-contour-perturbation-projection",
            "def-projection-valued-measure",
            "def-resolvent-and-spectrum-of-a-closed-unbounded-operator",
