      "items": [
        {
          "id": "cex-rpm-h-instantaneous-potential-free-boost",
          "kind": "counterexample",
          "domain": "mathematics",
          "title": "Free boost plus instantaneous relativistic pair potential violates the charge algebra",
          "statement": "Let $\\mathcal P=(T^*\\mathbb R)^2\\cong\\mathbb R^4$ have coordinates $(q_1,p_1,q_2,p_2)$, symplectic form $\\omega=\\sum_{a=1}^2dq_a\\wedge dp_a$, and canonical bracket $\\{F,G\\}=\\sum_{a=1}^2(F_{q_a}G_{p_a}-F_{p_a}G_{q_a})$. Let $q_a$ be one-dimensional positions in metres, $p_a$ momenta in kg m/s, $t$ an external equal-time parameter in seconds, $m_a>0$ in kg, and $c>0$ in m/s. For $k>0$ in kg/s$^2$ define $E_a(p_a)=\\sqrt{m_a^2c^4+c^2p_a^2}$, $V(r)=kr^2/2$ with $r=q_1-q_2$, $H=E_1+E_2+V(r)$, $P=p_1+p_2$, and $K=(q_1E_1+q_2E_2)/c^2-tP$. The proposed assertion that this Hamiltonian and unchanged free boost satisfy $\\{K,P\\}=H/c^2$ at every configuration is false.",
          "deps": [
            "thm-rpm-h-poincare-moment-map-and-algebra",
            "def-rpm-h-poincare-charge-space",
            "def-countable-choice"
          ],
