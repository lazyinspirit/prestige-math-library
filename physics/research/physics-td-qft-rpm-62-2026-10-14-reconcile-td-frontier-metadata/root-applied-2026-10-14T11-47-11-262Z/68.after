            "references": [
              {
                "title": "G. Teschl, Mathematical Methods in Quantum Mechanics, 1st edition 2009, Theorem 7.8, printed page 168 (the free Schrödinger operator and its domain), and Section 10.1, printed pages 221-222 (the weak Laplacian of the hydrogen Hamiltonian)",
                "url": "https://www.mat.univie.ac.at/~gerald/ftp/book-schroe/schroe.pdf"
              },
              {
                "title": "D. Tong, Quantum Mechanics (author-hosted lecture set), Section 4.2, printed pages 104-105 (the three-dimensional Schrödinger equation with a central potential and its spherical Laplacian)",
                "url": "https://davidtong.org/pdfs/teaching/quantum-mechanics/qm.pdf"
