    {
      "id": "emg-mg01",
      "title": "Oriented Lorentzian fields, observers and coordinate conventions",
      "category": "einstein-maxwell-models-mathematics",
      "library": "mathematics",
      "companion": "emg-mg01-examples",
      "kind": "A",
      "requires": [
