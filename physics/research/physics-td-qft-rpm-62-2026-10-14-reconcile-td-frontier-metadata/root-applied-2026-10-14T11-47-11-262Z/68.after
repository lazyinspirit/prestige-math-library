                "url": "https://www.mat.univie.ac.at/~gerald/ftp/book-schroe/schroe.pdf"
              },
              {
                "title": "Haim Brezis, Functional Analysis, Sobolev Spaces and Partial Differential Equations (Springer Universitext 2011), Section 8.1-8.2 pp. 201-210 (one-dimensional and Euclidean weak derivatives and Sobolev spaces)",
                "url": "https://www.math.toronto.edu/almut/Brezis.pdf"
              }
            ]
          },
          "aliases": [
            "nrqm-magnetic-and-detection-position-and-momentum-operators"
          ]
        },
        {
          "id": "lem-nrqm-magnetic-and-detection-weak-product-rule",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "Weak product rule for a bounded coefficient with bounded weak derivative",
          "reference": "local prerequisite added by this batch (closure of the reserved claims)",
          "design_state": "batch-local prerequisite; complete-conditional-argument",
          "dependency_level": 0,
          "deps": [
            "def-sobolev-space-wkp-and-its-norm",
