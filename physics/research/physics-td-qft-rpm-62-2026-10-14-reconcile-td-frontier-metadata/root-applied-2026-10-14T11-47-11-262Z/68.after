          "id": "def-cm-scalar-conservation-law-weak-and-entropy-solution",
          "kind": "definition",
          "domain": "mathematics",
          "title": "Weak and entropy solutions of the scalar conservation law $u_t+(u^2/2)_x=0$",
          "reference": "expansion-proofs.md#e23",
          "design_state": "completed-local-definition; recorded in the batch notes",
          "dependency_level": 0,
          "deps": [
