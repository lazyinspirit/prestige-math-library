    {
      "id": "em-waveguides-and-cavities-examples",
      "title": "Waveguides and cavities — Examples",
      "kind": "B",
      "category": "classical-electromagnetism",
      "library": "physics",
      "companion": "em-waveguides-and-cavities",
      "requires": [
        "em-waveguides-and-cavities",
