          "title": "Charged expectation vanishes by gauge averaging",
          "reference": "research/extended-frameworks-2026-10-03/quantum-field-theory/workers/qed/proofs.md#Q6; reserved proposed inventory, exact conditional statement authored in items/ex-qft-qed-ward-selection.md",
          "design_state": "reserved claim; complete conditional argument authored; Step-1 readiness escalated pending batch-37 carrier",
          "dependency_level": 7,
          "deps": [
            "lem-qft-lattice-ward-identities",
            "def-axiom-of-choice"
          ],
          "dependency_roles": {
            "lem-qft-lattice-ward-identities": "mathematical-premise",
            "def-axiom-of-choice": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "statement": "Take a two-vertex graph with one link $e:v_1\\to v_2$, one fermion mode per vertex and zero backgrounds. The zero-electric, zero-occupation vector $\\Omega$ is physical. The bounded creation operator $O=c^\\dagger_{v_1,1}$ has nonzero gauge charge at $v_1$, so its expectation in any physical vector, including $\\Omega$, vanishes.",
          "strategy": "direct",
          "provenance": {
            "statement": "ai-generated",
            "proof": "ai-generated"
          },
          "sources": {
            "references": [
