        {
          "id": "ex-cm-balances-continuation-boundary-checks",
          "kind": "example",
          "domain": "mathematics",
          "title": "Breakdown versus trapping: the blow-up of $x'=x^2$ and the global trapped solution of $x'=-x^2$",
