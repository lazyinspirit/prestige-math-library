          "sources": {
            "references": [
              {
                "title": "D. Tong, Quantum Mechanics (author-hosted lecture set), Section 1.1 and Section 3.3.1, printed pages 3-5 and 79-81 (Born position density and expectation formulas; the power-tail construction and its moment estimates are supplied locally in this example)",
                "url": "https://davidtong.org/pdfs/teaching/quantum-mechanics/qm.pdf"
