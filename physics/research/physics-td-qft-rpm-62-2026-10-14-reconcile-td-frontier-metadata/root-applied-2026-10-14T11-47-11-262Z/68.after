            "def-divergence-and-curl-of-a-c1-vector-field": "mathematical-premise",
            "def-cross-product-in-r3": "mathematical-premise",
            "def-euclidean-inner-product": "mathematical-premise",
            "def-ck-euclidean-maps-and-diffeomorphisms": "mathematical-premise",
            "thm-algebra-of-derivatives": "mathematical-premise",
            "thm-chain-rule-for-total-derivatives": "mathematical-premise",
            "def-countable-choice": "mathematical-premise",
            "lem-cross-product-is-bilinear-alternating-and-orthogonal": "mathematical-premise",
            "thm-clairaut-schwarz-mixed-partials": "mathematical-premise",
            "def-surface-area-and-scalar-surface-integral-of-a-patch": "mathematical-premise",
            "thm-surface-area-density-is-cross-product-norm": "mathematical-premise",
            "lem-rigidity-of-alternating-multilinear-matrix-functions": "mathematical-premise",
            "def-multilinear-alternating-normalized-and-antisymmetric-matrix-functions": "mathematical-premise"
          },
          "dependency_level": 1,
          "statement": "Assume the Axiom of Countable Choice ($\\mathrm{AC}_\\omega$). In the setting of [[def-em-moving-patch]], let $B$ be a $C^1$ field on a neighbourhood of the swept surface with $\\operatorname{div}B=0$. Then $\\Phi$ is differentiable on $I$ and $$\\Phi'(t)=\\int_{S(t)}\\partial_tB\\cdot n\\,dS-\\oint_{\\partial S(t)}(v\\times B)\\cdot d\\mathbf r,$$ the boundary integral using the induced orientation. Without the hypothesis $\\operatorname{div}B=0$ the additional term $\\int_{S(t)}(v\\cdot n)\\,\\operatorname{div}B\\,dS$ appears.",
          "strategy": "Differentiate the parametrized flux with the parameter lemma; the area derivative contributes $\\partial_uv\\times r_v+r_u\\times\\partial_vv$, and collecting terms gives $[\\partial_tB+(v\\cdot\\nabla)B+B\\operatorname{div}v-(B\\cdot\\nabla)v]\\cdot(r_u\\times r_v)$. The published cross-product identity turns this into $[\\partial_tB+v\\operatorname{div}B-\\operatorname{curl}(v\\times B)]\\cdot(r_u\\times r_v)$, and patch Stokes converts the curl term into the boundary circulation. The $C^2$ hypothesis lets mixed derivatives commute. Lorentz-force interpretation is a separate physical premise.",
          "provenance": {
            "statement": "ai-altered",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "I. Galili, D. Kaplan, Y. Lehavi, Teaching Faraday's law of electromagnetic induction in an introductory physics course, Am. J. Phys. 74, 337 (2006), Appendix",
                "url": "http://materias.df.uba.ar/f3Aa2013c1/files/2012/07/FaradayLaw-AJP000337.pdf"
              },
              {
                "title": "J. Feldman, A. Rechnitzer, E. Yeager, CLP-4 Vector Calculus (UBC), §4.4 (Theorem 4.4.1)",
                "url": "https://personal.math.ubc.ca/~CLP/CLP4/clp_4_vc/sec_StokesThm.html"
              }
            ]
          }
        },
        {
          "id": "lem-em-period-average",
          "kind": "lemma",
          "title": "Period averages of products of real parts of complex exponentials",
          "domain": "mathematics",
          "deps": [
            "def-em-complex-plane-wave",
            "def-complex-exponential",
            "def-complex-conjugate-real-imaginary-part-and-modulus",
            "def-complex-numbers-and-arithmetic",
            "thm-complex-numbers-form-a-field",
            "thm-complex-exponential-is-entire-with-derivative-itself",
            "thm-complex-exponential-addition-and-real-extension",
            "cor-complex-exponential-cartesian-form-modulus-and-eulers-identity",
            "lem-complex-conjugation-and-modulus-laws",
            "thm-kernel-and-fibres-of-complex-exponential",
            "thm-newton-leibniz-with-interior-derivative",
            "thm-algebra-of-derivatives",
            "thm-chain-rule-for-total-derivatives",
            "def-cross-product-in-r3",
            "def-euclidean-inner-product"
          ],
          "dependency_roles": {
            "def-em-complex-plane-wave": "mathematical-premise",
            "def-complex-exponential": "mathematical-premise",
            "def-complex-conjugate-real-imaginary-part-and-modulus": "mathematical-premise",
            "def-complex-numbers-and-arithmetic": "mathematical-premise",
            "thm-complex-numbers-form-a-field": "mathematical-premise",
            "thm-complex-exponential-is-entire-with-derivative-itself": "mathematical-premise",
            "thm-complex-exponential-addition-and-real-extension": "mathematical-premise",
            "cor-complex-exponential-cartesian-form-modulus-and-eulers-identity": "mathematical-premise",
            "lem-complex-conjugation-and-modulus-laws": "mathematical-premise",
            "thm-kernel-and-fibres-of-complex-exponential": "mathematical-premise",
            "thm-newton-leibniz-with-interior-derivative": "mathematical-premise",
            "thm-algebra-of-derivatives": "mathematical-premise",
            "thm-chain-rule-for-total-derivatives": "mathematical-premise",
            "def-cross-product-in-r3": "mathematical-premise",
            "def-euclidean-inner-product": "mathematical-premise"
          },
          "dependency_level": 1,
          "statement": "Let $\\omega>0$, $T=2\\pi/\\omega$, and let $a,d\\in\\mathbb C$ (or $a,d\\in\\mathbb C^3$, componentwise). Then $$\\frac1T\\int_0^T\\operatorname{Re}(ae^{-i\\omega t})\\operatorname{Re}(de^{-i\\omega t})\\,dt=\\frac12\\operatorname{Re}(a\\overline d),$$ and the dot-product and cross-product versions hold componentwise. Real quadratic expressions may not be replaced by complex quadratic expressions without conjugation.",
          "strategy": "Write $\\operatorname{Re}(z)=(z+\\overline z)/2$; the product is one constant term $\\frac14(a\\overline d+\\overline ad)$ plus oscillatory terms $e^{\\pm2i\\omega t}$, which integrate to zero over a full period by the fundamental theorem applied to $e^{\\pm2i\\omega t}/(\\pm2i\\omega)$.",
          "provenance": {
            "statement": "ai-altered",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "Review of Phasor Notation (course notes, University of San Diego), Complex Vectors and Time Harmonic Representation; Amplitude, Time Average, Mean Square",
                "url": "https://home.sandiego.edu/~ekim/e171f00/lectures/phasors"
              },
              {
                "title": "J. Lebl, Basic Analysis II, §9.1 (Leibniz integral rule), Theorem 9.1.1",
                "url": "https://www.jirka.org/ra/realanal2.pdf"
              }
            ]
          }
        },
        {
          "id": "lem-em-interface-wave-linear-system",
          "kind": "lemma",
          "title": "The two-equation interface system at normal incidence",
          "domain": "mathematics",
          "deps": [
            "lem-em-period-average",
            "def-complex-conjugate-real-imaginary-part-and-modulus",
            "def-complex-numbers-and-arithmetic",
            "thm-complex-numbers-form-a-field",
            "thm-of-square-roots",
            "def-complete-ordered-field"
          ],
          "dependency_roles": {
            "lem-em-period-average": "mathematical-premise",
            "def-complex-conjugate-real-imaginary-part-and-modulus": "mathematical-premise",
            "def-complex-numbers-and-arithmetic": "mathematical-premise",
            "thm-complex-numbers-form-a-field": "mathematical-premise",
            "thm-of-square-roots": "mathematical-premise",
            "def-complete-ordered-field": "mathematical-premise"
          },
          "dependency_level": 2,
          "statement": "Let $\\varepsilon_j,\\mu_j>0$, put $Z_j:=\\sqrt{\\mu_j/\\varepsilon_j}$ for $j=1,2$, and let $E_i,E_r,E_t\\in\\mathbb C$ with $E_i\\ne0$ satisfy the two linear equations $$E_i+E_r=E_t,\\qquad \\frac{E_i-E_r}{Z_1}=\\frac{E_t}{Z_2}.$$ Then $E_r/E_i=(Z_2-Z_1)/(Z_2+Z_1)$, $E_t/E_i=2Z_2/(Z_1+Z_2)$, and $R:=\\lvert E_r/E_i\\rvert^2$, $T:=(Z_1/Z_2)\\lvert E_t/E_i\\rvert^2$ satisfy $R+T=1$. The two equations are assumed, not derived; oblique incidence, complex impedance and anisotropy require further systems and branch conventions.",
          "strategy": "Solve the $2\\times2$ system by substitution; its determinant is $Z_1+Z_2>0$. For $R+T=1$, substitute the ratios and use $(Z_2-Z_1)^2+4Z_1Z_2=(Z_1+Z_2)^2$. No electromagnetic validity is asserted.",
          "provenance": {
            "statement": "ai-altered",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "R. Fitzpatrick, Electromagnetism lecture notes (UT Austin), Reflection at a dielectric boundary, Eqs. (1210)-(1232)",
                "url": "https://farside.ph.utexas.edu/teaching/em/lectures/node104.html"
              }
            ]
          }
        }
      ],
