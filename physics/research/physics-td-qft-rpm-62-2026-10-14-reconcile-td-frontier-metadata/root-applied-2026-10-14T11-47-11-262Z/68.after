          "id": "thm-tdmath-ornstein-uhlenbeck-model",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Ornstein–Uhlenbeck equation, transition law, and fluctuations",
          "reference": "items/thm-tdmath-ornstein-uhlenbeck-model.md#statement",
          "design_state": "Complete draft carrier authored; scoped checks and independent review remain pending.",
          "dependency_level": 1,
          "deps": [
