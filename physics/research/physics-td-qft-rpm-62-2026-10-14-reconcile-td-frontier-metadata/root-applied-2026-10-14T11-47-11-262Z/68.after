          "id": "ex-qft-x06",
          "kind": "example",
          "domain": "physics",
          "library": "physics",
          "title": "One-charge soft photon count example",
          "statement": "Use the one-charge prescribed current of\n[[pthm-qft-example-soft-coherent-counts]] with final velocity\n$v=\\tfrac12$ along $\\hat{\\mathbf z}$. Choose any upper photon-energy cutoff\n$\\Lambda>0$ in joules and set $\\lambda=\\Lambda/\\mathrm e$, where $\\mathrm e$\nis Euler's number. The angular coefficient is\n$$C=\\frac{\\alpha}{\\pi}(2\\log 3-2)>0.$$\nThe exact cutoff coherent state therefore has mean photon count $C$, vacuum\nprobability $e^{-C}$, and mean photon energy\n$C\\Lambda(1-\\mathrm e^{-1})$ joules. Each halving of $\\lambda$ increases the\nmean count by $C\\log 2$; the mean energy remains bounded and tends to\n$C\\Lambda$ as $\\lambda\\downarrow0$. These are model predictions for the\nprepared free state.",
          "deps": [
            "def-countable-choice",
            "def-qft-example-data",
            "pthm-qft-example-soft-coherent-counts"
          ],
          "dependency_roles": {
            "def-countable-choice": "mathematical-premise",
            "def-qft-example-data": "mathematical-premise",
            "pthm-qft-example-soft-coherent-counts": "physical-result"
          },
          "provenance": {
            "statement": "ai-generated",
            "proof": "ai-generated"
          },
          "dependency_level": 9,
          "physical_scope": "An exact numerical specialization of the prescribed-current positive free coherent-state model and finite-cutoff photon-count prediction. It describes a prepared model state, not an observed or simulated emission event.",
          "empirical_premises": [],
          "generation": {
            "role": "example"
          },
          "proof_strategy": "direct"
        },
        {
          "id": "exp-qft-fan-electron-moment-2022",
          "kind": "experiment",
          "domain": "physics",
          "library": "physics",
          "title": "Fan2022 reported electron magnetic-moment determination",
          "statement": "The authors report the weighted average of eleven cavity-corrected\ndeterminations:\n$$-\\frac{\\mu}{\\mu_B}=\\frac{g}{2}=1.00115965218059(13).$$\nThey state that the parenthetical digits give a $1\\sigma$ uncertainty of\n$1.3\\times10^{-13}$ in this dimensionless ratio. The reported consistency\nacross the eleven field settings is a source observation; this item does not\nturn it into a proof of QED or of the apparatus model.",
          "deps": [
            "def-qft-example-observable-types",
            "lem-qft-example-penning-frequency-invariant"
          ],
          "dependency_roles": {
            "def-qft-example-observable-types": "formulation-prerequisite",
            "lem-qft-example-penning-frequency-invariant": "operational-prerequisite"
          },
          "provenance": {
            "statement": "literature-derived",
            "proof": "not-applicable"
          },
          "sources": {
            "references": [
              {
                "title": "X. Fan et al., Measurement of the Electron Magnetic Moment, Physical Review Letters 130, 071801 (2023), arXiv:2209.13084v2 (2022)",
                "url": "https://arxiv.org/html/2209.13084"
              }
            ]
          },
          "dependency_level": 2,
          "physical_scope": "The source-reported 2022 one-electron cryogenic Penning-trap determination, including alternating quantum-jump trials, fitted and corrected frequencies, eleven weighted field determinations, and cavity and broadening analysis. The raw trials, covariance matrix, and weights are not reconstructed here.",
          "empirical_premises": []
        },
        {
          "id": "pthm-qft-reported-electron-anomaly-shift",
          "kind": "physics-theorem",
          "domain": "physics",
          "library": "physics",
          "title": "Qualified reported anomaly by exact affine subtraction",
          "statement": "Let the source-reported dimensionless ratio be denoted\n$\\widehat{g_s/2}:=-\\widehat\\mu/\\mu_B$, where $\\mu_B=e\\hbar/(2m)$ is the\nBohr magneton and the hat marks an empirical estimate, not an exact constant.\nDefine the derived dimensionless anomaly estimate\n$\\widehat a_e:=\\widehat{g_s/2}-1$. Under the empirical premise from\n[[exp-qft-fan-electron-moment-2022]], whose reported central value is\n$\\widehat{g_s/2}=1.00115965218059$, exact subtraction gives\n$$\\widehat a_e=0.00115965218059.$$\nThe source-stated $1\\sigma$ uncertainty remains $1.3\\times10^{-13}$, and all\napparatus, correction, weighting, correlation, and source-data qualifications\nof the experiment remain in force. This is only an affine transformation of a\nreported estimate; it supplies no comparison with a theoretical prediction.",
          "deps": [
            "exp-qft-fan-electron-moment-2022"
          ],
          "dependency_roles": {
            "exp-qft-fan-electron-moment-2022": "empirical-premise"
