            "thm-tdmath-monotone-convergence"
          ],
          "justified_by": [],
          "dependency_roles": {
            "thm-complex-plane-is-complete": "mathematical-premise",
            "thm-arithmetic-and-lattice-operations-preserve-measurability": "mathematical-premise",
            "thm-composition-with-borel-functions-preserves-measurability": "mathematical-premise",
            "thm-sequential-suprema-infima-limsup-liminf-and-pointwise-limits-are-measurable": "mathematical-premise",
            "def-tdmath-measure-integral": "mathematical-premise",
            "lem-tdmath-fatou": "mathematical-premise",
            "thm-tdmath-monotone-convergence": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "statement": "Let $(X,\\Sigma,\\mu)$ be a measure space and let $f_n:X\\to\\mathbb C$ be measurable with $f_n\\to f$ almost everywhere. Suppose $g\\ge0$ is measurable and $\\int g\\,d\\mu<\\infty$, and $|f_n|\\le g$ almost everywhere for every $n$. Let $f_0(x)$ be the finite complex pointwise limit of $(f_n(x))$ where it exists, and $0$ elsewhere. Then $f_0$ is measurable, equals $f$ almost everywhere, is integrable, and $\\int f_n\\,d\\mu\\to\\int f_0\\,d\\mu$ and $\\int|f_n-f_0|\\,d\\mu\\to0$. If the specified $f$ is measurable, these same conclusions hold with $f$ in place of $f_0$. In particular this is automatic when $\\mu$ is complete. On a noncomplete measure space an arbitrary almost-everywhere representative need not be measurable, so no integral of such a nonmeasurable $f$ is asserted.",
          "strategy": "proof_strategy: direct; complete numbered argument is in items/thm-tdmath-dominated-convergence.md and its proof contract.",
          "provenance": {
            "statement": "ai-altered",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
