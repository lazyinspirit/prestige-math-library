          "dependency_level": 22
        },
        {
          "id": "rem-em-radiation-reaction-limits",
          "kind": "remark",
          "domain": "physics",
          "title": "Self-force, runaways and finite-size regularizations are not supplied by this page",
          "reference": "core-conditional-proofs.md#K10",
          "design_state": "explicit-scope-remark-no-established-speculation",
          "deps": [
            "pthm-em-point-self-energy-divergence",
            "pthm-em-coulomb-solution",
            "def-em-weak-sources",
            "pthm-em-larmor-nonrelativistic",
            "pthm-em-lienard-emitted-power",
