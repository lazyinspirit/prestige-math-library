        {
          "id": "post-td-canonical-sampling",
          "kind": "postulate",
          "domain": "physics",
          "title": "Canonical sampling assumption for finite and normalized statistical models",
          "reference": "items/post-td-canonical-sampling.md#postulate",
          "design_state": "Complete draft carrier authored; scoped checks and prerequisite acceptance remain pending.",
          "dependency_level": 4,
