          "sources": {
            "references": [
              {
                "title": "D. Tong, Quantum Mechanics (author-hosted lecture set), Sections 3.2.2-3.3.1, printed pages 71-81 (Hermitian operators; the measurement outcome lies in the spectrum; probabilities from eigenstate expansion and expectation values)",
                "url": "https://davidtong.org/pdfs/teaching/quantum-mechanics/qm.pdf"
