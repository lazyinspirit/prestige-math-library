          ],
          "dependency_roles": {
            "thm-nrqm-controlled-dynamics-rotating-wave-finite-time-error": "mathematical-premise",
            "thm-nrqm-controlled-dynamics-norm-dyson-series-and-uniqueness": "mathematical-premise",
