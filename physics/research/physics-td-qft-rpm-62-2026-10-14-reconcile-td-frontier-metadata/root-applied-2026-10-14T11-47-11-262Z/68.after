          "dependency_level": 1,
          "sources": {
            "references": [
              {
                "title": "L. D. Landau and E. M. Lifshitz, The Classical Theory of Fields, 4th English edition, §39 and Problem 1",
                "url": "https://pierre.ag.gerard.web.ulb.be/textbooks/books/Landau_Lifshitz_T2.pdf"
