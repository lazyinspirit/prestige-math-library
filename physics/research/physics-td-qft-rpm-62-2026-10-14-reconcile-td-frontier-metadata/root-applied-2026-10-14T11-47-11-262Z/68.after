        {
          "id": "lem-em-harmonic-forcing-periodic-response",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "Periodic responses of $\\ddot z=\\operatorname{Re}(we^{-i\\omega t})$ and the affine classification of all solutions",
          "reference": "scaffold-added necessary mathematical prerequisite for the weak-field Thomson item (see research/physics-em-sr-40-2026-10-08-batch-40.notes.md)",
          "design_state": "new-local-prerequisite; complete-proof-strategy",
          "deps": [
