        {
          "id": "lem-nrqm-oscillator-diagonal-adjoint-and-graph-core-lemma",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "Diagonal adjoint and graph-core lemma",
          "reference": "inventory.json#nrqm-oscillator-diagonal-adjoint-and-graph-core-lemma; proof module M12 (scaffold/mathematical-prerequisites.md)",
          "design_state": "reserved-local-prerequisite; complete-conditional-argument",
          "dependency_level": 0,
          "deps": [
