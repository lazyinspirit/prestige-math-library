          "kind": "proposition",
          "domain": "mathematics",
          "title": "Coordinate covariance of the Euler-Lagrange expression under time-dependent point transformations",
          "reference": "expansion-proofs.md#e4",
          "design_state": "completed-local-proposition; recorded in the batch notes",
