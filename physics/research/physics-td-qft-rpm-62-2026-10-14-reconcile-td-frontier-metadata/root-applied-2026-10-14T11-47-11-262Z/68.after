    {
      "id": "gr-local-and-global-energy",
      "title": "Local And Global Energy",
      "category": "general-relativity",
      "library": "physics",
      "companion": "gr-local-and-global-energy-examples",
      "kind": "A",
      "requires": [
        "gr-einstein-and-matter",
