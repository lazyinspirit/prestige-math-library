      "id": "cm07-stationary-action-and-lagrangian-dynamics",
      "title": "Stationary action and Lagrangian dynamics",
      "category": "non-relativistic-classical-mechanics",
      "library": "physics",
      "companion": "cm07-stationary-action-and-lagrangian-dynamics-examples",
      "kind": "A",
      "requires": [
        "cm-math-verification",
