      "items": [
        {
          "id": "ex-qft-constant-conformal-normalization",
          "kind": "example",
          "domain": "mathematics",
          "library": "mathematics",
          "title": "Constant conformal factor verifies field and volume normalization",
          "statement": "Take the theorem's external metric with a constant conformal factor $\\Omega=b>0$, so $g=b^2\\eta$. The scalar field is smeared by $\\Phi_g(f)=\\Phi_0(b^3f)$ relative to $d\\mathrm{vol}_g=b^4d^4x$. In particular, $R_g=0$ and $P_g=b^{-2}\\Box_\\eta$. Relative to $d\\mathrm{vol}_g(x)d\\mathrm{vol}_g(y)$, the two-point kernel is $W_g(x,y)=b^{-2}W_0(x,y)$, so its double smearing is $b^6$ times the flat covariance. This example checks the constant-factor normalization only; it asserts no preferred state for a general curved metric.",
          "deps": [
            "def-countable-choice",
            "thm-qft-conformal-external-scalar"
          ],
          "dependency_roles": {
            "def-countable-choice": "mathematical-premise",
            "thm-qft-conformal-external-scalar": "mathematical-premise"
          },
          "dependency_level": 6,
          "provenance": {
            "statement": "ai-generated",
            "proof": "ai-generated"
          },
          "generation": {
            "role": "example"
          },
          "physical_scope": null,
          "proof_strategy": "direct"
        }
      ],
      "scaffold": "research/plan-quantum-field-theory-track.md",
      "order": 518
