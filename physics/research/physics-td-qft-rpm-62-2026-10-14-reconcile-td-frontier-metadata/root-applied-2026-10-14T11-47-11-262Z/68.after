                "title": "G. Teschl, Mathematical Methods in Quantum Mechanics, 1st edition 2009, Thm 7.8 p. 168 and §7.3 (free evolution)",
                "url": "https://www.mat.univie.ac.at/~gerald/ftp/book-schroe/schroe.pdf"
              }
            ]
          },
          "aliases": [
            "nrqm-composites-exact-free-gaussian-propagation"
          ]
        },
