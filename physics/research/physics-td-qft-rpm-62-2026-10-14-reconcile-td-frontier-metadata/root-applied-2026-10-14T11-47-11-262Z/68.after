        {
          "id": "thm-nrqm-controlled-dynamics-analytic-perturbation-remainder",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Analytic perturbation remainder",
          "dependency_level": 4,
          "deps": [
            "thm-nrqm-controlled-dynamics-contour-perturbation-projection",
