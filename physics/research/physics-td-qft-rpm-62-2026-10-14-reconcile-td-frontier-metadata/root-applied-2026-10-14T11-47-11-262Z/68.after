      "items": [
        {
          "id": "ex-qft-qed-two-polarizations",
          "kind": "example",
          "domain": "mathematics",
          "library": "mathematics",
          "physical_scope": null,
          "title": "Two physical photon fibers without global frame",
          "reference": "research/plan-quantum-field-theory-track.md#charged-gauge-data-and-si-natural-conventions",
          "design_state": "Assigned QFT-MG01 research interface authored as a conditional mathematical item with exact hypotheses and a complete local proof.",
          "dependency_level": 3,
          "deps": [
            "def-countable-choice",
            "def-euclidean-inner-product",
            "def-cross-product-in-r3",
            "lem-cross-product-is-bilinear-alternating-and-orthogonal",
            "thm-cross-product-norm-is-the-two-vector-gram-determinant",
            "def-qft-photon-transverse-space",
            "lem-qft-photon-null-quotient",
            "lem-qft-photon-no-global-polarization-frame"
          ],
          "dependency_roles": {
            "def-countable-choice": "mathematical-premise",
            "def-euclidean-inner-product": "mathematical-premise",
            "def-cross-product-in-r3": "mathematical-premise",
            "lem-cross-product-is-bilinear-alternating-and-orthogonal": "mathematical-premise",
            "thm-cross-product-norm-is-the-two-vector-gram-determinant": "mathematical-premise",
            "def-qft-photon-transverse-space": "mathematical-premise",
            "lem-qft-photon-null-quotient": "mathematical-premise",
            "lem-qft-photon-no-global-polarization-frame": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "proof_strategy": "direct",
          "statement": "Assume Countable Choice. For each nonzero $\\mathbf k$, the physical photon fiber is the real plane $n^\\perp$ (or its complexification), where $n=\\mathbf k/|\\mathbf k|$, and therefore has dimension two. Locally in direction space one can choose two continuous orthonormal polarization vectors. There is no continuous real orthonormal polarization frame on all of $S^2$. In the Lorenz auxiliary construction, the four-component subsidiary space modulo its null radical is isometric to this same two-dimensional transverse fiber; four auxiliary components do not represent four positive physical polarizations.",
          "provenance": {
            "statement": "literature-derived",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "David Tong, Quantum Field Theory, Chapter 6, §6.2.2",
                "url": "https://www.damtp.cam.ac.uk/user/tong/qft/qfthtml/S6.html",
                "locator": "Complete author-hosted HTML chapter 6; transverse photon polarization vectors and physical degrees of freedom."
              },
              {
                "title": "Mark Srednicki, Quantum Field Theory, author-hosted 2006 book draft, §§54–56",
                "url": "https://www.physics.ucsb.edu/~mark/ms-qft-DRAFT.pdf",
                "locator": "Complete 616-page book draft; Coulomb-gauge transverse modes and polarization vectors."
              }
            ]
          }
        },
        {
          "id": "cex-qft-qed-negative-auxiliary",
          "kind": "counterexample",
          "domain": "mathematics",
          "library": "mathematics",
          "physical_scope": null,
          "title": "Auxiliary timelike vector has negative form",
          "reference": "research/plan-quantum-field-theory-track.md#charged-gauge-data-and-si-natural-conventions",
          "design_state": "Assigned QFT-MG01 research interface authored as a conditional mathematical item with exact hypotheses and a complete local proof.",
          "dependency_level": 3,
          "deps": [
            "def-countable-choice",
            "lem-qft-photon-null-quotient"
          ],
          "dependency_roles": {
            "def-countable-choice": "mathematical-premise",
            "lem-qft-photon-null-quotient": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "proof_strategy": "direct",
          "statement": "Assume Countable Choice and the indefinite auxiliary form and subsidiary quotient of [[lem-qft-photon-null-quotient]]. Every vector in the auxiliary space $\\mathcal K$ has nonnegative quadratic form $[\\epsilon,\\epsilon]_\\eta$.",
          "provenance": {
            "statement": "literature-derived",
