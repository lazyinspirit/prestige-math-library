      "items": [
        {
          "id": "ex-cm-flow-of-a-linear-system-is-the-matrix-exponential",
          "kind": "example",
          "domain": "mathematics",
          "title": "The flow and variational equation of a linear system: Phi(t,a)=e^{tA}a",
          "reference": "expansion-proofs.md#e2",
          "design_state": "completed-local-example; recorded in the batch notes",
          "dependency_level": 2,
          "deps": [
            "def-euclidean-inner-product",
            "thm-cauchy-schwarz-and-the-euclidean-norm",
            "thm-euclidean-space-complete",
            "def-operator-norm",
            "def-cm-local-flow-of-an-autonomous-system",
