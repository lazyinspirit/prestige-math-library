    {
      "id": "cm01-framework-quantities-and-geometry",
      "title": "Framework, quantities and geometry",
      "category": "non-relativistic-classical-mechanics",
      "library": "physics",
      "companion": "cm01-framework-quantities-and-geometry-examples",
      "kind": "A",
      "requires": [
