          "justified_by": [],
          "dependency_roles": {
            "def-tdmath-measure-integral": "mathematical-premise",
            "thm-tdmath-monotone-convergence": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "statement": "Let $(X,\\Sigma,\\mu)$ be a measure space and let $f_n:X\\to[0,\\infty]$ be measurable. Then $\\int\\liminf_{n\\to\\infty} f_n\\,d\\mu\\le\\liminf_{n\\to\\infty}\\int f_n\\,d\\mu$.",
