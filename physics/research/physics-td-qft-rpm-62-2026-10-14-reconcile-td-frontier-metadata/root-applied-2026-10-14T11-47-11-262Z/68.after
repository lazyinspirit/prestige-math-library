    {
      "id": "qm-central-potentials-and-hydrogen-examples",
      "title": "Qm Central Potentials And Hydrogen — Examples",
      "kind": "B",
      "category": "non-relativistic-quantum-mechanics",
      "library": "physics",
      "companion": "qm-central-potentials-and-hydrogen",
      "requires": [
