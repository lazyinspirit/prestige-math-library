        {
          "id": "ex-cm-stationary-path-need-not-be-a-local-minimum",
          "kind": "example",
          "domain": "mathematics",
          "title": "A stationary path that is not a local minimum: the quadratic model $\\mathcal L=\\tfrac12(v^2-4q^2)$ on $[0,\\pi]$",
          "reference": "expansion-proofs.md#e19",
          "design_state": "completed-local-example; recorded in the batch notes",
          "dependency_level": 3,
          "deps": [
            "def-cm-time-dependent-lagrangian-and-action",
            "lem-cm-first-variation-formula",
            "thm-cm-stationarity-iff-euler-lagrange",
