    {
      "id": "td-interacting-equilibrium-preparations",
      "title": "Interacting Equilibrium Preparations",
      "category": "thermodynamics",
      "library": "physics",
      "companion": "td-interacting-equilibrium-preparations-examples",
      "kind": "A",
      "requires": [
