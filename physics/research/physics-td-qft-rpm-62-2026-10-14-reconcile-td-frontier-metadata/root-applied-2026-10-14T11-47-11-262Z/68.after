      "items": [
        {
          "id": "ex-nrqm-state-geometry-normalization-and-phase-check",
          "kind": "example",
          "domain": "mathematics",
          "title": "A two-dimensional normalization and phase computation",
          "statement": "Let $H=\\mathbb C^{2}$ carry the standard inner product\n$$\\langle z,w\\rangle=z_{1}\\overline{w_{1}}+z_{2}\\overline{w_{2}}$$\n([[def-inner-product-space]], [[def-hilbert-space]]; completeness follows from [[cor-finite-dimensional-normed-spaces-are-banach]]), and let $e_{1}=(1,0)$, $e_{2}=(0,1)$. Take\n$$\\psi=(1,i),\\qquad z=1+i,\\qquad \\varphi:=z\\psi,$$\nand verify on this explicit data the normalization and phase statements of [[lem-nrqm-state-geometry-normalization-and-phase-classes]]: the norm of $\\varphi$ is $|z|$ times the norm of $\\psi$, the normalized representative of $\\varphi$ is the phase multiple $(z/|z|)$ of the normalized representative of $\\psi$, the rays of $\\psi$ and $\\varphi$ coincide, and the normalized rank-one operators of $\\psi$, $\\varphi$ and $i\\psi$ are the same pure state [[def-nrqm-state-geometry-pure-mixed-states-and-purity]].",
          "strategy": "Worked two-dimensional computation verifying normalization, phase classes and representative independence of the pure state on the explicit vectors (1,i) and (1+i)(1,i).",
          "deps": [
            "def-nrqm-state-geometry-state-vectors-and-rays",
            "lem-nrqm-state-geometry-normalization-and-phase-classes",
            "lem-nrqm-state-geometry-ray-to-rank-one-projection",
            "def-nrqm-state-geometry-pure-mixed-states-and-purity",
            "def-inner-product-space",
            "def-hilbert-space",
            "cor-inner-product-induces-a-norm",
            "def-complex-numbers-and-arithmetic",
            "lem-complex-conjugation-and-modulus-laws",
            "cor-finite-dimensional-normed-spaces-are-banach",
            "def-countable-choice"
          ],
          "dependency_roles": {
            "def-nrqm-state-geometry-state-vectors-and-rays": "mathematical-premise",
            "lem-nrqm-state-geometry-normalization-and-phase-classes": "mathematical-premise",
            "lem-nrqm-state-geometry-ray-to-rank-one-projection": "mathematical-premise",
