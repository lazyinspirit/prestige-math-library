    {
      "id": "em-experiment-analysis-prerequisites-examples",
      "title": "Em Experiment Analysis Prerequisites — Examples",
      "kind": "B",
      "category": "classical-electromagnetism-mathematics",
      "library": "mathematics",
      "companion": "em-experiment-analysis-prerequisites",
      "requires": [
        "em-experiment-analysis-prerequisites"
