          "id": "lem-em-spherical-mean-family-smoothness",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "Joint smoothness of the spherical-mean family of a smooth spacetime function",
          "reference": "completed-expansion-arguments.md#W1-W3 (scaffolder-added prerequisite for the source term of thm-em-wave-cauchy-kirchhoff)",
          "design_state": "complete-local-branch-argument; added by this scaffolder as a necessary prerequisite, recorded in the batch notes",
          "dependency_level": 1,
          "deps": [
