      "id": "rpm-curved-orbits-scattering",
      "title": "Circular timelike orbit and reduced radial stability",
      "category": "relativistic-particle-mechanics",
      "library": "physics",
      "companion": "rpm-curved-orbits-scattering-examples",
      "kind": "A",
      "requires": [
        "cm-math-central",
