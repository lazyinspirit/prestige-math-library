        {
          "id": "pthm-em-dipole-radiation",
          "kind": "physics-theorem",
          "domain": "physics",
          "title": "Controlled electric-dipole far field and retarded-time radiated power of a compact smooth source",
          "reference": "completed-expansion-arguments.md#A1-A2",
          "design_state": "complete-explicit-branch-argument; not-independent-acceptance",
