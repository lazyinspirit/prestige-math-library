      "companion": "qft-mc02-examples",
      "kind": "A",
      "requires": [
        "qft-mc01",
        "tempered-distributions-and-the-fourier-transform",
        "schwartz-space-and-the-plancherel-theorem",
        "density-separability-and-convolution-in-lp",
