        {
          "id": "ex-td-two-site-no-thermalization",
          "kind": "example",
          "domain": "physics",
          "title": "Two isolated two-level sites do not relax an energy eigenstate to Gibbs form",
          "reference": "items/ex-td-two-site-no-thermalization.md#example",
          "design_state": "Complete draft carrier authored; scoped checks and prerequisite acceptance remain pending.",
          "dependency_level": 8,
          "deps": [
