            "def-nrqm-framework-quantities-and-units": "formulation-prerequisite",
            "post-nrqm-framework-preparation-and-apparatus": "physical-assumption"
          },
          "provenance": {
            "statement": "ai-altered",
            "proof": "not-applicable"
          },
          "dependency_level": 14,
          "sources": {
            "references": [
              {
                "title": "J. Binney and D. Skinner, The Physics of Quantum Mechanics, §3.1 printed pages 37-41 (PDF pages 45-49): the harmonic approximation about a potential minimum and its range of validity",
                "url": "https://www-thphys.physics.ox.ac.uk/people/JamesBinney/qb.pdf"
              },
              {
                "title": "B. Zwiebach, MIT 8.05 Quantum Physics II (Fall 2013), Chapter 6 'Quantum Dynamics', §1 printed pages 1-9: the oscillator as a model system and its energy scale hbar omega",
                "url": "https://ocw.mit.edu/courses/8-05-quantum-physics-ii-fall-2013/79a8091ef4f18d8e3ff76a097e8db33c_MIT8_05F13_Chap_06.pdf"
              }
            ]
          },
          "physical_scope": "The scope and empirical status of the one-dimensional and isotropic three-dimensional quadratic-potential oscillator model: what the page adopts as model assumption, including the potential-energy convention subtracting V(0) and the dimensionless excitation-number observable with unit 1/count; what it proves conditionally, which quantities carry dimensions and units, and which physical comparisons, corrections and extensions are not claimed by the page."
        }
      ],
