        {
          "id": "ex-tdmath-finite-ensemble-mismatch",
          "kind": "example",
          "domain": "mathematics",
          "title": "A finite canonical law differs from a narrow-shell microcanonical law",
          "reference": "research/physics-td-qft-rpm-62-2026-10-14-batch-11.notes.md#item-inventory",
          "design_state": "Complete draft proof recorded; scoped checks and independent review remain pending.",
          "dependency_level": 2,
          "deps": [
            "def-tdmath-countable-canonical-model",
            "thm-tdmath-summable-canonical-differentiation"
          ],
          "justified_by": [],
          "dependency_roles": {
            "def-tdmath-countable-canonical-model": "mathematical-premise",
            "thm-tdmath-summable-canonical-differentiation": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "statement": "Let a two-state model have energies $0$ and $\\varepsilon>0$, with unit state weights and $\\beta>0$. Adopt the finite-shell convention that the microcanonical law is uniform over states whose energy lies in $[0,\\Delta)$ when the shell is nonempty. For $0<\\Delta<\\varepsilon$, that shell contains only the ground state, whereas the canonical law assigns the excited state probability $e^{-\\beta\\varepsilon}/(1+e^{-\\beta\\varepsilon})>0$. Thus the two finite-ensemble laws differ.",
          "strategy": "proof_strategy: direct; complete numbered argument is in items/ex-tdmath-finite-ensemble-mismatch.md and its proof contract.",
          "provenance": {
            "statement": "ai-generated",
            "proof": "ai-generated"
          },
