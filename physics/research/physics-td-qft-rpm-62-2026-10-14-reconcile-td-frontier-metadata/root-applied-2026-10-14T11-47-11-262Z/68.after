          "id": "lem-fluid-galerkin-coefficient-ivp",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "The Galerkin coefficient system: finite-dimensional invariance, local Lipschitz property, and the unique maximal approximation on the torus",
