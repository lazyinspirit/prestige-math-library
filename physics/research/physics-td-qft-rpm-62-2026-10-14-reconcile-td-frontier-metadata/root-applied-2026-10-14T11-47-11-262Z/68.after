          "dependency_level": 11,
          "sources": {
            "references": [
              {
                "title": "D. Tong, Quantum Mechanics (author-hosted lecture set), Section 3.4, printed pages 81-84 (PDF pages 84-87): the canonical commutation relation, the shared-eigenfunction claim for commuting operators and its non-degeneracy caveat, and the physical reading of simultaneous values",
                "url": "https://davidtong.org/pdfs/teaching/quantum-mechanics/qm.pdf"
