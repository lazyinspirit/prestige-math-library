      "items": [
        {
          "id": "ex-qft-dirac-rotation-parity",
          "kind": "example",
          "domain": "physics",
          "library": "physics",
          "title": "Two-pi spin rotation and even-observable invariance",
          "statement": "Define $\\mathcal A_D^{\\mathrm{even}}$ as the norm closure of finite linear combinations of the identity and even-degree products of $\\Psi(F)$ and $\\Psi(F)^\\dagger$, for Schwartz spinor tests $F$. In the selected free Dirac model, let $U_{2\\pi}$ implement a spatial rotation by $2\\pi$ and let $U_{4\\pi}$ implement a rotation by $4\\pi$. On the $n$-particle sector of the adopted antisymmetric Fock decomposition, indexed by $n\\in\\mathbb N_0=\\{0,1,2,\\ldots\\}$, $U_{2\\pi}$ acts as $(-1)^n$ times the identity; $U_{4\\pi}=I$. Every finite even polynomial in bounded spacetime-smeared Dirac fields and their adjoints is invariant under conjugation by $U_{2\\pi}$, and therefore so is $\\mathcal A_D^{\\mathrm{even}}$. This is an exact model calculation; it does not infer a general spin-statistics theorem.",
          "dependency_level": 9,
          "deps": [
            "pthm-qft-dirac-free-properties"
          ],
          "dependency_roles": {
            "pthm-qft-dirac-free-properties": "physical-result"
          },
          "strategy": "direct",
          "provenance": {
            "statement": "literature-derived",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "David Tong, Quantum Field Theory, author-hosted full-text Chapter 4",
                "url": "https://www.damtp.cam.ac.uk/user/tong/qft/qfthtml/S4.html",
                "locator": "Complete HTML chapter on the Dirac equation, spinor representation and rotations."
              },
              {
                "title": "David Tong, Quantum Field Theory, author-hosted full-text Chapter 5",
                "url": "https://www.damtp.cam.ac.uk/user/tong/qft/qfthtml/S5.html",
                "locator": "Complete HTML chapter; §§5.2–5.3, fermionic field modes, particles and antiparticles."
              },
              {
                "title": "Niklas Beisert, Quantum Field Theory I, ETH Zürich 2025 HS complete lecture notes",
                "url": "https://people.phys.ethz.ch/~nbeisert/lectures/QFT1-25HS-Notes.pdf",
                "locator": "Complete 194-page notes; Chapter 5 spinor transformations and quantization; pp. 82–83, Dirac-sea comparison."
              }
            ]
          },
          "physical_scope": "One exact 2π or 4π spatial rotation in the selected free Dirac CAR model. The claim concerns the norm-closed bounded even algebra generated by smeared fields and contains no experiment, point-field product or general spin-statistics theorem.",
          "proof_strategy": "direct"
        }
      ],
      "scaffold": "research/plan-quantum-field-theory-track.md",
      "order": 554
    },
    {
      "id": "qft-f04",
      "title": "Free observable domains and limits of point notation",
      "category": "quantum-field-theory",
      "library": "physics",
      "companion": "qft-f04-examples",
      "kind": "A",
      "requires": [
        "qft-f01",
        "qft-mf04",
        "qft-mf02",
        "qft-mf03"
      ],
      "items": [
        {
          "id": "pthm-qft-free-observable-domain-limits",
          "kind": "physics-theorem",
          "domain": "physics",
          "title": "Free observable domains and limits of point notation",
          "reference": "research/extended-frameworks-2026-10-03/quantum-field-theory/proposed-inventory.json#QFT-F04",
          "design_state": "Develops exact operator domains and moments, locality of the selected bounded scalar and even Dirac observable algebras, and the precise limits of Gaussian point-smearing notation. The Born interpretation is conditional on a constructed instrument; point fields and coincident products are not supplied.",
          "dependency_level": 8,
          "deps": [
            "def-qft-framework-units",
            "def-countable-choice",
            "post-qft-free-field-model",
            "post-qft-constructed-model-and-measurement",
            "def-qft-free-field-observables",
            "lem-qft-free-domain-observables",
            "lem-qft-scalar-local-weyl-algebra",
            "lem-qft-free-dirac-car-locality",
