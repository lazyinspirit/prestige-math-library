        {
          "id": "lem-cm-closed-two-form-radial-primitive",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "A closed smooth two-form on a star-shaped domain has the radial primitive $\\alpha_x(v)=\\int_0^1 t\\,\\tau_{tx}(x,v)\\,dt$",
          "reference": "expansion-proofs.md#e21",
          "design_state": "completed local argument; carrier and readiness record authored in this batch",
          "dependency_level": 0,
          "deps": [
            "thm-poincare-lemma-for-differential-forms-on-star-shaped-domains",
