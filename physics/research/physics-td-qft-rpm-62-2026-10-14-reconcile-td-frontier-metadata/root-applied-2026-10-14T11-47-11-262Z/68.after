      "items": [
        {
          "id": "def-em-complex-plane-wave",
          "kind": "definition",
          "title": "Complex plane-wave fields: real parts of complex exponentials",
          "domain": "mathematics",
          "deps": [
            "def-complex-exponential",
            "def-complex-conjugate-real-imaginary-part-and-modulus",
            "def-complex-numbers-and-arithmetic",
            "def-euclidean-inner-product",
            "def-ck-euclidean-maps-and-diffeomorphisms",
            "thm-algebra-of-derivatives",
            "thm-chain-rule-for-total-derivatives",
            "thm-complex-exponential-is-entire-with-derivative-itself"
          ],
          "dependency_roles": {
            "def-complex-exponential": "mathematical-premise",
            "def-complex-conjugate-real-imaginary-part-and-modulus": "mathematical-premise",
            "def-complex-numbers-and-arithmetic": "mathematical-premise",
            "def-euclidean-inner-product": "mathematical-premise",
            "def-ck-euclidean-maps-and-diffeomorphisms": "mathematical-premise",
            "thm-algebra-of-derivatives": "mathematical-premise",
            "thm-chain-rule-for-total-derivatives": "mathematical-premise",
            "thm-complex-exponential-is-entire-with-derivative-itself": "mathematical-premise"
          },
          "dependency_level": 0,
          "statement": "Fix $\\mathbf k\\in\\mathbb R^3$, $\\omega>0$ and $\\mathbf e,\\mathbf b\\in\\mathbb C^3$. Writing $\\exp$ for the complex exponential, $\\operatorname{Re}$ for the real part and $\\mathbf k\\cdot\\mathbf x$ for the Euclidean inner product, define for each $t\\in\\mathbb R$ the real vector fields $$\\mathbf x\\mapsto\\operatorname{Re}\\bigl[\\mathbf e\\exp(i(\\mathbf k\\cdot\\mathbf x-\\omega t))\\bigr],\\qquad \\mathbf x\\mapsto\\operatorname{Re}\\bigl[\\mathbf b\\exp(i(\\mathbf k\\cdot\\mathbf x-\\omega t))\\bigr]$$ on $\\mathbb R^3$, componentwise. Complex notation is an encoding of real fields and of real linear equations; the complex object is not itself a physical field, and real parts, imaginary parts and complex conjugation are explicit operations.",
          "strategy": "State the encoding convention and its regularity: the defining maps are smooth in $(\\mathbf x,t)$ because the complex exponential is entire and $(\\mathbf x,t)\\mapsto\\mathbf k\\cdot\\mathbf x-\\omega t$ is linear. No electromagnetic interpretation is asserted; that is a later model choice.",
          "provenance": {
            "statement": "ai-altered",
            "proof": "not-applicable"
          },
          "sources": {
            "references": [
              {
                "title": "Review of Phasor Notation (course notes, University of San Diego), Complex Vectors and Time Harmonic Representation; Amplitude, Time Average, Mean Square",
                "url": "https://home.sandiego.edu/~ekim/e171f00/lectures/phasors"
              },
              {
                "title": "J. Lebl, Basic Analysis II, §9.1 (Leibniz integral rule), Theorem 9.1.1",
                "url": "https://www.jirka.org/ra/realanal2.pdf"
              }
            ]
          }
        },
        {
          "id": "def-em-moving-patch",
          "kind": "definition",
          "title": "Moving parametrized surface patches and their flux",
          "domain": "mathematics",
          "deps": [
            "def-type-i-type-ii-and-elementary-green-regions",
            "def-positive-orientation-for-elementary-region-boundaries",
            "def-admissible-regular-parametrized-surface-patch",
            "def-oriented-unit-normal-and-flux-of-a-surface-patch",
            "def-cross-product-in-r3",
            "def-euclidean-inner-product",
            "def-ck-euclidean-maps-and-diffeomorphisms",
            "thm-algebra-of-derivatives",
            "thm-chain-rule-for-total-derivatives",
            "thm-continuous-functions-on-compact-jordan-sets-are-integrable",
            "cor-jordan-content-finite-additivity",
            "thm-jordan-boundary-criterion",
            "lem-null-sets-in-rn-closed-under-subsets-and-countable-unions",
            "lem-compact-null-iff-content-zero-in-rn"
          ],
          "dependency_roles": {
            "def-type-i-type-ii-and-elementary-green-regions": "mathematical-premise",
            "def-positive-orientation-for-elementary-region-boundaries": "mathematical-premise",
            "def-admissible-regular-parametrized-surface-patch": "mathematical-premise",
            "def-oriented-unit-normal-and-flux-of-a-surface-patch": "mathematical-premise",
            "def-cross-product-in-r3": "mathematical-premise",
            "def-euclidean-inner-product": "mathematical-premise",
            "def-ck-euclidean-maps-and-diffeomorphisms": "mathematical-premise",
            "thm-algebra-of-derivatives": "mathematical-premise",
            "thm-chain-rule-for-total-derivatives": "mathematical-premise",
            "thm-continuous-functions-on-compact-jordan-sets-are-integrable": "mathematical-premise",
            "cor-jordan-content-finite-additivity": "mathematical-premise",
            "thm-jordan-boundary-criterion": "mathematical-premise",
            "lem-null-sets-in-rn-closed-under-subsets-and-countable-unions": "mathematical-premise",
            "lem-compact-null-iff-content-zero-in-rn": "mathematical-premise"
          },
          "dependency_level": 0,
          "statement": "Let D be a nonempty compact finite elementary Green region with its supplied positive boundary chain, I an interval (empty and singleton allowed), and r:D x I -> R^3 the restriction of a C^2 extension. Require r_u cross r_v nonzero on D interior x I interior, and a given C^1 velocity v on an open subset of R^4 containing the spacetime graph with v(r(p,t),t)=r_t(p,t). For a C^1 field B on a spacetime neighbourhood of that graph define Phi(t)=integral_D <B(r(p,t),t),r_u cross r_v> du dv. Parametrized flux allows disconnected/noninjective slices. Injectivity alone does not imply slice regularity; a regular material-slice interpretation also imposes nonzero cross product on D interior x I, including endpoint and singleton times. Singleton time jets depend on the chosen extension, while the flux does not.",
          "strategy": "Elementary Green regions are compact Jordan-measurable parameter regions, so the flux is a Riemann integral, and the orientation is the patch orientation of [[def-oriented-unit-normal-and-flux-of-a-surface-patch]]. Single-valuedness of the velocity is the hypothesis that makes the transport formula of the moving-flux lemma well posed. No physical assertion is made.",
          "provenance": {
            "statement": "ai-altered",
            "proof": "not-applicable"
          },
          "sources": {
            "references": [
              {
                "title": "M. E. Taylor, Introduction to Analysis in Several Variables, §3.2 and §4.4",
                "url": "https://mtaylor.web.unc.edu/wp-content/uploads/sites/16915/2018/04/analmv.pdf"
              },
              {
                "title": "J. Feldman, A. Rechnitzer, E. Yeager, CLP-4 Vector Calculus (UBC), §4.1 (Theorems 4.1.4-4.1.16)",
                "url": "https://personal.math.ubc.ca/~CLP/CLP4/clp_4_vc/sec_graadDivCurl.html"
              }
            ]
          }
        },
        {
          "id": "def-em-surface-distribution",
          "kind": "definition",
          "title": "Surface distributions and interfacial jumps",
          "domain": "mathematics",
          "deps": [
            "def-distribution",
            "def-test-function-space-d-of-an-open-set",
            "def-fixed-support-test-function-frechet-space",
