              }
            ]
          }
        },
        {
          "id": "cex-qft-qed-coulomb-potential-locality",
          "kind": "counterexample",
          "domain": "mathematics",
          "library": "mathematics",
          "physical_scope": null,
          "title": "Coulomb potential has nonlocal equal-time commutator",
          "reference": "research/plan-quantum-field-theory-track.md#charged-gauge-data-and-si-natural-conventions",
          "design_state": "Assigned QFT-MG01 research interface authored as a conditional mathematical item with exact hypotheses and a complete local proof.",
          "dependency_level": 4,
          "deps": [
            "def-countable-choice",
            "lem-qft-photon-smeared-potential",
            "lem-qft-photon-transverse-projector-kernel",
            "lem-smooth-bump-between-concentric-euclidean-balls"
          ],
          "dependency_roles": {
            "def-countable-choice": "mathematical-premise",
            "lem-qft-photon-smeared-potential": "mathematical-premise",
            "lem-qft-photon-transverse-projector-kernel": "mathematical-premise",
            "lem-smooth-bump-between-concentric-euclidean-balls": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "proof_strategy": "direct",
          "statement": "Assume Countable Choice and the equal-time Coulomb-gauge potential commutator and transverse-projector kernel in [[lem-qft-photon-smeared-potential]] and [[lem-qft-photon-transverse-projector-kernel]]. The distribution kernel of every $[A_i(\\mathbf x),E_j(\\mathbf y)]$ is supported on the diagonal $\\mathbf x=\\mathbf y$; equivalently, its pairing with every pair of smooth compactly supported tests having disjoint spatial supports vanishes.",
          "provenance": {
            "statement": "literature-derived",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "David Tong, Quantum Field Theory, Chapter 6, §§6.2.1 and 6.4",
                "url": "https://www.damtp.cam.ac.uk/user/tong/qft/qfthtml/S6.html",
                "locator": "Complete author-hosted HTML chapter 6; Coulomb-gauge transverse projector and nonlocal potential commutator."
              },
              {
                "title": "Mark Srednicki, Quantum Field Theory, author-hosted 2006 book draft, §§55–56",
                "url": "https://www.physics.ucsb.edu/~mark/ms-qft-DRAFT.pdf",
                "locator": "Complete 616-page book draft; Coulomb gauge and transverse photon field."
              }
            ]
          }
        },
        {
          "id": "cex-qft-qed-torus-charge",
          "kind": "counterexample",
          "domain": "mathematics",
          "library": "mathematics",
          "physical_scope": null,
          "title": "Periodic smooth Gauss excludes nonzero net charge",
          "reference": "research/plan-quantum-field-theory-track.md#charged-gauge-data-and-si-natural-conventions",
          "design_state": "Assigned QFT-MG01 research interface authored as a conditional mathematical item with exact hypotheses and a complete local proof.",
          "dependency_level": 4,
          "deps": [
            "def-countable-choice",
            "lem-qft-qed-coulomb-constraint"
          ],
          "dependency_roles": {
            "def-countable-choice": "mathematical-premise",
            "lem-qft-qed-coulomb-constraint": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "proof_strategy": "direct",
          "statement": "Assume Countable Choice, $L,\\epsilon_0>0$, and the periodic Coulomb-gauge Gauss equation of [[lem-qft-qed-coulomb-constraint]]. For every smooth periodic charge density $\\rho$ on $T_L^3$, there exists a smooth periodic potential $\\phi$ satisfying $-\\Delta\\phi=\\rho/\\epsilon_0$.",
          "provenance": {
            "statement": "literature-derived",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "David Tong, Quantum Field Theory, Chapter 6, §6.4",
                "url": "https://www.damtp.cam.ac.uk/user/tong/qft/qfthtml/S6.html",
                "locator": "Complete author-hosted HTML chapter 6; Gauss constraint and Coulomb potential."
              },
              {
                "title": "Mark Srednicki, Quantum Field Theory, author-hosted 2006 book draft, §55",
                "url": "https://www.physics.ucsb.edu/~mark/ms-qft-DRAFT.pdf",
                "locator": "Complete 616-page book draft; Gauss-law constraint and periodic-mode discussion."
              }
            ]
          }
        }
      ],
