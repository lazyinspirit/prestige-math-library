        {
          "id": "lem-nrqm-composites-separable-partial-trace",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "Separable partial trace and its basic properties",
          "reference": "inventory.json#nrqm-composites-separable-partial-trace; proof module M9 (scaffold/mathematical-prerequisites.md)",
          "design_state": "reserved-local-prerequisite; complete-conditional-argument",
          "dependency_level": 2,
          "deps": [
