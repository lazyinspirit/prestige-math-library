      "items": [
        {
          "id": "ex-em-grounded-plane-image-force",
          "kind": "example",
          "domain": "physics",
          "title": "Force on a held charge above a grounded plane in the image model",
          "reference": "worked-example-verifications.md#X2",
          "design_state": "complete-exact-conditional-research-argument",
          "deps": [
