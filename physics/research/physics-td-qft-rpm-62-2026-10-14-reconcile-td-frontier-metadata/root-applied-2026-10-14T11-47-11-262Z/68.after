        {
          "id": "thm-nrqm-controlled-dynamics-controlled-born-amplitude-error",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Controlled Born amplitude error",
          "dependency_level": 10,
          "deps": [
            "cor-cauchy-schwarz-inequality-for-l-two",
            "thm-tonelli-theorem-for-sigma-finite-product-spaces",
