          "id": "thm-nrqm-intervals-delta-interface-operator",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "The one-dimensional delta interface operator",
          "reference": "inventory.json#nrqm-intervals-and-contacts-delta-interface-operator; proof module M19 (scaffold/mathematical-prerequisites.md)",
          "design_state": "reserved-local-prerequisite; complete-conditional-argument",
          "dependency_level": 5,
          "deps": [
