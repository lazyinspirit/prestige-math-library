          ],
          "dependency_roles": {
            "pthm-em-electrostatic-bvp-uniqueness": "physical-result",
            "lem-neumann-compatibility-from-the-divergence-theorem": "mathematical-premise",
            "lem-em-weak-neumann-and-transmission-existence": "mathematical-premise",
