          "sources": {
            "references": [
              {
                "title": "D. Tong, Quantum Mechanics (author-hosted lecture set), Chapter 2, printed pages 19-27 (PDF pages 22-30): a quantum particle in one dimension, the free particle, the infinite potential well and the Gaussian wavepacket; Sections 2.3-2.4, printed pages 41-63 (PDF pages 44-66): bound states in one-dimensional potentials and scattering",
                "url": "https://davidtong.org/pdfs/teaching/quantum-mechanics/qm.pdf"
