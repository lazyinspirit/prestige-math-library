          "domain": "mathematics",
          "title": "A four-node cyclic chain mode with $a=c=1$: exact ODE check, dispersion value $\\omega^2=2$, and the continuum error bound",
          "reference": "batch-8 B page; constructed from the A-page statements",
          "design_state": "completed-local-example; recorded in the batch notes",
          "dependency_level": 2,
          "deps": [
