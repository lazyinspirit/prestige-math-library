            "references": [
              {
                "title": "D. Tong, Quantum Mechanics (author-hosted lecture set), Sections 2.1 and 3.2, printed pages 20-30 and 66-75 (PDF pages 23-33 and 69-78): the time-independent Schroedinger equation, eigenfunctions and their energies",
                "url": "https://davidtong.org/pdfs/teaching/quantum-mechanics/qm.pdf"
