          "title": "Homogeneous isotropic medium parameters: phase speed, impedance, refractive index, complex propagation constant and skin depth",
          "reference": "definition-contracts.md#def-em-medium-wave-parameters",
          "design_state": "explicit-definition-contract; supplier-validation-recorded-separately",
          "dependency_level": 17,
          "deps": [
