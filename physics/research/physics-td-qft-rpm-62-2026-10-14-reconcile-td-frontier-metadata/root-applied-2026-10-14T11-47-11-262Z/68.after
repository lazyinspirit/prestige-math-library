      "items": [
        {
          "id": "lem-nrqm-composites-hilbert-tensor-construction",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "Hilbert tensor construction: inner product, completion and product bases",
          "reference": "inventory.json#nrqm-composites-hilbert-tensor-construction; proof module M1 (scaffold/mathematical-prerequisites.md)",
          "design_state": "reserved-local-prerequisite; complete-conditional-argument",
          "dependency_level": 0,
          "deps": [
            "def-tensor-product-of-modules-by-generators-and-relations",
            "thm-completion-of-an-inner-product-space-is-hilbert",
            "def-completion-of-a-normed-space",
