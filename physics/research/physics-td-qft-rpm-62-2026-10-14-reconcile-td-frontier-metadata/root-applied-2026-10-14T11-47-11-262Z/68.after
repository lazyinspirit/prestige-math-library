            "statement": "literature-derived",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "X. Fan et al., Measurement of the Electron Magnetic Moment, Physical Review Letters 130, 071801 (2023), arXiv:2209.13084v2 (2022)",
                "url": "https://arxiv.org/html/2209.13084"
              }
            ]
          },
          "dependency_level": 3,
          "physical_scope": "Exact affine derivation from the 2022 reported one-electron Penning-trap estimate. The anomaly inherits the source's apparatus, correction, 11-field weighting, stated 1 sigma uncertainty, correlation caveat, and omitted-data limitations; no theory comparison or new statistical inference is made.",
          "empirical_premises": [
            {
              "experiment": "exp-qft-fan-electron-moment-2022",
              "conditions": "Reported 2022 one-electron cryogenic Penning-trap determination using alternating quantum-jump spectroscopy, fitted and corrected frequencies, eleven weighted field determinations, and cavity/broadening analysis; raw trials, covariance matrix, and weights are not reconstructed here.",
              "uncertainty": "Authors state a 1 sigma uncertainty of 1.3e-13 in the dimensionless ratio; nearby-field cavity uncertainties are correlated. No Gaussian, independent, posterior, or coverage interpretation is added.",
