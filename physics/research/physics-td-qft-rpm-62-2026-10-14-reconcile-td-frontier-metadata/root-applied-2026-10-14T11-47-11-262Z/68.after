            "def-jacobian-matrix-and-gradient"
          ],
          "dependency_roles": {
            "def-cm-time-dependent-lagrangian-and-action": "mathematical-premise",
            "def-cm-legendre-map-in-a-time-dependent-chart": "mathematical-premise",
            "thm-differentiation-under-the-integral-sign-on-a-compact-rectangle": "mathematical-premise",
            "thm-integration-by-parts": "mathematical-premise",
            "thm-ftc-first-part": "mathematical-premise",
            "thm-chain-rule-for-total-derivatives": "mathematical-premise",
            "thm-continuous-partial-derivatives-imply-total-differentiability": "mathematical-premise",
            "thm-ck-euclidean-maps-closed-under-algebra-and-composition": "mathematical-premise",
            "def-ck-euclidean-maps-and-diffeomorphisms": "mathematical-premise",
            "def-vector-valued-derivative-and-integral": "mathematical-premise",
            "def-darboux-integral": "mathematical-premise",
            "thm-continuous-implies-integrable": "mathematical-premise",
            "thm-linearity-of-the-integral": "mathematical-premise",
            "def-interval": "mathematical-premise",
            "def-euclidean-inner-product": "mathematical-premise",
            "def-jacobian-matrix-and-gradient": "mathematical-premise",
            "def-oriented-integral": "mathematical-premise",
            "thm-additivity-over-subintervals": "mathematical-premise",
            "thm-clairaut-schwarz-mixed-partials": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "statement": "Let $n\\ge1$, let $J\\subseteq\\mathbb R$ and $U\\subseteq\\mathbb R^n$ be open and nonempty, and let\n$\\mathcal L:J\\times U\\times\\mathbb R^n\\to\\mathbb R$ be a fibre-full $C^2$ time-dependent\nLagrangian chart that is hyperregular, with inverse Legendre branch $v$ and Hamiltonian\n$H(t,q,p)=p\\cdot v(t,q,p)-\\mathcal L(t,q,v(t,q,p))$\n([[def-cm-legendre-map-in-a-time-dependent-chart]],\n[[def-cm-time-dependent-lagrangian-and-action]]). Fix $t_0\\in J$ and $q_0\\in U$, let $T\\subseteq J\\setminus\\{t_0\\}$ be open and nonempty, and let\n$Q\\subseteq U$ be open and nonempty, let $D\\subseteq T\\times Q\\times J$ be open, and let\n$X:D\\to U$ be a $C^2$ map such that for every $(t,q)\\in T\\times Q$ the points $(t,q,t)$ and\n$(t,q,t_0)$ lie in $D$, the closed interval with endpoints $t_0$ and $t$ is contained in the\n$s$-section $D_{t,q}:=\\{s\\in J:(t,q,s)\\in D\\}$, which is required to be an open interval, and:\n\n1. $X(t,q,t)=q$ and $X(t,q,t_0)=q_0$;\n2. $s\\mapsto X(t,q,s)$ is a solution of the Euler–Lagrange equation of $\\mathcal L$ on the open\n   interval $D_{t,q}$, i.e. $\\bigl(s,X(t,q,s),\\partial_sX(t,q,s)\\bigr)\\in J\\times U\\times\\mathbb R^n$\n   and $E_{\\mathcal L}\\bigl(X(t,q,\\cdot)\\bigr)=0$ on $D_{t,q}$.\n\nDefine\n\n$$p(t,q):=\\mathcal L_v\\bigl(t,q,\\partial_sX(t,q,t)\\bigr),\\qquad W(t,q):=\\int_{t_0}^{t}\\mathcal L\\bigl(s,X(t,q,s),\\partial_sX(t,q,s)\\bigr)ds\\qquad\\bigl((t,q)\\in T\\times Q\\bigr).$$\n\nThen $W$ is of class $C^1$ on $T\\times Q$ and\n\n$$W_q(t,q)=p(t,q),\\qquad W_t(t,q)=-H\\bigl(t,q,p(t,q)\\bigr)\\qquad\\bigl((t,q)\\in T\\times Q\\bigr).$$",
          "strategy": "Differentiate the endpoint integral in q and t; integration by parts and the Euler-Lagrange equation cancel the interior terms, and the endpoint identities give W_q=p and W_t=-H.",
          "provenance": {
            "statement": "ai-altered",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "D. Cline, Variational Principles in Classical Mechanics (2nd edition, University of Rochester River Campus Libraries, open textbook, CC BY-NC-SA 4.0), Section 9.2 (Hamilton's Principle of Stationary Action: the endpoint variation p dq - H dt) and Section 15.4 (Hamilton-Jacobi Theory)",
                "url": "https://downloads.libretexts.org/api/v1/download/phys-9557/pdf"
              },
              {
                "title": "D. Tong, Classical Dynamics (University of Cambridge Part II Mathematical Tripos), Section 4.7 'The Hamilton-Jacobi Equation' (W as a function of the final configuration, with W_q^final = p^final), printed pages 121-123",
                "url": "https://www.davidtong.org/pdfs/teaching/classical-dynamics/clas.pdf"
              }
            ]
          }
        },
        {
          "id": "thm-cm-hamilton-phase-action-stationarity",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Stationarity of the phase-space action is equivalent to Hamilton's equations, and hyperregular elimination recovers the Lagrangian action",
          "reference": "expansion-proofs.md#e20",
          "design_state": "completed-local-theorem; recorded in the batch notes",
          "dependency_level": 4,
          "deps": [
