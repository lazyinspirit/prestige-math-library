          ],
          "dependency_roles": {
            "def-newtonian-potential": "mathematical-premise",
            "thm-newtonian-potential-solves-poisson-distributionally": "mathematical-premise",
            "thm-differentiation-under-the-integral-sign": "mathematical-premise",
