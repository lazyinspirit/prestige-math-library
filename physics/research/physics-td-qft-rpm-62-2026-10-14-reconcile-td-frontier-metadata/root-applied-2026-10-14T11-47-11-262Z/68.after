    {
      "id": "td-thermodynamic-framework-examples",
      "title": "Thermodynamic Framework — Examples",
      "kind": "B",
      "category": "thermodynamics",
      "library": "physics",
      "companion": "td-thermodynamic-framework",
      "requires": [
        "td-thermodynamic-framework"
      ],
      "items": [
        {
          "id": "ex-td-system-exchange-boundaries",
          "kind": "example",
          "domain": "physics",
          "title": "Classifying closed, open, and isolated system boundaries",
          "statement": "As defined in [[def-td-system-and-permitted-exchanges]], choose the gas inside a sealed cylinder with a conducting wall and movable piston as the system. If the outer boundary allows energy transfer but no matter transfer, it is closed. Choose instead a vessel whose outlet allows water vapour to cross the boundary; it is open because that named matter species crosses. An ideal rigid, impermeable, thermally insulating enclosure with no other external energy channel is isolated. These classifications depend on the selected boundary and stipulated channels; they do not claim that a real apparatus is perfectly sealed or insulated.",
          "deps": [
            "def-td-system-and-permitted-exchanges"
          ],
          "dependency_roles": {
            "def-td-system-and-permitted-exchanges": "formulation-prerequisite"
          },
          "provenance": {
            "statement": "ai-altered",
            "proof": "not-supplied"
          },
          "sources": {
            "references": [
              {
                "title": "Ling, Moebs, and Sanny, University Physics Volume 2, §3.1 Thermodynamic Systems",
                "url": "https://openstax.org/books/university-physics-volume-2/pages/3-1-thermodynamic-systems"
              }
            ]
          },
          "dependency_level": 1,
          "library": "physics",
          "physical_scope": "Illustrative boundary classifications in the macroscopic thermodynamic model; the setups below are idealized examples, not reported measurements."
        },
        {
          "id": "ex-td-si-unit-arithmetic",
          "kind": "example",
          "domain": "physics",
          "title": "Pressure-volume and force-distance units",
          "statement": "The SI units make both a pressure-volume product and a force-distance product have units of energy. In particular, one pascal times one cubic metre is one joule, and one newton times one metre is one joule.",
          "deps": [
            "def-td-si-quantities"
          ],
          "dependency_roles": {
            "def-td-si-quantities": "formulation-prerequisite"
          },
          "provenance": {
            "statement": "ai-altered",
            "proof": "ai-generated"
          },
          "sources": {
            "references": [
              {
                "title": "BIPM, The International System of Units, 9th edition, version 4.01, Table 4",
                "url": "https://www.bipm.org/documents/20126/41483022/SI-Brochure-9.pdf"
              }
            ]
          },
          "dependency_level": 1,
          "library": "physics",
          "physical_scope": "Unit arithmetic for the SI quantities used in the thermodynamic framework; the example does not assert a pressure-volume work law.",
          "proof_strategy": "direct"
        },
        {
          "id": "ex-td-first-law-sign-convention",
          "kind": "example",
          "domain": "physics",
          "title": "Converting work-on and work-by conventions",
          "statement": "Some sources take work done by the system as positive and write the first law as $\\Delta U=Q-W_{\\mathrm{by}}$. The present framework takes work done on the system as positive. Setting $W_{\\mathrm{by}}[P]:=-W_{\\mathrm{on}}[P]$ converts one equation to the other.",
          "deps": [
            "def-td-process-and-protocol",
            "post-td-first-law-energy"
          ],
          "dependency_roles": {
            "def-td-process-and-protocol": "formulation-prerequisite",
            "post-td-first-law-energy": "physical-assumption"
          },
          "provenance": {
            "statement": "literature-derived",
            "proof": "ai-generated"
          },
          "sources": {
            "references": [
              {
                "title": "Ling, Moebs, and Sanny, University Physics Volume 2, §3.3 First Law of Thermodynamics",
                "url": "https://openstax.org/books/university-physics-volume-2/pages/3-3-first-law-of-thermodynamics"
              }
            ]
          },
          "dependency_level": 5,
          "library": "physics",
          "physical_scope": "Algebraic conversion between two signed-work conventions for the closed process class of the adopted first-law postulate.",
          "proof_strategy": "direct"
        },
        {
          "id": "ex-td-joule-primary-work-heat-report",
          "kind": "example",
          "domain": "physics",
          "title": "Joule's 1850 paddle-wheel report",
          "statement": "Joule's 1850 report describes falling lead weights driving a paddle wheel in a sealed copper vessel of water. The water apparatus has rotating brass arms working between stationary vanes; a boxwood interruption reduces heat conduction along the shaft. The report describes thermometer calibration and resting trials arranged to estimate heat exchanged with the surroundings, alongside the friction trials. These are source-reported apparatus and procedure details, not measurements made for this library.\n\nThe water-series tabulation reports a nominal mechanical equivalent of 772.692 in the paper's historical convention: foot-pounds of falling-weight work compared with the heat needed to raise one pound of water by one Fahrenheit degree. The concluding proposition rounds that figure to 772 foot-pounds for raising one pound of water, weighed in vacuo and taken between 55°F and 60°F, by 1°F. Joule states that vibration and sound may make the estimate slightly high. This item adds no modern uncertainty interval or statistical inference. The historical result is empirical evidence from a particular apparatus and correction chain; it does not deductively establish the adopted first-law postulate for all systems.",
          "deps": [],
          "dependency_roles": {},
          "provenance": {
            "statement": "literature-derived",
            "proof": "not-supplied"
          },
          "sources": {
            "references": [
              {
                "title": "J. P. Joule, On the Mechanical Equivalent of Heat, Philosophical Transactions of the Royal Society of London, vol. 140 (1850), pp. 61–82, digitized copy",
                "url": "https://commons.princeton.edu/josephhenry/wp-content/uploads/sites/71/2021/02/Joule.pdf"
              }
            ]
          },
          "dependency_level": 0,
