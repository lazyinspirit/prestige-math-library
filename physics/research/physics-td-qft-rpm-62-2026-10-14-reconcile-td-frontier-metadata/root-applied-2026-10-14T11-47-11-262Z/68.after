        {
          "id": "def-em-moving-circuit-geometry",
          "kind": "definition",
          "domain": "physics",
          "title": "C2 moving material circuit: swept patch, single-valued material velocity, flux and electromotive force",
          "reference": "definition-contracts.md#def-em-moving-circuit-geometry",
          "design_state": "explicit-definition-contract; supplier-validation-recorded-separately",
          "deps": [
