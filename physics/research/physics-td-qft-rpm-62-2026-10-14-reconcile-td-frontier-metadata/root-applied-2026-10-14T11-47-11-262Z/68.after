                "locator": "Complete HTML lecture text read; abstract measure spaces, integration, Fatou, monotone convergence, dominated convergence, and the L1 convergence argument."
              }
            ]
          },
          "library": "mathematics",
          "proof_strategy": "direct"
        },
        {
          "id": "lem-tdmath-fatou",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "Fatou's lemma",
          "reference": "research/physics-td-qft-rpm-62-2026-10-14-batch-11.notes.md#item-inventory",
          "design_state": "Complete draft proof recorded; scoped checks and independent review remain pending.",
          "dependency_level": 2,
