        {
          "id": "ex-cm-harmonic-oscillator-action-derivative",
          "kind": "example",
          "domain": "mathematics",
          "title": "The harmonic oscillator action variable $J_{\\mathrm a}(E)=E/\\omega$ and $J_{\\mathrm a}'(E)=T/(2\\pi)$",
          "reference": "expansion-proofs.md#e6",
          "design_state": "completed-local-argument (E6 split into items; recorded in the batch notes)",
          "dependency_level": 2,
          "deps": [
