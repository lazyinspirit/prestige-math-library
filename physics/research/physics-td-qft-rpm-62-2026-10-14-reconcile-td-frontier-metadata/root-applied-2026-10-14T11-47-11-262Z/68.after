        {
          "id": "lem-slope-graph-transforms-converge",
          "kind": "lemma",
          "title": "Cone invariance and expansion, and convergence of the slope graph transforms to unique invariant stable and unstable line fields",
          "dependency_level": 1,
          "deps": [
