          "id": "lem-kam-affine-taylor-fourier-truncation",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "Affine Taylor splitting in the actions and conservative Fourier truncation of a small perturbation",
          "reference": "analytic-kam.md#e28",
