        {
          "id": "ex-tdmath-pure-state-versus-average-entropy",
          "kind": "example",
          "domain": "mathematics",
          "title": "Pure-state entropy and entropy of a dephased average",
          "reference": "items/ex-tdmath-pure-state-versus-average-entropy.md#statement",
          "design_state": "Complete draft carrier authored; scoped checks and independent review remain pending.",
          "dependency_level": 4,
          "deps": [
            "def-complex-exponential",
            "def-natural-logarithm",
            "def-real-and-complex-inner-product-space",
            "thm-logarithm-derivative-and-integral",
            "cor-complex-exponential-cartesian-form-modulus-and-eulers-identity",
            "thm-complex-exponential-is-entire-with-derivative-itself",
            "thm-ftc-second-part"
          ],
          "justified_by": [],
          "dependency_roles": {
            "def-complex-exponential": "mathematical-premise",
            "def-natural-logarithm": "mathematical-premise",
            "def-real-and-complex-inner-product-space": "mathematical-premise",
            "thm-logarithm-derivative-and-integral": "mathematical-premise",
            "cor-complex-exponential-cartesian-form-modulus-and-eulers-identity": "mathematical-premise",
            "thm-complex-exponential-is-entire-with-derivative-itself": "mathematical-premise",
            "thm-ftc-second-part": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "statement": "Use $\\mathcal H=\\mathbb C^2$ with $\\langle z,w\\rangle=z_1\\overline{w_1}+z_2\\overline{w_2}$, linear in the first argument, and $u_1=(1,0)$, $u_2=(0,1)$. Choose real $E_1\\ne E_2$ and define the self-adjoint energy operator $A(z_1,z_2)=(E_1z_1,E_2z_2)$. Fix $\\hbar>0$, set $U_tu_j=e^{-iE_jt/\\hbar}u_j$, and define $P_jz=\\langle z,u_j\\rangle u_j$, $\\rho_t=U_t\\rho U_t^*$ and $\\bar\\rho_T=T^{-1}\\int_0^T\\rho_t\\,dt$. Let $\\psi=(u_1+u_2)/\\sqrt2$, $\\rho=|\\psi\\rangle\\langle\\psi|$. Define the finite-dimensional entropy of a density matrix with eigenvalues $p_i$ as $S(\\rho)=-k_B\\sum_i p_i\\log p_i$, with $0\\log0=0$ and fixed $k_B>0$. Every instantaneous unitary state $\\rho_t$ is pure and has entropy zero. The Cesàro states converge to $\\rho_{\\rm diag}=(P_1+P_2)/2$, whose entropy is $k_B\\log2$. In fact $S(\\bar\\rho_T)\\to k_B\\log2$, whereas $T^{-1}\\int_0^T S(\\rho_t)\\,dt=0$ for every $T$. Entropy of the averaged state and average instantaneous entropy are distinct quantities.",
          "strategy": "proof_strategy: direct; complete argument is in items/ex-tdmath-pure-state-versus-average-entropy.md and its proof contract.",
          "provenance": {
            "statement": "ai-generated",
            "proof": "ai-generated"
          },
          "sources": {
            "references": [
              {
                "title": "Daniel Arovas, Lecture Notes on Thermodynamics and Statistical Mechanics",
                "url": "https://courses.physics.ucsd.edu/2025/Spring/physics210a/LECTURES/STATMECH.pdf",
                "locator": "Complete 635-page lecture notes retrieved and read; §§4.2–4.6, pp.192–217, ensembles, microcanonical phase space, quantum density matrices, and traces."
              },
