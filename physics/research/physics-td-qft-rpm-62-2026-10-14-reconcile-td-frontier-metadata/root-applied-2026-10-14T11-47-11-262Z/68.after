          "id": "thm-nrqm-magnetic-and-detection-covariance-refined-uncertainty",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Covariance-refined preparation uncertainty without operator products",
          "reference": "inventory.json#nrqm-magnetic-and-detection-covariance-refined-uncertainty; proof module M27 (scaffold/mathematical-prerequisites.md)",
          "design_state": "reserved-local-prerequisite; complete-conditional-argument",
          "dependency_level": 1,
