            "proof": "not-applicable"
          },
          "dependency_level": 12,
          "sources": {
            "references": [
              {
                "title": "J. Binney and D. Skinner, The Physics of Quantum Mechanics, Sections 1.3.6, 1.4 and 7.4.2, printed pages 14-15 and 161-164 (polarization probabilities, ideal measurement and Stern-Gerlach filters in series)",
                "url": "https://www-thphys.physics.ox.ac.uk/people/JamesBinney/qb.pdf"
              },
              {
                "title": "D. Tong, Quantum Mechanics (author-hosted lecture set), Section 3.3, printed pages 76-77 (the measurement postulate and its stated limits)",
                "url": "https://davidtong.org/pdfs/teaching/quantum-mechanics/qm.pdf"
              }
            ]
          },
          "physical_scope": "A scope audit of the companion page of worked instruments: it records what each finite model computation verifies inside the framework's declared-measurement vocabulary and what none of them claims. It proves nothing, records no measurement, reports no observation and asserts no apparatus realization or empirical agreement."
        }
