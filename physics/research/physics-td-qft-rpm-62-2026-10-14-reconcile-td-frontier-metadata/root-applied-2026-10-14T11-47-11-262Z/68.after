          "id": "thm-nrqm-magnetic-and-detection-gauge-h2-domain-preservation",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Gauge multiplication preserves H2 and transports the magnetic momentum",
          "reference": "inventory.json#nrqm-magnetic-and-detection-gauge-h2-domain-preservation; proof module M27 (scaffold/mathematical-prerequisites.md)",
