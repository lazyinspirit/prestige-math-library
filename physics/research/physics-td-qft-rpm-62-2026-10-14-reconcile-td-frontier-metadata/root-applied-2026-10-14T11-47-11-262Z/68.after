            "thm-cm-analytic-verlet-energy-on-exponential-times": "mathematical-premise",
            "lem-cm-separate-roundoff-energy-accumulation": "mathematical-premise"
          },
          "provenance": {
            "statement": "ai-generated",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "Hairer, Geometric Numerical Integration, Lecture 3: backward error analysis, Sections 1–3 and 5; local analytic estimates supplied here",
                "url": "https://www.unige.ch/~hairer/poly_geoint/week3.pdf"
              }
            ]
          },
          "reference": "analytic-backward-error.md#e29",
          "design_state": "Fully authored draft; outside artifact completion cycle 1; independent native review remains pending",
          "statement": "On the dimensionless real ball $U=B_4(0)\\subseteq\\mathbb R^2$, take $\\Pi=\\mathbb R$, mechanical mass matrix $\\mathsf M=(1)$, $A(q,p)=1-\\cos q$ and $B(q,p)=p^2/2$, with holomorphic extensions $\\tilde A(q,p)=1-\\cos q$ and $\\tilde B(q,p)=p^2/2$ on $D(1)$. Set $\\rho=1$ and $K=\\overline B_2(0)$. The analytic labels are potential first and kinetic second, so the splitting is velocity Verlet. These data satisfy the analytic hypotheses with the field bound $M=5+\\cosh(1)$. Therefore, for sufficiently small constant $h>0$, if the iterates lie in $K$ through $nh\\le e^{c/(2h)}$, their original-energy deviation is $O(h^2)$. Compact retention is an additional hypothesis, which this example does not infer from the estimate.",
          "inventory_expansion_required": false,
          "generation": {
            "role": "example"
          }
        }
      ],
