        {
          "id": "cex-cm-no-closed-lift-along-a-full-turn",
          "kind": "counterexample",
          "domain": "mathematics",
          "title": "A closed rotation loop with no closed lift: the full turn about an axis lifts from $1$ to $-1$",
          "statement": "In this item, a curve on $[0,1]$ is called $C^1$ when it is continuous on $[0,1]$ and its restriction to $(0,1)$ is $C^1$; no endpoint derivatives are required.\n\nFor every closed $C^1$ curve $R:[0,1]\\to SO(3)$ with $R(0)=R(1)=I_3$ and every $q_0\\in S^3$ with $\\rho(q_0)=I_3$, there exists a $C^1$ lift $q:[0,1]\\to S^3$ of $R$ with $q(0)=q(1)=q_0$.",
          "deps": [
            "def-cm-quaternion-rotation-map-and-cover",
            "lem-cm-quaternion-product-rule-and-conjugation-formula",
            "thm-cm-quaternion-lift-exists-and-is-unique",
            "prop-cm-quaternion-angular-velocity-reconstruction",
            "def-quaternions",
            "thm-sine-and-cosine-derivatives",
            "cor-trigonometric-parity-and-pythagorean-identity",
            "thm-quarter-turn-values-and-shift-formulas",
            "def-ck-euclidean-maps-and-diffeomorphisms"
          ],
          "dependency_roles": {
            "def-cm-quaternion-rotation-map-and-cover": "mathematical-premise",
            "lem-cm-quaternion-product-rule-and-conjugation-formula": "mathematical-premise",
            "thm-cm-quaternion-lift-exists-and-is-unique": "mathematical-premise",
            "prop-cm-quaternion-angular-velocity-reconstruction": "mathematical-premise",
