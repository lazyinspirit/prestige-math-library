                "url": "https://www.math.ucdavis.edu/~hunter/pdes/pde_notes.pdf"
              }
            ]
          }
        },
        {
          "id": "lem-em-quadratic-stress-identity",
          "kind": "lemma",
          "title": "Quadratic stress identity and the local angular-balance identity",
          "domain": "mathematics",
          "deps": [
            "def-divergence-and-curl-of-a-c1-vector-field",
            "def-cross-product-in-r3",
            "def-euclidean-inner-product",
            "thm-algebra-of-derivatives",
            "def-ck-euclidean-maps-and-diffeomorphisms",
            "def-jacobian-matrix-and-gradient",
            "def-directional-and-partial-derivatives"
          ],
          "dependency_roles": {
            "def-divergence-and-curl-of-a-c1-vector-field": "mathematical-premise",
            "def-cross-product-in-r3": "mathematical-premise",
            "def-euclidean-inner-product": "mathematical-premise",
            "thm-algebra-of-derivatives": "mathematical-premise",
            "def-ck-euclidean-maps-and-diffeomorphisms": "mathematical-premise",
            "def-jacobian-matrix-and-gradient": "mathematical-premise",
            "def-directional-and-partial-derivatives": "mathematical-premise"
          },
          "dependency_level": 0,
          "statement": "Let $U\\subseteq\\mathbb R^3$ be open and let $F:U\\to\\mathbb R^3$ be of class $C^1$ ([[def-ck-euclidean-maps-and-diffeomorphisms]]), with coordinates $x_1,x_2,x_3$, partial derivatives $\\partial_j=\\partial/\\partial x_j$, Euclidean inner product $\\langle\\cdot,\\cdot\\rangle$ and norm $\\lvert\\cdot\\rvert_2$ ([[def-euclidean-inner-product]]), divergence and curl as in [[def-divergence-and-curl-of-a-c1-vector-field]], and cross product as in [[def-cross-product-in-r3]]. Put\n\n$$Q_{ij}:=F_iF_j-\\tfrac12\\delta_{ij}\\lvert F\\rvert_2^2,\\qquad \\delta_{ij}:=\\begin{cases}1,&i=j,\\\\0,&i\\ne j,\\end{cases}\\qquad (\\operatorname{div}Q)_i:=\\sum_{j=1}^{3}\\partial_jQ_{ij}.$$\n\nThen $Q$ is a $C^1$ tensor field on $U$ and\n\n$$\\operatorname{div}Q=F\\,\\operatorname{div}F-F\\times\\operatorname{curl}F .$$\n\nMoreover, writing $\\epsilon_{ijk}$ for the Levi-Civita symbol ($\\epsilon_{ijk}=+1$ if $(i,j,k)$ is an even permutation of $(1,2,3)$, $-1$ if it is an odd permutation, and $0$ if two indices coincide), every symmetric tensor $Q$ (that is, $Q_{kj}=Q_{jk}$ for all $j,k$) satisfies\n\n$$\\epsilon_{ijk}Q_{kj}=0\\qquad(i\\in\\{1,2,3\\}),$$\n\nthe sum over $j,k$ being the nine-term sum with each pair counted separately. Finally, if $\\Pi$ is a $C^1$ symmetric tensor field on $U$, if $g:U\\to\\mathbb R^3$ is continuous, and if $\\partial_tg+\\operatorname{div}\\Pi=-f$ holds at every point of $U$ for a continuous $f:U\\to\\mathbb R^3$, where $(\\operatorname{div}\\Pi)_i=\\sum_{\\ell=1}^{3}\\partial_\\ell\\Pi_{i\\ell}$ and $(x\\times\\Pi)_{i\\ell}:=\\epsilon_{ijk}x_j\\Pi_{k\\ell}$ with the sum over $j,k$, then the vector field $x\\times g$ and the tensor field $x\\times\\Pi$ satisfy\n\n$$\\partial_t(x\\times g)+\\operatorname{div}(x\\times\\Pi)=-x\\times f .$$\n\nNo symmetry of $Q$ beyond the displayed form is assumed, and no boundary integral is asserted: these are pointwise identities on $U$.",
          "strategy": "Expand $\\sum_j\\partial_j(F_iF_j-\\tfrac12\\delta_{ij}\\lvert F\\rvert^2)=F_i\\operatorname{div}F+\\sum_jF_j\\partial_jF_i-\\sum_jF_j\\partial_iF_j$ by the product rule; the last difference is $-(F\\times\\operatorname{curl}F)_i$. For the second part, expand $\\epsilon_{ijk}x_j\\partial_\\ell\\Pi_{k\\ell}$ and cancel the two equal terms using symmetry; the term $\\epsilon_{ijk}\\Pi_{kj}$ vanishes. No symmetry of $Q$ beyond the displayed form is needed.",
          "provenance": {
            "statement": "ai-altered",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "J. Feldman, A. Rechnitzer, E. Yeager, CLP-4 Vector Calculus (UBC), §4.1 (Theorems 4.1.4-4.1.16)",
                "url": "https://personal.math.ubc.ca/~CLP/CLP4/clp_4_vc/sec_graadDivCurl.html"
              }
            ]
          }
        },
        {
          "id": "lem-em-interface-derivatives",
          "kind": "lemma",
          "title": "Distributional divergence and curl across a stationary interface",
          "domain": "mathematics",
          "deps": [
            "def-em-surface-distribution",
            "def-distribution",
            "def-distributional-derivative",
            "def-regular-distribution-from-a-locally-integrable-function",
