        {
          "id": "def-tdmath-bounded-finite-range-lattice",
          "kind": "definition",
          "domain": "mathematics",
          "title": "Bounded finite-range lattice model",
          "reference": "research/physics-td-qft-rpm-62-2026-10-14-batch-11.notes.md#item-inventory",
          "design_state": "Draft definition carrier recorded; scoped checks and independent review remain pending.",
          "dependency_level": 0,
          "deps": [
            "def-finite-sum",
            "def-real-exponential-function-and-e"
          ],
          "justified_by": [],
          "dependency_roles": {
            "def-finite-sum": "mathematical-premise",
            "def-real-exponential-function-and-e": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "statement": "Fix integers $d\\ge1$, $L\\ge1$, a finite alphabet $\\mathcal A$ of cardinality $q\\ge1$, and a finite, possibly empty, list of interaction shapes $S_a\\subset\\mathbb Z^d$, each nonempty and contained in $[-R,R]^d$ for some integer $R\\ge0$. $\\|\\Phi_a\\|_\\infty$ is finite because its domain is finite. For each shape let $\\Phi_a:\\mathcal A^{S_a}\\to\\mathbb R$ be a bounded interaction function. Set $J_0:=\\sum_a\\|\\Phi_a\\|_\\infty$. On $\\Lambda_L:=\\{1,\\ldots,L\\}^d$, define the free-boundary energy $H_L(s):=\\sum_a\\sum_{x:x+S_a\\subseteq\\Lambda_L}\\Phi_a((s_{x+u})_{u\\in S_a})$, for configurations $s\\in\\mathcal A^{\\Lambda_L}$. For $\\beta>0$, define the finite partition sum $Z_L(\\beta):=\\sum_{s\\in\\mathcal A^{\\Lambda_L}}e^{-\\beta H_L(s)}$ and normalized log-partition density $p_L(\\beta):=L^{-d}\\log Z_L(\\beta)$.",
          "strategy": "proof_strategy: direct; complete numbered argument is in items/def-tdmath-bounded-finite-range-lattice.md and its proof contract.",
          "provenance": {
            "statement": "literature-derived",
            "proof": "not-applicable"
          },
          "sources": {
            "references": [
              {
                "title": "David Tong, Statistical Physics, author-hosted complete HTML chapter text",
                "url": "https://davidtong.org/teaching/statistical-physics/statmechhtml/S1",
                "locator": "Full author-hosted HTML chapter text read; canonical/grand-canonical ensembles §§1.3–1.4 pp.17–30; two-state model §1.2.3 pp.11–14; 1D Ising §5.3.1 pp.156–157."
