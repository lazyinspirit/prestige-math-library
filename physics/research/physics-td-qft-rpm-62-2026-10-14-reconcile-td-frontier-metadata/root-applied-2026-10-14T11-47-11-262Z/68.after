        {
          "id": "def-cm-averaging-data-and-averaged-field",
          "kind": "definition",
          "domain": "mathematics",
          "title": "Periodic averaging data: the average field, the oscillatory part and the periodic deviation",
          "reference": "expansion-proofs.md#e8",
          "design_state": "completed-local-definition",
          "dependency_level": 0,
          "deps": [
            "def-vector-valued-functions-limits-and-continuity",
