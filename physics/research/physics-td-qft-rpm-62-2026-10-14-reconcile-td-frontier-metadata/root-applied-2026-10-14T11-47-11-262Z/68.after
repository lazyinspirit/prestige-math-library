      "items": [
        {
          "id": "ex-cm-free-particle-hamilton-jacobi-complete-integral",
          "kind": "example",
          "domain": "mathematics",
          "title": "The free particle: the complete integral $S=q\\alpha-t\\alpha^2/(2m)$, its characteristics and its canonical labels",
          "reference": "expansion-proofs.md#e7",
          "design_state": "completed local argument; carrier and readiness record authored in this batch",
          "dependency_level": 5,
          "deps": [
