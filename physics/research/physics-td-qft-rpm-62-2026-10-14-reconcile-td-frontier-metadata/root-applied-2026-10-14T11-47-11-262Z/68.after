    {
      "id": "td-interacting-equilibrium-preparations-examples",
      "title": "Interacting Equilibrium Preparations — Examples",
      "kind": "B",
      "category": "thermodynamics",
      "library": "physics",
      "companion": "td-interacting-equilibrium-preparations",
      "requires": [
        "td-interacting-equilibrium-preparations"
      ],
      "items": [
        {
          "id": "ex-td-two-particle-hard-core-preparation",
          "kind": "example",
          "domain": "physics",
          "title": "Two indistinguishable hard-core particles in an interval",
          "statement": "Take a dimensionless interval $\\Lambda=[0,L]$ with $0<a<L$, two identical particles, and the hard-core pair potential $\\varphi(r)=+\\infty$ for $|r|<a$ and $0$ otherwise. At any positive temperature the configurational canonical partition function is independent of $T$ and equals\n$$Z_{\\Lambda,2}=\\frac12(L-a)^2.$$\nThe factor $1/2$ is the adopted indistinguishable positional measure. This finite-volume calculation has no momentum variables or experimental data.",
          "deps": [
            "def-td-stable-tempered-continuum-preparation",
            "post-td-classical-indistinguishable-particle-measure",
            "post-td-equilibrium-ensemble-sampling"
          ],
          "dependency_roles": {
            "def-td-stable-tempered-continuum-preparation": "formulation-prerequisite",
            "post-td-classical-indistinguishable-particle-measure": "physical-assumption",
            "post-td-equilibrium-ensemble-sampling": "physical-assumption"
          },
          "provenance": {
            "statement": "ai-generated",
            "proof": "ai-generated"
          },
          "physical_scope": "A finite one-dimensional positional toy model with two classical identical particles and a hard-core exclusion; it is a model calculation, not a reported measurement.",
          "dependency_level": 6,
          "generation": {
            "role": "example"
          },
          "library": "physics",
          "proof_strategy": "direct"
        },
        {
          "id": "ex-td-nonunique-variational-phases",
          "kind": "example",
          "domain": "physics",
          "title": "Two minimizers in a reduced coexistence model",
          "statement": "Consider the reduced coarse-grained variational model with scalar dimensionless order parameter $m\\in[-1,1]$ and dimensionless free-energy function $g(m)=(m^2-1)^2$. Its global minimizers are $m=-1$ and $m=1$. This model shows why uniqueness must be stated as a parameter-specific assumption. It does not identify these two minimizers with Gibbs measures of a continuum pair potential.",
          "deps": [
            "post-td-grand-variational-phase-uniqueness"
          ],
          "dependency_roles": {
            "post-td-grand-variational-phase-uniqueness": "formulation-prerequisite"
          },
          "provenance": {
            "statement": "ai-generated",
            "proof": "ai-generated"
          },
          "physical_scope": "A dimensionless coarse-grained order-parameter example illustrating a possible failure of a singleton variational-minimizer assumption; it is not a continuum Gibbs-potential calculation.",
          "dependency_level": 7,
          "generation": {
            "role": "example"
          },
          "library": "physics",
          "proof_strategy": "direct"
        },
        {
          "id": "ex-td-forbidden-pair-beta-zero",
          "kind": "example",
          "domain": "physics",
          "title": "Hard-core exclusion retained at zero inverse temperature",
          "statement": "In an interval $\\Lambda=[0,L]$, let two particles have hard-core radius $a$ with $0<a<L$. Under the retained-admissibility zero-inverse-temperature preparation, the weight is zero on $|x_1-x_2|<a$ and equals $z^2$ on $|x_1-x_2|\\geq a$. Hence this law is not the unrestricted Poisson activity law, which assigns positive mass to the forbidden band. The conclusion concerns the finite positional continuation defined on the A page.",
          "deps": [
            "def-td-stable-tempered-continuum-preparation",
            "post-td-classical-indistinguishable-particle-measure",
            "def-td-retained-hard-core-zero-beta-preparation"
          ],
          "dependency_roles": {
            "def-td-stable-tempered-continuum-preparation": "formulation-prerequisite",
            "post-td-classical-indistinguishable-particle-measure": "physical-assumption",
            "def-td-retained-hard-core-zero-beta-preparation": "formulation-prerequisite"
          },
          "provenance": {
            "statement": "ai-generated",
            "proof": "ai-generated"
          },
          "physical_scope": "A finite-volume positional hard-core model under the explicitly defined retained-admissibility beta-zero continuation; no universal infinite-temperature claim is made.",
          "dependency_level": 3,
          "generation": {
            "role": "example"
          },
          "library": "physics",
          "proof_strategy": "direct"
        },
        {
          "id": "ex-td-volume-sized-external-field",
          "kind": "example",
          "domain": "physics",
          "title": "A volume-filling field changes ideal-gas pressure",
          "statement": "For the ideal positional gas $\\varphi=0$ in a region of dimensionless volume $V$, the grand partition is $\\Xi_V(z,\\beta)=e^{zV}$. Now impose an external energy $c$ joules per particle at every point of the volume. The new grand partition is $\\Xi_V^{(c)}=e^{ze^{-\\beta c}V}$, so the dimensionless pressure rate changes from $z$ to $ze^{-\\beta c}$ when $c\\neq0$. This exact volume-filling external preparation is not a member of the deterministic exterior class used by [[pthm-td-qualified-van-hove-and-exterior-limit]].",
          "deps": [
            "def-td-stable-tempered-continuum-preparation",
            "def-td-admissible-van-hove-and-tempered-exterior",
            "post-td-equilibrium-ensemble-sampling",
            "pthm-td-qualified-van-hove-and-exterior-limit"
          ],
          "dependency_roles": {
            "def-td-stable-tempered-continuum-preparation": "formulation-prerequisite",
            "def-td-admissible-van-hove-and-tempered-exterior": "formulation-prerequisite",
            "post-td-equilibrium-ensemble-sampling": "physical-assumption",
            "pthm-td-qualified-van-hove-and-exterior-limit": "physical-result"
          },
          "provenance": {
            "statement": "ai-generated",
            "proof": "ai-generated"
          },
          "physical_scope": "A finite-dimensional classical ideal positional gas with a constant per-particle external energy throughout the volume; it is excluded from the fixed uniformly tempered exterior class.",
          "dependency_level": 8,
          "generation": {
            "role": "example"
          },
          "library": "physics",
          "proof_strategy": "direct"
        }
      ],
      "scaffold": "research/plan-thermodynamics-track.md",
      "order": 304
    },
