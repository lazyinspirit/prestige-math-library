          ],
          "dependency_roles": {
            "def-qft-regular-polynomial-functional-algebra": "mathematical-premise",
            "lem-qft-tensor-test-function-density": "mathematical-premise",
            "thm-qft-regular-wick-star-associativity": "mathematical-premise",
            "def-qft-regular-formal-time-ordering": "mathematical-premise",
            "lem-qft-free-time-ordered-kernel": "mathematical-premise",
            "lem-qft-smeared-free-scalar": "mathematical-premise",
            "lem-qft-scalar-causal-commutator": "mathematical-premise",
            "lem-test-function-cutoffs-and-euclidean-localization": "mathematical-premise",
            "thm-tensor-product-distributions-and-iterated-pairings": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "proof_strategy": "direct",
          "statement": "Assume the current scalar suppliers\n[[lem-qft-free-time-ordered-kernel]],\n[[lem-qft-smeared-free-scalar]], and\n[[lem-qft-scalar-causal-commutator]] at exactly their displayed draft\ninterfaces. Let $W_\\mu$ be the relative-coordinate scalar Wightman\ndistribution from the smeared-field supplier, and let $H_\\mu$ be the\ntime-ordered relative-coordinate distribution from the time-ordered-kernel\nsupplier. Form their translation-invariant bidistributions by the construction\nin [[def-qft-regular-formal-time-ordering]].\n\nLet $V,U\\in\\mathcal P_{\\mathrm{reg}}(\\mathbb R^4)$ have compact supports\n$A,B$, respectively. If $A\\succcurlyeq_{\\mathrm{out}}B$, as defined in\n[[def-qft-regular-formal-time-ordering]], then\n$$ S_z^H(V+U)=S_z^H(V)\\star_{W_\\mu}S_z^H(U) $$\ncoefficientwise in $z$. If every difference $x-y$, $x\\in A$,\n$y\\in B$, is spacelike, then $F\\star_{W_\\mu}G=G\\star_{W_\\mu}F$ for\nregular $F,G$ supported in $A,B$; the corresponding formal series commute\ncoefficientwise. These are formal identities for regular functionals only.\nThey assert neither convergence in the coupling nor a local Wick-product or\ncontinuum-interaction construction.",
          "provenance": {
            "statement": "literature-derived",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "Klaus Fredenhagen and Katarzyna Rejzner, Perturbative algebraic quantum field theory, complete lecture notes, section 6",
                "url": "https://arxiv.org/html/1208.1428",
                "locator": "Complete 42-page notes, section 6, the T3 causal-factorization condition and equations (79)–(83) for the formal S-matrix and contraction coefficients."
              },
              {
                "title": "David Tong, Quantum Field Theory, complete author-hosted Cambridge lecture notes, chapter 3",
                "url": "https://www.damtp.cam.ac.uk/user/tong/qft/qfthtml/S3.html",
                "locator": "Complete HTML chapter 3, sections 3.1.1 and 3.3.2, equations (3.221)–(3.245); source formulas are motivation, while the proof below is conditional and distributionally explicit."
              }
            ]
          }
        }
      ],
