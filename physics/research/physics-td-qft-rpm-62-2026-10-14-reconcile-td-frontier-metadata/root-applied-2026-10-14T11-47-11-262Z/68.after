        {
          "id": "pthm-em-retarded-potentials",
          "kind": "physics-theorem",
          "domain": "physics",
          "title": "Retarded potentials, Lorenz gauge and Maxwell fields of a compactly supported conserved smooth source",
          "reference": "completed-expansion-arguments.md#W5",
          "design_state": "complete-explicit-branch-argument; not-independent-acceptance",
          "deps": [
            "post-em-radiation-selection",
            "pthm-em-charge-continuity",
            "lem-em-retarded-wave-kernel",
