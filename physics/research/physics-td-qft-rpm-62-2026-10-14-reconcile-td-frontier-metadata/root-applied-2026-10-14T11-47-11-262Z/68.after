        {
          "id": "prop-cm-local-action-family-exists",
          "kind": "proposition",
          "domain": "mathematics",
          "title": "A smooth local family of extremals with prescribed endpoint exists when the endpoint momentum map has invertible derivative",
          "reference": "expansion-proofs.md#e20",
