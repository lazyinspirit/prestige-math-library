          "title": "Differentiation of a variable-limit convolution integral with a C-one matrix kernel",
          "reference": "batch-7-local-construction; a necessary mathematical prerequisite added by this scaffolder and recorded in the batch notes",
          "design_state": "completed-local-argument",
          "dependency_level": 0,
          "deps": [
