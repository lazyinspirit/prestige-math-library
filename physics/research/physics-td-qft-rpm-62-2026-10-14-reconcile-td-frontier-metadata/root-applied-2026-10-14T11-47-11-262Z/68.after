          "title": "Closed ladder domains",
          "reference": "inventory.json#nrqm-oscillator-closed-ladder-domains; proof module M12 (scaffold/mathematical-prerequisites.md)",
          "design_state": "reserved-local-prerequisite; complete-conditional-argument",
          "dependency_level": 2,
          "deps": [
