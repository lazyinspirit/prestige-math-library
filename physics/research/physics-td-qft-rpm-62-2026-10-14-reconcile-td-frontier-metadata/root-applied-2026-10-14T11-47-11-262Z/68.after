            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "D. Tong, Dynamics and Relativity (Cambridge lecture notes, 2013), Section 1.2.1, printed pages 5-7",
                "url": "https://www.damtp.cam.ac.uk/user/tong/relativity/dynrel.pdf"
