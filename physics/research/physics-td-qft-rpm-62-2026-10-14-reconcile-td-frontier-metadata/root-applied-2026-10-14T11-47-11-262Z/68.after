    {
      "id": "rpm-radiation-models",
      "title": "Reduced-order LL local ODE and shell",
      "category": "relativistic-particle-mechanics",
      "library": "physics",
      "companion": "rpm-radiation-models-examples",
      "kind": "A",
      "requires": [
        "rpm-spin-finite-size",
