      ],
      "items": [
        {
          "id": "def-emg-lorentzian-forms",
          "kind": "definition",
          "domain": "mathematics",
          "title": "Oriented Lorentzian fields, observers and coordinate conventions",
          "reference": "items/def-emg-lorentzian-forms.md#Definition",
          "design_state": "Fully authored draft with complete local argument; independent review remains pending.",
          "dependency_level": 0,
          "deps": [
            "def-countable-choice",
            "def-gr-local-frame-and-tetrad-fields",
            "def-gr-metric-selected-connection",
            "def-gr-metric-volume-form-and-current-flux",
            "def-gr-observer-and-rest-space",
