    {
      "id": "gr-tensors-and-observers-examples",
      "title": "Tensors And Observers — Examples",
      "kind": "B",
      "category": "general-relativity",
      "library": "physics",
      "companion": "gr-tensors-and-observers",
      "requires": [
        "gr-tensors-and-observers",
