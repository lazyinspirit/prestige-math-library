            "def-ck-euclidean-maps-and-diffeomorphisms",
            "thm-graph-of-continuous-function-on-a-compact-set-has-content-zero",
            "lem-c-one-images-of-content-zero-compact-sets-have-content-zero",
            "def-null-and-content-zero-in-rn",
            "lem-null-sets-in-rn-closed-under-subsets-and-countable-unions",
            "lem-compact-null-iff-content-zero-in-rn",
            "def-countable-choice"
          ],
          "dependency_roles": {
            "def-distribution": "mathematical-premise",
            "def-test-function-space-d-of-an-open-set": "mathematical-premise",
            "def-fixed-support-test-function-frechet-space": "mathematical-premise",
            "thm-local-finite-order-characterization-of-distributions": "mathematical-premise",
            "def-regular-distribution-from-a-locally-integrable-function": "mathematical-premise",
            "def-surface-integral-on-a-compact-c-one-hypersurface": "mathematical-premise",
            "lem-surface-integral-is-independent-of-c-one-boundary-charts": "mathematical-premise",
            "def-bounded-c-one-domain-boundary-charts-and-outward-normal": "mathematical-premise",
            "def-oriented-unit-normal-and-flux-of-a-surface-patch": "mathematical-premise",
            "def-bounded-piecewise-c-one-euclidean-domain": "mathematical-premise",
            "def-embedded-submanifold-and-slice-chart": "mathematical-premise",
            "def-codimension-and-hypersurface": "mathematical-premise",
            "def-ck-euclidean-maps-and-diffeomorphisms": "mathematical-premise",
            "thm-graph-of-continuous-function-on-a-compact-set-has-content-zero": "mathematical-premise",
            "lem-c-one-images-of-content-zero-compact-sets-have-content-zero": "mathematical-premise",
            "def-null-and-content-zero-in-rn": "mathematical-premise",
            "lem-null-sets-in-rn-closed-under-subsets-and-countable-unions": "mathematical-premise",
            "lem-compact-null-iff-content-zero-in-rn": "mathematical-premise",
            "def-countable-choice": "mathematical-premise"
          },
          "dependency_level": 0,
          "statement": "Assume the Axiom of Countable Choice ($\\mathrm{AC}_\\omega$). Let $\\Omega\\subseteq\\mathbb R^3$ be open and let $S\\subset\\Omega$ be a fixed compact embedded $C^2$ hypersurface with a chosen unit normal $n$ pointing from the side $\\Omega_-$ to the side $\\Omega_+$, and put $\\delta_S(\\psi):=\\int_S\\psi\\,dS$ for $\\psi\\in\\mathcal D(\\Omega)$, the surface integral being that of [[def-surface-integral-on-a-compact-c-one-hypersurface]]. A continuous density $a$ on $S$ defines $a\\delta_S(\\psi)=\\int_S a\\psi\\,dS$. Both functionals are continuous of finite order on test functions, because $\\lvert a\\rvert$ and $\\psi$ are bounded on the compact interface and the surface measure is finite. A field that is $C^1$ on $\\Omega_-\\cup\\Omega_+$ with one-sided continuous traces has locally integrable components; write $[F]:=F_+-F_-$ for the jump across $S$.",
          "strategy": "Use the compact surface integral definition and the finite-order estimate for continuous densities; for non-compact interfaces localize with a compactly supported test. The jump $[F]$ is the one-sided trace difference, and the sign convention of $n$ (minus to plus) is fixed here and used by the interface-derivative lemma.",
          "provenance": {
            "statement": "ai-altered",
            "proof": "not-applicable"
          },
          "sources": {
            "references": [
              {
                "title": "S. Dyatlov, Lecture notes for 18.155 (MIT, 2026), Chapter 2 and Chapter 3",
                "url": "https://math.mit.edu/~dyatlov/18.155/155-notes.pdf"
              },
