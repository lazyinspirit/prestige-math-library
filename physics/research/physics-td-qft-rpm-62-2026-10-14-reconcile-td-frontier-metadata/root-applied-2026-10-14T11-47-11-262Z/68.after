            "thm-chain-rule",
            "thm-derivative-of-exponential",
            "thm-logarithm-derivative-and-integral",
            "thm-tdmath-dominated-convergence"
          ],
          "justified_by": [],
          "dependency_roles": {
            "thm-arithmetic-and-lattice-operations-preserve-measurability": "mathematical-premise",
            "thm-composition-with-borel-functions-preserves-measurability": "mathematical-premise",
            "cor-mean-value-theorem": "mathematical-premise",
            "def-natural-logarithm": "mathematical-premise",
            "def-real-exponential-function-and-e": "mathematical-premise",
            "def-tdmath-measure-integral": "mathematical-premise",
            "thm-algebra-of-derivatives": "mathematical-premise",
            "thm-chain-rule": "mathematical-premise",
            "thm-derivative-of-exponential": "mathematical-premise",
            "thm-logarithm-derivative-and-integral": "mathematical-premise",
            "thm-tdmath-dominated-convergence": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "statement": "Let $(X,\\Sigma,\\mu)$ be a measure space, let $w:X\\to[0,\\infty)$ and $X_a:X\\to\\mathbb R$ ($1\\le a\\le r$) be measurable, and let $U\\subseteq\\mathbb R^r$ be open. For $\\theta=(\\theta_1,\\ldots,\\theta_r)$, define $\\theta\\cdot X(x):=\\sum_{a=1}^r\\theta_aX_a(x)$. Set $Z(\\theta):=\\int w\\exp(\\theta\\cdot X)\\,d\\mu$ and assume $0<Z(\\theta)<\\infty$ on $U$. Suppose for every compact $K\\subset U$ there is an integrable $G_K\\ge0$ such that $w e^{\\theta\\cdot X}(1+\\sum_a|X_a|^2)\\le G_K$ pointwise for all $\\theta\\in K$. For the normalized density $p_\\theta=w e^{\\theta\\cdot X}/Z(\\theta)$, define $\\mathbb E_\\theta Y:=\\int Yp_\\theta\\,d\\mu$ when integrable and $\\operatorname{Cov}_\\theta(X_a,X_b):=\\mathbb E_\\theta[(X_a-\\mathbb E_\\theta X_a)(X_b-\\mathbb E_\\theta X_b)]$. Then $\\partial_a\\log Z=\\mathbb E_\\theta X_a$ and $\\partial_b\\mathbb E_\\theta X_a=\\operatorname{Cov}_\\theta(X_a,X_b)$. Thus the Hessian of $\\log Z$ is positive semidefinite. This is a mathematical model identity; it assumes no independence or absence of correlations.",
          "strategy": "proof_strategy: direct; complete numbered argument is in items/thm-tdmath-grand-response-covariance.md and its proof contract.",
          "provenance": {
            "statement": "literature-derived",
            "proof": "ai-altered"
          },
