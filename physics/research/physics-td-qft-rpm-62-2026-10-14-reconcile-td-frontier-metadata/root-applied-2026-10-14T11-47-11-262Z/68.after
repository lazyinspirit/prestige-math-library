        {
          "id": "thm-cm-plane-elastic-waves",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Exact plane-wave solutions of the isotropic linear elastic model, with longitudinal and transverse speeds",
          "reference": "expansion-proofs.md#e14",
          "design_state": "completed-local-argument; recorded in the batch notes",
          "dependency_level": 2,
          "deps": [
            "def-cm-linear-elastic-constitutive-law",
