        {
          "id": "thm-nrqm-controlled-dynamics-airy-contour-and-fresnel-normalization",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Airy contour and Fresnel normalization",
          "dependency_level": 1,
          "deps": [
            "lem-nrqm-composites-complex-gaussian-continuation",
            "thm-plancherel",
            "thm-fourier-inversion-on-schwartz-space",
