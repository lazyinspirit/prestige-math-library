          "id": "def-em-plane-wave-definition",
          "kind": "definition",
          "domain": "physics",
          "title": "Real plane-wave fields encoded by complex amplitudes",
          "reference": "definition-contracts.md#def-em-plane-wave-definition",
          "design_state": "explicit-definition-contract; supplier-validation-recorded-separately",
          "dependency_level": 9,
          "deps": [
            "def-em-complex-plane-wave",
            "def-em-fields",
