          ],
          "justified_by": [],
          "dependency_roles": {
            "def-tdmath-mixture-generator-space-and-energy": "mathematical-premise",
            "def-borel-probability-law-on-a-polish-space": "mathematical-premise",
            "def-integrable-real-and-complex-functions-and-their-integrals": "mathematical-premise",
            "thm-extreme-value-metric": "mathematical-premise",
            "thm-heine-borel-rn": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "statement": "Let $K\\subset\\mathbb R^d$ be nonempty compact, $d\\ge1$, and $a:K\\to\\mathbb R$ continuous. Define $a_{\\rm mix}$ as in [[def-tdmath-mixture-generator-space-and-energy]]. Then for every $x\\in\\operatorname{conv}K$ the infimum defining $a_{\\rm mix}(x)$ is attained by a Borel probability measure supported on at most $d+1$ points. The function $a_{\\rm mix}$ is lower semicontinuous and convex on $\\operatorname{conv}K$, and is the greatest convex function on $\\operatorname{conv}K$ bounded above by $a$ on $K$. Minimizing over all Borel probabilities on $K$ gives the same attained value as minimizing over finite mixtures. This is a mathematical compactness result; it makes no phase-preparation or equilibrium postulate.",
