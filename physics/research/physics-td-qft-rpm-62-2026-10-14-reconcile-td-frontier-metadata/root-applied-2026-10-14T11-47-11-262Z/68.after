          "sources": {
            "references": [
              {
                "title": "E. Hairer, Geometric Numerical Integration (TU Munchen 2010), Lecture 3 'Backward error analysis', Section 1: the logarithm of a one-step method as a formal series in the step size, printed pages 1-3",
