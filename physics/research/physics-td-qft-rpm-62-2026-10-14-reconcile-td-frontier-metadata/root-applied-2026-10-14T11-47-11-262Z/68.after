          "id": "cex-cm-radial-kepler-collision",
          "kind": "counterexample",
          "domain": "mathematics",
          "title": "A zero-angular-momentum Kepler trajectory reaches the force centre in finite time, refuting unconditional global existence",
          "reference": "expansion-proofs.md#e10",
