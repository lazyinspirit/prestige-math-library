      "items": [
        {
          "id": "ex-cm-balances-impulse-and-rocket-checks",
          "kind": "example",
          "domain": "mathematics",
          "title": "Worked impulse and restitution computations and a variable-mass rocket check",
          "reference": "batch-2 local construction (see research/physics-cm-qm-gr-79-2026-10-11-batch-2.notes.md)",
          "design_state": "scaffolder-constructed-explicit-mathematical-example; recorded in the batch notes",
          "dependency_level": 1,
