          "sources": {
            "references": [
              {
                "title": "G. Teschl, Mathematical Methods in Quantum Mechanics, 1st edition 2009, Section 6.6 printed pages 153-159 (PDF pages 165-171): perturbation of isolated eigenvalues and the Riesz projection of a separated spectral cluster",
                "url": "https://www.mat.univie.ac.at/~gerald/ftp/book-schroe/schroe.pdf"
