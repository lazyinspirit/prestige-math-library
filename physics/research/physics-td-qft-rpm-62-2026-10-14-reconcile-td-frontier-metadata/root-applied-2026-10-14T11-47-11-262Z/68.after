      "items": [
        {
          "id": "ex-sr-operational-record-arithmetic-worked",
          "kind": "example",
          "domain": "physics",
          "title": "Worked instance of the operational vocabulary: an illustrative bounded record for the longitudinal Doppler ratio and its parameter window",
          "reference": "scaffold/special-relativity.md SR12 reservation (\"def operational model/data/calibration/uncertainty vocabulary\"); B-page construction corresponding to def-sr-experiment-interface-vocabulary",
          "design_state": "complete elementary worked instance of the vocabulary clauses with exact rational arithmetic; declared illustrative values, not a measurement",
          "deps": [
            "def-sr-experiment-interface-vocabulary",
            "pthm-sr-null-wave-doppler-and-aberration",
            "def-sr-null-wave-covector-and-observer-frequency",
            "def-lorentz-boost",
            "def-inertial-frame-and-inertial-chart",
            "def-rational-power",
