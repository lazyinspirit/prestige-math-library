          "sources": {
            "references": [
              {
                "title": "Hairer, Geometric Numerical Integration, Lecture 3: backward error analysis, Sections 1–3 and 5; local analytic estimates supplied here",
                "url": "https://www.unige.ch/~hairer/poly_geoint/week3.pdf"
              }
            ]
