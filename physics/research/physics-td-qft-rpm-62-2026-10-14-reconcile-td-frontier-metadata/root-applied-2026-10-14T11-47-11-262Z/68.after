      "items": [
        {
          "id": "lem-em-coordinate-cell-localization",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "Localization of a continuous function by axis-parallel cube integrals",
          "reference": "local prerequisite added by batch 24 (see research/physics-em-sr-40-2026-10-08-batch-24.notes.md)",
          "design_state": "new-local-prerequisite; complete-proof-strategy",
          "dependency_level": 0,
          "deps": [
