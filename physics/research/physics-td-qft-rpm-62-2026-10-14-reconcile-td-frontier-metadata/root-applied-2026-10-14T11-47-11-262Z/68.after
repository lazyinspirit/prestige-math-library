            "def-td-reversible-process": "formulation-prerequisite",
            "post-td-macroscopic-second-law": "physical-assumption"
          },
          "provenance": {
            "statement": "ai-altered",
            "proof": "not-applicable"
          },
          "sources": {
            "references": [
              {
                "title": "David Tong, Statistical Physics, complete Chapter 4 lecture-note PDF, §4.3.1",
                "url": "https://davidtong.org/pdfs/teaching/statistical-physics/statphys4.pdf"
              },
              {
                "title": "Daniel Arovas, Lecture Notes on Thermodynamics and Statistical Mechanics, Chapter 2, §§2.5.2–2.5.4",
                "url": "https://courses.physics.ucsd.edu/2025/Spring/physics210a/LECTURES/CH02.pdf"
              }
            ]
          },
          "dependency_level": 6,
          "library": "physics",
          "physical_scope": "Two-reservoir cycles of a fixed-constitution working system with ideal constant-temperature baths and an ideal work store, all inside a declared isolated compound; finite reservoirs and unlisted transfers are excluded."
        },
        {
          "id": "pthm-td-carnot-engine-bound",
          "kind": "physics-theorem",
          "domain": "physics",
          "title": "Ideal-bath heat-engine efficiency bound",
          "statement": "Let an admitted heat-engine cycle in the sense of [[def-td-reservoir-cycle]] operate between fixed ideal-bath temperatures $0<T_c<T_h$, absorb $Q_h>0$, reject $Q_c>0$, and deliver $W_{\\mathrm{out}}>0$. Define its efficiency by $\\eta=W_{\\mathrm{out}}/Q_h$. Then\n$\n\\eta\\le 1-\\frac{T_c}{T_h}.\n$\nEquality holds exactly when the total entropy change of the isolated compound is zero. In particular, a reversible cycle in the stated boundary model saturates the bound; zero entropy change is not here asserted to imply full reversibility.",
          "deps": [
            "def-td-reservoir-cycle",
            "post-td-first-law-energy",
            "post-td-macroscopic-second-law"
          ],
          "dependency_roles": {
            "def-td-reservoir-cycle": "formulation-prerequisite",
            "post-td-first-law-energy": "physical-assumption",
            "post-td-macroscopic-second-law": "physical-assumption"
          },
          "provenance": {
            "statement": "ai-altered",
            "proof": "ai-generated"
          },
          "sources": {
            "references": [
              {
                "title": "David Tong, Statistical Physics, complete Chapter 4 lecture-note PDF, §4.3.1",
                "url": "https://davidtong.org/pdfs/teaching/statistical-physics/statphys4.pdf"
              },
              {
                "title": "Daniel Arovas, Lecture Notes on Thermodynamics and Statistical Mechanics, Chapter 2, §2.5.3",
                "url": "https://courses.physics.ucsd.edu/2025/Spring/physics210a/LECTURES/CH02.pdf"
              }
            ]
          },
          "dependency_level": 7,
          "library": "physics",
          "physical_scope": "Conditional efficiency bound for an admitted closed engine cycle between positive-temperature ideal baths inside an isolated compound with an ideal work store; finite reservoirs, unlisted transfers, and empirical engine performance are excluded.",
          "proof_strategy": "direct"
        },
        {
          "id": "pthm-td-refrigerator-bound",
          "kind": "physics-theorem",
          "domain": "physics",
          "title": "Ideal-bath refrigerator coefficient-of-performance bound",
          "statement": "Let an admitted refrigerator cycle in the sense of [[def-td-reservoir-cycle]] operate between fixed ideal-bath temperatures $0<T_c<T_h$, extract $Q_c>0$ from the cold bath, reject $Q_h>0$ to the hot bath, and consume $W_{\\mathrm{in}}>0$. Define its cooling coefficient of performance by $\\mathrm{COP}_R=Q_c/W_{\\mathrm{in}}$. Then\n$\n\\mathrm{COP}_R\\le\\frac{T_c}{T_h-T_c}.\n$\nEquality holds exactly when the total entropy change of the isolated compound is zero. A reversible cycle in the stated boundary model saturates the bound; no converse about reversibility is asserted.",
          "deps": [
            "def-td-reservoir-cycle",
            "post-td-first-law-energy",
            "post-td-macroscopic-second-law"
          ],
          "dependency_roles": {
            "def-td-reservoir-cycle": "formulation-prerequisite",
            "post-td-first-law-energy": "physical-assumption",
            "post-td-macroscopic-second-law": "physical-assumption"
          },
          "provenance": {
            "statement": "ai-altered",
            "proof": "ai-generated"
          },
          "sources": {
            "references": [
              {
                "title": "David Tong, Statistical Physics, complete Chapter 4 lecture-note PDF, §§4.3.1–4.3.3",
                "url": "https://davidtong.org/pdfs/teaching/statistical-physics/statphys4.pdf"
              },
              {
                "title": "Daniel Arovas, Lecture Notes on Thermodynamics and Statistical Mechanics, Chapter 2, §§2.5.2–2.5.3",
                "url": "https://courses.physics.ucsd.edu/2025/Spring/physics210a/LECTURES/CH02.pdf"
              }
            ]
          },
          "dependency_level": 7,
          "library": "physics",
          "physical_scope": "Conditional cooling coefficient-of-performance bound for an admitted closed refrigerator cycle between positive-temperature ideal baths inside an isolated compound with an ideal work store; finite reservoirs, unlisted transfers, and empirical appliance performance are excluded.",
          "proof_strategy": "direct"
        },
        {
          "id": "post-td-nernst-scoped",
          "kind": "postulate",
          "domain": "physics",
          "title": "Uniform Nernst heat-theorem postulate on a compact family",
          "statement": "Fix a material constitution $c$, a positive temperature $T_0$ in kelvins, and a nonempty set $K$ equipped with a specified topology $\\tau_K$ such that the topological space $(K,\\tau_K)$ is compact. Compact means that every cover of $K$ by $\\tau_K$-open subsets has a finite subcover; the label $a\\in K$ holds its listed external constraints fixed while temperature varies. Let $D_{c,+}\\subseteq D_c$ be the designated open equilibrium charts on which the finite $C^2$ entropy and positive absolute temperature $T_c=1/S_{c,U}$ are defined, as in [[post-td-concave-fundamental-entropy]] and [[def-td-temperature-pressure-chemical-potential]]. A model-specified family map\n$\n\\phi:(0,T_0)\\times K\\longrightarrow D_{c,+}\n$\nassigns an equilibrium state $\\phi(t,a)$ at temperature $t$, so $T_c(\\phi(t,a))=t$. The map need not be continuous in $a$; the postulate below itself requires the displayed supremum to be finite for all sufficiently small $t$. Define $S_K(t,a):=S_c(\\phi(t,a))$, measured in $\\mathrm{J\\,K^{-1}}$.\n\nThe model adopts the following uniform compact-family Nernst heat-theorem postulate:\n$\n\\lim_{t\\downarrow0}\\ \\sup_{a,b\\in K}\\left|S_K(t,a)-S_K(t,b)\\right|=0,\n$\nwhere the supremum is the least upper bound of the displayed real differences. This is an additional low-temperature physical postulate, not a consequence of the first or second law. It is a deliberately scoped uniform formulation; it is not asserted equivalent to every statement called the third law or Nernst's theorem.\n\nThe postulate constrains entropy differences within the declared family. It does not assert that any individual finite limit $S_K(0,a):=\\lim_{t\\downarrow0}S_K(t,a)$ exists, that such a limit is zero, or that the family includes every material or constraint. If the indicated individual limit is to be used, its existence and finiteness are an additional premise.",
          "deps": [
            "def-td-equilibrium-state-domain",
            "def-td-si-quantities",
            "def-td-temperature-pressure-chemical-potential",
            "post-td-concave-fundamental-entropy",
            "def-complete-ordered-field"
          ],
          "dependency_roles": {
            "def-td-equilibrium-state-domain": "formulation-prerequisite",
            "def-td-si-quantities": "formulation-prerequisite",
            "def-td-temperature-pressure-chemical-potential": "formulation-prerequisite",
            "post-td-concave-fundamental-entropy": "formulation-prerequisite",
            "def-complete-ordered-field": "formulation-prerequisite"
          },
          "provenance": {
            "statement": "ai-altered",
            "proof": "not-applicable"
          },
          "sources": {
            "references": [
              {
                "title": "David Tong, Statistical Physics, complete Chapter 4 lecture-note PDF, §4.5",
                "url": "https://davidtong.org/pdfs/teaching/statistical-physics/statphys4.pdf"
              },
              {
                "title": "Daniel Arovas, Lecture Notes on Thermodynamics and Statistical Mechanics, Chapter 2, §2.6.2",
                "url": "https://courses.physics.ucsd.edu/2025/Spring/physics210a/LECTURES/CH02.pdf"
              }
            ]
          },
          "dependency_level": 6,
          "library": "physics",
          "physical_scope": "A chosen compact family of fixed-constraint equilibrium branches at strictly positive temperatures in the adopted macroscopic thermodynamic framework; no zero-temperature state, absolute entropy normalization, or microscopic identification is supplied."
        },
        {
          "id": "post-td-unattainability-scoped",
          "kind": "postulate",
          "domain": "physics",
          "title": "Finite-protocol unattainability on a declared zero-temperature boundary",
          "statement": "For a declared material constitution $c$, let $D_{c,+}\\subseteq D_c$ be its designated equilibrium states with finite positive absolute temperature, and require $D_{c,+}\\ne\\varnothing$ for a nonvacuous application. Let $D_0$ be a separately declared nonempty set of zero-temperature boundary preparations, disjoint from $D_{c,+}$, and let\n$\n\\overline D_c:=D_{c,+}\\sqcup D_0,\\qquad\n\\overline T_c:\\overline D_c\\to[0,\\infty)\n$\nextend the thermodynamic temperature from [[def-td-temperature-pressure-chemical-potential]] by $\\overline T_c|_{D_{c,+}}=T_c$ and $\\overline T_c(y)=0$ for $y\\in D_0$.\n\nLet $\\mathcal U_c$ be the model-declared set of cooling controls, and let $\\mathcal C\\subseteq\\overline D_c\\times\\overline D_c\\times\\mathcal U_c\\times(0,\\infty)$ be the model's full declared family of admitted cooling operation records. Each record $\\gamma=(x^-,x^+,u,\\tau)$ has initial-endpoint map $i(\\gamma)=x^-$, final-endpoint map $f(\\gamma)=x^+$, control $u\\in\\mathcal U_c$, and finite positive duration $\\tau(\\gamma)=\\tau$ seconds. Its positive-temperature portions obey the process conventions of [[def-td-process-and-protocol]], while the model separately declares how a boundary endpoint in $D_0$ is represented. Define two records to be compatible exactly when $f(\\gamma)=i(\\gamma')$. A finite protocol is a tuple $(\\gamma_1,\\ldots,\\gamma_m)$ for $m\\in\\mathbb N$, $m\\ge1$ ([[def-natural-numbers]]), with each successive pair compatible; its initial and final endpoints are $i(\\gamma_1)$ and $f(\\gamma_m)$, and its duration is $\\sum_{j=1}^m\\tau(\\gamma_j)$. Let $\\mathcal P_{\\mathcal C}$ be the set of all such finite protocols and let $\\mathcal P_{\\mathcal C}^{+}:=\\{p\\in\\mathcal P_{\\mathcal C}:i(p)\\in D_{c,+}\\}$. For each $p=(\\gamma_1,\\ldots,\\gamma_m)$, define $i(p):=i(\\gamma_1)$, $f(p):=f(\\gamma_m)$, and $\\tau(p):=\\sum_{j=1}^m\\tau(\\gamma_j)<\\infty$. For a nonvacuous application, require $\\mathcal P_{\\mathcal C}^{+}\\ne\\varnothing$ and declare $\\mathcal C$ as the full operation family rather than defining it to exclude boundary endpoints. Define $\\operatorname{Reach}_{\\mathcal C}:=\\{(i(p),f(p)):p\\in\\mathcal P_{\\mathcal C}\\}\\subseteq\\overline D_c\\times\\overline D_c$.\n\nThe adopted operational unattainability postulate is\n$\n\\operatorname{Reach}_{\\mathcal C}\\cap(D_{c,+}\\times D_0)=\\varnothing.\n$\nThis is a separate physical assumption from the Nernst heat-theorem postulate; neither is deduced here from the first or second law. If $D_{c,+}$, $D_0$, or $\\mathcal P_{\\mathcal C}^{+}$ is empty, or if no boundary endpoint is available in the declared operation-record space because the model defines every operation to stay in $D_{c,+}$, the assertion is absent or vacuous and is not evidence for unattainability. The postulate does not remove the need to state the actual state space, controls, and admitted operations.",
          "deps": [
            "def-td-equilibrium-state-domain",
            "def-td-process-and-protocol",
            "def-td-si-quantities",
            "def-td-temperature-pressure-chemical-potential",
            "def-natural-numbers"
          ],
          "dependency_roles": {
            "def-td-equilibrium-state-domain": "formulation-prerequisite",
            "def-td-process-and-protocol": "operational-prerequisite",
            "def-td-si-quantities": "formulation-prerequisite",
            "def-td-temperature-pressure-chemical-potential": "formulation-prerequisite",
            "def-natural-numbers": "mathematical-premise"
          },
          "provenance": {
            "statement": "ai-altered",
            "proof": "not-applicable"
          },
          "sources": {
            "references": [
              {
                "title": "David Tong, Statistical Physics, complete Chapter 4 lecture-note PDF, §4.5",
                "url": "https://davidtong.org/pdfs/teaching/statistical-physics/statphys4.pdf"
              },
              {
                "title": "Daniel Arovas, Lecture Notes on Thermodynamics and Statistical Mechanics, Chapter 2, §§2.5.5–2.6.2",
                "url": "https://courses.physics.ucsd.edu/2025/Spring/physics210a/LECTURES/CH02.pdf"
              }
            ]
          },
          "dependency_level": 6,
          "library": "physics",
          "physical_scope": "A model-specific full family of admitted finite-duration cooling protocols for a nonempty positive-temperature domain and an explicitly represented nonempty zero-temperature boundary; the postulate is substantive only when positive-start protocols are admitted and the family is not defined to exclude the boundary by construction. No universal statement about all possible controls, dynamics, or materials is made."
        },
        {
          "id": "rem-td-residual-entropy",
          "kind": "remark",
          "domain": "physics",
          "title": "Residual entropy and the scope of the third-law postulates",
          "statement": "Residual entropy here means a finite entropy limit at low temperature under a model's specified entropy convention. In a finite canonical model, let a finite set of microstates have energies $E_i$ in joules, assign $p_i(T)\\propto\\exp[-E_i/(k_{\\mathrm B}T)]$ for $T>0$, and use the Gibbs entropy $-k_{\\mathrm B}\\sum_i p_i(T)\\log p_i(T)$. If the ground energy has finite degeneracy $g$ and there is a positive gap to all excited states, this model-specific entropy tends to $k_{\\mathrm B}\\log g$; [[ex-td-finite-canonical-ground-state-entropy]] supplies the full finite-state calculation. Here $g$ is the number of ground states and $\\log$ is the natural logarithm of [[def-natural-logarithm]].\n\nThis formula belongs to that specified microscopic preparation and entropy convention. It does not identify every Gibbs entropy with the macroscopic $S_c$, and it does not establish a universal value $S_c(0)=0$. The uniform Nernst postulate [[post-td-nernst-scoped]] constrains differences across its declared family, not the common entropy offset: adding one fixed constant to every $S_K(t,a)$ leaves every displayed difference unchanged. Thus that postulate alone neither selects an absolute zero nor forces a unique ground state. The Nernst heat theorem, zero-entropy convention for a unique ground state, and operational unattainability remain distinct model statements.",
          "deps": [
            "def-td-si-quantities",
            "def-natural-logarithm",
            "post-td-nernst-scoped"
          ],
          "dependency_roles": {
            "def-td-si-quantities": "formulation-prerequisite",
            "def-natural-logarithm": "mathematical-premise",
            "post-td-nernst-scoped": "formulation-prerequisite"
          },
          "provenance": {
            "statement": "literature-derived",
            "proof": "not-applicable"
          },
          "sources": {
            "references": [
              {
                "title": "David Tong, Statistical Physics, complete Chapter 4 lecture-note PDF, §4.5",
                "url": "https://davidtong.org/pdfs/teaching/statistical-physics/statphys4.pdf"
              },
              {
                "title": "Daniel Arovas, Lecture Notes on Thermodynamics and Statistical Mechanics, Chapter 2, §2.6.2",
                "url": "https://courses.physics.ucsd.edu/2025/Spring/physics210a/LECTURES/CH02.pdf"
              }
            ]
          },
          "dependency_level": 7,
          "library": "physics",
          "physical_scope": "Interpretive distinction between a macroscopic entropy-difference postulate and a finite microscopic canonical model; no identification of their entropies or universal zero-temperature value is asserted.",
          "forward_refs": [
            "ex-td-finite-canonical-ground-state-entropy"
          ]
        }
      ],
      "scaffold": "research/plan-thermodynamics-track.md",
      "order": 277
    },
