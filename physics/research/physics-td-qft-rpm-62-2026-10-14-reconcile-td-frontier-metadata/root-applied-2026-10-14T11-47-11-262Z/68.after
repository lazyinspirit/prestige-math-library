          ],
          "dependency_roles": {
            "lem-em-point-retarded-potential-and-fields": "mathematical-premise",
            "lem-em-gauge-wave-reachability": "mathematical-premise",
            "lem-em-retarded-wave-kernel": "mathematical-premise",
