        {
          "id": "post-td-microcanonical-sampling",
          "kind": "postulate",
          "domain": "physics",
          "title": "Microcanonical sampling assumption",
          "reference": "items/post-td-microcanonical-sampling.md#postulate",
          "design_state": "Complete draft carrier authored; scoped checks and prerequisite acceptance remain pending.",
          "dependency_level": 4,
          "deps": [
