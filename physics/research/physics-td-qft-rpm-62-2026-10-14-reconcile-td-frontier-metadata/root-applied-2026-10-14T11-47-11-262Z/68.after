    {
      "id": "cm06-regular-constraints-and-moving-frames",
      "title": "Regular constraints and moving frames",
      "category": "non-relativistic-classical-mechanics",
      "library": "physics",
      "companion": "cm06-regular-constraints-and-moving-frames-examples",
      "kind": "A",
      "requires": [
        "cm-math-variations",
        "cm03-momentum-work-and-energy-balances",
        "cm02-forces-initial-data-and-newtonian-flow",
