      ],
      "items": [
        {
          "id": "ex-rpm-incomplete",
          "kind": "example",
          "domain": "physics",
          "title": "Flat local geometry without completeness",
          "statement": "For $L,\\ell>0$, consider the flat Lorentzian cylinder $M_L=(\\mathbb R/L\\mathbb Z)\\times\\mathbb R^3$ and the open slab $S_\\ell=(0,\\ell)\\times\\mathbb R^3$, each with metric $-d\\theta^2+\\sum_{i=1}^3d(x^i)^2$ and future direction $\\partial_\\theta$, where $d\\theta$ is induced by the covering coordinate on $\\mathbb R/L\\mathbb Z$. The cylinder curve $\\gamma:\\mathbb R\\to M_L$, $\\gamma(s)=([s]_L,0,0,0)$, is a closed future timelike geodesic. The slab contains a timelike geodesic defined on a finite affine interval that cannot be extended inside the slab. Thus a locally Minkowski metric alone supplies neither chronology nor geodesic completeness.",
          "deps": [
            "def-rpm-spacetime-observer-and-worldline"
          ],
          "dependency_roles": {
            "def-rpm-spacetime-observer-and-worldline": "formulation-prerequisite"
          },
          "provenance": {
            "statement": "ai-generated",
            "proof": "ai-generated"
          },
          "dependency_level": 1,
          "sources": {
            "references": [
              {
                "title": "Sean Carroll, Lecture Notes on General Relativity, complete lecture notes, Ch. 3 geodesics",
                "url": "https://arxiv.org/pdf/gr-qc/9712019"
              },
              {
                "title": "David Tong, General Relativity, author-hosted lecture-note chapter excerpt, §§1.2–1.3",
                "url": "https://www.davidtong.org/pdfs/teaching/general-relativity/gr1.pdf"
              }
            ]
          },
          "strategy": "direct",
          "physical_scope": "Explicit Lorentzian model manifolds illustrating that local flatness does not imply global causal regularity or geodesic completeness; these are mathematical countermodels, not claims about nature.",
          "generation": {
            "role": "example"
          },
          "library": "physics",
          "proof_strategy": "direct"
        },
        {
          "id": "ex-rpm-clock-reunion",
          "kind": "example",
          "domain": "physics",
          "title": "Ideal-clock readings for a flat reunion path",
          "statement": "Choose an inertial frame $(o;e_0,e_1,e_2,e_3)$ and its inertial chart $\\chi$ from [[def-inertial-frame-and-inertial-chart]], with coordinates $(x^0,x^1,x^2,x^3)=(ct,x,y,z)$. Let $T>0$ seconds and $0<v<c$. A lab clock has chart path $\\chi\\circ x_L(t)=(ct,0,0,0)$ for $0\\le t\\le2T$. A traveler has chart path $\\chi\\circ x_R(t)=(ct,vt,0,0)$ on $[0,T]$ and $\\chi\\circ x_R(t)=(ct,v(2T-t),0,0)$ on $[T,2T]$. The traveler reverses direction at $t=T$ and reunites with the lab at $t=2T$.",
          "deps": [
            "post-rpm-test-clock-and-background",
            "thm-rpm-proper-time-parametrization",
            "def-gr-timelike-worldline-and-proper-time",
            "def-inertial-frame-and-inertial-chart"
          ],
          "dependency_roles": {
            "post-rpm-test-clock-and-background": "physical-assumption",
            "thm-rpm-proper-time-parametrization": "mathematical-premise",
            "def-gr-timelike-worldline-and-proper-time": "mathematical-premise",
            "def-inertial-frame-and-inertial-chart": "formulation-prerequisite"
          },
          "provenance": {
            "statement": "ai-generated",
            "proof": "ai-generated"
          },
          "dependency_level": 2,
          "sources": {
            "references": [
              {
                "title": "Sean Carroll, Lecture Notes on General Relativity, complete lecture notes, Ch. 1 proper time",
                "url": "https://arxiv.org/pdf/gr-qc/9712019"
              },
              {
                "title": "David Tong, General Relativity, author-hosted lecture-note chapter excerpt, §1.2 proper time",
                "url": "https://www.davidtong.org/pdfs/teaching/general-relativity/gr1.pdf"
              }
            ]
          },
          "strategy": "direct",
          "physical_scope": "Conditional ideal-clock calculation for two specified piecewise-inertial flat worldlines that reunite; it is a model prediction, not an experimental report.",
          "generation": {
