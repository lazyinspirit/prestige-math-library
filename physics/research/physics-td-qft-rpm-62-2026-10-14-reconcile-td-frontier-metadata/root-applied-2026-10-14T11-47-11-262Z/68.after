        {
          "id": "lem-nrqm-composites-rank-one-operator-calculus",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "Rank-one operator calculus",
          "reference": "local prerequisite added by batch-35 scaffolding (published rank-one trace facts were previously cited through a B-page example)",
          "design_state": "reserved-local-prerequisite; complete-conditional-argument",
          "dependency_level": 0,
          "deps": [
            "def-trace-class-operator",
            "lem-finite-rank-operators-are-compact",
            "lem-nuclear-series-characterizes-trace-norm",
            "thm-trace-is-absolutely-convergent-and-basis-independent",
