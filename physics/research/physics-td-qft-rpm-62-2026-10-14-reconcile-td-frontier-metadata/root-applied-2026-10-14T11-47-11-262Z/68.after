        {
          "id": "cex-rpm-h-relativistic-hj-caustic",
          "kind": "counterexample",
          "domain": "mathematics",
          "title": "Smooth free relativistic Hamilton-Jacobi data form a caustic",
          "statement": "Let $\\mathcal P=T^*\\mathbb R$ have position coordinate $q\\in\\mathbb R$ in metres, momentum coordinate $p\\in\\mathbb R$ in kg m/s, and symplectic form $\\omega=dq\\wedge dp$. For fixed mass $m>0$ in kg and speed $c>0$ in m/s, take the free Hamiltonian $H(p)=E(p)=\\sqrt{m^2c^4+c^2p^2}$, in joules, on $\\mathcal P$; time $t$ is measured in seconds. The proposed assertion that every smooth initial action $S_0:\\mathbb R\\to\\mathbb R$ produces a characteristic family extending as a smooth single-valued graph $p=S_q(t,q)$ with finite $S_{qq}$ through every finite future time $t\\ge0$ is false.",
          "deps": [
            "thm-rpm-h-local-hamilton-jacobi",
            "thm-rpm-h-inertial-time-reduced-hamiltonian",
            "def-countable-choice"
          ],
          "dependency_roles": {
            "thm-rpm-h-local-hamilton-jacobi": "mathematical-premise",
            "thm-rpm-h-inertial-time-reduced-hamiltonian": "mathematical-premise",
            "def-countable-choice": "mathematical-premise"
          },
          "provenance": {
            "statement": "ai-altered",
            "proof": "ai-altered"
          },
          "dependency_level": 6,
          "sources": {
            "references": [
              {
                "title": "Jerrold E. Marsden and Tudor S. Ratiu, Introduction to Mechanics and Symmetry, 2nd ed., complete book PDF; §12.1 Theorem 12.1.4 pp. 393–395; §12.4 Theorem 12.4.1 pp. 412–413; §§14.2–14.3 pp. 466–473; §7.9 pp. 208–211.",
                "url": "https://fisica.net/mecanicaclassica/introduction_to_mechanics_and_symmetry_by_jerrold_marsden.pdf",
                "locator": "Complete 549-page book; full relevant sections inspected."
