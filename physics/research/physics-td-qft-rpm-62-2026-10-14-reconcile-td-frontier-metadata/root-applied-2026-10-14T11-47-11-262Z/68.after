          "reference": "inventory.json#nrqm-composites-exact-free-gaussian-propagation; proof module M41 (scaffold/mathematical-prerequisites.md)",
          "design_state": "reserved-local-prerequisite; complete-conditional-argument",
          "dependency_level": 1,
          "deps": [
