            "def-sr-four-velocity-and-four-acceleration",
            "def-sr-observed-energy-momentum-and-kinetic-energy",
            "lem-sr-energy-momentum-observer-identities"
          ],
          "dependency_roles": {
            "def-sr-affine-minkowski-model": "formulation-prerequisite",
