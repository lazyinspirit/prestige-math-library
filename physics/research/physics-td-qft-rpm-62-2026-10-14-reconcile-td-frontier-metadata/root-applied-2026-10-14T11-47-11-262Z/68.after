    {
      "id": "td-math-interacting-ensemble-geometry",
      "title": "Interacting Ensemble Geometry",
      "category": "thermodynamics-mathematics",
      "library": "mathematics",
      "companion": "td-math-interacting-ensemble-geometry-examples",
      "kind": "A",
      "requires": [
        "td-math-continuum-pressure",
        "td-math-convex-contact-and-mixing",
