        {
          "id": "ex-td-refrigerator-cop-240-300",
          "kind": "example",
          "domain": "physics",
          "title": "A symbolic 240 K and 300 K refrigerator bound",
          "statement": "Consider a hypothetical refrigerator cycle with cold-bath temperature $T_c=240\\,\\mathrm K$, hot-bath temperature $T_h=300\\,\\mathrm K$, and $Q_c=1200\\,\\mathrm J$ extracted per cycle. In the ideal-bath model, its cooling coefficient of performance is at most $4$, so its work input is at least $300\\,\\mathrm J$. No appliance measurement is asserted.",
          "deps": [
            "pthm-td-refrigerator-bound",
            "def-td-si-quantities"
          ],
