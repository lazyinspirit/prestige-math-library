        {
          "id": "thm-tdmath-finite-range-lattice-pressure-limit",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Finite-range lattice log-partition limit",
          "reference": "research/physics-td-qft-rpm-62-2026-10-14-batch-11.notes.md#item-inventory",
          "design_state": "Complete draft proof recorded; scoped checks and independent review remain pending.",
          "dependency_level": 1,
          "deps": [
            "def-natural-logarithm",
            "def-tdmath-bounded-finite-range-lattice",
            "thm-division-algorithm-in-z",
            "thm-natural-logarithm-laws"
          ],
          "justified_by": [],
          "dependency_roles": {
            "def-natural-logarithm": "mathematical-premise",
            "def-tdmath-bounded-finite-range-lattice": "mathematical-premise",
            "thm-division-algorithm-in-z": "mathematical-premise",
            "thm-natural-logarithm-laws": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "statement": "For every fixed $\\beta>0$, the sequence $p_L(\\beta)$ of [[def-tdmath-bounded-finite-range-lattice]] has a finite limit as $L\\to\\infty$. If another finite-volume energy $\\widetilde H_L$ on the same configurations satisfies $\\sup_s|\\widetilde H_L(s)-H_L(s)|\\le C_bL^{d-1}$ for a constant $C_b$ independent of $L$, define $\\widetilde Z_L(\\beta):=\\sum_{s\\in\\mathcal A^{\\Lambda_L}}e^{-\\beta\\widetilde H_L(s)}$ and $\\widetilde p_L(\\beta):=L^{-d}\\log\\widetilde Z_L(\\beta)$. Then $\\widetilde p_L$ has the same limit. The result covers finite-alphabet, bounded, translation-invariant finite-range interactions on cubic boxes; it asserts no continuum-particle or long-range limit.",
          "strategy": "proof_strategy: direct; complete numbered argument is in items/thm-tdmath-finite-range-lattice-pressure-limit.md and its proof contract.",
          "provenance": {
            "statement": "literature-derived",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "David Tong, Statistical Physics, author-hosted complete HTML chapter text",
