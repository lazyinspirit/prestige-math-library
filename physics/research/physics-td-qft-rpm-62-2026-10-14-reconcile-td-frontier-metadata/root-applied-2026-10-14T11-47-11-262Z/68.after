        {
          "id": "ex-em-unit-dimensional-checks",
          "kind": "example",
          "domain": "physics",
          "title": "Dimensional check of every Maxwell and Lorentz term in SI units",
          "reference": "worked-example-verifications.md#X1",
          "design_state": "complete-exact-conditional-research-argument",
          "dependency_level": 18,
          "deps": [
            "def-divergence-and-curl-of-a-c1-vector-field",
