          "id": "thm-nrqm-intervals-dirichlet-nodal-theorem",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Dirichlet eigenvalues, simplicity and the nodal theorem on an interval",
          "reference": "inventory.json#nrqm-intervals-and-contacts-dirichlet-nodal-theorem; proof module M19 (scaffold/mathematical-prerequisites.md)",
          "design_state": "reserved-local-prerequisite; complete-conditional-argument",
          "dependency_level": 3,
          "deps": [
            "def-nrqm-intervals-hilbert-sobolev-spaces",
            "lem-nrqm-intervals-weak-derivative-ac-representative",
            "lem-nrqm-intervals-endpoint-trace-and-half-line-decay",
