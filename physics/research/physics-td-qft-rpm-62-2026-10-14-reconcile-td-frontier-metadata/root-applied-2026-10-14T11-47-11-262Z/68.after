        {
          "id": "thm-tdmath-dominated-convergence",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Dominated convergence for the measure integral",
          "reference": "research/physics-td-qft-rpm-62-2026-10-14-batch-11.notes.md#item-inventory",
          "design_state": "Complete draft proof recorded; scoped checks and independent review remain pending.",
          "dependency_level": 3,
          "deps": [
            "thm-complex-plane-is-complete",
            "thm-arithmetic-and-lattice-operations-preserve-measurability",
            "thm-composition-with-borel-functions-preserves-measurability",
            "thm-sequential-suprema-infima-limsup-liminf-and-pointwise-limits-are-measurable",
            "def-tdmath-measure-integral",
