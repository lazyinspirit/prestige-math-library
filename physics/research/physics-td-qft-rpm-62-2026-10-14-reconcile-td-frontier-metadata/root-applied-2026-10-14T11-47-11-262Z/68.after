            "thm-chain-rule",
            "thm-derivative-of-exponential",
            "thm-logarithm-derivative-and-integral",
            "thm-natural-logarithm-laws",
            "thm-tdmath-dominated-convergence"
          ],
          "justified_by": [],
          "dependency_roles": {
            "thm-arithmetic-and-lattice-operations-preserve-measurability": "mathematical-premise",
            "thm-composition-with-borel-functions-preserves-measurability": "mathematical-premise",
            "cor-mean-value-theorem": "mathematical-premise",
            "def-natural-logarithm": "mathematical-premise",
            "def-real-exponential-function-and-e": "mathematical-premise",
            "def-tdmath-measure-integral": "mathematical-premise",
            "thm-chain-rule": "mathematical-premise",
            "thm-derivative-of-exponential": "mathematical-premise",
            "thm-logarithm-derivative-and-integral": "mathematical-premise",
            "thm-natural-logarithm-laws": "mathematical-premise",
            "thm-tdmath-dominated-convergence": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "statement": "Let $(X,\\Sigma,\\mu)$ be a measure space, let $E:X\\to\\mathbb R$ be measurable, and let $J\\subset\\mathbb R$ be open. Suppose $Z(\\beta):=\\int e^{-\\beta E}\\,d\\mu$ satisfies $0<Z(\\beta)<\\infty$ on $J$, and for every compact interval $K\\subset J$ there is $G_K\\in L^1(\\mu)$ with $(1+|E|^2)e^{-\\beta E}\\le G_K$ pointwise for every $\\beta\\in K$. Define $p_\\beta=e^{-\\beta E}/Z(\\beta)$, $\\langle Y\\rangle_\\beta:=\\int Yp_\\beta\\,d\\mu$ for integrable $Y$, and $\\operatorname{Var}_\\beta(E):=\\int(E-\\langle E\\rangle_\\beta)^2p_\\beta\\,d\\mu$. Then $Z\\in C^2(J)$, $Z'=-\\int E e^{-\\beta E}d\\mu$, $Z''=\\int E^2e^{-\\beta E}d\\mu$, and $-\\partial_\\beta\\log Z=\\langle E\\rangle_\\beta$, $\\partial_\\beta^2\\log Z=\\operatorname{Var}_\\beta(E)$. The reference-relative entropy $-\\int p_\\beta\\log p_\\beta\\,d\\mu$ is finite and equals $\\log Z+\\beta\\langle E\\rangle_\\beta$.",
          "strategy": "proof_strategy: direct; complete numbered argument is in items/thm-tdmath-measurable-canonical-identities.md and its proof contract.",
          "provenance": {
            "statement": "literature-derived",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
