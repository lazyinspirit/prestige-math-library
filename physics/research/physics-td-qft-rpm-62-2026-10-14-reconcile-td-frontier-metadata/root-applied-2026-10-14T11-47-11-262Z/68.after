        {
          "id": "cex-nrqm-kinematics-ccr-cannot-hold-for-bounded-operators",
          "kind": "counterexample",
          "domain": "mathematics",
          "title": "No bounded operators satisfy the canonical commutation relation with a nonzero commutator",
          "statement": "Let $H\\ne\\{0\\}$ be a complex Hilbert space and let $\\hbar>0$. Then there exist\nbounded linear operators $A,B\\in\\mathcal B(H)$ with\n$$AB-BA=i\\hbar I .$$",
          "strategy": "direct",
          "deps": [
