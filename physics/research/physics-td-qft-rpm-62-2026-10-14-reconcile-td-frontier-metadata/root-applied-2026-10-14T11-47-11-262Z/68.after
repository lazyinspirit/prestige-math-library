            "def-interval": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "statement": "Let $\\mu>0$, let $J_0\\subseteq(0,\\infty)$ be an open interval, let\n$U:J_0\\to\\mathbb R$ be of class $C^2$, let $I\\subseteq\\mathbb R$ be an interval\nwith at least two points, and let $r:I\\to\\mathbb R^3$ be a central-force\ntrajectory for $(\\mu,U)$ with angular momentum vector\n$j=\\mu\\,r\\times r'$ ([[def-cm-central-force-trajectory]]). Then:\n\n1. $j$ is differentiable on $I$ with $j'(t)=0$ for every $t\\in I$; hence $j$ is\n   constant on $I$;\n2. for every $t\\in I$, $\\langle r(t),j(t)\\rangle=0$ and\n   $\\langle r'(t),j(t)\\rangle=0$.",
          "strategy": "direct",
          "provenance": {
            "statement": "ai-altered",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "David Tong, Classical Dynamics (University of Cambridge), §2.5.4, printed p. 31, Eqs. (2.83)-(2.84): the orbit lies in a plane perpendicular to the conserved angular momentum",
                "url": "https://www.davidtong.org/pdfs/teaching/classical-dynamics/clas.pdf"
              },
              {
                "title": "Richard Fitzpatrick, Newtonian Dynamics (University of Texas at Austin), §6.3 Motion in a General Central Force-Field, Eqs. (299)-(304): the angular first integral $r^2\\dot\\theta=h$ in polar coordinates",
                "url": "https://farside.ph.utexas.edu/teaching/336k/Newtonhtml/node44.html"
              }
            ]
          }
        },
