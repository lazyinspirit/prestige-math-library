    {
      "id": "em-variational-mathematical-prerequisites-examples",
      "title": "Em Variational Mathematical Prerequisites — Examples",
      "kind": "B",
      "category": "classical-electromagnetism-mathematics",
      "library": "mathematics",
      "companion": "em-variational-mathematical-prerequisites",
      "requires": [
        "em-variational-mathematical-prerequisites"
      ],
      "items": [
        {
          "id": "ex-em-variational-mathematical-prerequisites-hypothesis-boundaries",
          "kind": "example",
          "domain": "mathematics",
          "title": "Hypothesis and convention boundaries for the variational prerequisites",
          "reference": "mathematical-example-verifications.md#ex-em-variational-mathematical-prerequisites-hypothesis-boundaries",
          "design_state": "complete-explicit-mathematical-example",
          "dependency_level": 3,
          "deps": [
            "def-total-derivative-in-euclidean-space",
            "lem-em-compact-field-variation",
            "lem-em-fundamental-variation-lemma",
            "def-em-minkowski-affine-space",
            "def-countable-choice",
            "def-directional-and-partial-derivatives",
            "lem-derivative-of-a-power",
            "thm-lebesgue-measure-of-a-box-of-every-kind",
