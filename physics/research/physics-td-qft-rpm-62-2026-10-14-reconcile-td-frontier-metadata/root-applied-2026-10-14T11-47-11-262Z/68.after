          "title": "Analytic KAM data: angular tori, action-angle neighbourhoods, Fourier cutoffs and Diophantine frequency labels",
          "reference": "analytic-kam.md#e28",
          "design_state": "completed-local-definition",
          "dependency_level": 3,
          "deps": [
