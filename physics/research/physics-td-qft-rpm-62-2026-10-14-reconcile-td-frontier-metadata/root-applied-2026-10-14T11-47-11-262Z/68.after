        {
          "id": "lem-qft-lattice-hamiltonian-selfadjoint",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "Rotor interacting Hamiltonian with exact domain",
          "reference": "research/extended-frameworks-2026-10-03/quantum-field-theory/workers/qed/proofs.md#Q5; reserved proposed inventory, exact conditional statement authored in items/lem-qft-lattice-hamiltonian-selfadjoint.md",
          "design_state": "reserved claim; complete conditional argument authored; Step-1 readiness escalated pending batch-37 carrier",
          "dependency_level": 4,
          "deps": [
            "def-qft-compact-lattice-gauge-data"
          ],
          "dependency_roles": {
            "def-qft-compact-lattice-gauge-data": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "statement": "Assume the model data of [[def-qft-compact-lattice-gauge-data]]. The nonnegative electric operator $H_0=\\lambda_E\\sum_e E_e^2$ is self-adjoint on the stated maximal diagonal domain and finite Fourier/occupation sums are a graph core. The finite plaquette and fermion interaction $V=V_B+V_F$ is bounded and self-adjoint. Therefore $H=H_0+V$ is self-adjoint on exactly $D(H_0)$. Moreover $H$ commutes with every gauge transformation $U(\\alpha)$ on this domain. No continuum-limit assertion follows.",
          "strategy": "direct",
          "provenance": {
            "statement": "ai-altered",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "John B. Kogut, An Introduction to Lattice Gauge Theory and Spin Systems, Reviews of Modern Physics 51 (1979)",
