        {
          "id": "pthm-em-gauge-invariance",
          "kind": "physics-theorem",
          "domain": "physics",
          "title": "Gauge transformations preserve the field pair: invariance of the electric and magnetic fields",
          "reference": "core-conditional-proofs.md#K7",
          "design_state": "complete-exact-conditional-research-argument; sign and regularity conventions of def-em-potential-gauge-and-field-conventions",
