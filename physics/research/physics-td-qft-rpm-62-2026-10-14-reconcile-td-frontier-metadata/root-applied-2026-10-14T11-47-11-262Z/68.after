      "items": [
        {
          "id": "ex-sr-low-speed-expansion-at-beta-one-fifth",
          "kind": "example",
          "domain": "physics",
          "title": "Worked low-speed correspondence at $|w|=c/5$",
          "reference": "scaffold/mathematical-prerequisites.md#M08 (baseline Newtonian expansions); scaffold/special-relativity.md SR11 reservation",
          "design_state": "exact radical computations with rounded decimals and a check of every displayed bound",
          "deps": [
            "pthm-sr-newtonian-p-e-correspondence",
            "lem-sr-uniform-low-speed-expansion-of-observer-quantities",
            "lem-sr-uniform-low-speed-taylor-remainder",
