      "id": "gr-gr15-exact-checked-sbierski-smooth-mghd-proof-with-complete-local-prerequisites-and-quotient-second-countability",
      "title": "Gr15 Exact Checked Sbierski Smooth Mghd Proof With Complete Local Prerequisites And Quotient Second Countability",
      "category": "general-relativity",
      "library": "physics",
      "companion": "gr-gr15-exact-checked-sbierski-smooth-mghd-proof-with-complete-local-prerequisites-and-quotient-second-countability-examples",
      "kind": "A",
      "requires": [
        "gr-gr14-full-high-regularity-symmetric-hyperbolic-proof",
        "the-zfc-axioms-and-basic-set-constructions",
        "whitney-embedding-tubular-neighbourhoods-and-approximation",
