        {
          "id": "lem-em-gauge-wave-reachability",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "Every smooth potential pair on a slab can be put in Lorenz gauge by a wave-equation gauge function, without changing the fields",
          "reference": "completed-expansion-arguments.md#W6",
          "design_state": "complete-local-branch-argument",
          "dependency_level": 3,
          "deps": [
            "thm-em-wave-cauchy-kirchhoff",
