        {
          "id": "def-cm-fluid-constitutive-models",
          "kind": "definition",
          "domain": "mathematics",
          "title": "Incompressible Newtonian and barotropic inviscid fluid constitutive models",
          "reference": "expansion-proofs.md#e14",
          "design_state": "completed-local-definition; recorded in the batch notes",
          "dependency_level": 1,
          "deps": [
            "def-cm-euclidean-spatial-calculus",
            "def-matrix-space",
