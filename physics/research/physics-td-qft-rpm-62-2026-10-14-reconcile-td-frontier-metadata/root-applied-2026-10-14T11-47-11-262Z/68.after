    {
      "id": "sr-accelerated-observers",
      "title": "Accelerated Observers",
      "category": "special-relativity",
      "library": "physics",
      "companion": "sr-accelerated-observers-examples",
      "kind": "A",
      "requires": [
        "sr-causality-and-signals",
        "sr-light-and-doppler",
        "sr-proper-time-comparisons",
        "sine-cosine-and-the-definition-of-pi"
