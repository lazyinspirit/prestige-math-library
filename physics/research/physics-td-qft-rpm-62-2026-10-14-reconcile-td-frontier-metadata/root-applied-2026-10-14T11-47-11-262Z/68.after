          "id": "ex-two-rotor-kam-model-with-units",
          "kind": "example",
          "domain": "mathematics",
          "title": "A two-rotor model with units: dimensionless normalisation, Diophantine measure and the conditional KAM family",
          "reference": "analytic-kam.md#e28; batch-14-local-construction; recorded in the batch notes",
          "design_state": "scaffolder-constructed-explicit-mathematical-example; recorded in the batch notes",
          "dependency_level": 12,
          "deps": [
            "def-countable-choice",
            "thm-positive-measure-analytic-kam-family",
            "lem-diophantine-resonance-slab-measure",
