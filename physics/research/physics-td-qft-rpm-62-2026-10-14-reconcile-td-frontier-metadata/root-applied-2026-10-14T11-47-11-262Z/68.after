        {
          "id": "post-em-circuit-approximation",
          "kind": "postulate",
          "domain": "physics",
          "title": "Electro- and magneto-quasistatic lumped circuit model",
          "reference": "definition-contracts.md#post-em-circuit-approximation",
          "design_state": "explicit-adopted-postulate-contract; nonproof-source-scope-review",
          "deps": [
            "post-em-material-closure",
            "def-em-steady-current-regime",
