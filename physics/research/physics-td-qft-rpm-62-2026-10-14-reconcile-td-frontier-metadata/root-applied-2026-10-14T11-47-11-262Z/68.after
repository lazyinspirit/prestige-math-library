          "sources": {
            "references": [
              {
                "title": "J. Binney and D. Skinner, The Physics of Quantum Mechanics, Section 6.3.1, printed pages 125-127 (PDF pages 133-135): entanglement with an unobserved environment, the reduced density operator and the loss of interference",
                "url": "https://www-thphys.physics.ox.ac.uk/people/JamesBinney/qb.pdf"
              },
              {
                "title": "B. Zwiebach, MIT 8.05 Quantum Physics II (Fall 2013), Chapter 8 'Multiparticle States and Tensor Products', Section 2, chapter pages 8-9: non-product two-particle vectors and the two-dimensional determinant criterion",
                "url": "https://ocw.mit.edu/courses/8-05-quantum-physics-ii-fall-2013/ffe665c0cba2eae19a83e88dec42925c_MIT8_05F13_Chap_08.pdf"
