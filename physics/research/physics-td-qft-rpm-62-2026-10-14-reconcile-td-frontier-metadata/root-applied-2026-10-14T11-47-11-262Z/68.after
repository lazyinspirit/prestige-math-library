        {
          "id": "lem-cm-piecewise-c1-jump-derivative",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "The distributional derivative of a piecewise $C^1$ function with a jump: $(u_p)'=u_{p'_{\\mathrm{reg}}}+[p]\\,\\delta_{t_*}$",
          "reference": "expansion-proofs.md#e11 (impulse jump identity)",
          "design_state": "completed-local-argument; recorded in the batch notes; declares AC_omega for the Lebesgue distribution suppliers",
          "dependency_level": 0,
          "deps": [
            "cor-mean-value-theorem",
            "def-regular-distribution-from-a-locally-integrable-function",
