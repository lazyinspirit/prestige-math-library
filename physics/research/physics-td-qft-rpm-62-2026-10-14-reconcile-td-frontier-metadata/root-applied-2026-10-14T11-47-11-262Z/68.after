    {
      "id": "gr-linearized-waves",
      "title": "Linearized Waves",
      "category": "general-relativity",
      "library": "physics",
      "companion": "gr-linearized-waves-examples",
      "kind": "A",
      "requires": [
        "construction-of-r-via-cauchy-sequences",
