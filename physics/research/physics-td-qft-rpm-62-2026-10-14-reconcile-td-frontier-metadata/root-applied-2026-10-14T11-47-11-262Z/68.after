            "pthm-cm08-rotation",
            "pthm-cm08-boost-boundary",
            "pthm-cm08-time-energy",
            "def-cm08-symmetry-of-the-mechanical-lagrangian",
            "def-cm07-action-and-mechanical-lagrangian",
            "def-cross-product-in-r3",
            "lem-cross-product-is-bilinear-alternating-and-orthogonal",
            "def-euclidean-inner-product",
            "thm-chain-rule-for-total-derivatives",
            "thm-algebra-of-derivatives",
            "def-ck-euclidean-maps-and-diffeomorphisms",
            "def-jacobian-matrix-and-gradient",
            "def-directional-and-partial-derivatives",
            "def-vector-valued-derivative-and-integral",
            "def-interval",
            "def-sine-and-cosine-by-power-series",
            "thm-sine-and-cosine-derivatives",
            "cor-trigonometric-parity-and-pythagorean-identity",
            "def-cm01-configuration",
            "def-cm01-units"
          ],
          "dependency_roles": {
            "post-cm02-interactions": "physical-assumption",
