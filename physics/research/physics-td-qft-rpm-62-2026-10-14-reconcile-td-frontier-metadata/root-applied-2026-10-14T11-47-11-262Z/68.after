        {
          "id": "thm-nrqm-controlled-dynamics-liouville-turning-point-transformation",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Liouville turning-point transformation",
          "dependency_level": 0,
          "deps": [
            "def-derivative",
            "def-continuity-real",
