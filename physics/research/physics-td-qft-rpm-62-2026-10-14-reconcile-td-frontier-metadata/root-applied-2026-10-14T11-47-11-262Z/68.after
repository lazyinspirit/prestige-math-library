          "id": "lem-em-newtonian-far-field-gradient",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "The far-field gradient of a compactly supported Newtonian potential",
          "reference": "local prerequisite added by batch 25 (see research/physics-em-sr-40-2026-10-08-batch-25.notes.md)",
