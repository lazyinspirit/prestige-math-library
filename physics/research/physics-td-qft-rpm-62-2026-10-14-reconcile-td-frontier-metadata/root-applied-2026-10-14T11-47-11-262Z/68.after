          ],
          "dependency_roles": {
            "def-cm-phase-domain-and-standard-symplectic-two-form": "mathematical-premise",
            "def-symplectic-form-and-symplectic-manifold": "mathematical-premise",
            "def-symplectic-vector-space": "mathematical-premise",
            "def-smooth-differential-k-form": "mathematical-premise",
            "thm-local-coordinate-formula-for-the-exterior-derivative": "mathematical-premise",
            "thm-the-exterior-derivative-squares-to-zero": "mathematical-premise",
            "def-linear-map": "mathematical-premise",
            "def-invertible-euclidean-linear-map": "mathematical-premise",
            "def-matrix-product-and-identity-matrix": "mathematical-premise",
            "def-metric-topology": "mathematical-premise",
            "def-ck-euclidean-maps-and-diffeomorphisms": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "provenance": {
            "statement": "ai-altered",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "Ana Cannas da Silva, Lectures on Symplectic Geometry, revised January 2006, Symplectic Manifolds (the symplectic form sum dq^i wedge dp_i on R^2n, closedness and nondegeneracy) and Lecture 18",
                "url": "https://web.archive.org/web/20120413034139if_/http://www.math.ist.utl.pt:80/%7Eacannas/Books/symplectic.pdf"
              },
              {
                "title": "D. Tong, Classical Dynamics (University of Cambridge Part II Mathematical Tripos), Section 4.1 (Hamilton's equations: contraction identities and the matrix epsilon used for the symplectic form), printed pages 80-88",
                "url": "https://www.davidtong.org/pdfs/teaching/classical-dynamics/clas.pdf"
              }
            ]
          },
          "statement": "Let $n\\ge1$, let $U$ be a phase domain with canonical one-form $\\lambda_U$, standard two-form\n$\\omega_U=\\sum_i dq^i\\wedge dp_i$ and matrix $J=\\begin{pmatrix}0_n&I_n\\\\-I_n&0_n\\end{pmatrix}$\n([[def-cm-phase-domain-and-standard-symplectic-two-form]]). For a point $z\\in U$ write\n$\\omega_z:=(\\omega_U)_z$. Then:\n\n1. $\\omega_U$ is closed: $d\\omega_U=0$;\n2. for all $v,w\\in\\mathbb R^{2n}$, written in the coordinate frame as $v=(a,b)$ and $w=(c,d)$ with\n   $a,b,c,d\\in\\mathbb R^n$, one has\n   $$\\omega_z(v,w)=v^{\\mathsf T}J\\,w=a\\cdot d-b\\cdot c ;$$\n3. for every $v=(a,b)\\in\\mathbb R^n\\times\\mathbb R^n$ the contraction is the covector\n   $$\\iota_v\\omega_z=\\sum_{i=1}^n a_i\\,dp_i-\\sum_{i=1}^n b_i\\,dq^i ;$$\n4. $J^{\\mathsf T}=-J$, $J^2=-I_{2n}$, and $J$ is invertible with $J^{-1}=J^{\\mathsf T}=-J$;\n5. consequently $v\\mapsto\\iota_v\\omega_z$ is a linear isomorphism $\\mathbb R^{2n}\\to(\\mathbb R^{2n})^*$,\n   so $\\omega_U$ is nondegenerate at every point and $(U,\\omega_U)$ is a symplectic manifold."
        },
        {
          "id": "prop-cm-hamiltonian-field-and-poisson-bracket-in-a-phase-chart",
          "kind": "proposition",
          "domain": "mathematics",
          "title": "The Hamiltonian field of a $C^2$ function on a phase domain is $J\\nabla H$, and the Poisson bracket is $\\sum_i(\\partial_{q^i}f\\,\\partial_{p_i}g-\\partial_{p_i}f\\,\\partial_{q^i}g)$",
          "reference": "expansion-proofs.md#e7",
          "design_state": "completed local argument; carrier and readiness record authored in this batch",
          "dependency_level": 2,
          "deps": [
            "def-cm-phase-domain-and-standard-symplectic-two-form",
