        {
          "id": "lem-em-half-space-harmonic-uniqueness-with-decay",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "Uniqueness for harmonic functions on a punctured half-space with zero trace, decaying at the pole and at infinity",
          "reference": "local prerequisite added by batch 26 (see research/physics-em-sr-40-2026-10-08-batch-26.notes.md)",
          "design_state": "new-local-prerequisite; complete-proof-strategy",
          "deps": [
