    {
      "id": "cm15-scattering-and-impulse-model-boundaries",
      "title": "Scattering and impulse model boundaries",
      "category": "non-relativistic-classical-mechanics",
      "library": "physics",
      "companion": "cm15-scattering-and-impulse-model-boundaries-examples",
      "kind": "A",
      "requires": [
