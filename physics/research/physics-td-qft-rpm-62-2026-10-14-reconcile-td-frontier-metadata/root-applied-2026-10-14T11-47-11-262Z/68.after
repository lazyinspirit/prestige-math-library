      "items": [
        {
          "id": "pthm-rpm-schwarzschild-circular-stability",
          "kind": "physics-theorem",
          "domain": "physics",
          "library": "physics",
          "title": "Lyapunov stability of Schwarzschild circular orbits in the fixed-angular-momentum radial system",
          "statement": "Adopt the Schwarzschild vacuum exterior model with $m_*>0$, $s=2G_Nm_*/c^2>0$ and $f(r)=1-s/r$, together with its ideal-free-fall rule that a massive test body follows a future timelike geodesic. For a fixed angular-momentum magnitude $\\ell>0$, set\n\n$$W_\\ell(r)=f(r)\\left(c^2+\\frac{\\ell^2}{r^2}\\right),\\qquad r>s.$$\n\nThe equatorial reduced radial system is\n\n$$\\dot r=w,\\qquad \\dot w=-\\frac12 W_\\ell'(r),$$\n\nwhere dot denotes proper-time derivative and $\\ell$ is held fixed. For every circular timelike radius $r_c>3s/2$, the corresponding equilibrium is\n\n$$z_c=(r_c,0),\\qquad \\ell^2=\\frac{c^2s r_c^2}{2r_c-3s}.$$\n\nThen this equilibrium is Lyapunov stable in the Euclidean phase space $(r,w)$ when $r_c>3s$, and is not Lyapunov stable when $3s/2<r_c\\le3s$. At $r_c=3s$ the equilibrium is a stationary inflection of $W_\\ell$, not a strict extremum, and is still not Lyapunov stable. These are conclusions about the reduced radial system at fixed $\\ell$ only.",
          "deps": [
            "pthm-gr-schwarzschild-vacuum-model",
            "post-gr-ideal-clocks-and-free-fall",
            "lem-gr-schwarzschild-timelike-geodesic-reduction",
            "lem-gr-schwarzschild-circular-orbits-and-photon-sphere",
            "def-cm-equilibrium-and-lyapunov-stability",
            "thm-picard-lindelof-local-existence-and-uniqueness",
            "thm-cm-compact-continuation-for-locally-lipschitz-odes"
          ],
          "dependency_roles": {
            "pthm-gr-schwarzschild-vacuum-model": "physical-result",
            "post-gr-ideal-clocks-and-free-fall": "physical-assumption",
            "lem-gr-schwarzschild-timelike-geodesic-reduction": "mathematical-premise",
            "lem-gr-schwarzschild-circular-orbits-and-photon-sphere": "mathematical-premise",
            "def-cm-equilibrium-and-lyapunov-stability": "mathematical-premise",
            "thm-picard-lindelof-local-existence-and-uniqueness": "mathematical-premise",
            "thm-cm-compact-continuation-for-locally-lipschitz-odes": "mathematical-premise"
          },
          "provenance": {
            "statement": "ai-altered",
            "proof": "ai-altered"
          },
          "dependency_level": 0,
          "sources": {
            "references": [
              {
                "title": "David Tong, General Relativity, author-hosted Chapter 1 HTML of the complete lecture notes, §§1.2.5 and 1.3.1–1.3.5 (printed pp. 24–46)",
                "url": "https://davidtong.org/teaching/general-relativity/grhtml/S1"
              },
              {
                "title": "Sean Carroll, Lecture Notes on General Relativity, complete lecture notes, §7, pp. 172–179",
                "url": "https://arxiv.org/pdf/gr-qc/9712019"
              }
            ]
          },
          "strategy": "direct",
          "physical_scope": "Conditional conclusion of the adopted Schwarzschild vacuum and free-fall model for the one-dimensional timelike radial subsystem at fixed angular momentum. Lyapunov stability is only for the reduced state (r, dr/dτ); it is not stability of the full spacetime orbit, against angular-momentum perturbations, or against radiation reaction, self-force, finite-size effects, or observations.",
          "proof_strategy": "direct"
        },
        {
          "id": "lem-rpm-schwarzschild-null-geodesic-reduction",
          "kind": "lemma",
          "domain": "mathematics",
          "library": "mathematics",
          "title": "Null geodesic radial first integral in the Schwarzschild exterior",
          "statement": "Let $(M,g,N)$ be the Schwarzschild exterior datum with $s>0$ and $f(r)=1-s/r$ on $r>s$. Let $\\gamma(\\lambda)$ be an affinely parametrized null geodesic of its metric-selected connection whose image lies in the equatorial plane $\\vartheta=\\pi/2$, and choose the orientation so that\n\n$$E:=f(r)\\frac{dx^0}{d\\lambda}>0,\\qquad L:=r^2\\frac{d\\varphi}{d\\lambda}\\ge0.$$\n\nBoth quantities are constant along $\\gamma$. With impact parameter $b:=L/E\\ge0$ and $H(r):=f(r)/r^2$, its radial equation is\n\n$$\\left(\\frac{dr}{d\\lambda}\\right)^2=E^2\\bigl(1-b^2H(r)\\bigr).$$\n\nMoreover, $H'(r)=(3s-2r)/r^4$, so $H$ has its unique exterior maximum at $r_{\\rm ph}=3s/2$, with $H(r_{\\rm ph})=4/(27s^2)$. Thus the critical impact parameter for a radial turning point is $b_{\\rm c}=3\\sqrt3\\,s/2$.",
          "deps": [
            "def-gr-schwarzschild-exterior-model",
            "lem-gr-schwarzschild-metric-properties",
            "def-gr-killing-field",
            "def-lie-derivative-of-a-tensor-field",
            "thm-gr-killing-and-on-shell-matter-identities",
            "def-geodesic-of-an-affine-connection",
            "def-gr-metric-selected-connection",
            "thm-gr-nondegenerate-levi-civita-and-tensor-derivative",
            "def-derivative",
            "thm-chain-rule",
            "thm-algebra-of-derivatives"
          ],
          "dependency_roles": {
