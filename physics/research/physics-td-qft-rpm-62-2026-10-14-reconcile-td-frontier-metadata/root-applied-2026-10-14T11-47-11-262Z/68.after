            "thm-monotone-change-of-variable-for-riemann-integrals": "mathematical-premise",
            "thm-monotonicity-of-the-integral": "mathematical-premise"
          },
          "provenance": {
            "statement": "ai-altered",
            "proof": "ai-altered"
