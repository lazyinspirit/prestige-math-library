        {
          "id": "ex-em-nonconserved-switched-charge",
          "kind": "example",
          "domain": "physics",
          "title": "A suddenly appearing point charge with zero current is inadmissible",
          "reference": "worked-example-verifications.md#X1",
          "design_state": "complete-exact-conditional-research-argument",
          "dependency_level": 17,
          "deps": [
            "pthm-em-charge-continuity",
            "def-em-weak-sources",
            "lem-em-point-current-continuity",
            "post-em-vacuum-maxwell",
            "post-em-distributional-vacuum-maxwell",
