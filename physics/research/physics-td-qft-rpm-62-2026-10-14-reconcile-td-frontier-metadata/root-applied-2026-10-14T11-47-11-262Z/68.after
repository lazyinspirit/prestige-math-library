          "sources": {
            "references": [
              {
                "title": "D. Tong, Quantum Mechanics (author-hosted lecture set), Section 2.1.2, printed pages 24-27 (PDF pages 27-30): the infinite potential well, its boundary conditions, eigenfunctions and quantized energies",
