        {
          "id": "lem-weighted-tail-contractions-give-c-one-curves",
          "kind": "lemma",
          "title": "Weighted half-tail contractions for $q_n=M_{s_n}(q_{n-1},q_{n+1})$ give a unique $C^1$ curve with tangent slope bounded by $c/(1-q)$",
          "dependency_level": 4,
          "deps": [
            "lem-bounded-bilateral-sequence-ball-is-complete",
            "def-isometry-and-metric-embedding",
            "thm-banach-fixed-point",
            "def-metric-space",
            "def-metric-convergence",
            "def-continuity-real",
            "def-ck-euclidean-maps-and-diffeomorphisms",
            "def-directional-and-partial-derivatives",
            "thm-chain-rule-for-total-derivatives",
            "thm-mean-value-inequality",
            "thm-extreme-value-metric",
            "thm-heine-borel-rn",
            "def-jacobian-matrix-and-gradient",
            "def-total-derivative-in-euclidean-space",
            "def-lipschitz-holder-contraction",
            "def-abs-value",
