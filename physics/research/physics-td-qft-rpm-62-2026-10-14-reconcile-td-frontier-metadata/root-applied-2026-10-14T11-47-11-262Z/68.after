        {
          "id": "pthm-td-measurable-canonical-identities",
          "kind": "physics-theorem",
          "domain": "physics",
          "title": "Measurable canonical identities for a dimensionless reference measure",
          "reference": "items/pthm-td-measurable-canonical-identities.md#statement",
          "design_state": "Complete draft carrier authored; scoped checks and prerequisite acceptance remain pending.",
          "dependency_level": 5,
          "deps": [
            "def-td-si-quantities",
            "def-tdmath-measure-integral",
            "post-td-canonical-sampling",
            "thm-tdmath-measurable-canonical-identities"
          ],
          "dependency_roles": {
            "def-td-si-quantities": "formulation-prerequisite",
            "def-tdmath-measure-integral": "mathematical-premise",
            "post-td-canonical-sampling": "physical-assumption",
            "thm-tdmath-measurable-canonical-identities": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "statement": "Let $(X,\\Sigma,\\mu)$ be a measure space with dimensionless reference measure, let $E:X\\to\\mathbb R\\,\\mathrm J$ be measurable, and let $J_\\beta\\subset(0,\\infty)$ be open. Suppose $Z(\\beta)=\\int_Xe^{-\\beta E}\\,d\\mu$ is positive and finite on $J_\\beta$, and for each compact $K\\subset J_\\beta$ there is an integrable $G_K\\ge0$ with $(1+|E|^2)e^{-\\beta E}\\le G_K$ for every $\\beta\\in K$. Under the canonical sampling assumption [[post-td-canonical-sampling]], define $p_\\beta=e^{-\\beta E}/Z$, $\\langle E\\rangle_\\beta=\\int E p_\\beta\\,d\\mu$, and $\\operatorname{Var}_\\beta(E)=\\int(E-\\langle E\\rangle_\\beta)^2p_\\beta\\,d\\mu$. Then $Z\\in C^2$, $-\\partial_\\beta\\log Z=\\langle E\\rangle_\\beta$, $\\partial_\\beta^2\\log Z=\\operatorname{Var}_\\beta(E)$, and the relative Gibbs entropy is finite with $S_\\beta=-k_{\\mathrm B}\\int p_\\beta\\log p_\\beta\\,d\\mu=k_{\\mathrm B}(\\log Z+\\beta\\langle E\\rangle_\\beta)$. Hence $F_{\\mathrm{stat}}=-k_{\\mathrm B}T\\log Z=\\langle E\\rangle_\\beta-TS_\\beta$ for $\\beta=(k_{\\mathrm B}T)^{-1}$.",
          "strategy": "direct",
          "provenance": {
            "statement": "ai-altered",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "David Tong, Statistical Physics, complete lecture notes, §§1.3–1.4 (printed pp. 18–30)",
                "url": "https://davidtong.org/pdfs/teaching/statistical-physics/statphys.pdf"
              },
              {
                "title": "Daniel Arovas, Lecture Notes on Thermodynamics and Statistical Mechanics, §§4.2–4.4 (printed pp. 192–208)",
                "url": "https://courses.physics.ucsd.edu/2025/Spring/physics210a/LECTURES/STATMECH.pdf"
              }
            ]
          },
          "library": "physics",
          "physical_scope": "Measurable energy models with a dimensionless reference measure, positive finite partition integral, and compact-parameter local integrable second-moment envelope; no claim is made for an arbitrary phase-space measure or unbounded energy without these hypotheses.",
          "verification": {
            "precheck": "pass"
          },
          "proof_strategy": "direct"
        },
        {
          "id": "pthm-td-finite-quantum-free-energy-minimum",
          "kind": "physics-theorem",
