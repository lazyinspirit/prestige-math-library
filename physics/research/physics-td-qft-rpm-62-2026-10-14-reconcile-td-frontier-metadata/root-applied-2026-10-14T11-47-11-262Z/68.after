        {
          "id": "def-em-ideal-harmonic-dipole-model",
          "kind": "definition",
          "domain": "physics",
          "title": "The ideal harmonic electric-dipole radiation model",
          "reference": "scaffold-added necessary model definition for the dipole scattering and Thomson items (see research/physics-em-sr-40-2026-10-08-batch-40.notes.md)",
          "design_state": "new-local-definition-prerequisite; complete-definition-contract",
          "deps": [
            "pthm-em-dipole-radiation",
