                "locator": "Complete author-hosted HTML section read; equations (3.123)–(3.144), collision production, detailed balance, and Maxwellian form."
              }
            ]
          },
          "library": "mathematics",
          "proof_strategy": "direct"
        },
        {
          "id": "thm-tdmath-regular-energy-shell-measure",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Coarea and invariant measure on compact regular energy shells",
          "reference": "items/thm-tdmath-regular-energy-shell-measure.md#statement",
          "design_state": "Complete draft carrier authored; scoped checks and independent review remain pending.",
          "dependency_level": 1,
          "deps": [
