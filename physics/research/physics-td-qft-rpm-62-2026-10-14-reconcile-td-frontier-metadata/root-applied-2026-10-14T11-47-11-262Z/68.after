          "id": "def-cm-time-dependent-lagrangian-and-action",
          "kind": "definition",
          "domain": "mathematics",
          "title": "A time-dependent Lagrangian chart, its action functional and its fixed-endpoint first variations",
          "reference": "mathematical-prerequisites.md#m3",
          "design_state": "completed-local-definition; recorded in the batch notes",
          "dependency_level": 0,
          "deps": [
            "def-ck-euclidean-maps-and-diffeomorphisms",
            "def-ck-and-multi-index-notation-in-several-variables",
            "def-directional-and-partial-derivatives",
