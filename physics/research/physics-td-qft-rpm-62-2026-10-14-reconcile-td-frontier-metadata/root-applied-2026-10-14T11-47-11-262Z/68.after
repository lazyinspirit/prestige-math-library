          "sources": {
            "references": [
              {
                "title": "J. Lebl, Tasty Bits of Several Complex Variables, Chapter 1, Sections 1.1-1.3 (holomorphic maps, power series, derivatives), printed pages 13-31",
                "url": "https://www.jirka.org/scv/scv.pdf"
