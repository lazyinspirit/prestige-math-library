          "dependency_level": 12,
          "sources": {
            "references": [
              {
                "title": "D. Tong, Quantum Mechanics (author-hosted lecture set), Section 2.3.2, printed pages 48-49 (PDF pages 51-52): the delta-function potential, the derivative jump condition, the single bound state and its energy",
                "url": "https://davidtong.org/pdfs/teaching/quantum-mechanics/qm.pdf"
