              },
              {
                "title": "F. H. L. Essler, Advanced Quantum Theory (Oxford lecture notes, 2017/18), Chapter 1 Section 1.2 printed pages 3-6 (PDF pages 4-7): occupation-number states and the number operator of a bosonic Fock space",
                "url": "http://www-thphys.physics.ox.ac.uk/courses/C6/C6_2017/C6Notes/lecturenotes2017AQT.pdf"
