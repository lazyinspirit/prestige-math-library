          "inventory_expansion_required": false,
          "statement": "Let $(X,\\Sigma,\\mu)$ be a measure space and let $f:X\\to[0,+\\infty]$ be\n$\\Sigma$-measurable. The nonnegative integral defined by\n[[def-tdmath-measure-integral]] equals the shared nonnegative Lebesgue integral\ndefined by [[def-nonnegative-lebesgue-integral]], with the same value in\n$[0,+\\infty]$.",
          "strategy": "proof_strategy: direct; complete numbered argument is in items/lem-tdmath-measure-integral-agrees-with-root-lebesgue-integral.md and its proof contract.",
          "provenance": {
            "statement": "ai-altered",
            "proof": "ai-generated"
          },
