          "id": "thm-nrqm-composites-joint-pvm-construction",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Joint PVM construction for strongly commuting regular projection-valued measures",
          "reference": "inventory.json#nrqm-composites-joint-pvm-construction; proof module M49 (scaffold/mathematical-prerequisites.md)",
          "design_state": "reserved-local-prerequisite; complete-conditional-argument",
          "dependency_level": 0,
          "deps": [
