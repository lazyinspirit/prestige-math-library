        {
          "id": "ex-td-finite-canonical-ground-state-entropy",
          "kind": "example",
          "domain": "physics",
          "title": "Residual entropy in a finite canonical model",
          "statement": "Let $X=\\{1,\\ldots,N\\}$ be a finite set of microstates with energy values $E_i$ in joules. Let $E_0=\\min_i E_i$, let exactly $g\\ge1$ states have energy $E_0$, and suppose every other state has energy at least $E_0+\\Delta$ for one fixed gap $\\Delta>0$ joules. For $T>0$ kelvins, adopt the finite canonical probabilities\n$\nw_i(T)=\\exp\\!\\left(-\\frac{E_i-E_0}{k_{\\mathrm B}T}\\right),\\qquad\nZ(T)=\\sum_{i=1}^{N}w_i(T),\\qquad\np_i(T)=\\frac{w_i(T)}{Z(T)}\n$\nand the model entropy\n$\nS_G(T)=-k_{\\mathrm B}\\sum_{i=1}^{N}p_i(T)\\log p_i(T).\n$\nThen\n$\n\\lim_{T\\downarrow0}S_G(T)=k_{\\mathrm B}\\log g.\n$\nThis is a calculation for the adopted finite statistical model, not a deduction of the canonical preparation from macroscopic thermodynamics.",
          "deps": [
            "def-td-si-quantities",
            "def-td-temperature-pressure-chemical-potential",
            "def-natural-logarithm",
            "thm-natural-logarithm-laws",
            "thm-exponential-limits-and-range",
            "thm-logarithm-slower-than-every-positive-power"
          ],
          "dependency_roles": {
            "def-td-si-quantities": "formulation-prerequisite",
            "def-td-temperature-pressure-chemical-potential": "formulation-prerequisite",
            "def-natural-logarithm": "mathematical-premise",
            "thm-natural-logarithm-laws": "mathematical-premise",
            "thm-exponential-limits-and-range": "mathematical-premise",
            "thm-logarithm-slower-than-every-positive-power": "mathematical-premise"
          },
          "provenance": {
            "statement": "literature-derived",
            "proof": "ai-generated"
          },
          "sources": {
            "references": [
              {
                "title": "David Tong, Statistical Physics, complete Chapter 4 lecture-note PDF, §4.5",
                "url": "https://davidtong.org/pdfs/teaching/statistical-physics/statphys4.pdf"
              },
              {
                "title": "Daniel Arovas, Lecture Notes on Thermodynamics and Statistical Mechanics, Chapter 2, §2.6.2",
                "url": "https://courses.physics.ucsd.edu/2025/Spring/physics210a/LECTURES/CH02.pdf"
              }
            ]
          },
          "dependency_level": 6,
          "library": "physics",
          "physical_scope": "A finite discrete Gibbs preparation with a specified energy gap and entropy convention; no identification with the macroscopic entropy postulate or empirical material is assumed.",
          "proof_strategy": "direct"
        },
        {
          "id": "ex-td-geometric-cooling-protocol",
          "kind": "example",
          "domain": "physics",
          "title": "A finite-step geometric cooling protocol",
          "statement": "Fix $T_*>0$ kelvins, an initial temperature $T_{\\mathrm{in}}\\in(0,T_*]$, a ratio $r\\in(0,1)$, and an operation duration $\\tau_*>0$ seconds. Define the model's zero-temperature boundary to be $D_0=\\{0\\}$ and its positive-temperature state coordinates to be $D_+=(0,T_*]$. Each admitted operation maps $T$ to $rT$ and takes duration $\\tau_*$. An admitted finite protocol is any finite chain of these operations; write $T_N$ for its endpoint after $N$ updates. Since the operation is defined only on $D_+$ and always maps into $D_+$, this restricted model has no operation with endpoint in $D_0$; the proof below is a direct property of its update rule, not evidence for the physical unattainability postulate. It does not assert that a real refrigerator or every thermodynamic model has this update rule.",
          "deps": [
            "def-td-si-quantities",
            "def-td-temperature-pressure-chemical-potential",
            "def-natural-numbers",
            "thm-induction-principle",
            "def-ordered-field"
          ],
          "dependency_roles": {
            "def-td-si-quantities": "formulation-prerequisite",
            "def-td-temperature-pressure-chemical-potential": "formulation-prerequisite",
            "def-natural-numbers": "mathematical-premise",
            "thm-induction-principle": "mathematical-premise",
            "def-ordered-field": "mathematical-premise"
          },
          "provenance": {
            "statement": "ai-generated",
            "proof": "ai-generated"
          },
          "dependency_level": 6,
          "library": "physics",
          "physical_scope": "A constructed update-map model with one finite-duration operation repeated finitely many times; it proves only this model's reachability property and is not evidence about actual cooling devices.",
          "generation": {
            "role": "example"
          },
          "relations": {
            "motivated_by": [
              "post-td-unattainability-scoped"
            ]
          },
          "proof_strategy": "induction"
        }
      ],
