          "dependency_roles": {
            "def-td-finite-microstate-model": "formulation-prerequisite",
            "post-td-canonical-sampling": "physical-assumption"
          },
          "inventory_expansion_required": false,
          "statement": "Let $\\Omega=\\{a,b\\}$ with energies $E_a=0$, $E_b=\\varepsilon>0$ joules, and fix $T>0$ kelvins. The separately adopted canonical law has probabilities proportional to $(1,e^{-\\beta\\varepsilon})$. For the dynamical comparison, use a dimensionless model-time parameter $\\tau\\ge0$, stipulate the identity transition map $\\Phi_\\tau(a)=a$, $\\Phi_\\tau(b)=b$ for all $\\tau$, and start with the point mass $\\delta_a$.",
          "strategy": "direct",
          "provenance": {
            "statement": "ai-generated",
            "proof": "ai-generated"
          },
          "sources": {
            "references": [
              {
                "title": "David Tong, Statistical Physics, complete lecture notes, §1.3",
                "url": "https://davidtong.org/pdfs/teaching/statistical-physics/statphys.pdf"
