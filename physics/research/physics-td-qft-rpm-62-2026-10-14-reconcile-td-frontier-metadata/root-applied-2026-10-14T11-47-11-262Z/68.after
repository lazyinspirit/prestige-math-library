          "kind": "theorem",
          "domain": "mathematics",
          "title": "Graph-domain Ehrenfest identities and the conditional timescale bound",
          "reference": "inventory.json#nrqm-magnetic-and-detection-graph-domain-ehrenfest-and-timescale; proof module M50 (scaffold/mathematical-prerequisites.md)",
          "design_state": "reserved-local-prerequisite; complete-conditional-argument",
