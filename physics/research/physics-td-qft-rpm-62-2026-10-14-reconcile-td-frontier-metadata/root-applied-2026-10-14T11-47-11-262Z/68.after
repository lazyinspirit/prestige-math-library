          "id": "texp-em-classical-orbit-instability",
          "kind": "thought-experiment",
          "domain": "physics",
          "title": "Conditional radius loss of a prescribed slowly orbiting charge in a reduced quasistatic model",
          "reference": "core-conditional-proofs.md#K9",
          "design_state": "complete-exact-conditional-research-argument",
          "deps": [
            "pthm-em-larmor-nonrelativistic",
            "post-em-lorentz-coupling",
