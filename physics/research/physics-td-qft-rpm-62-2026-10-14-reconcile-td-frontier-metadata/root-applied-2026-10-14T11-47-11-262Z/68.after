                "url": "https://people.phys.ethz.ch/~nbeisert/lectures/ED-24FS-Skript.pdf",
                "locator": "printed pp. 12.8-12.10, eqs. (12.36)-(12.45): cross section, dipole scattering, dielectric sphere"
              }
