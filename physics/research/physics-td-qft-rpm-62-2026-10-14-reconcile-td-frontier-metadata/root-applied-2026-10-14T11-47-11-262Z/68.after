          "id": "lem-three-dimensional-radial-carleman-integer-weight",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "Three-dimensional radial Carleman inequality with integer weight",
          "reference": "audit-expansion-2026-10-03/root-ucp-compact-scattering.md#radial-carleman-inequality-in-three-dimensions",
          "design_state": "local-research-proof-written; exact-hypotheses-retained; not published and not engine-certified",
