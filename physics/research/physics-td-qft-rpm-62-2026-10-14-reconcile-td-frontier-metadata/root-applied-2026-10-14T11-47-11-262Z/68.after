        {
          "id": "thm-cm-work-energy-balance",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Work-energy balance $\\frac{d}{dt}\\bigl(K+U(t,x(t))\\bigr)=\\partial_tU(t,x(t))+\\sum_i\\langle d_i(t),x_i'(t)\\rangle$ for forces $m_ix_i''=-\\nabla_{x_i}U+d_i$",
          "reference": "mathematical-prerequisites.md#m2",
          "design_state": "completed-local-argument; recorded in the batch notes",
          "dependency_level": 1,
          "deps": [
            "lem-cm-derivative-of-pairings-of-curves",
