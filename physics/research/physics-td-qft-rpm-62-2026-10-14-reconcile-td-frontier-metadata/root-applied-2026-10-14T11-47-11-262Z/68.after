      "items": [
        {
          "id": "def-tdmath-countable-canonical-model",
          "kind": "definition",
          "domain": "mathematics",
          "title": "Countable canonical model",
          "reference": "research/physics-td-qft-rpm-62-2026-10-14-batch-11.notes.md#item-inventory",
          "design_state": "Draft definition carrier recorded; scoped checks and independent review remain pending.",
          "dependency_level": 0,
          "deps": [
            "def-complete-ordered-field",
            "def-finite-sum",
            "def-natural-logarithm",
            "def-real-exponential-function-and-e",
            "def-series"
          ],
          "justified_by": [],
          "dependency_roles": {
            "def-complete-ordered-field": "mathematical-premise",
            "def-finite-sum": "mathematical-premise",
            "def-natural-logarithm": "mathematical-premise",
            "def-real-exponential-function-and-e": "mathematical-premise",
            "def-series": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "statement": "Let $I$ be a nonempty finite or countably infinite set equipped with a specified enumeration, let $E_i\\in\\mathbb R$ be finite energies, let $g_i>0$ be weights, and let $J\\subseteq\\mathbb R$ be an open parameter interval. For a nonnegative family $(a_i)_{i\\in I}$ define $\\sum_{i\\in I}a_i:=\\sup_{F\\subset I,\\,F\\text{ finite}}\\sum_{i\\in F}a_i$, with finite sums as in [[def-finite-sum]] and the supremum as in [[def-complete-ordered-field]] when the finite subsums are bounded; set the value to $+\\infty$ when they are unbounded. This definition is independent of the specified enumeration. For $\\beta\\in J$, define the nonnegative partition sum $Z(\\beta):=\\sum_{i\\in I}g_i\\exp(-\\beta E_i)$ by this rule. The admissible parameter set is $J_Z:=\\{\\beta\\in J:0<Z(\\beta)<\\infty\\}$. For $\\beta\\in J_Z$, define $p_i(\\beta):=g_i\\exp(-\\beta E_i)/Z(\\beta)$; then $(p_i)$ is a countable probability law. For any real observable $X_i$ with $\\sum_i p_i|X_i|<\\infty$, define $\\langle X\\rangle_\\beta:=\\sum_i p_iX_i$. If $\\sum_i|p_i\\log(p_i/g_i)|<\\infty$, define the reference-relative entropy $H_g(p):=-\\sum_i p_i\\log(p_i/g_i)$. When $g_i=1$, this is the Shannon entropy with natural logarithms. A lower bound on the energies alone is not part of this definition and does not imply $Z(\\beta)<\\infty$. For countably infinite $I$, any specified enumeration is used only to write a list; the nonnegative sum itself is the supremum over finite subsums above.",
          "strategy": "proof_strategy: direct; complete numbered argument is in items/def-tdmath-countable-canonical-model.md and its proof contract.",
          "provenance": {
            "statement": "literature-derived",
            "proof": "not-applicable"
          },
          "sources": {
            "references": [
              {
                "title": "David Tong, Statistical Physics, author-hosted complete HTML chapter text",
                "url": "https://davidtong.org/teaching/statistical-physics/statmechhtml/S1",
                "locator": "Full author-hosted HTML chapter text read; §§1.3–1.4, printed pp.17–30, for canonical and grand-canonical normalizations and responses."
              },
              {
                "title": "Daniel Arovas, Lecture Notes on Thermodynamics and Statistical Mechanics (work in progress, dated 12 October 2026)",
                "url": "https://courses.physics.ucsd.edu/2025/Spring/physics210a/LECTURES/STATMECH.pdf",
                "locator": "Complete 635-page PDF retrieved; §§4.2–4.6, printed pp.192–217, for microcanonical, canonical, quantum trace and grand-canonical constructions."
              }
            ]
          },
          "library": "mathematics"
        },
        {
          "id": "thm-tdmath-summable-canonical-differentiation",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Summable canonical differentiation",
          "reference": "research/physics-td-qft-rpm-62-2026-10-14-batch-11.notes.md#item-inventory",
          "design_state": "Complete draft proof recorded; scoped checks and independent review remain pending.",
          "dependency_level": 1,
          "deps": [
            "cor-mean-value-theorem",
            "def-natural-logarithm",
            "def-real-exponential-function-and-e",
            "def-series",
            "def-tdmath-countable-canonical-model",
            "thm-chain-rule",
            "thm-derivative-of-exponential",
            "thm-logarithm-derivative-and-integral"
          ],
          "justified_by": [],
          "dependency_roles": {
            "cor-mean-value-theorem": "mathematical-premise",
            "def-natural-logarithm": "mathematical-premise",
            "def-real-exponential-function-and-e": "mathematical-premise",
            "def-series": "mathematical-premise",
            "def-tdmath-countable-canonical-model": "mathematical-premise",
            "thm-chain-rule": "mathematical-premise",
            "thm-derivative-of-exponential": "mathematical-premise",
            "thm-logarithm-derivative-and-integral": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "statement": "Let $I,E_i,g_i,J,Z$ be as in [[def-tdmath-countable-canonical-model]]. Suppose that for every compact interval $K\\subset J$ there is a summable sequence $a_i\\ge0$ such that $g_i(1+|E_i|^2)\\exp(-\\beta E_i)\\le a_i$ for every $i\\in I$ and $\\beta\\in K$. Then $Z$ is positive, finite, and $C^2$ on $J$, with $Z'(\\beta)=-\\sum_i g_iE_i\\exp(-\\beta E_i)$ and $Z''(\\beta)=\\sum_i g_iE_i^2\\exp(-\\beta E_i)$. The probabilities $p_i$ are normalized; their mean $\\bar E$ and variance are finite and satisfy $-\\partial_\\beta\\log Z=\\bar E$ and $\\partial_\\beta^2\\log Z=\\operatorname{Var}_\\beta(E)$. Moreover $H_g(p)=\\log Z+\\beta\\bar E$, and its defining series is absolutely convergent.",
          "strategy": "proof_strategy: direct; complete numbered argument is in items/thm-tdmath-summable-canonical-differentiation.md and its proof contract.",
          "provenance": {
            "statement": "literature-derived",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "David Tong, Statistical Physics, author-hosted complete HTML chapter text",
                "url": "https://davidtong.org/teaching/statistical-physics/statmechhtml/S1",
                "locator": "Full author-hosted HTML chapter text read; §§1.3–1.4, printed pp.17–30, for canonical and grand-canonical normalizations and responses."
              },
              {
                "title": "Daniel Arovas, Lecture Notes on Thermodynamics and Statistical Mechanics (work in progress, dated 12 October 2026)",
                "url": "https://courses.physics.ucsd.edu/2025/Spring/physics210a/LECTURES/STATMECH.pdf",
                "locator": "Complete 635-page PDF retrieved; §§4.2–4.6, printed pp.192–217, for microcanonical, canonical, quantum trace and grand-canonical constructions."
              }
            ]
          },
          "library": "mathematics",
          "proof_strategy": "direct"
        },
        {
          "id": "def-tdmath-diagonal-operator-model",
          "kind": "definition",
          "domain": "mathematics",
          "title": "Diagonal self-adjoint operator model",
          "reference": "research/physics-td-qft-rpm-62-2026-10-14-batch-11.notes.md#item-inventory",
          "design_state": "Draft definition carrier recorded; scoped checks and independent review remain pending.",
          "dependency_level": 0,
          "deps": [
            "def-hilbert-space",
            "def-square-summable-family-on-an-arbitrary-index-set",
            "def-unbounded-linear-operator-domain-and-graph"
          ],
          "justified_by": [
            "lem-tdmath-diagonal-model-hilbert-and-domain"
          ],
          "dependency_roles": {
            "def-hilbert-space": "mathematical-premise",
            "def-square-summable-family-on-an-arbitrary-index-set": "mathematical-premise",
            "def-unbounded-linear-operator-domain-and-graph": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "statement": "Let $I$ be a finite or countably infinite set with a specified enumeration, let $E_i\\in\\mathbb R$, and let $\\ell^2(I):=\\{x:I\\to\\mathbb C:\\sum_i|x_i|^2<\\infty\\}$ with inner product $\\langle x,y\\rangle=\\sum_i x_i\\overline{y_i}$, linear in the first variable. Write $u_i$ for the coordinate unit vector at $i$. The diagonal multiplication operator $H_E$ is the linear operator with domain $D(H_E):=\\{x\\in\\ell^2(I):\\sum_i|E_ix_i|^2<\\infty\\}$ and action $(H_Ex)_i:=E_ix_i$. [[lem-tdmath-diagonal-model-hilbert-and-domain]] proves completeness of the coefficient space, linearity and density of this domain, and linearity of the coordinate action before the Hilbert-space operator interpretation is used. Its domain is part of the operator data in the sense of [[def-unbounded-linear-operator-domain-and-graph]].",
          "strategy": "proof_strategy: direct; complete numbered argument is in items/def-tdmath-diagonal-operator-model.md and its proof contract.",
          "provenance": {
            "statement": "literature-derived",
            "proof": "not-applicable"
          },
          "sources": {
            "references": [
              {
                "title": "Daniel Arovas, Lecture Notes on Thermodynamics and Statistical Mechanics (work in progress, dated 12 October 2026)",
                "url": "https://courses.physics.ucsd.edu/2025/Spring/physics210a/LECTURES/STATMECH.pdf",
                "locator": "Complete 635-page PDF retrieved; §§4.2–4.6, printed pp.192–217, for microcanonical, canonical, quantum trace and grand-canonical constructions."
              }
            ]
          },
          "library": "mathematics"
        },
        {
          "id": "lem-tdmath-diagonal-model-hilbert-and-domain",
          "reference": "research/physics-td-qft-rpm-62-2026-10-14-owner-step2-batches12-17-round1/new11-inventory-proposal.json",
          "design_state": "Established local prerequisite authored and released; independent review pending.",
          "inventory_expansion_required": false,
          "strategy": "proof_strategy: direct; complete argument is in items/lem-tdmath-diagonal-model-hilbert-and-domain.md; root integrates the released proof contract.",
          "dependency_level": 1,
          "kind": "lemma",
          "title": "Completeness and linear domain of the diagonal sequence model",
          "domain": "mathematics",
