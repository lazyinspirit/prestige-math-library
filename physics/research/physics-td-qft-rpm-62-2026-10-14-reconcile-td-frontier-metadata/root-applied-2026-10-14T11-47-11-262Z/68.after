        {
          "id": "lem-em-rectangle-mode-profile-identities",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "The separated sine and cosine rectangle profiles: eigen-identities, boundary traces, orthogonality and Dirichlet integrals",
          "reference": "completed-expansion-arguments.md#G1-G2; scaffold-added necessary prerequisite (see batch-35 notes)",
          "design_state": "new-local-prerequisite; complete-proof-strategy",
          "dependency_level": 0,
          "deps": [
            "def-directional-and-partial-derivatives",
            "def-laplacian-of-a-c2-function",
            "def-multidimensional-rectangle-and-volume",
            "thm-continuous-on-a-rectangle-is-riemann-integrable",
