      "items": [
        {
          "id": "def-em-field-action-definition",
          "kind": "definition",
          "domain": "physics",
          "title": "Smooth finite-region Maxwell action, compact variations and the fixed-endpoint particle functional",
          "reference": "definition-contracts.md#def-em-field-action-definition",
          "design_state": "explicit-definition-contract; supplier-validation-recorded-separately",
          "deps": [
            "def-em-electromagnetic-tensor",
            "def-em-lab-geometry",
            "def-em-si-conventions",
            "def-em-sources",
            "def-em-relativistic-worldlines-frames",
