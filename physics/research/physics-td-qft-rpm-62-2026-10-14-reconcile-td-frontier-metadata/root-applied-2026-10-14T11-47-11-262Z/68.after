    {
      "id": "qm-measurement-and-instruments-examples",
      "title": "Qm Measurement And Instruments — Examples",
      "kind": "B",
      "category": "non-relativistic-quantum-mechanics",
      "library": "physics",
      "companion": "qm-measurement-and-instruments",
