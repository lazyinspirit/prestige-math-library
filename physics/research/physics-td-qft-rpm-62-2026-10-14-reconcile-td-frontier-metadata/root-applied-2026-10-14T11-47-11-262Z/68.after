        {
          "id": "pthm-em-lienard-wiechert",
          "kind": "physics-theorem",
          "domain": "physics",
          "title": "Retarded point fields off the worldline: Lienard-Wiechert potentials, the velocity/acceleration split and the uniform far-zone remainder",
          "reference": "completed-expansion-arguments.md#R1-R2",
          "design_state": "complete-explicit-branch-argument; not-independent-acceptance",
          "deps": [
            "def-em-retarded-point-geometry",
            "pthm-em-retarded-potentials",
            "lem-em-point-retarded-potential-and-fields",
            "thm-em-retarded-root-and-fields",
            "post-em-radiation-selection",
            "def-em-weak-sources",
            "def-em-potential-gauge-and-field-conventions",
            "def-em-fields",
            "def-em-sources",
            "def-em-relativistic-worldlines-frames",
