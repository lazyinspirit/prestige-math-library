          "id": "pthm-em-rectangular-mode-candidates",
          "kind": "physics-theorem",
          "domain": "physics",
          "title": "The separated TE and TM candidate modes of the lossless rectangular PEC guide: exact verification, index restrictions and cutoff",
          "reference": "completed-expansion-arguments.md#G1",
          "design_state": "complete-exact-conditional-research-argument",
          "dependency_level": 18,
          "deps": [
