            "references": [
              {
                "title": "B. Zwiebach, MIT 8.05 Quantum Physics II (Fall 2013), Chapter 6 'Quantum Dynamics', Sections 4.3-4.5 printed pages 30-39 (PDF pages 30-39): coherent states, their classical mean motion and the translation (displacement) operator",
                "url": "https://ocw.mit.edu/courses/8-05-quantum-physics-ii-fall-2013/79a8091ef4f18d8e3ff76a097e8db33c_MIT8_05F13_Chap_06.pdf"
