        {
          "id": "thm-tdmath-finite-bath-error-bound",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Finite-bath canonical error bound",
          "reference": "research/physics-td-qft-rpm-62-2026-10-14-batch-11.notes.md#item-inventory",
          "design_state": "Complete draft proof recorded; scoped checks and independent review remain pending.",
          "dependency_level": 1,
          "deps": [
            "cor-taylor-remainder-bound",
            "def-natural-logarithm",
            "def-real-exponential-function-and-e",
            "def-tdmath-countable-canonical-model",
            "thm-natural-logarithm-laws"
          ],
          "justified_by": [],
          "dependency_roles": {
            "cor-taylor-remainder-bound": "mathematical-premise",
            "def-natural-logarithm": "mathematical-premise",
            "def-real-exponential-function-and-e": "mathematical-premise",
            "def-tdmath-countable-canonical-model": "mathematical-premise",
            "thm-natural-logarithm-laws": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "statement": "Let $I$ be a finite nonempty subsystem state set, let $E_i\\in\\mathbb R$ satisfy $|E_i|\\le L$ for $L\\ge0$, and let the dimensionless bath entropy $s_B$ be $C^2$ on an open interval $U$ containing $[u_0-L,u_0+L]$, with $|s_B''(u)|\\le M$ on that closed interval for $M\\ge0$. Use one energy unit for $E_i,u_0,L$, so $\\beta=s_B'(u_0)$ has inverse-energy units and $M$ has inverse-energy-squared units; $\\delta=ML^2/2$ is dimensionless. Put $Z:=\\sum_{j\\in I}e^{-\\beta E_j}$ and $q_i:=e^{-\\beta E_i}/Z$. Suppose the joint shell weights induce the normalized subsystem law $p_i:=e^{s_B(u_0-E_i)}/\\sum_{j\\in I}e^{s_B(u_0-E_j)}$. Then $|s_B(u_0-E_i)-s_B(u_0)+\\beta E_i|\\le\\delta$ for every $i$, and $\\sum_i|p_i-q_i|\\le e^{2\\delta}-1$.",
          "strategy": "proof_strategy: direct; complete numbered argument is in items/thm-tdmath-finite-bath-error-bound.md and its proof contract.",
          "provenance": {
            "statement": "literature-derived",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "David Tong, Statistical Physics, author-hosted complete HTML chapter text",
                "url": "https://davidtong.org/teaching/statistical-physics/statmechhtml/S1",
                "locator": "Full author-hosted HTML chapter text read; canonical/grand-canonical ensembles §§1.3–1.4 pp.17–30; two-state model §1.2.3 pp.11–14; 1D Ising §5.3.1 pp.156–157."
              },
              {
                "title": "Daniel Arovas, Lecture Notes on Thermodynamics and Statistical Mechanics (work in progress, dated 12 October 2026)",
                "url": "https://courses.physics.ucsd.edu/2025/Spring/physics210a/LECTURES/STATMECH.pdf",
                "locator": "Complete 635-page PDF retrieved; ensembles and traces §§4.2–4.6 pp.192–217; Bose/Fermi models §§5.6–5.7 pp.277–303; 1D Ising §6.2.2 pp.330–333."
              }
            ]
          },
          "library": "mathematics",
          "proof_strategy": "direct"
        },
        {
