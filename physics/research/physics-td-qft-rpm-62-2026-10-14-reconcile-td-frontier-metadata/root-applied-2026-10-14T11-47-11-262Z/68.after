          "library": "physics",
          "proof_strategy": "direct"
        },
        {
          "id": "ex-rpm-null-scale",
          "kind": "example",
          "domain": "physics",
          "title": "One null ray with distinct momentum scales",
          "statement": "In a prescribed background, let $I\\subseteq\\mathbb R$ be a nonempty open interval and let $x:I\\to M$ be an affinely parametrized nonzero future-null free geodesic with momentum $P=dx/d\\lambda$. For any constant $a>0$, on the rescaled open interval $I/a:=\\{\\lambda/a:\\lambda\\in I\\}$ the same ray image admits momentum $P_a=aP$ using the affine parameter $\\lambda_a=\\lambda/a$.",
          "deps": [
            "pthm-rpm-free-massive-and-null-geodesics",
            "def-rpm-mechanical-momentum-and-observer-energy"
          ],
          "dependency_roles": {
            "pthm-rpm-free-massive-and-null-geodesics": "physical-result",
            "def-rpm-mechanical-momentum-and-observer-energy": "formulation-prerequisite"
          },
          "provenance": {
            "statement": "ai-generated",
