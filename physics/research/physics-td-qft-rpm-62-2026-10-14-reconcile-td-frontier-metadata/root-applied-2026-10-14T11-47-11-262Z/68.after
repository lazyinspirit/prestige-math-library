        {
          "id": "lem-em-coulomb-dipole-remainder",
          "kind": "lemma",
          "title": "Monopole-dipole expansion with an explicit remainder for compactly supported $L^1$ densities",
          "domain": "mathematics",
          "deps": [
            "def-l-one-of-a-measure",
