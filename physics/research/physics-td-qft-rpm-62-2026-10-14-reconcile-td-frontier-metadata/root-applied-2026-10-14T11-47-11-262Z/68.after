        {
          "id": "thm-nrqm-oscillator-multidimensional-oscillator-completeness",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Multidimensional oscillator completeness",
          "reference": "inventory.json#nrqm-oscillator-multidimensional-oscillator-completeness; proof module M12 (scaffold/mathematical-prerequisites.md)",
          "design_state": "reserved-local-prerequisite; complete-conditional-argument",
          "dependency_level": 4,
          "deps": [
            "lem-nrqm-oscillator-diagonal-adjoint-and-graph-core-lemma",
            "thm-nrqm-oscillator-diagonal-spectrum",
            "thm-nrqm-oscillator-hermite-recurrence",
            "thm-nrqm-oscillator-hermite-orthogonality",
            "thm-nrqm-oscillator-hermite-completeness",
            "thm-nrqm-oscillator-oscillator-scaling-and-exact-realization",
            "lem-nrqm-composites-hilbert-tensor-construction",
            "lem-nrqm-composites-bounded-tensor-maps",
            "lem-nrqm-composites-euclidean-l2-product-unitary",
            "thm-stars-and-bars",
