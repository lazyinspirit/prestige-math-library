        {
          "id": "lem-nrqm-intervals-weak-derivative-ac-representative",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "Absolutely continuous representative of an L2 function with L2 weak derivative",
          "reference": "inventory.json#nrqm-intervals-and-contacts-weak-derivative-ac-representative; proof module M19 (scaffold/mathematical-prerequisites.md)",
          "design_state": "reserved-local-prerequisite; complete-conditional-argument",
          "dependency_level": 1,
          "deps": [
