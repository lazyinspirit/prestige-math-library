    {
      "id": "sr-worldlines-and-clocks",
      "title": "Worldlines And Clocks",
      "category": "special-relativity",
      "library": "physics",
      "companion": "sr-worldlines-and-clocks-examples",
      "kind": "A",
      "requires": [
        "sr-lorentz-transformations",
        "monotone-functions-and-discontinuities",
        "monotone-sequences-and-cauchy-completeness",
        "properties-of-the-integral-and-the-working-ftc",
