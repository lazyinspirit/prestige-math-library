    {
      "id": "td-continuum-heat-model",
      "title": "Continuum Heat Model",
      "category": "thermodynamics",
      "library": "physics",
      "companion": "td-continuum-heat-model-examples",
      "kind": "A",
      "requires": [
        "td-entropy-foundation",
        "td-math-local-pfaff-geometry",
