        {
          "id": "ex-td-reaction-boundary-example",
          "kind": "example",
          "domain": "physics",
          "title": "A boundary reaction minimum with a one-sided extent",
          "reference": "items/ex-td-reaction-boundary-example.md",
          "design_state": "Step 1 complete draft; readiness recorded separately.",
          "dependency_level": 10,
          "deps": [
            "lem-tdmath-stoichiometric-tangent-cone"
          ],
          "dependency_roles": {
            "lem-tdmath-stoichiometric-tangent-cone": "mathematical-premise"
          },
          "physical_scope": "A constructed units-labelled tangent-cone optimization illustration with one zero-amount boundary; it makes no thermodynamic-equilibrium, material, or empirical claim.",
          "inventory_expansion_required": false,
          "statement": "Use species $A,B$, one reaction column $\\nu=(-1,1)^{\\mathsf T}$, and starting amounts $n_A^0=0$ mol, $n_B^0=1$ mol. The admissible extents are $\\xi\\in[-1,0]$ mol because $n_A(\\xi)=-\\xi$ and $n_B(\\xi)=1\\,\\mathrm{mol}+\\xi$ must both be nonnegative. Let $\\Phi_0$ have units joules and define an ambient affine potential on an open neighborhood of the nonnegative amount region by\n$$\n\\widehat\\Phi(n_A,n_B)=\\Phi_0+1\\,\\mathrm J-(1\\,\\mathrm{J\\,mol^{-1}})n_B .\n$$\nAlong $n(\\xi)=(-\\xi,1\\,\\mathrm{mol}+\\xi)$, set $\\Phi(\\xi):=\\widehat\\Phi(n(\\xi))=\\Phi_0-(1\\,\\mathrm{J\\,mol^{-1}})\\xi$. Its derivative-defined amount coefficients are $\\mu_A:=\\partial_{n_A}\\widehat\\Phi=0$ and $\\mu_B:=\\partial_{n_B}\\widehat\\Phi=-1\\,\\mathrm{J\\,mol^{-1}}$, including at $\\xi_*=0$ mol. This ambient extension is constructed optimization data only; no positive-mole thermodynamic chart at $n_A=0$ or physical realization is asserted.",
          "provenance": {
            "statement": "ai-generated",
            "proof": "ai-generated"
          },
          "sources": {
            "references": [
              {
                "title": "Konstantin K. Likharev, Essential Graduate Physics: Statistical Mechanics, §4.1 First-order phase transitions",
                "url": "https://phys.libretexts.org/Bookshelves/Thermodynamics_and_Statistical_Mechanics/Essential_Graduate_Physics_-_Statistical_Mechanics_%28Likharev%29/04%3A_Phase_Transitions/4.01%3A_First_order_phase_transitions"
              }
            ]
          },
          "library": "physics",
          "strategy": "direct",
          "generation": {
            "role": "example"
          },
          "proof_strategy": "direct"
        },
        {
          "id": "cex-td-noncompact-phase-mixture-no-attained-maximum",
          "kind": "counterexample",
          "domain": "physics",
          "title": "A noncompact phase domain with no attained mixture maximum",
          "reference": "items/cex-td-noncompact-phase-mixture-no-attained-maximum.md",
          "design_state": "Step 1 complete draft; readiness recorded separately.",
          "dependency_level": 10,
          "deps": [
            "def-borel-sigma-algebra",
            "def-probability-measure",
            "def-tdmath-measure-integral"
          ],
          "dependency_roles": {
            "def-borel-sigma-algebra": "mathematical-premise",
            "def-probability-measure": "mathematical-premise",
            "def-tdmath-measure-integral": "mathematical-premise"
          },
          "physical_scope": "A constructed continuous entropy extension that is positive and concave on a convex ambient domain but restricted to a noncompact generator set omitting its maximizing barycenter; it makes no material claim.",
          "inventory_expansion_required": false,
          "statement": "Let $d\\ge1$, let $K\\subseteq C\\subseteq\\mathbb R^d$ with $K$ noncompact and $C$ convex, and let $\\mathcal P$ be a nonempty family of Borel probability measures on $K$ sharing a prescribed barycenter. The statement refuted is that $\\sup_{P\\in\\mathcal P}\\int_Ks\\,dP$ is always attained whenever $s=\\widetilde s|_K$ for a bounded, positive, continuous concave function $\\widetilde s:C\\to\\mathbb R$. Here convexity of $C$ means $(1-t)x+ty\\in C$ for $x,y\\in C$ and $t\\in[0,1]$, and concavity means\n$$\n\\widetilde s((1-t)x+ty)\\ge(1-t)\\widetilde s(x)+t\\widetilde s(y)\\qquad(x,y\\in C,\\ t\\in[0,1]).\n$$",
          "provenance": {
            "statement": "ai-generated",
            "proof": "ai-generated"
          },
          "sources": {
            "references": [
              {
                "title": "David Tong, Statistical Physics, author-hosted complete lecture notes, §5.4.3",
                "url": "https://davidtong.org/teaching/statistical-physics/statmechhtml/S5"
              },
              {
                "title": "Konstantin K. Likharev, Essential Graduate Physics: Statistical Mechanics, §4.1 First-order phase transitions",
                "url": "https://phys.libretexts.org/Bookshelves/Thermodynamics_and_Statistical_Mechanics/Essential_Graduate_Physics_-_Statistical_Mechanics_%28Likharev%29/04%3A_Phase_Transitions/4.01%3A_First_order_phase_transitions"
              }
            ]
          },
          "library": "physics",
          "strategy": "direct",
          "generation": {
            "role": "counterexample"
          },
          "proof_strategy": "direct"
        },
        {
          "id": "ex-td-compact-continuous-phase-mixture",
          "kind": "example",
          "domain": "physics",
          "title": "A compact two-generator mixture attains the d+1 support bound",
          "reference": "items/ex-td-compact-continuous-phase-mixture.md",
          "design_state": "Step 1 complete draft; readiness recorded separately.",
          "dependency_level": 10,
          "deps": [
