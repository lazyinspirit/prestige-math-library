          "id": "lem-discrete-young-and-sobolev-product",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "Discrete Young inequality, the Sobolev product bound, and the transport product bound on the torus",
          "reference": "local-fluid-wellposedness.md (E30)",
