        {
          "id": "lem-em-smooth-forced-maxwell-cauchy-system",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "The smooth forced Maxwell Cauchy system on a slab: existence, uniqueness, Gauss constraints and the c-cone of dependence",
          "reference": "completed-expansion-arguments.md#W7",
          "design_state": "complete-exact-conditional-research-argument",
          "dependency_level": 3,
          "deps": [
            "cor-zero-derivative-implies-constant",
