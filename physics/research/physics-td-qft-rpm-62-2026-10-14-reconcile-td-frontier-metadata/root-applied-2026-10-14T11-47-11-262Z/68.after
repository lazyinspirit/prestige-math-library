        {
          "id": "thm-tdmath-independent-microcanonical-block-limit",
          "kind": "theorem",
          "domain": "mathematics",
          "title": "Finite-site microcanonical and canonical block equivalence",
          "reference": "items/thm-tdmath-independent-microcanonical-block-limit.md#statement",
          "design_state": "Complete draft carrier authored; scoped checks and independent review remain pending.",
          "dependency_level": 1,
          "deps": [
            "def-tdmath-finite-site-shell-and-canonical-law",
            "def-finite-sum",
            "def-natural-logarithm",
            "def-real-exponential-function-and-e",
