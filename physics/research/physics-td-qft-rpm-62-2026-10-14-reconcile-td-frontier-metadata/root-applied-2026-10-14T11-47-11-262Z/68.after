          "id": "def-nrqm-intervals-hilbert-sobolev-spaces",
          "kind": "definition",
          "domain": "mathematics",
          "title": "One-dimensional Sobolev spaces on intervals",
          "reference": "local prerequisite added by this batch (closure of the reserved claims)",
          "design_state": "batch-local prerequisite; complete-conditional-argument",
          "dependency_level": 0,
          "deps": [
            "def-weak-derivative-of-a-locally-integrable-function",
            "def-locally-integrable-function-as-a-regular-distribution",
            "def-complex-lp-and-euclidean-test-function-conventions",
            "def-l-p-space-as-a-quotient-by-null-functions",
