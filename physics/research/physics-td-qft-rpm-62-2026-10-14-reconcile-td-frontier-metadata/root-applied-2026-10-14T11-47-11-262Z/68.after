          "id": "ex-tdmath-two-level-canonical-fluctuations",
          "kind": "example",
          "domain": "mathematics",
          "title": "Canonical mean and variance for a two-level system",
          "reference": "research/physics-td-qft-rpm-62-2026-10-14-batch-11.notes.md#item-inventory",
          "design_state": "Complete draft proof recorded; scoped checks and independent review remain pending.",
          "dependency_level": 2,
          "deps": [
            "def-tdmath-countable-canonical-model",
            "thm-tdmath-summable-canonical-differentiation"
          ],
          "justified_by": [],
          "dependency_roles": {
            "def-tdmath-countable-canonical-model": "mathematical-premise",
            "thm-tdmath-summable-canonical-differentiation": "mathematical-premise"
          },
          "inventory_expansion_required": false,
          "statement": "Let the state set be $\\{0,1\\}$, with energies $E_0=0$, $E_1=\\varepsilon>0$, unit weights, and $\\beta>0$. Writing $q=e^{-\\beta\\varepsilon}$, the excited-state probability is $q/(1+q)$, the mean energy is $\\varepsilon q/(1+q)$, and the energy variance is $\\varepsilon^2q/(1+q)^2>0$.",
          "strategy": "proof_strategy: direct; complete numbered argument is in items/ex-tdmath-two-level-canonical-fluctuations.md and its proof contract.",
