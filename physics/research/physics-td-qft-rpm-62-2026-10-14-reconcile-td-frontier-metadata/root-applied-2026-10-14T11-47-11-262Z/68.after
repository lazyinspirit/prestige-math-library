          "id": "ex-nrqm-magnetic-and-detection-finite-dark-bin-probability",
          "kind": "example",
          "domain": "mathematics",
          "title": "A dark bin of positive length has positive coherent probability",
          "reference": "inventory.json#nrqm-magnetic-and-detection-finite-dark-bin-probability; proof module M27 (scaffold/mathematical-prerequisites.md)",
          "design_state": "reserved-local-prerequisite; complete-conditional-argument",
