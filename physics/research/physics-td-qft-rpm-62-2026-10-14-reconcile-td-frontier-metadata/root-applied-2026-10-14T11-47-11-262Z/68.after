        {
          "id": "lem-em-rectangular-transverse-mode-completeness",
          "kind": "lemma",
          "domain": "mathematics",
          "title": "The sine and cosine systems are complete orthogonal systems of L^2 on an interval and on a rectangle",
          "reference": "completed-expansion-arguments.md#G2; scaffold-added necessary prerequisite (see batch-35 notes)",
          "design_state": "new-local-prerequisite; complete-proof-strategy",
          "dependency_level": 1,
          "deps": [
