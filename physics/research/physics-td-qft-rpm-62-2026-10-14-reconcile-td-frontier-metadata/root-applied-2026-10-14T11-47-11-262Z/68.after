          "kind": "theorem",
          "domain": "mathematics",
          "title": "Control-volume balance: mass and momentum rates for a moving non-material region",
          "reference": "expansion-proofs.md#e13",
          "design_state": "completed-local-argument; recorded in the batch notes",
