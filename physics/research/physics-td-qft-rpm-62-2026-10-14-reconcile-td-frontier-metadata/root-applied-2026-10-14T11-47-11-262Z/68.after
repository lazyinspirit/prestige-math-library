          "id": "ex-em-boosted-fields-example",
          "kind": "example",
          "domain": "physics",
          "title": "Boosted uniform electric field and the mixed magnetic field",
          "reference": "worked-example-verifications.md#X8",
          "design_state": "complete-exact-conditional-research-argument",
          "deps": [
            "pthm-em-lorentz-field-transform",
