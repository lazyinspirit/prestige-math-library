    {
      "id": "cm-math-approximation",
      "title": "Cm Math Approximation",
      "category": "non-relativistic-classical-mechanics-mathematics",
      "library": "mathematics",
      "companion": "cm-math-approximation-examples",
      "kind": "A",
      "requires": [
        "cm-math-dynamics",
        "bounded-linear-operators-and-quotient-spaces",
        "complex-differentiability-and-cauchy-riemann",
        "field-extensions-and-the-complex-numbers",
