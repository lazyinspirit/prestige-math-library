        "id": "rem-qft-local-wick-diagonal-obligation",
        "kind": "remark",
        "domain": "mathematics",
        "library": "mathematics",
        "physical_scope": null,
        "title": "Local Wick diagonal products need additional prerequisites",
        "reference": "research/plan-quantum-field-theory-track.md#regular-polynomial-field-functional-algebra",
        "design_state": "Verifies that a nonzero local quartic has a nonzero diagonal second-derivative distribution outside the regular class.",
        "dependency_level": 7,
        "deps": [
          "def-qft-regular-polynomial-functional-algebra",
          "lem-qft-tensor-test-function-density",
          "thm-qft-diagonal-delta-distribution",
