      {
        "id": "cex-rpm-lad-force-free-runaway",
        "kind": "counterexample",
        "domain": "physics",
        "title": "Force-free runaway solution of the LAD equation",
        "statement": "Within the adopted flat LAD effective equation with $\\tau_e>0$ and zero prescribed external field, every smooth future-timelike proper-time solution defined for all future proper times has bounded proper acceleration toward the future. This is an assertion about the adopted ODE, not an empirical statement about a finite charge.",
        "deps": [
