    "items": [
      {
        "id": "lem-rpm-finite-time-ode-comparison",
        "kind": "lemma",
        "domain": "mathematics",
        "title": "Finite-time comparison of bounded vector fields",
        "statement": "Let $n\\ge1$, $T\\ge0$, $U\\subseteq\\mathbb R^n$ be open, and $K\\subseteq U$ be compact and convex. Let $F_\\epsilon,F_0:[0,T]\\times U\\to\\mathbb R^n$ be continuous. Suppose that on $[0,T]\\times K$ both fields are bounded in the Euclidean norm by $B\\ge0$, the comparison field $F_0$ is state-Lipschitz with constant $L\\ge0$, and\n\n$$\\|F_\\epsilon(t,z)-F_0(t,z)\\|_2\\le\\eta\\qquad(t\\in[0,T],\\ z\\in K)$$\n\nfor some $\\eta\\ge0$. Let $z_\\epsilon,z_0\\in C^1([0,T],\\mathbb R^n)$ solve $\\dot z_\\epsilon=F_\\epsilon(t,z_\\epsilon)$ and $\\dot z_0=F_0(t,z_0)$, with both trajectories contained in $K$. Then, for every $t\\in[0,T]$,\n\n$$\\|z_\\epsilon(t)-z_0(t)\\|_2\\le\\bigl(\\|z_\\epsilon(0)-z_0(0)\\|_2+\\eta t\\bigr)e^{Lt}.$$\n\nIn particular, equal initial states give $\\sup_{0\\le t\\le T}\\|z_\\epsilon(t)-z_0(t)\\|_2\\le\\eta T e^{LT}$. The field bound $B$ alone is not a stability hypothesis; the comparison-field Lipschitz bound $L$ and uniform field error $\\eta$ are part of the assumptions. No existence through $T$ follows unless the trajectories are known to exist there.",
        "deps": [
          "def-vector-valued-derivative-and-integral",
          "thm-componentwise-limits-and-continuity",
          "thm-continuous-implies-integrable",
          "cor-vector-valued-ftc-and-lipschitz-bound",
          "thm-norm-inequality-for-the-vector-valued-integral",
          "thm-gronwall-integral-inequality"
        ],
        "dependency_roles": {
          "def-vector-valued-derivative-and-integral": "mathematical-premise",
          "thm-componentwise-limits-and-continuity": "mathematical-premise",
          "thm-continuous-implies-integrable": "mathematical-premise",
          "cor-vector-valued-ftc-and-lipschitz-bound": "mathematical-premise",
          "thm-norm-inequality-for-the-vector-valued-integral": "mathematical-premise",
          "thm-gronwall-integral-inequality": "mathematical-premise"
        },
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "dependency_level": 0,
        "sources": {
          "references": [
            {
              "title": "Gautam Iyer, Brief Notes on Introduction to Differential Equations, complete ODE notes",
              "url": "https://www.math.cmu.edu/~gautam/c/2026-632/notes/existence.html"
