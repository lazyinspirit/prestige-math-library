            },
            {
              "title": "Richard S. Laugesen, Spectral Theory of Partial Differential Equations — Lecture Notes, Chapter 4, pp.27–32",
              "url": "https://arxiv.org/pdf/1203.2344v1"
            }
          ]
        },
