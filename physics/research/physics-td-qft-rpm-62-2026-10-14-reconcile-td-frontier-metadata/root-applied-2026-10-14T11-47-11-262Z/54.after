      {
        "id": "def-qft-free-field-observables",
        "kind": "definition",
        "domain": "physics",
        "title": "Specified free state and observable interpretation",
        "reference": "research/extended-frameworks-2026-10-03/quantum-field-theory/workers/free-fields/proof-modules.md#FF7",
        "design_state": "Defines the selected smeared scalar and even Dirac observables, vacuum states, generator domains and Born reading. The current QFT-MF04 carrier omits the planned charged-number domain extension.",
        "dependency_level": 7,
        "deps": [
