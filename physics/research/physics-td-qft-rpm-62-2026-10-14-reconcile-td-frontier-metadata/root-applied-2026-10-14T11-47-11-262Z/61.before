          "lem-qft-free-domain-observables",
          "lem-qft-scalar-local-weyl-algebra",
          "lem-qft-free-dirac-car-locality",
          "thm-dominated-convergence"
        ],
        "dependency_roles": {
          "def-qft-framework-units": "formulation-prerequisite",
          "def-countable-choice": "mathematical-premise",
          "post-qft-free-field-model": "physical-assumption",
          "post-qft-constructed-model-and-measurement": "physical-assumption",
          "def-qft-free-field-observables": "formulation-prerequisite",
          "lem-qft-free-domain-observables": "mathematical-premise",
          "lem-qft-scalar-local-weyl-algebra": "mathematical-premise",
          "lem-qft-free-dirac-car-locality": "mathematical-premise",
          "thm-dominated-convergence": "mathematical-premise"
        },
        "physical_scope": "The selected flat four-dimensional real scalar bosonic and Dirac CAR Fock models, with their chosen vacua and bounded smeared observable algebras. Operator-domain and point-smearing conclusions are conditional on the named mathematical carriers. No interacting theory, pointwise field operator, coincident product, thermal trace, apparatus, or empirical outcome is asserted.",
        "empirical_premises": [],
        "statement": "For the selected free scalar and Dirac Fock models, the named self-adjoint generators have the exact maximal domains of the inspected mathematical carrier; normalized vectors in D(A) have finite means and variances, while products use composition domains. The specified scalar Weyl and even Dirac local algebras commute for pairwise spacelike-separated regions. Normalized Gaussian spacetime scalar and equal-time Dirac tests approximate point masses, but their vacuum-vector and operator norms diverge, respectively, so they have no finite limits in those norm topologies. Pointwise fields and coincident products are not defined; Born probabilities apply only to a supplied state and finite bounded instrument.",
        "proof_strategy": "direct",
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "David Tong, Quantum Field Theory, author-hosted complete lecture notes, Chapter 2, §§2.2, 2.3 and 2.6.1",
              "url": "https://www.damtp.cam.ac.uk/user/tong/qft/qfthtml/S2.html"
            },
            {
              "title": "Mark Srednicki, Quantum Field Theory, Part I: Spin Zero, author prepublication textbook draft, arXiv:hep-th/0409035v1",
              "url": "https://arxiv.org/html/hep-th/0409035"
            },
            {
              "title": "Mark Srednicki, Quantum Field Theory, Part II: Spin One Half, author prepublication textbook draft, arXiv:hep-th/0409036v1",
              "url": "https://arxiv.org/html/hep-th/0409036"
            },
            {
              "title": "Christopher J. Fewster and Kasia Rejzner, Algebraic Quantum Field Theory—an introduction, complete author manuscript, arXiv:1904.04051v2",
              "url": "https://arxiv.org/html/1904.04051v2"
            }
          ]
        }
      },
      {
        "id": "pthm-qft-classical-quantum-free-correspondence",
        "kind": "physics-theorem",
        "domain": "physics",
        "title": "Classical equations and adopted exact free quantum representation",
        "reference": "research/extended-frameworks-2026-10-03/quantum-field-theory/proposed-inventory.json#QFT-F04",
        "design_state": "Checks the classical compact-variation scalar and Dirac equations against the tested equations of the separately adopted free representations. Quantization and statistics assignments are model assumptions, not deductions from the classical actions.",
        "dependency_level": 7,
        "deps": [
          "def-qft-framework-units",
          "def-countable-choice",
          "post-qft-free-field-model",
          "lem-qft-free-action-equations",
          "lem-qft-mass-shell-test-restriction-continuity",
