        "id": "cex-qft-point-operator-assumption",
        "kind": "counterexample",
        "domain": "physics",
        "title": "A sharp pointfield is not a Fock-vacuum-domain operator",
        "reference": "research/extended-frameworks-2026-10-03/quantum-field-theory/proposed-inventory.json#QFT-F04",
        "design_state": "Refutes the finite vacuum-vector norm-limit claim for the specified normalized scalar Gaussian spacetime-smearing family; it does not exclude other distributional or renormalized constructions.",
        "dependency_level": 9,
        "deps": [
          "thm-dominated-convergence",
          "pthm-qft-free-observable-domain-limits"
        ],
        "dependency_roles": {
          "thm-dominated-convergence": "mathematical-premise",
          "pthm-qft-free-observable-domain-limits": "physical-result"
        },
        "physical_scope": "The normalized Gaussian spacetime-smearing family for the real scalar field in the selected four-dimensional free Fock vacuum. It refutes only convergence in this representation's vacuum-vector norm; distributional or renormalized point-field constructions in other senses are outside scope. No empirical observation is asserted.",
        "empirical_premises": [],
        "statement": "Under the hypotheses of pthm-qft-free-observable-domain-limits, the normalized scalar Gaussian tests approximate a point mass but their vacuum vectors have unbounded norms as their widths tend to zero. Therefore they cannot converge in Fock norm to a finite vector defining a sharp point field.",
        "proof_strategy": "direct",
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
