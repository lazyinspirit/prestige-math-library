    "items": [
      {
        "id": "ex-td-macrocell-and-gibbs-entropy",
        "kind": "example",
        "domain": "physics",
        "title": "A macrocell count and a nonuniform microscopic distribution",
        "reference": "items/ex-td-macrocell-and-gibbs-entropy.md#example",
        "design_state": "Draft carrier authored; prerequisites and independent review pending.",
        "dependency_level": 6,
        "deps": [
          "def-td-macro-versus-micro-entropy-claim",
          "def-td-si-quantities",
          "def-natural-logarithm",
          "thm-natural-logarithm-laws",
          "def-finite-sum"
        ],
        "justified_by": [],
        "dependency_roles": {
          "def-td-macro-versus-micro-entropy-claim": "formulation-prerequisite",
          "def-td-si-quantities": "formulation-prerequisite",
          "def-natural-logarithm": "mathematical-premise",
          "thm-natural-logarithm-laws": "mathematical-premise",
          "def-finite-sum": "mathematical-premise"
        },
        "inventory_expansion_required": false,
        "statement": "Let $\\Omega=\\{\\omega_1,\\omega_2\\}$, put both states in one macrocell $M_m=\\Omega$, and assign $p_1=1,\\ p_2=0$. The model is deliberately nonuniform. It shows that the macrocell-count definition and the Gibbs–Shannon definition can take different values on separately specified inputs.",
        "provenance": {
          "statement": "ai-generated",
          "proof": "ai-generated"
        },
        "sources": {
          "references": []
        },
        "library": "physics",
        "physical_scope": "A stipulated two-microstate finite model with a nonuniform probability vector; it is not an equilibrium preparation, measurement or empirical claim.",
        "strategy": "direct"
      },
      {
        "id": "ex-td-mean-vs-trial-outcome",
        "kind": "example",
        "domain": "physics",
        "title": "Positive ensemble mean with a negative realization",
        "reference": "items/ex-td-mean-vs-trial-outcome.md#example",
        "design_state": "Draft carrier authored; prerequisites and independent review pending.",
        "dependency_level": 7,
        "deps": [
          "rem-td-fluctuation-model-hypotheses"
        ],
        "justified_by": [],
        "dependency_roles": {
          "rem-td-fluctuation-model-hypotheses": "formulation-prerequisite"
        },
        "inventory_expansion_required": false,
        "statement": "Let $a>0$ have units $\\mathrm{J\\,K^{-1}}$. On two outcomes $\\omega_+$ and $\\omega_-$, assign probabilities $3/4$ and $1/4$, and assign a random variable $Y$ the values $Y(\\omega_+)=2a$ and $Y(\\omega_-)=-2a$. The label $Y$ is only an illustrative entropy-valued variable; this example adopts no physical path law.\n\nThis arithmetic example illustrates the distinction in [[rem-td-fluctuation-model-hypotheses]].",
        "provenance": {
          "statement": "ai-generated",
          "proof": "ai-generated"
        },
        "sources": {
          "references": []
        },
        "library": "physics",
        "physical_scope": "A two-outcome probability model for an illustrative entropy-valued random variable; it is not a specified physical fluctuation law or reported observation.",
        "strategy": "direct"
      },
      {
        "id": "ex-td-local-equilibrium-profile",
        "kind": "example",
        "domain": "physics",
        "title": "A nonconstant local-equilibrium temperature field",
        "reference": "items/ex-td-local-equilibrium-profile.md#example",
        "design_state": "Draft carrier authored; prerequisites and independent review pending.",
        "dependency_level": 1,
        "deps": [
          "rem-td-local-equilibrium-branch"
        ],
        "justified_by": [],
        "dependency_roles": {
          "rem-td-local-equilibrium-branch": "formulation-prerequisite"
