    "items": [
      {
        "id": "ex-qftmath-x01",
        "kind": "example",
        "domain": "mathematics",
        "title": "Worked example B01 — exact finite dynamics and its first coefficient",
        "statement": "Use the two-level matrix model of [[thm-qft-example-finite-dyson-unitarity]] with $H=g_E\\sigma_x$, where $g_E>0$ is in joules. At\n$$t_1=\\frac{\\pi\\hbar}{2g_E}>0,$$\nthe exact off-diagonal matrix-element square is $1$, while its first-order squared coefficient is $\\pi^2/4>1$. At $t_2=\\pi\\hbar/g_E$, the exact survival matrix-element square is $1$, whereas $e^{-\\Gamma t_2}<1$ for every positive rate $\\Gamma$ in $\\mathrm{s}^{-1}$. These are finite-matrix identities. A later Born-rule interpretation may assign the exact square a probability; the mathematics here assigns no probability to an amplitude.",
        "deps": [
          "def-countable-choice",
          "def-qft-example-data",
          "thm-qft-example-finite-dyson-unitarity"
        ],
        "dependency_roles": {
          "def-countable-choice": "mathematical-premise",
          "def-qft-example-data": "mathematical-premise",
          "thm-qft-example-finite-dyson-unitarity": "mathematical-premise"
        },
        "provenance": {
          "statement": "ai-generated",
          "proof": "ai-generated"
        },
        "generation": {
          "role": "example"
        },
        "sources": {
          "references": [
            {
              "title": "David Tong, Quantum Field Theory, §3.1.1 Dyson's Formula",
              "url": "https://www.damtp.cam.ac.uk/user/tong/qft/qfthtml/S3.html"
            },
            {
              "title": "R. Fitzpatrick, Quantum Mechanics, Chapter 13",
              "url": "https://farside.ph.utexas.edu/teaching/qmech/qmech.pdf"
            }
          ]
        },
        "dependency_level": 2,
        "proof_strategy": "direct"
      },
      {
        "id": "ex-qftmath-x03",
        "kind": "example",
        "domain": "mathematics",
        "title": "Worked example B03 — nonretarded one-mode correlator",
        "statement": "For the one-mode oscillator in [[lem-qft-example-oscillator-feynman-prescription]], choose $t_*=-\\pi/(2\\omega)$, where $\\omega>0$ is in $\\mathrm{s}^{-1}$. Then the normalized Feynman correlator is $-i/(2\\omega)$, while the retarded response kernel is zero. The nonzero negative-time correlation is not a response to a future source.",
        "deps": [
          "def-countable-choice",
          "def-qft-example-data",
          "lem-qft-example-oscillator-feynman-prescription"
        ],
        "dependency_roles": {
