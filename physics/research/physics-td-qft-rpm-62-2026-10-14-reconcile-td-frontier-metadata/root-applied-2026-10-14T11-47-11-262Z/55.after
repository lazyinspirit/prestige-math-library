      {
        "id": "pthm-qft-qed-classical-coupling",
        "kind": "physics-theorem",
        "domain": "physics",
        "title": "Conditional classical charged gauge equations and current",
        "reference": "research/extended-frameworks-2026-10-03/quantum-field-theory/workers/qed/proofs.md#Q1",
        "design_state": "Derives the smooth classical Dirac and Maxwell equations and conserved charge current from compactly supported variations.",
        "dependency_level": 9,
        "deps": [
          "post-qft-qed-local-coupling",
          "def-qft-framework-units",
          "def-qft-qed-physical-gauge-quantities",
          "def-qft-qed-gauge-data",
          "def-qft-dirac-projections",
