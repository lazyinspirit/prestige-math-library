          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "Daniel Arovas, Thermodynamics and Statistical Mechanics, §2.7",
              "url": "https://phys.libretexts.org/Bookshelves/Thermodynamics_and_Statistical_Mechanics/Book:_Thermodynamics_and_Statistical_Mechanics_(Arovas)/02:_Thermodynamics/2.07:_Thermodynamic_Potentials"
            },
            {
              "title": "Jeremy Tatum, Heat and Thermodynamics, §12.5, Summary, Maxwell Relations, and Gibbs-Helmholtz Relations",
              "url": "https://phys.libretexts.org/Bookshelves/Thermodynamics_and_Statistical_Mechanics/Heat_and_Thermodynamics_(Tatum)/12:_Free_Energy/12.05:_Summary_the_Maxwell_Relations_and_the_Gibbs-Helmholtz_Relations"
            }
          ]
        },
        "dependency_level": 8,
        "inventory_expansion_required": false,
        "physical_scope": "Exact local differential identities on positive-temperature, C2, single-phase energy-representation charts with the stated Legendre coordinate maps invertible; no identity is asserted at singular response charts or phase boundaries.",
        "library": "physics",
        "proof_strategy": "direct"
      },
      {
        "id": "pthm-td-euler-and-gibbs-duhem",
        "kind": "physics-theorem",
        "domain": "physics",
        "title": "Euler and Gibbs-Duhem identities under same-tag homogeneity",
        "statement": "Let $C$ be the open positive-temperature domain of a local C2 energy representation $\\mathcal U_c(s,V,n)$ for a fixed material constitution $c$, with $V>0$, $n_j>0$, and conjugates $T=\\mathcal U_{c,s}$, $p=-\\mathcal U_{c,V}$, and $\\mu_j=\\mathcal U_{c,n_j}$. Let $W\\subseteq C$ be open. In addition to the framework suppliers, assume the **same-tag homogeneity hypothesis**: for every $q=(s,V,n_1,\\ldots,n_r)\\in W$ there is an $\\varepsilon_q\\in(0,1)$ such that\n\n$$\\mathcal U_c(\\lambda s,\\lambda V,\\lambda n_1,\\ldots,\\lambda n_r)=\\lambda\\mathcal U_c(s,V,n_1,\\ldots,n_r)$$\n\nfor every $\\lambda>0$ with $|\\lambda-1|<\\varepsilon_q$ and $\\lambda q\\in C$. Then, throughout $W$,\n\n$$\\mathcal U_c=Ts-pV+\\sum_{j=1}^r\\mu_jn_j,$$\n\nand on the same chart\n\n$$s\\,dT-V\\,dp+\\sum_{j=1}^r n_j\\,d\\mu_j=0.$$\n\nThe same-tag hypothesis is supplied, in particular, when the inverse states $\\Psi(q):=(\\mathcal U_c(q),V,n)$ for $q\\in W$ lie in the designated common-law cone of [[post-td-common-bulk-constitutive-law]], expressed in physical SI coordinate values using the fixed unit conversion. On this branch the adopted entropy transport implies the energy homogeneity locally by uniqueness of the local inverse; no global inverse or global energy-domain cone is assumed. These are conditional model deductions. The general tagged relation in [[post-td-concave-fundamental-entropy]] alone does not identify the scaled system with one fixed constitutive law.",
        "deps": [
          "post-td-bulk-additivity",
          "post-td-concave-fundamental-entropy",
          "post-td-common-bulk-constitutive-law",
          "pthm-td-local-energy-representation",
          "pthm-td-potential-differentials",
          "lem-tdmath-euler-identity-for-degree-one-homogeneous-function",
          "thm-chain-sum-product-and-composition-rules-for-banach-derivatives"
        ],
        "dependency_roles": {
          "post-td-bulk-additivity": "physical-assumption",
          "post-td-concave-fundamental-entropy": "physical-assumption",
          "post-td-common-bulk-constitutive-law": "physical-assumption",
          "pthm-td-local-energy-representation": "physical-result",
          "pthm-td-potential-differentials": "physical-result",
          "lem-tdmath-euler-identity-for-degree-one-homogeneous-function": "mathematical-premise",
          "thm-chain-sum-product-and-composition-rules-for-banach-derivatives": "mathematical-premise"
        },
        "provenance": {
