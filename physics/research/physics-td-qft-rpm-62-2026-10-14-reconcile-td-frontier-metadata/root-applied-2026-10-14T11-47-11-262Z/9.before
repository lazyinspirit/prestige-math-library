      {
        "id": "lem-tdmath-integrable-horizontal-orbits-have-empty-interior",
        "reference": "items/lem-tdmath-integrable-horizontal-orbits-have-empty-interior.md",
        "design_state": "Owner escalation prerequisite authored; draft with independent pipeline review pending.",
        "inventory_expansion_required": false,
        "kind": "lemma",
        "domain": "mathematics",
        "library": "mathematics",
        "title": "Horizontal orbits under local first integrals have empty interior",
        "deps": [
          "def-tdmath-one-form-and-horizontal-path",
          "lem-tdmath-local-contraction-flow",
          "lem-tdmath-variational-flow-and-commutation",
          "thm-tdmath-local-implicit-rank",
          "thm-chain-rule-for-total-derivatives",
          "cor-mean-value-theorem",
          "thm-connected-subsets-of-r-are-intervals",
          "thm-rationals-countable",
          "lem-q-and-irrationals-dense-r",
          "thm-heine-borel-rn",
          "thm-continuous-image-of-a-compact-space-is-compact",
          "thm-compact-subset-is-closed-and-bounded",
          "thm-euclidean-space-complete",
          "thm-recursion",
          "thm-well-ordering-principle"
        ],
        "dependency_roles": {
          "def-tdmath-one-form-and-horizontal-path": "mathematical-premise",
          "lem-tdmath-local-contraction-flow": "mathematical-premise",
          "lem-tdmath-variational-flow-and-commutation": "mathematical-premise",
          "thm-tdmath-local-implicit-rank": "mathematical-premise",
          "thm-chain-rule-for-total-derivatives": "mathematical-premise",
          "cor-mean-value-theorem": "mathematical-premise",
          "thm-connected-subsets-of-r-are-intervals": "mathematical-premise",
          "thm-rationals-countable": "mathematical-premise",
          "lem-q-and-irrationals-dense-r": "mathematical-premise",
          "thm-heine-borel-rn": "mathematical-premise",
          "thm-continuous-image-of-a-compact-space-is-compact": "mathematical-premise",
          "thm-compact-subset-is-closed-and-bounded": "mathematical-premise",
          "thm-euclidean-space-complete": "mathematical-premise",
          "thm-recursion": "mathematical-premise",
          "thm-well-ordering-principle": "mathematical-premise"
        },
        "statement": "Let $U\\subseteq\\mathbb R^{n+1}$, $n\\ge1$, be open, and let $\\omega$ be a nowhere-zero $C^2$ one-form, with the horizontal paths of [[def-tdmath-one-form-and-horizontal-path]]. Assume that every point has a neighborhood $W$ with $S\\in C^2(W)$ and nowhere-zero $\\mu\\in C^1(W)$ satisfying $dS=\\mu\\omega$. For every $q\\in U$, its horizontal reachability class in $U$ is contained in a countable union of compact subsets of $U$ with empty interior. Consequently every nonempty open $V\\subseteq U$ contains a point not horizontally reachable from $q$ by any horizontal path in $U$. In particular, if $q\\in V$, that point is not reachable by a path contained in $V$. No global first integral or choice axiom is assumed.",
        "dependency_level": 2,
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        }
      },
      {
        "id": "thm-tdmath-local-caratheodory-inaccessibility",
        "kind": "theorem",
        "deps": [
          "lem-tdmath-integrable-horizontal-orbits-have-empty-interior",
          "def-tdmath-one-form-and-horizontal-path",
          "lem-tdmath-local-contraction-flow",
          "lem-tdmath-variational-flow-and-commutation",
          "thm-tdmath-codimension-one-frobenius",
          "thm-tdmath-local-implicit-rank"
        ],
        "dependency_level": 3,
        "domain": "mathematics",
        "library": "mathematics",
        "title": "Local horizontal inaccessibility and Pfaff integrability",
        "dependency_roles": {
          "lem-tdmath-integrable-horizontal-orbits-have-empty-interior": "mathematical-premise",
          "def-tdmath-one-form-and-horizontal-path": "mathematical-premise",
          "lem-tdmath-local-contraction-flow": "mathematical-premise",
          "lem-tdmath-variational-flow-and-commutation": "mathematical-premise",
          "thm-tdmath-codimension-one-frobenius": "mathematical-premise",
          "thm-tdmath-local-implicit-rank": "mathematical-premise"
        },
        "statement": "Let $U\\subseteq\\mathbb R^{n+1}$, $n\\ge1$, be open and let $\\omega$ be a nowhere-zero $C^2$ one-form. Suppose horizontal paths and local reachability are as in [[def-tdmath-one-form-and-horizontal-path]]. The following are equivalent: (a) for every $q\\in U$ and every open neighborhood $V$ of $q$ contained in $U$, some $p\\in V$ is not horizontally reachable from $q$ by a path contained in $V$; (b) every $q\\in U$ has a neighborhood $W$ and $\\mu\\in C^1(W)$ nowhere zero, $S\\in C^2(W)$ with $dS=\\mu\\omega$. Both conditions are local. This is a mathematical theorem about the declared horizontal-path relation; identifying that relation with physical adiabatic processes is an additional modeling assumption.",
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        }
      }
    ]
  },
