        },
        "proof_strategy": "direct",
        "statement": "Every finite-dimensional Euclidean quartic partition function with nonnegative coupling has a perturbation Taylor series at zero coupling with positive radius of convergence."
      },
      {
        "id": "ex-qft-wick-quartic-coercivity",
        "kind": "example",
        "title": "Explicit stability of a Wick-subtracted quartic",
        "deps": [
          "def-qft-finite-wick-normal-powers",
          "lem-qft-coercive-polynomial-form-domain",
          "def-countable-choice",
          "def-axiom-of-choice"
        ],
        "dependency_roles": {
          "def-qft-finite-wick-normal-powers": "mathematical-premise",
          "lem-qft-coercive-polynomial-form-domain": "mathematical-premise",
          "def-countable-choice": "mathematical-premise",
          "def-axiom-of-choice": "mathematical-premise"
        },
        "dependency_level": 3,
        "domain": "mathematics",
        "library": "mathematics",
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "David Skinner, Advanced Quantum Field Theory, Chapter 2, “QFT in Zero Dimensions” (University of Cambridge Part III lecture notes)",
              "url": "https://www.damtp.cam.ac.uk/user/dbs26/AQFT/chap2.pdf"
            },
            {
              "title": "Nima Moshayedi, Quantum Field Theory and Functional Integrals (lecture notes, arXiv:1902.08652)",
              "url": "https://arxiv.org/pdf/1902.08652"
            }
          ]
        },
        "proof_strategy": "direct",
        "statement": "For the one-coordinate Wick potential $V(q):=\\lambda:q^4:_C$, every prescribed $\\alpha>0$ has an explicit constant $C_0=15\\lambda C^2+\\alpha^2/(2\\lambda)$ such that $V(q)\\ge\\alpha q^2-C_0$ for all $q$. Therefore the potential satisfies the coercivity hypothesis of [L1]. **Conditional on the current QFT-IR01 draft argument and its stated hypotheses**, the shifted kinetic-plus-potential form has the dense, continuously injected form completion stated in [L1]. This example establishes a lower bound and a conditional form-domain consequence; it does not assert self-adjointness or an interacting Hamiltonian here."
      },
      {
        "id": "ex-qft-finite-wick-quadratic-pair",
        "kind": "example",
        "title": "Finite Wick quadratic pairing",
        "deps": [
          "def-qft-finite-wick-normal-powers",
          "lem-qft-finite-gaussian-wick-moments",
          "def-multivariate-normal-law",
