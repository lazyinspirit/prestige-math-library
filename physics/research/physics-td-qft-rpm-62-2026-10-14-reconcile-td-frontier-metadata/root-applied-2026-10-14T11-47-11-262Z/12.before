          ]
        },
        "physical_scope": "Smooth single-phase charts with positive finite entropy derivative in the adopted nonrelativistic macroscopic thermodynamic framework; the quantities are state functions, not empirical thermometer readings.",
        "inventory_expansion_required": false,
        "dependency_level": 5
      },
      {
        "id": "post-td-mechanical-conjugate-identification",
        "kind": "postulate",
        "domain": "physics",
        "title": "Mechanical pressure-volume work coupling",
        "statement": "Adopt p_mech=p_c and delta W_on=-p_c dV for a quasistatic frictionless constant-area piston.",
