      {
        "id": "pthm-td-local-energy-representation",
        "kind": "physics-theorem",
        "domain": "physics",
        "title": "Local energy representation and thermodynamic conjugates",
        "statement": "Locally invert a C2 entropy representative with S_U>0 and derive U_s=T, U_V=-p, and U_nj=mu_j.",
