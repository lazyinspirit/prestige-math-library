          "proof": "not-applicable"
        },
        "dependency_level": 5,
        "sources": {
          "references": [
            {
              "title": "Sean Carroll, Lecture Notes on General Relativity, complete lecture notes, Ch. 1 four-momentum and Ch. 3 particle action",
              "url": "https://arxiv.org/pdf/gr-qc/9712019"
