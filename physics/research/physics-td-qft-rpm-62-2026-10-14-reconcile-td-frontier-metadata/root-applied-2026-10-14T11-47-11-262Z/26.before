        },
        "physical_scope": "Definitions of point-particle momentum and observer-relative energy in the adopted massive and null test sectors; no conservation or empirical claim."
      },
      {
        "id": "pthm-rpm-free-massive-and-null-geodesics",
        "kind": "physics-theorem",
        "domain": "physics",
        "title": "Free massive and null particle geodesics",
        "statement": "On a prescribed smooth time-oriented Lorentzian background, stationary paths of the adopted massive action of [[post-rpm-massive-test-particle-action]] satisfy $D_\\tau U=0$ in proper-time parameter, with $P=mU$ and $m>0$ constant. In the separately adopted null sector of [[post-rpm-null-test-particle-action]], stationary einbein paths have a nonzero future-null momentum $P$ satisfying $D_\\lambda P=0$ in an affine parameter $\\lambda$ with $dx/d\\lambda=P$. Through each allowed initial point and tangent, each equation has a unique local solution and a unique maximal solution on an open interval. Neither maximal interval is asserted to be all of $\\mathbb R$.",
        "deps": [
          "post-rpm-massive-test-particle-action",
          "post-rpm-null-test-particle-action",
          "def-rpm-mechanical-momentum-and-observer-energy",
          "lem-rpm-length-action-first-variation",
          "lem-rpm-einbein-variation-and-equivalence",
          "thm-rpm-proper-time-parametrization",
          "thm-gr-local-geodesics-and-exponential-map"
        ],
        "dependency_roles": {
