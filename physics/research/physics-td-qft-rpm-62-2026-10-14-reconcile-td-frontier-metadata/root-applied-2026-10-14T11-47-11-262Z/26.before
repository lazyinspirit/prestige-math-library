      {
        "id": "post-rpm-test-clock-and-background",
        "kind": "postulate",
        "domain": "physics",
        "title": "Ideal clocks on a prescribed Lorentzian background",
        "statement": "**Adopted convention.** On a prescribed background $(M,g,N)$ from [[def-rpm-spacetime-observer-and-worldline]], an ideal clock carried along a future timelike test worldline $x$ records the proper-time parameter $\\tau$ defined by $d\\tau=c^{-1}\\sqrt{-g(dx/ds,dx/ds)}\\,ds$. Thus elapsed reading between two ordered points is the integral of this positive density. The flat-spacetime specialization is inherited from [[post-sr-ideal-clocks-and-light]]; extending that convention to the curved prescribed background is a separate adoption of this framework.",
        "deps": [
          "def-rpm-spacetime-observer-and-worldline",
          "post-sr-ideal-clocks-and-light"
        ],
        "dependency_roles": {
          "def-rpm-spacetime-observer-and-worldline": "formulation-prerequisite",
          "post-sr-ideal-clocks-and-light": "formulation-prerequisite"
        },
        "provenance": {
          "statement": "ai-altered",
          "proof": "not-applicable"
        },
        "dependency_level": 1,
        "sources": {
          "references": [
            {
              "title": "David Tong, General Relativity, author-hosted lecture-note chapter excerpt, §1.1.1 particle worldline action and §1.2 proper time",
              "url": "https://www.davidtong.org/pdfs/teaching/general-relativity/gr1.pdf"
            },
            {
              "title": "Sean Carroll, Lecture Notes on General Relativity, complete lecture notes, Ch. 1",
              "url": "https://arxiv.org/pdf/gr-qc/9712019"
            }
          ]
        },
        "physical_scope": "Adopted classical test-particle framework on a prescribed smooth time-oriented Lorentzian four-manifold; the curved-background clock reading convention extends the flat ideal-clock postulate and is not an empirical accuracy claim."
      },
      {
        "id": "lem-rpm-length-action-first-variation",
        "kind": "lemma",
        "domain": "mathematics",
        "title": "Timelike length action: arbitrary-parameter first variation",
        "statement": "Let $(M,g,N)$ be a prescribed smooth time-oriented Lorentzian four-manifold, $a<b$, and $x:[a,b]\\to M$ a $C^2$ future timelike curve. Put $T=dx/ds$, $\\ell=\\sqrt{-g(T,T)}>0$, and for a constant $m>0$ and $c>0$ define the length action $S[x]=-mc\\int_a^b\\ell(s)\\,ds$. Let $H(\\epsilon,s)$ be a $C^2$ fixed-endpoint variation through future timelike curves for $\\epsilon$ near $0$, with $H(0,s)=x(s)$ and variation field $J=\\partial_\\epsilon H|_0$. Then",
        "deps": [
          "def-rpm-spacetime-observer-and-worldline",
          "thm-rpm-proper-time-parametrization",
