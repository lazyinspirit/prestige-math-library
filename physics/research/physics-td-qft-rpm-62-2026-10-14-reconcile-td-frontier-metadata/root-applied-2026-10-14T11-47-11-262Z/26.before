    "items": [
      {
        "id": "def-rpm-spacetime-observer-and-worldline",
        "kind": "definition",
        "domain": "mathematics",
        "title": "Particle spacetime, observers and worldlines",
        "statement": "Use the signature $(-,+,+,+)$ throughout. In the flat case, **Minkowski spacetime** means the affine model $(A,V,\\eta,C^+)$ of [[def-sr-affine-minkowski-model]]: $A$ is an affine space, $\\eta$ is a nondegenerate Lorentz form on its four-dimensional displacement space, and $C^+$ selects the future cone. In the curved case, a **background spacetime** means a prescribed smooth time-oriented Lorentzian four-manifold $(M,g,N)$ of [[def-gr-smooth-lorentzian-objects]]; the metric and time orientation are fixed data, not dynamical unknowns here. No field equation or completeness assumption is included.",
        "deps": [
          "def-sr-affine-minkowski-model",
          "def-gr-smooth-lorentzian-objects",
          "def-gr-timelike-worldline-and-proper-time",
          "def-gr-observer-and-rest-space",
          "def-gr-observer-congruence-and-adapted-charts",
          "def-gr-local-frame-and-tetrad-fields",
          "def-sr-chart-tetrad-and-congruence-distinction"
        ],
        "dependency_roles": {
