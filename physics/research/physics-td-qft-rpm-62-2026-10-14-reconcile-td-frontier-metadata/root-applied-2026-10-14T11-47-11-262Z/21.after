      {
        "id": "lem-tdmath-counts-generate-configuration-sigma",
        "kind": "lemma",
        "domain": "mathematics",
        "title": "Counts Generate the Sigma-Algebra of Finite Configurations",
        "statement": "Let $C=[0,1)^d$ for an integer $d\\geq1$. Let $\\mathsf C_f(C)$ be the set of finite subsets of $C$, represented by their cardinality $n$ and their uniquely lexicographically increasing list $(x_1,\\ldots,x_n)$. Give this set the Borel structure of the countable disjoint union of the Borel subspaces of $C^n$ consisting of strictly increasing lists. For each Borel $B\\subseteq C$, let $N_B(\\eta)=\\#(\\eta\\cap B)$. Then\n$$\\mathcal B(\\mathsf C_f(C))=\\sigma\\{N_B:B\\in\\mathcal B(C)\\}.$$",
        "deps": [
          "def-axiom-of-choice",
          "def-borel-sigma-algebra",
          "def-product-sigma-algebra-and-finite-product-sigma-algebras",
          "def-standard-borel-space",
