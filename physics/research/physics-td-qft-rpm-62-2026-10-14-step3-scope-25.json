  "refuter_findings": [
    {
      "obligation": "refuter:25:1",
      "id": "thm-rpm-h-constraint-consistency",
      "location": "Statement",
      "defect": "missing-hypothesis",
      "evidence": "The Statement says the admissible variation classes “imply” the constraint and Hamilton equations, but never assumes the paths and multipliers are stationary for the displayed action. Its cited supplier, `thm-cm-stationarity-iff-euler-lagrange`, states that a path is stationary iff its Euler–Lagrange expression vanishes; admissibility alone does not imply stationarity. The proof’s variation step therefore requires the missing vanishing-first-variation hypothesis.",
      "severity": "fatal",
      "observed_sha256": "261c76a928bde449399d50550c993d478314f8cdfea91b48d17ff1033f265df1"
    },
    {
      "obligation": "refuter:25:2",
      "id": "pthm-rpm-h-coordinate-versus-observer-energy",
      "location": "Statement",
      "defect": "false-claim",
      "evidence": "The Statement says “only explicit time independence implies its conservation.” Within the stated Hamiltonian form, take `N=1`, `h=δ`, and `β(t)=(0,sin(t/t₀),0)` for `t₀>0`. For a massive state with constant spatial momentum `p=(p₁,0,0)`, `p₁≠0`, the Hamiltonian is explicitly time-dependent as a function, `H=c(√(m²c²+|p|²)−sin(t/t₀)p₂)`, but along this solution `p₂=0` and `H` is constant. Step 2.2 establishes only `dH/dt=∂ₜH`, so time independence is sufficient, not necessary, for conservation along a solution.",
      "severity": "fatal",
      "observed_sha256": "dc0919c3e453d0f045ddcb917fd8794d50bb8f0302e36f58dcc6918e3b8818cc"
    }
  ],
