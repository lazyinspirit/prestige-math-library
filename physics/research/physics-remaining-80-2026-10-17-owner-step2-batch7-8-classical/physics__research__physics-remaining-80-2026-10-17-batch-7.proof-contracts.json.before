        },
        {
          "case": "degenerate",
          "status": "checked",
          "evidence": "Proof step 2.1 shrinks to a compact cylinder with A0>=aI for a>0 and takes speed lambda>b/a. A degenerate time matrix is excluded; zero energy is retained and forces the zero solution."
        },
        {
          "case": "endpoints",
          "status": "not_applicable",
          "reason": "Proof step 2.1 proves a neighborhood in shrinking future and past cones; neither an endpoint trace nor continuation through a finite singular time is asserted."
        },
        {
          "case": "nonempty-choice",
          "status": "not_applicable",
          "reason": "Proof step 1.1–3.1 use the supplied solution and local differential/energy identities; no new sequence of choices or existence construction from a family is made in this propagation lemma."
        },
        {
          "case": "iff-forward",
          "status": "not_applicable",
          "reason": "Statement is the implication from reduced evolution, initial constraints and gauge initialization to H=0 and full equations, not an equivalence of unconstrained data classes."
        },
        {
          "case": "iff-reverse",
          "status": "not_applicable",
          "reason": "Proof step 3.1 recovers full Einstein equations once H vanishes; it does not claim an arbitrary full solution already has the chosen harmonic coordinates or initialized jet."
        }
      ],
      "finite_checks": [],
