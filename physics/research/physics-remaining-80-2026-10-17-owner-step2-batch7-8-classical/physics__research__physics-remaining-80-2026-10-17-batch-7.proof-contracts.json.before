    "ex-emg-nonzero-parallel-field-data": {
      "citations": [
        {
          "fact": "L1",
          "source": "thm-emg-gauss-codazzi-maxwell-constraints",
          "source_section": "Statement",
          "quote": "$$R(h)+(\\operatorname{tr}_hK)^2-|K|_h^2=2\\Lambda+\\frac{\\kappa}{\\mu_0}(|e|_h^2+|b|_h^2),$$",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F1",
          "source": "thm-emg-local-high-sobolev-electrovacuum",
          "source_section": "Statement",
          "quote": "Then there are $T>0$ and a solution of the full source-free Einstein–Maxwell system on $(-T,T)\\times\\mathbb T^3$ with\n$$g\\in L^\\infty H^{s+1}\\cap C^0H^s,\\qquad \\partial_tg\\in L^\\infty H^s\\cap C^0H^{s-1},\\qquad F\\in L^\\infty H^s\\cap C^0H^{s-1}.$$\nThe initial two-form is reconstructed by $F(n,\\mathsf e_i)=-e_i$ and $F(\\mathsf e_i,\\mathsf e_j)=\\epsilon_{ijk}b_k$; no independent Maxwell normal derivative is prescribed.",
          "uses": [
            "2.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "step-1-1",
          "step": "1.1",
          "claim": "The flat torus has $R(h)=0$ and zero Christoffel symbols. Constant $e,b$ therefore have $D_ie^i=D_ib^i=0$; their collinearity gives $e\\times_h b=0$. Since $K=Hh$ with constant $H$, $D K=0$, $\\operatorname{tr}_hK=3H$, and $|K|_h^2=3H^2$. Hence the Hamiltonian left side is $0+9H^2-3H^2=6H^2$, which by the definition of $H$ equals $\\kappa\\mu_0^{-1}(|e|^2+|b|^2)$, exactly the right side of [L1] for $\\Lambda=0$. The momentum left side and right side both vanish. Thus all four constraints hold. The scalar under the square root is positive since both fields are nonzero, and $H$ is finite and real.",
          "inputs": [
            "given",
            "L1",
            "algebra"
          ]
        },
        {
          "id": "step-2-1",
          "step": "2.1",
          "claim": "The data are smooth and $h$ is uniformly positive on the compact torus. For any integer $s\\ge5$ they belong to the Sobolev classes in [F1]; their verified constraints meet its hypotheses. Applying [F1] yields a smooth local full source-free solution. The reconstructed initial two-form has nonzero electric and magnetic components because $e,b\\ne0$, so the solution is nontrivial. The argument is a model deduction, not an empirical claim.",
          "inputs": [
            "step 1.1",
            "F1",
            "algebra"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "Statement uses the fixed nonempty flat three-torus and two prescribed constant vectors; no empty indexed sum or domain is part of the example."
        },
        {
          "case": "zero",
          "status": "checked",
          "evidence": "Statement excludes e=0 and b=0 to assert a nontrivial field; proof step 1.1 makes H strictly positive from their nonzero squared norms. The Remarks separately check K=0 with a nonzero field and show the Hamiltonian constraint fails."
        },
        {
          "case": "one",
          "status": "not_applicable",
          "reason": "Statement fixes two three-component vectors and one specific initial tuple, not a cardinality parameter taking value one."
        },
        {
          "case": "degenerate",
          "status": "checked",
          "evidence": "Proof step 1.1 uses positive kappa,mu0 and nonzero fields to obtain finite real H; parallel vectors, including antiparallel ones, still give e cross b=0. The metric h=delta is strictly positive."
        },
        {
          "case": "endpoints",
          "status": "not_applicable",
          "reason": "Proof step 2.1 invokes only a short open local existence interval; neither future endpoint regularity nor later isotropy is claimed."
        },
        {
          "case": "nonempty-choice",
          "status": "checked",
          "evidence": "Proof step 2.1 uses the local theorem under its AComega convention, with smooth bounded periodic data on a nonempty compact torus; no additional Choice principle appears."
        },
        {
          "case": "iff-forward",
          "status": "not_applicable",
          "reason": "Statement verifies one explicitly constructed constrained data tuple and applies local existence; it does not characterize all solutions or all constrained tuples by an iff."
        },
        {
          "case": "iff-reverse",
          "status": "not_applicable",
          "reason": "Proof step 1.1 verifies sufficiency for this chosen H and K only; no converse claims every electrovacuum tuple has constant parallel fields or K=Hh."
        }
      ],
      "finite_checks": [
        {
          "check": "tr_h(Hh)=3H and |Hh|_h^2=3H^2 in three spatial dimensions.",
          "result": "The Hamiltonian left side is 6H^2.",
          "verifies": "Step 1.1."
        },
        {
          "check": "H^2=κ(|e|^2+|b|^2)/(6μ_0).",
          "result": "6H^2=κ(|e|^2+|b|^2)/μ_0, the Λ=0 Maxwell right side.",
          "verifies": "Step 1.1."
        }
      ],
      "risk_review": {
        "status": "complete",
        "reviewer": "step-1-author",
        "notes": "Exact source-item excerpts and every actual proof step are mapped. CP01 suppliers are draft with verification precheck pending, so consuming readiness remains conditional; imported current suppliers retain their own verification states."
      }
    },
    "rem-emg-maximal-is-not-complete": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-gr-development-and-data-fixing-isometry",
          "source_section": "Definition",
          "quote": "**(d) Maximality.** A development $(M,g,N,j,\\psi)$ of the given data is\n**maximal** when for every development $(M',g',N',j',\\psi')$ of the same data\nthere exists a development embedding $\\varphi:M'\\to M$.",
          "uses": [
            "1.1",
            "2.1"
          ]
        },
        {
          "fact": "F2",
          "source": "thm-emg-sourcefree-smooth-maximal-development",
          "source_section": "Statement",
          "quote": "Then there is a smooth connected time-oriented globally hyperbolic development $(M_{\\max},g_{\\max},F_{\\max},\\iota)$ into which every other smooth source-free Einstein–Maxwell development of these complete data embeds by a time-orientation-preserving isometric embedding fixing $\\iota$ and carrying $F$ to $F_{\\max}$.",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F2",
          "source": "thm-gr-smooth-maximal-globally-hyperbolic-development",
          "source_section": "Statement",
          "quote": "Then there exists a development\n$(M_{\\mathrm{max}},g_{\\mathrm{max}},N_{\\mathrm{max}},j_{\\mathrm{max}},\\psi_{\\mathrm{max}})$\nof the data in the sense of [[def-gr-development-and-data-fixing-isometry]]\nclause (a) that is maximal in the sense of clause (d) of that definition:\nfor every development $(M,g,N,j,\\psi)$ of the same data there is a\ndata-fixing development embedding $M\\to M_{\\mathrm{max}}$.",
          "uses": [
            "2.1"
          ]
        }
      ],
      "derivations": [
        {
