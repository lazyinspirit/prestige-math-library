  "scientific_repairs": [
    {
      "defect": "Ordinary punctured scaling bounds and punctured transversality do not establish PB.",
      "repair": "Positive full-center product lemma proves uniform fixed-support, dyadic-tempered, Fourier-cone and product-integral estimates. Causal blocks are transverse at the full diagonal by internal momentum conservation and pointed future cross-edge momenta. A homogeneous angular partition preserves scaling.",
      "claim": "All finite derivative graphs have finite upper scaling bounds; the primitive engineering upper bound is 2|E|+sum|alpha|. No PB hypothesis remains."
    },
    {
      "defect": "Finite-jet density presentations may differ by integration by parts.",
      "repair": "Balanced total/relative derivative decomposition, local representative uniqueness/support, and derivative-compatible extension make the constructed maps depend only on actual functionals.",
      "claim": "All approved finite jets remain; no derivative interactions or admissible intended free data were dropped."
    },
    {
      "defect": "The original unsigned null relation omitted cotangent tangency.",
      "repair": "Definition60 now uses covectors proportional to the metric-dual tangent of the connecting null line, with either endpoint order and the diagonal case. Future W and both causal Feynman branches use that unsigned relation.",
      "claim": "The massless witness is verified admissible only for the corrected relation. Admissibility for the old overbroad literal equality is not claimed."
    },
    {
      "defect": "Exact actual-degree preservation of every differentiated cancellation is incompatible with functional presentation independence.",
      "repair": "Final derivative descendants and local normalizations obey engineering upper bounds and the corresponding finite delta-jet bound; exact-degree analytic extension families are retained for independent balanced coefficients where proved.",
      "claim": "The old exact-degree requirement is corrected, not claimed achieved. The counterexample locally constructs the massless datum and proves P h_F=-i delta_4 while its punctured restriction is zero. The necessary engineering degree four is attained by this contact term."
    },
    {
      "defect": "The given-systems composition proof unnecessarily inherited AC from constructing the systems.",
      "repair": "The supplied systems are compared by deterministic triangular residual recursion, ZF product-test density and ZF point-support classification. Unique recursion uses no new arbitrary extension choice.",
      "claim": "The comparison proposition is strengthened to CC only, as required by its actual common contraction contract. The separate existence theorem retains AC."
    },
    {
      "defect": "The local-functional microcausality proof wrongly removed all variation derivatives to smooth coefficients.",
      "repair": "Retained derivatives of thin-diagonal deltas; their finite polynomial Fourier factors are absorbed by rapid center-frequency decay.",
      "claim": "The original conormal and microcausality Statement is unchanged."
    }
  ],
