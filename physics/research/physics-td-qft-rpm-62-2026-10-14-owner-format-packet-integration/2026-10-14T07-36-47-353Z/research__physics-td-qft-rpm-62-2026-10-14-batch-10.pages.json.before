        "kind": "definition",
        "domain": "physics",
        "title": "Ideal-reservoir thermodynamic cycles",
        "statement": "Defines two-reservoir working-system cycles with ideal constant-temperature baths, an entropy-neutral work store, and an isolated compound boundary.",
        "deps": [
          "def-td-process-and-protocol",
          "def-td-system-and-permitted-exchanges",
          "def-td-si-quantities",
          "def-td-temperature-pressure-chemical-potential",
