      "derivations": [
        {
          "id": "ex-qftmath-timeordered-jump-step-1-1",
          "claim": "On $t>0$, $g_\\omega(t)=e^{-i\\omega t}/(2\\omega)$ and $g_\\omega'(t)=-\\tfrac i2e^{-i\\omega t}$, so $g_\\omega'(0+)=-i/2$. On $t<0$, $g_\\omega(t)=e^{i\\omega t}/(2\\omega)$ and $g_\\omega'(t)=+\\tfrac i2e^{i\\omega t}$, so $g_\\omega'(0-)=+i/2$. The function is continuous at $0$, and the derivative jump is $g_\\omega'(0+)-g_\\omega'(0-)=-i$.",
          "step": "1.1",
