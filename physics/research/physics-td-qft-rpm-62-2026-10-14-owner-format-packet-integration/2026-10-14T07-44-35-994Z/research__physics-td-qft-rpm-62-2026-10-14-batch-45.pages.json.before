        "dependency_level": 4,
        "proof_strategy": "direct",
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "statement": "Let $e\\in\\mathbb R^3$ be a unit vector and $P_T(n)=I_3-nn^\\top$ for $n\\in S^2$. Then the angular coefficient in the coherent infrared family with $b(n)=\\lambda P_T(n)e$, $\\lambda\\in\\mathbb R\\setminus\\{0\\}$, is\n$$ \\int_{S^2}|b(n)|^2\\,d\\Omega=\\frac{8\\pi\\lambda^2}{3}. $$",
        "sources": {
          "references": [
