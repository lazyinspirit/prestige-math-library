        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "statement": "For any $\\mu>0$, use $h=\\operatorname{diag}(1,-1,-1,-1)$, $p=(0,0,0,0)$, and $k=(2\\mu,0,0,0)$. Both $p$ and $p+k$ are off shell. The exact rational matrices are\n$$ S_0(p)=-\\frac{1}{\\mu}I_4,\\qquad S_0(p+k)=\\frac{2\\beta+I_4}{3\\mu},\\qquad \\Gamma(k)=2\\mu\\beta . $$",
        "sources": {
          "references": [
            {
              "title": "David Tong, Quantum Field Theory, §§6.4–6.5",
              "url": "https://www.damtp.cam.ac.uk/user/tong/qft/qfthtml/S6.html",
              "locator": "Complete author-hosted Chapter 6 HTML; finite rational QED propagator and tree-current rule context."
