              "url": "https://web.physics.ucsb.edu/~mark/ms-qft-DRAFT.pdf"
            }
          ]
        },
        "physical_scope": "Conditional finite formal-tree calculations for unpolarized electron-positron to muon-antimuon scattering and the specified scalar contact and decay amplitudes, interpreted only by the adopted coefficient maps. The electron-mass estimate compares two tree coefficients only; no continuum scattering operator, loop or infrared error, threshold resummation, detector prediction, or empirical estimate is asserted.",
        "empirical_premises": [],
        "dependency_level": 8
      },
      {
        "id": "pthm-qft-example-dirac-magnetic-benchmark",
        "kind": "physics-theorem",
        "domain": "physics",
        "library": "physics",
        "title": "Minimal Dirac magnetic benchmark from the adopted action",
        "statement": "Derives the compact-variation Dirac equation of the adopted local Maxwell–Dirac action and matches its formal minimal Pauli spin coefficient to gs=2 on the stated smooth pure-magnetic core. No self-adjoint closure, full spectrum, radiative correction, or empirical equality is asserted.",
