      {
        "id": "post-qft-example-formal-observable-map",
        "kind": "postulate",
        "domain": "physics",
        "library": "physics",
        "title": "Formal diagram coefficient-to-observable adoption",
        "statement": "Adopts specified QED and scalar formal tree coefficients as model-specific leading phenomenological readings through the two-body flux and phase-space maps. It does not identify them with exact continuum observables or reported measurements.",
        "deps": [
          "def-qft-example-observable-types",
          "post-qft-formal-qed-coefficients",
          "lem-qft-example-two-body-phase-space"
        ],
        "dependency_roles": {
