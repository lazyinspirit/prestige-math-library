      {
        "id": "ex-qft-x04",
        "kind": "example",
        "domain": "physics",
        "library": "physics",
        "title": "Massless formal annihilation angular contrast",
        "statement": "For the massless specialization of the formal e+e−→μ+μ− tree coefficient, the differential coefficients at θ=0 and θ=π/2 have ratio 2, and the full-sphere total is 4πα²(ℏc)²/(3s). No event ratio or exact continuum cross section is asserted.",
        "deps": [
