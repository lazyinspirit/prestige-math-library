          "reason": "The lem-qft-qed-conserved-current-gauge claim makes no iff-forward boundary assertion."
        },
        {
          "case": "iff-reverse",
          "status": "not_applicable",
          "reason": "The lem-qft-qed-conserved-current-gauge claim makes no iff-reverse boundary assertion."
        }
      ],
      "finite_checks": [
        {
          "name": "zero-transfer longitudinal term",
          "inputs": [
            "A1",
            "F1",
            "algebra",
            "step 1.1"
          ],
          "expected": "At k=0, c(0)kμkν=0 and the current contraction vanishes."
