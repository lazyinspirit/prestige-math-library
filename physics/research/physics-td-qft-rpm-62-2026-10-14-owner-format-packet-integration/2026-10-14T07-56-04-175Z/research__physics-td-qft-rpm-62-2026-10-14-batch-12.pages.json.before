        "title": "Coarea and invariant measure on compact regular energy shells",
        "reference": "items/thm-tdmath-regular-energy-shell-measure.md#statement",
        "design_state": "Complete draft carrier authored; scoped checks and independent review remain pending.",
        "dependency_level": 1,
        "deps": [
