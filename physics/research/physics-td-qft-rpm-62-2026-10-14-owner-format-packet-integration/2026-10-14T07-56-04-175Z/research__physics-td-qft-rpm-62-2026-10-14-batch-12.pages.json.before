        "id": "thm-tdmath-discrete-quantum-cesaro-dephasing",
        "kind": "theorem",
        "domain": "mathematics",
        "title": "Trace-norm Cesàro dephasing for a discrete Gibbs spectrum",
        "reference": "items/thm-tdmath-discrete-quantum-cesaro-dephasing.md#statement",
        "design_state": "Complete draft carrier authored; scoped checks and independent review remain pending.",
        "dependency_level": 3,
