      {
        "id": "thm-tdmath-hamiltonian-measure-and-recurrence",
        "kind": "theorem",
        "domain": "mathematics",
        "title": "Hamiltonian volume, recurrence, and ergodic scope",
        "reference": "items/thm-tdmath-hamiltonian-measure-and-recurrence.md#statement",
        "design_state": "Complete draft carrier authored; scoped checks and independent review remain pending.",
        "dependency_level": 0,
        "deps": [
          "cor-birkhoff-ergodic-theorem-for-ergodic-probability-systems",
          "cor-symplectic-manifolds-have-a-canonical-orientation-and-volume-form",
          "def-axiom-of-choice",
          "def-ergodic-measure-preserving-system",
          "def-hamiltonian-vector-field-and-hamiltonian-function",
          "def-integrable-real-and-complex-functions-and-their-integrals",
          "def-measure-preserving-transformation-and-system",
          "def-probability-measure",
          "def-symplectic-form-and-symplectic-manifold",
          "thm-birkhoff-ergodic-theorem",
