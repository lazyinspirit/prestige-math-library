        "domain": "mathematics",
        "title": "Attainment and finite support for compact continuous mixtures",
        "reference": "items/thm-tdmath-compact-continuous-mixture-attainment.md#statement",
        "design_state": "Complete draft carrier authored; scoped checks and independent review remain pending.",
        "dependency_level": 1,
        "deps": [
          "def-tdmath-mixture-generator-space-and-energy",
          "def-borel-probability-law-on-a-polish-space",
          "def-integrable-real-and-complex-functions-and-their-integrals",
