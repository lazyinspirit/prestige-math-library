      {
        "id": "thm-rpm-h-killing-shell-first-integral",
        "kind": "theorem",
        "domain": "mathematics",
        "title": "Killing scalar conservation in cotangent shell form",
        "statement": "Assume $\\mathrm{AC}_\\omega$ for the cotangent supplier. Let $(M,g)$ be a smooth Lorentzian manifold with canonical cotangent coordinates $(x^a,p_a)$ and $C_m(x,p)=\\tfrac12(g^{ab}p_ap_b+m^2c^2)$ for fixed $m\\ge0$. For any smooth vector field $\\xi$, set $F_\\xi=p_a\\xi^a(x)$. With canonical bracket $\\{F,G\\}=F_xG_p-F_pG_x$,\n\n$$\\{F_\\xi,C_m\\}=-\\tfrac12(\\mathcal L_\\xi g^{-1})^{ab}p_ap_b.$$\n\nIf $\\xi$ is Killing, this bracket vanishes for all cotangent covectors, and $F_\\xi$ is constant along every constrained free-shell trajectory generated by $eC_m$ with any smooth multiplier $e$ on its actual interval. No global existence or empirical conservation is asserted.",
        "deps": [
          "thm-rpm-h-first-order-action-and-geodesics",
          "thm-rpm-h-canonical-poisson-and-flow",
          "thm-gr-killing-and-on-shell-matter-identities",
          "def-countable-choice"
        ],
        "dependency_roles": {
          "thm-rpm-h-first-order-action-and-geodesics": "mathematical-premise",
          "thm-rpm-h-canonical-poisson-and-flow": "mathematical-premise",
          "thm-gr-killing-and-on-shell-matter-identities": "mathematical-premise",
          "def-countable-choice": "mathematical-premise"
        },
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "dependency_level": 5,
        "sources": {
          "references": [
