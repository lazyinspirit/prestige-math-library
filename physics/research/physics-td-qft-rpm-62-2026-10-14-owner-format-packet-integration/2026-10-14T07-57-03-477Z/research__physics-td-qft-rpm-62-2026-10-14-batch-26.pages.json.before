      {
        "id": "pthm-rpm-h-classical-orbit-evolution",
        "kind": "physics-theorem",
        "domain": "physics",
        "title": "Conditional classical orbit evolution and invariant labels",
        "statement": "Assume $\\mathrm{AC}_\\omega$. Adopt the optional classical spinning-orbit model of [[post-rpm-h-classical-spin-orbit-model]] with fixed $m,s>0$ and selected inertial Hamiltonian $H=cP^0$. Conditional on the KKS orbit and canonical Hamiltonian conventions, its Hamiltonian flow is the one-parameter coadjoint action of the corresponding time-translation subgroup (with the sign fixed by the library convention). It exists for all real evolution parameters and preserves $m$ and $s$. This is a deduction inside the adopted classical model, not evidence for that model or a derivation of quantum spin.",
        "deps": [
          "post-rpm-h-classical-spin-orbit-model",
          "thm-rpm-h-positive-spin-orbit",
          "thm-rpm-h-canonical-poisson-and-flow",
