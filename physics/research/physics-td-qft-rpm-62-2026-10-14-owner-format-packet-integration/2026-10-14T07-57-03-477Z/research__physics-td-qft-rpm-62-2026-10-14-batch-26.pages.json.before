      {
        "id": "thm-rpm-h-positive-spin-orbit",
        "kind": "theorem",
        "domain": "mathematics",
        "title": "Positive classical spin Poincare orbit and stabilizer jump",
        "statement": "Assume $\\mathrm{AC}_\\omega$. Let $G=\\mathbb R^4\\rtimes SO^+(1,3)$ act coadjointly on the dual charge space of [[def-rpm-h-poincare-charge-space]]. For fixed $m>0$ and $s>0$, take the rest covector $P=(mc,0,0,0)$, $J^{12}=s$, with all other independent components of $J$ zero. Its coadjoint orbit is an eight-dimensional smooth symplectic manifold with its KKS form. In the convention $\\varepsilon_{0123}=+1$, $\\varepsilon^{0123}=-1$, the algebraic vector $W^a=\\tfrac12\\varepsilon^{abcd}p_bJ_{cd}$ on that orbit satisfies $P^2=-m^2c^2$, $P$ future, $W\\cdot P=0$, and $W^2=m^2c^2s^2$. The exact joint invariant set with these values is this one orbit. At $s=0$ the rest stabilizer has dimension four and the spinless orbit has dimension six; no smoothness claim is made for a larger union of Casimir level sets.",
        "deps": [
          "thm-rpm-h-poincare-moment-map-and-algebra",
          "thm-coadjoint-orbits-are-symplectic-manifolds",
          "def-countable-choice",
          "def-rpm-h-poincare-charge-space"
        ],
        "dependency_roles": {
          "thm-rpm-h-poincare-moment-map-and-algebra": "mathematical-premise",
          "thm-coadjoint-orbits-are-symplectic-manifolds": "mathematical-premise",
          "def-countable-choice": "mathematical-premise",
          "def-rpm-h-poincare-charge-space": "mathematical-premise"
        },
        "provenance": {
