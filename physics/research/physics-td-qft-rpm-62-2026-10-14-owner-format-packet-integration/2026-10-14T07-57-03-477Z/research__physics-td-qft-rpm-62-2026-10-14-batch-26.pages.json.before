      {
        "id": "post-rpm-h-classical-spin-orbit-model",
        "kind": "postulate",
        "domain": "physics",
        "title": "Optional adopted classical spinning-orbit model",
        "statement": "**Adopted model postulate (optional):** Under $\\mathrm{AC}_\\omega$ for the referenced KKS orbit, and for fixed primitive parameters $m>0$ (kg) and $s>0$ (angular momentum units), use the coadjoint orbit and KKS symplectic form of [[thm-rpm-h-positive-spin-orbit]] as the phase space of a classical spinning particle. In a selected inertial frame choose the Hamiltonian $H=cP^0$ (joules). This premise chooses a mathematical model; it is not inferred from the spinless action, an experiment, or the existence of the orbit alone. It does not assert a quantum spin spectrum, a Wigner unitary representation, a spin supplementary condition, a charged-spin force law, or radiation dynamics.",
        "deps": [
          "thm-rpm-h-positive-spin-orbit",
          "def-countable-choice"
        ],
        "dependency_roles": {
          "thm-rpm-h-positive-spin-orbit": "mathematical-premise",
