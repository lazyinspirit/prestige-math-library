      ],
      "finite_checks": [
        {
          "check": "Evaluate H(r)=f(r)/r^2 at r=3s/2 and differentiate.",
          "result": "H=4/(27s^2), H′=0, and b_c=1/sqrt(H)=3sqrt(3)s/2.",
