        "id": "ex-qft-x06",
        "kind": "example",
        "domain": "physics",
        "library": "physics",
        "title": "One-charge soft photon count example",
        "statement": "Use the one-charge prescribed current of\n[[pthm-qft-example-soft-coherent-counts]] with final velocity\n$v=\\tfrac12$ along $\\hat{\\mathbf z}$. Choose any upper photon-energy cutoff\n$\\Lambda>0$ in joules and set $\\lambda=\\Lambda/\\mathrm e$, where $\\mathrm e$\nis Euler's number. The angular coefficient is\n$$C=\\frac{\\alpha}{\\pi}(2\\log 3-2)>0.$$\nThe exact cutoff coherent state therefore has mean photon count $C$, vacuum\nprobability $e^{-C}$, and mean photon energy\n$C\\Lambda(1-\\mathrm e^{-1})$ joules. Each halving of $\\lambda$ increases the\nmean count by $C\\log 2$; the mean energy remains bounded and tends to\n$C\\Lambda$ as $\\lambda\\downarrow0$. These are model predictions for the\nprepared free state.",
        "deps": [
          "def-countable-choice",
          "def-qft-example-data",
          "pthm-qft-example-soft-coherent-counts"
        ],
        "dependency_roles": {
          "def-countable-choice": "mathematical-premise",
          "def-qft-example-data": "mathematical-premise",
          "pthm-qft-example-soft-coherent-counts": "physical-result"
        },
        "provenance": {
          "statement": "ai-generated",
          "proof": "ai-generated"
        },
        "sources": {},
        "dependency_level": 9,
        "physical_scope": "An exact numerical specialization of the prescribed-current positive free coherent-state model and finite-cutoff photon-count prediction. It describes a prepared model state, not an observed or simulated emission event.",
        "empirical_premises": [],
        "generation": {
          "role": "example"
        }
      },
