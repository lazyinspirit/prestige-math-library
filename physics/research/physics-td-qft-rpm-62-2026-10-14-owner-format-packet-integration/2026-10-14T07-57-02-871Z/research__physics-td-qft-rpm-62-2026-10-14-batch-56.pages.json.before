      {
        "id": "pthm-qft-scalar-free-properties",
        "kind": "physics-theorem",
        "domain": "physics",
        "title": "Scalar distribution, covariance, locality and spectrum",
        "reference": "research/extended-frameworks-2026-10-03/quantum-field-theory/workers/free-fields/proof-modules.md#FF3-FF4",
        "design_state": "Complete conditional deductions for the real scalar model: Klein-Gordon equation, covariance, forward spectrum, exact mass gap, and local Weyl commutativity.",
        "dependency_level": 8,
        "deps": [
          "post-qft-free-field-model",
          "def-qft-free-scalar-model",
          "def-qft-scalar-mass-shell",
          "def-countable-choice",
          "lem-qft-smeared-free-scalar",
          "lem-qft-scalar-causal-commutator",
          "lem-qft-second-quantized-spectrum",
          "lem-qft-scalar-local-weyl-algebra"
        ],
        "dependency_roles": {
          "post-qft-free-field-model": "physical-assumption",
          "def-qft-free-scalar-model": "formulation-prerequisite",
          "def-qft-scalar-mass-shell": "mathematical-premise",
          "def-countable-choice": "mathematical-premise",
          "lem-qft-smeared-free-scalar": "mathematical-premise",
          "lem-qft-scalar-causal-commutator": "mathematical-premise",
          "lem-qft-second-quantized-spectrum": "mathematical-premise",
          "lem-qft-scalar-local-weyl-algebra": "mathematical-premise"
        },
        "inventory_expansion_required": false,
        "physical_scope": "Conditional properties of the selected four-dimensional real scalar free Fock model: the smeared Klein–Gordon field, proper orthochronous Poincare covariance, vacuum and forward-cone spectrum, exact mass gap, and isotony and spacelike commutativity of bounded local Weyl algebras.",
        "empirical_premises": [],
        "statement": "Assume the scalar model adoption planned in\n[[post-qft-free-field-model]] and Countable Choice\n[[def-countable-choice]]. Let $\\mu\\ge0$ and use the model, shell, field,\nvacuum, and units of [[def-qft-free-scalar-model]] and\n[[def-qft-scalar-mass-shell]]. These are conditional model deductions, with no\nempirical premise.\n\nFor every Schwartz test $f$, $\\Phi_\\mu(f)$ is defined on\n$\\mathcal D_{\\mathrm{fin}}$; for real $f$ it is symmetric and essentially\nself-adjoint there. Distributionally,\n$\\Phi_\\mu((\\Box-\\mu^2)f)=0$. The Fock lift of the proper orthochronous\nPoincare action is unitary, leaves $\\Omega$ invariant, and implements\ncovariance of the smeared field. For real Schwartz tests the vacuum\ntwo-point form is $\\langle\\Omega,\\Phi_\\mu(f)\\Phi_\\mu(g)\\Omega\\rangle=\\langle K_\\mu f,K_\\mu g\\rangle_2$, and it is nonnegative when $g=f$. The\njoint spectrum of spacetime translations is contained in the closed forward\ncone.\n\nFor real compactly supported smooth tests with pairwise spacelike-separated\nsupports, the smeared fields commute on $\\mathcal D_{\\mathrm{fin}}$. The\nbounded local Weyl algebras are isotonic and algebras for spacelike-separated\nregions commute. The physical Hamiltonian is self-adjoint on the exact\nmultiplier domain in [[def-qft-free-scalar-model]], is nonnegative, and has\n$\\Omega$ as its unique zero-energy vector. If $\\mu>0$, the infimum of its\npositive spectrum is $\\hbar c\\mu=m_{\\mathrm{rest,SI}}c^2$. If $\\mu=0$, its\npositive spectrum has no gap above zero.",
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "David Tong, Quantum Field Theory, author-hosted full-text Chapter 2",
              "url": "https://www.damtp.cam.ac.uk/user/tong/qft/qfthtml/S2.html"
            },
            {
              "title": "Mark Srednicki, Quantum Field Theory, author-hosted 2006 prepublication book draft",
              "url": "https://www.physics.ucsb.edu/~mark/ms-qft-DRAFT.pdf"
            }
          ]
        },
        "library": "physics"
      },
