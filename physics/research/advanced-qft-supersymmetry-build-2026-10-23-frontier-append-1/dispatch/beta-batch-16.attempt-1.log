  "title": "Finite semisimple fusion data for non-invertible defects",
  "reference": "items/def-aqft-noninvertible-defect-fusion.md",
  "design_state": "Planned exact finite semisimple fusion-category and higher-category definition; draft authored with explicit coherence and physical-realization boundary.",
  "dependency_level": 0,
  "deps": [
    "def-fusion-and-multifusion-category",
    "def-monoidal-category"
  ],
  "dependency_roles": {
    "def-fusion-and-multifusion-category": "mathematical-premise",
    "def-monoidal-category": "mathematical-premise"
