/** F3/B10: strip escalation-retry meta-talk from scratch, sentence-scoped. */
export function scrubRetryMetaTalk(scratch: string): { scratch: string; scrubbed: boolean } {
  const LEAK = /previous (attempt|rejection|version|issue|proof|error)|was rejected|the verifier|the reviewer|the rejection/i;
  const sentences = String(scratch || '').split(/(?<=[.!?])\s+/);
  const kept = sentences.filter((x) => !LEAK.test(x));
  if (kept.length === sentences.length) return { scratch, scrubbed: false };
  return { scratch: kept.join(' ').trim(), scrubbed: true };
}

/** O8: strip a trailing meta closing step; re-attach the QED glyph to the real
 *  final step so the parity precheck still sees a terminal ∎. */
export function stripMetaClosing(p: string): string {
  const lines = String(p || '').split('\n');
  for (let i = lines.length - 1; i >= 0; i--) {
    const t = lines[i].trim();
    if (!t) continue;
    const isMeta = /^(?:\*\*)?\d+\.\d+\s+This (?:completes|finishes|concludes) the proof\b[^\[\]]*?(?:\[[^\[\]]*\])?\s*\.?\s*[∎■□]?\s*(?:\*\*)?$/i.test(t);
    if (isMeta) {
      const hadQed = /[∎■□]/.test(t);
      lines.splice(i, 1);
      if (hadQed) {
        for (let k = lines.length - 1; k >= 0; k--) {
          if (/^\s*(?:\*\*)?\d+\.\d+\b/.test(lines[k].replace(/\*\*/g, ''))) {
            if (!/[∎■□]/.test(lines[k])) lines[k] = lines[k].replace(/\s*$/, ' ∎');
            break;
          }
        }

## Proof

1.1 If $n=0$, the polynomial algebra consists only of constants, so its degree-at-most-$q$ subspace has dimension at most one. If $n>0$, every monomial is indexed by an exponent vector $(a_1,\ldots,a_n)$ with $0\leq a_j\leq q$ for each $j$, since $\sum_j a_j\leq q$; hence the full degree-at-most-$q$ algebra is spanned by at most $(q+1)^n$ monomials. The exterior generators only reduce this finite set because their exponents are restricted to $0$ or $1$. [given, F1, algebra]

1.2 The subspace $P_{q,D}$ is spanned by the subset of those finitely many monomials whose assigned weights sum to $D$, so it is finite-dimensional; if no monomial has weight $D$, it is the zero space. The invariant vectors $P_{q,D}^{G}$ form a linear subspace of $P_{q,D}$ because the action preserves parity and weight, and every subspace of a finite-dimensional vector space is finite-dimensional. [given, step 1.1, algebra] ∎


