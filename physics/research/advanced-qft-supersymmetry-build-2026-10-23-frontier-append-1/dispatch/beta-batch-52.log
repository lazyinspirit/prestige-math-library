research/plan-spec.json:255856:          "inventory_expansion_required": false,
research/plan-spec.json-255857-          "statement": "For every $u,v\\in\\mathbb C$, the transfer matrices $t(u),t(v)$ of the ordered\nperiodic monodromy on $V_N=(\\mathbb C^2)^{\\otimes N}$ satisfy\n$$[t(u),t(v)]=0.$$\nNear $u=0$, $M(u):=t(0)^{-1}t(u)$ has the analytic matrix logarithm with\n$\\log M(0)=0$. Its Taylor-coefficient matrices commute pairwise and commute\nwith every $t(v)$.",
research/plan-spec.json-255858-          "provenance": {
