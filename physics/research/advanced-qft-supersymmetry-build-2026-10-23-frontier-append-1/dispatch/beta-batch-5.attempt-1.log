let failed = 0, checked = 0;
const results: Array<Record<string, unknown>> = [];
for (const file of files) {
  const md = readFileSync(file, 'utf8');
  const kind = parseFrontmatter(splitFrontmatter(md).fm).kind;
  if (kind === 'open-problem') {
