import json
from pathlib import Path

path = Path(\"research/advanced-qft-supersymmetry-build-2026-10-23-batch-26.proof-contracts.json\")
data = json.loads(path.read_text())
threshold_para = r'''A declared matching calculation supplies a finite list of renormalized amplitudes or Green-function values "'$A_{'"\\sigma,j}(t,c;\\lambda_{\\mathrm{IR}})"'$, where $j$ indexes the selected external states and kinematics, $c$ is a coefficient vector, and $'"\\lambda_{\\mathrm{IR}}"'$ denotes the common infrared regulator used in both descriptions. The matching map at scale $t$ is a supplied continuously differentiable map $M_t:U_+'"\\to U_-"'$ between open complex coefficient domains. Its realified map is $$'"\\widehat M_t:=\\rho_{N_-}\\circ M_t\\circ\\rho_{N_+}"'^{-1},$$ defined on the corresponding open real coefficient domains. It is a matching map through the declared loop order, operator dimension, and mass-expansion order when, for every selected $j$ and every admitted $c'"\\in U_+"'$, the prescribed truncations of $A_{+,j}(t,c;'"\\lambda_{\\mathrm{IR}})"'$ and $A_{-,j}(t,M_t(c);'"\\lambda_{\\mathrm{IR}})"'$ agree. The truncation projection and its retained orders are part of the datum. This equality records only the selected amplitudes and orders; it neither estimates discarded terms nor asserts that a matching calculation exists for every model.'"'''
threshold_full = threshold_para + r''' A matching map is RG-compatible on these domains when, in realified coefficient coordinates, "'$$'"\\partial_t\\widehat M_t(x)+D_x\\widehat M_t(x)\\,\\beta_+(t,x)=\\beta_-\\"'!'"\\left(t,\\widehat M_t(x)\\right)"'$$ for every admitted $(t,x). Here $D_x$ is the ordinary real derivative with respect to the coefficient coordinates. RG-compatibility is an additional condition to be checked from the supplied beta functions and matching calculation; it does not follow merely from defining $M_t$ by amplitude equality.'"'''
scheme_quote = r'''The scale "'$'"\\mu"'$ and cutoff $'"\\Lambda"'$ are distinct inputs. Choose a reference scale $'"\\mu_0\\in J"'$ and set $$t:='"\\log(\\mu/\\mu_0),\\qquad I:=\\{\\log(\\mu/\\mu_0):\\mu\\in J\\};"'$$ then $t$ is dimensionless and $I$ is an open interval containing $0$.'"'''

data[\"contracts\"][\"pthm-aqft-matching-and-running-scale-independence\"][\"citations\"] = [
    ({**c, \"quote\": threshold_full} if c[\"fact\"] == \"F2\" else c)
    for c in data[\"contracts\"][\"pthm-aqft-matching-and-running-scale-independence\"][\"citations\"]
]
data[\"contracts\"][\"pthm-aqft-matching-and-running-scale-independence\"][\"supplier_excerpts\"] = [
    ({**e, \"excerpt\": threshold_full} if e[\"supplier\"] == \"def-aqft-threshold-matching-map\" else e)
    for e in data[\"contracts\"][\"pthm-aqft-matching-and-running-scale-independence\"][\"supplier_excerpts\"]
]
for c in data[\"contracts\"][\"ex-aqft-qed-threshold-matching\"][\"citations\"]:
    if c[\"fact\"] == \"F1\":
        c[\"quote\"] = scheme_quote
    elif c[\"fact\"] == \"F2\":
        c[\"quote\"] = threshold_para
for e in data[\"contracts\"][\"pthm-aqft-matching-and-running-scale-independence\"][\"boundaries\"]:
    if e[\"case\"] == \"one\":
        e[\"evidence\"] = \"Step 1.1 is dimension-independent for finite positive coefficient dimensions, including one.\"
    elif e[\"case\"] == \"nonempty-choice\":
        e[\"evidence\"] = \"The Statement fixes the initial vector and finite thresholds; step 1.4 uses finite induction and no choice principle.\"
path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + \"\\n\")
