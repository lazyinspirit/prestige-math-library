  if(at<0) throw new Error('Missing '+marker+' in '+sourcePath);
  const start=at+marker.length;
  const next=raw.indexOf('\\n## ',start);
  const statement=raw.slice(start,next<0?undefined:next).trim();
  const row={
    id:fm.id,
    kind:fm.kind,
    domain:fm.domain,
    title:fm.title,
    reference:sourcePath+'#'+section,
    design_state:'Step 1 authored draft; planned item contract; readiness recorded separately.',
