from pathlib import Path
p=Path(\"items/def-aqft-threshold-matching-map.md\")
s=p.read_text()
old=r\"The supplied matching family is a jointly continuously differentiable real map "'$'"\\widehat{\\mathcal M}:\\mathcal U\\to\\rho_{N_-}(U_-)"'$ on an open domain $'"\\mathcal U\\subset\\{(t,x)\\in J\\times\\rho_{N_+}(U_+):(t,x)\\in\\Omega_+,\\ (t,\\widehat{\\mathcal M}(t,x))\\in\\Omega_-\\}"'$. It defines $M_t(c):="
new=r"The supplied matching family is a jointly continuously differentiable real map $'"\\widehat{\\mathcal M}:\\mathcal V\\to\\rho_{N_-}(U_-)"'$ on an open domain $'"\\mathcal V\\subset J\\times\\rho_{N_+}(U_+)"'$. Its admissible domain is the open subset $'"\\mathcal U=\\{(t,x)\\in\\mathcal V:(t,x)\\in\\Omega_+,\\ (t,\\widehat{\\mathcal M}(t,x))\\in\\Omega_-\\}"'$. It defines $M_t(c):="
assert s.count(old)==1
