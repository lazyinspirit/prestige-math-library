import { readFileSync, writeFileSync } from 'node:fs';
import { parseFrontmatter } from './tools/physics-support/content-policy-lib.mjs';

const path='research/advanced-qft-supersymmetry-build-2026-10-23-batch-26.pages.json';
const pages=JSON.parse(readFileSync(path,'utf8'));
const specs={
  'aqft-eft-matching-running':[
    ['def-aqft-threshold-matching-map','Definition'],
    ['pthm-aqft-matching-and-running-scale-independence','Statement'],
  ],
  'aqft-eft-matching-running-examples':[
    ['ex-aqft-qed-threshold-matching','Example'],
  ],
};
function itemRow(id,section){
  const sourcePath='items/'+id+'.md';
  const raw=readFileSync(sourcePath,'utf8');
  const fmRaw=raw.match(/"'^---'"\\r?\\n([\\s\\S]*?)\\r?\\n---(?:\\r?\\n|"'$)/)?.[1];
  if(!fmRaw) throw new Error('"'Missing frontmatter in '+sourcePath);
  const fm=parseFrontmatter(fmRaw);
  if(fm.id"'!==id) throw new Error('"'Identity mismatch for '+id);
  const marker='## '+section+'\\n';
  const at=raw.indexOf(marker);
  if(at<0) throw new Error('Missing '+marker+' in '+sourcePath);
  const start=at+marker.length;
  const next=raw.indexOf('\\n## ',start);
  const statement=raw.slice(start,next<0?undefined:next).trim();
  const row={
    id:fm.id,
    kind:fm.kind,
    domain:fm.domain,
    title:fm.title,
    reference:sourcePath+'#'+section,
    design_state:'Step 1 authored draft; planned item contract; readiness recorded separately.',
    dependency_level:fm.dependency_level,
    deps:fm.deps??[],
    dependency_roles:fm.dependency_roles??{},
    inventory_expansion_required:false,
    statement,
    provenance:fm.provenance,
    sources:fm.sources,
    library:fm.library,
    physical_scope:fm.physical_scope,
  };
  if(fm.proof_strategy) row.proof_strategy=fm.proof_strategy;
  if(fm.generation) row.generation=fm.generation;
  return row;
}
for(const page of pages){
  page.items=(specs[page.id]??[]).map(([id,section])=>itemRow(id,section));
}
writeFileSync(path,JSON.stringify(pages,null,2)+'\\n');
console.log(JSON.stringify(pages.map(p=>({page:p.id,items:p.items.map(i=>({id:i.id,level:i.dependency_level,deps:i.deps}))})),null,2));
