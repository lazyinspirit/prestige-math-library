const ABSTRACT_SHAPES = [
  { test: (u) => /(^|\.)arxiv\.org$/i.test(u.host) && /^\/abs\//i.test(u.pathname),
    why: 'arXiv /abs/ is the abstract page — cite the full text at /pdf/<id>' },
