import { readFileSync, writeFileSync } from 'node:fs';
import { yaml } from './tools/physics-support/pathway-lib.mjs';
const root = process.cwd();
const manifestPath = "'`${root}/research/advanced-qft-supersymmetry-build-2026-10-23-batch-23.pages.json`;
const manifest = JSON.parse(readFileSync(manifestPath, '"'utf8'));
function item(id, expansion) {
  const reference = "'`items/${id}.md`;
  const text = readFileSync(`${root}/${reference}`, '"'utf8');
  const match = text.match(/"'^---'"\\r?\\n([\\s\\S]*?)\\r?\\n---/);
  if ("'!match) throw new Error(`Missing frontmatter in ${reference}`);
  const fm = yaml().parse(match[1]);
  const body = text.slice(match[0].length).trimStart();
  const heading = fm.kind === '"'open-problem' ? 'Open problem' : 'Example';
  const section = body.match(new RegExp("'`''^## ${heading}'"\\\\r?\\\\n([\\\\s\\\\S]*?)(?=\\\\r?\\\\n## |"'$)`, '"'m'));
  if ("'!section) throw new Error(`Missing ${heading} section in ${reference}`);
  const row = {
    id: fm.id, kind: fm.kind, domain: fm.domain, title: fm.title, reference,
    design_state: expansion ? '"'Step 1 authored draft; batch-local example expansion; readiness recorded separately.' : 'Step 1 authored draft; planned nonlogical record; readiness recorded separately.',
    dependency_level: fm.dependency_level, deps: fm.deps ?? [], dependency_roles: fm.dependency_roles ?? {},
    inventory_expansion_required: expansion, statement: section[1].trim(), provenance: fm.provenance,
    sources: fm.sources, library: fm.library, physical_scope: fm.physical_scope ?? null,
