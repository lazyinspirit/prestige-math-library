+      "citations": [],
+      "derivations": [
+        {
+          "id": "step-1-1",
+          "step": "1.1",
+          "claim": "Quaternion conjugation preserves the imaginary subspace and norm, is a homomorphism into SO(3), and is onto by the axis-angle representation.",
+          "inputs": ["given", "A1", "algebra"]
+        },
+        {
+          "id": "step-1-2",
+          "step": "1.2",
+          "claim": "The kernel is {1,-1}; the differential is the isomorphism v -> (x -> [v,x]); and the cross-product Lie algebra is nonabelian and simple.",
+          "inputs": ["given", "A1", "algebra"]
+        },
+        {
+          "id": "step-1-3",
+          "step": "1.3",
+          "claim": "SU(2) has center {1,-1}, SO(3) has trivial center, and the two groups are distinct global forms with isomorphic simple Lie algebras.",
+          "inputs": ["given", "A1", "step 1.1", "step 1.2", "algebra"]
+        },
+        {
+          "id": "step-2-1",
+          "step": "2.1",
+          "claim": "A result at G=SU(2) is one instance and does not discharge the separate G=SO(3) case of the universal group claim.",
+          "inputs": ["given", "step 1.3", "algebra"]
+        }
+      ],
+      "routine_steps": [],
+      "finite_checks": [
+        "For q=1 and q=-1, conjugation fixes every imaginary quaternion.",
+        "For unit n and q=cos(theta/2)+n sin(theta/2), quaternion multiplication gives rotation by theta; theta=0 gives the identity and theta=pi gives the half-turn about n.",
+        "The basis brackets [i,j]=2k, [j,k]=2i, and [k,i]=2j show the nonabelian cross-product structure used in the ideal argument."
+      ],
+      "boundaries": [
+        {
+          "case": "identity rotation",
+          "status": "checked",
+          "evidence": "At theta=0 the chosen quaternion is 1 and its conjugation is the identity."
+        },
+        {
+          "case": "half-turn",
+          "status": "checked",
+          "evidence": "At theta=pi the chosen quaternion is n and conjugation is the half-turn about n."
+        },
+        {
+          "case": "kernel",
+          "status": "checked",
+          "evidence": "Both unit real quaternions 1 and -1 act trivially, and commuting with i and j forces every kernel element to be real."
+        },
+        {
+          "case": "universal group quantifier",
+          "status": "checked",
+          "evidence": "SU(2) and SO(3) are distinct groups with isomorphic simple Lie algebras, so the fixed SU(2) case leaves a separate SO(3) instance."
+        }
+      ]
+    },
