+      "open_problem_review": {
+        "formulation": {
+          "verdict": "pass",
+          "evidence": "The uninterrupted Open problem statement fixes the universal class as compact connected Lie groups with nonabelian simple Lie algebra; distinguishes Euclidean R^4 Schwinger distributions from the reconstructed Minkowski Wightman theory; specifies gauge-invariant curvature operators, short-distance content, vacuum and Hamiltonian conditions; defines the finite positive spectral gap; and keeps confinement outside the claim."
+        },
+        "status": {
+          "verdict": "pass",
+          "evidence": "The current Clay Mathematics Institute problem page was checked on 2026-10-23 and reports the problem unsolved with no proof known. Jaffe–Witten §§5–6 distinguish confinement and chiral symmetry breaking from the prize claim and qualify compact-volume and lower-dimensional partial results; the status text does not promote them to an R^4 continuum construction."
+        },
+        "sources": {
+          "verdict": "pass",
+          "evidence": "Read the full substantive current Clay problem page; read the complete relevant Jaffe–Witten sections §§3–6 in the full CMI-hosted book PDF (printed pp. 134–150); and read the complete relevant §7.3 in Arthur Jaffe's full 16-page lecture-note PDF (PDF pp. 13–15). Exact URLs, locators, item mappings, reading extents, limitations, and fetch stamps are recorded in the batch-23 coverage file. The older note is used only as an independent historical treatment, not as current status."
+        }
+      }
+    },
