        "title": "Fixed-order integration-by-parts and leading-equation field-redefinition relations",
        "reference": "items/prop-aqft-integration-by-parts-eom-and-field-redefinition-redundancy.md",
        "design_state": "Assigned item fully authored in Step 1; readiness is recorded separately.",
        "dependency_level": 3,
        "deps": [
