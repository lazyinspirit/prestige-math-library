  const planned = new Map();
  for (const page of read(join(dir, 'plan-spec.json'))?.pages ?? [])
    for (const item of page.items ?? []) planned.set(item.id, { item, page });
  return { root, run, pages, pairs, items, planned, cache: new Map() };
}

