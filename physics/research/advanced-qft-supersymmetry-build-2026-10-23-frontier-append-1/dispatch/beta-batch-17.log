    // reverse pointer. Reject a contradictory pointer or a shared B page.
    if (!b || (b.companion && b.companion !== a.id) || pairs.has(a.id)
      || claimedCompanions.has(b.id)) throw Error(`Invalid pair ${a.id}`);
    claimedCompanions.add(b.id);
