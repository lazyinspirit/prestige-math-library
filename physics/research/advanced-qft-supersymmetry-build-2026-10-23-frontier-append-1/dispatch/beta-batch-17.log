  if (!s.items.has(id)) throw Error(`Unknown run item ${id}`);
  if (!Array.isArray(extra) || extra.some(d => typeof d !== 'string')) throw Error('dependencies must be an ID array');
  const seen = new Map(), queue = [id, ...extra];
