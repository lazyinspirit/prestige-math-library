/** One-line description for a preflight report. */
#!/usr/bin/env node
// tsx-run.mjs — run one of this repo's .mts tools with an available TS loader.
//
//   node tools/physics-support/tsx-run.mjs tools/physics-support/precheck.mts [item.md ...]
//   node tools/physics-support/tsx-run.mjs tools/physics-support/judge.mts items/<id>.md --parallel
//
// This replaces the hardcoded `node --import /root/Projects/prestige-intelligence/
// worker/node_modules/tsx/dist/loader.mjs <tool>` form that every doc and brief
// used to carry. The loader path is resolved at run time (tools/physics-support/paths.mjs): use
// the app checkout's tsx when installed, otherwise use the repository's minimal
// hook with an installed global TypeScript runtime.

import { spawnSync } from 'node:child_process';
import { tsxLoader } from './paths.mjs';

const [target, ...rest] = process.argv.slice(2);
if (!target) {
  console.error('usage: node tools/physics-support/tsx-run.mjs <tool.mts> [args...]');
  process.exit(2);
}

let loader;
try {
  loader = tsxLoader();
} catch (error) {
  console.error(`tsx-run: ${error.message}`);
  process.exit(2);
}

const result = spawnSync(process.execPath, ['--import', loader, target, ...rest], { stdio: 'inherit' });
if (result.error) {
  console.error(`tsx-run: ${result.error.message}`);
  process.exit(2);
}
process.exit(result.status ?? 1);
// The normative checker reads one line per step; Markdown reads one paragraph.
// Join only soft line breaks within numbered paragraphs. Keep paragraph/step
// boundaries and every mathematical token, citation and justification intact.
export function normalizeNumberedParagraphs(text) {
  return text.split(/(\r?\n[ \t]*\r?\n)/).map(block =>
    /^[ \t]*(?:\*\*)?\d+\.\d+\b/.test(block)
      ? block.replace(/\r?\n(?![ \t]*(?:\*\*)?\d+\.\d+\b)/g, ' ')
      : block
  ).join('');
}

/** Facts declarations plus proof steps, with existing legacy-body support. */
export function checkableText(md) {
  const fa = md.split(/\n## Facts & Assumptions\n/);
  if (fa.length >= 2) return normalizeNumberedParagraphs(fa[fa.length - 1].replace(/^## .*$/gm, '').trim());
  const body = md.split(/\n## (Proof|Refutation|Verification|Counterexample)\n/);
  if (body.length >= 3) return normalizeNumberedParagraphs(body[body.length - 1].trim());
  return null;
}

