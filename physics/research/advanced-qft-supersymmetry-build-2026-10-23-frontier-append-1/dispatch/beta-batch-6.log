def read_item(ident):
    raw=(Path('items')/(ident+'.md')).read_text()
    _,fm,body=raw.split('---',2)
    def scalar(key,default=None):
        m=re.search(rf'"'^{re.escape(key)}:'"\\s*(.*?)\\s*"'$'"',fm,re.M)
        return m.group(1).strip('\"') if m else default
    def listblock(key):
        m=re.search(rf'"'^{re.escape(key)}:'"\\s*\\n((?:[ \\t]+.*\\n|\\n)*)',fm,re.M)
        if not m:return []
        return [x.strip()[2:].strip() for x in m.group(1).splitlines() if x.strip().startswith('- ')]
    def roleblock():
        m=re.search(r'"'^dependency_roles:'"\\s*\\n((?:[ \\t]+.*\\n|\\n)*)',fm,re.M)
        if not m:return {}
        out={}
        for line in m.group(1).splitlines():
            q=re.match(r'\\s+(["'^:#]+):'"\\s*(\\S+)\\s*"'$'"',line)
            if q:out[q.group(1).strip()]=q.group(2).strip()
        return out
    prov={}
    pm=re.search(r'"'^provenance:'"\\s*\\n((?:[ \\t]+.*\\n|\\n)*)',fm,re.M)
    if pm:
        for line in pm.group(1).splitlines():
            q=re.match(r'\\s+(statement|proof):\\s*(\\S+)\\s*"'$'"',line)
            if q:prov[q.group(1)]=q.group(2)
    refs=[]
    sm=re.search(r'"'^sources:'"\\s*\\n((?:[ \\t]+.*\\n|\\n)*)',fm,re.M)
    if sm:
        lines=sm.group(1).splitlines()
        current=None
        for line in lines:
            q=re.match(r'\\s+- title:\\s*\"?(.*?)\"?\\s*"'$'"',line)
            if q:
                if current:refs.append(current)
                current={'title':q.group(1)}
                continue
            q=re.match(r'\\s+url:\\s*\"?(.*?)\"?\\s*"'$'"',line)
            if q and current:current['url']=q.group(1)
            q=re.match(r'\\s+locator:\\s*\"?(.*?)\"?\\s*"'$'"',line)
            if q and current:current['locator']=q.group(1)
        if current:refs.append(current)
    kind=scalar('kind')
    heading={'definition':'Definition','lemma':'Statement','theorem':'Statement','example':'Example'}[kind]
    m=re.search(rf'"'^## {re.escape(heading)}'"\\s*\\n(.*?)(?="'^## |'"\\Z)',body,re.M|re.S)
    if not m: raise RuntimeError(f'no {heading} section in {ident}')
    statement=m.group(1).strip()
    entry={
      'id':ident,'kind':kind,'domain':scalar('domain'),'title':scalar('title'),
      'reference':f'items/{ident}.md','design_state':('Step 1 authored; readiness recording follows final scoped checks.' if ident in planned else 'Step 1 authored; authorized inventory expansion recorded; readiness recording follows final scoped checks.'),
      'dependency_level':int(scalar('dependency_level')),'deps':listblock('deps'),'dependency_roles':roleblock(),
      'inventory_expansion_required':ident not in planned,'statement':statement,'provenance':prov,
      'sources':{'references':refs},'library':scalar('library'),
      'proof_strategy':scalar('proof_strategy','definition' if kind=='definition' else None),
    }
    justified=listblock('justified_by')
    if justified:entry['justified_by']=justified
    if kind=='example':entry['generation']={'role':'example'}
    return entry
pages=json.loads(Path(f'research/{run}-batch-6.pages.json').read_text())
