function localIdentity(s, token) {
  if (!s.identityIndex) {
    const ids = new Map(), aliases = new Map();
    const add = (map, key, name) => {
      if (typeof key !== 'string' || !key) return;
      if (!map.has(key)) map.set(key, new Set());
      map.get(key).add(name);
    };
