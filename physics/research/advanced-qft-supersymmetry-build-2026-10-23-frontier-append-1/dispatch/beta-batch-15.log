        "proof_strategy": "direct"
      },
      {
        "id": "ex-aqft-noninvertible-z2-sum",
        "kind": "example",
        "domain": "mathematics",
        "title": "A non-invertible direct sum in Vec_Z2",
        "reference": "items/ex-aqft-noninvertible-z2-sum.md",
        "design_state": "B-page algebraic example distinguishing non-invertibility of a direct sum from simple non-invertibility.",
