      { "id": "consumer-id", "path": "research/exact-before.md", "sha256": "FROZEN_PATH_RAW_ITEM_SHA256" },
      { "id": "supplier-id", "path": "research/exact-supplier-before.md", "sha256": "FROZEN_PATH_RAW_ITEM_SHA256" }
    ],
