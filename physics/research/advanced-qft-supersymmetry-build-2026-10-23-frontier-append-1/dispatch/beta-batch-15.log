+      url: "https://math.mit.edu/~etingof/egnobookfinal.pdf"
+      locator: "§2.3, the finite-group-graded vector-space tensor product, printed pp. 27–28; §4.1, fusion-category examples, printed pp. 65–66."
+verification:
+  precheck: pending
