function zeros(n){return Array.from({length:n},()=>Array(n).fill(0));}
function eye(n){const a=zeros(n);for(let i=0;i<n;i++)a[i][i]=1;return a;}
function add(a,b){return a.map((r,i)=>r.map((x,j)=>x+b[i][j]));}
function mul(a,b){const n=a.length,m=b[0].length,k=b.length,c=Array.from({length:n},()=>Array(m).fill(0));for(let i=0;i<n;i++)for(let j=0;j<m;j++)for(let t=0;t<k;t++)c[i][j]+=a[i][t]*b[t][j];return c;}
function tr(a){return a[0].map((_,j)=>a.map(r=>r[j]));}
function eq(a,b){return a.every((r,i)=>r.every((x,j)=>Math.abs(x-b[i][j])<1e-10));}
function anti(a,b){return add(mul(a,b),mul(b,a));}
function assert(ok,msg){if("'!ok)throw Error(msg);}
const c1=zeros(4),c2=zeros(4);
c1[0][1]=1;c1[2][3]=1;
c2[0][2]=1;c2[1][3]=-1;
const short=[c1,c2,tr(c2),tr(c1)].map(a=>a.map(r=>r.map(x=>Math.SQRT2*x)));
const shortN=4;
for(let i=0;i<2;i++)for(let j=0;j<2;j++){
  assert(eq(anti(short[i],tr(short[j])),i===j?shortN===4?eye(4).map(r=>r.map(x=>2*x)):null:zeros(4)),`short CAR mixed ${i},${j}`);
  assert(eq(anti(short[i],short[j]),zeros(4)),`short CAR same ${i},${j}`);
}
const q=(I,a)=>short[(I-1)*2+(a-1)];
for(let I=1;I<=2;I++)for(let a=1;a<=2;a++)for(let J=1;J<=2;J++)for(let b=1;b<=2;b++){
 const mixed=anti(q(I,a),tr(q(J,b)));
 assert(eq(mixed,(I===J&&a===b)?eye(4).map(r=>r.map(x=>2*x)):zeros(4)),`short mixed ${I}${a},${J}${b}`);
 const expected=(a===1&&b===2&&I===1&&J===2)||(a===2&&b===1&&I===2&&J===1)?eye(4).map(r=>r.map(x=>2)):zeros(4);
 assert(eq(anti(q(I,a),q(J,b)),expected),`short central ${I}${a},${J}${b}`);
}
assert(eq(add(q(1,1),tr(q(2,2))),zeros(4)),'"'short BPS null combination');
const n=16,cs=Array.from({length:4},()=>zeros(n));
for(let state=0;state<n;state++)for(let j=0;j<4;j++)if(state&(1<<j)){
  const lower=state&((1<<j)-1);let count=0;for(let k=0;k<j;k++)if(lower&(1<<k))count++;
  const target=state&~(1<<j);cs[j][target][state]=count%2?-1:1;
}
const long=cs.map(a=>a.map(r=>r.map(x=>Math.SQRT2*x)));
for(let j=0;j<4;j++)for(let k=0;k<4;k++){
 assert(eq(anti(long[j],tr(long[k])),j===k?eye(n).map(r=>r.map(x=>2*x)):zeros(n)),"'`long CAR mixed ${j},${k}`);
 assert(eq(anti(long[j],long[k]),zeros(n)),`long CAR same ${j},${k}`);
}
