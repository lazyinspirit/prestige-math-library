}
export function reviewInstruction(kind, domain = 'mathematics') {
  if (kind === 'open-problem') return 'Review the exact unresolved question, hypotheses, source attribution, status and date. Never invent a proof, judge stamp, or resolution; open problems cannot supply deps or justified_by for any item. Place established partial results in separate proved items and distinguish missing local authoring from genuinely unresolved claims.';
  if (kind === 'algorithm') return 'Audit the defining procedure exactly as a definition: precise inputs, outputs, admissible conditions, branches, smaller procedure calls and loops. Algorithmic properties require separate proved result items; do not demand a proof merely for instructions. Declare smaller algorithms in deps; execution repetition does not create prerequisite cycles. For physical algorithms check scope, units, assumptions and empirical qualifications; physical consequences require physics-theorem, not mathematical theorem kinds.';
  if (kind === 'postulate') return 'Audit this postulate for exact source-backed formulation, physical meaning, scope, and explicit adopted-assumption status. Do not demand a proof or treat empirical support as deduction. Reject unsupported universality or fabricated source reading.';
  if (kind === 'experiment') return 'Audit this reported experiment for source-backed apparatus, preparation, calibration, procedure, observed results, uncertainty, and limitations. Separate observations from model predictions and interpretations. Reject invented measurements, thought experiments presented as observations, and omitted auxiliary assumptions. Check sampling assumptions, finite-sample fluctuations, uncertainty, model comparisons, and the strength of statistical inference. Finite agreement does not prove a theory; a rare outcome does not automatically falsify it. Do not demand a proof of an observed outcome.';
  if (['physics-theorem', 'thought-experiment'].includes(kind)) return 'Audit the complete conditional proof from explicit mathematical and physical premises. Physics theorems and thought experiments have identical acceptance standards. Check inherited empirical uncertainty, physical regime, units, and apparatus assumptions; deduction does not establish empirical truth. Distinguish expected or almost-sure behavior from claims about every finite dataset, and carry sampling and measurement qualifications.';
  if (domain === 'physics') return 'Audit this physical definition, algorithm, example, counterexample, or remark for operational meaning, explicit physical scope, units, source faithfulness, and clearly stated model assumptions. Apply ordinary complete argument requirements to any verification or refutation. Preserve empirical uncertainty; illustrative calculations are not reported experimental evidence.';
  return 'Apply the unchanged mathematical proof standards to this mathematical item, even when it appears in a physics category. Physical items cannot supply its justification.';
}
// The normative checker reads one line per step; Markdown reads one paragraph.
// Join only soft line breaks within numbered paragraphs. Keep paragraph/step
// boundaries and every mathematical token, citation and justification intact.
export function normalizeNumberedParagraphs(text) {
  return text.split(/(\r?\n[ \t]*\r?\n)/).map(block =>
    /^[ \t]*(?:\*\*)?\d+\.\d+\b/.test(block)
      ? block.replace(/\r?\n(?![ \t]*(?:\*\*)?\d+\.\d+\b)/g, ' ')
      : block
  ).join('');
}

/** Facts declarations plus proof steps, with existing legacy-body support. */
export function checkableText(md) {
  const fa = md.split(/\n## Facts & Assumptions\n/);
  if (fa.length >= 2) return normalizeNumberedParagraphs(fa[fa.length - 1].replace(/^## .*$/gm, '').trim());
  const body = md.split(/\n## (Proof|Refutation|Verification|Counterexample)\n/);
  if (body.length >= 3) return normalizeNumberedParagraphs(body[body.length - 1].trim());
  return null;
}

