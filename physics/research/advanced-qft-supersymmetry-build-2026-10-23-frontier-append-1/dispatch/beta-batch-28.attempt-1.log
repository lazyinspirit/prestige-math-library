  const rep = r[0];
  const did = r[1];
  if (/^\s*(?:\*\*)?\d+\.\d+\b/m.test(rep.split(QED_RE).pop() as string))
    return { err: 'qed-not-final-postrepair', strategy: strat };
  return { err: null, strategy: strat, repaired: did, proof: rep };
}

/* ── EXTENSIONS (2026-07-17 fix round, shared by BOTH dataset engines) ── */

/** F3/B10: strip escalation-retry meta-talk from scratch, sentence-scoped. */
export function scrubRetryMetaTalk(scratch: string): { scratch: string; scrubbed: boolean } {
  const LEAK = /previous (attempt|rejection|version|issue|proof|error)|was rejected|the verifier|the reviewer|the rejection/i;
  const sentences = String(scratch || '').split(/(?<=[.!?])\s+/);
  const kept = sentences.filter((x) => !LEAK.test(x));
  if (kept.length === sentences.length) return { scratch, scrubbed: false };
  return { scratch: kept.join(' ').trim(), scrubbed: true };
}

/** O8: strip a trailing meta closing step; re-attach the QED glyph to the real
 *  final step so the parity precheck still sees a terminal ∎. */
export function stripMetaClosing(p: string): string {
  const lines = String(p || '').split('\n');
  for (let i = lines.length - 1; i >= 0; i--) {
    const t = lines[i].trim();
    if (!t) continue;
    const isMeta = /^(?:\*\*)?\d+\.\d+\s+This (?:completes|finishes|concludes) the proof\b[^\[\]]*?(?:\[[^\[\]]*\])?\s*\.?\s*[∎■□]?\s*(?:\*\*)?$/i.test(t);
    if (isMeta) {
      const hadQed = /[∎■□]/.test(t);
      lines.splice(i, 1);
      if (hadQed) {
        for (let k = lines.length - 1; k >= 0; k--) {
          if (/^\s*(?:\*\*)?\d+\.\d+\b/.test(lines[k].replace(/\*\*/g, ''))) {
            if (!/[∎■□]/.test(lines[k])) lines[k] = lines[k].replace(/\s*$/, ' ∎');
            break;
          }
        }
      }
    }
    break;
  }
  return lines.join('\n');
}

/** Fix 2 mechanical layer: every [def. X] STEP tag must resolve to a
 *  "[def. X] <definition>" line in the **Definitions:** block. */
export function undeclaredDefTags(proof: string): string[] {
  const blockTerms = new Set<string>();
  const stepTerms: string[] = [];
  for (const line of String(proof || '').split('\n')) {
    const stripped = line.replace(/\*\*/g, '').trim();
    const isStep = /^\d+\.\d+\b/.test(stripped);
    const re = /\[def\.\s*([^\[\]]+?)\]/gi;
    let m: RegExpExecArray | null;
    while ((m = re.exec(stripped))) {
      const term = m[1].trim().toLowerCase();
      if (isStep) stepTerms.push(term);
      else blockTerms.add(term);
    }
    if (isStep) {
      const tg = /\[([^\[\]]+)\]/g;
      let g: RegExpExecArray | null;
      while ((g = tg.exec(stripped))) {
        for (const tok of g[1].split(',')) {
          const t = tok.trim();
          if (/^def\./i.test(t)) stepTerms.push(t.replace(/^def\.\s*/i, '').trim().toLowerCase());
        }
      }
    }
  }
  if (!stepTerms.length) return [];
  return [...new Set(stepTerms.filter((t) => t && !blockTerms.has(t)))].sort();
}

/** B19: instructions must be self-contained (no dangling source-context refs). */
export const CONTEXT_DEPENDENT_RE = /described above|as above|see above|previous (lemma|section|proposition)|the notation of (Section|Chapter)/i;

/** Intervention 2 (2026-07-18): a rejection whose reason is a SYMBOL-SCOPE error
 *  (use-before-bind / forward reference / redefinition / out-of-scope). Interleaved
 *  two-direction chases produce exactly these; a targeted escalation instruction
