+  def-aqft-eft-scattering-channel: formulation-prerequisite
+  pthm-aqft-forward-positivity-wilson-coefficient: physical-result
+justified_by: []
+proof_strategy: direct
+provenance:
+  statement: ai-generated
+  proof: ai-generated
+generation:
