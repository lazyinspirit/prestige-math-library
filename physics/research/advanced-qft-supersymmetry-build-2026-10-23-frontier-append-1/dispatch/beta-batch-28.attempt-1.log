export const SCOPE_REJECT_RE =
  /before (?:it|they|[a-z]+) (?:is |are |was |being )?(?:defined|introduced)|forward[- ]reference|not (?:defined|introduced) until|out[- ]of[- ]scope|redefin|used before/i;

export function scopeRepairHint(reason: string): string {
  return SCOPE_REJECT_RE.test(String(reason || ''))
    ? ` This is a SYMBOL-SCOPE error: prove each direction/case of the argument in its OWN contiguous block of phases; introduce EVERY symbol with its own "Let …" / [choose] / [construct] step BEFORE any step that uses it; and use FRESH symbol names in each direction ($x$, $x'$, $x_1$, $x_2$) — never reuse or redefine a symbol across directions.`
    : '';
}

