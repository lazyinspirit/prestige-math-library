let stamped = 0;
let sources = 0;
let dropped = 0;
const failures = [];

for (const file of coverages) {
  const path = absolute(file);
  if (!existsSync(path)) { console.error(`ERROR fetch-check-no-coverage: ${file}`); process.exit(1); }
