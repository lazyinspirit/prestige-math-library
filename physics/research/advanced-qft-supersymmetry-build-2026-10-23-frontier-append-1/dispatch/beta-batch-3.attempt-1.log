  return Boolean(stamp && Number.isFinite(Date.parse(stamp.at))
    && Number.isFinite(stamp.bytes) && stamp.bytes > 0
    && ['pdf', 'html', 'text'].includes(stamp.kind)
    && (/^[a-f0-9]{16}$/.test(stamp.sha256_16 ?? '')
      || /^[a-f0-9]{64}$/.test(stamp.sha256 ?? '')));
}

