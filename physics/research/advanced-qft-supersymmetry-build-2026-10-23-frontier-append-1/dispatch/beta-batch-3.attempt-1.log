        "title": "Generalized Newtonian, Bingham and conformation model equations",
        "reference": "items/def-fd-nonnewtonian-laws.md",
        "design_state": "Step 1 complete draft; readiness recorded separately.",
        "dependency_level": 1,
        "deps": [
