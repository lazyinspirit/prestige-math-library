import { readFileSync } from 'node:fs';
import { loadStep1Record } from '/home/lazyinspirit/Projects/prestige-math-library-aqft-20261023/physics/tools/physics-support/frontier-snapshot.mjs';
import { step1Decision, recordStep1 } from '/home/lazyinspirit/Projects/prestige-math-library-aqft-20261023/physics/tools/physics-support/step1-decisions.mjs';
const root='/home/lazyinspirit/Projects/prestige-math-library-aqft-20261023/physics';
const run='advanced-qft-supersymmetry-build-2026-10-23';
const pages=JSON.parse(readFileSync("'`${root}/research/${run}-batch-8.pages.json`,'"'utf8'));
const itemPage=new Map(pages.flatMap(page=>page.items.map(item=>[item.id,{item,page}])));
let snapshot=loadStep1Record(root,run);
const existing=[...itemPage.keys()].map(id=>[id,step1Decision(snapshot,id)]);
const escalated=existing.filter(([,d])=>d.row?.decision==='escalated');
if(escalated.length) throw Error("'`Refusing to overwrite existing escalation(s): ${escalated.map(([id])=>id).join('"', ')}"'`);
const rank=(x,y)=>x.item.dependency_level-y.item.dependency_level||x.item.id.localeCompare(y.item.id);
const ordered=[...itemPage.values()].sort(rank);
const rows=[];
for(const {item,page} of ordered){
  snapshot=loadStep1Record(root,run);
  const prior=step1Decision(snapshot,item.id);
  if(prior.closed){rows.push({item:item.id,decision:'"'ready',preserved:true,sha256:prior.row.sha256});continue;}
  if(prior.row?.decision==='escalated') throw Error("'`Refusing to overwrite escalation for ${item.id}`);
  for(const dep of item.deps??[]){
    if(snapshot.items.has(dep)){
      const status=step1Decision(snapshot,dep);
      if(!status.closed) throw Error(`${item.id}: in-run supplier ${dep} is not current and ready (${status.reason})`);
    }
  }
  const pageLabel=page.kind==='"'A'?'A page':'B examples page';
  let reason="'`Complete conditional argument and scoped interface inspection are recorded in the item and strict proof contract. Direct dependencies are listed in the readiness record; all in-run suppliers are current and ready. Placement is ${pageLabel} ${page.id}, dependency level ${item.dependency_level}. Focused depcheck, content policy, strict proof contract, and explicit proof-layout checks pass; no mathematical prerequisite is unresolved.`;
  if(item.id==='"'def-qftx-character-localization') reason+=' The two cross-batch real-coefficient/Borel supplier records are hash-current ready, and both item edges plus the required page edge are verified.';
  rows.push(recordStep1(root,{run,item:item.id,decision:'ready',dependencies:item.deps??[],reason}));
}
console.log(JSON.stringify(rows.map(r=>({item:r.item,decision:r.decision,dependencies:r.dependencies.length,sha256:r.sha256})),null,2));
