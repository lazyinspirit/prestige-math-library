import { readFileSync } from 'node:fs';
import { loadStep1Record } from '/home/lazyinspirit/Projects/prestige-math-library-aqft-20261023/physics/tools/physics-support/frontier-snapshot.mjs';
import { step1Decision, recordStep1 } from '/home/lazyinspirit/Projects/prestige-math-library-aqft-20261023/physics/tools/physics-support/step1-decisions.mjs';
const root='/home/lazyinspirit/Projects/prestige-math-library-aqft-20261023/physics';
const run='advanced-qft-supersymmetry-build-2026-10-23';
const pages=JSON.parse(readFileSync("'`${root}/research/${run}-batch-8.pages.json`,'"'utf8'));
const rows=pages.flatMap(page=>page.items.map(item=>({item,page})));
for(const level of [1,3,4,5,6]){
  const snapshot=loadStep1Record(root,run);
  const group=rows.filter(x=>x.item.dependency_level===level);
  for(const {item} of group){
    const prior=step1Decision(snapshot,item.id);
    if(prior.row?.decision==='escalated') throw Error("'`Refusing to overwrite escalation for ${item.id}`);
    if(prior.closed) continue;
    for(const dep of item.deps??[]) if(snapshot.items.has(dep)){
      const supplier=step1Decision(snapshot,dep);
      if(!supplier.closed) throw Error(`${item.id}: required in-run supplier ${dep} is not ready: ${supplier.reason}`);
    }
  }
  const writes=await Promise.all(group.map(({item,page})=>{
    const prior=step1Decision(snapshot,item.id);
    if(prior.closed) return {item:item.id,preserved:true,decision:'"'ready'};
    const place=page.kind==='A'?"'`A page ${page.id}`:`B examples page ${page.id}`;
    let reason=`Complete argument and final scoped evidence are in the current item and proof contract. The readiness row lists every direct dependency; all in-run suppliers have current ready records. Placement is ${place}; computed dependency level is ${level}. Focused dependency check, content policy, strict contract, coverage, source-fetch, and explicit proof-layout checks pass. No mathematical prerequisite remains unresolved.`;
    if(item.id==='"'def-qftx-character-localization') reason+=' Both Batch-7 inputs are hash-current ready and the page and item cross-batch edges are verified.';
    return recordStep1(root,{run,item:item.id,decision:'ready',dependencies:item.deps??[],reason});
  }));
  console.log(JSON.stringify({level,items:writes.map(x=>({item:x.item,decision:x.decision,preserved:"'!!x.preserved,sha256:x.sha256?.slice(0,12)}))}));
}
