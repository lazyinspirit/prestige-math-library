  assert.equal(sourceDropped(s), true);
  s.source_resolution.alternatives = [];
  assert.equal(sourceDropped(s), false);
  s.source_resolution = source().source_resolution;
  s.source_resolution.decided_by = 'unknown';
  assert.equal(sourceDropped(s), false);
});

