      {
        "id": "pthm-em-wave-energy-average",
        "kind": "physics-theorem",
        "domain": "physics",
        "title": "Period-averaged energy density, Poynting vector and momentum flux of a plane wave",
        "reference": "core-conditional-proofs.md#K7",
        "design_state": "complete-exact-conditional-research-argument",
        "dependency_level": 19,
