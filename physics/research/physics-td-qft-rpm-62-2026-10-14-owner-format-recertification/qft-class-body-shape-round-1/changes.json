    "final_raw_sha256": "1403be83bf8181491fa8c80ba20000ee4ec597263b488819fcfbd15872077260",
    "original_positive_statement_preserved_verbatim": true,
    "numbered_argument_unchanged": true,
    "new_statement_refuted": "Assume Countable Choice and the indefinite auxiliary form and subsidiary quotient of [[lem-qft-photon-null-quotient]]. Every vector in the auxiliary space $\\mathcal K$ has nonnegative quadratic form $[\\epsilon,\\epsilon]_\\eta$."
