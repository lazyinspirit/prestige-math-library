  {
    "id": "cex-qft-qed-coulomb-potential-locality",
    "batch": "44",
    "kind": "counterexample",
    "missing": [
      "Statement refuted",
      "Counterexample"
    ],
    "source": "items/cex-qft-qed-coulomb-potential-locality.md",
    "before_raw_sha256": "56ef23663315cde5f3ca50c94e2d728124e712a1a895b188bf194bcba1d7afea",
    "final_raw_sha256": "acc7acbdec4ab800c022f5fbe0c5b92379aeda1707e80da0ecaed8b3e6522f62",
    "original_positive_statement_preserved_verbatim": true,
    "numbered_argument_unchanged": true,
    "new_statement_refuted": "Assume Countable Choice and the equal-time Coulomb-gauge potential commutator and transverse-projector kernel in [[lem-qft-photon-smeared-potential]] and [[lem-qft-photon-transverse-projector-kernel]]. The distribution kernel of every $[A_i(\\mathbf x),E_j(\\mathbf y)]$ is supported on the diagonal $\\mathbf x=\\mathbf y$; equivalently, its pairing with every pair of smooth compactly supported tests having disjoint spatial supports vanishes."
  },
  {
    "id": "cex-qft-qed-torus-charge",
