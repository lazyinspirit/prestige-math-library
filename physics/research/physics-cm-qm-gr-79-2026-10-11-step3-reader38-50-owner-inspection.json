      "routing": "owner-downstream-consumer-repair",
      "smallest_missing_requirement": "F2 claims for every real α that (ℏ²/2m)A_α has ψ_α as an eigenvector with eigenvalue −ℏ²α²/(8m), without restricting this eigenpair claim to α<0. The current source theorem thm-nrqm-intervals-delta-unique-bound-state defines this normalized bound state and proves its eigenvalue only for α<0; for α≥0 it states there is no negative eigenvalue. The batch-51 proof uses the scaled eigenpair only for g<0, so its conclusions remain supported, but the extra fact in F2 is false or undefined outside that range. Restrict the scaled eigenvector clause to α<0.",
      "original_finding": {
        "id": "pthm-nrqm-potentials-delta-point-interaction-bound-state",
        "subject_type": "in-flight-item",
        "consumer_id": null,
        "observed_source": null,
        "location": "items/pthm-nrqm-potentials-delta-point-interaction-bound-state.md:118, Facts & Assumptions [F2], trailing scaled-operator clause",
        "defect": "false-claim",
        "evidence": "F2 claims for every real α that (ℏ²/2m)A_α has ψ_α as an eigenvector with eigenvalue −ℏ²α²/(8m), without restricting this eigenpair claim to α<0. The current source theorem thm-nrqm-intervals-delta-unique-bound-state defines this normalized bound state and proves its eigenvalue only for α<0; for α≥0 it states there is no negative eigenvalue. The batch-51 proof uses the scaled eigenpair only for g<0, so its conclusions remain supported, but the extra fact in F2 is false or undefined outside that range. Restrict the scaled eigenvector clause to α<0.",
        "severity": "nonfatal"
      },
