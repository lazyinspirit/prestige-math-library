      },
      {
        "id": "ex-td-forbidden-pair-beta-zero",
        "kind": "example",
        "domain": "physics",
        "title": "Hard-core exclusion retained at zero inverse temperature",
        "statement": "In an interval $\\Lambda=[0,L]$, let two particles have hard-core radius $a$ with $0<a<L$. Under the retained-admissibility zero-inverse-temperature preparation, the weight is zero on $|x_1-x_2|<a$ and equals $z^2$ on $|x_1-x_2|\\geq a$. Hence this law is not the unrestricted Poisson activity law, which assigns positive mass to the forbidden band. The conclusion concerns the finite positional continuation defined on the A page.",
        "deps": [
          "def-td-stable-tempered-continuum-preparation",
          "post-td-classical-indistinguishable-particle-measure",
          "def-td-retained-hard-core-zero-beta-preparation"
        ],
        "dependency_roles": {
