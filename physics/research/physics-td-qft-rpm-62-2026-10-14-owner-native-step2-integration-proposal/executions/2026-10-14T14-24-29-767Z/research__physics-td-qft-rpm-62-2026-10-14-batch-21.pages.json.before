      {
        "id": "ex-td-nonunique-variational-phases",
        "kind": "example",
        "domain": "physics",
        "title": "Two minimizers in a reduced coexistence model",
        "statement": "Consider the reduced coarse-grained variational model with scalar dimensionless order parameter $m\\in[-1,1]$ and dimensionless free-energy function $g(m)=(m^2-1)^2$. Its global minimizers are $m=-1$ and $m=1$. This model shows why uniqueness must be stated as a parameter-specific assumption. It does not identify these two minimizers with Gibbs measures of a continuum pair potential.",
        "deps": [
          "post-td-grand-variational-phase-uniqueness"
        ],
        "dependency_roles": {
