    "cex-qft-formal-factorial-series": {
      "citations": [],
      "derivations": [
        {
          "id": "step-1-1",
          "claim": "Each $n!$ is a finite complex number, so the sequence $(n!)_{n\\ge0}$ defines an element $S(g)=\\sum_{n\\ge0}n!g^n$ of $\\mathbb C\\llbracket g\\rrbracket$ by [A1], irrespective of numerical convergence.",
          "step": "1.1",
          "inputs": [
            "given",
            "A1",
            "algebra"
          ]
        },
        {
          "id": "step-1-2",
          "claim": "Fix any $g\\ne0$ and put $t_n=n!g^n$. Then $|t_{n+1}|/|t_n|=(n+1)|g|$, which is greater than $2$ for all sufficiently large $n$. Hence $|t_n|$ eventually grows by a factor greater than $2$ at every step, so $t_n$ does not tend to zero.",
          "step": "1.2",
          "inputs": [
            "given",
            "algebra"
          ]
        },
        {
          "id": "step-2-1",
          "claim": "If the numerical series $\\sum_nt_n$ converged, its partial sums $s_N:=\\sum_{n=0}^Nt_n$ would converge, so $t_n=s_n-s_{n-1}\\to0$ as $n\\to\\infty$; step 1.2 rules this out for every nonzero $g$. At $g=0$, the convention $g^0=1$ leaves only the constant term, so the series equals $1$. Thus the series converges at no nonzero $g$. For every $r>0$, the point $g=r/2$ lies in $|g|<r$ and gives divergence, so no positive $r$ satisfies the defining property of the radius; $r=0$ satisfies it vacuously. Therefore $R=0$ and the claimed positive radius fails.",
          "step": "2.1",
          "inputs": [
            "A1",
            "step 1.2",
            "algebra"
          ]
        }
      ],
