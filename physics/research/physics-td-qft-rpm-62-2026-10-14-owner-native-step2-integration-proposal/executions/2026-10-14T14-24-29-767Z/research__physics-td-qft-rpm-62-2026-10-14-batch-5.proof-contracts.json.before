          ]
        },
        {
          "fact": "F2",
          "source": "lem-tdmath-exact-multiple-implies-pfaff-integrability",
          "source_section": "Statement",
          "quote": "Let $U\\subseteq\\mathbb R^{n+1}$ be open. Let $\\omega$ be a $C^1$ one-form on $U$, $\\mu\\in C^1(U)$ nowhere zero, and $S\\in C^2(U)$ with $dS=\\mu\\omega$. Then $\\omega\\wedge d\\omega=0$ on $U$.",
