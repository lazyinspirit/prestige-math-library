        }
      ],
      "derivations": [
        {
          "id": "step-1-1",
          "claim": "On $\\mathbb R^3$ with coordinates $(x,y,z)$ take $\\omega=dz-y\\,dx$. It is smooth and nowhere zero because the $dz$ coefficient is $1$.",
          "step": "1.1",
