        },
        {
          "case": "endpoints",
          "status": "checked",
          "evidence": "U is open, so no boundary-point extension is claimed; the rectangle argument is restricted to rectangles in U, step 1.1."
        },
        {
          "case": "nonempty-choice",
          "status": "checked",
          "evidence": "Only a point and two coordinate directions are fixed; the argument uses no choice principle, step 1.1."
        },
        {
