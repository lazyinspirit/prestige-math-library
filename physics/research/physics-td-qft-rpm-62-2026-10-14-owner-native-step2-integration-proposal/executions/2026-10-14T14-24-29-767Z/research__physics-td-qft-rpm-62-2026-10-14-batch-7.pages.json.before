      },
      {
        "id": "post-td-universal-thermal-range",
        "kind": "postulate",
        "domain": "physics",
        "title": "Universal thermal-equilibrium range T5",
        "statement": "Adopt **T5 (universal thermal-equilibrium range)**: for every ordered pair of simple systems $i,j$, each state $x$ of $i$, and every work-coordinate point $v_j$ in the projection of the state domain of $j$, there is some state $y=(u_j,v_j)$ of $j$ with $x\\sim_T y$, using [[def-td-thermal-join]].\n\nThis is a quantified existence assumption for a thermal-equilibrium partner at each permitted work coordinate. It does not define a numerical temperature, assert that all systems possess the same temperature range as a real apparatus, or supply a calibration map and its uncertainty.",
        "deps": [
          "def-td-thermal-join",
          "post-td-thermal-join-axioms"
        ],
        "dependency_roles": {
          "def-td-thermal-join": "formulation-prerequisite",
          "post-td-thermal-join-axioms": "operational-prerequisite"
        },
        "provenance": {
