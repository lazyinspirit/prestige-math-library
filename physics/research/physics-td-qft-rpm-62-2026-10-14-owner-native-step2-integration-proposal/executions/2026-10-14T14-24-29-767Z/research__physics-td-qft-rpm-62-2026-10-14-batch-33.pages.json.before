        "id": "cex-emg-conformal-maxwell-not-einstein",
        "kind": "counterexample",
        "domain": "mathematics",
        "library": "mathematics",
        "title": "Conformal Maxwell symmetry fails to preserve electrovac geometry",
        "reference": "research/extended-frameworks-2026-10-03/einstein-maxwell-models/integrator-inventory.json#cex-emg-conformal-maxwell-not-einstein; proof module research/extended-frameworks-2026-10-03/einstein-maxwell-models/complete-local-arguments.md#C2",
