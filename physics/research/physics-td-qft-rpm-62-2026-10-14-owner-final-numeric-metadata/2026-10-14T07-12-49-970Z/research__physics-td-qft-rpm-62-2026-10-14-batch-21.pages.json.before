        "kind": "definition",
        "domain": "physics",
        "title": "Stable regularly tempered classical positional preparation",
        "statement": "Defines the reference length, positional configuration, pair energy, stability, integrable tail, units, and free or periodic positional models.",
        "deps": [],
        "dependency_roles": {},
