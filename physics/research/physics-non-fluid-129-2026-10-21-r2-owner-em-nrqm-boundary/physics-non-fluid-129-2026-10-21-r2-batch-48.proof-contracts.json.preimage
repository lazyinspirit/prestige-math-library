          "consumer_use": "F8 supplies this interface in step(s) 2.1."
        },
        {
          "supplier": "cor-finite-dimensional-inner-product-spaces-have-orthonormal-bases",
          "carrier": "items/cor-finite-dimensional-inner-product-spaces-have-orthonormal-bases.md",
