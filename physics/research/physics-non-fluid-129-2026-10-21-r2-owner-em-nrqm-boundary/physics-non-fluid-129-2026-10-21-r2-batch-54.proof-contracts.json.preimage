          ]
        },
        {
          "fact": "F1",
          "source": "ex-nrqmx-two-band-gap-closures",
          "source_section": "Example",
          "quote": "Assume Axiom of Choice and Countable Choice. For $M\\in\\mathbb R$, consider the two-orbital finite-range Bloch Hamiltonian",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F2",
          "source": "thm-nrqmx-bloch-projector-chern",
          "source_section": "Statement",
          "quote": "Assume Axiom of Choice and Countable Choice. Let $P:\\mathbb T^2_{2\\pi}\\to M_r(\\mathbb C)$ be a $C^2$ orthogonal projector of constant rank $m\\ge1$; in particular it may be the projector of an isolated band cluster of a finite-range Bloch Hamiltonian. Use the orientation $dk_1\\wedge dk_2$, let $E_P=\\operatorname{im}P$, and let $F=P(dP\\wedge dP)P$ be the curvature of the projected connection $\\nabla=P\\,d$. Then",
          "uses": [
