        },
        {
          "id": "step-2-1",
          "claim": "Apply [F2] to that frame: it would force $C(P_-)=0$, contradicting step 1.1's value $-1$. Thus this smooth isolated band has no global smooth periodic normalized eigenvector, refuting the universal statement.",
          "step": "2.1",
          "inputs": [
            "F2",
            "step 1.1",
            "algebra"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
