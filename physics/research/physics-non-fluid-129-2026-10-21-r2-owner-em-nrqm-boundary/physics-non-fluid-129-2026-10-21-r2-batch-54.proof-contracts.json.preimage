        }
      ],
      "derivations": [
        {
          "id": "step-1-1",
          "claim": "By [F1], this is a smooth rank-one orthogonal band projector with $C(P_-)=-1\\ne0$. Suppose it had a global smooth periodic normalized eigenvector $u(k)$. Since its range is one-dimensional, $u(k)$ would be a global orthonormal frame of the line bundle.",
          "step": "1.1",
          "inputs": [
            "A1",
