    "lem-nrqmx-determinant-line-projector-well-defined": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-nrqmx-determinant-line-projector",
          "source_section": "Definition",
          "quote": "Let $M$ be a smooth manifold, let $r\\ge1$, and let $P:M\\to M_r(\\mathbb C)$ be a $C^2$ orthogonal projector of constant rank $m$, with $1\\le m\\le r$. Its image bundle is $E_P=\\{(x,v):P(x)v=v\\}$, with the projected connection $\\nabla s=P\\,ds$ of [[def-nrqmx-smooth-projector-bundle]]. The **determinant line bundle** is the complex line bundle",
          "uses": [
            "1.1",
            "2.1"
          ]
        },
        {
          "fact": "F2",
          "source": "thm-exterior-powers-are-functorial",
          "source_section": "Statement",
          "quote": "For linear maps $T:V\\to W$ and $S:W\\to U$ and every $k\\ge0$, the induced maps of [[def-kth-exterior-power-of-a-linear-map]] satisfy",
          "uses": [
            "2.1",
            "3.1"
          ]
        },
        {
          "fact": "F3",
          "source": "thm-the-matrix-of-an-exterior-power-is-the-signed-minor-matrix",
          "source_section": "Statement",
          "quote": "Let $V,W$ be finite-dimensional with ordered bases $(e_1,\\ldots,e_n)$ and $(f_1,\\ldots,f_m)$, let $T:V\\to W$ be linear with matrix $A=(a_{ij})$, so $T(e_j)=\\sum_ia_{ij}f_i$, and let $1\\le k\\le\\min(n,m)$. In the wedge bases $(e_I)$ and $(f_J)$ of [[thm-increasing-basis-wedges-form-a-basis]], the matrix of $\\Lambda^kT$ has entries",
          "uses": [
            "1.1",
            "4.1"
          ]
        },
        {
          "fact": "F4",
          "source": "thm-increasing-basis-wedges-form-a-basis",
          "source_section": "Statement",
          "quote": "Let $V$ have the ordered basis $(e_1,\\ldots,e_n)$ over $F$ and let $0\\le k\\le n$. For each $k$-element subset $I=\\{i_1<\\cdots<i_k\\}\\subseteq\\{1,\\ldots,n\\}$ write",
          "uses": [
            "1.1",
            "3.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "step-1-1",
          "claim": "In the standard orthonormal wedge basis from [F4], the matrix entry of $\\bigwedge^m T$ in row $I$, column $J$ is $\\det T_{I,J}$ by [F3]. Consequently $[(\\bigwedge^mT)^*]_{I,J}=\\overline{\\det T_{J,I}}=\\det (T^*)_{I,J}$, so $(\\bigwedge^mT)^*=\\bigwedge^m(T^*)$. Applying this to $P=P^*$ shows $Q=Q^*$.",
          "step": "1.1",
          "inputs": [
            "F1",
            "F3",
            "F4",
            "algebra"
          ]
        },
        {
          "id": "step-2-1",
          "claim": "Functoriality [F2] gives $Q^2=\\bigwedge^m(P^2)=\\bigwedge^mP=Q$. Hence $Q$ is a Hermitian idempotent by step 1.1; for $x=Qy$ and $Qz=0$, $\\langle x,z\\rangle=\\langle Qy,z\\rangle=\\langle y,Qz\\rangle=0$, so its range and kernel are orthogonal and it is the orthogonal projection onto its range.",
          "step": "2.1",
          "inputs": [
            "F1",
            "F2",
            "step 1.1",
            "algebra"
          ]
        },
        {
          "id": "step-3-1",
          "claim": "Every decomposable wedge in the image of $Q$ is a wedge of $m$ vectors in $\\operatorname{im}P$, so the full image lies in $\\bigwedge^m\\operatorname{im}P$. Conversely, for a basis $v_1,\\ldots,v_m$ of the $m$-dimensional range of $P$, $Q(v_1\\wedge\\cdots\\wedge v_m)=v_1\\wedge\\cdots\\wedge v_m\\ne0$. The increasing-wedge basis theorem [F4], applied to this basis of the range, says $\\bigwedge^m\\operatorname{im}P$ is one-dimensional; thus it equals $\\operatorname{im}Q$ and $Q$ has rank one.",
          "step": "3.1",
          "inputs": [
            "F2",
            "F4",
            "step 2.1"
          ]
        },
        {
          "id": "step-4-1",
          "claim": "Each matrix entry of $Q(x)$ is a polynomial minor in the entries of $P(x)$ by [F3], hence is $C^2$. Together with step 2.1 this proves that $Q$ is a $C^2$ rank-one orthogonal projector with the stated range, and its ranges form the determinant line subbundle.",
          "step": "4.1",
          "inputs": [
            "F3",
            "step 2.1",
            "step 3.1"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "The statement assumes 1≤m≤r; zero rank is excluded."
        },
        {
          "case": "zero",
