    "post-nrqmx-magnetic-model-extension": {
      "citations": [],
      "derivations": [],
      "routine_steps": [],
      "boundaries": [],
      "finite_checks": [],
      "physics_review": {
        "formulation": {
          "verdict": "pass",
          "evidence": "The adopted SI form states -i hbar grad - qA, all fields and potential units, a fixed joule normalization for form norms, and an optional spin-half Pauli core form with declared real dimensionless g."
        },
        "scope": {
          "verdict": "pass",
          "evidence": "A nonrelativistic point-particle model with a static smooth external vector potential and locally integrable lower-bounded scalar potential in Euclidean space, in SI units. An optional spin-half Pauli coupling is an effective model term only when its form is closable and semibounded; no measured g-factor or relativistic correction is asserted."
        },
        "sources": {
