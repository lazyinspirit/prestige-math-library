      "supplier_excerpts": [
        {
          "supplier": "def-countable-choice",
          "carrier": "items/def-countable-choice.md",
          "status": "Published mathematical supplier; exact current Definition inspected.",
          "source_section": "Definition",
          "exact_statement": "The **Axiom of Countable Choice**, written $\\mathrm{AC}_\\omega$, is the following\nstatement.\n\n> For every family $(X_n)_{n \\in \\mathbb{N}}$ of nonempty sets indexed by\n> $\\mathbb{N}$ there is a function $f$ with domain $\\mathbb{N}$ such that\n> $f(n) \\in X_n$ for every $n \\in \\mathbb{N}$.\n\nEquivalently, in the vocabulary of Choice function: every at most\ncountable family of nonempty sets has a choice function.",
          "relevant_hypotheses_and_conventions": "[A1] [A1] Countable Choice is [[def-countable-choice]], the hypothesis carried by [[thm-nrqmx-adiabatic-geometric-phase-bound]].",
          "supplier_proof_status": "Definition item; no proof is claimed or required for the defining interface.",
          "consumer_use": "[A1] [A1] Countable Choice is [[def-countable-choice]], the hypothesis carried by [[thm-nrqmx-adiabatic-geometric-phase-bound]]."
