      "actual_failed_native_evidence": "ERROR decision-not-applied: [lem-rpm-ll-reduced-ode] accepted_repair no longer matches the reader result",
      "current_byte_archive": "research/physics-td-qft-rpm-62-2026-10-14-owner-stage3-native-battery-rpm-emg-round1/source-current/lem-rpm-ll-reduced-ode.md"
