      {
        "id": "lem-bounded-bilateral-sequence-ball-is-complete",
        "kind": "lemma",
        "title": "The bounded functions on a set form a complete metric space in the supremum metric, and every closed ball of bounded sequences is complete",
        "dependency_level": 3,
        "deps": [
          "def-bilateral-symbol-and-bounded-sequence-space",
          "lem-cm-bilateral-shift-metric-and-sequential-compactness",
          "lem-sup-metric-is-a-metric",
          "def-metric-space",
          "def-cauchy-in-metric",
          "def-metric-convergence",
          "def-complete-metric-space",
          "thm-cauchy-criterion-via-lub",
          "lem-limit-preserves-order",
          "def-sequence",
          "def-bounded-set",
          "lem-sup-unique",
          "def-complete-ordered-field",
          "lem-of-abs-value",
          "def-abs-value"
        ],
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "reference": "mechanical-horseshoe.md#1 (completeness of the bounded-sequence space and of B_R)",
        "design_state": "completed-local-argument",
        "inventory_expansion_required": false,
        "statement": "For a nonempty set S the space of bounded real functions with the supremum metric is complete; for every R>0 the closed ball of functions bounded by R is itself a complete metric space; specialising S=Z and S=N gives that l-infinity(Z), l-infinity(N) and their closed balls B_R are complete.",
        "strategy": "Coordinatewise Cauchy limits, the completeness of R, a uniform two-index estimate for sup convergence, and the stability of the bound |f(s)|<=R under pointwise limits.",
        "sources": {
          "references": [
            {
              "title": "G. Teschl, Ordinary Differential Equations and Dynamical Systems, AMS Graduate Studies in Mathematics 140 (author's preliminary online edition, complete PDF)",
              "url": "https://www.mat.univie.ac.at/~gerald/ftp/book-ode/ode.pdf"
