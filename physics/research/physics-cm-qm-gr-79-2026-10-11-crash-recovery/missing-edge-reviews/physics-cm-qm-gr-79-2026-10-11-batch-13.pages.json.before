      {
        "id": "def-smooth-periodic-oscillator-pulse-model",
        "kind": "definition",
        "title": "The smooth P-periodic pulsed oscillator: the normalized bump w, the periodic potential, its Hamiltonian and the stroboscopic (period) map",
        "dependency_level": 1,
        "deps": [
          "def-cm-stroboscopic-map",
          "lem-test-function-cutoffs-and-euclidean-localization",
          "def-ck-euclidean-maps-and-diffeomorphisms",
          "def-first-order-ode-initial-value-problem-and-solution",
