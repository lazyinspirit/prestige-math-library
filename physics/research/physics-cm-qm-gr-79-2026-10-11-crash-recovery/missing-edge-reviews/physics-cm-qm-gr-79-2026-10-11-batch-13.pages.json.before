      {
        "id": "lem-symbol-locality-gives-coding-continuity",
        "kind": "lemma",
        "title": "Finite symbol windows determine the coded sequence: locality of the iterates, coding continuity and injectivity of h",
        "dependency_level": 5,
        "deps": [
          "def-bilateral-symbol-and-bounded-sequence-space",
          "lem-coded-quadratic-recurrence-is-a-contraction",
          "lem-bounded-bilateral-sequence-ball-is-complete",
