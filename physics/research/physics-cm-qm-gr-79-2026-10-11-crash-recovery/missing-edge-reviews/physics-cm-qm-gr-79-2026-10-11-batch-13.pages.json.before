      {
        "id": "def-bilateral-symbol-and-bounded-sequence-space",
        "kind": "definition",
        "title": "The two-sign bilateral shift space, its coding map, and the ball of bounded bilateral real sequences",
        "dependency_level": 2,
        "deps": [
          "def-cm-bilateral-shift-space-and-cylinders",
          "lem-cm-bilateral-shift-metric-and-sequential-compactness",
          "def-function-space",
          "def-metric-space",
