          "lem-geometric-sequence-null",
          "def-series",
          "lem-of-abs-value",
          "def-abs-value",
          "def-lipschitz-holder-contraction",
          "def-metric-space",
          "def-metric-ball",
          "lem-cm-bilateral-shift-metric-and-sequential-compactness"
        ],
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "reference": "mechanical-horseshoe.md#1 (finite-locality of the iterates, error 2R L^{-m}, continuity and injectivity of the coding map)",
        "design_state": "completed-local-argument",
        "inventory_expansion_required": false,
        "statement": "The m-th iterate of T_sigma started at 0 has n-th coordinate depending only on the symbols sigma_j with |j-n|<=m-1, and differs from x(sigma) by at most 2R L^{-m} in the supremum norm; consequently the coding map h(sigma)=(x_{-1}(sigma),x_0(sigma)) is continuous, and it is injective because the signs of the forward and backward iterates recover every symbol.",
        "strategy": "Induction on m for the window dependence, the Banach a priori error estimate for the uniform tail bound, and the inverse-map sign argument for injectivity.",
        "sources": {
          "references": [
            {
              "title": "G. Teschl, Ordinary Differential Equations and Dynamical Systems, AMS Graduate Studies in Mathematics 140 (author's preliminary online edition, complete PDF)",
              "url": "https://www.mat.univie.ac.at/~gerald/ftp/book-ode/ode.pdf"
