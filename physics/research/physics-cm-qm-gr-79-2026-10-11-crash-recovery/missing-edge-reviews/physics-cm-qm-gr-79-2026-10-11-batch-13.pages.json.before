      {
        "id": "lem-coded-quadratic-recurrence-is-a-contraction",
        "kind": "lemma",
        "title": "The square-root recurrence T_sigma(x)_n = sigma_n sqrt(a+x_{n-1}+x_{n+1}) is a contraction of the ball B_R with a unique coded solution",
        "dependency_level": 4,
        "deps": [
          "def-bilateral-symbol-and-bounded-sequence-space",
          "lem-bounded-bilateral-sequence-ball-is-complete",
          "thm-banach-fixed-point",
          "def-lipschitz-holder-contraction",
          "thm-of-square-roots",
          "lem-of-abs-value",
          "def-abs-value",
          "def-interval",
          "def-complete-ordered-field",
          "def-metric-space",
          "def-metric-convergence"
        ],
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "reference": "mechanical-horseshoe.md#1 (radicand bounds, the derivative bound 1/(2L), and the unique coded sequence)",
        "design_state": "completed-local-argument",
        "inventory_expansion_required": false,
        "statement": "For a>=100, R=sqrt(a)+3 and L=sqrt(a-2R) one has L>1 and a-2R>0; for every sigma in X the map T_sigma on B_R is well defined, maps B_R into itself, and is a contraction with constant 1/L<1; its unique fixed point x(sigma) satisfies |x_n|>=L, sign x_n = sigma_n and x_{n+1}+x_{n-1}=x_n^2-a for every n.",
        "strategy": "Positivity of the radicand interval, the Lipschitz bound of the square root on [L^2,a+2R], Banach's fixed point theorem on the complete ball, and the sign/recurrence identities at the fixed point.",
        "sources": {
          "references": [
            {
              "title": "G. Teschl, Ordinary Differential Equations and Dynamical Systems, AMS Graduate Studies in Mathematics 140 (author's preliminary online edition, complete PDF)",
              "url": "https://www.mat.univie.ac.at/~gerald/ftp/book-ode/ode.pdf"
            },
            {
              "title": "P. Cvitanovic, R. Artuso, R. Mainieri, G. Tanner, G. Vattay, Chaos: Classical and Quantum (ChaosBook.org, edition 17.6.8, complete PDF)",
              "url": "https://chaosbook.org/chapters/ChaosBook.pdf"
            },
            {
              "title": "R. Devaney and Z. Nitecki, Shift automorphisms in the Henon mapping, Communications in Mathematical Physics 67 (1979) 137-146",
              "url": "https://projecteuclid.org/journals/communications-in-mathematical-physics/volume-67/issue-2/Shift-automorphisms-in-the-H%C3%A9non-mapping/cmp/1103905161.pdf"
            }
          ]
        },
