      {
        "id": "thm-henon-coded-invariant-set-is-conjugate-to-shift",
        "kind": "theorem",
        "title": "The quadratic map F(x,y)=(y,y^2-a-x) has a compact coded invariant set on which it is topologically conjugate to the two-sign shift and chaotic",
        "dependency_level": 6,
        "deps": [
          "def-bilateral-symbol-and-bounded-sequence-space",
          "lem-bounded-bilateral-sequence-ball-is-complete",
          "lem-coded-quadratic-recurrence-is-a-contraction",
          "lem-symbol-locality-gives-coding-continuity",
          "def-cm-topologically-mixing-dense-periodic-and-sensitive-maps",
          "thm-cm-bilateral-shift-mixing-dense-periodic-and-sensitive",
          "def-cm-bilateral-shift-space-and-cylinders",
          "lem-cm-bilateral-shift-metric-and-sequential-compactness",
          "def-metric-continuity",
          "def-metric-convergence",
          "def-metric-compactness-variants",
          "def-metric-compactness",
          "thm-metric-sequential-closure",
          "thm-continuous-image-of-a-compact-space-is-compact",
