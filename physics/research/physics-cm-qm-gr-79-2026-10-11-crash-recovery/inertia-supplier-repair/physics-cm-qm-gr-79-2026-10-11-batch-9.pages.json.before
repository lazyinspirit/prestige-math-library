      {
        "id": "def-cm-mass-distribution-and-inertia-matrix",
        "kind": "definition",
        "domain": "mathematics",
        "title": "Mass distributions on $\\mathbb R^3$: total mass, first moment and inertia matrix",
        "statement": "Under the Axiom of Countable Choice AC_omega, used only to make the moment integrals finite: a mass distribution on R^3 is a finite Borel measure nu with support in a closed ball and 0<nu(R^3)<infty. Its total mass is m=nu(R^3); its first moment is mu(nu)=int rho dnu (componentwise); and its inertia matrix has entries I_jk = int (||rho||^2 delta_jk - rho_j rho_k) dnu, vector- and matrix-valued integrals being componentwise. Centred means mu(nu)=0.",
        "deps": [
          "def-borel-sigma-algebra",
          "def-measure",
          "def-measure-space",
          "def-metric-ball",
          "def-integral-over-a-measurable-set",
          "def-integrable-real-and-complex-functions-and-their-integrals",
          "def-euclidean-inner-product",
          "def-matrix-space",
          "def-matrix-product-and-identity-matrix",
          "def-countable-choice"
        ],
        "dependency_roles": {
