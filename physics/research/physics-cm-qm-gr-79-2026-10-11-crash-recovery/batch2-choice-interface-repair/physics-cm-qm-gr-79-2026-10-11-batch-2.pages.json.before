          "def-vector-valued-functions-limits-and-continuity": "mathematical-premise",
          "def-metric-continuity": "mathematical-premise",
          "def-metric-topology": "mathematical-premise",
          "def-metric-ball": "mathematical-premise",
          "def-complete-metric-space": "mathematical-premise",
          "def-interval": "mathematical-premise",
          "thm-picard-lindelof-local-existence-and-uniqueness": "mathematical-premise",
          "prop-first-order-ivp-is-equivalent-to-a-volterra-integral-equation": "mathematical-premise",
          "thm-additivity-over-subintervals": "mathematical-premise",
          "thm-norm-inequality-for-the-vector-valued-integral": "mathematical-premise",
          "thm-monotonicity-of-the-integral": "mathematical-premise",
          "thm-euclidean-space-complete": "mathematical-premise",
          "thm-extreme-value-metric": "mathematical-premise",
          "thm-compact-subset-is-closed-and-bounded": "mathematical-premise",
          "thm-componentwise-limits-and-continuity": "mathematical-premise",
          "cor-archimedean-reciprocal": "mathematical-premise",
          "thm-cauchy-schwarz-and-the-euclidean-norm": "mathematical-premise",
          "lem-reverse-triangle-inequality-in-a-normed-space": "mathematical-premise",
          "cor-differentiable-implies-continuous": "mathematical-premise"
        },
        "inventory_expansion_required": false,
        "statement": "Let D be open in R x R^n, F:D->R^n continuous and locally Lipschitz in the state variable, x:[t0,b)->R^n a solution of x'=F(t,x), x(t0)=x0. If there is compact K in D and delta>0 with (t,x(t)) in K for t in (b-delta,b), then (1) some epsilon>0 and a solution xtilde:[t0,b+epsilon)->R^n extend x; (2) if D=R x U, F(t,z)=G(z) autonomous with G continuous and locally Lipschitz, and x(t) in a compact K0 in U for t near b, then the extension conclusion holds as well.",
        "strategy": "Bound F on K, get a Lipschitz estimate from the Volterra equation, produce the one-sided limit x_b by completeness, place (b,x_b) in the closed K, apply Picard-Lindelof at (b,x_b), and glue by uniqueness; clause 2 repeats the argument with K0.",
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "Gerald Teschl, Ordinary Differential Equations and Dynamical Systems, §2.6, printed pp. 50-53: Corollaries 2.15-2.16",
              "url": "https://schecter.math.ncsu.edu/ma_732_sp13/teschl_ode.pdf"
            },
            {
              "title": "Julien Arino, MATH 8430 (University of Manitoba), §1.3, printed pp. 24-28: Lemma 1.3.1, Theorem 1.3.3, Theorem 1.3.7",
              "url": "https://julien-arino.github.io/assets/pdf/courses/math8430_lecture_notes.pdf"
            }
          ]
        }
      },
      {
        "id": "cor-cm-finite-time-breakdown-requires-escape",
        "kind": "corollary",
        "domain": "mathematics",
        "title": "A non-extendable solution leaves every compact subset of the domain near its finite endpoint; an autonomous solution trapped in a compact state set cannot break down there",
        "reference": "mathematical-prerequisites.md#m10",
        "design_state": "completed-local-argument; recorded in the batch notes",
        "dependency_level": 1,
        "deps": [
          "thm-cm-compact-continuation-for-locally-lipschitz-odes",
          "def-first-order-ode-initial-value-problem-and-solution",
          "def-locally-lipschitz-in-the-state-variable"
        ],
        "dependency_roles": {
          "thm-cm-compact-continuation-for-locally-lipschitz-odes": "mathematical-premise",
          "def-first-order-ode-initial-value-problem-and-solution": "mathematical-premise",
          "def-locally-lipschitz-in-the-state-variable": "mathematical-premise"
        },
        "inventory_expansion_required": false,
        "statement": "With F continuous and locally Lipschitz and x a solution on [t0,b) admitting no extension past b: (1) for every compact K in D and every eta>0 there is t in (b-eta,b) with (t,x(t)) not in K; (2) if D=R x U and F is autonomous and x(t) lies in a compact K0 in U for t near b, then x does extend past b, so the no-extension hypothesis fails.",
        "strategy": "Both clauses are the contrapositive/contradiction form of the compact continuation theorem.",
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "Gerald Teschl, Ordinary Differential Equations and Dynamical Systems, §2.6, Corollary 2.16, printed p. 53",
              "url": "https://schecter.math.ncsu.edu/ma_732_sp13/teschl_ode.pdf"
            },
            {
              "title": "Julien Arino, MATH 8430 (University of Manitoba), §1.3, Theorem 1.3.3, printed pp. 25-26",
              "url": "https://julien-arino.github.io/assets/pdf/courses/math8430_lecture_notes.pdf"
            }
          ]
        }
      },
      {
