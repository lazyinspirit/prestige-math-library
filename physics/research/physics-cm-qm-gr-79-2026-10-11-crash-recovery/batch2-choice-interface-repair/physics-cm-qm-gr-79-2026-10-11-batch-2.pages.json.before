          "thm-norm-inequality-for-the-vector-valued-integral",
          "thm-monotonicity-of-the-integral",
          "thm-euclidean-space-complete",
          "thm-extreme-value-metric",
          "thm-compact-subset-is-closed-and-bounded",
          "thm-componentwise-limits-and-continuity",
          "cor-differentiable-implies-continuous",
          "cor-archimedean-reciprocal",
          "thm-cauchy-schwarz-and-the-euclidean-norm",
          "lem-reverse-triangle-inequality-in-a-normed-space"
        ],
        "dependency_roles": {
          "def-first-order-ode-initial-value-problem-and-solution": "mathematical-premise",
          "def-locally-lipschitz-in-the-state-variable": "mathematical-premise",
