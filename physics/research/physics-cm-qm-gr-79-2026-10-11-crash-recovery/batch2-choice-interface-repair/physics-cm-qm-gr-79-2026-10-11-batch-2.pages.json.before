    "items": [
      {
        "id": "lem-cm-derivative-of-pairings-of-curves",
        "kind": "lemma",
        "domain": "mathematics",
        "title": "Differentiation of sums, scalar multiples, inner products, cross products and squared norms of differentiable curves in R^3",
        "reference": "mathematical-prerequisites.md#m2 (differentiation inputs of the balance identities)",
        "design_state": "completed-local-argument (M2 split into items); recorded in the batch notes",
        "dependency_level": 0,
        "deps": [
          "def-vector-valued-derivative-and-integral",
          "def-euclidean-inner-product",
          "def-cross-product-in-r3",
          "def-derivative",
          "def-limit-point-r",
          "def-interval",
          "thm-algebra-of-derivatives",
          "lem-cross-product-is-bilinear-alternating-and-orthogonal",
          "lem-finite-sum-laws"
        ],
        "dependency_roles": {
          "def-vector-valued-derivative-and-integral": "mathematical-premise",
          "def-euclidean-inner-product": "mathematical-premise",
          "def-cross-product-in-r3": "mathematical-premise",
          "def-derivative": "mathematical-premise",
          "def-limit-point-r": "mathematical-premise",
          "def-interval": "mathematical-premise",
          "thm-algebra-of-derivatives": "mathematical-premise",
          "lem-cross-product-is-bilinear-alternating-and-orthogonal": "mathematical-premise",
          "lem-finite-sum-laws": "mathematical-premise"
        },
        "inventory_expansion_required": false,
        "statement": "Let I be an interval with at least two points and t0 in I; let x,y:I->R^3 be differentiable at t0 and lambda:I->R differentiable at t0. Then x+y, lambda*x, the inner product t-><x(t),y(t)>, the cross product t->x(t) x y(t), and the squared norm t->||x(t)||_2^2 are differentiable at t0 with the sum/scalar rules, <x,y>' = <x',y>+<x,y'>, (x x y)' = x' x y + x x y', and (||x||^2)' = 2<x',x>.",
        "strategy": "Clause 1 componentwise from the componentwise differentiability and the real algebra of derivatives; clause 2 expands the finite sum of products; clause 3 repeats componentwise for the cross product; clause 4 applies clause 2 with y=x and symmetry.",
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "Konstantin Likharev, Essential Graduate Physics: Classical Mechanics, §1.3, Eq. (1.32), printed pp. 10-11",
              "url": "https://essentialgraduatephysics.org/Files/CM%20merged.pdf"
            },
            {
              "title": "David Tong, Classical Dynamics (University of Cambridge), §§1.2-1.3, printed pp. 2-8",
              "url": "https://www.davidtong.org/pdfs/teaching/classical-dynamics/clas.pdf"
            }
          ]
        }
      },
      {
        "id": "thm-cm-center-of-mass-and-kinetic-splitting",
        "kind": "theorem",
        "domain": "mathematics",
        "title": "Centre of mass, the identity sum_i m_i rho_i = 0, and the splitting of the kinetic sum into centre-of-mass and relative parts (two-body reduced-mass case)",
        "reference": "mathematical-prerequisites.md#m2",
        "design_state": "completed-local-argument; recorded in the batch notes",
        "dependency_level": 0,
        "deps": [
          "def-vector-valued-derivative-and-integral",
          "def-euclidean-inner-product",
          "def-interval",
          "lem-finite-sum-laws"
        ],
        "dependency_roles": {
          "def-vector-valued-derivative-and-integral": "mathematical-premise",
          "def-euclidean-inner-product": "mathematical-premise",
          "def-interval": "mathematical-premise",
          "lem-finite-sum-laws": "mathematical-premise"
        },
        "inventory_expansion_required": false,
        "statement": "Let N>=1, I an interval with at least two points, m_i>0 and x_i:I->R^3 differentiable. With M=sum m_i, X=M^{-1}sum m_i x_i and rho_i=x_i-X: (1) X and the rho_i are differentiable with X'=M^{-1}sum m_i x_i', rho_i'=x_i'-X', and sum m_i rho_i = sum m_i rho_i' = 0; (2) sum m_i||x_i'||^2 = M||X'||^2 + sum m_i||rho_i'||^2 on I; (3) if N=2, with r=x_1-x_2 and mu=m_1m_2/M, sum m_i||rho_i'||^2 = mu||r'||^2, hence sum m_i||x_i'||^2 = M||X'||^2 + mu||r'||^2.",
        "strategy": "Differentiate the defining finite sums; differentiate the zero identity; expand the squared norm by bilinearity with the cross term killed by sum m_i rho_i'=0; specialise rho_1=(m_2/M)r, rho_2=-(m_1/M)r.",
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "David Tong, Classical Dynamics (University of Cambridge), §1.3, Eqs. (1.15)-(1.16), (1.22)-(1.23), printed pp. 6-8",
              "url": "https://www.davidtong.org/pdfs/teaching/classical-dynamics/clas.pdf"
            },
            {
              "title": "Konstantin Likharev, Essential Graduate Physics: Classical Mechanics, §3.4, Eqs. (3.30)-(3.35), printed pp. 40-42",
              "url": "https://essentialgraduatephysics.org/Files/CM%20merged.pdf"
            }
          ]
        }
      },
      {
        "id": "thm-cm-momentum-and-angular-momentum-balance",
        "kind": "theorem",
        "domain": "mathematics",
        "title": "Total momentum and total angular momentum balances for a finite system with antisymmetric pair forces; pairwise central forces make the internal torque vanish",
        "reference": "mathematical-prerequisites.md#m2",
        "design_state": "completed-local-argument; recorded in the batch notes",
        "dependency_level": 1,
        "deps": [
          "lem-cm-derivative-of-pairings-of-curves",
          "def-cross-product-in-r3",
          "lem-cross-product-is-bilinear-alternating-and-orthogonal",
          "def-vector-valued-derivative-and-integral",
          "def-interval",
          "lem-finite-sum-laws",
          "lem-finite-sum-reindexing-and-fubini"
        ],
        "dependency_roles": {
          "lem-cm-derivative-of-pairings-of-curves": "mathematical-premise",
          "def-cross-product-in-r3": "mathematical-premise",
          "lem-cross-product-is-bilinear-alternating-and-orthogonal": "mathematical-premise",
          "def-vector-valued-derivative-and-integral": "mathematical-premise",
          "def-interval": "mathematical-premise",
          "lem-finite-sum-laws": "mathematical-premise",
          "lem-finite-sum-reindexing-and-fubini": "mathematical-premise"
        },
        "inventory_expansion_required": false,
        "statement": "Let N>=1, I an interval with at least two points, m_i>0, x_i:I->R^3 twice differentiable, p_i=m_i x_i'. Suppose f_ij=-f_ji and p_i'=f_i+sum_{j!=i} f_ij on I. Then P=sum p_i is differentiable with P'=sum f_i; J=sum x_i x p_i is differentiable with J'=sum x_i x f_i + sum_{i<j}(x_i-x_j) x f_ij; and if each f_ij is parallel to x_i-x_j then J'=sum x_i x f_i.",
        "strategy": "Sum the balance equations; differentiate each cross product, kill x_i' x p_i by alternation, and reindex the internal double sum using antisymmetry; parallel pairs have vanishing (x_i-x_j) x f_ij.",
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "David Tong, Classical Dynamics (University of Cambridge), §1.3, Eqs. (1.11)-(1.19), printed pp. 5-7",
              "url": "https://www.davidtong.org/pdfs/teaching/classical-dynamics/clas.pdf"
            },
            {
              "title": "Richard Fitzpatrick, Classical Mechanics (University of Texas at Austin), Non-Isolated Systems, Eqs. (41)-(44)",
              "url": "https://farside.ph.utexas.edu/teaching/336k/Newtonhtml/node12.html"
            }
          ]
        }
      },
      {
        "id": "thm-cm-work-energy-balance",
        "kind": "theorem",
        "domain": "mathematics",
        "title": "Work-energy balance d(K+U(t,x))/dt = d_t U(t,x(t)) + sum_i <d_i, x_i'> for forces m_i x_i'' = -grad_{x_i} U + d_i",
        "reference": "mathematical-prerequisites.md#m2",
        "design_state": "completed-local-argument; recorded in the batch notes",
        "dependency_level": 1,
        "deps": [
          "lem-cm-derivative-of-pairings-of-curves",
          "def-ck-euclidean-maps-and-diffeomorphisms",
          "def-euclidean-inner-product",
          "def-jacobian-matrix-and-gradient",
          "def-total-derivative-in-euclidean-space",
          "def-vector-valued-derivative-and-integral",
          "def-interval",
          "thm-chain-rule-for-total-derivatives",
          "thm-continuous-partial-derivatives-imply-total-differentiability",
          "thm-total-derivative-computes-directional-and-partial-derivatives",
          "cor-zero-derivative-implies-constant",
          "lem-finite-sum-laws",
          "thm-algebra-of-derivatives"
        ],
        "dependency_roles": {
          "lem-cm-derivative-of-pairings-of-curves": "mathematical-premise",
          "def-ck-euclidean-maps-and-diffeomorphisms": "mathematical-premise",
          "def-euclidean-inner-product": "mathematical-premise",
          "def-jacobian-matrix-and-gradient": "mathematical-premise",
          "def-total-derivative-in-euclidean-space": "mathematical-premise",
          "def-vector-valued-derivative-and-integral": "mathematical-premise",
          "def-interval": "mathematical-premise",
          "thm-chain-rule-for-total-derivatives": "mathematical-premise",
          "thm-continuous-partial-derivatives-imply-total-differentiability": "mathematical-premise",
          "thm-total-derivative-computes-directional-and-partial-derivatives": "mathematical-premise",
          "cor-zero-derivative-implies-constant": "mathematical-premise",
          "lem-finite-sum-laws": "mathematical-premise",
          "thm-algebra-of-derivatives": "mathematical-premise"
        },
        "inventory_expansion_required": false,
        "statement": "Let U:I x Q -> R be C1 on the open set I x Q (Q open in R^{3N}), x:I->Q twice differentiable, m_i>0, K=1/2 sum m_i||x_i'||^2, and suppose m_i x_i'' = -grad_{x_i}U(t,x(t)) + d_i(t). Then K'=sum <m_i x_i'', x_i'>; d/dt U(t,x(t)) = d_t U(t,x(t)) + sum <grad_{x_i}U(t,x(t)), x_i'(t)>; hence (K+U(t,x(t)))' = d_t U(t,x(t)) + sum <d_i, x_i'>; if the d_i vanish the derivative is d_t U(t,x(t)), and if in addition d_t U = 0 the sum K+U(t,x(t)) is constant on I.",
        "strategy": "Differentiate the squared norms; apply the chain rule to the composite U(t,x(t)) and read the total derivative on (1,x'(t)) through the Jacobian; add and substitute the force identity; conclude constancy by the zero-derivative criterion.",
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "David Tong, Classical Dynamics (University of Cambridge), §1.3.2, Eqs. (1.22)-(1.25), printed pp. 8-9",
              "url": "https://www.davidtong.org/pdfs/teaching/classical-dynamics/clas.pdf"
            },
            {
              "title": "Konstantin Likharev, Essential Graduate Physics: Classical Mechanics, §1.3, Eqs. (1.19)-(1.27), printed pp. 8-10",
              "url": "https://essentialgraduatephysics.org/Files/CM%20merged.pdf"
            }
          ]
        }
      },
      {
        "id": "thm-cm-variable-mass-momentum-balance",
        "kind": "theorem",
        "domain": "mathematics",
        "title": "Variable-mass momentum balance from m'=r_in-r_out and (mv)'=F+r_in w_in-r_out w_out",
        "reference": "expansion-proofs.md#e11 (variable-mass packet accounting)",
        "design_state": "completed-local-argument; recorded in the batch notes",
        "dependency_level": 0,
        "deps": [
          "def-vector-valued-derivative-and-integral",
          "def-derivative",
          "def-interval",
          "thm-algebra-of-derivatives"
        ],
        "dependency_roles": {
          "def-vector-valued-derivative-and-integral": "mathematical-premise",
          "def-derivative": "mathematical-premise",
          "def-interval": "mathematical-premise",
          "thm-algebra-of-derivatives": "mathematical-premise"
        },
        "inventory_expansion_required": false,
        "statement": "Let I be an interval with nonempty interior, m:I->(0,inf) and v:I->R^3 differentiable, F:I->R^3, r_in,r_out:I->[0,inf), w_in,w_out:I->R^3. If m'=r_in-r_out and (mv)'=F+r_in w_in-r_out w_out on I, then m v' = F + r_in(w_in-v) - r_out(w_out-v) on I. In particular if F=0, r_in=0, r_out=r constant, then m v' = -r(w_out-v).",
        "strategy": "Product rule coordinatewise for (mv)', substitute the mass-rate identity, and group the flux terms.",
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "David Tong, Classical Dynamics (University of Cambridge), §1.2, printed p. 2",
              "url": "https://www.davidtong.org/pdfs/teaching/classical-dynamics/clas.pdf"
            },
            {
              "title": "Richard Fitzpatrick, Classical Mechanics (University of Texas at Austin), Non-Isolated Systems",
              "url": "https://farside.ph.utexas.edu/teaching/336k/Newtonhtml/node12.html"
            }
          ]
        }
      },
      {
        "id": "thm-cm-compact-continuation-for-locally-lipschitz-odes",
        "kind": "theorem",
        "domain": "mathematics",
        "title": "Compact continuation for locally Lipschitz ODEs, with the autonomous trapped-state clause",
        "reference": "mathematical-prerequisites.md#m10",
        "design_state": "completed-local-argument; recorded in the batch notes",
        "dependency_level": 0,
        "deps": [
          "def-first-order-ode-initial-value-problem-and-solution",
          "def-locally-lipschitz-in-the-state-variable",
          "def-vector-valued-derivative-and-integral",
          "def-vector-valued-functions-limits-and-continuity",
          "def-metric-continuity",
          "def-metric-topology",
          "def-metric-ball",
