+
+// Legacy v2 in-flight findings were fingerprinted by the native collector,
+// without observed_source. Authenticate their original triples from archives;
+// never add a fictional observed_source to a frozen independent observation.
+function reviewedLegacyV2Classification({run, group, prior, decision, primary, alias,
+  primaryBatch, entry, receipt, bytes, sha, hashValue}) {
+  const bound = g => {
+    if (!g?.path?.startsWith(`research/${run}-`) || !/^[a-f0-9]{64}$/.test(g.sha256 ?? '')
+      || receipt.inputs?.[g.path] !== g.sha256 || sha(bytes(g.path)) !== g.sha256)
+      throw Error('stale legacy alias evidence');
+    return bytes(g.path);
+  };
+  if (prior.route !== 'reader' || decision.route !== 'flagged'
+    || primary.defect !== alias.defect || primary.severity !== alias.severity
+    || primary.observed_source !== undefined || alias.observed_source !== undefined
+    || primary.observation_basis !== undefined || alias.observation_basis !== undefined
+    || !/^[a-f0-9]{64}$/.test(primary.observed_sha256 ?? '')
+    || !/^[a-f0-9]{64}$/.test(alias.observed_sha256 ?? '')
+    || primary.observed_sha256 === alias.observed_sha256
+    || primary.location !== entry.primary_location || alias.location !== entry.alias_location
+    || entry.primary_observed_sha256 !== primary.observed_sha256
+    || entry.alias_observed_sha256 !== alias.observed_sha256) return false;
+  const scopeGuard = entry.frozen_scope_guard;
+  if (scopeGuard?.path !== `research/${run}-step3-scope-${primaryBatch}.json`) return false;
+  const scope = JSON.parse(bound(scopeGuard));
+  if (scope.version !== 2 || scope.run !== run || String(scope.batch) !== primaryBatch
+    || group !== `batch-${primaryBatch}` || !(scope.manifest_post ?? []).includes(entry.subject)
+    || hashValue(scope.reader_findings?.find(x => x.obligation === prior.obligation)) !== hashValue(primary)
+    || hashValue(scope.refuter_findings?.find(x => x.obligation === decision.obligation)) !== hashValue(alias)) return false;
+  const frozen = entry.frozen_file_guards;
+  if (!Array.isArray(frozen) || frozen.length !== 2) return false;
+  for (const [name, key] of [['reader-findings', 'reader_report_sha256'], ['refute', 'refuter_report_sha256']]) {
+    const g = frozen.find(x => x.path === `research/${run}-${name}-${primaryBatch}.json`);
+    if (!g || g.sha256 !== scope[key]) return false;
+    bound(g);
+  }
+  const raw = entry.observed_raw_archive;
+  const oldText = bound(raw).toString();
+  if (!/^[a-f0-9]{64}$/.test(raw.sha256 ?? '')
+    || !oldText.includes(`id: ${entry.subject}`)) return false;
+  // Reader fingerprint must be exactly the unchanged authentic pre/post item
+  // carrier, not a tuple supplied by the alias author.
+  let original;
+  for (const label of ['pre','post']) {
+    const g = entry.observed_snapshot_guards?.find(x => x.path === `research/${run}-step3-hash-${primaryBatch}-${label}.json`);
+    if (!g || entry.observed_snapshot_guards.length !== 2) return false;
+    const snapshot = JSON.parse(bound(g)), c = snapshot.hashes?.[entry.subject];
+    if (snapshot.version !== 2 || snapshot.run !== run || String(snapshot.batch) !== primaryBatch
+      || snapshot.label !== label || !(snapshot.manifest ?? []).includes(entry.subject)
+      || c?.item_sha256 !== raw.sha256 || hashValue(c) !== primary.observed_sha256) return false;
+    original ??= c;
+    if (hashValue(c) !== hashValue(original)) return false;
+  }
+  const manifests = JSON.parse(bound(entry.observed_manifest_archive));
+  if (!Array.isArray(manifests)) return false;
+  const rows = manifests.flatMap(p => (p.items ?? []).filter(x => x?.id === entry.subject)
+    .map(x => ({...x, __step4_page_id: String(p.id)})));
+  if (rows.length !== 1 || hashValue(rows[0]) !== original.manifest_sha256) return false;
+  const contract = JSON.parse(bound(entry.alias_contract_archive)).contracts?.[entry.subject];
+  if (!contract) return false;
+  const reconstructed = {...original, contract_sha256: hashValue(contract)};
+  if (hashValue(reconstructed) !== alias.observed_sha256) return false;
+  // Genuine bounded native continuation independently bound this exact raw
+  // source before the second review; it is not reconstructed from current text.
+  const authorization = JSON.parse(bound(entry.native_continuation_authorization));
+  const continuation = authorization.continuations?.filter(x => String(x.unit) === primaryBatch);
+  if (authorization.version !== 1 || authorization.run !== run || authorization.authorized_by !== 'owner'
+    || continuation?.length !== 1 || !continuation[0].subjects?.some(x => x.id === entry.subject
+      && x.path === `items/${entry.subject}.md` && x.sha256 === raw.sha256)) return false;
+  const owner = JSON.parse(bound(entry.scientific_owner_receipt));
+  const source = entry.current_source;
+  if (owner.run !== run || owner.group !== group || owner.classification_approved !== true
+    || owner.one_underlying_issue !== true || owner.canonical_defect_id !== entry.original_defect_id
+    || !owner.obligations?.includes(prior.obligation) || !owner.obligations?.includes(decision.obligation)
+    || owner.original_labels_preserved?.[prior.obligation] !== primary.defect
+    || owner.original_labels_preserved?.[decision.obligation] !== alias.defect
+    || owner.original_severities_preserved?.[prior.obligation] !== primary.severity
+    || owner.original_severities_preserved?.[decision.obligation] !== alias.severity
+    || owner.primary_observed_sha256 !== primary.observed_sha256
+    || owner.alias_observed_sha256 !== alias.observed_sha256
+    || owner.observed_raw_sha256 !== raw.sha256
+    || typeof owner.rationale !== 'string' || owner.rationale.length < 80
+    || source?.path !== `items/${entry.subject}.md` || receipt.inputs?.[source.path] !== source.sha256
+    || sha(bytes(source.path)) !== source.sha256
+    || owner.current_source_guard?.path !== source.path || owner.current_source_guard?.sha256 !== source.sha256) return false;
+  const text = bytes(source.path).toString();
+  return Array.isArray(entry.reviewed_source_excerpts) && entry.reviewed_source_excerpts.length >= 2
+    && entry.reviewed_source_excerpts.every(x => typeof x === 'string' && x.length >= 80 && text.includes(x));
+}
