      {
        "id": "pthm-td-controlled-thermodynamic-ensemble-duality",
        "kind": "physics-theorem",
        "domain": "physics",
        "title": "Controlled canonical–grand thermodynamic duality",
        "statement": "Conditionally transfers the closed-concave canonical/grand Legendre-Fenchel duality to the positional physical units.",
        "deps": [
