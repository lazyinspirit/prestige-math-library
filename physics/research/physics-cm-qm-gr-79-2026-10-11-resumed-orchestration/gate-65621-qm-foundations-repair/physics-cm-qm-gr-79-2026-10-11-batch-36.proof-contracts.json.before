          ]
        },
        {
          "id": "step-1-2",
          "step": "1.2",
          "claim": "[(b) mean] By [F3] and [F1], $\\sum_nnp_n=\\sum_nn|c_n|^2=\\langle N\\psi_z,\\psi_z\\rangle=|z|^2$.",
          "inputs": [
