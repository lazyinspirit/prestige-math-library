          ]
        },
        {
          "fact": "F3",
          "source": "lem-complex-exponential-series-converges-everywhere",
          "source_section": "Statement",
          "quote": "For every $z\\in\\mathbb C$, the series $\\sum z^n/n!$ converges absolutely.",
          "uses": [
            "1.1",
