            "thm-leray-acyclic-cover-theorem",
            "thm-cech-to-sheaf-cohomology-comparison",
            "cor-dolbeault-vanishing-pseudoconvex-domain"
          ],
          "dependency_roles": {
            "def-axiom-of-choice": "mathematical-premise",
            "thm-dolbeault-lemma-polydisc": "mathematical-premise",
            "thm-dolbeault-cohomology-polydisc-vanishes-positive-q": "mathematical-premise",
            "thm-smooth-function-module-sheaves-are-acyclic": "mathematical-premise",
            "thm-acyclic-resolution-theorem-for-right-derived-functors": "mathematical-premise",
            "thm-cauchy-integral-formula-on-a-polydisc": "mathematical-premise",
            "thm-laurent-expansion-annulus": "mathematical-premise",
            "lem-holomorphic-dependence-of-slice-laurent-coefficients": "mathematical-premise",
            "thm-locally-uniform-limit-of-holomorphic-functions-in-several-variables": "mathematical-premise",
            "thm-leray-acyclic-cover-theorem": "mathematical-premise",
            "thm-cech-to-sheaf-cohomology-comparison": "mathematical-premise",
            "cor-dolbeault-vanishing-pseudoconvex-domain": "mathematical-premise"
          },
          "statement": "Assume AC. For 0\u2264r\u22643, any holomorphic vector bundle E on P^r(C) has its analytic sheaf cohomology naturally identified with the cohomology of the global smooth E-valued Dolbeault complex. In particular H^0(P^r,O)=C and H^q(P^r,O)=0 for q>0. The scalar vanishing is proved by a direct Laurent/\u010cech calculation on the standard affine cover, including its acyclic intersections and convergent cochain contractions. This statement does not assume GAGA, higher-dimensional K\u00e4hler Hodge theory, or arbitrary-coherent projective vanishing.",
          "strategy": "Generalize the written curve Dolbeault resolution pattern directly in all dimensions \u22643 using local polydisc exactness and smooth-module acyclicity. In the standard projective cover identify finite intersections with products of C and C*, prove scalar acyclicity using explicit pseudoconvex exhaustions and scalar Dolbeault solvability (or direct Laurent solution). Expand holomorphic functions on polyannuli, prove parameter holomorphy, normal convergence and uniqueness by iterated Cauchy integrals. Decompose homogeneous degree-zero Laurent modes and give a sign-correct \u010cech contracting homotopy for positive degree, verifying subseries extend to the claimed charts and converge locally uniformly. Global degree-zero functions are constants. This source-guided Laurent reconstruction is not supplied by the algebraic O(m) theorem and not proved by Serre\u2019s footnote. For the standard projective cover, intersections are C^a times (C*)^b, not polydiscs. Prove their required scalar acyclicity by an explicit annular-product Dolbeault/exhaustion or Laurent argument before using Leray; local coherent acyclicity alone does not imply it.",
          "proof_strategy": "direct",
          "axiom_base": "ZF + full AC; record resolutions, countable shrinking/diagonal choices, Baire/Fr\u00e9chet arguments and supplier-inherited choice uses precisely. No physical premise.",
          "provenance": {
            "statement": "literature-derived",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "Serre",
                "url": "https://www.college-de-france.fr/media/jean-pierre-serre/UPL1698785858825941763_Serre_GAGA.pdf",
                "locator": "\u00a713 Lemma4 and footnote4, printed pp.20\u201321: Laurent route is mentioned as unpublished Frenkel calculation, not supplied there. Demailly VII10.6\u201310.7 pp.348\u2013349 were read but use Hodge/duality/Nakano; not the proposed proof route."
              }
            ]
          },
          "proof_contract_plan": {
            "state": "unproved proposal; no local proof/native approval",
            "obligations": [
              "Generalize the written curve Dolbeault resolution pattern directly in all dimensions \u22643 using local polydisc exactness and smooth-module acyclicity",
              "In the standard projective cover identify finite intersections with products of C and C*, prove scalar acyclicity using explicit pseudoconvex exhaustions and scalar Dolbeault solvability (or direct Laurent solution)",
              "Expand holomorphic functions on polyannuli, prove parameter holomorphy, normal convergence and uniqueness by iterated Cauchy integrals",
              "Decompose homogeneous degree-zero Laurent modes and give a sign-correct \u010cech contracting homotopy for positive degree, verifying subseries extend to the claimed charts and converge locally uniformly",
              "Global degree-zero functions are constants",
              "This source-guided Laurent reconstruction is not supplied by the algebraic O(m) theorem and not proved by Serre\u2019s footnote.",
              "Prove scalar acyclicity on standard-cover intersections C^a\u00d7(C*)^b, or a full sheaf-level Laurent resolution, before using Cech as sheaf cohomology; do not assume general coherent Stein Cartan B."
            ],
            "source_reading_is_not_proof": true,
            "native_authoring_and_independent_review_required": true
          },
          "reference": "items/thm-qftx-gaga-analytic-projective-dolbeault-scalar-cohomology.md#Statement",
          "dependency_level": 1
        }
