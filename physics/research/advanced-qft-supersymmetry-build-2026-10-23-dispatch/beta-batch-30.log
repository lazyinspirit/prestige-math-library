      "id": "thm-qftx-n-extended-central-charge-bounds",
      "kind": "theorem",
      "domain": "mathematics",
      "library": "mathematics",
      "title": "Positive central-charge bounds on a massive rest representation fiber",
      "reference": "items/thm-qftx-n-extended-central-charge-bounds.md",
      "design_state": "Draft authored for aqft-susy-math-foundations; full statement, dependencies, and source qualifications are in the item carrier.",
      "dependency_level": 2,
      "deps": [
        "def-qftx-unitary-super-poincare-representation",
        "def-qftx-super-poincare-algebra-4d",
        "def-complex-conjugate-real-imaginary-part-and-modulus",
