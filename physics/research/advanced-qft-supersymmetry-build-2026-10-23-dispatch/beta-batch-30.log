      "id": "def-qftx-n1-chiral-superfield",
      "kind": "definition",
      "domain": "mathematics",
      "library": "mathematics",
      "title": "Four-dimensional N=1 chiral superfield on flat superspace",
      "reference": "items/def-qftx-n1-chiral-superfield.md",
      "design_state": "Draft authored for aqft-susy-math-foundations; full statement, dependencies, and source qualifications are in the item carrier.",
      "dependency_level": 2,
      "deps": [
        "def-qftx-superspace-grassmann-algebra",
