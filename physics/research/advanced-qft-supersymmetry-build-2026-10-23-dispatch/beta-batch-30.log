      "id": "def-qftx-superspace-grassmann-algebra",
      "kind": "definition",
      "domain": "mathematics",
      "library": "mathematics",
      "title": "Four-dimensional N=1 superspace Grassmann algebra and Berezin integration",
      "reference": "items/def-qftx-superspace-grassmann-algebra.md",
      "design_state": "Draft authored for aqft-susy-math-foundations; full statement, dependencies, and source qualifications are in the item carrier.",
      "dependency_level": 0,
      "deps": [
