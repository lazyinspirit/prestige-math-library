  {
    const factLabels = new Set(facts.keys());
    if (factLabels.size >= 4) {
      for (const step of steps.values()) {
        const cited = [...explicitTokens(step.text)].filter((t) => factLabels.has(t));
        if (cited.length >= 4 && cited.length * 2 >= factLabels.size) {
