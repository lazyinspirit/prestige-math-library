} else if (mechanical) {
  if (!contractsPath || !judgePath || !verifyCurrent || receiptPath || templatePath || spineReceiptPath) usage();
} else if ((!receiptPath && !templatePath) || (receiptPath && templatePath)) usage();
const errors = [];
const warnings = [];
