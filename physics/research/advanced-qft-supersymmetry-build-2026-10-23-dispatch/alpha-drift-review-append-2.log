+          "id": "def-qftx-smooth-sobolev-gauge-configuration",
+          "kind": "definition",
+          "domain": "mathematics",
+          "library": "mathematics",
+          "title": "Smooth and Sobolev configuration and reduced gauge spaces",
+          "reference": "items/def-qftx-smooth-sobolev-gauge-configuration.md#Definition",
+          "deps": [
+            "def-gauge-group-of-a-smooth-principal-bundle",
+            "def-principal-connection-and-vertical-curvature",
+            "def-axiom-of-choice"
+          ],
+          "dependency_roles": {
+            "def-gauge-group-of-a-smooth-principal-bundle": "mathematical-premise",
+            "def-principal-connection-and-vertical-curvature": "mathematical-premise",
+            "def-axiom-of-choice": "mathematical-premise"
+          },
+          "statement": "Fix compact connected oriented boundaryless smooth Riemannian M, d=3 or4, N>=2, smooth principal SU(N) bundle P and smooth reference A0. Define A_k=A0+H^k(T*M tensor adP), integer k>d/2+1, G_{k+1}=H^{k+1} sections of AdP, Gbar=G/Z_N, based G_m={u:u(p_m)=e}, A_infty=A0+Omega^1(adP) with seminorm C-infty topology, and smooth gauge group with C-infty section topology. Quotients have quotient topology. Define irreducible as holonomy acts irreducibly on C^N; do not replace this by full holonomy without proof. Fix action A^u=u^-1Au+u^-1du and Sobolev norms by a finite bundle atlas.",
+          "strategy": "Specify all spaces, norm equivalence, basepoint frame and finite central quotient; locally define any unprovided adjoint-bundle/Sobolev-section conventions. Definition only; smoothness claims in the next lemma.",
+          "proof_strategy": "definition",
+          "provenance": {
+            "statement": "ai-altered",
+            "proof": "not-applicable"
+          },
+          "sources": {
+            "references": [
+              {
+                "title": "I. M. Singer, Some Remarks on the Gribov Ambiguity, CMP60 (1978), 7–12",
+                "url": "https://scispace.com/pdf/some-remarks-on-the-gribov-ambiguity-33y52evtqe.pdf",
+                "locator": "Singer §§1–2 pp7–9; Mitter §§I–III"
+              },
+              {
+                "title": "P. K. Mitter and C. M. Viallet, On the Bundle of Connections and the Gauge Orbit Manifold in Yang–Mills Theory, CMP79 (1981), 457–472",
+                "url": "https://scispace.com/pdf/on-the-bundle-of-connections-and-the-gauge-orbit-manifold-in-1nks9qpdkj.pdf",
+                "locator": "Singer §§1–2 pp7–9; Mitter §§I–III"
+              }
+            ]
+          },
+          "axiom_base": "Use ZF + AC through the chosen analytic/topological imported suppliers; record precise uses and carry AC to every consumer. No new choice-free claim.",
+          "design_state": "Explicit planned prerequisite; no authored carrier/readiness or independent proof acceptance is asserted."
+        },
+        {
+          "id": "lem-qftx-gauge-sobolev-calculus",
+          "kind": "lemma",
+          "domain": "mathematics",
+          "library": "mathematics",
+          "title": "Sobolev gauge calculus and smooth gauge action",
+          "reference": "items/lem-qftx-gauge-sobolev-calculus.md#Statement",
+          "deps": [
+            "def-qftx-smooth-sobolev-gauge-configuration",
+            "cor-sobolev-algebra-above-the-critical-index",
+            "thm-higher-order-sobolev-embedding",
