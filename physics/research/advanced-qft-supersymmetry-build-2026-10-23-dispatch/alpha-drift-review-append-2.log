      "items": [
        {
          "id": "thm-qftx-gaga-analytic-local-ring-flatness",
          "kind": "theorem",
          "domain": "mathematics",
          "library": "mathematics",
          "title": "Faithful flatness of finite-type algebraic-to-analytic local rings",
          "deps": [
            "def-axiom-of-choice",
