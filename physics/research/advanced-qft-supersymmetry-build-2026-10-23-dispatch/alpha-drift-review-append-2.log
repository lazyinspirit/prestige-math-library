            "thm-noetherian-ring-quotients-and-localisations": "mathematical-premise",
            "thm-completion-of-a-noetherian-local-ring": "mathematical-premise",
            "thm-flatness-of-noetherian-completion": "mathematical-premise",
            "thm-flatness-criteria-by-injections-and-ideals": "mathematical-premise",
            "thm-faithfully-flat-ring-map-characterisations": "mathematical-premise",
            "thm-long-exact-tor-sequence-in-the-right-module-variable": "mathematical-premise"
          },
          "statement": "Assume AC. Let X be a finite-type complex scheme, x a complex closed point, and define X^an locally by extending a finite polynomial defining ideal to convergent holomorphic functions, retaining nilpotents. The canonical local map A=O_{X,x}\u2192B=O_{X^an,x} is injective and faithfully flat; its induced map on maximal-ideal completions is an isomorphism. In Serre\u2019s flat-pair convention, B/A is flat over A and M\u2192M\u2297_A B is injective for every A-module M. On an affine ambient chart at x, C[t]_(t) and C{t} have common completion C[[t]], and the quotient comparison is compatible with every finitely generated defining ideal. This is a local-ring assertion, not a relative direct-image theorem.",
          "strategy": "Identify finite jets on polynomial local and convergent rings by truncation and finite degree-k monomial grouping of convergent tails. Apply existing completion flatness: T is flat over A and faithfully flat over B. For each injection of A-modules tensor its B-kernel with T, use A-flatness of T and faithful reflection to get zero kernel. Prove local faithfulness and unit injection, then Tor gives B/A flat. Pass to the same extended defining ideal for finite-type quotients; do not invoke reduced-set Nullstellensatz.",
          "proof_strategy": "direct",
          "axiom_base": "ZF + full AC; record resolutions, countable shrinking/diagonal choices, Baire/Fr\u00e9chet arguments and supplier-inherited choice uses precisely. No physical premise.",
          "provenance": {
            "statement": "literature-derived",
            "proof": "ai-altered"
          },
          "sources": {
            "references": [
              {
                "title": "Serre",
                "url": "https://www.college-de-france.fr/media/jean-pierre-serre/UPL1698785858825941763_Serre_GAGA.pdf",
                "locator": "\u00a76 Proposition3/Corollary1 printed pp.9\u201311; Annex Propositions22\u201323,27\u201329 printed pp.36\u201340; read."
              }
            ]
          },
          "proof_contract_plan": {
            "state": "unproved proposal; no local proof/native approval",
            "obligations": [
              "Identify finite jets on polynomial local and convergent rings by truncation and finite degree-k monomial grouping of convergent tails",
              "Apply existing completion flatness: T is flat over A and faithfully flat over B",
              "For each injection of A-modules tensor its B-kernel with T, use A-flatness of T and faithful reflection to get zero kernel",
              "Prove local faithfulness and unit injection, then Tor gives B/A flat",
              "Pass to the same extended defining ideal for finite-type quotients; do not invoke reduced-set Nullstellensatz."
            ],
            "source_reading_is_not_proof": true,
            "native_authoring_and_independent_review_required": true
          },
          "reference": "items/thm-qftx-gaga-analytic-local-ring-flatness.md#Statement",
          "dependency_level": 1
