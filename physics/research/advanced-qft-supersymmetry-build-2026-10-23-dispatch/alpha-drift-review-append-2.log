+          ],
+          "dependency_roles": {
+            "def-qftx-smooth-sobolev-gauge-configuration": "mathematical-premise",
+            "cor-sobolev-algebra-above-the-critical-index": "mathematical-premise",
+            "thm-higher-order-sobolev-embedding": "mathematical-premise",
+            "thm-inverse-function-theorem-for-banach-spaces": "mathematical-premise"
+          },
+          "statement": "For data of the preceding definition, finite-atlas Sobolev norms are equivalent; H^k sections embed in C1 for k>d/2+1, pointwise multiplication H^k x H^k→H^k is bounded, local matrix exponential/log charts make G_{k+1} a Hilbert Lie group, and the gauge action A_k x G_{k+1}→A_k is smooth.",
+          "strategy": "Transfer existing Euclidean-domain product/embedding estimates with cutoffs; construct section charts explicitly. Prove Nemytskii derivatives and one-derivative loss, not just scalar product boundedness. Constants are uniform over the fixed finite atlas.",
+          "proof_strategy": "direct",
+          "provenance": {
+            "statement": "ai-altered",
+            "proof": "not-supplied"
+          },
