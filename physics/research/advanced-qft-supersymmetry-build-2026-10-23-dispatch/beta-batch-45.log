/bin/bash -lc "python3 - <<'PY'
import json
from pathlib import Path
p=Path('research/advanced-qft-supersymmetry-build-2026-10-23-batch-45.proof-contracts.json')
data=json.loads(p.read_text())
c=data['contracts']

# Wilsonian superpotential theorem: canonical proof numbering is 1.1, 2.1, 3.1.
t=c['pthm-aqft-wilsonian-superpotential-nonrenormalization']
for citation in t['citations']:
    uses=citation['uses']
    citation['uses']=[{'1.2':'2.1','2.1':'3.1'}.get(s,s) for s in uses]
for d, step in zip(t['derivations'], ['1.1','2.1','3.1']):
    d['id']='step-'+step.replace('.','-')
    d['step']=step
    for i,x in enumerate(d['inputs']):
