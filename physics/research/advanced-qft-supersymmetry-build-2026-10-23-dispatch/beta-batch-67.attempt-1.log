+  - def-complex-manifolds-and-holomorphic-vector-bundles
+dependency_roles:
+  def-complex-projective-space-and-holomorphic-charts: mathematical-premise
+  def-complex-manifolds-and-holomorphic-vector-bundles: mathematical-premise
+justified_by: []
+aliases: []
