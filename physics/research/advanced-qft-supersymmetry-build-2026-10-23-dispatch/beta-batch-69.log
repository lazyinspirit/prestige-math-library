#!/usr/bin/env node
import { existsSync as physicsExistsSync } from 'node:fs';
const physicsToolRoot = fileURLToPath(new URL('../../', import.meta.url));
// proof-contract.mjs — auditable proof-obligation, citation, and boundary contracts.
//
//   node tools/physics-support/proof-contract.mjs research/level<n>-proof-contracts.json --strict
//   node tools/physics-support/proof-contract.mjs research/level<n>-proof-contracts.json --items id-a,id-b
//
// This intentionally does not attempt to prove mathematics.  It makes three
