    kind: parseFrontmatter(fm).kind,
    body,
    deps: list(fm, 'deps'),
    justified: list(fm, 'justified_by'),
    forward: list(fm, 'forward_refs'),
    statementProvenance: nested(fm, 'provenance', 'statement'),
  };
}


