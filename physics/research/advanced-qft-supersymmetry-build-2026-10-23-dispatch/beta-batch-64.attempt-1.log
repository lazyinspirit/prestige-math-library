research/advanced-qft-supersymmetry-build-2026-10-23-owner-resolution/private-preparation/0f7d7a66-73a7-41eb-960f-f9fff69cd3ca-batch-64.pages.json:1:[{"id": "qftx-gaga-local-analytic-flatness", "title": "Faithful flatness of finite-type algebraic-to-analytic local rings", "kind": "A", "category": "quantum-field-theory-mathematics", "library": "mathematics", "order": 967.16, "companion": "qftx-gaga-local-analytic-flatness-examples", "requires": ["relations-functions-and-quotients", "analytic-continuation-and-monodromy", "holomorphic-functions-of-several-variables", "holomorphic-inverse-and-weierstrass-preparation", "noetherian-rings-and-hilbert-basis", "inverse-limits-and-noetherian-completion", "tensor-products-of-modules", "flatness-and-faithful-flatness", "tor-flatness-and-global-dimension", "schemes-subschemes-and-morphisms-locally-of-finite-type"], "items": [{"id": "thm-qftx-gaga-analytic-local-ring-flatness", "kind": "theorem", "domain": "mathematics", "library": "mathematics", "title": "Faithful flatness of finite-type algebraic-to-analytic local rings", "deps": ["def-axiom-of-choice", "thm-holomorphic-germs-at-a-point-form-a-local-ring", "thm-power-series-expansion-in-several-complex-variables", "thm-holomorphic-germ-ring-is-noetherian", "thm-hilbert-basis-theorem", "thm-noetherian-ring-quotients-and-localisations", "thm-completion-of-a-noetherian-local-ring", "thm-flatness-of-noetherian-completion", "thm-flatness-criteria-by-injections-and-ideals", "thm-faithfully-flat-ring-map-characterisations", "thm-long-exact-tor-sequence-in-the-right-module-variable"], "dependency_roles": {"def-axiom-of-choice": "mathematical-premise", "thm-holomorphic-germs-at-a-point-form-a-local-ring": "mathematical-premise", "thm-power-series-expansion-in-several-complex-variables": "mathematical-premise", "thm-holomorphic-germ-ring-is-noetherian": "mathematical-premise", "thm-hilbert-basis-theorem": "mathematical-premise", "thm-noetherian-ring-quotients-and-localisations": "mathematical-premise", "thm-completion-of-a-noetherian-local-ring": "mathematical-premise", "thm-flatness-of-noetherian-completion": "mathematical-premise", "thm-flatness-criteria-by-injections-and-ideals": "mathematical-premise", "thm-faithfully-flat-ring-map-characterisations": "mathematical-premise", "thm-long-exact-tor-sequence-in-the-right-module-variable": "mathematical-premise"}, "statement": "Assume AC. Let X be a finite-type complex scheme, x a complex closed point, and define X^an locally by extending a finite polynomial defining ideal to convergent holomorphic functions, retaining nilpotents. The canonical local map A=O_{X,x}\u2192B=O_{X^an,x} is injective and faithfully flat; its induced map on maximal-ideal completions is an isomorphism. In Serre\u2019s flat-pair convention, B/A is flat over A and M\u2192M\u2297_A B is injective for every A-module M. On an affine ambient chart at x, C[t]_(t) and C{t} have common completion C[[t]], and the quotient comparison is compatible with every finitely generated defining ideal. This is a local-ring assertion, not a relative direct-image theorem.", "strategy": "Identify finite jets on polynomial local and convergent rings by truncation and finite degree-k monomial grouping of convergent tails. Apply existing completion flatness: T is flat over A and faithfully flat over B. For each injection of A-modules tensor its B-kernel with T, use A-flatness of T and faithful reflection to get zero kernel. Prove local faithfulness and unit injection, then Tor gives B/A flat. Pass to the same extended defining ideal for finite-type quotients; do not invoke reduced-set Nullstellensatz.", "proof_strategy": "direct", "axiom_base": "ZF + full AC; record resolutions, countable shrinking/diagonal choices, Baire/Fr\u00e9chet arguments and supplier-inherited choice uses precisely. No physical premise.", "provenance": {"statement": "literature-derived", "proof": "not-supplied"}, "sources": {"references": [{"title": "Serre", "url": "https://www.college-de-france.fr/media/jean-pierre-serre/UPL1698785858825941763_Serre_GAGA.pdf", "locator": "\u00a76 Proposition3/Corollary1 printed pp.9\u201311; Annex Propositions22\u201323,27\u201329 printed pp.36\u201340; read."}]}, "proof_contract_plan": {"state": "unproved proposal; no local proof/native approval", "obligations": ["Identify finite jets on polynomial local and convergent rings by truncation and finite degree-k monomial grouping of convergent tails", "Apply existing completion flatness: T is flat over A and faithfully flat over B", "For each injection of A-modules tensor its B-kernel with T, use A-flatness of T and faithful reflection to get zero kernel", "Prove local faithfulness and unit injection, then Tor gives B/A flat", "Pass to the same extended defining ideal for finite-type quotients; do not invoke reduced-set Nullstellensatz."], "source_reading_is_not_proof": true, "native_authoring_and_independent_review_required": true}, "reference": "items/thm-qftx-gaga-analytic-local-ring-flatness.md#Statement", "dependency_level": 1, "page": "qftx-gaga-local-analytic-flatness", "category": "quantum-field-theory-mathematics", "status": "draft", "origin": "pipeline", "inventory_expansion_required": true, "design_state": "Owner-approved unproved mathematical prerequisite proposal; fresh native supplemental drift and full authoring required.", "proof_obligation": "Identify finite jets on polynomial local and convergent rings by truncation and finite degree-k monomial grouping of convergent tails. Apply existing completion flatness: T is flat over A and faithfully flat over B. For each injection of A-modules tensor its B-kernel with T, use A-flatness of T and faithful reflection to get zero kernel. Prove local faithfulness and unit injection, then Tor gives B/A flat. Pass to the same extended defining ideal for finite-type quotients; do not invoke reduced-set Nullstellensatz."}], "examples": [], "status": "draft", "scaffold": true, "canonical_scaffold": true}, {"id": "qftx-gaga-local-analytic-flatness-examples", "title": "Faithful flatness of finite-type algebraic-to-analytic local rings \u2014 Examples", "kind": "B", "category": "quantum-field-theory-mathematics", "library": "mathematics", "order": 967.16, "requires": ["qftx-gaga-local-analytic-flatness"], "items": [{"id": "ex-qftx-gaga-analytic-equal-completions", "kind": "example", "domain": "mathematics", "library": "mathematics", "title": "Unequal local rings with equal completions", "deps": ["thm-qftx-gaga-analytic-local-ring-flatness"], "dependency_roles": {"thm-qftx-gaga-analytic-local-ring-flatness": "mathematical-premise"}, "statement": "C[t]_(t)\u2192C{t} is faithfully flat with common completion C[[t]], but is not surjective.", "strategy": "Use a convergent nonrational germ, e.g. exp(t), and prove its nonrationality.", "axiom_base": "ZF + AC inherited from the theorem; no physical premise.", "provenance": {"statement": "ai-generated", "proof": "not-supplied"}, "generation": {"role": "example"}, "sources": {"references": [{"title": "Serre", "url": "https://www.college-de-france.fr/media/jean-pierre-serre/UPL1698785858825941763_Serre_GAGA.pdf", "locator": "\u00a76 Proposition3/Corollary1 printed pp.9\u201311; Annex Propositions22\u201323,27\u201329 printed pp.36\u201340; read."}]}, "proof_contract_plan": {"state": "unproved proposal", "obligations": ["Use a convergent nonrational germ, e.g. exp(t), and prove its nonrationality."], "native_authoring_and_independent_review_required": true}, "reference": "items/ex-qftx-gaga-analytic-equal-completions.md#Example", "proof_strategy": "direct", "dependency_level": 2, "page": "qftx-gaga-local-analytic-flatness-examples", "category": "quantum-field-theory-mathematics", "status": "draft", "origin": "pipeline", "inventory_expansion_required": true, "design_state": "Owner-approved unproved mathematical prerequisite proposal; fresh native supplemental drift and full authoring required.", "proof_obligation": "Use a convergent nonrational germ, e.g. exp(t), and prove its nonrationality."}, {"id": "ex-qftx-gaga-analytic-nonreduced-quotient", "kind": "example", "domain": "mathematics", "library": "mathematics", "title": "Faithful flatness retaining a nilpotent thickening", "deps": ["thm-qftx-gaga-analytic-local-ring-flatness"], "dependency_roles": {"thm-qftx-gaga-analytic-local-ring-flatness": "mathematical-premise"}, "statement": "C[x,y]_(x,y)/(x^2)\u2192C{x,y}/(x^2) is faithfully flat and retains the nonzero nilpotent class x.", "strategy": "Apply quotient flatness and verify x\u22600; do not replace by reduced vanishing sets.", "axiom_base": "ZF + AC inherited from the theorem; no physical premise.", "provenance": {"statement": "ai-generated", "proof": "not-supplied"}, "generation": {"role": "example"}, "sources": {"references": [{"title": "Serre", "url": "https://www.college-de-france.fr/media/jean-pierre-serre/UPL1698785858825941763_Serre_GAGA.pdf", "locator": "\u00a76 Proposition3/Corollary1 printed pp.9\u201311; Annex Propositions22\u201323,27\u201329 printed pp.36\u201340; read."}]}, "proof_contract_plan": {"state": "unproved proposal", "obligations": ["Apply quotient flatness and verify x\u22600; do not replace by reduced vanishing sets."], "native_authoring_and_independent_review_required": true}, "reference": "items/ex-qftx-gaga-analytic-nonreduced-quotient.md#Example", "proof_strategy": "direct", "dependency_level": 2, "page": "qftx-gaga-local-analytic-flatness-examples", "category": "quantum-field-theory-mathematics", "status": "draft", "origin": "pipeline", "inventory_expansion_required": true, "design_state": "Owner-approved unproved mathematical prerequisite proposal; fresh native supplemental drift and full authoring required.", "proof_obligation": "Apply quotient flatness and verify x\u22600; do not replace by reduced vanishing sets."}], "companion": "qftx-gaga-local-analytic-flatness", "status": "draft", "scaffold": true, "canonical_scaffold": true}]
