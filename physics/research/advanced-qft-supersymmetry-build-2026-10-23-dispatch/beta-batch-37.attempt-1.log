+{
+  "version": 1,
+  "scope": [
+    "def-aqft-p-form-global-symmetry",
+    "pthm-aqft-p-form-charge-characters",
+    "ex-aqft-maxwell-magnetic-one-form-charge",
+    "ex-aqft-s3-zero-form-representation-labels"
+  ],
+  "contracts": {
+    "def-aqft-p-form-global-symmetry": {
+      "citations": [],
+      "derivations": [],
+      "routine_steps": [],
+      "boundaries": [
+        {"case":"empty","status":"not_applicable","reason":"This is a data definition and asserts no model existence for an empty field space."},
+        {"case":"zero","status":"checked","evidence":"The definition includes p=0 and explicitly allows non-Abelian zero-form groups with representation-valued local charges."},
+        {"case":"one","status":"checked","evidence":"The identity group element is assigned the transparent identity interface and each element has an inverse."},
+        {"case":"degenerate","status":"checked","evidence":"The model may have no nontrivial charge sectors; the definition does not assert a nontrivial action."},
+        {"case":"endpoints","status":"checked","evidence":"The support dimension d-p-1 is nonnegative because the definition requires 0<=p<d."},
+        {"case":"nonempty-choice","status":"checked","evidence":"Groups, bundles, sectors and backgrounds are supplied model data; the definition makes no arbitrary-index choice."},
+        {"case":"iff-forward","status":"not_applicable","reason":"The section defines data and contains no biconditional."},
+        {"case":"iff-reverse","status":"not_applicable","reason":"The section defines data and contains no biconditional."}
+      ],
+      "finite_smoke": []
+    },
+    "pthm-aqft-p-form-charge-characters": {
+      "citations": [
+        {
+          "fact": "F1",
+          "source": "def-aqft-p-form-global-symmetry",
+          "source_section": "Definition",
+          "quote": "A **group-like $p$-form global symmetry** of $\\mathcal T$ consists of a locally compact Hausdorff topological group $G$ and an assignment $g\\mapsto U_g(\\Sigma)$ of invertible symmetry interfaces to the allowed closed supports $\\Sigma$ of dimension $d-p-1$ and codimension $p+1$.",
+          "uses": ["1.1","1.2","2.1","2.2","2.4"]
+        }
+      ],
+      "derivations": [
+        {"id":"step-1-1","step":"1.1","claim":"State both ordered products using the group-like fusion law.","inputs":["given","F1"]},
+        {"id":"step-1-2","step":"1.2","claim":"Use the admissible exchange isotopy and topologicality to equate correlators, then use effectiveness to conclude group commutativity.","inputs":["A2","F1","step 1.1"]},
+        {"id":"step-2-1","step":"2.1","claim":"A simple nonzero operator has a scalar, nonzero crossing endomorphism under each invertible symmetry defect.","inputs":["A1","F1"]},
+        {"id":"step-2-2","step":"2.2","claim":"Fusion and successive crossing imply multiplicativity and the identity value of the scalar.","inputs":["F1","step 2.1","algebra"]},
+        {"id":"step-2-3","step":"2.3","claim":"Unitary conjugation preserves operator norm, forcing the scalar to have unit modulus; the model supplies continuity.","inputs":["A1","step 2.1","algebra"]},
+        {"id":"step-2-4","step":"2.4","claim":"The scalar action is therefore a continuous U(1) character, hence an element of the defined Pontryagin dual.","inputs":["F1","step 2.2","step 2.3"]}
+      ],
+      "routine_steps": [],
+      "boundaries": [
+        {"case":"empty","status":"not_applicable","reason":"The hypotheses include d>=2, a group G, and an operator O."},
+        {"case":"zero","status":"checked","evidence":"The theorem excludes p=0 explicitly; no non-Abelian zero-form group is forced to be Abelian."},
+        {"case":"one","status":"checked","evidence":"The group identity has character value one by step 2.2; no nontrivial group element is required."},
+        {"case":"degenerate","status":"checked","evidence":"The operator must be bounded and nonzero; zero operators are excluded before division in step 2.2."},
+        {"case":"endpoints","status":"checked","evidence":"The allowed range is 1<=p<d, so symmetry support dimension d-p-1 is nonnegative and codimension is at least two."},
+        {"case":"nonempty-choice","status":"checked","evidence":"The group, model, operator, junction action and exchange isotopies are explicit hypotheses; no choice principle is used."},
+        {"case":"iff-forward","status":"not_applicable","reason":"The result is an implication, not an equivalence."},
+        {"case":"iff-reverse","status":"not_applicable","reason":"The result is an implication, not an equivalence."}
+      ],
+      "finite_smoke": []
+    },
+    "ex-aqft-maxwell-magnetic-one-form-charge": {
+      "citations": [
+        {
+          "fact": "A2",
+          "source": "def-countable-choice",
+          "source_section": "Definition",
+          "quote": "The **Axiom of Countable Choice**, written $\\mathrm{AC}_\\omega$, is the following statement. For every family $(X_n)_{n \\in \\mathbb{N}}$ of nonempty sets indexed by $\\mathbb{N}$ there is a function $f$ with domain $\\mathbb{N}$ such that $f(n) \\in X_n$ for every $n \\in \\mathbb{N}$.",
+          "uses": ["1.1"]
+        },
+        {
+          "fact": "F1",
+          "source": "def-qftx-principal-connection-form",
+          "source_section": "Definition",
+          "quote": "A supplied principal connection is a smooth, right-invariant complement $TP=VP\\oplus H$, where $VP=\\ker d\\pi$; write $v:TP\\to VP$ for the projection along $H$, and let $K_H(X,Y)=-v([hX,hY])$ be its vertical-valued curvature.",
+          "uses": ["1.1"]
+        },
+        {
+          "fact": "F2",
+          "source": "lem-qftx-principal-curvature-cartan-bianchi",
+          "source_section": "Statement",
+          "quote": "For any trivializing cover with smooth sections $s_i:U_i\\to P$, set $A_i=s_i^*\\omega$ and $F_i=s_i^*\\Omega_\\omega. On an overlap, let $g_{ij}:U_i\\cap U_j\\to G$ be the smooth map determined by $s_j=s_i g_{ij}$, and write $\\theta_L(g_{ij})=g_{ij}^*\\theta_L$ for the left Maurer–Cartan form. Then $A_j=\\operatorname{Ad}_{g_{ij}^{-1}}A_i+\\theta_L(g_{ij}),\\quad F_i=dA_i+\\frac12[A_i\\wedge A_i],\\quad F_j=\\operatorname{Ad}_{g_{ij}^{-1}}F_i,\\quad D_{A_i}F_i=0$.",
+          "uses": ["1.1","1.2"]
+        },
+        {
+          "fact": "F3",
+          "source": "thm-stokes-theorem-for-smooth-singular-chains",
+          "source_section": "Statement",
+          "quote": "For $k\\ge1$, $c\\in C_k^\\infty(M;\\mathbb R)$ and $\\omega\\in\\Omega^{k-1}(M)$, define integration over a chain by the finite linear sum of its simplex integrals. Then $$\\int_c d\\omega=\\int_{\\partial c}\\omega.$$",
+          "uses": ["1.2","2.1"]
+        },
+        {
+          "fact": "F4",
+          "source": "def-aqft-p-form-global-symmetry",
+          "source_section": "Definition",
+          "quote": "A **genuine $p$-dimensional observable** is an observable supported on a closed embedded $p$-dimensional submanifold whose definition is independent of an attached higher-dimensional support.",
+          "uses": ["2.2"]
+        },
+        {
+          "fact": "F5",
+          "source": "pthm-aqft-p-form-charge-characters",
+          "source_section": "Statement",
+          "quote": "There is a continuous character $\\chi_O:G\\to U(1)$ such that passing $U_g$ across $O$ multiplies it by $\\chi_O(g)$. Thus the charge of $O$ belongs to the Pontryagin dual $\\widehat G=\\operatorname{Hom}_{\\mathrm{cts}}(G,U(1))$.",
+          "uses": ["2.3"]
+        }
+      ],
+      "derivations": [
+        {"id":"step-1-1","step":"1.1","claim":"Reduce the Bianchi identity to dF=0 because the U(1) Lie algebra bracket vanishes.","inputs":["A1","A2","F1","F2","algebra"]},
+        {"id":"step-1-2","step":"1.2","claim":"Apply smooth-singular-chain Stokes in the source-free region to prove the surface insertion is invariant under the swept isotopy.","inputs":["A1","F3","step 1.1","algebra"]},
+        {"id":"step-2-1","step":"2.1","claim":"Use the supplied source-free chain with linking-sphere boundary components and the line's flux data to evaluate the surface-flux jump.","inputs":["A1","F3","step 1.1","algebra"]},
+        {"id":"step-2-2","step":"2.2","claim":"Exponentiate the flux difference to obtain the crossing phase and the unit-linking charge.","inputs":["A1","F4","step 2.1","algebra"]},
+        {"id":"step-2-3","step":"2.3","claim":"Check 2pi periodicity, multiplicativity and continuity of the integer magnetic charge character.","inputs":["A1","F5","step 2.2","algebra"]},
+        {"id":"step-3-1","step":"3.1","claim":"Check zero-charge, identity-parameter and orientation-reversal boundary cases.","inputs":["A1","step 2.1","step 2.2","algebra"]}
+      ],
+      "routine_steps": [],
+      "boundaries": [
+        {"case":"empty","status":"not_applicable","reason":"The example fixes M=R^4 and a nonempty field and insertion sector."},
+        {"case":"zero","status":"checked","evidence":"Step 3.1 gives the trivial phase when m=0."},
+        {"case":"one","status":"checked","evidence":"Step 2.3 checks alpha=0 and alpha=2pi using integer flux m."},
+        {"case":"degenerate","status":"checked","evidence":"Step 3.1 covers zero magnetic charge and the identity symmetry parameter."},
+        {"case":"endpoints","status":"checked","evidence":"Alpha is an angle modulo 2pi; step 2.3 verifies the two representatives give the same operator."},
+        {"case":"nonempty-choice","status":"checked","evidence":"The group, bundle, connection, external line, flux normalization and finite support chain are supplied model data; only AC_omega is inherited."},
+        {"case":"iff-forward","status":"not_applicable","reason":"The example states a charge calculation, not an equivalence."},
+        {"case":"iff-reverse","status":"not_applicable","reason":"The example states a charge calculation, not an equivalence."}
+      ],
+      "finite_smoke": []
+    },
+    "ex-aqft-s3-zero-form-representation-labels": {
+      "citations": [
+        {
+          "fact": "F1",
+          "source": "def-aqft-p-form-global-symmetry",
+          "source_section": "Definition",
+          "quote": "For $p=0$, local observables may carry higher-dimensional representations of a non-Abelian group; the representation label is distinct from the group element implementing a transformation.",
+          "uses": ["1.1","1.5"]
+        },
+        {
+          "fact": "F2",
+          "source": "pthm-aqft-p-form-charge-characters",
+          "source_section": "Statement",
+          "quote": "This theorem makes no claim for $p=0$ or for operators with nonscalar crossing endomorphisms.",
+          "uses": ["1.4"]
+        }
+      ],
+      "derivations": [
+        {"id":"step-1-1","step":"1.1","claim":"Verify the permutation representation law and exhibit two noncommuting transpositions.","inputs":["A1","F1","algebra"]},
+        {"id":"step-1-2","step":"1.2","claim":"Show the constant vector and sum-zero plane give invariant complementary subspaces.","inputs":["given","algebra"]},
+        {"id":"step-1-3","step":"1.3","claim":"Use the distinct three-cycle eigenlines and their exchange by a transposition to prove the standard plane is irreducible.","inputs":["given","algebra"]},
+        {"id":"step-1-4","step":"1.4","claim":"Use zero Hamiltonian and fixed cyclic order to verify the finite model's topological zero-form defect and the p=0 boundary of the theorem.","inputs":["A1","F2","step 1.1","algebra"]},
+        {"id":"step-1-5","step":"1.5","claim":"Distinguish state-sector representation labels from group elements that implement transformations.","inputs":["F1","step 1.1","step 1.2"]}
+      ],
+      "routine_steps": [],
+      "boundaries": [
+        {"case":"empty","status":"not_applicable","reason":"The example fixes a nonempty three-dimensional Hilbert space."},
+        {"case":"zero","status":"checked","evidence":"Step 1.2 identifies the one-dimensional trivial representation explicitly."},
+        {"case":"one","status":"checked","evidence":"The identity permutation acts as the identity matrix by the representation law in step 1.1."},
+        {"case":"degenerate","status":"checked","evidence":"The representation decomposition includes both the trivial and irreducible two-dimensional sectors."},
+        {"case":"endpoints","status":"not_applicable","reason":"There is no interval or continuous parameter with endpoints."},
+        {"case":"nonempty-choice","status":"checked","evidence":"The finite basis, group action and operators are explicit; no selection principle is used."},
+        {"case":"iff-forward","status":"not_applicable","reason":"The example asserts a decomposition and representation distinction, not an equivalence."},
+        {"case":"iff-reverse","status":"not_applicable","reason":"The example asserts a decomposition and representation distinction, not an equivalence."}
+      ],
+      "finite_smoke": []
+    }
+  }
+}

