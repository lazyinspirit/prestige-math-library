const MIN_OTHER = 10 * 1024;
const MIN_PDF_PAGES = 4; // Shorter documents require explicit completeness evidence.

if (!coverages.length) {
  console.error('usage: node tools/physics-support/source-fetch-check.mjs --coverage <a,b,...> [--stamp] [--force] [--timeout-sec 90] [--max-bytes N]');
  process.exit(2);
}
const absolute = (f) => (f.startsWith('/') ? f : join(REPO, f));

/** Known abstract/landing-page URL shapes, each with the fix in the message.
