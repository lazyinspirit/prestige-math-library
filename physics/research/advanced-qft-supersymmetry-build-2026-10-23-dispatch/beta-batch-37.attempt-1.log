from pathlib import Path
import json, re

levels = {
  'def-aqft-p-form-global-symmetry': 1,
  'pthm-aqft-p-form-charge-characters': 2,
  'ex-aqft-maxwell-magnetic-one-form-charge': 3,
  'ex-aqft-s3-zero-form-representation-labels': 3,
}
for item_id, level in levels.items():
  p = Path('items') / f'{item_id}.md'
  s = p.read_text()
  s = re.sub(r'(?m)"'^dependency_level: '"\\d+"'$'"', f'dependency_level: {level}', s, count=1)
  s = s.replace('symmetry interface', 'symmetry defect')
  p.write_text(s)

contract_path = Path('research/advanced-qft-supersymmetry-build-2026-10-23-batch-37.proof-contracts.json')
data = json.loads(contract_path.read_text())
for row in data['contracts']['def-aqft-p-form-global-symmetry']['boundaries']:
  if row['case'] == 'one': row['evidence'] = 'Statement: the identity group element is assigned the transparent identity defect and each element has an inverse.'
th = data['contracts']['pthm-aqft-p-form-charge-characters']
th['citations'][0]['quote'] = 'A **group-like "'$p$-form global symmetry** of $'"\\\\mathcal T"'$ consists of a locally compact Hausdorff topological group $G$ and an assignment $g'"\\\\mapsto U_g(\\\\Sigma)"'$ of invertible topological symmetry defects to the allowed closed supports $'"\\\\Sigma"'$ of dimension $d-p-1$ and codimension $p+1$.'"'
mx = data['contracts']['ex-aqft-maxwell-magnetic-one-form-charge']
for cite in mx['citations']:
  if cite['fact'] == 'F4':
    cite['quote'] = 'Its symmetry action is defined by moving a symmetry defect across it, with the model specifying the resulting junction or operator action.'
contract_path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + '\\n')

manifest_path = Path('research/advanced-qft-supersymmetry-build-2026-10-23-batch-37.pages.json')
pages = json.loads(manifest_path.read_text())
for page in pages:
  for row in page['items']:
    row['dependency_level'] = levels[row['id']]
    item_text = Path(row['reference']).read_text()
    heading = {'definition':'Definition','physics-theorem':'Statement','example':'Example'}[row['kind']]
    match = re.search(r'"'^## '"' + re.escape(heading) + r'\\s*\\n(.*?)(?="'^## '"' + re.escape(heading) + r' references\\s*"'$)'"', item_text, re.M | re.S)
    if not match: raise SystemExit(f'Could not extract {heading} for {row[\"id\"]}')
    row['statement'] = match.group(1).strip()
manifest_path.write_text(json.dumps(pages, indent=2, ensure_ascii=False) + '\\n')
