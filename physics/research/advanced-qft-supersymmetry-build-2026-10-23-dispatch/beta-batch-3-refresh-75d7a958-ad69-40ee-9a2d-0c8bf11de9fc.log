  "contracts": {
    "lem-qftx-complex-grassmannian-compactness": {
      "citations": [
        {
          "fact": "F1",
          "source": "cor-heine-borel-in-the-product-topology",
          "source_section": "Statement",
          "quote": "Let $n \\in \\mathbb{N}$ with $n \\ge 1$, let $\\mathbb{R}^n$ be the set of functions\n$n \\to \\mathbb{R}$ ([[lem-metrics-on-rn]]) carrying the product topology of $n$\ncopies of the usual topology of $\\mathbb{R}$ ([[def-product-topology]]), and let\n$d_2$ be the Euclidean metric. Then:\n\n1. The product topology on $\\mathbb{R}^n$ **is** the metric topology of $d_2$\n   ([[def-metric-topology]]), so $\\mathbb{R}^n$ as a product and $\\mathbb{R}^n$ as\n   a metric space are one topological space, and it is metrizable\n   ([[def-metrizable-space]]).\n2. A subset $K \\subseteq \\mathbb{R}^n$ is a compact subset for the product\n   topology ([[def-compact-space]]) **if and only if** $K$ is closed in\n   $\\mathbb{R}^n$ and bounded ([[def-metric-bounded-diameter]]).\n\nThe hypothesis $n \\ge 1$ is inherited from [[lem-metrics-on-rn]], which defines\n$\\mathbb{R}^n$ and its three metrics only there; for $n = 0$ the product is a\none-point space and is compact. **No choice principle is used**: the metric\nstatement it is read off from is proved by bisection\n([[thm-heine-borel-rn]]).\n\n",
          "uses": [
            "2.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "step-1-1",
          "step": "1.1",
          "claim": "If $P^*=P$ and $P^2=P$, then $\\mathbb C^N=\\operatorname{ran}P\\oplus\\ker P$: every $x$ equals $Px+(x-Px)$, and the intersection is zero. The two summands are orthogonal because $\\langle Pu,y\\rangle=\\langle u,P^*y\\rangle=0$ for $y\\in\\ker P$. An orthonormal basis adapted to this decomposition makes $P$ diagonal with one $1$ for each basis vector in $\\operatorname{ran}P$ and zero otherwise. Trace is invariant under change of basis, so $\\operatorname{tr}P=\\dim_{\\mathbb C}\\operatorname{ran}P$, while $\\|P\\|_F^2=\\operatorname{tr}(P^*P)=\\operatorname{tr}(P^2)=k$. Thus the stated equations are exactly the orthogonal projections onto $k$-planes, and every such plane has one unique projection.",
          "inputs": [
            "given",
            "algebra",
            "construct"
          ]
        },
        {
          "id": "step-2-1",
          "step": "2.1",
          "claim": "For fixed $k$, the equations $P^*=P$, $P^2=P$, and $\\operatorname{tr}P=k$ are closed conditions on the real and imaginary matrix entries, and step 1.1 bounds the Frobenius norm by $\\sqrt{k}$. Since $2N^2\\ge1$, [F1] makes $\\operatorname{Gr}_{\\mathbb C}(k,N)$ compact. There are finitely many indices $k$; restricting any open cover of their union to each compact member gives a finite subcover for that member, and the union of these finitely many finite subfamilies is finite. Hence $\\mathscr G_N$ is compact.",
          "inputs": [
            "F1",
            "step 1.1",
            "given",
            "algebra"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "checked",
          "evidence": "The Statement has N≥2, so k=1 is in range; step 2.1 treats the finite union of its compact Grassmannians."
        },
        {
          "case": "zero",
          "status": "not_applicable",
          "reason": "The Statement only ranges over proper nonzero planes, so k=0 is excluded."
        },
        {
          "case": "one",
          "status": "checked",
          "evidence": "For N=2 there is one index k=1; step 2.1 reduces to one compact member."
        },
        {
          "case": "degenerate",
          "status": "not_applicable",
          "reason": "The zero and identity projections have ranks outside the Statement range 1≤k<N."
        },
        {
          "case": "endpoints",
          "status": "not_applicable",
          "reason": "The Statement has no parameter, convergence, or endpoint assertion."
        },
        {
          "case": "nonempty-choice",
          "status": "checked",
          "evidence": "Step 2.1 uses finitely many compact subcovers; [F1] states the Heine–Borel input is choice-free."
        },
        {
          "case": "iff-forward",
          "status": "checked",
          "evidence": "Step 1.1 sends every stated projection to its k-dimensional range."
        },
        {
          "case": "iff-reverse",
          "status": "checked",
          "evidence": "Step 1.1 constructs the unique orthogonal projection onto each k-plane."
        }
      ],
      "finite_checks": [
        {
          "name": "smallest admissible case N=2",
          "calculation": "The only index is k=1; a rank-one orthogonal projection has Frobenius norm sqrt(1)=1.",
          "result": "Agrees with step 1.1 and the closed-bounded compactness argument in step 2.1; this finite case is a consistency check, not the general proof."
        }
      ],
      "finite_checks_disposition": "The N=2 calculation checks the projection norm and indexing convention only; the proof uses closedness, boundedness, and finite union compactness for every N≥2."
    },
    "lem-qftx-holonomy-incidence-codimension": {
      "citations": [
        {
          "fact": "F1",
          "source": "lem-qftx-complex-grassmannian-compactness",
          "source_section": "Statement",
          "quote": "Let $N\\ge2$. For $1\\le k<N$, let $\\operatorname{Gr}_{\\mathbb C}(k,N)$ be the set of matrices $P\\in M_N(\\mathbb C)$ satisfying $P^*=P$, $P^2=P$, and $\\operatorname{tr}P=k$, with the topology inherited from $M_N(\\mathbb C)\\cong\\mathbb R^{2N^2}$. The map $P\\mapsto\\operatorname{ran}P$ identifies this space with the usual Grassmannian of complex $k$-planes in $\\mathbb C^N$. The finite union $\\mathscr G_N=\\bigcup_{1\\le k<N}\\operatorname{Gr}_{\\mathbb C}(k,N)$ is compact.\n\n",
          "uses": [
            "1.2",
            "2.1"
          ]
        },
        {
          "fact": "F2",
          "source": "thm-a-regular-level-set-is-an-embedded-submanifold",
          "source_section": "Statement",
          "quote": "Let $F:M^m\\to N^n$ be smooth, let $q\\in N$ be a regular value, and assume\n$F^{-1}(q)$ is nonempty. Then $F^{-1}(q)$ is an embedded submanifold of\ncodimension $n$. Equivalently, it has dimension $m-n$.\n\n",
          "uses": [
            "1.1"
          ]
        }
      ],
