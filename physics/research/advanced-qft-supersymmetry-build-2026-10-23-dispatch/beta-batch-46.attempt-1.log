const coverages = (option('--coverage') ?? '').split(',').map((s) => s.trim()).filter(Boolean);
const stampMode = argv.includes('--stamp');
const force = argv.includes('--force');
const timeoutSec = Number(option('--timeout-sec') ?? 90);
