/bin/bash -lc "python3 - <<'PY'
import json,re,yaml
from pathlib import Path
root=Path('.')
ids=[
'def-aqft-profile-likelihood-ratio',
'def-aqft-calibrated-pvalue',
'def-aqft-cls-exclusion-ratio',
'exp-aqft-atlas-global-smeft-fit-2026',
'exp-aqft-cms-global-smeft-fit-2026',
'exp-aqft-cms-multiboson-smeft-2026',
'exp-aqft-atlas-tau-squark-gluino-search-2025',
]
rows={}
for item_id in ids:
    path=root/'items'/f'{item_id}.md'
    text=path.read_text()
    fm=text.split('---',2)[1]
    data=yaml.safe_load(fm)
    if data['kind']=='definition':
        m=re.search(r'(?ms)"'^## Definition'"\\n(.*?)(?="'^## Definition references)'"',text)
        if not m: raise SystemExit(f'no definition section for {item_id}')
        statement=m.group(1).strip()
    else:
        m=re.search(r'(?ms)"'^## Observations'"\\n(.*?)(?="'^## Observations references)'"',text)
        if not m: raise SystemExit(f'no observations section for {item_id}')
        statement=m.group(1).strip()
    row={
