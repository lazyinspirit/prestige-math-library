import { existsSync as physicsExistsSync } from 'node:fs';
const physicsToolRoot = fileURLToPath(new URL('../../', import.meta.url));
// content-policy.mjs — enforce future-session provenance and containment rules.
//
//   node tools/physics-support/content-policy.mjs research/level<n>-batch-*.pages.json [--manifest-only] [--json]
