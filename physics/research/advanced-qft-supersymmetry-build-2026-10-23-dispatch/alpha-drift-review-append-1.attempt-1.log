              }
            ]
          },
          "axiom_base": "ZF + AC wherever inherited from named suppliers; keep every use explicit. No physical premise.",
          "design_state": "Existing local complete draft argument/definition, still requiring fresh native Beta authoring and review; no readiness or acceptance asserted.",
          "dependency_level": 0,
          "proof_strategy": "definition"
