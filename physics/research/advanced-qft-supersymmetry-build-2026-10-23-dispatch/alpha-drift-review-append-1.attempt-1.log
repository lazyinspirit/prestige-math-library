            "url": "https://julianchaidez.net/materials/reu/lee_smooth_manifolds.pdf"
          }
        ]
      },
      "strategy": "",
      "proof_strategy": "direct"
    },
    {
      "id": "thm-qftx-adhm-real-complex-quotient-correspondence",
