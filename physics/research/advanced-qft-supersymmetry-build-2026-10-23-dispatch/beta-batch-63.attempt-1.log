+      url: "https://www-fourier.univ-grenoble-alpes.fr/~demailly/manuscripts/agbook.pdf"
+    - title: "Joachim Wehler, Stein Manifolds, §4.2, Theorem 4.28"
+      url: "https://www.math.lmu.de/~wehler/20190530_Stein_Manifolds_script.pdf"
+verification:
