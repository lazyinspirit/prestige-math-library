      {
        "id": "ex-aqft-explicit-breaking-endpoint",
        "kind": "example",
        "domain": "physics",
        "library": "physics",
        "category": "advanced-qft-and-supersymmetry",
        "title": "A fixed source breaks the matching symmetry",
        "reference": "items/ex-aqft-explicit-breaking-endpoint.md",
        "design_state": "B-page finite four-dimensional scalar-lattice endpoint with a fixed source; checks explicit breaking and the failure of the theorem hypothesis.",
