+  \fill (2,2) circle (2pt) node[above right] {$(1,1)$};
+  \node[red] at (1.45,-0.45) {$L_{SU(2)}$};
+  \node[blue] at (-0.85,1) {$L_{SO(3)_+}$};
+  \node[green!60!black] at (2.4,1.45) {$L_{SO(3)_-}$};
