+  \draw[->] (0,-0.35) -- (0,2.65) node[above] {$m$};
+  \draw[red,thick] (0,0) -- (2,0);
+  \draw[blue,thick] (0,0) -- (0,2);
+  \draw[green!60!black,thick] (0,0) -- (2,2);
+  \fill (0,0) circle (2pt) node[below left] {$(0,0)$};
