    if not m: raise ValueError(f'missing {heading} {iid}')
    lines=m.group(2).splitlines(); meta=[]
    for idx,line in enumerate(lines):
        text=line.replace('**','')
        opening=re.match(r'"'^'"\\s*(\\d+\\.\\d+)\\b',text)
        if opening:
            refs=re.findall(r'\\bstep\\s+(\\d+\\.\\d+)',text,re.I)
            meta.append({'idx':idx,'old':opening.group(1),'refs':refs,'line':line})
    if len(meta)<2: raise ValueError(f'fewer than 2 steps {iid}')
    layers={}
    for item in meta:
        level=1
        for ref in item['refs']:
            level=max(level,(layers.get(ref) or 1)+1)
        layers[item['old']]=level
    terminal=None
    for item in meta:
        if any(mark in item['line'] for mark in ['∎','■','□']) or re.search(r'\\[discharge-',item['line'],re.I): terminal=item['old']
    if terminal is not None:
        other=[level for label,level in layers.items() if label"'!=terminal]
        if other: layers[terminal]=max(other)+1
    order=sorted(range(len(meta)),key=lambda i:(layers[meta[i]['"'old']],i))
    per_layer={}; mapping={}
    for i in order:
        old=meta[i]['old']; layer=layers[old]
        per_layer[layer]=per_layer.get(layer,0)+1
        mapping[old]=f'{layer}.{per_layer[layer]}'
    slots=[item['idx'] for item in meta]; new_lines=lines[:]
    for k,i in enumerate(order):
        item=meta[i]; label=mapping[item['old']]
        moved=re.sub(r'"'^('"\\s*(?:\\*\\*)?)(\\d+\\.\\d+)',lambda x:x.group(1)+label,item['line'],count=1)
        new_lines[slots[k]]=moved
    def remap_sequence(match):
        prefix,sequence=match.group(1),match.group(2)
        sequence=re.sub(r'\\d+\\.\\d+',lambda x:mapping.get(x.group(0),x.group(0)),sequence)
        return prefix+sequence
    # Match the exact sequence vocabulary used by the normative layer repairer.
    text='\\n'.join(new_lines)
    text=re.sub(r'(steps?\\s+)((?:\\d+\\.\\d+)(?:(?:\\s*,\\s*|\\s+and\\s+|\\s*&\\s*)\\d+\\.\\d+)*)',remap_sequence,text,flags=re.I)
    before=src[:m.start(2)]; after=src[m.end(2):]
    # Layer repair also rewrites step references in remarks and explanatory text after Proof.
    if after:
        after=re.sub(r'(steps?\\s+)((?:\\d+\\.\\d+)(?:(?:\\s*,\\s*|\\s+and\\s+|\\s*&\\s*)\\d+\\.\\d+)*)',remap_sequence,after,flags=re.I)
    p.write_text(before+text+'\\n\\n'+after)
    print(iid+': '+', '.join(f'{item[\"old\"]}->{mapping[item[\"old\"]]}' for item in meta))
print('applied one canonical dependency-layer renumbering pass')
