  return value.replace(/\r?\n/g, ' ').replace(/\s+/g, ' ').trim();
}
function option(flag) {
  const index = argv.indexOf(flag);
  return index >= 0 ? argv[index + 1] : undefined;
}
function resolvePath(path) {
