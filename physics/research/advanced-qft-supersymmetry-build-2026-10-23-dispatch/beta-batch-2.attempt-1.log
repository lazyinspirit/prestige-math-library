    // [base] tag the checker just credited. Honor the mutated lines.
    const joined = lines.join('\n');
    return joined === p0 ? [p0, false] : [joined, true];
  }
  const newLines = lines.slice();
  const slots = meta.map((s) => s.idx);
  orderIdx.forEach((i, k) => {
    newLines[slots[k]] = lines[meta[i].idx].replace(
      /^(\s*(?:\*\*)?)(\d+\.\d+)/,
      (_mm, g1, g2) => g1 + (relabel[g2] || g2),
    );
  });
  let out = newLines.join('\n');
  out = out.replace(
    /(steps?\s+)((?:\d+\.\d+)(?:(?:\s*,\s*|\s+and\s+|\s*&\s*)\d+\.\d+)*)/gi,
    (_mm, g1, g2) => g1 + g2.replace(/\d+\.\d+/g, (x: string) => relabel[x] || x),
  );
  return [out, true];
}

/* ── EXTENSION (2026-07-16, BUGLOG B6) — NOT part of the 0-diff parity port ──
 * A numbered step must contain mathematical content beyond its label and tags:
 * "1.3 [base]" satisfies proposedPrecheck mechanically but is humanly an empty
 * placeholder (the one real defect in the first e2e audit, pair 11). Run this
 * AFTER proposedPrecheck on its (possibly repaired) proof; null = pass. */
export function contentPrecheck(pf: string): string | null {
  for (const l of String(pf || '').split('\n')) {
    const stripped = l.replace(/\*\*/g, '').trim();
    const m = /^(\d+\.\d+)\b(.*)$/.exec(stripped);
    if (!m) continue;
    const residue = m[2].replace(/\[[^\[\]]*\]/g, '').replace(QED_RE, '').replace(/[\s.,;:]+/g, '');
    if (residue.length < 4) return 'empty-step-' + m[1];
  }
  return null;
}

/* ── EXTENSION (2026-07-17, owner-directed) — NOT part of the 0-diff parity port ──
 * "Number the final discharge line": generators sometimes leave the concluding
 * line unnumbered ("Therefore the claim is false. [discharge-construct: ...] ∎"),
 * so proposedPrecheck's strategy check never sees the discharge tag and rejects a
 * mathematically fine proof (observed: seeded-run wave 1, seed 1 variant 0). When
 * a line AFTER the last numbered step ends with a bracket tag (optionally + QED),
 * prepend the next-layer step number. Run BEFORE proposedPrecheck. */
export function numberFinalDischarge(pf: string): { proof: string; repaired: boolean } {
  const p0 = String(pf || '');
  const lines = p0.split('\n');
  let lastStepIdx = -1;
  let maxLayer = 0;
  lines.forEach((l, idx) => {
    const m = /^\s*(?:\*\*)?(\d+)\.\d+\b/.exec(l.replace(/\*\*/g, ''));
    if (m) {
      lastStepIdx = idx;
      maxLayer = Math.max(maxLayer, parseInt(m[1], 10));
    }
  });
  if (lastStepIdx < 0) return { proof: p0, repaired: false }; // no steps at all — nothing to anchor to
  for (let i = lastStepIdx + 1; i < lines.length; i++) {
    const t = lines[i].trim();
    if (!t) continue;
    // exactly the tagged-line shape proposedPrecheck credits: ends "[...]" + optional "." / QED
    if (/\[[^\[\]]{1,200}\]\s*\.?\s*(∎|■|□|\bQ\.?E\.?D\.?)?\s*$/i.test(t.replace(/\*\*/g, ''))) {
      lines[i] = lines[i].replace(/^(\s*)/, `$1${maxLayer + 1}.1 `);
      return { proof: lines.join('\n'), repaired: true };
    }
    return { proof: p0, repaired: false }; // trailing prose without a tag — leave for the checker
  }
  return { proof: p0, repaired: false };
}

/* ── EXTENSION (2026-07-17, D6b — proofs engine only; disproof F2 stays deferred) ──
 * Tag-comma guard: LaTeX inside a bracket tag breaks the comma tokenizer —
 * "[def. order in $\mathrm{Con}\,A$]" splits at the `\,` into a bogus "A$]" token
 * → bad-tag rejection of a sound pair (seeded-run s6-v0). Tags are justification
 * LABELS, not proof content, and the prompt now forbids math there — this guard
 * normalizes offenders by dropping the $…$ span(s) from the tag term (an
 * unbalanced `$` truncates to the text before it). Non-math tags are untouched.
 * Run BEFORE proposedPrecheck. */
export function maskTagMath(pf: string): string {
  return String(pf || '').replace(/\[([^\[\]]*)\]/g, (m, inner: string) => {
    if (inner.indexOf('$') < 0) return m;
    let cleaned = inner.replace(/\$[^$]*\$/g, ' ');
    const dangling = cleaned.indexOf('$');
    if (dangling >= 0) cleaned = cleaned.slice(0, dangling);
    cleaned = cleaned.replace(/\s+/g, ' ').replace(/[\s,]+$/g, '').trim();
    return cleaned ? `[${cleaned}]` : m;
  });
}

export function proposedPrecheck(pf: string, strategy: string): PrecheckResult {
  const p0 = String(pf || '');
  const strat = (strategy || '').toLowerCase();
  if (!/\*\*\s*Given\s*:?\s*\*\*/i.test(p0)) return { err: 'no-given' };
  if (!QED_RE.test(p0)) return { err: 'no-qed' };
  if (/^\s*(?:\*\*)?\d+\.\d+\b/m.test(p0.split(QED_RE).pop() as string)) return { err: 'qed-not-final' };
  const lines = p0.split('\n');
  const meta: StepMeta[] = [];
  lines.forEach((l, idx) => {
    const m = /^\s*(\d+\.\d+)\b/.exec(l.replace(/\*\*/g, ''));
    if (m) meta.push({ idx, label: m[1], text: l });
  });
  if (meta.length < 2) return { err: 'no-steps' };
  const body = lines.map((l) => l.toLowerCase()).join(' ');
  let tagged = 0;
  const badtags: string[] = [];
  for (const s of meta) {
    const mt = /\[([^\[\]]{1,200})\]\s*\.?\s*∎?\s*$/.exec(lines[s.idx].replace(/\*\*/g, '').trim());
    if (!mt) continue;
    tagged++;
    for (const tk of mt[1].split(',')) {
      const t = tk.trim().toLowerCase();
      if (t.startsWith('def.')) continue;
      if (!PROP_TAG.test(t)) badtags.push(tk.trim().slice(0, 30));
    }
  }
  if (badtags.length) return { err: 'bad-tag(' + badtags[0] + ')', strategy: strat };
  if (tagged / meta.length < 0.7) return { err: 'untagged-steps', strategy: strat };
  const known = new Set<string>();
  for (const s of meta) {
    const cs: string[] = [];
    const re = /step\s+(\d+\.\d+)/gi;
    let m: RegExpExecArray | null;
    while ((m = re.exec(lines[s.idx]))) cs.push(m[1]);
    for (const c of cs) {
      if (!known.has(c)) return { err: 'forward-ref-' + c, strategy: strat };
    }
    s.cites = cs;
    known.add(s.label);
  }
  const finalLine = lines[meta[meta.length - 1].idx];
  const miss: string[] = [];
  if (strat === 'contradiction') {
    if (!tagPresent('assume-contra', body)) miss.push('assume-contra');
    if (!tagPresent('discharge-contradiction', finalLine)) miss.push('discharge-contradiction-final');
  } else if (strat === 'contrapositive') {
    if (!tagPresent('contrapositive-reduce', body)) miss.push('contrapositive-reduce');
    if (!tagPresent('assume-hyp', body)) miss.push('assume-hyp');
    if (!tagPresent('discharge-contrapositive', finalLine)) miss.push('discharge-contrapositive-final');
  } else if (strat === 'induction') {
    if (!tagPresent('base', body)) {
      const dm = /discharge-induction:\s*step\s+(\d+\.\d+)/i.exec(finalLine);
      let promoted = false;
      if (dm) {
        for (const s of meta) {
          if (s.label === dm[1]) {
            const ln = lines[s.idx];
            lines[s.idx] = /\[[^\[\]]*\]\s*∎?\s*$/.test(ln)
              ? ln.replace(/\[[^\[\]]*\]\s*(∎?)\s*$/, '[base] $1')
              : ln.replace(/\s+$/, '') + ' [base]';
            promoted = true;
            break;
          }
        }
      }
      if (!promoted) miss.push('base');
    }
    let ihLabel: string | null = null;
    for (const s of meta) {
      if (tagPresent('ih', lines[s.idx])) {
        ihLabel = s.label;
        break;
      }
    }
    if (!ihLabel) miss.push('IH');
    else {
      const cited = meta.some(
        (s) =>
          s.label !== ihLabel &&
          new RegExp('step\\s+' + ihLabel.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\b', 'i').test(
            lines[s.idx],
          ),
      );
      if (!cited) miss.push('step-cites-IH');
    }
    if (!tagPresent('discharge-induction', finalLine)) miss.push('discharge-induction-final');
  } else if (strat === 'cases') {
    if (tagCount('assume-case', body) < 2) miss.push('>=2-assume-case');
    if (!tagPresent('cases-exhaustive', body) && !tagPresent('cases', body))
      miss.push('cases-exhaustive/discharge');
  } else if (strat === 'constructive') {
    if (!tagPresent('construct', body)) miss.push('construct');
    if (!tagPresent('discharge-construct', finalLine)) miss.push('discharge-construct-final');
  }
  // Strategy-independent orphan-tag hygiene (2026-07-18): a strategy OPENER that
  // UNAMBIGUOUSLY starts a discharge-bearing strategy must co-occur with its
  // matching DISCHARGE, even when it belongs to a strategy the proof did not
  // declare (e.g. a stray [contrapositive-reduce] that never discharges, or an
  // [assume-case] with no [cases: …]). The declared strategy's own completeness
  // is checked above, so we skip that family to avoid a redundant double-flag.
  // NOTE: [assume-hyp] is deliberately EXCLUDED — it is a GENERAL "assume this
  // hypothesis" tag (used to assume the antecedent of a direct implication, the
  // [IH] in induction, or ¬Q in a contrapositive), not a contrapositive-only
  // marker, so its bare presence is not an orphan.
  const TAG_FAMILIES: { name: string; openers: string[]; discharge: string }[] = [
    { name: 'contrapositive', openers: ['contrapositive-reduce'], discharge: 'discharge-contrapositive' },
    { name: 'contradiction', openers: ['assume-contra'], discharge: 'discharge-contradiction' },
    { name: 'induction', openers: ['base', 'ih'], discharge: 'discharge-induction' },
    { name: 'cases', openers: ['assume-case', 'cases-exhaustive'], discharge: 'cases' },
  ];
  for (const fam of TAG_FAMILIES) {
    if (fam.name === strat) continue;
    if (fam.openers.some((t) => tagPresent(t, body)) && !tagPresent(fam.discharge, body)) {
      miss.push('orphan-' + fam.name + '-tag');
    }
  }
  if (miss.length) return { err: 'strategy-missing(' + miss.join(',') + ')', strategy: strat };
  const r = layerRepair(p0, lines, meta, meta.map((s) => s.cites || []), true);
  const rep = r[0];
  const did = r[1];
  if (/^\s*(?:\*\*)?\d+\.\d+\b/m.test(rep.split(QED_RE).pop() as string))
    return { err: 'qed-not-final-postrepair', strategy: strat };
  return { err: null, strategy: strat, repaired: did, proof: rep };
}

/* ── EXTENSIONS (2026-07-17 fix round, shared by BOTH dataset engines) ── */

/** F3/B10: strip escalation-retry meta-talk from scratch, sentence-scoped. */
export function scrubRetryMetaTalk(scratch: string): { scratch: string; scrubbed: boolean } {
  const LEAK = /previous (attempt|rejection|version|issue|proof|error)|was rejected|the verifier|the reviewer|the rejection/i;
  const sentences = String(scratch || '').split(/(?<=[.!?])\s+/);
  const kept = sentences.filter((x) => !LEAK.test(x));
  if (kept.length === sentences.length) return { scratch, scrubbed: false };
  return { scratch: kept.join(' ').trim(), scrubbed: true };
}

/** O8: strip a trailing meta closing step; re-attach the QED glyph to the real
 *  final step so the parity precheck still sees a terminal ∎. */
export function stripMetaClosing(p: string): string {
  const lines = String(p || '').split('\n');
  for (let i = lines.length - 1; i >= 0; i--) {
    const t = lines[i].trim();
    if (!t) continue;
    const isMeta = /^(?:\*\*)?\d+\.\d+\s+This (?:completes|finishes|concludes) the proof\b[^\[\]]*?(?:\[[^\[\]]*\])?\s*\.?\s*[∎■□]?\s*(?:\*\*)?$/i.test(t);
    if (isMeta) {
      const hadQed = /[∎■□]/.test(t);
      lines.splice(i, 1);
      if (hadQed) {
        for (let k = lines.length - 1; k >= 0; k--) {
          if (/^\s*(?:\*\*)?\d+\.\d+\b/.test(lines[k].replace(/\*\*/g, ''))) {
            if (!/[∎■□]/.test(lines[k])) lines[k] = lines[k].replace(/\s*$/, ' ∎');
            break;
          }
        }
      }
    }
    break;
  }
  return lines.join('\n');
}

/** Fix 2 mechanical layer: every [def. X] STEP tag must resolve to a
