{
  "finding_index": 1,
  "original_finding": {"id": "consumer-id", "subject_type": "in-flight-item", "consumer_id": null, "observed_source": null, "location": "exact original location", "defect": "ill-formed", "evidence": "exact original evidence", "severity": "nonfatal"},
  "owner_batch": "13",
