 *
 *  Accepts a whole item file or a bare body. */
export function factsSectionText(text) {
  const body = splitFrontmatter(text).body;
  const match = body
    .match(/^##\s+Facts[^\n]*\r?\n([\s\S]*?)(?=^##\s+|(?![\s\S]))/m);
  if (match) return match[1];
