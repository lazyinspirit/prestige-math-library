        "id": "def-qftx-zero-fi-regular-adhm-and-twistor-data",
        "kind": "definition",
        "domain": "mathematics",
        "library": "mathematics",
        "title": "Zero-FI regular ADHM and framed twistor data",
        "status": "draft",
        "dependency_level": 3,
        "deps": [
          "def-qftx-adhm-linear-data-stability-and-regularity",
          "def-qftx-instanton-number-and-asd-sector",
