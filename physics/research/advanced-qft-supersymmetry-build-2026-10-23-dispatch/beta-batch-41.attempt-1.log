    assert(typeof row.batch === 'string' && row.batch && !owners.has(row.batch),
      `Invalid or duplicate batch ownership: ${row.batch}`);
    assert(Array.isArray(row.requires) && row.requires.every(id => typeof id === 'string' && id),
