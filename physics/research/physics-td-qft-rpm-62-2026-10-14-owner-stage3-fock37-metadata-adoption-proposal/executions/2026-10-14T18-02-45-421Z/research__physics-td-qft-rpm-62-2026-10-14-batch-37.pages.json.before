      {
        "id": "def-qft-fock-and-test-spaces",
        "kind": "definition",
        "domain": "mathematics",
        "library": "mathematics",
        "physical_scope": null,
        "title": "Schwartz/distribution spaces and Hilbert Fock conventions",
        "deps": [
          "def-schwartz-space-and-its-seminorms",
          "def-test-function-space-d-of-an-open-set",
          "def-test-function-topology",
