        },
        "provenance": {
          "statement": "literature-derived",
          "proof": "not-applicable"
        },
        "sources": {
          "references": [
            {
              "title": "Lieb and Yngvason, The Physics and Mathematics of the Second Law of Thermodynamics, §IV.A",
              "url": "https://arxiv.org/pdf/cond-mat/9708200v2"
            },
            {
              "title": "André Thess, The Lieb–Yngvason Machine: A didactical tool for the definition of entropy in classical thermodynamics, §§2–3",
              "url": "https://www.dlr.de/de/tt/downloads/dokumente/institut/institutsleitung/Entropie.pdf/@@download/file"
            }
          ]
        },
        "dependency_level": 8
      },
      {
        "id": "post-td-universal-thermal-range",
        "kind": "postulate",
        "domain": "physics",
        "title": "Universal thermal-equilibrium range T5",
        "statement": "Adopt T5: every permitted work coordinate has a thermal-equilibrium partner for every state of an ordered system pair.",
        "deps": [
          "def-td-thermal-join",
          "post-td-thermal-join-axioms"
        ],
        "dependency_roles": {
          "def-td-thermal-join": "formulation-prerequisite",
          "post-td-thermal-join-axioms": "operational-prerequisite"
        },
        "provenance": {
          "statement": "literature-derived",
          "proof": "not-applicable"
        },
        "sources": {
          "references": [
            {
              "title": "Lieb and Yngvason, The Physics and Mathematics of the Second Law of Thermodynamics, §IV.A, T5",
              "url": "https://arxiv.org/pdf/cond-mat/9708200v2"
            },
            {
              "title": "André Thess, The Lieb–Yngvason Machine: A didactical tool for the definition of entropy in classical thermodynamics, §§2–3",
              "url": "https://www.dlr.de/de/tt/downloads/dokumente/institut/institutsleitung/Entropie.pdf/@@download/file"
            }
          ]
        },
        "dependency_level": 9
      },
      {
        "id": "post-td-equilibrium-join-coherence",
        "kind": "postulate",
        "domain": "physics",
        "title": "Equilibrium-join coherence C1",
        "statement": "Adopt the separate C1 condition that an equilibrated join is thermally equivalent to each constituent.",
        "deps": [
          "def-td-thermal-join",
          "post-td-thermal-join-axioms"
        ],
        "dependency_roles": {
          "def-td-thermal-join": "formulation-prerequisite",
          "post-td-thermal-join-axioms": "operational-prerequisite"
        },
        "provenance": {
