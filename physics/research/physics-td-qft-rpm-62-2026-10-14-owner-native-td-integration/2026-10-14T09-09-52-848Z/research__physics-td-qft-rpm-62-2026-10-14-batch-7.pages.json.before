        },
        "dependency_level": 7
      },
      {
        "id": "post-td-thermal-join-axioms",
        "kind": "postulate",
        "domain": "physics",
        "title": "Thermal-contact axioms T1–T4",
        "statement": "Adopt T1–T4 for joining, reversible splitting, thermal-equilibrium transitivity and transversality.",
        "deps": [
          "def-td-thermal-join",
          "post-td-accessibility-a1-a6",
          "post-td-simple-system-geometric-axioms"
        ],
        "dependency_roles": {
