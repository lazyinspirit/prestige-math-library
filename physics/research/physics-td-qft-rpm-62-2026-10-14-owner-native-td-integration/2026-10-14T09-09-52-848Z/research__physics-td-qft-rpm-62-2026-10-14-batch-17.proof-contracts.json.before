        }
      ],
      "derivations": [
        {
          "id": "step-1-1",
          "claim": "If $G_1,G_2$ are disjoint bounded Borel sets, [F1] decomposes $D(P_{G_1\\cup G_2}\\Vert Q_{G_1}\\otimes Q_{G_2})$ into $D(P_{G_1}\\Vert Q_{G_1})$ plus the mean conditional relative entropy of $G_2$ given $G_1$. That conditional increment is at least $D(P_{G_2}\\Vert Q_{G_2})$ by the conditioning monotonicity in [F1], comparing observation by $G_1$ with no observation. Thus relative entropy is superadditive over disjoint regions; if the left side is infinite the inequality is immediate, and otherwise all terms in the chain rule are finite.",
          "step": "1.1",
          "inputs": [
            "A1",
            "F1",
            "algebra"
          ]
        },
        {
          "id": "step-2-1",
          "claim": "Fix an integer $m\\geq1$ and let $q_N=\\lfloor N/m\\rfloor$. Tile $[0,q_Nm)^d$ by $q_N^d$ disjoint translates of $\\Lambda_m$, leaving the Borel remainder $\\Lambda_N\\setminus[0,q_Nm)^d$. Iterating step 1.1 and using nonnegativity on the remainder gives $$D(P_{\\Lambda_N}\\Vert Q_{\\Lambda_N})\\geq q_N^dD(P_{\\Lambda_m}\\Vert Q_{\\Lambda_m}),$$ because stationarity gives the same entropy for each translated $m$-cube. If $D(P_{\\Lambda_m}\\Vert Q_{\\Lambda_m})=+\\infty$, this forces $D(P_{\\Lambda_N}\\Vert Q_{\\Lambda_N})=+\\infty$ for every $N\\geq m$.",
          "step": "2.1",
          "inputs": [
            "F1",
            "F2",
            "step 1.1",
            "construct"
          ]
        },
        {
          "id": "step-3-1",
          "claim": "Put $s=\\sup_{m\\geq1}m^{-d}D(P_{\\Lambda_m}\\Vert Q_{\\Lambda_m})$. If $s=+\\infty$, step 2.1 makes the liminf of $N^{-d}D_N$ exceed every finite bound, so the integer-cube limit is $+\\infty=s$. If $s<+\\infty$, step 2.1 gives $$\\liminf_{N\\to\\infty}N^{-d}D_N\\geq m^{-d}D(P_{\\Lambda_m}\\Vert Q_{\\Lambda_m})$$ for every $m$, since $q_N^d/N^d\\to m^{-d}$. Taking the supremum gives liminf at least $s$, while the definition of $s$ gives $N^{-d}D_N\\leq s$ for every integer $N$. Hence the integer-cube limit exists and equals $s$.",
          "step": "3.1",
          "inputs": [
            "step 2.1",
            "algebra"
          ]
        },
        {
          "id": "step-4-1",
          "claim": "For real $L\\to\\infty$, let $N=\\lfloor L\\rfloor$. The inclusions $\\Lambda_N\\subseteq\\Lambda_L\\subseteq\\Lambda_{N+1}$ and [F3] give $D_N\\leq D_L\\leq D_{N+1}$. Since $N/L\\to1$ and $(N+1)/L\\to1$, step 3.1 squeezes $L^{-d}D_L$ to the same extended limit $s$; if some integer-cube entropy is infinite, monotonicity gives the same conclusion directly.",
          "step": "4.1",
          "inputs": [
            "F2",
            "F3",
            "step 3.1",
            "algebra"
          ]
        },
        {
          "id": "step-5-1",
          "claim": "If $I(P)<\\infty$ and $A$ is bounded, choose an integer cube $\\Lambda_N+x$ containing $A$. Stationarity [F2] and restriction monotonicity [F3] give $$D(P_A\\Vert Q_A)\\leq D(P_{\\Lambda_N+x}\\Vert Q_{\\Lambda_N+x})=D(P_{\\Lambda_N}\\Vert Q_{\\Lambda_N})\\leq N^d I(P)<\\infty.$$ Thus every bounded restriction has finite relative entropy.",
          "step": "5.1",
          "inputs": [
            "F2",
            "F3",
            "step 3.1",
            "construct"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "checked",
          "evidence": "The statement allows any bounded Borel restriction; on the empty region the restrictions are the same one-point law and relative entropy is zero."
        },
        {
          "case": "zero",
          "status": "checked",
          "evidence": "The statement allows I(P)=0, including the reference law, and all lower bounds use only nonnegativity."
        },
        {
          "case": "one",
          "status": "checked",
          "evidence": "The statement includes the unit cube m=1 in its integer-cube supremum."
        },
        {
          "case": "degenerate",
          "status": "not_applicable",
          "reason": "No degeneracy, singular limit, or rank-drop case is part of the statement."
        },
        {
          "case": "endpoints",
          "status": "checked",
          "evidence": "The statement uses half-open cubes; the nested inclusions for real L are valid at integer endpoints and give the squeeze."
        },
        {
          "case": "nonempty-choice",
