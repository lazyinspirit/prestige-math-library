    "ex-td-transport-coefficient-model-input": {
      "citations": [
        {
          "fact": "F1",
          "source": "rem-td-transport-branch",
          "source_section": "Remark",
          "quote": "A Fourier heat-transport model may postulate\n\n$$\\mathbf j_Q(\\mathbf x,t)=-K(\\mathbf x,t)\\nabla T(\\mathbf x,t),$$\n\nwhere $\\mathbf j_Q:\\mathcal O\\times I\\to\\mathbb R^3$ is a continuous heat-energy flux field in $\\mathrm{W\\,m^{-2}}$ and $K:\\mathcal O\\times I\\to\\mathbb R^{3\\times3}$ is a declared conductivity tensor with units $\\mathrm{W\\,m^{-1}\\,K^{-1}}$. In an isotropic model $K=\\kappa I_3$ with $\\kappa\\ge0$. A diffusion model may separately postulate $\\mathbf j_n=-D\\nabla n$, where number density $n:\\mathcal O\\times I\\to[0,\\infty)$ is in $\\mathrm{m^{-3}}$, number flux $\\mathbf j_n:\\mathcal O\\times I\\to\\mathbb R^3$ is in $\\mathrm{m^{-2}\\,s^{-1}}$, and $D$ is a declared scalar or tensor in $\\mathrm{m^2\\,s^{-1}}$.",
          "uses": [
            "3.1"
          ]
        }
      ],
      "supplier_excerpts": [
        {
          "supplier": "rem-td-transport-branch",
          "carrier": "items/rem-td-transport-branch.md",
          "status": "Current draft carrier inspected; its status is preserved and no independent approval is claimed.",
          "source_section": "Remark",
          "exact_statement": "A Fourier heat-transport model may postulate\n\n$$\\mathbf j_Q(\\mathbf x,t)=-K(\\mathbf x,t)\\nabla T(\\mathbf x,t),$$\n\nwhere $\\mathbf j_Q:\\mathcal O\\times I\\to\\mathbb R^3$ is a continuous heat-energy flux field in $\\mathrm{W\\,m^{-2}}$ and $K:\\mathcal O\\times I\\to\\mathbb R^{3\\times3}$ is a declared conductivity tensor with units $\\mathrm{W\\,m^{-1}\\,K^{-1}}$. In an isotropic model $K=\\kappa I_3$ with $\\kappa\\ge0$. A diffusion model may separately postulate $\\mathbf j_n=-D\\nabla n$, where number density $n:\\mathcal O\\times I\\to[0,\\infty)$ is in $\\mathrm{m^{-3}}$, number flux $\\mathbf j_n:\\mathcal O\\times I\\to\\mathbb R^3$ is in $\\mathrm{m^{-2}\\,s^{-1}}$, and $D$ is a declared scalar or tensor in $\\mathrm{m^2\\,s^{-1}}$.",
          "supplier_proof_status": "draft remark inspected as a convention; no theorem proof claimed.",
          "consumer_use": "Facts & Assumptions F1 at 3.1."
        }
      ],
      "derivations": [
        {
          "id": "step-1-1",
