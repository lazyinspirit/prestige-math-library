      "derivations": [
        {
          "id": "step-1-1",
          "claim": "Under the finite-sector model [F4], units and time convention [F5], flow [F6], and both choice assumptions [A1], clause (a) of [F1] gives $s(\\rho(t))=s(\\rho(0))$ for every declared preparation and every real $t$. Multiplying by the fixed $k_{\\mathrm B}$ and using [F2] yields $S_{\\mathrm{vN}}(\\rho(t))=S_{\\mathrm{vN}}(\\rho(0))$. This proves conclusion 1.",
          "step": "1.1",
          "inputs": [
            "F1",
            "F2",
            "F4",
            "F5",
            "F6",
            "A1",
            "algebra"
          ]
        },
        {
          "id": "step-1-2",
          "claim": "Clause (b) of [F1] gives conclusion 2 under the same model and choice assumptions. The canonical preparation is an adopted premise of [F1]; its stationarity does not derive that preparation or a relaxation process.",
          "step": "1.2",
          "inputs": [
            "F1",
            "F4",
            "F5",
            "F6",
            "A1"
          ]
        },
        {
          "id": "step-2-1",
          "claim": "If $\\rho(t)=\\rho_\\beta$ for some $t$, then applying $U(t)^*$ on the left and $U(t)$ on the right, using [F7], gives $\\rho(0)=U(t)^*\\rho_\\beta U(t)$. Stationarity in step 1.2 at time $-t$ makes the right-hand side $\\rho_\\beta$. Thus $\\rho(0)\\ne\\rho_\\beta$ implies $\\rho(t)\\ne\\rho_\\beta$ for every real $t$, which is conclusion 3. By [F3] the invariant in step 1.1 is defined on density operators, while the macroscopic entropy is defined on equilibrium macrostates; [F8] also keeps the von Neumann entropy restricted to finite-dimensional sectors. None of the premises identifies those domains or supplies a bath or macroscopic relaxation law, so no monotonicity claim for $S_c$, bath relaxation, or thermalization follows.",
          "step": "2.1",
          "inputs": [
            "F3",
            "F7",
            "F8",
            "step 1.1",
            "step 1.2",
            "algebra"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "checked",
          "evidence": "The adopted normalized canonical preparation in the Statement is a declared density operator, so the empty-sector case is excluded; step 1.1 applies only to declared preparations."
        },
        {
          "case": "zero",
          "status": "checked",
          "evidence": "Pure preparations have zero dimensionless entropy by the entropy definition; step 1.1 preserves the full eigenvalue multiset, including zero eigenvalues."
        },
        {
          "case": "one",
          "status": "checked",
          "evidence": "The one-dimensional nonzero sector is covered by the universal finite-sector supplier in [F1]; step 1.1 preserves its sole eigenvalue and step 1.2 its canonical state."
        },
        {
          "case": "degenerate",
          "status": "checked",
          "evidence": "No nondegenerate-spectrum premise is added; the finite-sector theorem [F1] covers its declared self-adjoint generator, and step 1.2 uses its canonical spectral form."
        },
        {
          "case": "endpoints",
          "status": "checked",
          "evidence": "The conclusion quantifies over every real time, including t=0 and both signs; steps 1.1, 1.2, and 2.1 use that full domain."
        },
        {
          "case": "nonempty-choice",
          "status": "checked",
          "evidence": "The Axiom of Countable Choice and Axiom of Choice are explicit in [A1]; steps 1.1 and 1.2 retain them as exact supplier premises."
        },
        {
          "case": "iff-forward",
          "status": "not_applicable",
          "reason": "No biconditional is claimed; conclusion 3 is the one-way statement that a distinct initial preparation cannot evolve to the canonical one."
        },
        {
          "case": "iff-reverse",
          "status": "not_applicable",
          "reason": "No converse characterization is claimed; step 2.1 proves only the stated no-production implication."
        }
      ],
      "finite_smoke": [
        {
          "case": "finite-sector entropy conservation",
          "status": "checked",
