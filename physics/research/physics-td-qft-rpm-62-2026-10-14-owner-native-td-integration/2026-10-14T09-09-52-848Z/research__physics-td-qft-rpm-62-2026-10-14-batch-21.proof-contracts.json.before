        },
        {
          "case": "nonempty-choice",
          "status": "not_applicable",
          "reason": "The proof selects no element from a family of nonempty sets."
        },
        {
          "case": "iff-forward",
          "status": "not_applicable",
          "reason": "The Statement contains no biconditional requiring a forward-implication check."
        },
        {
          "case": "iff-reverse",
          "status": "not_applicable",
          "reason": "The Statement contains no biconditional requiring a reverse-implication check."
        }
      ],
      "finite_smoke": [
        {
          "case": "ideal positional gas",
          "status": "checked",
          "evidence": "For phi=0, Z(V,N)=V^N/N! and Xi_V=e^(zV) exactly; the physical pressure rate is z kBT/ell_0^d for every finite V."
        }
      ],
      "risk_review": {
        "status": "complete",
        "reviewer": "beta-batch-21 (author review)",
        "notes": "Checked the local conditional argument, physical units and stated regime. Mathematical supplier statements remain draft. The latest scoped proof-contract check for the 12 direct mathematics suppliers passes; none of the 21 batch-18 items has a Step 1 decision. This author review is not independent approval."
