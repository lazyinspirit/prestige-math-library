          "planned_proof_status": "complete exact stated argument",
          "planned_scope": "Given smooth Lorentz metric and m,c>0: rank-three Hessian, positive-ray fibres, embedded future shell, psharp=mcV/s.",
          "math_physics_issue": "Domain mathematics with direct dependency def-rpm-h-background-and-model-quantities in domain physics.",
          "readiness_reason": "A current run-scoped Step 1 ready record exists with a hash-current input closure; the supplier still has status draft and no pipeline_run binding, and this record is not independent proof approval.",
          "manifest_page": "rpm-hamiltonian-constraints",
