          "current_carrier": "items/thm-rpm-h-inertial-time-reduced-hamiltonian.md",
          "actual_kind": "theorem",
          "actual_sha256": "939f7b961649d12c98641fcbbcc1eb5bda85b3a9d07f9681ca1eaf1ef44e3ea0",
          "actual_source_section": "Statement",
