          ]
        },
        {
          "fact": "L1",
          "source": "thm-rpm-h-poincare-moment-map-and-algebra",
          "source_section": "Statement",
          "quote": "Assume $\\mathrm{AC}_\\omega$. For the group and cotangent conventions of [[def-rpm-h-poincare-charge-space]], the map $\\mu:T^*\\mathbb R^4\\to\\mathfrak g^*$ defined by $\\langle\\mu(x,p",
          "uses": [
            "1.1",
