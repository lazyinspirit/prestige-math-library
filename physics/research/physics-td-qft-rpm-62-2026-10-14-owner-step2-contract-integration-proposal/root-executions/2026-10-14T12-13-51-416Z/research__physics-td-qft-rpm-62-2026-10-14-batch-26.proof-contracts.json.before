      ],
      "dependency_drift": false,
      "batch_page_count": 22,
      "current_run_binding": "No pipeline_run metadata or Step 1 decision binds the draft item to the active run; it is listed in H25 only as a draft.",
      "current_carrier": "items/thm-rpm-h-homogeneous-legendre-degeneracy.md",
      "actual_kind": "theorem",
      "actual_sha256": "b34a31e5d6754d63abaf88477313de818af587564df4300f3b228278f7fe888f",
      "actual_source_section": "Statement"
    },
    "thm-rpm-h-homogeneous-massive-shell": {
      "supplier": "thm-rpm-h-homogeneous-massive-shell",
      "status": "draft_unbound",
      "actual_file": "items/thm-rpm-h-homogeneous-massive-shell.md",
      "actual_status": "draft",
      "actual_pipeline_run": "absent",
      "actual_frontmatter_parseable": true,
      "actual_domain": "mathematics",
      "actual_proof_provenance": "ai-altered",
      "actual_section": "Statement",
      "actual_statement_excerpt": "Let $(M,g,T)$ be a smooth time-oriented Lorentzian four-manifold, $m>0$, and $L(x,V)=-mc\\sqrt{-g(V,V)}$ on the future timelike tangent cone. Its fibre derivative is\n\n$$p_a=mc\\frac{g_{ab}V^b}{s},\\qquad s=\\sqrt{-g(V,V)}>0.$$\n\nThe velocity Hessian is $mc(g_{ab}/s+V_aV_b/s^3)$, has kernel exactly $\\mathbb RV$, and rank three. The image consists exactly of the future shell $\\Sigma_m^+=\\{g^{-1}(p,p)=-m^2c^2,\\ p^\\sharp\\text{ future}\\}$$. Each fibre is a connected positive ray, and the Legendre map is a surjective submersion onto this embedded image. Its energy $p(V)-L$ is zero; the map has no local inverse in the four-velocity direction.",
      "actual_dependencies": [
        "def-countable-choice",
        "def-rpm-h-background-and-model-quantities",
        "def-rpm-spacetime-observer-and-worldline",
        "def-rpm-h-cotangent-phase-space",
