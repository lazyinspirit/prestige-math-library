          "current_carrier": "items/thm-rpm-h-homogeneous-massive-shell.md",
          "actual_kind": "theorem",
          "actual_sha256": "a3102e26b1e19a79fb00ce48c3979f4cc73ac4ab74bfa0f07d9be165b5346045",
          "actual_source_section": "Statement",
