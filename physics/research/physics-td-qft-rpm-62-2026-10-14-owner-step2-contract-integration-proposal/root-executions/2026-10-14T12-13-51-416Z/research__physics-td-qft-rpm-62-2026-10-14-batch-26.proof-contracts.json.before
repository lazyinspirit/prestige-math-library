          "current_carrier": "items/def-rpm-h-regular-constraint-system.md",
          "actual_kind": "definition",
          "actual_sha256": "9b5e14864572415ddc276275e20e011072ea7921034966044f59848634d270eb",
          "actual_source_section": "Definition",
