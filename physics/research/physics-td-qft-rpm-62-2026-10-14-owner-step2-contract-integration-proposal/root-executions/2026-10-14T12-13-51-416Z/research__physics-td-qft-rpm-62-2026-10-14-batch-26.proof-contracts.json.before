          "dependency_drift": false,
          "batch_page_count": 22,
          "current_run_binding": "A current physics-td-qft-rpm-62-2026-10-14 Step 1 record binds the supplier input hash, but the item frontmatter has no pipeline_run field; the readiness record is not independent proof approval.",
          "current_carrier": "items/def-rpm-h-background-and-model-quantities.md",
          "actual_kind": "definition",
          "actual_sha256": "2ce9d9ec0c45ef9277632981ec37d6ad3948cb9a60abe93ba6f8ee3b5fef29f3",
          "actual_source_section": "Definition",
