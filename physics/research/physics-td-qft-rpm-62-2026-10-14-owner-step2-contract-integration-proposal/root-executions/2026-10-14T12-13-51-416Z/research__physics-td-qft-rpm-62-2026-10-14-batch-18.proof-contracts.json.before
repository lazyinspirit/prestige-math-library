      "external_sources": {
        "L1": {
          "title": "H.-O. Georgii, Large deviations and the equivalence of ensembles for Gibbsian particle systems with superstable interaction",
          "url": "https://www.mathematik.uni-muenchen.de/~georgii/papers/LDPsuperstable.pdf",
          "source_section": "Theorem 2, Section 3, printed pp.174–176 / PDF pp.4–6; complete proof in Sections 4–5.",
          "source_statement": "For a superstable regular interaction and z,β>0, the periodic grand-canonical distribution obeys a good large-deviation principle for the periodized empirical field, with zero set equal to the stationary variational minimizers.",
          "uses": [
            "4.1"
          ]
        }
      }
    },
    "ex-tdmath-hard-core-zero-beta": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-tdmath-superstable-regular-interaction",
          "source_section": "Definition",
          "quote": "With fixed numerical length and energy units, the canonical positional partition is\n$$Z(L,N;\\beta)=\\frac1{N!}\\int_{\\Lambda_L^N}e^{-\\beta H_\\phi(q_1,\\ldots,q_N)}dq_1\\cdots dq_N,\\quad Z(L,0;\\beta)=1,$$\nwhere $\\beta>0$, and the grand partition is $\\Xi(L;a,\\beta)=\\sum_{N\\geq0}a^NZ(L,N;\\beta)$ for numerical activity $a>0$.",
          "uses": [
            "1.1",
            "2.1"
          ]
        },
        {
          "fact": "F2",
          "source": "thm-tdmath-retained-hard-zero-beta-limit",
          "source_section": "Statement",
          "quote": "Define the zero-inverse-temperature-parameter continuation (the mathematical $\\beta=0$ branch) to be $z^{N(\\omega)}\\mathbf 1_{\\rm admissible}(\\omega)$, explicitly retaining the hard exclusion.",
          "uses": [
            "1.1",
            "2.1"
          ]
        },
        {
          "fact": "F3",
          "source": "def-product-measure-on-sigma-finite-spaces",
          "source_section": "Definition",
          "quote": "This is the\n**product measure** of $\\mu$ and $\\nu$.",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F3",
          "source": "thm-lebesgue-measure-of-a-box-of-every-kind",
          "source_section": "Statement",
          "quote": "In particular this covers the four one-dimensional face conventions in each\ncoordinate — the open box, the closed box $[a,b]$, the half-open box\n$B(a,b) = \\prod_{i<n}(a_i,b_i]$ of [[def-half-open-box]], and every mixture of\nthem, in any combination of coordinates — and it gives measure $0$ to all of them\nwhenever $a_i = b_i$ for some $i<n$.",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F3",
          "source": "thm-sigma-finite-product-measure-exists-is-rectangular-and-is-unique",
          "source_section": "Statement",
          "quote": "1. the set function $E \\mapsto (\\mu \\times \\nu)(E)$ of\n   [[def-product-measure-on-sigma-finite-spaces]] is a measure on\n   $\\mathcal A \\otimes \\mathcal B$;\n2. for measurable rectangles,\n   $$(\\mu \\times \\nu)(A \\times B)=\\mu(A)\\nu(B),$$\n   with the nonnegative extended-product convention $0\\cdot\\infty=\\infty\\cdot0=0$;\n3. the measure $\\mu \\times \\nu$ is sigma-finite; and\n4. it is the unique measure on $\\mathcal A \\otimes \\mathcal B$ with the\n   rectangle formula.",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F3",
          "source": "thm-tonelli-theorem-for-sigma-finite-product-spaces",
          "source_section": "Statement",
          "quote": "Let $(X,\\mathcal A,\\mu)$ and $(Y,\\mathcal B,\\nu)$ be sigma-finite measure\nspaces, and let $f : X \\times Y \\to [0,\\infty]$ be product-measurable.",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F4",
          "source": "def-factorial-and-falling-factorial",
          "source_section": "Definition",
          "quote": "**The factorial.** By the recursion theorem ([[thm-recursion]]) applied to the\nset $\\mathbb{N}\\times\\mathbb{N}$, the starting element $(0,1)$ and the function\n$f(k, v) = (\\sigma(k),\\, v \\cdot \\sigma(k))$, and by the same induction on the\nfirst coordinate as in [[def-nat-finite-sum-and-product]], there is a unique\n$F : \\mathbb{N} \\to \\mathbb{N}$ with",
          "uses": [
            "1.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "proof-step-1-1",
          "claim": "On the ordered region $x_1<x_2$, allowed pairs satisfy $x_2\\geq x_1+a$, so their volume is $\\int_0^{L-a}(L-x_1-a)\\,dx_1=(L-a)^2/2$. The coordinate-swap map preserves product Lebesgue measure, so the region $x_2<x_1$ has the same volume; the diagonal has zero product measure. Thus the full labeled allowed volume is $(L-a)^2$, and division by $2!$ gives $Z(L,2;0)=(L-a)^2/2$.",
          "step": "1.1",
          "inputs": [
            "F1",
            "F2",
            "F3",
            "F4"
          ]
        },
        {
          "id": "proof-step-2-1",
          "claim": "Since $0<a<L$, $(L-a)^2/2<L^2/2$, the unrestricted ideal-gas two-particle canonical term. The strict deficit is caused by the forbidden separation band and remains at beta zero by [F2].",
          "step": "2.1",
          "inputs": [
            "F2",
            "F1",
            "step 1.1"
          ]
        }
      ],
      "routine_steps": [],
      "finite_checks": [
        {
          "name": "two-particle hard-core deficit",
          "inputs": [
            "F1",
            "F2",
            "F3",
            "F4",
            "step 1.1",
            "step 2.1"
          ],
          "expected": "For a=1 and L=3, Z(3,2;0)=(3-1)^2/2=2, while the unrestricted ideal-gas term is 3^2/2=4.5; the strict deficit remains at beta=0."
        }
      ],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "In one spatial dimension, let $\\phi(x)=+\\infty$ for $|x|<a$ and $0$ otherwise, with $a>0$. Boundary empty: The Statement has no empty-configuration branch; its claim concerns the displayed positive-volume, density, or conditional regime.",
          "case_scope": {
            "source_section": "Example",
            "source_excerpt": "In one spatial dimension, let $\\phi(x)=+\\infty$ for $|x|<a$ and $0$ otherwise, with $a>0$. On an interval $[0,L]$, define the beta-zero weight by retaining the forbidden-pair exclusion as in [[thm-tdmath-retained-hard-zero-beta-limit]]. If $L>a$, the two-particle canonical partition is\n$$Z(L,2;0)=\\frac{(L-a)^2}{2},$$\nwhile the unrestricted ideal-gas value is $L^2/2$. Thus the retained hard-core beta-zero ensemble is not the Poisson ideal gas.",
            "current_raw_sha256": "3eb8608b6447fae77e3e9df96a943ed30f9e93f5999598a5150d2b9958594c8f",
            "scope_only_not_proof_acceptance": true
          }
