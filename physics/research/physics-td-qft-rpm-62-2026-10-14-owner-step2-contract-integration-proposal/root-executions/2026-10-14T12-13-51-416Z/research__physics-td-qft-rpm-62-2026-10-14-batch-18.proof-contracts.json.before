      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "For a bounded set $\\Omega\\subset\\mathbb R^d$ and $R>0$, define its two-sided boundary layer\n$$\\partial_R\\Omega=\\{x\\in\\mathbb R^d:\\operatorname{dist}(x,\\partial\\Omega)\\leq R\\},$$\nwhere distance is Euclidean distance and $|\\cdot|$ denotes $d$-dimensional Lebesgue measure. Boundary empty: This definition requires positive-volume input and states no empty-object theorem.",
          "case_scope": {
            "source_section": "Definition",
            "source_excerpt": "For a bounded set $\\Omega\\subset\\mathbb R^d$ and $R>0$, define its two-sided boundary layer\n$$\\partial_R\\Omega=\\{x\\in\\mathbb R^d:\\operatorname{dist}(x,\\partial\\Omega)\\leq R\\},$$\nwhere distance is Euclidean distance and $|\\cdot|$ denotes $d$-dimensional Lebesgue measure. A van Hove sequence is a sequence of bounded Lebesgue measurable sets $(\\Omega_k)_{k\\geq1}$ with $0<|\\Omega_k|<\\infty$, $|\\Omega_k|\\to\\infty$, and\n$$\\frac{|\\partial_R\\Omega_k|}{|\\Omega_k|}\\longrightarrow0\\qquad\\text{for every fixed }R>0.$$\nThe condition controls both inner and outer boundary neighborhoods. It does not impose connectedness, a bounded aspect ratio, smooth boundaries, or a periodic identification.",
            "current_raw_sha256": "bb1e6c57afcbefa0537497ff9b640f6d018e5f74d9f465e3d7c48b819637967c",
            "scope_only_not_proof_acceptance": true
          }
        },
        {
