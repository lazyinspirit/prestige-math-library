      "external_sources": {
        "L1": {
          "title": "H.-O. Georgii, Large deviations and the equivalence of ensembles for Gibbsian particle systems with superstable interaction",
          "url": "https://www.mathematik.uni-muenchen.de/~georgii/papers/LDPsuperstable.pdf",
          "source_section": "Theorem 2, Section 3 and equations (2.20)–(2.22), printed pp.174–176 / PDF pp.4–6; complete proof in Sections 4–5.",
          "source_statement": "For a superstable regular interaction, the periodized empirical fields under either free or periodic grand-canonical Gibbs law satisfy a good large-deviation principle in the local topology with rate I(P)+βΦ(P)−ρ(P)log z+p_Q(z,β).",
          "uses": [
            "1.2"
          ]
        }
      }
