    "lem-tdmath-superstable-cell-energy-bound": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-tdmath-superstable-regular-interaction",
          "source_section": "Definition",
          "quote": "It is superstable in the Georgii splitting convention if $\\phi=\\phi_s+\\phi_r$, where $\\phi_s$ is stable and $\\phi_r\\geq0$ everywhere and, for some $r_0,\\delta>0$, $\\phi_r(x)\\geq\\delta$ whenever $|x|_\\infty\\leq r_0$.",
          "uses": [
            "1.1",
            "2.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "proof-step-1-1",
          "claim": "Choose an integer $k\\geq1$ with $1/k\\leq r_0$. Partition each unit cell $C_i$ into $k^d$ half-open subcubes of side $1/k$, and denote their occupancies by $n_{i,j}$, $1\\leq j\\leq k^d$. Distinct points in one subcube have $|x-y|_\\infty<1/k\\leq r_0$, so their repulsive pair energy is at least $\\delta$. Therefore\n$$H_{\\phi_r}(\\omega)\\geq\\frac{\\delta}{2}\\sum_{i,j}n_{i,j}(n_{i,j}-1).$$\nWriting $\\bar n=N_{C_i}(\\omega)/k^d$, nonnegativity of $\\sum_j(n_{i,j}-\\bar n)^2$ expands to $\\sum_j n_{i,j}^2\\geq N_{C_i}(\\omega)^2/k^d$, and $\\sum_{i,j}n_{i,j}=N(\\omega)$. Thus $H_{\\phi_r}(\\omega)\\geq\\frac{\\delta}{2k^d}\\sum_iN_{C_i}^2-\\frac\\delta2N$.",
          "step": "1.1",
          "inputs": [
            "F1"
          ]
        },
        {
          "id": "proof-step-2-1",
          "claim": "The stable part obeys $H_{\\phi_s}(\\omega)\\geq-B_sN$. Add this inequality to step 1.1 and take $A=\\delta/(2k^d)$ and $B=B_s+\\delta/2$. This proves the cell-quadratic bound. If any term is $+\\infty$, the inequality holds in the extended order; otherwise all sums are finite.",
          "step": "2.1",
          "inputs": [
            "F1",
            "step 1.1"
          ]
        }
      ],
      "routine_steps": [],
      "finite_checks": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "checked",
          "evidence": "Statement with N=0 every cell count is zero and H_0=0, so the displayed bound reads zero>=zero. The proof grid has positive finite cell parameters from delta,r_0>0.",
          "case_scope": {
            "source_section": "Statement",
            "source_excerpt": "Let $\\phi=\\phi_s+\\phi_r$ be superstable in the splitting convention of [[def-tdmath-superstable-regular-interaction]]. Suppose $H_{\\phi_s}(\\omega)\\geq-B_sN(\\omega)$ and $\\phi_r(x)\\geq\\delta>0$ for $|x|_\\infty\\leq r_0$, with $\\phi_r\\geq0$ elsewhere. For the unit cells $C_i=i+[0,1)^d$, there are constants $A>0$ and $B\\geq0$ such that every finite configuration satisfies\n$$H_\\phi(\\omega)\\geq A\\sum_{i\\in\\mathbb Z^d}N_{C_i}(\\omega)^2-BN(\\omega).$$\nOnly finitely many summands are nonzero. This is the cell form used in the continuum pressure arguments.",
            "current_raw_sha256": "2bd0b076da82ffb7ccb1a9db8e7a0b335848e7b6bf7d3dfdbd5e6d457afbc53d",
            "scope_only_not_proof_acceptance": true
          }
        },
        {
          "case": "zero",
          "status": "checked",
          "evidence": "Statement delta,r_0>0 give a positive subdivision constant and A>0. Vanishing particle counts give zero contributions and are not denominators; the cube-grid reciprocal is a positive integer-grid factor.",
          "case_scope": {
