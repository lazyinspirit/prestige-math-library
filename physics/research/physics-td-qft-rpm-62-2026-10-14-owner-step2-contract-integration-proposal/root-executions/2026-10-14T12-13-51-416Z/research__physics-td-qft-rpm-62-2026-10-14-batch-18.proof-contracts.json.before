      ],
      "derivations": [
        {
          "id": "proof-step-1-1",
          "claim": "The $N$-particle term without the field is $z^NV^N/N!$, by the product volume [F1] and the $1/N!$ convention [given]. Summing over $N\\geq0$ gives $\\Xi_0=\\sum_N(zV)^N/N!=e^{zV}$ by [F2].",
          "step": "1.1",
          "inputs": [
            "F1",
            "F2",
            "A1"
          ]
        },
        {
          "id": "proof-step-2-1",
          "claim": "With the field, each term is multiplied by $e^{-\\beta cN}$, so $\\Xi_c=\\sum_N(ze^{-\\beta c}V)^N/N!=e^{ze^{-\\beta c}V}$ by [F2]. Therefore $V^{-1}\\log\\Xi_0=z$ and $V^{-1}\\log\\Xi_c=ze^{-\\beta c}$. If $c\\ne0$, these differ because $z,\\beta>0$.",
          "step": "2.1",
          "inputs": [
            "F2",
            "A1",
            "step 1.1"
          ]
        }
      ],
      "routine_steps": [],
      "finite_checks": [
        {
          "name": "unit-volume bulk field",
          "inputs": [
            "A1",
            "F1",
            "F2",
            "step 1.1",
            "step 2.1"
          ],
          "expected": "For V=1, z=1, beta=1 and c=log(2), Xi_0=e and Xi_c=e^(1/2), so the pressures per volume are 1 and 1/2."
        }
      ],
      "boundaries": [
