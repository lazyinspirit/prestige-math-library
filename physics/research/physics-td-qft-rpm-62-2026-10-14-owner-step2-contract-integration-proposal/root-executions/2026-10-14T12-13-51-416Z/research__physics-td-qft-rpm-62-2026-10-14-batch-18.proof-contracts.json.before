      ],
      "derivations": [
        {
          "id": "proof-step-1-1",
          "claim": "Since $\\rho$ is interior and $F_\\beta$ is finite and concave there by [F1], it has a finite supporting slope $\\alpha$ at $\\rho$. Put $z=e^\\alpha>0$.",
          "step": "1.1",
          "inputs": [
            "F1"
          ]
        },
        {
          "id": "proof-step-2-1",
          "claim": "The free exact-$N$ rate hypothesis of [F5] is exactly [F1], and [F2] supplies its supporting activity. The normalized/physical pressure conversion in [F3] is the equality required by [F5]; the empirical field is the stationary one in [F4]. Applying [F5] with free boundary gives concentration on $\\mathcal M_{z,\\beta}$ in every open $\\tau_L$ neighborhood.",
          "step": "2.1",
          "inputs": [
            "F5",
            "F1",
            "F2",
            "F3",
            "F4",
            "step 1.1"
          ]
        },
        {
          "id": "proof-step-3-1",
          "claim": "If the minimizer set is the singleton $\\{P_*\\}$, every open neighborhood of $P_*$ is a neighborhood of the full set. Step 2.1 therefore gives $C_{L,N_L}(R_{L,\\omega}\\notin U)\\to0$ for every open $U\\ni P_*$, which is convergence in probability in $\\tau_L$.",
          "step": "3.1",
          "inputs": [
            "F5",
            "step 2.1"
          ]
        }
      ],
      "routine_steps": [],
      "finite_checks": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "Assume the superstable regular model of [[thm-tdmath-continuum-variational-pressure]], $\\beta>0$, and an interior attainable density $\\rho>0$. Boundary empty: The Statement has no empty-configuration branch; its claim concerns the displayed positive-volume, density, or conditional regime.",
          "case_scope": {
            "source_section": "Statement",
            "source_excerpt": "Assume the superstable regular model of [[thm-tdmath-continuum-variational-pressure]], $\\beta>0$, and an interior attainable density $\\rho>0$. Let $N_L/L^d\\to\\rho$, let $C_{L,N_L}$ be the free-boundary positional canonical law with exactly $N_L$ particles, and let $R_{L,\\omega}$ be its periodized empirical field from [[def-tdmath-periodized-empirical-field]]. Choose any finite supporting activity $z>0$ of $F_\\beta$ at $\\rho$ and set\n$$\\mathcal M_{z,\\beta}:=\\operatorname*{argmin}_{P\\in\\mathcal P^1_{\\rm stat}}\\{I(P)+\\beta\\Phi(P)-\\rho(P)\\log z\\}.$$\nFor every open $\\tau_L$ neighborhood $U$ of $\\mathcal M_{z,\\beta}$,\n$$C_{L,N_L}\\{\\omega:R_{L,\\omega}\\in U\\}\\longrightarrow1.$$\nIf $\\mathcal M_{z,\\beta}=\\{P_*\\}$, then $R_{L,\\omega}\\to P_*$ in probability in $\\tau_L$. This is local observable equivalence for a uniformly sampled bulk location; it makes no claim about the raw finite-box law at a fixed origin or about uniqueness for every interaction.",
            "current_raw_sha256": "8a16c46063ddd6de57a69457713ef5c514075b85984c4898ab68fb4d8b2f4727",
            "scope_only_not_proof_acceptance": true
          }
        },
