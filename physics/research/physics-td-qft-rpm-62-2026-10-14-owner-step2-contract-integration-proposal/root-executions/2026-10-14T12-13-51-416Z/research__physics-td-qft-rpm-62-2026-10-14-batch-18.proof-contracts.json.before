      "external_sources": {
        "L1": {
          "title": "H.-O. Georgii, Large deviations and the equivalence of ensembles for Gibbsian particle systems with superstable interaction",
          "url": "https://www.mathematik.uni-muenchen.de/~georgii/papers/LDPsuperstable.pdf",
          "source_section": "Lemma 4.3, Section 4, printed p.183 / PDF p.13.",
          "source_statement": "For all n≥0 and k>r(φ), the difference between H_n and H_{n+k,per} is bounded by 2dδ_kT_n on the finite-configuration space.",
          "uses": [
            "1.2"
          ]
        }
      }
    },
    "thm-tdmath-controlled-shell-three-ensemble-equivalence": {
      "citations": [
        {
          "fact": "F1",
          "source": "thm-tdmath-periodic-fixed-n-limit",
          "source_section": "Statement",
          "quote": "For any finite supporting activity $z>0$ of $F_\\beta$ at $\\rho$, these empirical fields concentrate in every open $\\tau_L$ neighborhood of the minimizer set of $I+\\beta\\Phi-\\rho\\log z$.",
          "uses": [
            "1.1",
            "3.1"
          ]
        },
        {
          "fact": "F2",
          "source": "thm-tdmath-fixed-n-local-ensemble-equivalence",
          "source_section": "Statement",
          "quote": "Let $N_L/L^d\\to\\rho$, let $C_{L,N_L}$ be the free-boundary positional canonical law with exactly $N_L$ particles, and let $R_{L,\\omega}$ be its periodized empirical field from [[def-tdmath-periodized-empirical-field]].",
          "uses": [
            "4.1"
          ]
        },
        {
          "fact": "F3",
          "source": "thm-tdmath-continuum-variational-pressure",
          "source_section": "Statement",
          "quote": "For free and periodic cubes define\n$$Z_{L,z,\\beta,bc}=E_{Q_{\\Lambda_L}}\\!\\left[z^{N_{\\Lambda_L}}e^{-\\beta H_{L,bc}}\\right],\\qquad bc\\in\\{\\mathrm{free},\\mathrm{per}\\}.$$\nThen the limit $p_Q(z,\\beta)=\\lim_{L\\to\\infty}L^{-d}\\log Z_{L,z,\\beta,bc}$ exists, is independent of $bc$, and\n$$p_Q(z,\\beta)=-\\min_{P\\in\\mathcal P^1_{\\rm stat}}\\{I(P)+\\beta\\Phi(P)-\\rho(P)\\log z\\}.$$\nThe minimizer set is nonempty and compact in the local-tame topology $\\tau_L$.",
          "uses": [
            "4.1"
          ]
        },
        {
          "fact": "F4",
          "source": "def-tdmath-periodized-empirical-field",
          "source_section": "Definition",
          "quote": "Define its **periodized empirical field**\n$$R_{L,\\omega}:=\\frac1{L^d}\\int_{\\Lambda_L}\\delta_{T_x\\omega^{(L)}}\\,dx.$$\nThe integral is the push-forward of normalized Lebesgue measure on $\\Lambda_L$ under $x\\mapsto T_x\\omega^{(L)}$.",
          "uses": [
            "3.1",
            "4.1"
          ]
        },
        {
          "fact": "F4",
          "source": "lem-tdmath-periodized-empirical-field-stationary-density",
          "source_section": "Statement",
          "quote": "For $L>0$ and a finite configuration $\\omega\\subset\\Lambda_L$ with $N(\\omega)=N$, the measure $R_{L,\\omega}$ of [[def-tdmath-periodized-empirical-field]] is a stationary probability law of finite intensity and\n$$\\rho(R_{L,\\omega})=\\frac{N}{L^d}.$$\nFor any probability law $C_L$ on finite configurations in $\\Lambda_L$ with $E_{C_L}N<\\infty$, its empirical-field barycenter $\\bar C_L$ is also a stationary probability law of finite intensity and $\\rho(\\bar C_L)=E_{C_L}N/L^d$.",
          "uses": [
            "3.1",
            "4.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "proof-step-1-1",
          "claim": "Let $C_L$ be the periodic exact-$N_L$ canonical law. For $|t|<\\beta$, $$ E_{C_L}e^{tH_{\\mathrm{per}}} =Z_{\\mathrm{per}}(L,N_L;\\beta-t)/Z_{\\mathrm{per}}(L,N_L;\\beta). $$ By [F1], the normalized log moment generating function converges to $F_{\\beta-t}(\\rho)-F_\\beta(\\rho)$, whose derivative at zero is $e$. For any fixed $\\epsilon>0$, choose small positive and negative $t$ so the Chernoff exponents for $H/L^d\\geq e+\\epsilon$ and $H/L^d\\leq e-\\epsilon$ are strictly negative. Hence the canonical probability outside the fixed $\\epsilon$-window tends to zero.",
          "step": "1.1",
          "inputs": [
            "F1"
          ]
        },
        {
          "id": "proof-step-2-1",
          "claim": "Choose increasing thresholds $L_k$ so that for every $L\\geq L_k$ the probability outside the $1/k$ window is at most $1/k$. Set $k(L)=\\max\\{k:L_k\\leq L\\}$ and $\\delta_L=1/k(L)$. Then $\\delta_L\\downarrow0$ and the canonical probability of the selected shell tends to one. Positivity of the canonical weight on the shell implies positive Poisson reference measure, so the shell law is defined eventually.",
          "step": "2.1",
          "inputs": [
            "step 1.1"
          ]
        },
        {
          "id": "proof-step-3-1",
          "claim": "Let $U$ be any open $\\tau_L$ neighborhood of $P_*$ and let $S_L$ be the selected shell event. On $S_L$, the periodic canonical density relative to the uniform positional law lies between $e^{-\\beta L^d(e+\\delta_L)}$ and $e^{-\\beta L^d(e-\\delta_L)}$. Hence\n$$Q_{\\Lambda_L}(R_{L,\\omega}\\notin U\\mid S_L)\\leq\\frac{e^{2\\beta\\delta_L L^d}}{C_L^{\\mathrm{per}}(S_L)}\\,C_L^{\\mathrm{per}}(R_{L,\\omega}\\notin U).$$\nBy step 2.1, $C_L^{\\mathrm{per}}(S_L)\\to1$. By [F1], the last probability has a strictly negative exponential rate. Since $\\delta_L\\to0$, the right side tends to zero. Thus the uniform shell empirical field converges in probability to $P_*$.",
          "step": "3.1",
          "inputs": [
            "F1",
            "F4",
            "step 2.1"
          ]
        },
        {
          "id": "proof-step-4-1",
          "claim": "The free exact-$N$ empirical field converges in probability by [F2]. The periodic grand empirical fields obey the good LDP [L1]; its unique zero is $P_*$ by [F3], so the probability outside each neighborhood of $P_*$ tends to zero. Together with steps 2.1 and 3.1, this proves the stated three-ensemble conclusion.",
          "step": "4.1",
          "inputs": [
            "F2",
            "L1",
            "F3",
            "F4",
            "step 2.1",
            "step 3.1"
          ]
        }
      ],
      "routine_steps": [],
      "finite_checks": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "Assume the superstable regular model of [[thm-tdmath-periodic-fixed-n-limit]], an interior density $N_L/L^d\\to\\rho$, and differentiability of $\\beta\\mapsto F_\\beta(\\rho)$ at $\\beta>0$. Boundary empty: The Statement has no empty-configuration branch; its claim concerns the displayed positive-volume, density, or conditional regime.",
          "case_scope": {
            "source_section": "Statement",
            "source_excerpt": "Assume the superstable regular model of [[thm-tdmath-periodic-fixed-n-limit]], an interior density $N_L/L^d\\to\\rho$, and differentiability of $\\beta\\mapsto F_\\beta(\\rho)$ at $\\beta>0$. Put $e=-\\partial_\\beta F_\\beta(\\rho)$. Suppose the grand variational minimizer at a supporting activity $z>0$ is a singleton $P_*$. Let $R_{L,\\omega}$ be the periodized empirical field of [[def-tdmath-periodized-empirical-field]]. There exists a specified sequence $\\delta_L\\downarrow0$ such that the uniform positional shell law\n$$Q_{\\Lambda_L}\\!\\left(\\,\\cdot\\ \\middle|\\ N=N_L,\\ \\left|H_{L,\\mathrm{per}}/L^d-e\\right|\\leq\\delta_L\\right)$$\nis eventually defined, and its empirical field converges in probability in $\\tau_L$ to $P_*$. The free and periodic exact-$N$ canonical empirical fields and the matching periodic grand-canonical empirical field converge in probability to the same limit. The energy width $2\\delta_LL^d=o(L^d)$; no arbitrary prescribed width or zero-width surface measure is asserted.",
            "current_raw_sha256": "b2e80903e7a373e5956a8cb5078ec151e55aea1a01b72ea0b0321a1211a9189b",
            "scope_only_not_proof_acceptance": true
          }
        },
