        ],
        "dependency_roles": {
          "def-rpm-body-moments": "formulation-prerequisite",
          "lem-rpm-td-local-closure": "mathematical-premise",
          "post-rpm-mpd-truncation": "physical-assumption"
        },
        "statement": "Adopt the neutral pole-dipole equations and local body moments of [[post-rpm-mpd-truncation]] and [[def-rpm-body-moments]]. Suppose a solution satisfies the TD condition $S^{ab}p_b=0$, with future timelike $p$, and remains in the local admissible region of [[lem-rpm-td-local-closure]] where $K$ is invertible and $W=K^{-1}p$ is future timelike. Then, on its local interval of existence,\n$$\\mu:=\\sqrt{-g(p,p)}\\quad\\text{and}\\quad \\frac12S_{ab}S^{ab}$$\nare constant. If the initial spin tensor is zero, it remains zero and the solution obeys\n$$p=\\frac{\\mu}{c}U,\\qquad D_\\tau p=0,\\qquad D_\\tau U=0,$$\nso the representative curve is a timelike geodesic with constant rest mass $M=\\mu/c$. The claims stop if the local TD admissible region ends; no global extension follows.",
        "strategy": "direct",
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
