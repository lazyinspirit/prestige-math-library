        "id": "pthm-rpm-spherical-charge-size-bound",
        "kind": "physics-theorem",
        "domain": "physics",
        "library": "physics",
        "title": "Spherical charge exterior-energy size bound",
        "reference": "items/pthm-rpm-spherical-charge-size-bound.md#Statement",
        "design_state": "Draft carrier authored in assigned batch; independent review remains pending.",
        "dependency_level": 3,
        "deps": [
