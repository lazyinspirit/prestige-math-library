        "dependency_roles": {
          "def-em-vacuum-energy-flux": "formulation-prerequisite",
          "def-em-si-conventions": "formulation-prerequisite",
          "def-rpm-body-moments": "formulation-prerequisite",
          "pthm-em-coulomb-solution": "physical-result",
          "pthm-em-point-self-energy-divergence": "physical-result"
        },
        "statement": "Let an extended static spherical charged body have radius $\\ell>0$ metres, total charge $q\\in\\mathbb R$ coulombs, and finite total rest energy $Mc^2$ with $M>0$ kilograms. Use the flat-body moment convention of [[def-rpm-body-moments]] in its rest frame and the SI constants of [[def-em-si-conventions]], including $c$ in metres per second and $\\varepsilon_0>0$. Its vacuum exterior field is assumed to be exactly\n$$\\mathbf E(r)=\\frac{q}{4\\pi\\varepsilon_0r^2}\\widehat{\\mathbf r},\\qquad \\mathbf B=0,\\qquad r\\ge\\ell.$$\nLet $u$ be the vacuum energy density of [[def-em-vacuum-energy-flux]] and define $E_{\\rm ext}:=\\int_{|x|\\ge\\ell}u(x)\\,d^3x$. Assume the total rest energy is the sum of this exterior field energy and a remaining material-plus-interior contribution $E_{\\rm rem}\\ge0$. Then\n$$Mc^2\\ge\\frac{q^2}{8\\pi\\varepsilon_0\\ell},\\qquad \\ell\\ge\\frac{q^2}{8\\pi\\varepsilon_0Mc^2}.$$\nThe exact Coulomb exterior and nonnegative energy accounting are hypotheses. The theorem does not infer an exterior field from spherical symmetry alone. No identification of field energy with an ideal point particle's rest mass is made.",
        "strategy": "direct",
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "sources": [
          {
            "title": "Konstantin K. Likharev, Essential Graduate Physics: Classical Electrodynamics, §1.3 Scalar Potential and Electric Field Energy",
            "url": "https://phys.libretexts.org/Bookshelves/Electricity_and_Magnetism/Essential_Graduate_Physics_-_Classical_Electrodynamics_%28Likharev%29/01%3A_Electric_Charge_Interaction/1.03%3A_Scalar_Potential_and_Electric_Field_Energy",
            "locator": "Full HTML section §1.3, Eqs. (1.34)–(1.35) Coulomb field/potential and (1.65)–(1.68) field energy with a uniform sphere's interior/exterior calculation; the point-charge interpretation is context only."
          }
        ],
        "physical_scope": "A conditional static spherical-body energy inequality when its vacuum exterior is exactly Coulomb and its total rest energy includes that exterior field energy plus nonnegative remaining energy. It is not a universal radius theorem for arbitrary charge distributions, and it makes no mass inference for an ideal point charge.",
        "empirical_premises": []
      },
