        "id": "ex-rpm-bmt-fw-and-g-two",
        "kind": "example",
        "domain": "physics",
        "library": "physics",
        "title": "BMT G=0 Fermi–Walker and G=1 shared-generator cases",
        "reference": "items/ex-rpm-bmt-fw-and-g-two.md#Example",
        "design_state": "Draft carrier authored in assigned batch; independent review remains pending.",
        "dependency_level": 5,
        "deps": [
          "def-rpm-charge-spin-model",
          "pthm-rpm-external-charge-action-equivalence",
