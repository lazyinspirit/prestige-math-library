        "title": "TD spin and momentum norms",
        "reference": "items/pthm-rpm-td-invariants.md#Statement",
        "design_state": "Draft carrier authored in assigned batch; independent review remains pending.",
        "dependency_level": 4,
        "deps": [
          "def-rpm-body-moments",
          "lem-rpm-td-local-closure",
