        "id": "pthm-td-intensive-coexistence-conditions",
        "kind": "physics-theorem",
        "domain": "physics",
        "title": "Intensive equilibrium conditions for coexisting phases",
        "reference": "items/pthm-td-intensive-coexistence-conditions.md",
        "design_state": "Step 1 complete draft; readiness recorded separately.",
