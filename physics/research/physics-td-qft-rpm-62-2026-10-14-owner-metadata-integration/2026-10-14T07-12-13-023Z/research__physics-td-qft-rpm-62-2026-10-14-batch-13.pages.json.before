      {
        "id": "ex-td-clapeyron-linear-branches",
        "kind": "example",
        "domain": "physics",
        "title": "A two-branch Gibbs model with a positive Clapeyron slope",
        "reference": "items/ex-td-clapeyron-linear-branches.md",
        "design_state": "Step 1 complete draft; readiness recorded separately.",
        "dependency_level": 11,
        "deps": [
          "def-td-phase-and-coexistence-domain",
          "pthm-td-clapeyron-local",
          "thm-euclidean-inverse-function-theorem"
        ],
        "justified_by": [],
        "forward_refs": [],
        "dependency_roles": {
          "def-td-phase-and-coexistence-domain": "formulation-prerequisite",
          "pthm-td-clapeyron-local": "physical-result",
          "thm-euclidean-inverse-function-theorem": "mathematical-premise"
        },
        "physical_scope": "A constructed pair of one-component Gibbs charts satisfying the same-tag, exchange, and reversible-heat assumptions of the local Clapeyron theorem; the constants are illustrative and are not observations.",
        "inventory_expansion_required": false,
        "statement": "Fix $T_0=300\\,\\mathrm K$, $p_0=10^5\\,\\mathrm{Pa}$, $g_0=1\\,\\mathrm{J\\,mol^{-1}}$, $c>0$ in $\\mathrm{J\\,mol^{-1}K^{-1}}$, and $\\kappa>0$ in $\\mathrm{m^3\\,mol^{-1}Pa^{-1}}$. On a common open chart define\n\\[\ng_i(T,p)=g_0-s_i(T-T_0)-\\frac{c}{2T_0}(T-T_0)^2+v_i(p-p_0)-\\frac{\\kappa}{2}(p-p_0)^2,\n\\]\nfor $i\\in\\{\\alpha,\\beta\\}$, with $s_\\alpha=2\\,\\mathrm{J\\,mol^{-1}K^{-1}}$, $s_\\beta=5\\,\\mathrm{J\\,mol^{-1}K^{-1}}$, $v_\\alpha=1.0\\times10^{-3}\\,\\mathrm{m^3\\,mol^{-1}}$, and $v_\\beta=4.0\\times10^{-3}\\,\\mathrm{m^3\\,mol^{-1}}$. Set $G_i=n_i g_i$ and use the natural Gibbs assignments $S_i=-\\partial_TG_i$, $V_i=\\partial_pG_i$, $\\mu_i=\\partial_{n_i}G_i$, and $U_i=G_i+TS_i-pV_i$. Thus same-tag homogeneity is explicit. Assume the constructed model stipulates an attained coexistence endpoint with bilateral energy, volume, and species exchange, and a reversible $\\alpha\\to\\beta$ conversion in contact with an ideal thermal reservoir at $T_0$. These parameters and endpoint assumptions are model inputs, not empirical claims.",
        "provenance": {
          "statement": "ai-generated",
          "proof": "ai-generated"
        },
        "sources": {
          "references": [
