        "id": "def-qft-framework-units",
        "kind": "definition",
        "domain": "physics",
        "title": "Quantum field quantities and compatible SI normalizations",
        "reference": "research/extended-frameworks-2026-10-03/quantum-field-theory/quantities-and-postulates.md#framework-units",
        "design_state": "planned local unit and domain definition; complete SI consistency argument, model conventions, and scope boundaries authored",
        "dependency_level": 0,
