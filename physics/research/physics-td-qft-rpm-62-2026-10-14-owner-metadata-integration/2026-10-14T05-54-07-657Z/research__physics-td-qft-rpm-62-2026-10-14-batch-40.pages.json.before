      {
        "id": "texp-qft-two-level-measurement",
        "kind": "thought-experiment",
        "domain": "physics",
        "title": "Two-level measurement and formal-coefficient boundary",
        "reference": "research/extended-frameworks-2026-10-03/quantum-field-theory/quantities-and-postulates.md#framework-examples",
        "design_state": "planned B leaf; complete finite two-level conditional argument and formal versus numerical convergence proof authored",
        "dependency_level": 3,
        "deps": [
          "post-qft-constructed-model-and-measurement",
          "def-qft-finite-bounded-kraus-instrument",
          "def-countable-choice",
          "lem-qft-finite-instrument-normalization",
          "lem-nrqm-composites-rank-one-operator-calculus",
