      {
        "id": "post-td-entropy-maximum",
        "kind": "postulate",
        "domain": "physics",
        "title": "Equilibrium as an attained global entropy maximum",
        "statement": "For stable equilibrium of an explicitly specified isolated compound of independent separated systems, adopt an attained global maximum of the summed entropy on its exact feasible set; local maxima do not suffice.",
        "deps": [
          "def-finite-sum",
          "def-max-min",
          "def-td-isolated-compound-feasible-set",
          "def-td-thermal-contact-constraints",
