      {
        "id": "post-td-zeroth-law",
        "kind": "postulate",
        "domain": "physics",
        "title": "Zeroth law for the declared thermal-contact family",
        "statement": "Adopt the thermal-contact relation as an equivalence relation only within its declared contact family; it supplies no numerical temperature scale or universal calibration.",
        "deps": [
          "def-td-thermal-contact-constraints"
        ],
        "dependency_roles": {
          "def-td-thermal-contact-constraints": "formulation-prerequisite"
        },
