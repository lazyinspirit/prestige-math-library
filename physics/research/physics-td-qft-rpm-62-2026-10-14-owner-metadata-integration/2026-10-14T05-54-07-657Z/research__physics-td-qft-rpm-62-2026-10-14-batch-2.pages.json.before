      {
        "id": "post-td-macroscopic-second-law",
        "kind": "postulate",
        "domain": "physics",
        "title": "Macroscopic second law for isolated compounds",
        "statement": "For the declared isolated closed core-process class and equilibrium endpoints, adopt nondecrease of total entropy; reversible operations have zero total change, while strict increase is allowed but not required for irreversible operations.",
        "deps": [
          "post-td-concave-fundamental-entropy",
          "def-td-system-and-permitted-exchanges",
          "def-td-process-and-protocol",
