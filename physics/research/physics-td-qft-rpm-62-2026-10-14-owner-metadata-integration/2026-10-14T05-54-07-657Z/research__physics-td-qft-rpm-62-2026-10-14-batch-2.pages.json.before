      {
        "id": "post-td-concave-fundamental-entropy",
        "kind": "postulate",
        "domain": "physics",
        "title": "Concave macroscopic fundamental entropy",
        "statement": "Adopt a finite, continuous, concave entropy function on each declared convex equilibrium chart, additive for independent separated systems and homogeneous on the tagged bulk family; assume C² and S_U>0 only on specified open single-phase charts.",
        "deps": [
          "def-ck-euclidean-maps-and-diffeomorphisms",
          "def-directional-and-partial-derivatives",
          "def-interval",
          "def-td-equilibrium-state-domain",
          "def-td-si-quantities",
          "def-td-system-and-permitted-exchanges",
          "post-td-bulk-additivity"
        ],
        "dependency_roles": {
