        "id": "ex-td-irreversible-adiabatic-compression",
        "kind": "example",
        "domain": "physics",
        "title": "Entropy increase in an idealized adiabatic compression",
        "statement": "In a stipulated one-mole monatomic ideal-gas model, a sudden constant-load adiabatic compression from V_i to 0.9V_i raises the gas entropy by the exactly calculated positive amount.",
        "deps": [
          "def-td-process-and-protocol",
          "def-td-reversible-process",
          "def-td-si-quantities",
          "post-td-first-law-energy",
          "post-td-concave-fundamental-entropy",
