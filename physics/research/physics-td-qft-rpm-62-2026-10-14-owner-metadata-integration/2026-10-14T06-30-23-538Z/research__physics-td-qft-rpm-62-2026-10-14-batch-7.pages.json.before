      {
        "id": "pthm-td-universal-mixing-entropy",
        "kind": "physics-theorem",
        "domain": "physics",
        "title": "Conditional weak entropy principle across mixing channels",
        "statement": "Under the exact catalyst-cost, no-sinks, A1–A6 and Choice hypotheses, obtain a weakly monotone entropy across admitted cross-type channels.",
        "deps": [
