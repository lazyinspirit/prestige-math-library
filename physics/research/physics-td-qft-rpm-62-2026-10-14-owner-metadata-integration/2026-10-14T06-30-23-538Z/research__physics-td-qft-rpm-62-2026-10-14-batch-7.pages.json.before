        "dependency_level": 6
      },
      {
        "id": "def-td-cross-type-reaction-network",
        "kind": "definition",
        "domain": "physics",
        "title": "Cross-type mixing and reaction network",
        "statement": "Define admitted cross-type mixing and reaction channels, finite catalyst-chain costs and the explicit no-sinks condition.",
