      },
      {
        "id": "post-td-equilibrium-join-coherence",
        "kind": "postulate",
        "domain": "physics",
        "title": "Equilibrium-join coherence C1",
        "statement": "Adopt the separate C1 condition that an equilibrated join is thermally equivalent to each constituent.",
        "deps": [
          "def-td-thermal-join",
          "post-td-thermal-join-axioms"
        ],
        "dependency_roles": {
          "def-td-thermal-join": "formulation-prerequisite",
