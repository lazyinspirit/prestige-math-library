[
  {
    "order": 271,
    "id": "td-accessibility-foundation",
    "kind": "A",
    "category": "thermodynamics",
    "library": "physics",
    "title": "Accessibility Foundation",
    "companion": "td-accessibility-foundation-examples",
    "requires": [
      "td-math-convex-contact-and-mixing",
      "td-thermodynamic-framework"
    ],
    "items": [
      {
        "id": "def-td-adiabatic-accessibility",
        "kind": "definition",
        "domain": "physics",
        "title": "Adiabatic accessibility",
        "statement": "Define adiabatic accessibility as existence of an admitted zero-heat process record between fixed-composition equilibrium endpoints.",
        "deps": [
          "def-td-equilibrium-state-domain",
          "def-td-process-and-protocol",
          "def-td-system-and-permitted-exchanges"
        ],
        "dependency_roles": {
          "def-td-equilibrium-state-domain": "formulation-prerequisite",
          "def-td-process-and-protocol": "formulation-prerequisite",
          "def-td-system-and-permitted-exchanges": "formulation-prerequisite"
        },
        "provenance": {
          "statement": "literature-derived",
          "proof": "not-applicable"
        },
        "sources": {
          "references": [
            {
              "title": "Lieb and Yngvason, The Physics and Mathematics of the Second Law of Thermodynamics, §§II.A–II.B",
              "url": "https://arxiv.org/pdf/cond-mat/9708200v2"
            },
            {
              "title": "André Thess, The Lieb–Yngvason Machine: A didactical tool for the definition of entropy in classical thermodynamics, §2",
              "url": "https://www.dlr.de/de/tt/downloads/dokumente/institut/institutsleitung/Entropie.pdf/@@download/file"
            },
            {
              "title": "Samuel J. Ling, William Moebs, and Jeff Sanny, University Physics Volume 2, §4.1 Reversible and Irreversible Processes",
              "url": "https://openstax.org/books/university-physics-volume-2/pages/4-1-reversible-and-irreversible-processes"
            },
            {
              "title": "Goddard, The second law of thermodynamics as variation on a theme of Carathéodory, §§2–3",
              "url": "https://escholarship.org/content/qt27k6m59q/qt27k6m59q.pdf"
            }
          ]
        },
        "dependency_level": 4
      },
      {
        "id": "def-td-scaled-products-and-comparison",
        "kind": "definition",
        "domain": "physics",
        "title": "Tagged scaled systems and separated products",
        "statement": "Define tagged scaled copies, finite separated products and equal-composition comparisons without inferring accessibility from coordinate addition.",
        "deps": [
          "def-td-adiabatic-accessibility",
          "def-td-equilibrium-state-domain",
          "post-td-bulk-additivity"
        ],
        "dependency_roles": {
          "def-td-adiabatic-accessibility": "formulation-prerequisite",
          "def-td-equilibrium-state-domain": "formulation-prerequisite",
          "post-td-bulk-additivity": "physical-assumption"
        },
        "provenance": {
          "statement": "literature-derived",
          "proof": "not-applicable"
        },
        "sources": {
          "references": [
            {
              "title": "Lieb and Yngvason, The Physics and Mathematics of the Second Law of Thermodynamics, §§II.A–II.C",
              "url": "https://arxiv.org/pdf/cond-mat/9708200v2"
            },
            {
              "title": "André Thess, The Lieb–Yngvason Machine: A didactical tool for the definition of entropy in classical thermodynamics, §2",
              "url": "https://www.dlr.de/de/tt/downloads/dokumente/institut/institutsleitung/Entropie.pdf/@@download/file"
            }
          ]
        },
        "dependency_level": 5
      },
      {
        "id": "post-td-accessibility-a1-a6",
        "kind": "postulate",
        "domain": "physics",
        "title": "Accessibility axioms A1–A6",
        "statement": "Adopt reflexivity, transitivity, consistency, scaling, reversible splitting and stability for accessibility on equal-composition finite products.",
        "deps": [
          "def-td-adiabatic-accessibility",
          "def-td-scaled-products-and-comparison",
          "post-td-bulk-additivity"
        ],
        "dependency_roles": {
