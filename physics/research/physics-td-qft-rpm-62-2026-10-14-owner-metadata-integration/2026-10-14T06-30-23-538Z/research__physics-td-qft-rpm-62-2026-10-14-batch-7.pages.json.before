        "dependency_level": 6
      },
      {
        "id": "def-td-thermal-join",
        "kind": "definition",
        "domain": "physics",
        "title": "Thermal joins and thermal equivalence",
        "statement": "Define an energy-summing thermal join, its retained work coordinates and the pair-to-join contact relation.",
        "deps": [
          "def-td-adiabatic-accessibility",
          "def-td-scaled-products-and-comparison",
          "def-td-equilibrium-state-domain",
          "post-td-bulk-additivity"
