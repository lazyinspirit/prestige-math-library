            }
          ]
        },
        "dependency_level": 12
      },
      {
        "id": "pthm-td-entropy-under-product-comparison",
        "kind": "physics-theorem",
        "domain": "physics",
        "title": "Entropy representation for finite separated products",
        "statement": "Under the full contact branch, Choice and explicit finite-factor types, obtain a dimensionless additive extensive entropy representation; A7 makes it concave.",
        "deps": [
          "def-axiom-of-choice",
          "def-td-scaled-products-and-comparison",
