      {
        "id": "pthm-td-contact-product-comparison",
        "kind": "physics-theorem",
        "domain": "physics",
        "title": "Conditional contact calibrator and product comparison",
        "statement": "Under A1–A7, S1–S3, T1–T5 and C1, conditionally obtain calibrator states and comparison on all finite separated products.",
