      "supplier_excerpts": [
        {
          "supplier": "def-tdmath-measure-integral",
          "carrier": "items/def-tdmath-measure-integral.md",
          "status": "current draft supplier carrier; interface inspected, independent acceptance not asserted",
          "source_section": "Definition",
          "exact_statement": "A measure space is a triple $(X,\\Sigma,\\mu)$ where $\\Sigma$ contains $\\varnothing,X$ and is closed under complements and countable unions (a $\\sigma$-algebra) of subsets of $X$ and $\\mu:\\Sigma\\to[0,\\infty]$ is countably additive with $\\mu(\\varnothing)=0$. A measurable function $f:X\\to[-\\infty,\\infty]$ has measurable inverse images of Borel sets, where the Borel sets of the extended real line are the sigma-algebra generated by its open sets. A nonnegative simple function has the form $s=\\sum_{j=1}^m c_j\\mathbf1_{A_j}$ with finitely many disjoint $A_j\\in\\Sigma$ and finite $c_j\\ge0$. Define $c\\mu(A)=+\\infty$ if $c>0$ and $\\mu(A)=+\\infty$, define $0\\cdot\\infty:=0$, and define the finite sum of these extended nonnegative terms to be $+\\infty$ if any term is $+\\infty$ and otherwise the real finite sum of [[def-finite-sum]]. Then $\\int s\\,d\\mu:=\\sum_j c_j\\mu(A_j)$; using canonical level sets $\\{s=c\\}$ makes this value representation-independent. For measurable $f\\ge0$, define $\\int f\\,d\\mu:=\\sup\\{\\int s\\,d\\mu: s\\text{ is simple and }0\\le s\\le f\\}$, using [[def-complete-ordered-field]] for a bounded set of finite values and setting the supremum to $+\\infty$ when the values are unbounded or one is infinite. A real measurable $f$ is integrable when $\\int|f|\\,d\\mu<\\infty$, and then $\\int f:=\\int f^+-\\int f^-$, where $f^+=\\max(f,0)$ and $f^-:=\\max(-f,0)$. Complex integrability and integration are defined by integrable real and imaginary parts.",
          "relevant_hypotheses_and_conventions": "The exact current supplier statement is quoted above. Its hypotheses, domain and conventions are those declared by consumer Fact labels F1.",
          "supplier_proof_status": "Draft definition is present; its local interface was inspected.",
          "consumer_use": "F1 is used in step(s) 1.1, 2.1, 3.1"
        },
        {
          "supplier": "thm-tdmath-dominated-convergence",
          "carrier": "items/thm-tdmath-dominated-convergence.md",
          "status": "current draft supplier carrier; interface inspected, independent acceptance not asserted",
          "source_section": "Statement",
          "exact_statement": "Let $(X,\\Sigma,\\mu)$ be a measure space and let $f_n:X\\to\\mathbb C$ be measurable with $f_n\\to f$ almost everywhere. Suppose $g\\ge0$ is measurable and $\\int g\\,d\\mu<\\infty$, and $|f_n|\\le g$ almost everywhere for every $n$. Then $f$ is integrable, $\\int f_n\\,d\\mu\\to\\int f\\,d\\mu$, and $\\int|f_n-f|\\,d\\mu\\to0$.",
          "relevant_hypotheses_and_conventions": "The exact current supplier statement is quoted above. Its hypotheses, domain and conventions are those declared by consumer Fact labels F2.",
          "supplier_proof_status": "Draft result has a complete local proof carrier; independent acceptance is not asserted.",
          "consumer_use": "F2 is used in step(s) 1.1"
        },
        {
          "supplier": "def-real-exponential-function-and-e",
          "carrier": "items/def-real-exponential-function-and-e.md",
          "status": "current published mathematical supplier; exact interface inspected",
          "source_section": "Definition",
          "exact_statement": "For $x\\in\\mathbb R$, define\n$$\\exp(x):=\\sum_{n=0}^{\\infty}\\frac{x^n}{\\iota(n!)}, \\qquad e:=\\exp(1),$$\nprovided by the all-real convergence proved in [[lem-exponential-series-has-infinite-radius]]. Here $n!\\in\\mathbb N$ is the factorial of [[def-factorial-and-falling-factorial]], $\\iota(n!)$ is its nonzero real image ([[def-canonical-natural]], [[lem-of-naturals-positive]]), and powers and series are those of [[def-integer-power]] and [[def-series]].\n\nThis is a real power series centred at $0$ ([[def-real-power-series-and-radius-of-convergence]]). No logarithm, irrational power, or differential equation enters the definition.",
          "relevant_hypotheses_and_conventions": "The exact current supplier statement is quoted above. Its hypotheses, domain and conventions are those declared by consumer Fact labels F3.",
          "supplier_proof_status": "Published definition; no proof is required.",
          "consumer_use": "F3 is used in step(s) 1.1, 2.1, 3.1"
        },
        {
