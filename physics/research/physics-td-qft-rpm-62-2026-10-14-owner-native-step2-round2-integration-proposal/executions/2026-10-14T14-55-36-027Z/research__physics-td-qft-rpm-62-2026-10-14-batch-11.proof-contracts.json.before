            "scope_only_not_proof_acceptance": true
          }
        },
        {
          "case": "iff-reverse",
          "status": "not_applicable",
          "reason": "Let a two-state model have energies $0$ and $\\varepsilon>0$, with unit state weights and $\\beta>0$. Boundary iff-reverse: The statement contains no iff characterization.",
          "case_scope": {
