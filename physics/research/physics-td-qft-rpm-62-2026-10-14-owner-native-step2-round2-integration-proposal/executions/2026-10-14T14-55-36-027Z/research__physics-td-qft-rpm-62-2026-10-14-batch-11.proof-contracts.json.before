    "ex-tdmath-finite-ensemble-mismatch": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-tdmath-countable-canonical-model",
          "source_section": "Definition",
          "quote": "Let $I$ be a nonempty finite or countably infinite set equipped with a specified enumeration, let $E_i\\in\\mathbb R$ be finite energies, let $g_i>0$ be weights, and let $J\\subseteq\\mathbb R$ be an open parameter interval. For a nonnegative family $(a_i)_{i\\in I}$ define $\\sum_{i\\in I}a_i:=\\sup_{F\\subset I,\\,F\\text{ finite}}\\sum_{i\\in F}a_i$, with finite sums as in [[def-finite-sum]] and the supremum as in [[def-complete-ordered-field]] when the finite subsums are bounded; set the value to $+\\infty$ when they are unbounded. This definition is independent of the specified enumeration. For $\\beta\\in J$, define the nonnegative partition sum $Z(\\beta):=\\sum_{i\\in I}g_i\\exp(-\\beta E_i)$ by this rule. The admissible parameter set is $J_Z:=\\{\\beta\\in J:0<Z(\\beta)<\\infty\\}$. For $\\beta\\in J_Z$, define $p_i(\\beta):=g_i\\exp(-\\beta E_i)/Z(\\beta)$; then $(p_i)$ is a countable probability law. For any real observable $X_i$ with $\\sum_i p_i|X_i|<\\infty$, define $\\langle X\\rangle_\\beta:=\\sum_i p_iX_i$. If $\\sum_i|p_i\\log(p_i/g_i)|<\\infty$, define the reference-relative entropy $H_g(p):=-\\sum_i p_i\\log(p_i/g_i)$. When $g_i=1$, this is the Shannon entropy with natural logarithms. A lower bound on the energies alone is not part of this definition and does not imply $Z(\\beta)<\\infty$. For countably infinite $I$, any specified enumeration is used only to write a list; the nonnegative sum itself is the supremum over finite subsums above.",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F2",
          "source": "thm-tdmath-summable-canonical-differentiation",
          "source_section": "Statement",
          "quote": "Let $I,E_i,g_i,J,Z$ be as in [[def-tdmath-countable-canonical-model]]. Suppose that for every compact interval $K\\subset J$ there is a summable sequence $a_i\\ge0$ such that $g_i(1+|E_i|^2)\\exp(-\\beta E_i)\\le a_i$ for every $i\\in I$ and $\\beta\\in K$. Then $Z$ is positive, finite, and $C^2$ on $J$, with $Z'(\\beta)=-\\sum_i g_iE_i\\exp(-\\beta E_i)$ and $Z''(\\beta)=\\sum_i g_iE_i^2\\exp(-\\beta E_i)$. The probabilities $p_i$ are normalized; their mean $\\bar E$ and variance are finite and satisfy $-\\partial_\\beta\\log Z=\\bar E$ and $\\partial_\\beta^2\\log Z=\\operatorname{Var}_\\beta(E)$. Moreover $H_g(p)=\\log Z+\\beta\\bar E$, and its defining series is absolutely convergent.",
          "uses": [
            "1.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "step-1-1",
          "claim": "The canonical partition sum is $1+e^{-\\beta\\varepsilon}$; its excited probability is $e^{-\\beta\\varepsilon}/(1+e^{-\\beta\\varepsilon})$, strictly positive because the exponential is positive.",
          "step": "1.1",
          "inputs": [
            "F1",
            "F2",
            "A1"
          ]
        },
        {
          "id": "step-2-1",
          "claim": "The shell condition $0\\le E_i<\\Delta$ includes the state of energy zero and excludes the state of energy $\\varepsilon$, since $\\Delta<\\varepsilon$. Uniform weighting of this one-state shell gives excited probability zero, which differs from step 1.1.",
          "step": "2.1",
          "inputs": [
            "A1",
            "step 1.1",
            "1.1"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "Let a two-state model have energies $0$ and $\\varepsilon>0$, with unit state weights and $\\beta>0$. Boundary empty: The claim has no empty-set or empty-domain assertion; its stated object domain is nonempty or the boundary is not separate.",
          "case_scope": {
            "source_section": "Example",
            "source_excerpt": "Let a two-state model have energies $0$ and $\\varepsilon>0$, with unit state weights and $\\beta>0$. Adopt the finite-shell convention that the microcanonical law is uniform over states whose energy lies in $[0,\\Delta)$ when the shell is nonempty. For $0<\\Delta<\\varepsilon$, that shell contains only the ground state, whereas the canonical law assigns the excited state probability $e^{-\\beta\\varepsilon}/(1+e^{-\\beta\\varepsilon})>0$. Thus the two finite-ensemble laws differ.",
            "current_raw_sha256": "35e9c3774db8a762b5c5c1668982df27307aacdcfa60d249b46f48763333d880",
            "scope_only_not_proof_acceptance": true
          }
