      "supplier_excerpts": [
        {
          "supplier": "def-tdmath-bounded-finite-range-lattice",
          "carrier": "items/def-tdmath-bounded-finite-range-lattice.md",
          "status": "current draft supplier carrier; interface inspected, independent acceptance not asserted",
          "source_section": "Definition",
          "exact_statement": "Fix integers $d\\ge1$, $L\\ge1$, a finite alphabet $\\mathcal A$ of cardinality $q\\ge1$, and a finite, possibly empty, list of interaction shapes $S_a\\subset\\mathbb Z^d$, each nonempty and contained in $[-R,R]^d$ for some integer $R\\ge0$. $\\|\\Phi_a\\|_\\infty$ is finite because its domain is finite. For each shape let $\\Phi_a:\\mathcal A^{S_a}\\to\\mathbb R$ be a bounded interaction function. Set $J_0:=\\sum_a\\|\\Phi_a\\|_\\infty$. On $\\Lambda_L:=\\{1,\\ldots,L\\}^d$, define the free-boundary energy $H_L(s):=\\sum_a\\sum_{x:x+S_a\\subseteq\\Lambda_L}\\Phi_a((s_{x+u})_{u\\in S_a})$, for configurations $s\\in\\mathcal A^{\\Lambda_L}$. For $\\beta>0$, define the finite partition sum $Z_L(\\beta):=\\sum_{s\\in\\mathcal A^{\\Lambda_L}}e^{-\\beta H_L(s)}$ and normalized log-partition density $p_L(\\beta):=L^{-d}\\log Z_L(\\beta)$.",
          "relevant_hypotheses_and_conventions": "The exact current supplier statement is quoted above. Its hypotheses, domain and conventions are those declared by consumer Fact labels A1, F1.",
          "supplier_proof_status": "Draft definition is present; its local interface was inspected.",
          "consumer_use": "A1 is used in step(s) 1.1, 1.2, 2.1, 3.1, 4.1; F1 is used in step(s) 1.1, 1.2, 2.1, 3.1, 4.1"
        },
        {
          "supplier": "thm-division-algorithm-in-z",
          "carrier": "items/thm-division-algorithm-in-z.md",
          "status": "current published mathematical supplier; exact interface inspected",
          "source_section": "Statement",
          "exact_statement": "Let $a, b \\in \\mathbb{Z}$ ([[def-integers]]) with $b > 0$. Then there exist\nintegers $q$ and $r$ with\n\n$$a \\;=\\; qb + r, \\qquad 0 \\le r < b,$$\n\nand the pair $(q,r)$ with these two properties is unique.\n\nWe say $b$ **divides** $a$, written $b \\mid a$, when $a = qb$ for some\n$q \\in \\mathbb{Z}$; by the above, for $b > 0$ this holds exactly when the\nremainder $r$ is $0$.",
          "relevant_hypotheses_and_conventions": "The exact current supplier statement is quoted above. Its hypotheses, domain and conventions are those declared by consumer Fact labels F3.",
          "supplier_proof_status": "Published mathematical result; proof carrier is present and its hypotheses were inspected.",
          "consumer_use": "F3 is used in step(s) 1.2, 2.1"
        },
        {
          "supplier": "def-natural-logarithm",
          "carrier": "items/def-natural-logarithm.md",
          "status": "current published mathematical supplier; exact interface inspected",
          "source_section": "Definition",
          "exact_statement": "For $x>0$, define $\\log x$ to be the unique real $y$ such that $\\exp(y)=x$. This is well-defined because [[cor-exponential-is-a-bijection-onto-positive-reals]] states that $\\exp:\\mathbb R\\to(0,\\infty)$ is a bijection.\n\nThus $\\log:(0,\\infty)\\to\\mathbb R$ is the inverse function of $\\exp$. In particular, $\\log(\\exp y)=y$ for every $y\\in\\mathbb R$ and $\\exp(\\log x)=x$ for every $x>0$.",
          "relevant_hypotheses_and_conventions": "The exact current supplier statement is quoted above. Its hypotheses, domain and conventions are those declared by consumer Fact labels F2.",
          "supplier_proof_status": "Published definition; no proof is required.",
          "consumer_use": "F2 is used in step(s) 1.1, 2.1, 4.1"
        },
        {
          "supplier": "thm-natural-logarithm-laws",
          "carrier": "items/thm-natural-logarithm-laws.md",
          "status": "current published mathematical supplier; exact interface inspected",
          "source_section": "Statement",
          "exact_statement": "The function $\\log:(0,\\infty)\\to\\mathbb R$ is continuous and strictly increasing, is onto $\\mathbb R$, and satisfies, for $x,y>0$,\n$$\\log(xy)=\\log x+\\log y,\\qquad \\log(x/y)=\\log x-\\log y,\\qquad \\log(1/x)=-\\log x.$$\nAlso $\\log 1=0$.",
          "relevant_hypotheses_and_conventions": "The exact current supplier statement is quoted above. Its hypotheses, domain and conventions are those declared by consumer Fact labels F2.",
