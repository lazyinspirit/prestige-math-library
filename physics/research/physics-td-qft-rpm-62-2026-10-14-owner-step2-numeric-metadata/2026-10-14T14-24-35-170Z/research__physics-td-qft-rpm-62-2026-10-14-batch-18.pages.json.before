          "lem-tdmath-relative-entropy-variational-and-chain-rules": "mathematical-premise",
          "thm-tdmath-local-tame-entropy-compactness": "mathematical-premise",
          "lem-tdmath-superstable-cell-energy-bound": "mathematical-premise",
