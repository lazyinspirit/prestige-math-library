    "pthm-td-mean-dissipation": {
      "citations": [
        {
          "fact": "F1",
          "source": "pthm-td-finite-jarzynski",
          "source_section": "Statement",
          "quote": "For the forward path law of [[def-td-driven-finite-path-model]], under [[post-td-canonical-protocol-preparation]] and [[post-td-stationary-bath-kernel]], the finite expectation satisfies $\\mathbb E_F[e^{-\\beta W}]=Z_m/Z_0=e^{-\\beta\\Delta F}$. This is an ensemble identity; it does not say $W=\\Delta F$ on each path.",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F2",
          "source": "thm-exponential-two-point-convexity",
          "source_section": "Statement",
          "quote": "For all $x,y\\in\\mathbb R$ and $0\\le t\\le1$,\n$$\\exp((1-t)x+ty)\\le(1-t)\\exp x+t\\exp y.$$\nIf $0<t<1$, equality holds exactly when $x=y$.",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F3",
          "source": "thm-finite-jensen-inequality",
          "source_section": "Statement",
          "quote": "Let $f:I\\to\\mathbb R$ be convex. If $N\\ge1$, $x_1,\\ldots,x_N\\in I$, and $\\lambda_1,\\ldots,\\lambda_N\\ge0$ satisfy $\\sum_{i=1}^N\\lambda_i=1$, then\n\n$$f\\left(\\sum_{i=1}^N\\lambda_i x_i\\right)\\le\\sum_{i=1}^N\\lambda_i f(x_i).$$",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F4",
          "source": "thm-exponential-is-strictly-increasing",
          "source_section": "Statement",
          "quote": "The exponential function is continuous and strictly increasing on $\\mathbb R$.",
          "uses": [
            "2.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "step-1-1",
          "claim": "Apply finite Jensen to the finitely many forward paths with $x_\\omega=-\\beta W(\\omega)$ and weights $P_F(\\omega)$. Then $e^{-\\beta\\mathbb E_F W}\\le\\mathbb E_F e^{-\\beta W}=e^{-\\beta\\Delta F}$.",
          "step": "1.1",
          "inputs": [
            "given",
            "F1",
            "F2",
            "F3"
          ]
        },
        {
          "id": "step-2-1",
          "claim": "Strict increase of the exponential yields $-\\beta\\mathbb E_F W\\le-\\beta\\Delta F$. Since $\\beta>0$, multiplying by $-1/\\beta$ reverses the order and gives $\\mathbb E_F W\\ge\\Delta F$.",
          "step": "2.1",
          "inputs": [
            "F4",
            "step 1.1",
            "algebra"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "checked",
          "evidence": "Statement assumes a normalized finite forward path law, which requires at least one admissible path."
        },
        {
          "case": "zero",
          "status": "checked",
          "evidence": "Step 1.1 and Jensen allow zero work values; no division by work is used."
        },
        {
          "case": "one",
          "status": "checked",
          "evidence": "Step 1.1 applies finite Jensen to a one-point path distribution, where equality holds."
        },
        {
          "case": "degenerate",
          "status": "checked",
          "evidence": "Statement includes equal stage energies, giving W=ΔF=0 and equality in the claimed average bound."
        },
        {
          "case": "endpoints",
          "status": "checked",
          "evidence": "Statement compares the initial and final protocol free energies through ΔF=F_m−F_0."
        },
        {
          "case": "nonempty-choice",
          "status": "not_applicable",
          "reason": "Under the hypotheses of [[pthm-td-finite-jarzynski]], the mean work obeys $\\mathbb E_F W\\ge\\Delta F$. Boundary nonempty-choice: No choice principle is used; the finite data are fixed and all sums are finite. Item: pthm-td-mean-dissipation.",
          "case_scope": {
            "source_section": "Statement",
            "source_excerpt": "Under the hypotheses of [[pthm-td-finite-jarzynski]], the mean work obeys $\\mathbb E_F W\\ge\\Delta F$. The conclusion concerns the path ensemble only; individual paths may have $W<\\Delta F$.",
            "current_raw_sha256": "5c83ddc0d589a21a3cb1b0388fbcecc3777f9f92494c9b47ba82b1ddf5b16b3e",
