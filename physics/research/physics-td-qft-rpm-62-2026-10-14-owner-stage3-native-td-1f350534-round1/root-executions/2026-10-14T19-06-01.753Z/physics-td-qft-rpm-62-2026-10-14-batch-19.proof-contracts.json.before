        },
        {
          "case": "iff-forward",
          "status": "not_applicable",
          "reason": "Let $S$ have $N\\ge2$ states, positive detailed-balance law $\\pi$, and connected undirected rate graph as in [[def-td-detailed-balance-rate-model]]. Boundary iff-forward: The item statement contains no biconditional; neither direction is asserted.",
          "case_scope": {
            "source_section": "Statement",
            "source_excerpt": "Let $S$ have $N\\ge2$ states, positive detailed-balance law $\\pi$, and connected undirected rate graph as in [[def-td-detailed-balance-rate-model]]. For every strictly positive initial probability vector $p(0)$, the master equation has a unique strictly positive probability solution $p(t)$ for all $t\\ge0$. The relative entropy $D(p(t)\\Vert\\pi)=\\sum_i p_i(t)\\log(p_i(t)/\\pi_i)$ is nonincreasing, and $p_i(t)\\to\\pi_i$ for every state. No monotonicity of Shannon entropy $-\\sum_i p_i\\log p_i$ is asserted.",
            "current_raw_sha256": "81b1eca60b0507ac7a046f1012c3007e2bdf7dd347b5da70295855e52efeabdd",
            "scope_only_not_proof_acceptance": true
          }
        },
        {
          "case": "iff-reverse",
          "status": "not_applicable",
          "reason": "Let $S$ have $N\\ge2$ states, positive detailed-balance law $\\pi$, and connected undirected rate graph as in [[def-td-detailed-balance-rate-model]]. Boundary iff-reverse: The item statement contains no biconditional; neither direction is asserted.",
          "case_scope": {
            "source_section": "Statement",
            "source_excerpt": "Let $S$ have $N\\ge2$ states, positive detailed-balance law $\\pi$, and connected undirected rate graph as in [[def-td-detailed-balance-rate-model]]. For every strictly positive initial probability vector $p(0)$, the master equation has a unique strictly positive probability solution $p(t)$ for all $t\\ge0$. The relative entropy $D(p(t)\\Vert\\pi)=\\sum_i p_i(t)\\log(p_i(t)/\\pi_i)$ is nonincreasing, and $p_i(t)\\to\\pi_i$ for every state. No monotonicity of Shannon entropy $-\\sum_i p_i\\log p_i$ is asserted.",
            "current_raw_sha256": "81b1eca60b0507ac7a046f1012c3007e2bdf7dd347b5da70295855e52efeabdd",
            "scope_only_not_proof_acceptance": true
          }
        }
