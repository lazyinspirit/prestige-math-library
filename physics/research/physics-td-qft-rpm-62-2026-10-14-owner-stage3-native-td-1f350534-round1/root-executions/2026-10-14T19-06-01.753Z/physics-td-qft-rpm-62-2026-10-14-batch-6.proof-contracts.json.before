    "lem-tdmath-relative-interior-segment": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-convex-subset-of-euclidean-space",
          "source_section": "Definition",
          "quote": "A subset $U\\subseteq\\mathbb R^m$ is **convex** when, for all $x,y\\in U$ and $t\\in[0,1]$ ([[def-interval]]), the point $(1-t)x+ty$ lies in $U$. Thus the full line segment from $x$ to $y$ remains in $U$.",
          "uses": [
            "1.1",
            "2.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "step-1-1",
          "step": "1.1",
          "claim": "Let $k=\\dim(\\operatorname{aff}C)$. If $k=0$, then $C$ is a singleton and is open in its affine hull. If $k>0$, the definition of affine hull supplies $k+1$ affinely independent points of $C$ spanning it. Their simplex lies in $C$ by [F1]. Its barycenter has all $k+1$ barycentric coordinates positive; sufficiently small coordinate perturbations preserve positivity and their sum one. Thus a relative neighborhood of that barycenter lies in the simplex, proving $\\operatorname{ri}_H C\\ne\\varnothing$.",
          "inputs": [
            "given",
            "F1",
            "construct"
          ]
        },
        {
          "id": "step-2-1",
          "step": "2.1",
          "claim": "Fix $w,y,t$ as in the Statement. The case $t=0$ is $w\\in\\operatorname{ri}_H C$. Suppose $0<t<1$ and put $q=(1-t)w+ty$. Choose $r>0$ so the relative ball $B_H(w,r)$ lies in $C$. Since $y\\in\\overline{C}^{\\,H}$, choose one $y_*\\in C$ with $\\|y_*-y\\|<(1-t)r/(4t)$. For every $q'\\in B_H(q,(1-t)r/4)$, put $w_*=(q'-ty_*)/(1-t)$. Then $\\|w_*-w\\|<r/2$, so $w_*\\in C$ and $q'=(1-t)w_*+ty_*\\in C$ by [F1]. A relative neighborhood of $q$ lies in $C$, so $q\\in\\operatorname{ri}_H C$.",
          "inputs": [
            "given",
            "F1",
            "choose",
            "algebra"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "Let $C$ be a nonempty convex subset of a finite-dimensional affine Euclidean space $H$. Boundary empty: The item makes no empty boundary claim; this case does not apply to its stated result.",
          "case_scope": {
            "source_section": "Statement",
            "source_excerpt": "For a nonempty set $C$, define $\\operatorname{aff}C=\\{\\sum_{j=1}^N a_jc_j:N\\ge1,\\ c_j\\in C,\\ a_j\\in\\mathbb R,\\ \\sum_j a_j=1\\}$. With a fixed $c_0\\in C$, this is $c_0+\\operatorname{span}\\{c-c_0:c\\in C\\}$, where span consists of finite linear combinations. An affine Euclidean space is such a translate of a finite-dimensional linear subspace with its induced Euclidean distance. Relative balls use this distance; interior means containing a relative ball, and closure means every relative ball meets the set. Let $C$ be a nonempty convex subset of a finite-dimensional affine Euclidean space $H$. Its relative interior $\\operatorname{ri}_H C$ is the interior in $H=\\operatorname{aff}C$. Then $\\operatorname{ri}_H C$ is nonempty. If $w\\in\\operatorname{ri}_H C$, $y\\in\\overline{C}^{\\,H}$, and $0\\le t<1$, then $(1-t)w+ty\\in\\operatorname{ri}_H C$.",
            "current_raw_sha256": "29dec5846060b6112de15ffc98dcd4dbb96e8919c0e26cec15dd6e8b43a4a21e",
            "scope_only_not_proof_acceptance": true
          }
        },
        {
          "case": "zero",
          "status": "checked",
          "evidence": "The t=0 endpoint is handled directly (step 2.1)."
        },
        {
          "case": "one",
          "status": "checked",
          "evidence": "The zero-dimensional affine-hull case is the singleton case (step 1.1)."
        },
        {
          "case": "degenerate",
          "status": "checked",
          "evidence": "The k=0 affine-dimension case is proved separately (step 1.1)."
        },
        {
          "case": "endpoints",
          "status": "checked",
          "evidence": "The included t=0 and excluded closure endpoint t=1 are distinguished (step 2.1)."
        },
        {
          "case": "nonempty-choice",
          "status": "checked",
          "evidence": "Affine-hull dimension supplies finitely many affinely independent points (step 1.1)."
        },
        {
          "case": "iff-forward",
          "status": "not_applicable",
          "reason": "Let $C$ be a nonempty convex subset of a finite-dimensional affine Euclidean space $H$. Boundary iff-forward: The item makes no iff-forward boundary claim; this case does not apply to its stated result.",
          "case_scope": {
            "source_section": "Statement",
            "source_excerpt": "For a nonempty set $C$, define $\\operatorname{aff}C=\\{\\sum_{j=1}^N a_jc_j:N\\ge1,\\ c_j\\in C,\\ a_j\\in\\mathbb R,\\ \\sum_j a_j=1\\}$. With a fixed $c_0\\in C$, this is $c_0+\\operatorname{span}\\{c-c_0:c\\in C\\}$, where span consists of finite linear combinations. An affine Euclidean space is such a translate of a finite-dimensional linear subspace with its induced Euclidean distance. Relative balls use this distance; interior means containing a relative ball, and closure means every relative ball meets the set. Let $C$ be a nonempty convex subset of a finite-dimensional affine Euclidean space $H$. Its relative interior $\\operatorname{ri}_H C$ is the interior in $H=\\operatorname{aff}C$. Then $\\operatorname{ri}_H C$ is nonempty. If $w\\in\\operatorname{ri}_H C$, $y\\in\\overline{C}^{\\,H}$, and $0\\le t<1$, then $(1-t)w+ty\\in\\operatorname{ri}_H C$.",
            "current_raw_sha256": "29dec5846060b6112de15ffc98dcd4dbb96e8919c0e26cec15dd6e8b43a4a21e",
            "scope_only_not_proof_acceptance": true
          }
        },
        {
          "case": "iff-reverse",
          "status": "not_applicable",
          "reason": "Let $C$ be a nonempty convex subset of a finite-dimensional affine Euclidean space $H$. Boundary iff-reverse: The item makes no iff-reverse boundary claim; this case does not apply to its stated result.",
          "case_scope": {
            "source_section": "Statement",
            "source_excerpt": "For a nonempty set $C$, define $\\operatorname{aff}C=\\{\\sum_{j=1}^N a_jc_j:N\\ge1,\\ c_j\\in C,\\ a_j\\in\\mathbb R,\\ \\sum_j a_j=1\\}$. With a fixed $c_0\\in C$, this is $c_0+\\operatorname{span}\\{c-c_0:c\\in C\\}$, where span consists of finite linear combinations. An affine Euclidean space is such a translate of a finite-dimensional linear subspace with its induced Euclidean distance. Relative balls use this distance; interior means containing a relative ball, and closure means every relative ball meets the set. Let $C$ be a nonempty convex subset of a finite-dimensional affine Euclidean space $H$. Its relative interior $\\operatorname{ri}_H C$ is the interior in $H=\\operatorname{aff}C$. Then $\\operatorname{ri}_H C$ is nonempty. If $w\\in\\operatorname{ri}_H C$, $y\\in\\overline{C}^{\\,H}$, and $0\\le t<1$, then $(1-t)w+ty\\in\\operatorname{ri}_H C$.",
            "current_raw_sha256": "29dec5846060b6112de15ffc98dcd4dbb96e8919c0e26cec15dd6e8b43a4a21e",
