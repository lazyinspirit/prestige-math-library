  "load_bearing": [
    {
      "id": "thm-sr-proper-time-and-observer-decomposition",
      "statement": "For C1 future timelike worldlines, η(U,U)=−c²; where the worldline is C2, η(U,A)=0 and nonzero A is spacelike. For future unit timelike n, n⊥ is three-dimensional and positive definite, h(v)=v+η(n,v)n is the rest projection, and v=−η(n,v)n+h(v) uniquely. For future unit n,u, γ=−η(n,u)≥1 and w=ch(u)/γ satisfy u=γ(n+w/c), |w|²=c²(1−γ⁻²)<c², with γ=1 iff u=n.",
      "used_by": [
        "def-sr-observer-congruence-and-kinematics",
        "def-sr-simultaneity-slice-and-rest-distance",
        "lem-sr-radar-midpoint-for-inertial-observer",
        "def-sr-fermi-walker-transport",
        "pthm-sr-four-velocity-norm-and-orthogonality",
        "thm-sr-smooth-local-herglotz-noether"
      ]
    },
    {
      "id": "def-sr-regular-causal-curve-and-worldline",
      "statement": "A future timelike worldline is a C1 curve on an order-convex real domain with at least two elements and future timelike tangent everywhere. Piecewise C1 curves are C1 on finitely many open pieces and have finite one-sided difference-quotient derivatives at both ends of every piece; continuous extension of the open-piece derivative is not required.",
      "used_by": [
        "lem-sr-weak-piecewise-causal-integrability",
        "def-sr-proper-time",
        "def-sr-piecewise-proper-time",
        "def-sr-causal-reachability-in-affine-minkowski-space"
      ]
    },
    {
      "id": "lem-sr-weak-piecewise-causal-integrability",
      "statement": "For the stated weak piecewise C1 curve with nonzero future causal interior and one-sided endpoint tangents, every coordinate derivative is absolutely improperly Riemann integrable and its signed improper integral equals its endpoint increment. The spatial speed and √(−η(x′,x′)) have finite nonnegative improper integrals dominated by the time increment. Piece sums are partition-independent; endpoint displacement is nonzero future causal, strictly timelike if any interior or one-sided endpoint tangent is future timelike, and coordinate time is strictly increasing on every nondegenerate subinterval.",
      "used_by": [
        "def-sr-piecewise-proper-time",
        "lem-sr-piecewise-proper-time-reparametrization-invariance",
        "thm-sr-future-cone-and-flat-domain-of-dependence"
      ]
    },
    {
      "id": "def-sr-piecewise-proper-time",
      "statement": "For a weak piecewise C1 future timelike worldline on [a,b], a<b, total proper time is c⁻¹ times the finite sum of the improper integrals of √(−η(x′,x′)) over its open pieces. It is positive, partition-independent, chart-independent and additive under concatenation; under hypothesis (H), continuous derivative extension to closed pieces, it equals the ordinary Riemann formula.",
      "used_by": [
        "lem-sr-piecewise-proper-time-reparametrization-invariance",
        "post-sr-free-trajectories-and-clock-hypothesis",
        "thm-sr-future-cone-and-flat-domain-of-dependence"
      ]
    },
    {
      "id": "lem-sr-proper-time-parametrization",
      "statement": "For a C1 future timelike worldline, τ′=c⁻¹√(−η(x′,x′))>0, τ is C1 and strictly increasing onto an order-convex image J with at least two elements, and its inverse ρ is C1 with ρ′(τ(s))=1/τ′(s). The curve x∘ρ is a C1 future timelike worldline with tangent x′(s)/τ′(s) at τ(s), parametrized by its own proper time up to an additive constant.",
      "used_by": [
        "def-sr-four-velocity-and-four-acceleration",
        "lem-sr-proper-time-reparametrization-invariance",
        "lem-sr-fermi-walker-transport-existence-and-uniqueness"
      ]
    },
    {
      "id": "def-sr-observer-congruence-and-kinematics",
      "statement": "For a smooth observer congruence, h=η+n♭⊗n♭, a=∇ₙn, θ and ω are the horizontally projected symmetric and antisymmetric halves of ∇n♭, and ∇ₐnᵦ=−nₐaᵦ+θₐᵦ+ωₐᵦ. Born rigidity means Lₙh=0, equivalently θ=0.",
      "used_by": [
        "thm-sr-local-congruence-adapted-charts-and-frobenius",
        "thm-sr-fermi-walker-and-rigid-observer-examples",
        "thm-sr-smooth-local-herglotz-noether",
        "ex-sr-bell-congruence-fails-born-rigidity",
        "cex-sr-born-rigid-motion-need-not-be-killing"
      ]
    },
    {
      "id": "lem-sr-future-causal-sums-and-inertial-coordinate-criterion",
      "statement": "In every inertial chart C+={v:v⁰>|vₛ|} and cl(C+)={v:v⁰≥|vₛ|}; nonzero elements of the closed future cone have v⁰>0. Finite sums remain in the closed future cone and are timelike if a summand is timelike. For D=x(q)−x(p), q∈J+(p) iff D⁰≥|Dₛ| and q∈I+(p) iff D⁰>|Dₛ|.",
      "used_by": [
        "thm-sr-future-cone-and-flat-domain-of-dependence",
        "pthm-sr-causal-signal-order-and-composition",
        "texp-sr-superluminal-relay-antitelephone",
        "ex-sr-causal-diamond-in-one-plus-one"
      ]
    },
    {
      "id": "thm-sr-future-cone-and-flat-domain-of-dependence",
      "statement": "Future causal paths have future-cone endpoint displacement; J+(p)=R+(p), with the straight-segment criterion for distinct endpoints. The causal relation is reflexive, transitive and antisymmetric; no nonconstant closed future causal path exists, and inertial time increases along nonconstant future causal paths. For q∈I+(p), every weak piecewise C1 future timelike worldline from p to q has proper time at most √(−η(q−p,q−p))/c, with equality iff it traverses the straight segment with strictly increasing time coordinate. Proper orthochronous affine Lorentz maps preserve J+, I+ and the causal relation.",
      "used_by": [
        "pthm-sr-causal-signal-order-and-composition",
        "texp-sr-superluminal-relay-antitelephone",
        "cex-sr-null-separated-events-are-not-timelike-joinable",
        "ex-sr-null-legs-compose-to-a-timelike-displacement",
        "pthm-em-general-wave-ivp",
        "pthm-sr-rindler-horizons-and-radar"
      ]
    },
    {
      "id": "lem-sr-boost-time-length-and-velocity-formulas",
      "statement": "For the stated inertial frames related by a collinear boost with |v|<c, the moving clock has dτ/dt=1/γ; a rod at rest in the other frame has measuring-frame simultaneous length L₀/γ; equal unprimed time and longitudinal separation L give Δx′⁰=−γ(v/c)L. For a C1 future causal curve with |w|≤c, w′₁=(w₁−v)/(1−vw₁/c²) and w′⊥=w⊥/[γ(1−vw₁/c²)], with positive denominators and preservation of the timelike and null speed branches.",
      "used_by": [
        "pthm-sr-observer-time-length-and-velocity-measurements",
        "ex-sr-time-dilation-at-beta-three-fifths",
        "ex-sr-length-contraction-of-a-moving-rod",
        "ex-sr-velocity-transformation-worked",
        "rem-sr-twin-acceleration-and-synchronization-caveats"
      ]
    },
    {
      "id": "thm-sr-local-congruence-adapted-charts-and-frobenius",
      "statement": "Smooth nonvanishing fields admit local flow-box charts. A smooth nowhere-zero one-form α has integrable kernel iff α∧dα=0. For an observer congruence with α=n♭, dα(X,Y)=2ω(X,Y) on rest vectors, and α∧dα=0 iff ω=0 iff the rest distribution is locally integrable; its integral hypersurfaces have positive-definite induced metric.",
      "used_by": [
        "thm-sr-fermi-walker-and-rigid-observer-examples",
        "thm-sr-smooth-local-herglotz-noether",
        "ex-sr-rindler-wedge-congruence-worked",
        "ex-sr-rigid-rotation-simultaneity-holonomy"
      ]
    },
    {
      "id": "thm-sr-smooth-local-herglotz-noether",
      "statement": "For a smooth future unit timelike Born-rigid field, on an adapted flow box where ω is nowhere zero, ω and a♭ are basic and da♭=0; every primitive F of a♭ gives the timelike Killing field e^F n. A normalized future timelike Killing field on a connected open set is Born rigid and has vorticity either nowhere zero or identically zero. If θ=ω=0, locally the rest leaves are orthogonal affine hyperplane families of a smooth future unit-speed curve z, with N=1+η(z″∘σ,x−z∘σ)>0, dσ(v)=−η(z′∘σ,v)/N and a=(z″∘σ)/N; the stated tubular constructions also give the converse.",
      "used_by": [
        "cex-sr-born-rigid-motion-need-not-be-killing"
      ]
    },
    {
      "id": "post-sr-causal-signal-propagation",
      "statement": "The admitted transmission relation T⊆A×A satisfies T⊆{(p,q):q∈J+(p)}. This is a necessary endpoint condition, not existence for every causal pair. Ideal vacuum light supplies the null boundary case; independent prearranged spacelike patterns and correlations are not forbidden by the restriction.",
      "used_by": [
        "pthm-sr-causal-signal-order-and-composition",
        "texp-sr-superluminal-relay-antitelephone",
        "pthm-sr-rindler-horizons-and-radar"
      ]
    }
  ],
