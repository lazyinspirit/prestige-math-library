        {
          "fact": "F6",
          "source": "cor-complex-exponential-cartesian-form-modulus-and-eulers-identity",
          "source_section": "Statement",
          "quote": "For real $x,y$, $\\exp(x+iy)=e^x(\\cos y+i\\sin y)$ and $|\\exp(x+iy)|=e^x$.",
          "uses": [
            "1.4",
