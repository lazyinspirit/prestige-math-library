    "lem-qft-fock-one-mode-splitting": {
      "citations": [
        {
          "fact": "A1",
          "source": "def-countable-choice",
          "source_section": "Definition",
          "quote": "The **Axiom of Countable Choice**, written $\\mathrm{AC}_\\omega$, is the following statement.",
          "uses": [
