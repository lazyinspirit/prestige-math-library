        },
        {
          "fact": "F1",
          "source": "lem-nrqm-composites-hilbert-tensor-construction",
          "source_section": "Statement",
          "quote": "Assume the Axiom of Countable Choice ([[def-countable-choice]]). Let $H,K$ be complex Hilbert spaces with the pairing linear in the first argument ([[def-real-and-complex-inner-product-space]],",
          "uses": [
            "2.1",
