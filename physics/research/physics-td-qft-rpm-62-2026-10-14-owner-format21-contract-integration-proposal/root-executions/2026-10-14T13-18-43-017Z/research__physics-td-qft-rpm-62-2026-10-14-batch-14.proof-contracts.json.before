        },
        {
          "supplier": "def-real-power",
          "carrier": "items/def-real-power.md",
          "status": "current published mathematical supplier; exact interface inspected",
          "source_section": "Definition",
          "exact_statement": "For $a>0$ and $x\\in\\mathbb R$, define\n$$a^x:=\\exp(x\\log a).$$\nFor the supplementary zero-base convention, define $0^x:=0$ when $x>0$.",
          "relevant_hypotheses_and_conventions": "The exact excerpt is quoted above; the consumer Facts and proof step state the hypotheses and conventions used.",
          "supplier_proof_status": "Published definition; no proof obligation.",
          "consumer_use": "F9 is used in step(s) 1.1, 4.1, 5.1."
        },
        {
          "supplier": "thm-real-power-laws",
          "carrier": "items/thm-real-power-laws.md",
          "status": "current published mathematical supplier; exact interface inspected",
          "source_section": "Statement",
          "exact_statement": "For $a,b>0$ and $r,s\\in\\mathbb R$,\n$$a^{r+s}=a^ra^s,\\qquad (ab)^r=a^rb^r,\\qquad (a/b)^r=a^r/b^r,\\qquad (a^r)^s=a^{rs}.$$",
          "relevant_hypotheses_and_conventions": "The exact excerpt is quoted above; the consumer Facts and proof step state the hypotheses and conventions used.",
          "supplier_proof_status": "Published mathematical result; current statement and proof carrier inspected.",
          "consumer_use": "F9 is used in step(s) 1.1, 4.1, 5.1."
        },
        {
          "supplier": "thm-real-power-continuity-and-derivatives",
          "carrier": "items/thm-real-power-continuity-and-derivatives.md",
          "status": "current published mathematical supplier; exact interface inspected",
          "source_section": "Statement",
          "exact_statement": "For $a>0$, the function $x\\mapsto a^x$ is continuous on $\\mathbb R$ and\n$$(a^x)'=a^x\\log a.$$\nFor $\\alpha\\in\\mathbb R$, the function $x\\mapsto x^\\alpha$ is continuous and differentiable on $(0,\\infty)$, with\n$$(x^\\alpha)'=\\alpha x^{\\alpha-1}.$$",
          "relevant_hypotheses_and_conventions": "The exact excerpt is quoted above; the consumer Facts and proof step state the hypotheses and conventions used.",
          "supplier_proof_status": "Published mathematical result; current statement and proof carrier inspected.",
          "consumer_use": "F9 is used in step(s) 1.1, 4.1, 5.1."
        },
        {
