          "carrier": "items/def-natural-logarithm.md",
          "status": "current published mathematical supplier; exact interface inspected",
          "source_section": "Definition",
          "exact_statement": "For $x>0$, define $\\log x$ to be the unique real $y$ such that $\\exp(y)=x$. This is well-defined because [[cor-exponential-is-a-bijection-onto-positive-reals]] states that $\\exp:\\mathbb R\\to(0,\\infty)$ is a bijection.",
          "relevant_hypotheses_and_conventions": "The exact excerpt is quoted above; the consumer Facts and proof step state the hypotheses and conventions used.",
          "supplier_proof_status": "Published definition; no proof obligation.",
          "consumer_use": "F9 is used in step(s) 1.1, 4.1, 5.1."
        },
        {
          "supplier": "thm-natural-logarithm-laws",
          "carrier": "items/thm-natural-logarithm-laws.md",
          "status": "current published mathematical supplier; exact interface inspected",
          "source_section": "Statement",
          "exact_statement": "The function $\\log:(0,\\infty)\\to\\mathbb R$ is continuous and strictly increasing, is onto $\\mathbb R$, and satisfies, for $x,y>0$,\n$$\\log(xy)=\\log x+\\log y,\\qquad \\log(x/y)=\\log x-\\log y,\\qquad \\log(1/x)=-\\log x.$$\nAlso $\\log 1=0$.",
          "relevant_hypotheses_and_conventions": "The exact excerpt is quoted above; the consumer Facts and proof step state the hypotheses and conventions used.",
          "supplier_proof_status": "Published mathematical result; current statement and proof carrier inspected.",
          "consumer_use": "F9 is used in step(s) 1.1, 4.1, 5.1."
        },
