          "status": "checked",
          "evidence": "Step 1.1 compares simple-minorant classes, each of which contains the zero function."
        },
        {
          "case": "zero",
          "status": "checked",
          "evidence": "Step 2.1 retains zero coefficients and the shared 0·∞=0 convention."
        },
        {
          "case": "one",
