  "contracts": {
    "lem-tdmath-measure-integral-agrees-with-root-lebesgue-integral": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-tdmath-measure-integral",
          "source_section": "Definition",
          "quote": "A measure space is a triple $(X,\\Sigma,\\mu)$ where $\\Sigma$ contains $\\varnothing,X$ and is closed under complements and countable unions (a $\\sigma$-algebra) of subsets of $X$ and $\\mu:\\Sigma\\to[0,\\infty]$ is countably additive with $\\mu(\\varnothing)=0$. A measurable function $f:X\\to[-\\infty,\\infty]$ has measurable inverse images of Borel sets, where $[-\\infty,\\infty]$ has its order topology: finite open intervals and the endpoint neighborhoods $[-\\infty,a)$ and $(a,\\infty]$ form a basis. Its Borel sigma-algebra is generated by these open sets. A complex-valued function is measurable exactly when its finite real and imaginary parts are measurable, equivalently for the usual Borel structure of $\\mathbb C$. Almost-everywhere assertions mean outside a measurable $\\mu$-null set; completeness of $\\mu$ is not assumed. Nonnegative extended addition uses $a+\\infty=\\infty+a=\\infty$ for $a\\in[0,\\infty]$; positive scalars multiply $\\infty$ to $\\infty$, while $0\\cdot\\infty=0$. Signed expressions $\\infty-\\infty$ remain undefined and are not used in signed integrals. A nonnegative simple function has the form $s=\\sum_{j=1}^m c_j\\mathbf1_{A_j}$ with finitely many disjoint $A_j\\in\\Sigma$ and finite $c_j\\ge0$. Define $c\\mu(A)=+\\infty$ if $c>0$ and $\\mu(A)=+\\infty$, define $0\\cdot\\infty:=0$, and define the finite sum of these extended nonnegative terms to be $+\\infty$ if any term is $+\\infty$ and otherwise the real finite sum of [[def-finite-sum]]. Then $\\int s\\,d\\mu:=\\sum_j c_j\\mu(A_j)$; using canonical level sets $\\{s=c\\}$ makes this value representation-independent. For measurable $f\\ge0$, define $\\int f\\,d\\mu:=\\sup\\{\\int s\\,d\\mu: s\\text{ is simple and }0\\le s\\le f\\}$, using [[def-complete-ordered-field]] for a bounded set of finite values and setting the supremum to $+\\infty$ when the values are unbounded or one is infinite. A real measurable $f$ is integrable when $\\int|f|\\,d\\mu<\\infty$, and then $\\int f:=\\int f^+-\\int f^-$, where $f^+=\\max(f,0)$ and $f^-:=\\max(-f,0)$. Complex integrability and integration are defined by integrable real and imaginary parts.",
          "uses": [
            "1.1",
            "2.1",
            "3.1"
          ]
        },
        {
          "fact": "F2",
          "source": "def-nonnegative-lebesgue-integral",
          "source_section": "Definition",
          "quote": "Let $f:X\\to[0,+\\infty]$ be measurable\n([[def-extended-real-valued-measurable-function]]). Its\n**nonnegative Lebesgue integral** is\n$$\\int f\\,d\\mu:=\\sup\\left\\{\\int s\\,d\\mu:\\ s \\text{ is nonnegative simple and } 0\\le s\\le f\\right\\},$$\nwhere the simple integral on the right is the one from\n[[def-integral-of-a-nonnegative-simple-function]].",
          "uses": [
            "1.1",
            "3.1"
          ]
        },
        {
          "fact": "F3",
          "source": "def-nonnegative-simple-measurable-function",
          "source_section": "Definition",
          "quote": "Let $(X,\\mathcal A,\\mu)$ be a measure space. A measurable function\n$s:X\\to[0,+\\infty)\\subseteq\\overline{\\mathbb R}$\n([[def-extended-real-valued-measurable-function]]) is a\n**nonnegative simple measurable function** when it has finite range.",
          "uses": [
            "1.1",
            "2.1"
          ]
        },
        {
          "fact": "F3",
          "source": "def-simple-function-and-canonical-representation",
          "source_section": "Definition",
          "quote": "Let $(X,\\mathcal{A})$ be a measurable space. A function\n$s : X \\to \\mathbb{R}$ is **simple** when it is measurable and its range is\nfinite.",
          "uses": [
            "1.1",
            "2.1"
          ]
        },
        {
          "fact": "F4",
          "source": "def-measure",
          "source_section": "Definition",
          "quote": "Let $X$ be a set and let $\\mathcal A$ be a sigma-algebra on $X$ ([[def-sigma-algebra]]). A **measure** on $(X,\\mathcal A)$ is a function",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F4",
          "source": "def-integral-of-a-nonnegative-simple-function",
          "source_section": "Definition",
          "quote": "Let $s=\\sum_{j=1}^m c_j\\chi_{E_j}$ be a simple representation of a\nnonnegative simple measurable function\n([[def-nonnegative-simple-measurable-function]]) on a measure space\n$(X,\\mathcal A,\\mu)$, so the $E_j\\in\\mathcal A$ are pairwise disjoint and\n$c_j\\ge0$. Its\n**simple integral** is\n$$\\int s\\,d\\mu:=\\sum_{j=1}^m c_j\\mu(E_j),$$\nwhere $\\mu$ is the given measure ([[def-measure]]) and the convention\n$0\\cdot(+\\infty)=0$ is fixed once and for all.",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F4",
          "source": "lem-well-definedness-of-the-simple-integral",
          "source_section": "Statement",
          "quote": "If a nonnegative simple measurable function $s$ admits two representations\n$$s=\\sum_{i=1}^m c_i\\chi_{E_i}=\\sum_{j=1}^n d_j\\chi_{F_j},$$\nthen the two coefficient sums defining $\\int s\\,d\\mu$ are equal. So\n[[def-integral-of-a-nonnegative-simple-function]] is well defined.",
          "uses": [
            "2.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "step-1-1",
          "claim": "A nonnegative simple function in the thermodynamics definition is a finite\nsum of indicators of disjoint measurable sets, hence is measurable and has\nfinite range; conversely, the level sets in [F3] represent every nonnegative\nfinite-range measurable function in that form. Thus the two definitions use\nthe same class of simple minorants.",
          "step": "1.1",
          "inputs": [
            "F1",
            "F2",
            "F3",
            "construct"
          ]
        },
        {
          "id": "step-2-1",
          "claim": "For any simple minorant $s$, use its canonical level-set representation\nfrom [F3]. Both [F1] and [F4] assign the same finite sum\n$\\sum_j c_j\\mu(A_j)$ to $s$, including zero coefficients on sets of infinite\nmeasure; [F4] ensures the shared value is representation-independent. Hence\nthe two definitions assign the same value to every minorant.",
          "step": "2.1",
          "inputs": [
            "F1",
            "F3",
            "F4",
            "step 1.1"
          ]
        },
        {
          "id": "step-3-1",
          "claim": "The two nonnegative integrals are suprema over the same minorants with the\nsame value for each minorant by steps 1.1 and 2.1. Their suprema therefore agree,\nincluding when the common value is $+\\infty$.",
          "step": "3.1",
          "inputs": [
            "F1",
            "F2",
            "step 1.1",
            "step 2.1"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
