  "load_bearing": [
    {
      "id": "def-em-potential-gauge-and-field-conventions",
      "statement": "For c > 0 and open Ω ⊆ R³ × R, a Cᵏ potential pair consists of scalar φ and vector A of that class. For k ≥ 1 its fields are E = −∇φ − ∂tA and B = curl A, and its Lorenz divergence is G = div A + c⁻²∂tφ, all Cᵏ⁻¹. For k ≥ 2, Tχ(φ,A) = (φ − ∂tχ,A + ∇χ) is Cᵏ⁻¹ for a Cᵏ gauge function. W = c⁻²∂t² − Δ acts on C² functions. Closed slabs use the stated extension sense; the definition asserts no solvability.",
      "used_by": [
        "lem-em-gauge-wave-reachability",
        "lem-em-point-retarded-potential-and-fields",
        "ex-em-causal-wave-kernel-prerequisites-explicit-checks",
        "pthm-em-spacetime-potentials",
        "def-em-gauge-transformation",
        "pthm-em-gauge-invariance",
        "pthm-em-lorenz-gauge-wave-form",
        "pthm-em-gauge-reachability",
        "pthm-em-retarded-potentials",
        "pthm-em-lienard-wiechert",
        "thm-em-retarded-root-and-fields"
      ]
    },
    {
      "id": "lem-em-retarded-wave-kernel",
      "statement": "Assume Countable Choice and c > 0. On Q = R³ × R, K(ψ) = (4π)⁻¹∫ψ(y,|y|/c)|y|⁻¹dy is an absolutely convergent distribution pairing with support exactly {t = |y|/c}. For every h ∈ C_c∞(Q), (K*h)(x,t) = ∫h(y,t − |x−y|/c)/(4π|x−y|)dy is absolutely convergent, C∞, satisfies W(K*h) = h pointwise, and obeys the stated shifted-pairing identity. Distributionally WK = δ_(0,0).",
      "used_by": [
        "lem-em-point-retarded-potential-and-fields",
        "thm-em-retarded-point-distributional-maxwell",
        "ex-em-causal-wave-kernel-prerequisites-explicit-checks",
        "pthm-em-retarded-potentials",
        "thm-em-retarded-root-and-fields"
      ]
    },
    {
      "id": "lem-em-point-retarded-potential-and-fields",
      "statement": "Assume Countable Choice, c > 0, q ∈ R, ε₀ > 0, μ₀ = (c²ε₀)⁻¹, C = q/(4πε₀), and all-time C³ z with |z′| ≤ v_* < c. The proper point current is conserved. The explicit retarded-history pairings are distributions equal to the regular distributions of the locally integrable zero extensions of φ = C/(κr), A = βφ/c. Off the graph these potentials are C² and their C¹ fields satisfy E = C[(1−|β|²)(n−β)/(κ³r²) + n×((n−β)×β̇)/(cκ³r)] and B = n×E/c. Cᵏ trajectories, k ≥ 3, give Cᵏ⁻¹ potentials and Cᵏ⁻² fields; smooth trajectories give smooth objects off the graph.",
      "used_by": [
        "thm-em-retarded-point-distributional-maxwell",
        "ex-em-causal-wave-kernel-prerequisites-explicit-checks",
        "thm-em-retarded-root-and-fields",
        "pthm-em-lienard-wiechert"
      ]
    },
    {
      "id": "thm-em-retarded-point-distributional-maxwell",
      "statement": "Under Countable Choice and the stipulated all-time uniformly subluminal C³ point history, the exact retarded potential distributions, with no independent free addition, satisfy WΦ = ρ/ε₀, WΥ = μ₀J and div Υ + c⁻²∂tΦ = 0. The distributions ℰ = −∇Φ − ∂tΥ and ℬ = curl Υ satisfy div ℰ = ρ/ε₀, div ℬ = 0, curl ℰ = −∂tℬ and curl ℬ = μ₀J + c⁻²∂tℰ. They are precisely the regular distributions of the locally integrable zero extensions of the off-worldline fields, which satisfy source-free classical Maxwell equations off the graph.",
      "used_by": ["pthm-em-lienard-wiechert"]
    },
    {
      "id": "thm-em-causal-dispersive-response",
      "statement": "Assume Countable Choice, and additionally Dependent Choice in clause (c). For d ≥ 1, real matrix K ∈ L¹ and bounded continuous E:R→Rᵈ give an absolutely convergent bounded continuous linear causal convolution. For K ∈ C_c∞((0,∞)), χ(z) = ∫₀∞K(s)e^(izs)ds is entire, χ(−ω) = conjugate χ(ω), has the stated |z|⁻² bounds, and satisfies entrywise Re χ(ω) = π⁻¹ PV∫Im χ(ξ)/(ξ−ω)dξ and Im χ(ω) = −π⁻¹ PV∫Re χ(ξ)/(ξ−ω)dξ. Locally absolutely continuous K with K,K′,sK ∈ L¹ gives the upper-half-plane and boundary branch with the same relations, after subtracting any real instantaneous matrix. For ω,ε₀ > 0, the stipulated harmonic response has averaged work ε₀ω Im(e*χe)/2, nonnegative for every e exactly when (χ−χ*)/(2i) is positive semidefinite.",
      "used_by": [
        "ex-em-causal-response-and-radiation-prerequisites-hypothesis-boundaries",
        "pthm-em-causal-dispersive-response"
      ]
    },
    {
      "id": "thm-em-radiation-asymptotic-flux",
      "statement": "Assume Countable Choice; c,μ₀,a > 0; t₀ < T; globally smooth ρ,J vanishing whenever |y| > a or source time is outside [t₀,T], with ∂tρ + div J = 0. The stated exterior retarded potentials yield the retarded field integrals and agree with the zero-data wave Cauchy solutions on {|x| ≥ 2a} × [t₀,T]. With V(n,u) = ∫_(B_a)J_t(y,u+n·y/c)dy, the fields at (rn,u+r/c) have uniform O(r⁻²) errors from E_lead = μ₀ n×(n×V)/(4πr) and n×E_lead/c for n ∈ S², u ∈ [t₀,T], r ≥ 2a, with constants depending only on the listed parameters and source suprema. For every fixed u ∈ [t₀,T], the outward flux limit equals μ₀/(16π²c)∫_(S²)|n×V(n,u)|²dΩ.",
      "used_by": [
        "ex-em-causal-response-and-radiation-prerequisites-hypothesis-boundaries",
        "pthm-em-dipole-radiation"
      ]
    },
    {
      "id": "lem-em-gauge-wave-reachability",
      "statement": "Assume Countable Choice, c > 0 and t₀ < T. Every extension-sense smooth potential pair on R³ × [t₀,T] admits an extension-sense smooth χ with zero gauge Cauchy data at t₀ and Wχ = G on the open slab. Its transform is smooth, preserves E,B on the closed slab, and has G(Tχ) = G−Wχ = 0 on the open slab. Any two extension-sense C² functions with the same W-image G differ by a homogeneous wave solution. No bounded-domain boundary or decay conclusion is asserted.",
      "used_by": [
        "ex-em-causal-wave-kernel-prerequisites-explicit-checks",
        "pthm-em-gauge-reachability"
      ]
    },
    {
      "id": "thm-em-uncertainty-analysis",
      "statement": "Let n ≥ 1, U ⊆ Rⁿ open, θ₀ ∈ U, |u|₂ = 1, and I an open interval containing zero with θ₀+θu ∈ U throughout I. Let F:U→R be C¹, F(θ₀) = 0 and D_uF(θ₀+θu) ≥ m > 0 throughout I. If |ŷ| ≤ s with s ≥ 0 and |F(θ₀+θu)−ŷ| ≤ δ with δ ≥ 0 at a candidate θ ∈ I, then |θ| ≤ (s+δ)/m and |θu|₂ = |θ|. This is a deterministic conditional bound.",
      "used_by": [
        "ex-em-experiment-analysis-prerequisites-hypothesis-boundaries",
        "pthm-em-specified-model-comparison"
      ]
    },
    {
      "id": "lem-em-smooth-forced-maxwell-cauchy-system",
      "statement": "Assume Countable Choice, positive c,ε,μ with ε μ c² = 1, smooth extension-sense conserved sources on R³ × [t₀,T], and smooth initial fields satisfying div E₀ = ρ(t₀)/ε and div B₀ = 0. The system E_t = c²curl B − J/ε, B_t = −curl E has exactly one extension-sense smooth solution with those data, obeys both Gauss laws, and has the stated closed backward c-cone domain of dependence.",
      "used_by": []
    }
  ],
