    "ex-qft-dirac-rotation-parity": {
      "citations": [
        {
          "fact": "F1",
          "source": "pthm-qft-dirac-free-properties",
          "source_section": "Statement",
          "quote": "For the explicit spatial rotation lift, $S_R(2\\pi)=-I_4$ and $S_R(4\\pi)=I_4$; hence the $2\\pi$ test pullback is $F\\mapsto-F$ and $U_{2\\pi}\\Psi(F)U_{2\\pi}^{-1}=-\\Psi(F)$, while the $4\\pi$ test pullback and field action are identities.",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F2",
          "source": "pthm-qft-dirac-free-properties",
          "source_section": "Statement",
          "quote": "$$U(\\widetilde g)\\Psi(F)U(\\widetilde g)^{-1}=\\Psi(\\tau_{\\widetilde g}F),\\qquad \\tau_{\\widetilde g}F(x)=(S^{-1})^\\dagger F(\\Lambda^{-1}(x-a)),$$",
          "uses": [
            "1.1",
            "3.1"
          ]
        },
        {
          "fact": "F3",
          "source": "pthm-qft-dirac-free-properties",
          "source_section": "Statement",
          "quote": "For all Schwartz spinor tests $F,G$, the bounded smeared field $\\Psi$ is antilinear in its test",
          "uses": [
            "1.1",
            "3.1"
          ]
        }
      ],
