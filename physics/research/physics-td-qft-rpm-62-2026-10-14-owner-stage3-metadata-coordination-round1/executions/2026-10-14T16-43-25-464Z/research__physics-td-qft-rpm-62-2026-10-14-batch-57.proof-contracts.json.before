    "pthm-qft-dirac-free-properties": {
      "citations": [
        {
          "fact": "A1",
          "source": "post-qft-free-field-model",
          "source_section": "Postulate",
          "quote": "As the physical interpretation of this selected free model, assign the real scalar species to the bosonic symmetric Fock representation and assign the Dirac field to the particle/antiparticle CAR representation on $\\mathcal H_+\\oplus\\overline{\\mathcal H_-}$. Choose the zero-particle Fock vectors as the scalar and Dirac vacuum states.",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "A2",
          "source": "def-countable-choice",
          "source_section": "Definition",
          "quote": "The **Axiom of Countable Choice**, written $\\mathrm{AC}_\\omega$, is the following statement.",
          "uses": [
            "1.1",
            "2.1"
          ]
        },
        {
          "fact": "F1",
          "source": "def-qft-free-dirac-model",
          "source_section": "Definition",
          "quote": "For $\\mu>0$, $\\mu=m_{\\mathrm{rest,SI}}c/\\hbar$; $\\mu=0$ is the admitted massless branch. The corresponding SI energy and momentum are $\\hbar c\\omega$ joules and $\\hbar\\mathbf k$ in $\\mathrm{kg\\,m\\,s^{-1}}$.",
          "uses": [
            "1.1",
            "2.1",
            "3.1"
          ]
        },
        {
          "fact": "F1",
          "source": "def-qft-framework-units",
          "source_section": "Definition",
          "quote": "Energy and momentum are $E=\\hbar c\\omega$ in joules and $\\mathbf p=\\hbar\\mathbf k$ in $\\mathrm{kg\\,m\\,s^{-1}}$.",
          "uses": [
            "1.1",
            "2.1",
            "3.1"
          ]
        },
        {
          "fact": "F2",
          "source": "lem-qft-free-dirac-car-locality",
          "source_section": "Statement",
          "quote": "It satisfies $$\\{\\Psi(F),\\Psi(G)\\}=0,\\qquad \\{\\Psi(F),\\Psi(G)^\\dagger\\}=\\langle u_F,u_G\\rangle_{\\mathcal H_D}I.$$",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F3",
          "source": "lem-qft-free-dirac-car-locality",
          "source_section": "Statement",
          "quote": "Spinor tests with compact spacelike-separated supports have vanishing anticommutators with one another and with each other's adjoints. Consequently, even polynomials in the bounded smeared fields commute across spacelike-separated regions.",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F4",
          "source": "lem-qft-dirac-covariance-spectrum",
          "source_section": "Statement",
          "quote": "The fermionic Fock space of [[def-qft-fock-and-test-spaces]] carries a strongly continuous unitary representation $U$ of $\\widetilde G$ such that $$U(\\tilde g)\\Psi(F)U(\\tilde g)^{-1}=\\Psi(\\tau_{\\tilde g}F).$$",
          "uses": [
            "2.1",
            "3.1"
          ]
        },
        {
          "fact": "F5",
          "source": "lem-qft-dirac-projection-matrices",
          "source_section": "Statement",
          "quote": "$S_R(\\theta)=\\cos(\\theta/2)I_4-i\\sin(\\theta/2)\\Sigma_{\\mathbf n}$",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F6",
          "source": "thm-quarter-turn-values-and-shift-formulas",
          "source_section": "Statement",
          "quote": "For every real $x$, $$\\sin(x+\\pi/2)=\\cos x,\\quad\\cos(x+\\pi/2)=-\\sin x,\\quad\\sin(x+\\pi)=-\\sin x,\\quad\\cos(x+\\pi)=-\\cos x.$$ In particular, $$\\sin(\\pi/2)=1,\\quad\\cos(\\pi/2)=0,\\quad\\sin\\pi=0,\\quad\\cos\\pi=-1.$$",
          "uses": [
            "2.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "d-1.1",
          "claim": "Under the adopted model, the conditional field proof establishes CAR, the tested Dirac equation and vanishing cross anticommutators for spacelike-separated supports. Taking adjoints supplies the adjoint-adjoint case; swapping each of r and s factors gives sign (-1)^(rs), equal to +1 when both degrees are even, and bilinearity gives finite even-polynomial commutation.",
          "step": "1.1",
          "inputs": [
            "A1",
            "A2",
            "F1",
            "F2",
            "F3",
            "given",
            "algebra"
