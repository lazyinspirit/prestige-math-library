          "id": "thm-qftx-gaga-analytic-projective-dolbeault-scalar-cohomology-5-1",
          "claim": "For $E=\\mathcal O_X$, [F10] identifies its holomorphic-section sheaf with $\\mathcal O$. Then [F11] supplies $H^0(X,\\mathcal O)=\\mathbb C$ and $H^q(X,\\mathcal O)=0$ for $q>0$ in every stated dimension, as claimed.",
          "step": "5.1",
          "inputs": [
            "F10",
            "F11",
            "given",
            "algebra"
          ]
        }
      ],
