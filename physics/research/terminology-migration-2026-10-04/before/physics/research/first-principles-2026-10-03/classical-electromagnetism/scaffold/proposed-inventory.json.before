  "items": [
    {
      "id": "def-em-lab-geometry",
      "kind": "definition",
      "domain": "physics",
      "title": "Oriented SR inertial-chart restriction and spatial fields",
      "deps": [
        "def-ck-euclidean-maps-and-diffeomorphisms",
        "def-euclidean-inner-product",
        "def-vector-space",
        "lem-standard-basis-of-f-n",
        "def-directional-and-partial-derivatives",
        "def-sr-affine-minkowski-model",
        "post-sr-inertial-covariance"
      ],
      "strategy": "Exact definition-contracts.md; SR S0/S1 geometry, x0=ct, spacelike Euclidean slices",
      "design_state": "explicit-definition-contract; supplier-validation-recorded-separately",
      "dependency_level": 0,
      "dependency_roles": {
        "def-ck-euclidean-maps-and-diffeomorphisms": "mathematical-premise",
        "def-euclidean-inner-product": "mathematical-premise",
        "def-vector-space": "mathematical-premise",
        "lem-standard-basis-of-f-n": "mathematical-premise",
