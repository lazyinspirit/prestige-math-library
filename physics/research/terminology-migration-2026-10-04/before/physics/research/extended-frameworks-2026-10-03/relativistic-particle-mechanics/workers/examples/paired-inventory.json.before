    {
      "id": "pthm-rpm-constant-electric-orbit",
      "title": "Exact constant electric field trajectories",
      "domain": "physics",
      "kind": "physical-theorem",
      "deps": [
        "SR0",
        "SR7",
        "CS02",
        "NRE2"
      ],
      "proof_module": "proofs.md#X1",
      "scope": "Fixed external uniform E, B=0; m>0; arbitrary finite initial momentum; no self-force",
      "page": "rpm-constant-electric-orbit",
      "side": "A",
      "status": "complete conditional local research argument"
    },
