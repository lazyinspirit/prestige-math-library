add('thm-qsm-product-thermal-state-nonnormal','Thermal product state has no normal vacuum extension','theorem',['lem-qsm-vacuum-representation-irreducible','thm-qsm-onsite-product-kms'],'i8','q>=2,full-rank onsite density,p0<1; decreasing prefix projections and increasing basis sums',nn)
