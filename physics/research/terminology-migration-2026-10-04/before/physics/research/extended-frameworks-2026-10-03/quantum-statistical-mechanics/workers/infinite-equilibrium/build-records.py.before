local={r['id']:r for r in rows}
for r in rows:
 r['dependency_roles']={x:('mathematical-premise' if r['domain']=='mathematics' or not(x in local and local[x]['domain']=='physics') else 'physical-assumption' if x.startswith('post-') else 'physical-result' if x.startswith('pthm-') else 'formulation-prerequisite') for x in r['deps']}
(p/'inventory.json').write_text(json.dumps({'version':1,'items':rows,'supplier_first_order':[r['id'] for r in rows if r['side']=='A'],'external_supplier_ids':sorted({x for r in rows for x in r['deps'] if x not in local})},indent=2)+'\n')
