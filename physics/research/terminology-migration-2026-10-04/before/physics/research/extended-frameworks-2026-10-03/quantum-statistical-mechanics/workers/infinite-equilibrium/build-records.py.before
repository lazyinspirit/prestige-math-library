add('lem-qsm-consistent-local-states','Consistent local densities extend to an algebraic state','lemma',['def-qsm-infinite-algebraic-state','lem-qsm-matrix-state-calculus'],'i1','Positive matrix densities; finite partial-trace consistency; norm1 extension',st)
add('lem-qsm-spin-state-compactness','Local spin-state sequential compactness','lemma',['lem-qsm-consistent-local-states','def-countable-choice'],'i1','Countable local matrices; finite density sets; pointwise all-observable convergence',st)
add('lem-qsm-state-gns-construction','Cyclic representation of a quasi-local state','lemma',['lem-qsm-consistent-local-states','lem-qsm-quasilocal-completion'],'i1a','Null left ideal/Cauchy-Schwarz/bounded left multiplication; state-specific Hilbert representation',st)
add('def-qsm-bounded-finite-range-interaction','Uniformly bounded finite-range quantum spin interaction','definition',['def-qsm-local-spin-algebras'],'i0','Finite M,R,kappa; self-adjoint local terms; explicit multiplicities',dy)
