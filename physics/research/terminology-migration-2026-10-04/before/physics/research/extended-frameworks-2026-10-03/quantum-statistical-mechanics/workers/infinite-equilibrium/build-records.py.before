from pathlib import Path
import json,hashlib,re
p=Path(__file__).parent; root=Path.cwd(); rows=[]
def add(i,t,k,deps,module,scope,page,domain='mathematics',side='A'):
 rows.append(dict(id=i,title=t,domain=domain,kind=k,deps=deps,proof_module='proof-modules.md#'+module,scope=scope,page=page+('-examples' if side=='B' else ''),side=side,status='complete-scoped-research-argument' if k not in ['definition','postulate','remark'] else 'research-definition-adoption-or-disposition'))
st='qsm-quasilocal-states';dy='qsm-finite-range-spin-dynamics';tl='qsm-spin-thermodynamic-limits';km='qsm-kms-equilibrium';ph='qsm-commuting-quantum-phases';nn='qsm-nonnormal-thermal-states';pp='qsm-infinite-spin-physical-models'
add('def-qsm-local-spin-algebras','Local spin matrix algebras and isometric inclusions','definition',['lem-qsm-matrix-state-calculus'],'i0','q finite; integer lattice; explicit tensor inclusions and support',st)
