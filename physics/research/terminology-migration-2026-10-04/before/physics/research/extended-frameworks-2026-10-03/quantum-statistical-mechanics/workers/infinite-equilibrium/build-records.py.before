add('def-qsm-kms-state','Physical-time KMS strip equilibrium condition','definition',['def-qsm-infinite-algebraic-state','thm-qsm-finite-range-spin-dynamics'],'i5','beta>0; strip width beta*hbar seconds; bounded continuous analytic functions for all pairs',km)
