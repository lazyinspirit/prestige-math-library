    "lem-choice-free-smooth-inverse-function-theorem-in-euclidean-space": {
      "id": "lem-choice-free-smooth-inverse-function-theorem-in-euclidean-space",
      "path": "items/lem-choice-free-smooth-inverse-function-theorem-in-euclidean-space.md",
      "status": "published",
      "domain": "mathematics",
      "kind": "lemma",
      "exact_statement": "In ZF, let $n\\ge1$, let $U\\subseteq\\mathbb R^n$ be open, let $f:U\\to\\mathbb R^n$ be smooth, and let $a\\in U$. If $Df(a)$ is invertible, then there are open neighbourhoods $a\\in V\\subseteq U$ and $f(a)\\in W$ such that $f|_V:V\\to W$ is a diffeomorphism. Writing $g=(f|_V)^{-1}$,\n$$Dg(y)=Df(g(y))^{-1}\\qquad(y\\in W).$$\nNo choice axiom is used.",
      "sha256": "2974fff5001ecf2457e31176568aa57c3a1ec81a098be67d1cf01b578c3bedbc",
      "reading_status": "status/statement extracted; actual proof-reading extent belongs to specialist supplier record",
      "consumers": [
        "thm-emg-xs-rn-crossing"
      ],
      "home_kind": "canonical-root-item",
