    "thm-picard-lindelof-local-existence-and-uniqueness": {
      "id": "thm-picard-lindelof-local-existence-and-uniqueness",
      "path": "items/thm-picard-lindelof-local-existence-and-uniqueness.md",
      "status": "published",
      "domain": "mathematics",
      "kind": "theorem",
      "exact_statement": "Let $D\\subseteq\\mathbb R\\times\\mathbb R^n$ be open, let $F:D\\to\\mathbb R^n$ be continuous and locally Lipschitz in the state variable, and let $(t_0,x_0)\\in D$. Then a unique local solution of the IVP exists on some interval around the initial time. More quantitatively, if $h,r>0$ make\n\n$$[t_0-h,t_0+h]\\times\\overline B(x_0,r)\\subseteq D,$$\n\nif $\\|F\\|_2\\le M$ and $F$ has state-Lipschitz constant $L$ on this cylinder, and if $hM\\le r$ and $Lh<1$, then there is exactly one solution on $[t_0-h,t_0+h]$ through $(t_0,x_0)$ whose graph lies in the cylinder. Any two solutions through the same initial data agree on every common subinterval containing $t_0$.\n\nIn particular, a unique local solution exists on an interval around the initial time.",
      "sha256": "c5929085a3cde39dfb9bdeb634760148a8c1d52009f1a5a64da56d778265ae28",
      "reading_status": "status/statement extracted; actual proof-reading extent belongs to specialist supplier record",
      "consumers": [
        "thm-emg-weak-slow-test-lorentz-limit"
      ],
      "home_kind": "canonical-root-item",
      "original_page_homes": [
        {
          "path": "library/real-analysis/picard-lindelof-and-first-order-odes.md",
          "page": "picard-lindelof-and-first-order-odes",
          "is_B": false,
          "status": "published"
        }
      ]
    },
