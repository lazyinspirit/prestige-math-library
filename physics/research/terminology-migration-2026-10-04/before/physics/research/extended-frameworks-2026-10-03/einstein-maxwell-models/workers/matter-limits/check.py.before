from pathlib import Path
import json
p=Path(__file__).parent;o=json.loads((p/'inventory.json').read_text());rows=o['items'];by={r['id']:r for r in rows};errors=[]
if len(by)!=len(rows):errors.append('duplicate IDs')
external={d for r in rows for d in r['deps'] if d not in by}
registry=json.loads((p/'supplier-map.json').read_text())['external_suppliers'];exby={r['id']:r for r in registry}
for d in external:
 if d not in exby:errors.append('unregistered external '+d)
for r in rows:
 if set(r['deps'])!=set(r['dependency_roles']):errors.append(r['id']+' role mismatch')
 if r['kind'] in ['postulate','physical-theorem'] and r['domain']!='physics':errors.append('kind domain '+r['id'])
 module,anchor=r['proof_module'].split('#')
 if '<a id="'+anchor+'"></a>' not in (p/module).read_text():errors.append('anchor '+r['id'])
 for d in r['deps']:
  sr=by.get(d,exby.get(d))
  if sr is None:continue
  if r['domain']=='mathematics' and sr['domain']!='mathematics':errors.append('physical premise of math '+r['id']+' <- '+d)
  if d in by and by[d]['side']=='B':errors.append('B leaf consumed '+d)
 if r['domain']=='physics' and not r['physical_scope']:errors.append('scope '+r['id'])
seen=set();active=set()
def visit(i):
 if i in active:errors.append('cycle '+i);return
 if i in seen:return
 active.add(i)
 for d in by[i]['deps']:
  if d in by:visit(d)
 active.remove(i);seen.add(i)
for i in by:visit(i)
counts={pg:sum(r['page']==pg for r in rows)for pg in {r['page']for r in rows}}
for pair in o['page_pairs']:
 if len({r['domain']for r in rows if r['page']in[pair['a'],pair['b']]})!=1:errors.append('mixed pair '+pair['a'])
 if any(counts.get(pair[s],0)>100 for s in ['a','b']):errors.append('page overflow '+pair['a'])
result={'date':'2026-10-04','command':'python3 '+str(p/'check.py'),'items':len(rows),'pairs':len(o['page_pairs']),'page_counts':dict(sorted(counts.items())),'external_suppliers':sorted(external),'actual_html_anchors':True,'math_only_premises_checked_against_domains':True,'B_leaves':True,'local_DAG':True,'homogeneous_pairs':True,'errors':errors,'research_only_not_independent_acceptance':True}
(p/'structural-check.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result,indent=2));raise SystemExit(bool(errors))
