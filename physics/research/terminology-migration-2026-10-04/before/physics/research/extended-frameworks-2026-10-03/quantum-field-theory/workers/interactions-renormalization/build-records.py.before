b=Path(__file__).parent;r=[]
def add(id,title,kind,deps,sec,scope,page,side='A',domain='mathematics'):
 row=dict(id=id,title=title,domain=domain,kind=kind,deps=deps,roles={d:('physical-assumption' if d.startswith('post-') else 'physical-result' if d.startswith('pthm-') else 'formulation-prerequisite' if d=='def-qft-framework-units' else 'mathematical-premise') for d in deps},page=page,side=side,proof_module='workers/interactions-renormalization/proofs.md#'+sec,scope=scope,status='proposed-research',proof_status='defined' if kind=='definition' else 'source-and-scope-only' if kind in ['postulate','remark'] else 'complete-exact-argument')
 if domain=='physics':row.update(physical_scope=scope,empirical_premises=[])
 r.append(row)
