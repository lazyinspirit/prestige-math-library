for file,title,url,extent,uses,fail in [
 ('brunetti-fredenhagen','Brunetti and Fredenhagen, Microlocal analysis and interacting quantum field theories: renormalization on physical backgrounds','https://arxiv.org/pdf/math-ph/9903028','PDF pp22–27 fully displayed/read, including complete point-extension Theorems5.2/5.3 proofs pp23–25; source38pages retained, not whole manuscript read',['IR05G exact arbitraryfinite-scalingdegree point extension; Baire/movingtest/decomposition details supplied locally','IR06 logscaling origin context; no unexamined general microlocal/causalEG theorem consumed'],[]),
 ('tong-qft','David Tong, Quantum Field Theory lecture notes','https://www.damtp.cam.ac.uk/user/tong/qft/qft.pdf','PDF pp27–31,53–56,62–65 fully read; printed pp21–25,47–50,56–59; canonical/operator formalism, interaction/engineering dimensions and complete displayed Wick induction; source155pages retained, not whole course read',['restricted canonical physicalmodel motivation','IR03/IR04 Wick calculations comparison','IR07 engineering dimensions; no source informal continuum pointproducts or convergence accepted'],['Initial curl failed TLS certificate chain validation; fitz had nofile following that failure','Recovered bycurl -k at same author URL, hashes retained; TLSidentity verification not claimed'])]:
 path=b/'sources/raw'/f'{file}.pdf';src.append(dict(title=title,url=url,raw_path=str(path),sha256=hashlib.sha256(path.read_bytes()).hexdigest(),retrieval='full PDF downloaded/extracted with installed fitz',reading_extent=extent,uses=uses,retrieval_failures=fail,license='No redistribution permission inferred; raw locally retained and ignored'))
