ids={x['id']:x for x in r};external=set(external_math+external_physics);color={}
assert len(ids)==len(r)
def visit(i):
 assert color.get(i)!=1,i
 if color.get(i)==2:return
 color[i]=1
 for dep in ids[i]['deps']:
  assert dep in ids or dep in external,(i,dep)
  if dep in ids:
   assert ids[dep]['side']=='A',(i,dep)
   if ids[i]['domain']=='mathematics':assert ids[dep]['domain']=='mathematics',(i,dep)
   visit(dep)
  elif ids[i]['domain']=='mathematics':assert dep in external_math
 color[i]=2
for i in ids:visit(i)
proof=(b/'proofs.md').read_text()
for x in r:assert 'id="'+x['proof_module'].split('#')[1]+'"' in proof,x['id']
page_edges={}
for x in r:
 key=(x['page'],x['side']);page_edges.setdefault(key,set())
 for dep in x['deps']:
  if dep in ids:
   target=(ids[dep]['page'],ids[dep]['side'])
   if target!=key:page_edges[key].add(target)
pc={}
def pv(k):
 assert pc.get(k)!=1,k
 if pc.get(k)==2:return
 pc[k]=1
 for x in page_edges.get(k,[]):pv(x)
 pc[k]=2
for k in page_edges:pv(k)
for pg in pages:
 assert len(pg['A'])<100 and len(pg['B'])<100
 assert all(ids[i]['domain']==pg['domain'] for i in pg['A']+pg['B'])
report=dict(local_only=True,independent_acceptance=False,items=len(r),unique_ids=True,declared_deps_resolved=True,item_DAG=True,side_page_DAG=True,pure_math_boundary=True,homogeneous_pages=True,B_leaves=True,under100_each=True,anchors=True,page_counts={x['page']:{'A':len(x['A']),'B':len(x['B'])} for x in pages})
(b/'structural-checks.json').write_text(json.dumps(report,indent=2)+'\n');print(json.dumps(report))
