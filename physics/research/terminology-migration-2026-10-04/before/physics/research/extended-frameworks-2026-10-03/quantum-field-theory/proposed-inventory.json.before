    "thm-fourier-inversion-on-schwartz-space": {
      "id": "thm-fourier-inversion-on-schwartz-space",
      "path": "items/thm-fourier-inversion-on-schwartz-space.md",
      "status": "published",
      "domain": "mathematics",
      "kind": "theorem",
      "exact_statement": "Assume countable choice. For every $f\\in\\mathcal S(\\mathbb R^n)$ and every $x\\in\\mathbb R^n$,\n$$f(x)=\\int_{\\mathbb R^n}\\widehat f(\\xi)e^{2\\pi ix\\cdot\\xi}\\,d\\xi.$$\nThe integral is absolutely convergent.",
      "sha256": "23a09a11dcdfcf44de28b64b15cd1f9ea0944bb82cd0efb1352de55176efe73f",
      "reading_status": "status/statement extracted; actual proof-reading extent belongs to specialist supplier record",
      "consumers": [
