          "page": "fundamental-solutions-newtonian-potentials-and-green-functions",
          "is_B": false,
          "status": "published"
        }
      ]
    },
    "thm-stone-one-parameter-unitary-groups": {
      "id": "thm-stone-one-parameter-unitary-groups",
      "path": "items/thm-stone-one-parameter-unitary-groups.md",
      "status": "published",
      "domain": "mathematics",
      "kind": "theorem",
      "exact_statement": "Assume the Axiom of Choice. The map $T\\mapsto U(t)=e^{itT}$, computed by the\nBorel functional calculus of $T$\n([[thm-unbounded-borel-functional-calculus]]), is a bijection from the set of\nself-adjoint operators on $H$ onto the set of strongly continuous\none-parameter unitary groups on $H$. Its inverse assigns to $U$ its generator\n$G$ and the self-adjoint operator $T=-iG$; here $D(T)=D(G)$ is exactly the set\nof vectors at which $t\\mapsto U(t)x$ is differentiable at $0$, and\n$\\frac1t(U(t)x-x)\\to iTx$ for $x\\in D(T)$.",
      "sha256": "cb16f0665a836ca0d33a89803483b7d8bd529c6d4bba9d6ae3fbced023d2ac39",
      "reading_status": "status/statement extracted; actual proof-reading extent belongs to specialist supplier record",
      "consumers": [
        "lem-qft-lattice-physical-evolution"
      ],
