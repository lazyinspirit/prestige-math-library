    "thm-fourier-transform-maps-schwartz-space-continuously-to-itself": {
      "id": "thm-fourier-transform-maps-schwartz-space-continuously-to-itself",
      "path": "items/thm-fourier-transform-maps-schwartz-space-continuously-to-itself.md",
      "status": "published",
      "domain": "mathematics",
      "kind": "theorem",
      "exact_statement": "Assume countable choice. The negative-sign, $2\\pi$-normalized Fourier transform is continuous $\\mathcal F:\\mathcal S\\to\\mathcal S$, and\n$$\\mathcal F(\\partial^\\alpha f)(\\xi)=(2\\pi i\\xi)^\\alpha\\widehat f(\\xi),\\qquad \\partial^\\beta\\widehat f=\\mathcal F((-2\\pi ix)^\\beta f).$$",
      "sha256": "1443ab5179dec2743f967465b275e6e6eba20e890a2cd86b04ea12b7ce6db1b0",
      "reading_status": "status/statement extracted; actual proof-reading extent belongs to specialist supplier record",
