    "thm-plancherel": {
      "id": "thm-plancherel",
      "path": "items/thm-plancherel.md",
      "status": "published",
      "domain": "mathematics",
      "kind": "theorem",
      "exact_statement": "Assume countable choice and let $n\\ge1$. Fourier transformation on Schwartz space extends uniquely to a surjective complex-linear isometry $\\mathcal F_2:L^2(\\mathbb R^n;\\mathbb C)\\to L^2(\\mathbb R^n;\\mathbb C)$. It preserves the first-variable-linear inner product, and hence is unitary.",
