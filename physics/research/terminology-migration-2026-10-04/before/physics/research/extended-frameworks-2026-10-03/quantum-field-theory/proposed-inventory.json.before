  "external_suppliers": {
    "thm-completion-of-an-inner-product-space-is-hilbert": {
      "id": "thm-completion-of-an-inner-product-space-is-hilbert",
      "path": "items/thm-completion-of-an-inner-product-space-is-hilbert.md",
      "status": "published",
      "domain": "mathematics",
      "kind": "theorem",
      "exact_statement": "Assume the Axiom of Countable Choice. Let $X$ be a real or complex inner-product space and let $(\\widehat X,\\kappa)$ be its norm completion ([[def-completion-of-a-normed-space]]). Then $\\widehat X$ carries a unique inner product that extends the given one along $\\kappa$ and whose induced length is the completion norm; with it $\\widehat X$ is a Hilbert space, and the extension is unique among inner products that extend the given pairing and induce the completion norm.",
      "sha256": "58a58ed60d9214f77e19732317b94f42f37355487b7f62d4304872d6d74bf461",
      "reading_status": "status/statement extracted; actual proof-reading extent belongs to specialist supplier record",
