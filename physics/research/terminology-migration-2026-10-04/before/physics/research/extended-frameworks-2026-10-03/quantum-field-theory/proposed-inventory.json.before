    "lem-c-one-change-of-variables-for-nonnegative-borel-functions-via-radon-uniqueness": {
      "id": "lem-c-one-change-of-variables-for-nonnegative-borel-functions-via-radon-uniqueness",
      "path": "items/lem-c-one-change-of-variables-for-nonnegative-borel-functions-via-radon-uniqueness.md",
      "status": "published",
      "domain": "mathematics",
      "kind": "lemma",
      "exact_statement": "Assume $\\mathrm{AC}_\\omega$. Let $m\\ge1$, let U,V be open subsets of $\\mathbb R^m$, and let $T:U\\to V$ be a $C^1$ diffeomorphism. For every nonnegative Borel $h:V\\to[0,\\infty]$, $\\int_V h(y)\\,dy=\\int_U h(T(x))|\\det DT(x)|\\,dx$, with equality in $[0,\\infty]$ and $0\\cdot\\infty=0$. This statement concerns Borel h; no completed-measurable substitution is asserted.",
      "sha256": "d0885c6e402cce0f2ea0c28997fa15ad9e59f58d98aec6834225599e4dd8b51c",
      "reading_status": "status/statement extracted; actual proof-reading extent belongs to specialist supplier record",
