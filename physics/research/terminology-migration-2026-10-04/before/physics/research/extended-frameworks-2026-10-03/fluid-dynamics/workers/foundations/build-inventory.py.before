add('pthm-fd-perfect-gas-temperature','Perfect-gas entropy, isentropic law and temperature balance','physics','physical-theorem','FD-F03',['post-fd-continuum-balances','post-fd-local-equilibrium','lem-fd-gibbs-entropy-residual'],'F07','Explicit adopted R,c_v>0 closure with dimensionless logarithms; full c_v temperature dynamics, uniform versus trajectory entropy distinguished.')
