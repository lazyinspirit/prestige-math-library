for row in rows:
 roles={}
 for d in row['deps']:
  supplier=byid.get(d,external.get(d,{}))
  if supplier.get('domain')=='mathematics': role='mathematical-premise'
  elif supplier.get('kind')=='postulate': role='physical-assumption'
  elif supplier.get('kind') in ['physical-theorem','thought-experiment']: role='physical-result'
  else: role='formulation-prerequisite'
  if row['kind']=='postulate':role='formulation-prerequisite'
  roles[d]=role
 row['dependency_roles']=roles
 row['source_references']=[{'title':'Tong, Fluid Mechanics','url':'https://www.damtp.cam.ac.uk/user/tong/fluids/fluids.pdf','reading_record':'supplier-reading.md'}] if row['domain']=='physics' else []
 if 'conformation' in row['id'] or 'nonnewtonian' in row['id']:
  row['source_references'].append({'title':'Barrett and Boyaval, Oldroyd-B','url':'https://arxiv.org/pdf/0907.4066','reading_record':'supplier-reading.md'})
 row['physical_scope']=row['scope'] if row['domain']=='physics' else None
 row['proof_status']='source-scope-review-only' if row['kind']=='postulate' else row['status']
