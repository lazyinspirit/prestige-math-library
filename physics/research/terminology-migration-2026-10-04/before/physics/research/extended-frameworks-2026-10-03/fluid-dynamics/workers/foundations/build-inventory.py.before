add('lem-fd-local-balance-equivalence','Momentum, angular, kinetic/internal and total balance algebra','mathematics','lemma','FD-MF02',['lem-fd-transport-and-density','lem-fd-cauchy-contact','thm-divergence-theorem-for-bounded-c-one-euclidean-domains'],'F04','Smooth positive density; continuity; linear/angular integral equations; ACω surface theorem; full energy split F03–F04.')
add('lem-fd-weak-jump-consistency','Smooth weak equivalence and moving jump residual','mathematics','lemma','FD-MF02',['def-fd-conservative-weak-form'],'F06','Piecewise C¹ states and C¹ interface with finite traces; [F]n=Vn[U], physical entropy interface sign ≥0; no entropy-system existence.')
add('pthm-fd-cauchy-momentum-angular','Cauchy stress, local momentum and stress symmetry','physics','physical-theorem','FD-F02',['post-fd-continuum-balances','lem-fd-cauchy-contact','lem-fd-local-balance-equivalence'],'F03','Nonpolar adopted contact/linear/angular balance gives t=σn,σ symmetric and rho Dtu=rho b+divσ.')
