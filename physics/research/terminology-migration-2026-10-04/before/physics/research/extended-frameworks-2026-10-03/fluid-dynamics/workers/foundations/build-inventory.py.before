add('pthm-fd-energy-decomposition','Kinetic/internal/total energy and boundary work','physics','physical-theorem','FD-F02',['post-fd-continuum-balances','lem-fd-local-balance-equivalence'],'F04','rho Dte=σ:D−divq+rho r; energy with conservative potential; compatible closed/periodic data.')
add('pthm-fd-conservation-jump-laws','Fluid conservation and entropy jump conditions','physics','physical-theorem','FD-F02',['post-fd-continuum-balances','lem-fd-weak-jump-consistency'],'F06','Adopt weak integral balances as weak extension; piecewise smooth jump algebra only, no smooth-balance theorem through shocks.')
