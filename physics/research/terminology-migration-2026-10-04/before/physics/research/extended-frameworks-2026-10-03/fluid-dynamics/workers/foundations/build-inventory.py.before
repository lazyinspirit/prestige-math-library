import pathlib,json,re
p=pathlib.Path(__file__).parent
f=p/'foundation-proofs.md';text=f.read_text()
for i in range(12):
 code=f'F{i:02d}';text=text.replace(f'## {code} —',f'<a id="{code}"></a>\n\n## {code} —') if f'<a id="{code}"></a>' not in text else text
text=text.replace('A FD-F01: mathematical configurations/kinematics, classical-frame adoption, primitive quantities, continuum adoption, F01 transport/inverse labels, F02 observer/objectivity. A FD-F02:', 'Mathematical A FD-MF01: configurations/kinematics, F01 transport/inverse labels and F02 observer calculus. Physical A FD-F01: classical-frame and continuum adoption, primitive quantities and their physical kinematic interpretations. Mathematical A FD-MF02: F03–F06 integral/local/conservative algebra under explicit equation hypotheses. Physical A FD-F02:')
text=text.replace('A FD-F03: local-equilibrium', 'Mathematical A FD-MF03: F07–F08 response, chart and constitutive algebra. Physical A FD-F03: local-equilibrium').replace('A FD-F04: F09', 'Mathematical A FD-MF04: F09 law definitions, monotone graph and conformation algebra. Physical A FD-F04: F09 adopted material branches and conditional interpretation of')
f.write_text(text)
rows=[]
def add(id,title,domain,kind,page,deps,mod,scope,roles=None):
 rows.append(dict(id=id,title=title,domain=domain,kind=kind,page=page,deps=deps,dependency_roles=roles or {d:('mathematical-premise' if domain=='mathematics' or d.startswith(('def-','lem-','thm-','prop-','NR-','TD-')) else 'physical-assumption') for d in deps},proof_module=f'{f.name}#{mod}',scope=scope,status='explicit-definition' if kind=='definition' else 'adopted-source-scoped-postulate' if kind=='postulate' else 'completed-local-argument',empirical_premises=[],production_ready=False))
add('def-fd-smooth-motion','Smooth material configurations and Eulerian fields','mathematics','definition','FD-MF01',[],'F00','C² diffeomorphic family on neighborhood of bounded C¹ reference body; positive Jacobian, inverse labels, strain-rate definitions.')
add('lem-fd-transport-and-density','Smooth transport, Jacobian and advected reference density','mathematics','lemma','FD-MF01',['def-fd-smooth-motion','thm-change-of-variables-for-compact-jordan-sets','thm-chain-rule-for-total-derivatives'],'F01','Continuous-parameter fixed-domain differentiation; continuity equation exactly equivalent to mass integral and rho J invariant; no weak/vacuum inverse.')
add('lem-fd-observer-calculus','Rigid observer calculus and objective strain rate','mathematics','lemma','FD-MF01',['def-fd-smooth-motion','thm-chain-rule-for-total-derivatives'],'F02','C² Q(t),c(t); D*=QDQ^T, acceleration includes 2Qprime u+Qdoubleprime x+c doubleprime.')
add('def-fd-quantity-and-frame-conventions','Classical frames, primitive quantities and SI units','physics','definition','FD-F01',['def-fd-smooth-motion'],'F00','Explicit Galilean spacetime and inertial/observer distinction; every introduced quantity role and unit.')
add('post-fd-continuum-balances','Single-component nonpolar continuum and material balances','physics','postulate','FD-F01',['def-fd-quantity-and-frame-conventions','lem-fd-transport-and-density'],'F00','P-CONT,P-CONTACT,P-MASS,P-MOM,P-ENERGY,P-ENTROPY; smooth material regions, local bounded contact, no couples, heat supply at local T.',{ 'def-fd-quantity-and-frame-conventions':'formulation-prerequisite','lem-fd-transport-and-density':'formulation-prerequisite'})
add('pthm-fd-smooth-material-kinematics','Mass density reconstruction and incompressibility','physics','physical-theorem','FD-F01',['post-fd-continuum-balances','lem-fd-transport-and-density'],'F01','rho(t,chi)J=rho0 J0; positive-density D_t rho=0 iff div u=0, spatially variable density allowed.')
