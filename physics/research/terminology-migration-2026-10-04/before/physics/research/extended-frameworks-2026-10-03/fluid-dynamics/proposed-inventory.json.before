    "thm-fubini-theorem-for-l-one-on-sigma-finite-product-spaces": {
      "id": "thm-fubini-theorem-for-l-one-on-sigma-finite-product-spaces",
      "path": "items/thm-fubini-theorem-for-l-one-on-sigma-finite-product-spaces.md",
      "status": "published",
      "domain": "mathematics",
      "kind": "theorem",
      "exact_statement": "Let $(X,\\mathcal A,\\mu)$ and $(Y,\\mathcal B,\\nu)$ be sigma-finite measure\nspaces, and let $f : X \\times Y \\to \\mathbb C$ belong to\n$L^1(\\mu \\times \\nu)$. Then:\n\n1. for $\\mu$-almost every $x$, the section $f_x$ belongs to $L^1(\\nu)$;\n2. for $\\nu$-almost every $y$, the section $f^y$ belongs to $L^1(\\mu)$;\n3. after assigning the value $0$ on the exceptional parameter sets, the\n   section-integral functions are integrable; and\n4. the three integrals agree:\n$$\\int_{X \\times Y} f\\,d(\\mu \\times \\nu) = \\int_X \\left(\\int_Y f_x\\,d\\nu\\right)d\\mu = \\int_Y \\left(\\int_X f^y\\,d\\mu\\right)d\\nu.$$",
      "sha256": "805e764f513b1de1f1baf0a013b3c6a249400b0ff5198e264b0e9a32300cfc1a",
      "reading_status": "status/statement extracted; actual proof-reading extent belongs to specialist supplier record",
      "consumers": [
        "def-fd-kinetic-density",
        "lem-fd-no-slip-lsix"
      ],
      "home_kind": "canonical-root-item",
      "original_page_homes": [
