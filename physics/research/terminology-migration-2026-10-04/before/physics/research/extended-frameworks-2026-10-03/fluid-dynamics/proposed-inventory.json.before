    },
    "thm-tonelli-theorem-for-sigma-finite-product-spaces": {
      "id": "thm-tonelli-theorem-for-sigma-finite-product-spaces",
      "path": "items/thm-tonelli-theorem-for-sigma-finite-product-spaces.md",
      "status": "published",
      "domain": "mathematics",
      "kind": "theorem",
      "exact_statement": "Let $(X,\\mathcal A,\\mu)$ and $(Y,\\mathcal B,\\nu)$ be sigma-finite measure\nspaces, and let $f : X \\times Y \\to [0,\\infty]$ be product-measurable. Then\n$x \\mapsto \\int_Y f_x\\,d\\nu$ and $y \\mapsto \\int_X f^y\\,d\\mu$ are measurable,\nand\n\n$$\\int_{X \\times Y} f\\,d(\\mu \\times \\nu) = \\int_X \\left(\\int_Y f_x\\,d\\nu\\right)d\\mu = \\int_Y \\left(\\int_X f^y\\,d\\mu\\right)d\\nu.$$",
      "sha256": "a99bb7e2d4edea2b0a7ee315d84d30da51f67fd66de31a916c03dadff54b4dfc",
      "reading_status": "status/statement extracted; actual proof-reading extent belongs to specialist supplier record",
      "consumers": [
        "lem-fd-finite-mode-compactness",
        "thm-fd-bounded-global-weak-existence"
      ],
      "home_kind": "canonical-root-item",
      "original_page_homes": [
        {
          "path": "library/measure-theory/product-measures-and-the-fubini-tonelli-theorems.md",
          "page": "product-measures-and-the-fubini-tonelli-theorems",
          "is_B": false,
          "status": "published"
        }
      ]
    },
    "def-distributional-derivative": {
      "id": "def-distributional-derivative",
      "path": "items/def-distributional-derivative.md",
      "status": "published",
      "domain": "mathematics",
      "kind": "definition",
      "exact_statement": "For a distribution $u\\in\\mathcal D'(\\Omega)$ in the convention of [[def-distribution]] and a multi-index $\\alpha\\in\\mathbb N_0^n$, its **distributional derivative** is\n$$\\langle\\partial^\\alpha u,\\varphi\\rangle=(-1)^{|\\alpha|}\\langle u,\\partial^\\alpha\\varphi\\rangle\\qquad(\\varphi\\in\\mathcal D(\\Omega)).$$\nThe test derivative is a continuous linear endomorphism by [[thm-test-function-operations-are-continuous]]. Its composition with $u$, multiplied by the indicated sign, is therefore a continuous complex-linear functional, so this definition produces a distribution. The pairing is bilinear, with no complex conjugation. For $\\alpha=0$ the operation is the identity; for one coordinate derivative its sign is minus. Every derivative of the zero distribution is zero, including on the empty domain. No choice axiom enters this construction. Compatibility with classical derivatives requires an integration-by-parts argument where it is used; it is not part of the definition.",
      "sha256": "631ca57daeb6da4b1665ce7cf6fd63f6c1da11ab6f75d6c6a52c1cd006cae40e",
      "reading_status": "status/statement extracted; actual proof-reading extent belongs to specialist supplier record",
      "consumers": [
        "def-fd-periodic-leray-hopf",
        "def-fd-conservation-system"
      ],
      "home_kind": "canonical-root-item",
      "original_page_homes": [
        {
          "path": "library/functional-analysis/distributions-test-functions-and-differentiation.md",
          "page": "distributions-test-functions-and-differentiation",
          "is_B": false,
          "status": "published"
        }
      ]
    },
