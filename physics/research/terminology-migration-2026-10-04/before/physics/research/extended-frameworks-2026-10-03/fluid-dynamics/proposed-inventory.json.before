    "thm-change-of-variables-for-compact-jordan-sets": {
      "id": "thm-change-of-variables-for-compact-jordan-sets",
      "path": "items/thm-change-of-variables-for-compact-jordan-sets.md",
      "status": "published",
      "domain": "mathematics",
      "kind": "theorem",
      "exact_statement": "Let $n\\ge1$, let $U\\subseteq\\mathbb R^n$ be open, let $g:U\\to\\mathbb R^n$ be injective and $C^1$, and suppose $Dg(x)$ is invertible for every $x\\in U$. Let $K\\subseteq U$ be compact and Jordan measurable. For a bounded function $f:g(K)\\to\\mathbb R$, the following are equivalent:\n\n1. $f$ is Riemann integrable on $g(K)$;\n2. $x\\mapsto f(g(x))|\\det Dg(x)|$ is Riemann integrable on $K$.\n\nWhen either condition holds,\n$$\\int_{g(K)}f(y)\\,dy=\\int_K f(g(x))|\\det Dg(x)|\\,dx.$$",
      "sha256": "5ba025149ece179a8fe70764da7260c9926708a651aa8f2b385362691dccad20",
      "reading_status": "status/statement extracted; actual proof-reading extent belongs to specialist supplier record",
