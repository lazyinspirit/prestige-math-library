    "thm-fundamental-theorem-of-calculus-for-absolutely-continuous-functions": {
      "id": "thm-fundamental-theorem-of-calculus-for-absolutely-continuous-functions",
      "path": "items/thm-fundamental-theorem-of-calculus-for-absolutely-continuous-functions.md",
      "status": "published",
      "domain": "mathematics",
      "kind": "theorem",
      "exact_statement": "Assume the Axioms of Countable Choice and Dependent Choice. For $F:[a,b]\\to\\mathbb R$, the following are equivalent:\n\n1. $F$ is absolutely continuous.\n2. $F'$ exists almost everywhere, $F'\\in L^1[a,b]$, and\n$$F(x)-F(a)=\\int_a^xF'(t)\\,dt\\quad\\text{for every }x\\in[a,b].$$",
      "sha256": "be286980a1e733fb6e15a3bcda0b3044db44f6da405780785aa2b3b790630ca7",
      "reading_status": "status/statement extracted; actual proof-reading extent belongs to specialist supplier record",
      "consumers": [
