ids={x['id']:x for x in rows}; ext={'ROOT-FOURIER','ROOT-TONELLI','ROOT-DISTRIBUTIONS','ROOT-AC-FTC','ROOT-FUBINI','NR-E2','NR-E13','NR-E23','NR-E30','TD-L12','TD-M17','TD-M27','TD-M22','TD-M34','ROOT-ZERO-EXTENSION','ROOT-SOBOLEV-COMPLETE','lem-fd-rectangular-test-divergence-inverse'}
seen=set()
for x in rows:
 assert x['id'] not in seen; seen.add(x['id'])
 assert len([z for z in rows if z['page']==x['page'] and z['side']==x['side']])<=100
 assert '<a id="'+x['proof_module'].split('#')[1]+'"></a>' in (D/'developments.md').read_text()
 for dep in x['deps']:
  assert dep in ids or dep in ext,dep
  if dep in ids:
   assert ids[dep]['side']=='A','B leaf violation'
   assert x['domain']=='physics' or ids[dep]['domain']=='mathematics','math depends on physics'
def visit(id,active,done):
 assert id not in active,'cycle';
 if id in done:return
 for dep in ids[id]['deps']:
  if dep in ids:visit(dep,active|{id},done)
 done.add(id)
done=set()
for id in ids:visit(id,set(),done)
(D/'checks.json').write_text(json.dumps({'status':'local structural pass','item_count':len(rows),'checks':['unique IDs','≤100 A and B per page','anchors resolve','internal dep DAG','B companions leaves','domain boundary'],'not_checked':['production engine gates','independent mathematical audit','empirical source acceptance'],'command':'python3 '+str(D/'build-records.py')},indent=2)+'\n')
print('local structural pass;',len(rows),'items')
