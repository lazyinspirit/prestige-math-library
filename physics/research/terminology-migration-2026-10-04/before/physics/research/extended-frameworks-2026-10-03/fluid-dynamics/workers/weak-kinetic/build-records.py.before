def src(key,path,extent,statement,hypotheses,use,status):
 p=root/path; supplier.append(dict(key=key,path=path,sha256=hashlib.sha256(p.read_bytes()).hexdigest(),reading_extent=extent,statement=statement,hypotheses=hypotheses,use=use,proof_status=status,publication_status='published' if path.startswith('items/') else 'research scaffold; not production acceptance'))
