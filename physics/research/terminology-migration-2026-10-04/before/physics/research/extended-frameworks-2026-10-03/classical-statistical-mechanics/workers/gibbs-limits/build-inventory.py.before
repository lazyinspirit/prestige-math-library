add('lem-csm-maximal-coupling-and-heat-bath','Finite maximal coupling and heat-bath stationary law','mathematics','lemma',['lem-csm-lattice-specification-consistency'],'g4','Half-TV normalization; positive finite conditionals; finite random-scan chain')
add('thm-csm-dobrushin-finite-range-uniqueness','Finite-range Dobrushin uniqueness and boundary influence','mathematics','theorem',['lem-csm-maximal-coupling-and-heat-bath','thm-csm-lattice-dlr-existence'],'g4','sup row sum influence<1; exponential influence bound; local uniform boundary convergence')
add('lem-csm-ising-influence-bound','Ising influence bounded by hyperbolic tangent','mathematics','lemma',['def-csm-finite-range-lattice-interaction'],'g4','cij<=tanh(beta|Jij|); any h; finite range')
