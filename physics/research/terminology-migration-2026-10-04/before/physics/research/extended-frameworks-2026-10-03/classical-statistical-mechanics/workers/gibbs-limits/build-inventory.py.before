from pathlib import Path
import json,hashlib
p=Path(__file__).parent
rows=[]
def add(i,t,d,k,deps,g,scope,side='A',page='csm-gibbs-lattice'):
 rows.append(dict(id=i,title=t,domain=d,kind=k,deps=deps,proof_module='proof-modules.md#'+g,scope=scope,side=side,page=page+('-examples' if side=='B' else ''),status='research-complete-local-argument' if k not in ['definition','postulate','remark'] else 'research-definition-adoption-or-disposition'))
add('def-csm-finite-range-lattice-interaction','Finite-range lattice interaction and conditional energy','mathematics','definition',[],'g0','Finite alphabet; finite bounded translation-invariant interaction list; explicit multiplicities')
add('def-csm-stable-superstable-continuum-interaction','Stability, superstability and regular tails','mathematics','definition',[],'g0','Even Borel extended-valued pair potential; exact cell/envelope/reference conventions',page='csm-gibbs-continuum')
add('def-csm-gibbs-physical-parameters','Classical Gibbs quantities and SI reference conventions','physics','definition',['def-csm-finite-range-lattice-interaction','def-csm-stable-superstable-continuum-interaction','thm-gaussian-integral','thm-tonelli-theorem-for-sigma-finite-product-spaces'],'g0','kB,beta,T,J,a,activity,mu,pressure,entropy; primitive/derived roles')
add('post-csm-interacting-equilibrium-gibbs','Interacting classical Gibbs equilibrium adoption','physics','postulate',['def-csm-gibbs-physical-parameters'],'g0','Chosen classical Hamiltonian, equilibrium bath and reference; no equilibration theorem')
