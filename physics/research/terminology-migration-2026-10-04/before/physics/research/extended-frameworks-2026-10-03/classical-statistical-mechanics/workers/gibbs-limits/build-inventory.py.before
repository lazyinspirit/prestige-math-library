add('lem-csm-chain-markov-bridge','Positive Ising transfer matrix Markov bridge','mathematics','lemma',['thm-tdmath-ising-chain-limit','lem-csm-lattice-product-and-measure-compactness'],'g9a','Finite beta,J,h; positive eigenvector; explicit normalized transition kernel',page='csm-gibbs-chain')
add('thm-csm-chain-dlr-uniqueness','All-positive-temperature one-dimensional Ising DLR uniqueness','mathematics','theorem',['lem-csm-chain-markov-bridge','thm-csm-lattice-dlr-existence'],'g9a','Uniform endpoint spectral asymptotics; no inference from pressure analyticity alone',page='csm-gibbs-chain')
add('pthm-csm-ising-equilibrium-phases','Conditional Ising equilibrium phase predictions','physics','physical-theorem',['post-csm-interacting-equilibrium-gibbs','thm-csm-ising-high-temperature-state','thm-csm-ising-low-temperature-coexistence','thm-csm-ising-coexistence-pressure-cusp','thm-csm-chain-dlr-uniqueness'],'g6','Model predictions for chosen classical spin interaction; no claimed measured critical point')
add('pthm-csm-pressure-entropy-reference-units','Gibbs pressure and entropy with physical reference units','physics','physical-theorem',['post-csm-interacting-equilibrium-gibbs','thm-csm-lattice-dlr-variational-pressure','def-csm-gibbs-physical-parameters'],'g5','P dimensionless/site; f=-kBT P/a^d,s=kB h/a^d; prescribed reference')
add('cex-csm-gibbs-marginals-not-free','Interacting marginals are not free Gibbs laws','mathematics','counterexample',['lem-csm-lattice-specification-consistency'],'g10','Three-site zero-field chain endpoints; tanh² correlation','B')
add('cex-csm-stable-not-superstable','Stable interaction need not be superstable','mathematics','counterexample',['def-csm-stable-superstable-continuum-interaction'],'g10','Zero pair potential with arbitrarily many particles in one cell','B','csm-gibbs-continuum')
add('cex-csm-finite-range-attraction-collapse','Finite range alone does not imply stability','mathematics','counterexample',['def-csm-stable-superstable-continuum-interaction'],'g7','Every close pair attractive; quadratic collapse','B','csm-gibbs-continuum')
add('cex-csm-bulk-field-changes-pressure','A bulk external field changes ideal-gas pressure','physics','counterexample',['pthm-csm-qualified-continuum-equilibrium-limits'],'g10','Exact grand exponential with energy cN; not negligible boundary','B','csm-gibbs-continuum')
add('ex-csm-high-low-temperature-regimes','Sufficient Ising uniqueness and coexistence regimes','physics','example',['pthm-csm-ising-equilibrium-phases'],'g10','High-T2d tanh K<1; 2D low-T K>=2; gap between bounds unasserted','B')
add('ex-csm-chain-analytic-interacting-model','Analytic interacting chain and its Gibbs state','physics','example',['thm-csm-chain-dlr-uniqueness','thm-csm-ising-chain-convergent-series','post-csm-interacting-equilibrium-gibbs'],'g9a','All finite positive temperatures; classical model conditional prediction','B','csm-gibbs-chain')
foundations={'def-csm-finite-range-lattice-interaction','def-csm-stable-superstable-continuum-interaction','def-csm-gibbs-physical-parameters','post-csm-interacting-equilibrium-gibbs','lem-csm-finite-gibbs-variational-identity','lem-csm-gibbs-response-covariance','lem-csm-lattice-product-and-measure-compactness'}
for r in rows:
 if r['id'] in foundations:r['page']='csm-interacting-models'
 if r['id'] in ['pthm-csm-ising-equilibrium-phases','pthm-csm-pressure-entropy-reference-units']:r['page']='csm-interacting-equilibrium-interpretations'
local={r['id']:r for r in rows}
# Resolve Tonelli to its actual exact root ID, not a guessed spelling.
for r in rows:
 r['dependency_roles']={x:('mathematical-premise' if r['domain']=='mathematics' or not (x in local and local[x]['domain']=='physics') else 'physical-assumption' if x.startswith('post-') else 'physical-result' if x.startswith('pthm-') else 'formulation-prerequisite') for x in r['deps']}
(p/'inventory.json').write_text(json.dumps({'version':1,'items':rows,'supplier_first_order':[r['id'] for r in rows if r['side']=='A'],'external_supplier_ids':sorted({x for r in rows for x in r['deps'] if x not in local})},indent=2)+'\n')
