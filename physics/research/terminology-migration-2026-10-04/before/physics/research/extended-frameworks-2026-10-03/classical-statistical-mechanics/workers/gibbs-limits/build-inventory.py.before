add('pthm-csm-qualified-continuum-equilibrium-limits','Qualified interacting continuum thermodynamic and positional ensemble limits','physics','physical-theorem',['post-csm-interacting-equilibrium-gibbs','thm-tdmath-stable-tempered-free-cube-grand-pressure','thm-tdmath-canonical-interior-density-limit','lem-tdmath-integrable-tail-diagonal-gap','thm-tdmath-canonical-grand-duality','thm-tdmath-continuum-variational-pressure','thm-tdmath-retained-hard-zero-beta-limit','thm-tdmath-uniform-tempered-exterior-pressure','thm-tdmath-superstable-van-hove-pressure','thm-tdmath-periodic-fixed-n-limit','thm-tdmath-fixed-n-local-ensemble-equivalence','thm-tdmath-controlled-shell-three-ensemble-equivalence','thm-tdmath-van-hove-fixed-n-limit'],'g8','Every stated theorem retains distinct exact assumptions; Poisson+1 and SI restoration; no minimizer-to-DLR inference',page='csm-gibbs-continuum')
