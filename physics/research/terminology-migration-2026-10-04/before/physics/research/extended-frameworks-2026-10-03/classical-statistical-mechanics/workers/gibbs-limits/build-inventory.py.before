add('thm-csm-lattice-dlr-variational-pressure','DLR states attain the bounded lattice pressure variational principle','mathematics','theorem',['lem-csm-stationary-dlr-construction','thm-csm-lattice-van-hove-pressure','lem-csm-stationary-lattice-entropy-energy'],'g5','DLR implies equilibrium; converse not asserted; uniform boundary relative entropy bound')
