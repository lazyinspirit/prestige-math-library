add('lem-csm-lattice-product-and-measure-compactness','Finite-alphabet product and probability compactness','mathematics','lemma',['def-countable-choice','thm-caratheodory-extension-theorem','thm-dynkin-pi-lambda'],'g2','Countable lattice; cylinder topology; proved premeasure extension and diagonal compactness')
add('def-csm-lattice-gibbs-specification','Lattice Gibbs kernels and DLR states','mathematics','definition',['def-csm-finite-range-lattice-interaction','lem-csm-lattice-product-and-measure-compactness'],'g3','Proper kernels and conditional identities on full cylinder-generated sigma-field')
add('lem-csm-lattice-specification-consistency','Conditional Gibbs kernel consistency','mathematics','lemma',['def-csm-lattice-gibbs-specification','lem-csm-finite-gibbs-variational-identity'],'g3','Finite-range energy decomposition; conditionals rather than free marginals')
add('thm-csm-lattice-dlr-existence','Finite-range lattice DLR existence and closed convex state set','mathematics','theorem',['lem-csm-lattice-specification-consistency','lem-csm-lattice-product-and-measure-compactness'],'g3','Arbitrary exhausting finite volumes and exterior subsequential limits; no uniqueness presumed')
