      "derivations": [
        {
          "id": "step-1-1",
          "step": "1.1",
          "claim": "Since $\\varphi=0$ and $\\pi=0$, the scalar equation is $0-V'(0)\\,0=0$ and $j^a=0$. Also $L_\\varphi=V(0)=0$, so $T^\\varphi_{ab}=0$. The condition $V(0)=0$ is what removes the remaining term $-\\tfrac12K_\\varphi g_{ab}V(0)$.",
          "inputs": [
