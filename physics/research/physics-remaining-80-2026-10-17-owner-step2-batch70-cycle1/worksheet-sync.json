    {
      "id": "thm-tgr-constrained-entropy-tov-criticality",
      "kind": "retired-native-obsolete-citation",
      "citation": {
        "fact": "F4",
        "source": "lem-choice-free-smooth-inverse-function-theorem-in-euclidean-space",
        "source_section": "Statement",
        "quote": "In ZF, let $n\\ge1$, let $U\\subseteq\\mathbb R^n$ be open, let $f:U\\to\\mathbb R^n$ be smooth, and let $a\\in U$. If $Df(a)$ is invertible, then there are open neighbourhoods $a\\in V\\subseteq U$ and $f(a)\\in W$ such that $f|_V:V\\to W$ is a diffeomorphism. Writing $g=(f|_V)^{-1}$,\n$$Dg(y)=Df(g(y))^{-1}\\qquad(y\\in W).$$\nNo choice axiom is used.",
        "uses": [
          "3.1"
        ]
      }
