        {
          "supplier": "thm-c-one-change-of-variables-for-nonnegative-lebesgue-measurable-functions",
          "carrier": "items/thm-c-one-change-of-variables-for-nonnegative-lebesgue-measurable-functions.md",
          "status": "Published read-only mathematical supplier; exact current interface inspected.",
          "source_section": "Statement",
          "exact_statement": "Assume the Axiom of Countable Choice ([[def-countable-choice]]). Let\n$U,V \\subseteq \\mathbb R^n$ be open and let $T : U \\to V$ be a\n$C^1$ diffeomorphism. For every nonnegative Lebesgue measurable\n$f : V \\to [0,\\infty]$,\n$$ \\int_V f(y)\\,d\\lambda_n(y) = \\int_U f(T(x))\\,|\\det DT(x)|\\,d\\lambda_n(x). $$\n\n",
          "relevant_hypotheses_and_conventions": "Use is limited to the exact conditions recorded in F5 and the item risk review; no stronger regularity or unqualified physical conclusion is inferred.",
          "supplier_proof_status": "Published result with proof present; this local consumer review does not certify its entire transitive closure.",
          "consumer_use": "F5 at 1.1, 1.2"
        },
        {
          "supplier": "thm-of-square-roots",
          "carrier": "items/thm-of-square-roots.md",
          "status": "Published read-only mathematical supplier; exact current interface inspected.",
          "source_section": "Statement",
          "exact_statement": "Let $F$ be a complete ordered field ([[def-complete-ordered-field]]). Then every\n$a \\in F$ with $a \\ge 0$ has a **unique** $s \\in F$ with $s \\ge 0$ and $s^2 = a$;\nwe write $s = \\sqrt{a}$. Consequently the positive elements of $F$ are exactly the\nnonzero squares: $x > 0$ if and only if $x = y^2$ for some $y \\neq 0$.\n\n",
          "relevant_hypotheses_and_conventions": "Use is limited to the exact conditions recorded in F5 and the item risk review; no stronger regularity or unqualified physical conclusion is inferred.",
          "supplier_proof_status": "Published result with proof present; this local consumer review does not certify its entire transitive closure.",
          "consumer_use": "F5 at 1.1, 1.2"
        },
        {
          "supplier": "def-natural-logarithm",
          "carrier": "items/def-natural-logarithm.md",
          "status": "Published read-only mathematical supplier; exact current interface inspected.",
          "source_section": "Definition",
          "exact_statement": "For $x>0$, define $\\log x$ to be the unique real $y$ such that $\\exp(y)=x$. This is well-defined because [[cor-exponential-is-a-bijection-onto-positive-reals]] states that $\\exp:\\mathbb R\\to(0,\\infty)$ is a bijection.\n\nThus $\\log:(0,\\infty)\\to\\mathbb R$ is the inverse function of $\\exp$. In particular, $\\log(\\exp y)=y$ for every $y\\in\\mathbb R$ and $\\exp(\\log x)=x$ for every $x>0$.\n\n",
          "relevant_hypotheses_and_conventions": "Use is limited to the exact conditions recorded in F6 and the item risk review; no stronger regularity or unqualified physical conclusion is inferred.",
          "supplier_proof_status": "Definition; any well-definedness discharges retain their actual supplier status.",
          "consumer_use": "F6 at 2.1"
        },
        {
          "supplier": "thm-logarithm-derivative-and-integral",
          "carrier": "items/thm-logarithm-derivative-and-integral.md",
          "status": "Published read-only mathematical supplier; exact current interface inspected.",
          "source_section": "Statement",
          "exact_statement": "For $x>0$, $\\log$ is differentiable and\n$$\\log'(x)=\\frac1x,\\qquad \\log x=\\int_1^x\\frac{dt}{t}.$$\n\n",
          "relevant_hypotheses_and_conventions": "Use is limited to the exact conditions recorded in F6 and the item risk review; no stronger regularity or unqualified physical conclusion is inferred.",
          "supplier_proof_status": "Published result with proof present; this local consumer review does not certify its entire transitive closure.",
