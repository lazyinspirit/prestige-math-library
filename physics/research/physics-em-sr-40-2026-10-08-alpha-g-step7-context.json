  "conventions": [
    {
      "convention": "η has matrix diag(-1,1,1,1); Greek indices run from 0 through 3. Lowering reverses the time-component sign. C+ consists of nonzero future causal vectors, including null vectors.",
      "fixed_by": "def-em-minkowski-affine-space",
      "matters_for": [
        "lem-em-boost-preserves-metric",
        "lem-em-proper-time-reparametrization",
        "lem-em-antisymmetric-tensor-contraction",
        "lem-em-compact-field-variation",
        "post-em-minkowski-physical-model"
      ]
    },
    {
      "convention": "A frame is an origin and an η-orthonormal ordered basis with future time vector; positive spatial orientation is not an additional requirement of this definition. For u′a=L⁻¹ua and N=B⁻¹LB, components transform as v′=Nv, θ′=(N⁻¹)ᵀθ and F′=(N⁻¹)ᵀFN⁻¹.",
      "fixed_by": "def-em-minkowski-affine-space",
      "matters_for": [
        "lem-em-antisymmetric-tensor-contraction",
        "post-em-minkowski-physical-model",
        "def-em-electromagnetic-tensor"
      ]
    },
    {
      "convention": "The raised-index operator is defined by η(Φ(u),w)=F(w,u), giving Φ(u)^μ=η^{μα}F_{αβ}u^β.",
      "fixed_by": "lem-em-antisymmetric-tensor-contraction",
      "matters_for": [
        "ex-em-minkowski-mathematical-prerequisites-hypothesis-boundaries",
        "def-em-electromagnetic-tensor",
        "post-em-lorentz-coupling"
      ]
    },
    {
      "convention": "Moving flux counts the supplied parametrization with multiplicity. Its area vector is r_u×r_v; its boundary is the image of the positive parameter boundary chain. A compatible C¹ spacetime velocity field is supplied. Rank is required only on D°×I°; singleton time data do not determine time derivatives.",
      "fixed_by": "def-em-moving-patch",
      "matters_for": [
        "lem-em-moving-flux",
        "ex-em-elementary-mathematical-prerequisites-hypothesis-boundaries"
      ]
    },
    {
      "convention": "For divergence-free B, the moving-flux boundary term is minus the circulation of v×B. Without divergence-free B, add the parametrized flux of v div B. Normal shorthand requires a rank-two slice; the parameter formula remains meaningful at degenerate endpoint slices.",
      "fixed_by": "lem-em-moving-flux",
      "matters_for": [
        "ex-em-elementary-mathematical-prerequisites-hypothesis-boundaries"
      ]
    },
    {
      "convention": "The stationary interface is compact, embedded C² and has no manifold boundary. n points from Ω− to Ω+ and [F]=F+−F−. Distribution pairings are complex bilinear without conjugation. Surface-density multiplication means the specified surface integral, not multiplication of arbitrary distributions.",
      "fixed_by": "def-em-surface-distribution",
      "matters_for": [
        "lem-em-interface-derivatives",
        "def-em-weak-sources",
        "pthm-em-fixed-vacuum-jumps"
      ]
    },
    {
      "convention": "Countable Choice is an explicit premise of localization, surface-distribution and interface formulas, Coulomb remainders, parameter integrals, moving flux, and both variational lemmas; it is not silently removed by their consumers.",
      "fixed_by": "lem-em-continuous-localization",
      "matters_for": [
        "def-em-surface-distribution",
        "lem-em-interface-derivatives",
        "lem-em-coulomb-dipole-remainder",
        "lem-em-parameter-integrals",
        "lem-em-moving-flux",
        "lem-em-fundamental-variation-lemma",
        "lem-em-compact-field-variation"
      ]
    },
    {
      "convention": "The source-free point-current identity requires a proper graph into the ambient open spacetime domain. The finite-endpoint branch instead requires continuous endpoint extension, finite absolute improper integral of |z′|, and endpoint events in the domain; it contributes qδ_start−qδ_end.",
      "fixed_by": "lem-em-point-current-continuity",
      "matters_for": [
        "def-em-weak-sources"
      ]
    },
    {
      "convention": "Plane waves encode real fields using exp(i(k·x−ωt)), with ω>0. Complex dot and cross products are bilinear extensions; quadratic period averages conjugate the second amplitude.",
      "fixed_by": "def-em-complex-plane-wave",
      "matters_for": [
        "lem-em-period-average",
        "lem-em-interface-wave-linear-system"
      ]
    },
    {
      "convention": "Localization uses canonical zero-based coordinates. Several elementary vector-calculus items use spatial labels 1,2,3; the elementary example explicitly identifies these with canonical coordinates 0,1,2.",
      "fixed_by": "lem-em-continuous-localization",
      "matters_for": [
        "lem-em-fundamental-variation-lemma",
        "ex-em-elementary-mathematical-prerequisites-hypothesis-boundaries"
      ]
    },
    {
      "convention": "The compact field functional has source term +J^νA_ν and quadratic term −F_{μν}F^{μν}/(4κ), with κ>0. Variations are all smooth vector fields compactly supported in U. Stationarity gives ∂_μF^{μν}=−κJ^ν, without existence or minimality claims.",
      "fixed_by": "lem-em-compact-field-variation",
      "matters_for": [
        "ex-em-variational-mathematical-prerequisites-hypothesis-boundaries"
      ]
    },
    {
      "convention": "Joint Cᵏ regularity on a possibly non-open interval means restriction of a Cᵏ map on an open spacetime neighbourhood; joint smoothness requires one smooth extension. Included nondegenerate endpoints use relative derivatives; singleton restrictions do not determine time jets.",
      "fixed_by": "lem-em-joint-smooth-potentials",
      "matters_for": [
        "lem-em-joint-smooth-potentials",
        "ex-em-elementary-mathematical-prerequisites-hypothesis-boundaries"
      ]
    }
  ],
  "load_bearing": [
    {
      "id": "def-em-minkowski-affine-space",
      "statement": "Defines A=V=R⁴ as affine space with translation action, η(v,w)=−v⁰w⁰+v¹w¹+v²w²+v³w³, causal classes, the nonzero future causal cone, orientation, Lorentz maps, frames, tensor components and their frame-change laws, with a separate fixed c>0.",
      "used_by": [
        "lem-em-boost-preserves-metric",
        "lem-em-proper-time-reparametrization",
        "lem-em-antisymmetric-tensor-contraction",
        "lem-em-compact-field-variation",
        "post-em-minkowski-physical-model"
      ]
    },
    {
      "id": "lem-em-parameter-integrals",
      "statement": "Under Countable Choice, for compact Lebesgue-measurable K⊂Rⁿ of finite measure, a<b, and real f and ∂_tf continuous on an open neighbourhood of K×[a,b], differentiation of ∫_K f equals ∫_K ∂_tf, including relative endpoint derivatives. The same conclusion holds for a fixed compact embedded C¹ hypersurface and its surface measure.",
      "used_by": [
        "lem-em-moving-flux",
        "pthm-em-integral-maxwell",
        "pthm-em-poynting-balance",
        "pthm-em-momentum-balance",
        "pthm-em-angular-balance",
        "pthm-em-coupled-total-conservation"
      ]
    },
    {
      "id": "lem-em-continuous-localization",
      "statement": "Under Countable Choice, a continuous g:U→Rᵐ on open U⊂Rⁿ, n,m≥1, vanishes if its componentwise integral over every compactly contained ball vanishes. A continuous F:W→R³ vanishes if its flux through every admissible closed coordinate-normal flat disc vanishes, in all three coordinate directions and at all centres.",
      "used_by": [
        "lem-em-fundamental-variation-lemma"
      ]
    },
    {
      "id": "lem-em-fundamental-variation-lemma",
      "statement": "Assume Countable Choice. Let n,m≥1, U⊂Rⁿ be open and g:U→Rᵐ continuous. If ∫_U⟨g,h⟩dλ=0 for every h∈C_c^∞(U;Rᵐ), then g=0 on U.",
      "used_by": [
        "lem-em-compact-field-variation",
        "ex-em-variational-mathematical-prerequisites-hypothesis-boundaries"
      ]
    },
    {
      "id": "def-em-moving-patch",
      "statement": "Defines a C² parametrized family over a supplied finite elementary Green region, rank two on D°×I°, with a supplied compatible C¹ spacetime velocity field and a C¹ field B near the swept graph; its flux is ∫_D⟨B(r(p,t),t),r_u×r_v⟩dp, counted with the parametrization.",
      "used_by": [
        "lem-em-moving-flux",
        "ex-em-elementary-mathematical-prerequisites-hypothesis-boundaries"
      ]
    },
    {
      "id": "def-em-surface-distribution",
      "statement": "Under Countable Choice, defines δ_S(ψ)=∫_SψdS and aδ_S(ψ)=∫_SaψdS for continuous a on a compact embedded C² stationary hypersurface without boundary, together with its two-sided normal convention and continuous one-sided field jump [F]=F+−F−.",
      "used_by": [
        "lem-em-interface-derivatives",
        "def-em-weak-sources",
        "pthm-em-fixed-vacuum-jumps"
      ]
    },
    {
      "id": "lem-em-interface-derivatives",
      "statement": "Under Countable Choice, for the specified two-sided compact embedded C² stationary interface and a separately C¹ field whose values and first partial derivatives extend continuously from each side, ∂_iF_j={∂_iF_j}+n_i[F_j]δ_S. Consequently div F={div F}+n·[F]δ_S and curl F={curl F}+n×[F]δ_S as distributions.",
      "used_by": [
        "pthm-em-fixed-vacuum-jumps"
      ]
    },
    {
      "id": "lem-em-quadratic-stress-identity",
      "statement": "For C¹ F on open U⊂R³ and Q_ij=F_iF_j−δ_ij|F|²/2, div Q=F div F−F×curl F. Symmetric Q has ε_ijkQ_kj=0. For symmetric Π with continuous entries and spatial first derivatives, continuous g,f and existing ∂_tg satisfying ∂_tg+div Π=−f on U×I with I open, ∂_t(x×g)+div(x×Π)=−x×f.",
      "used_by": [
        "pthm-em-momentum-balance",
        "pthm-em-angular-balance",
        "pthm-em-coupled-total-conservation"
      ]
    },
    {
      "id": "lem-em-antisymmetric-tensor-contraction",
      "statement": "For a skew bilinear form F on the fixed Minkowski space, the uniquely defined linear operator η(Φ(u),w)=F(w,u) has components Φ(u)^μ=η^{μα}F_{αβ}u^β and η(u,Φ(u))=0. On a nonempty open interval, differentiable U satisfying mU′=qΦ(U), m≠0, has constant η(U,U); the same holds for pointwise varying skew forms, without differentiating those forms.",
      "used_by": [
        "ex-em-minkowski-mathematical-prerequisites-hypothesis-boundaries",
        "def-em-electromagnetic-tensor",
        "post-em-lorentz-coupling"
      ]
    },
    {
      "id": "lem-em-point-current-continuity",
      "statement": "For a C¹ trajectory on an open interval whose graph is proper into an open spacetime domain, the pairings ρ(ψ)=q∫ψ(z(t),t)dt and J(ψ)=q∫z′(t)ψ(z(t),t)dt define distributions satisfying ∂_tρ+div J=0. For a bounded finite-endpoint history with continuous endpoint extension, integrable |z′| and endpoint events in the domain, the identity instead has qδ_start−qδ_end.",
      "used_by": [
        "def-em-weak-sources"
      ]
    },
    {
      "id": "lem-em-compact-field-variation",
      "statement": "Under Countable Choice, for bounded open U⊂R⁴, open N⊃closure(U), κ>0 and smooth A,J:N→R⁴, S[A]=∫_U(−F_{μν}F^{μν}/(4κ)+J^νA_ν)dλ is finite. For every compactly supported smooth variation, S[A+sh] is the stated quadratic polynomial, its first variation equals ∫_U(κ⁻¹∂_μF^{μν}+J^ν)h_νdλ, and stationarity for all such variations is equivalent to ∂_μF^{μν}=−κJ^ν on U.",
      "used_by": [
        "ex-em-variational-mathematical-prerequisites-hypothesis-boundaries"
      ]
    },
    {
      "id": "lem-em-period-average",
      "statement": "For ω>0, T=2π/ω and complex a,d, T⁻¹∫_0^T Re(ae^(−iωt))Re(de^(−iωt))dt=Re(a conjugate(d))/2. The componentwise vector versions give Re⟨a,conjugate(d)⟩/2 and Re(a×conjugate(d))/2 using complex-bilinear extensions.",
      "used_by": [
        "lem-em-interface-wave-linear-system",
        "ex-em-elementary-mathematical-prerequisites-hypothesis-boundaries"
      ]
    },
    {
      "id": "lem-em-coulomb-dipole-remainder",
      "statement": "Under Countable Choice, for a>0 and real or complex ρ∈L¹(λ₃) vanishing almost everywhere outside |y|≤a, and r=|x|≥2a, ∫ρ(y)/|x−y|dy=Q/r+⟨p,x⟩/r³+R(x), with Q=∫ρ, p=∫yρ, bilinear contraction and |R(x)|≤16a²‖ρ‖₁/r³. The kernel is assigned zero at y=x; no derivative estimate of R is asserted.",
      "used_by": [
        "lem-em-magnetic-dipole-remainder"
      ]
    },
    {
      "id": "lem-em-moving-flux",
      "statement": "Under Countable Choice and the moving-patch hypotheses, flux is differentiable on nondegenerate time intervals, with relative included-endpoint derivatives. Its parameter formula is Φ′=∫_D⟨∂_tB+v div B,r_u×r_v⟩dp−∮(v×B)·dr. At rank-two slices this has the stated normal notation, and div B=0 removes the additional divergence term.",
      "used_by": [
        "ex-em-elementary-mathematical-prerequisites-hypothesis-boundaries"
      ]
    }
  ],
