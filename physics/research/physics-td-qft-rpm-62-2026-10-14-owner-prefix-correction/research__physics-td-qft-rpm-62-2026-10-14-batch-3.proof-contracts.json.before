          "case_scope": {
            "source_section": "Example",
            "source_excerpt": "Set $A=\\{1,2\\}$ and $r=2$, with independently supplied data $\\nu_1=(1,-1)$, $d_1=-2$, $\\nu_2=(-1,1)$, and $d_2=1$. No offset $b\\in\\mathbb R^2$ satisfies both $b\\cdot\\nu_a+d_a\\ge0$.",
            "current_raw_sha256": "a701371449414ac937257c4c3636770c2a6615f8efbf0318761a2de98dab2a0a",
            "scope_only_not_proof_acceptance": true
          }
        },
        {
          "case": "nonempty-choice",
          "status": "not_applicable",
          "reason": "nonempty-choice: No arbitrary choice is used; any existence argument is for the fixed finite or individual case.",
          "case_scope": {
            "source_section": "Example",
            "source_excerpt": "Set $A=\\{1,2\\}$ and $r=2$, with independently supplied data $\\nu_1=(1,-1)$, $d_1=-2$, $\\nu_2=(-1,1)$, and $d_2=1$. No offset $b\\in\\mathbb R^2$ satisfies both $b\\cdot\\nu_a+d_a\\ge0$.",
            "current_raw_sha256": "a701371449414ac937257c4c3636770c2a6615f8efbf0318761a2de98dab2a0a",
            "scope_only_not_proof_acceptance": true
