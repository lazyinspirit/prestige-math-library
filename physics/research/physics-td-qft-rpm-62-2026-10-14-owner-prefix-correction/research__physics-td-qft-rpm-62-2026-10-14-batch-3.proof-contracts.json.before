    "ex-tdmath-reaction-offset-cycle-obstruction": {
      "citations": [
        {
          "fact": "F1",
          "source": "thm-tdmath-reaction-offset-feasibility",
          "source_section": "Statement",
          "quote": "Let $A$ be a finite set of reaction channels, let $r\\in\\mathbb N$, let $\\nu_a\\in\\mathbb R^r$ be the output-minus-input type vector of channel $a$, and let $d_a\\in\\mathbb R$ be a finite lower bound on its already calibrated entropy change. There exists an offset vector $b\\in\\mathbb R^r$ satisfying\n\n$$b\\cdot\\nu_a+d_a\\ge0\\qquad(a\\in A)$$\n\nif and only if every $\\lambda\\in\\mathbb R^A$ with $\\lambda_a\\ge0$ and $\\sum_{a\\in A}\\lambda_a\\nu_a=0$ satisfies $\\sum_{a\\in A}\\lambda_ad_a\\ge0$. If an actual transition has entropy change $\\Delta\\sigma_a\\ge d_a$, such a vector guarantees $\\Delta\\sigma_a+b\\cdot\\nu_a\\ge0$. The criterion is exact for the finite lower-bound inequalities; it does not claim necessity for actual transitions when $d_a$ is only a loose bound.",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F2",
          "source": "thm-tdmath-finite-inequality-alternative",
          "source_section": "Statement",
          "quote": "Let $m,n\\in\\mathbb N$ be finite, let $c_j\\in\\mathbb R^n$ and $h_j\\in\\mathbb R$ for $0\\le j<m$. The finite system\n\n$$c_j\\cdot b\\ge h_j\\qquad(0\\le j<m)$$\n\nhas a solution $b\\in\\mathbb R^n$ if and only if every $\\lambda\\in\\mathbb R^m$ with $\\lambda_j\\ge0$ and $\\sum_{j<m}\\lambda_jc_j=0$ satisfies $\\sum_{j<m}\\lambda_jh_j\\le0$. Dot products and sums are finite. This includes empty rows, empty variables, and an empty inequality family.",
          "uses": [
            "2.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "step-1-1",
          "step": "1.1",
          "claim": "The multiplier $\\lambda=(1,1)$ is nonnegative and satisfies $\\lambda_1\\nu_1+\\lambda_2\\nu_2=(1,-1)+(-1,1)=(0,0)$. But $\\lambda_1d_1+\\lambda_2d_2=-2+1=-1<0$, violating the necessary condition in [F1]; therefore no offset exists.",
          "inputs": [
            "A1",
            "F1",
            "algebra"
          ]
        },
        {
          "id": "step-2-1",
          "step": "2.1",
          "claim": "Directly, the two inequalities would require $b_1-b_2\\ge2$ and $-b_1+b_2\\ge-1$, equivalently $b_1-b_2\\le1$. Adding the original inequalities gives $0\\ge1$, a contradiction. This is the positive-right-side zero-left certificate of [F2].",
          "inputs": [
            "A1",
            "F2",
            "step 1.1",
            "algebra",
            "1.1"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "empty: No empty family is quantified in the Statement; the input domain is fixed there.",
          "case_scope": {
            "source_section": "Example",
            "source_excerpt": "Set $A=\\{1,2\\}$ and $r=2$, with independently supplied data $\\nu_1=(1,-1)$, $d_1=-2$, $\\nu_2=(-1,1)$, and $d_2=1$. No offset $b\\in\\mathbb R^2$ satisfies both $b\\cdot\\nu_a+d_a\\ge0$.",
            "current_raw_sha256": "a701371449414ac937257c4c3636770c2a6615f8efbf0318761a2de98dab2a0a",
            "scope_only_not_proof_acceptance": true
          }
        },
        {
          "case": "zero",
          "status": "checked",
          "evidence": "1.1 exhibits a zero-net cycle."
        },
        {
          "case": "one",
          "status": "checked",
          "evidence": "2.1 checks both channel inequalities."
        },
        {
          "case": "degenerate",
