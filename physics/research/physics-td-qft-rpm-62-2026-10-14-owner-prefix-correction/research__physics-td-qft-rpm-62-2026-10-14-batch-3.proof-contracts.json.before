    "lem-tdmath-reciprocal-naturals-tend-zero": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-complete-ordered-field",
          "source_section": "Definition",
          "quote": "$F$ is a **complete ordered field** (equivalently, $F$ has the\n**least-upper-bound property**, or is **Dedekind complete**) if every nonempty\n$S \\subseteq F$ that is bounded above has a least upper bound in $F$.",
          "uses": [
            "1.1",
            "2.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "step-1-1",
          "claim": "The natural numbers are nonempty. If they had an upper bound, completeness [F1] would give $s=\\sup\\mathbb N$. The number $s-1$ cannot be an upper bound, so some $n\\in\\mathbb N$ satisfies $n>s-1$. Then $n+1>s$, while $n+1\\in\\mathbb N$, contradicting that $s$ is an upper bound. Thus the natural numbers are unbounded above.",
          "step": "1.1",
          "inputs": [
            "F1",
            "algebra"
          ]
        },
        {
          "id": "step-2-1",
          "claim": "Each $n+1$ is positive, so $\\epsilon_n>0$; since $n+2>n+1$, ordered-field division by positive denominators gives $1/(n+2)<1/(n+1)$. Given $\\eta>0$, unboundedness from step 1.1 supplies $N\\in\\mathbb N$ with $N+1>1/\\eta$. For all $n\\ge N$, $0<\\epsilon_n\\le1/(N+1)<\\eta$, which is the definition of convergence to zero.",
          "step": "2.1",
          "inputs": [
            "F1",
            "step 1.1",
            "algebra"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
