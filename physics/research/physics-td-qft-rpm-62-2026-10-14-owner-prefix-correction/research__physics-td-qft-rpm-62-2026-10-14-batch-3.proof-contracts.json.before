    "ex-tdmath-no-sinks-sandwich-on-r": {
      "citations": [
        {
          "fact": "F1",
          "source": "thm-tdmath-infinite-no-sinks-sandwich",
          "source_section": "Statement",
          "quote": "For each $\\Gamma\\in\\mathcal G$, let $X_\\Gamma$ be a state set and $\\sigma_\\Gamma:X_\\Gamma\\to\\mathbb R$ a baseline state function. If every admitted transition $(\\Gamma,x)\\to(\\Gamma',y)$, with $x\\in X_\\Gamma$ and $y\\in X_{\\Gamma'}$, satisfies $\\sigma_{\\Gamma'}(y)-\\sigma_\\Gamma(x)\\ge F(\\Gamma,\\Gamma')$, then $\\sigma_\\Gamma(x)+B(\\Gamma)$ is nondecreasing across those transitions. The existence or properties of such a cost $p$, including no-sinks, are hypotheses and are not proved by this theorem.",
          "uses": [
            "1.1",
            "2.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "step-1-1",
          "claim": "For $x=0$, $p(x)=0$. For $t>0$, $p(tx)=\\max\\{tx,0\\}=t\\max\\{x,0\\}=tp(x)$. Also $p(x+y)\\le p(x)+p(y)$ because the right side is nonnegative and at least $x+y$. Every value is finite, so $p(x)<+\\infty$ iff $p(-x)<+\\infty$. Thus all assumptions in [F1] hold.",
          "step": "1.1",
          "inputs": [
            "A1",
            "F1",
            "algebra"
          ]
        },
        {
          "id": "step-2-1",
          "claim": "The map $L(x)=x/2$ is real-linear. If $x\\ge0$, then $p(x)=x$, $p(-x)=0$, and $0\\le x/2\\le x$. If $x\\le0$, then $p(x)=0$, $p(-x)=-x$, and $x\\le x/2\\le0$. These two cases include $x=0$ and give $-p(-x)\\le L(x)\\le p(x)$ for all $x$.",
          "step": "2.1",
          "inputs": [
            "A1",
            "F1",
            "step 1.1",
            "algebra"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "checked",
          "evidence": "Statement uses V=R, which contains zero."
        },
        {
          "case": "zero",
          "status": "checked",
          "evidence": "1.1 and 2.1 include x=0."
        },
        {
          "case": "one",
          "status": "checked",
          "evidence": "2.1 treats the one-dimensional space directly."
        },
        {
          "case": "degenerate",
          "status": "checked",
          "evidence": "2.1 includes equality at x=0 and both sign cases."
        },
        {
          "case": "endpoints",
          "status": "checked",
          "evidence": "2.1 checks x>=0 and x<=0, including their common endpoint."
        },
        {
          "case": "nonempty-choice",
          "status": "not_applicable",
          "reason": "Then $p$ is an everywhere-finite no-sinks sublinear function and $L$ satisfies $-p(-x)\\le L(x)\\le p(x)$ for every real $x$. Boundary nonempty-choice: No arbitrary choice is used; any existence argument is for the fixed finite or individual case.",
