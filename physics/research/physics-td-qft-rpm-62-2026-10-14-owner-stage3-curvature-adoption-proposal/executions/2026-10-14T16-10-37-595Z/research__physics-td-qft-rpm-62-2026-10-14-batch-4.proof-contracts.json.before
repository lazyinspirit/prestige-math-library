          "evidence": "Step 1.2 treats P=1 separately with q=0."
        },
        {
          "case": "endpoints",
          "status": "not_applicable",
          "reason": "Composition-boundary points are excluded from U and no boundary dimension claim is made."
        },
        {
          "case": "nonempty-choice",
          "status": "checked",
          "evidence": "The coordinate definitions and local rank theorem use no choice."
        },
        {
