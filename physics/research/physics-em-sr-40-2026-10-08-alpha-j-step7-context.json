  "load_bearing": [
    {
      "id": "def-sr-affine-minkowski-model",
      "statement": "The model consists of a nonempty affine space over an oriented four-dimensional real displacement space, a nondegenerate symmetric Lorentz form of inertia (3,1,0), and a selected timelike component C+.",
      "used_by": [
        "def-inertial-frame-and-inertial-chart",
        "post-sr-inertial-covariance",
        "post-sr-ideal-clocks-and-light",
        "def-lorentz-map-and-lorentz-group",
        "thm-sr-affine-isometry-classification",
        "def-ck-tensor-field-on-minkowski-space"
      ]
    },
    {
      "id": "def-inertial-frame-and-inertial-chart",
      "statement": "An inertial frame is an origin with a future, positively oriented η-orthonormal ordered basis. Its chart is x(p)=E⁻¹(p-o); another frame with E'=EM has x'=M⁻¹(x-x(o')).",
      "used_by": [
        "lem-affine-minkowski-charts-form-a-smooth-atlas",
        "lem-tangent-space-of-affine-minkowski-space-is-v",
        "def-oriented-minkowski-volume-form",
        "def-lorentz-boost",
        "lem-inertial-chart-transitions-are-affine-lorentz",
        "thm-sr-tensor-and-current-transformation"
      ]
    },
    {
      "id": "lem-timelike-cone-has-two-convex-components",
      "statement": "In an η-orthonormal ordered basis, T has exactly the two nonempty, disjoint, open, convex, path-connected components T+={v:v0>|vspatial|} and T-={v:v0<-|vspatial|}. Their closures replace the strict inequalities by weak ones and intersect exactly at zero; another orthonormal basis gives the same two components in some order.",
      "used_by": [
        "lem-future-oriented-inertial-frames-exist",
        "lem-lorentz-map-preserves-metric-and-causal-structure",
        "lem-boost-is-proper-orthochronous-with-inverse",
        "lem-boost-rotation-factorization",
        "pthm-sr-interval-and-cone-invariance",
        "thm-sr-tensor-and-current-transformation"
      ]
    },
    {
      "id": "lem-lorentz-map-preserves-metric-and-causal-structure",
      "statement": "A linear endomorphism preserving η is an isomorphism, satisfies the orthonormal matrix criterion Mᵀη0M=η0, has determinant ±1, preserves causal character, and permutes the two timelike components. Proper maps preserve ε; determinant -1 reverses its sign. The full, proper, orthochronous and proper orthochronous sets are groups, and affine Lorentz maps are bijections forming a group.",
      "used_by": [
        "lem-boost-is-proper-orthochronous-with-inverse",
        "lem-boost-rotation-factorization",
        "thm-sr-proper-orthochronous-lorentz-algebra",
        "lem-lorentz-exponential-map-and-rapidity",
        "lem-inertial-chart-transitions-are-affine-lorentz"
      ]
    },
    {
      "id": "thm-em-retarded-root-and-fields",
      "statement": "Under Countable Choice, c>0, a C3 history z:R→R3 satisfying |z'|≤v*<c, q∈R and ε0>0, every event off Γ has a unique C3 retarded root s<t, with st=1/κ, ∇s=-n/(cκ) and κ=1-n·β≥1-v*/c>0. The history pairings equal the regular distributions of the locally integrable zero extensions of φ=C/(κr), A=βφ/c. Off Γ, E=C[(1-|β|²)(n-β)/(κ³r²)+n×((n-β)×βdot)/(cκ³r)] and B=n×E/c are C1. The velocity term is bounded by |C|(1+v*/c)(1-v*/c)⁻³r⁻². On xr=z(s0)+rn, tr=s0+r/c, the root is s0 and this bound is the direction-uniform far-zone remainder at fixed s0.",
      "used_by": [
        "ex-em-wave-equation-prerequisites-hypothesis-boundaries",
        "pthm-em-lienard-wiechert",
        "pthm-em-larmor-nonrelativistic",
        "pthm-em-lienard-emitted-power"
      ]
    },
    {
      "id": "lem-boost-is-proper-orthochronous-with-inverse",
      "statement": "For every |β|<1, B(β) is proper orthochronous, B(β)⁻¹=B(-β), and B(β)e0=γ(e0-β). The parameter map is injective. For a future unit timelike u, B(uspacial/u0)u=e0.",
      "used_by": [
        "lem-collinear-boost-composition-and-velocity-addition",
        "lem-boost-rotation-factorization",
        "thm-sr-proper-orthochronous-lorentz-algebra",
        "ex-sr-four-current-boost"
      ]
    },
    {
      "id": "lem-inertial-chart-transitions-are-affine-lorentz",
      "statement": "Two inertial charts have transition u↦M⁻¹(u-x(o')), with M and M⁻¹ proper orthochronous Lorentz matrices. Conversely, every proper orthochronous linear Lorentz map L and origin c give the inertial frame (c;Le0,...,Le3), with chart xL(p)=ML⁻¹(x(p)-x(c)).",
      "used_by": [
        "pthm-sr-interval-and-cone-invariance",
        "thm-sr-tensor-and-current-transformation",
        "ex-sr-tensor-component-transformation",
        "ex-sr-four-current-boost",
        "ex-sr-primed-frame-origin-motion"
      ]
    },
    {
      "id": "lem-boost-rotation-factorization",
      "statement": "For L∈SO+(V,η), set u=Le0 and β=uspacial/u0. Then |β|<1, Rhat=B(β)L fixes e0 and restricts to a determinant-one spatial isometry, and L=B(-β)Rhat. This factorization is unique; conversely every such product is proper orthochronous. L is a passive boost iff Rhat=I.",
      "used_by": [
        "thm-sr-proper-orthochronous-lorentz-algebra",
        "ex-sr-boost-rotation-factorization-worked",
        "cex-sr-noncollinear-boosts-do-not-commute",
        "cex-sr-a-rotation-is-a-proper-orthochronous-lorentz-map-that-is-not-a-boost"
      ]
    },
    {
      "id": "thm-sr-tensor-and-current-transformation",
      "statement": "For inertial charts x'=Λx+b and Cℓ fields on an open Ω, vector components gain Λ and covector components gain Λ⁻¹; general tensor components gain these factors on their respective slots at the same event. Contraction is intrinsic, while remaining free indices retain their transformation factors. At points of total differentiability, ∂'a=(Λ⁻¹)b_a∂b and ∂'aJ'a=∂aJa. Physical current identification requires a separate model premise.",
      "used_by": [
        "ex-sr-tensor-component-transformation",
        "ex-sr-four-current-boost"
      ]
    }
  ],
