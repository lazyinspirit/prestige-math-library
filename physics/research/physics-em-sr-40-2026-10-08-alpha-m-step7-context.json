  "load_bearing": [
    {
      "id": "lem-sr-compact-variation-and-fundamental-lemma",
      "statement": "On a nonempty open chart domain, continuous g pairing to zero against every smooth compactly supported test is zero. For C¹ compactly supported f and C¹ g, ∫(∂af)g = −∫f(∂ag). A jointly continuous parameter family with continuous parameter derivative and one common compact support has a C¹ integral with derivative obtained by integrating that derivative. All integrals are Riemann integrals.",
      "used_by": [
        "lem-sr-scalar-field-euler-lagrange",
        "lem-sr-scalar-field-hilbert-stress-energy",
        "def-em-electromagnetic-tensor"
      ]
    },
    {
      "id": "thm-sr-stress-balance-and-finite-flux",
      "statement": "For a C¹ symmetric tensor on a neighbourhood of a closed nondegenerate axis-parallel box, each integral of ∂aTᵃᵇ equals the sum of positive-face integrals minus negative-face integrals. The finite slice integral Qᵇ is continuous and obeys the displayed bulk-minus-side-flux balance. Zero divergence and zero spatial side flux imply equal endpoint slice integrals.",
      "used_by": [
        "post-sr-matter-isolation-and-total-stress-energy",
        "pthm-sr-integrated-conservation-for-isolated-matter",
        "ex-sr-constant-velocity-dust-with-transverse-profile",
        "ex-sr-box-flux-balance-worked",
        "cex-sr-divergence-free-stress-energy-with-varying-slice-momentum"
      ]
    },
    {
      "id": "thm-sr-antisymmetric-observer-decomposition",
      "statement": "For an alternating bilinear form F on the oriented Lorentz vector space and a future unit n, eₐ = Fₐᵦnᵇ and bₐ = (*F)ₐᵦnᵇ are horizontal, F = n♭∧e − *(n♭∧b), and *²F = −F. In an adapted oriented orthonormal frame, ½FₐᵦFᵃᵇ = |b|²−|e|², Fₐᵦ(*F)ᵃᵇ = −4e·b and F∧F = 2(e·b)ε.",
      "used_by": [
        "def-em-electromagnetic-tensor"
      ]
    },
    {
      "id": "lem-sr-connecting-field-stretching",
      "statement": "For the stipulated C¹ future unit field and injective C² flow immersion Φ:J×B→Ω, Gᵢⱼ = h(eᵢ,eⱼ) is C¹ and positive definite, ∂sGᵢⱼ = (Lₙh)(eᵢ,eⱼ) = 2θ(eᵢ,eⱼ), and ∂τℓᵢ = cθ(uᵢ,uᵢ)ℓᵢ with uᵢ = h(eᵢ)/ℓᵢ. When θ vanishes on the family's image, every Gᵢⱼ is constant along each flow line.",
      "used_by": [
        "texp-sr-bell-rockets-thread",
        "ex-sr-bell-congruence-rest-separation-worked"
      ]
    },
    {
      "id": "lem-sr-uniform-low-speed-taylor-remainder",
      "statement": "For z₀∈[0,1), f(z) = (1−z)⁻¹ᐟ² and K(z₀) = ⅜(1−z₀)⁻⁵ᐟ², every z∈[0,z₀] satisfies f(z) = 1+z/2+R(z), |R(z)| ≤ K(z₀)z² and |f(z)−1| ≤ z/2+K(z₀)z².",
      "used_by": [
        "lem-sr-uniform-low-speed-expansion-of-observer-quantities",
        "lem-sr-uniform-galilean-limit-of-boost-charts",
        "pthm-sr-newtonian-p-e-correspondence",
        "ex-sr-low-speed-expansion-at-beta-one-fifth"
      ]
    },
    {
      "id": "lem-sr-scalar-field-hilbert-stress-energy",
      "statement": "For smooth φ and smooth potential V on the stipulated nonempty open domain, c,K > 0, and compactly supported smooth symmetric metric variations, the relative action derivative is (1/2c)∫Tᵃᵇhₐᵦ, where Tᵃᵇ = K[∂ᵃφ∂ᵇφ−ηᵃᵇ(½∂dφ∂ᵈφ+V(φ))]. T is smooth, symmetric and uniquely determined among continuous symmetric fields by all such pairings; background action convergence is unnecessary.",
      "used_by": [
        "lem-sr-scalar-field-stress-divergence-identity",
        "post-sr-matter-models-and-evolution",
        "pthm-sr-local-stress-energy-conservation",
        "ex-sr-scalar-field-plane-wave-stress-energy"
      ]
    },
    {
      "id": "lem-sr-scalar-field-stress-divergence-identity",
      "statement": "In the smooth Hilbert-tensor setting, ∂aTᵃᵇ = K(□φ−V′(φ))∂ᵇφ. The scalar equation implies conservation. Conversely conservation implies the scalar equation wherever dφ≠0; generally conservation is equivalent to (□φ−V′(φ))dφ = 0.",
      "used_by": [
        "pthm-sr-local-stress-energy-conservation",
        "ex-sr-scalar-field-plane-wave-stress-energy"
      ]
    },
    {
      "id": "lem-sr-dust-conservation-equivalence",
      "statement": "For C¹ ρ > 0 and C¹ future unit n on an open Ω, conservation of Tᵃᵇ = ρnᵃnᵇ is equivalent to ∂a(ρnᵃ) = 0 and nᵃ∂anᵇ = 0. If nonnegative ρ may vanish, conservation implies inertial flow only on {ρ > 0}. Under those hypotheses the stipulated integral curves have zero second derivative and are affine straight lines.",
      "used_by": [
        "pthm-sr-local-stress-energy-conservation",
        "ex-sr-dust-stress-energy-under-a-boost",
        "ex-sr-constant-velocity-dust-with-transverse-profile"
      ]
    },
    {
      "id": "lem-sr-perfect-fluid-conservation-equations",
      "statement": "For C¹ ε,P and C¹ future unit n, Tᵃᵇ = (ε+P)nᵃnᵇ+Pηᵃᵇ has divergence nᵇ[Dε+(ε+P)ϑ]+[(ε+P)aᵇ+hᵇᶜ∂cP]. Conservation is equivalent to both bracket expressions vanishing; no equation of state, positivity or causality condition is assumed.",
      "used_by": [
        "post-sr-matter-models-and-evolution",
        "pthm-sr-local-stress-energy-conservation",
        "ex-sr-perfect-fluid-rest-and-moving-frame"
      ]
    },
    {
      "id": "pthm-sr-rindler-horizons-and-radar",
      "statement": "Under the adopted flat model, ideal clocks, light and causal signal restriction, an event q can causally precede some event of a full Rindler worldline exactly when V(q)<0, and can causally follow one exactly when U(q)>0. For a distinct positive coaxial reflector radius, reflection and return occur at θe+|log(ρm/ρ₀)| and θe+2|log(ρm/ρ₀)|; radar distance is ρ₀|log(ρm/ρ₀)|. Any radar triple requires U>0,V<0.",
      "used_by": [
        "ex-sr-rindler-radar-distance-worked",
        "cex-sr-rindler-horizon-is-not-a-physical-boundary",
        "cex-sr-rindler-radar-distance-is-not-symmetric"
      ]
    },
    {
      "id": "pthm-sr-guided-ring-sagnac-delay",
      "statement": "For R>0, real Ω with |Ω|R<c, the stipulated circular guided signals and ideal receiver clock have first positive return times t₁ = 2πR/(c−ΩR), t₂ = 2πR/(c+ΩR). Their signed chart-time difference is 4πΩR²/(c²−Ω²R²), and receiver proper-time difference is that divided by γ. The chart-time and receiver proper-time rest-line holonomies are half these respective differences.",
      "used_by": [
        "ex-sr-guided-ring-sagnac-worked"
      ]
    },
    {
      "id": "lem-sr-uniform-low-speed-expansion-of-observer-quantities",
      "statement": "For future unit n, P=mU with m>0 and η(U,U)=−c², and z=|w|²/c²≤z₀<1, Eₙ = mc²+½m|w|²+R_E, Tₙ = ½m|w|²+R_E and qₙ = mw+R_q. Here |R_E|≤K(z₀)m|w|⁴/c² and |R_q|≤[½+K(z₀)z₀]z m|w|. Constants depend only on z₀, and both remainders vanish at w=0.",
      "used_by": [
        "pthm-sr-newtonian-p-e-correspondence",
        "rem-sr-newtonian-bridge-limits-and-failures"
      ]
    },
    {
      "id": "lem-sr-uniform-galilean-limit-of-boost-charts",
      "statement": "For fixed v,T,R and z₀∈(0,1), on D(T,R), whenever v≠0 and C≥|v|/√z₀, the time error is bounded by [A₀|v|²T+Γ₀|v|R]/C² and spatial error by A₀|v|²(R+|v|T)/C², where A₀=½+K(z₀)z₀ and Γ₀=(1−z₀)⁻¹ᐟ². The maps converge uniformly there to Gv; for v≠0 each error is unbounded on the whole chart domain at every finite admissible C.",
      "used_by": [
        "ex-sr-uniform-galilean-chart-bound-worked",
        "rem-sr-newtonian-bridge-limits-and-failures"
      ]
    }
  ],
