  "conventions": [
    {
      "convention": "Stress-energy is a symmetric type-(2,0) field on a nonempty open subset of affine Minkowski space. Divergence and balance terminology require C¹ regularity; continuity alone supplies only component conventions and pointwise contractions.",
      "fixed_by": "def-sr-stress-energy-tensor-and-force-density",
      "matters_for": [
        "lem-sr-observer-stress-energy-decomposition",
        "thm-sr-stress-balance-and-finite-flux",
        "pthm-sr-local-stress-energy-conservation",
        "cex-sr-prescribed-stress-energy-need-not-be-conserved"
      ]
    },
    {
      "convention": "In length coordinates x⁰ = ct, ε = T⁰⁰, momentum density πⁱ = T⁰ⁱ/c, stress Sⁱʲ = Tⁱʲ, and energy flux is cTⁱ⁰. Matter components have units J/m³; spatial divergence is force per volume and c times its temporal component is power per volume. These physical readings are adopted assumptions.",
      "fixed_by": "post-sr-matter-models-and-evolution",
      "matters_for": [
        "pthm-sr-local-stress-energy-conservation",
        "pthm-sr-integrated-conservation-for-isolated-matter",
        "rem-sr-continuum-force-and-conservation-scope"
      ]
    },
    {
      "convention": "Compact-support integrals are Riemann integrals of zero extensions on bounding nondegenerate rectangles. Parameter differentiation requires one common compact support and joint continuity of the integrand and its parameter derivative.",
      "fixed_by": "lem-sr-compact-variation-and-fundamental-lemma",
      "matters_for": [
        "lem-sr-scalar-field-euler-lagrange",
        "lem-sr-scalar-field-hilbert-stress-energy",
        "def-em-electromagnetic-tensor"
      ]
    },
    {
      "convention": "The metric signature is (−,+,+,+), ε₀₁₂₃ = +1 and ε⁰¹²³ = −1. The Hodge dual is (*F)ab = ½εab{}cd Fcd, with *²F = −F. The optional SI dictionary uses Fⁱ⁰ = Eᵢ/c and Fⁱʲ = −εᵢⱼₖBₖ; the EM consumer's tensor is its overall negative.",
      "fixed_by": "thm-sr-antisymmetric-observer-decomposition",
      "matters_for": [
        "def-em-electromagnetic-tensor"
      ]
    },
    {
      "convention": "Integrated conservation concerns finite nondegenerate boxes in one inertial chart, with C¹ data on a neighbourhood, local divergence zero and zero spatial side flux. Qᵇ = ∫T⁰ᵇ and Pᵇ = Qᵇ/c; no transformation law under changed chart or slicing is asserted.",
      "fixed_by": "pthm-sr-integrated-conservation-for-isolated-matter",
      "matters_for": [
        "cex-sr-divergence-free-stress-energy-with-varying-slice-momentum",
        "rem-sr-continuum-force-and-conservation-scope"
      ]
    },
    {
      "convention": "For C¹ future unit fields, Born rigidity means Lₙh = 0, equivalently θ = 0. The material-family hypothesis is an injective C² immersion with flow derivative n. Its flow parameter s satisfies τ = s/c; its metric length is internal label-space length, without an automatic finite endpoint-hyperplane interpretation.",
      "fixed_by": "lem-sr-connecting-field-stretching",
      "matters_for": [
        "texp-sr-bell-rockets-thread",
        "ex-sr-bell-congruence-rest-separation-worked",
