export function undeclaredDefTags(proof: string): string[] {
  const blockTerms = new Set<string>();
  const stepTerms: string[] = [];
  for (const line of String(proof || '').split('\n')) {
    const stripped = line.replace(/\*\*/g, '').trim();
    const isStep = /^\d+\.\d+\b/.test(stripped);
    const re = /\[def\.\s*([^\[\]]+?)\]/gi;
    let m: RegExpExecArray | null;
    while ((m = re.exec(stripped))) {
      const term = m[1].trim().toLowerCase();
      if (isStep) stepTerms.push(term);
      else blockTerms.add(term);
    }
    if (isStep) {
      const tg = /\[([^\[\]]+)\]/g;
