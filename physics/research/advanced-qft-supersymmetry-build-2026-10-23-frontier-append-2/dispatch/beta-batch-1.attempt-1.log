/* ── EXTENSION (2026-07-16, BUGLOG B6) — NOT part of the 0-diff parity port ──
 * A numbered step must contain mathematical content beyond its label and tags:
 * "1.3 [base]" satisfies proposedPrecheck mechanically but is humanly an empty
 * placeholder (the one real defect in the first e2e audit, pair 11). Run this
 * AFTER proposedPrecheck on its (possibly repaired) proof; null = pass. */
export function contentPrecheck(pf: string): string | null {
  for (const l of String(pf || '').split('\n')) {
    const stripped = l.replace(/\*\*/g, '').trim();
    const m = /^(\d+\.\d+)\b(.*)$/.exec(stripped);
    if (!m) continue;
    const residue = m[2].replace(/\[[^\[\]]*\]/g, '').replace(QED_RE, '').replace(/[\s.,;:]+/g, '');
    if (residue.length < 4) return 'empty-step-' + m[1];
  }
  return null;
}

/* ── EXTENSION (2026-07-17, owner-directed) — NOT part of the 0-diff parity port ──
 * "Number the final discharge line": generators sometimes leave the concluding
 * line unnumbered ("Therefore the claim is false. [discharge-construct: ...] ∎"),
 * so proposedPrecheck's strategy check never sees the discharge tag and rejects a
 * mathematically fine proof (observed: seeded-run wave 1, seed 1 variant 0). When
 * a line AFTER the last numbered step ends with a bracket tag (optionally + QED),
 * prepend the next-layer step number. Run BEFORE proposedPrecheck. */
export function numberFinalDischarge(pf: string): { proof: string; repaired: boolean } {
  const p0 = String(pf || '');
  const lines = p0.split('\n');
  let lastStepIdx = -1;
  let maxLayer = 0;
  lines.forEach((l, idx) => {
    const m = /^\s*(?:\*\*)?(\d+)\.\d+\b/.exec(l.replace(/\*\*/g, ''));
    if (m) {
      lastStepIdx = idx;
      maxLayer = Math.max(maxLayer, parseInt(m[1], 10));
    }
  });
  if (lastStepIdx < 0) return { proof: p0, repaired: false }; // no steps at all — nothing to anchor to
  for (let i = lastStepIdx + 1; i < lines.length; i++) {
    const t = lines[i].trim();
    if (!t) continue;
    // exactly the tagged-line shape proposedPrecheck credits: ends "[...]" + optional "." / QED
    if (/\[[^\[\]]{1,200}\]\s*\.?\s*(∎|■|□|\bQ\.?E\.?D\.?)?\s*$/i.test(t.replace(/\*\*/g, ''))) {
      lines[i] = lines[i].replace(/^(\s*)/, `$1${maxLayer + 1}.1 `);
      return { proof: lines.join('\n'), repaired: true };
    }
    return { proof: p0, repaired: false }; // trailing prose without a tag — leave for the checker
  }
  return { proof: p0, repaired: false };
}

/* ── EXTENSION (2026-07-17, D6b — proofs engine only; disproof F2 stays deferred) ──
 * Tag-comma guard: LaTeX inside a bracket tag breaks the comma tokenizer —
 * "[def. order in $\mathrm{Con}\,A$]" splits at the `\,` into a bogus "A$]" token
        for (const tok of g[1].split(',')) {
          const m = /^C(\d+)$/i.exec(tok.trim());
          if (m) cited.push('c' + m[1]);
        }
      }
    } else {
      // Declaration line: starts with a [C#] tag (optionally after a -/* bullet).
      const d = /^(?:[-*]\s*)?\[C(\d+)\]/i.exec(stripped);
      if (d) declared.add('c' + d[1]);
    }
  }
  if (!cited.length) return [];
  return [...new Set(cited.filter((c) => !declared.has(c)))].sort();
}

/** Phase-2 choose-before-use gate: a symbol introduced by a [choose]/[construct]
 *  step must be discharged/used only AFTER its introducing step. This mechanical
 *  check catches the narrower, reliably-detectable violation: a [choose] step
 *  that FORWARD-references a step number greater than its own (a repair-hoist
 *  artifact). Returns the offending step labels ([] if none). We intentionally
 *  do NOT try to track symbol scope here — that stays the judge's job; this only
 *  flags the structural forward-reference that phase repair can manufacture. */
export function chooseForwardRefs(proof: string): string[] {
  const bad: string[] = [];
  for (const line of String(proof || '').split('\n')) {
    const stripped = line.replace(/\*\*/g, '').trim();
    const sm = /^(\d+)\.(\d+)\b/.exec(stripped);
    if (!sm) continue;
    if (!/\[(?:choose|construct)\b/i.test(stripped)) continue;
    const layer = Number(sm[1]);
    const re = /step\s+(\d+)\.(\d+)/gi;
    let m: RegExpExecArray | null;
    while ((m = re.exec(stripped))) {
      if (Number(m[1]) > layer) { bad.push(`${sm[1]}.${sm[2]}`); break; }
    }
  }
  return bad;
}


/* ── D2-B: mechanical [L#] → [A#] assumption re-tag (pure; shared by BOTH engines
 * since the $50-audit fix round — a kept pair citing an unproven lemma re-tags the
 * citation as an assumption instead of shipping a dangling [L#]). ── */
export function retagAssumption(
  proof: string,
  uses: string[],
  lid: string,
  statement: string,
): { proof: string; uses: string[]; aid: string } {
  const lidU = lid.toUpperCase();
  let maxA = 0;
  const are = /\[A(\d+)\b/gi;
  let am: RegExpExecArray | null;
  while ((am = are.exec(proof))) maxA = Math.max(maxA, Number(am[1]));
  const aid = `A${maxA + 1}`;

  // Token-level tag replacement inside every bracket group.
  let out = proof.replace(/\[([^\[\]]+)\]/g, (_m, inner: string) => {
    const toks = inner.split(",").map((tok) => {
      const t = tok.trim();
      return t.toUpperCase() === lidU ? aid : t;
    });
    return `[${toks.join(", ")}]`;
  });

  // Facts line: "[L2] <stmt>" → "[A#] <full statement> (assumed)". B14: generators
  // sometimes bullet their Facts ("- [L2] …") — tolerate a leading dash/asterisk,
  // otherwise the re-tag inserts a DUPLICATE assumption line above the original.
  const lines = out.split("\n");
  const factLineIdx = lines.findIndex((l) => new RegExp(`^\\s*(?:[-*]\\s*)?\\[${aid}\\]`).test(l.trim()) && !/^\s*\d+\.\d+/.test(l));
  const assumedLine = `[${aid}] ${statement} (assumed)`;
  if (factLineIdx >= 0) {
    lines[factLineIdx] = assumedLine;
    out = lines.join("\n");
  } else {
    // No Facts line carried the lemma — insert one (after **Facts:** or **Given:**).
    const anchor = lines.findIndex((l) => /\*\*\s*Facts\s*:?\s*\*\*/i.test(l));
    const givenIdx = lines.findIndex((l) => /\*\*\s*Given\s*:?\s*\*\*/i.test(l));
    if (anchor >= 0) lines.splice(anchor + 1, 0, assumedLine);
    else if (givenIdx >= 0) lines.splice(givenIdx + 1, 0, "**Facts:**", assumedLine);
    else lines.unshift("**Facts:**", assumedLine);
    out = lines.join("\n");
  }
  return { proof: out, uses: uses.filter((u) => u.trim().toUpperCase() !== lidU), aid };
}

/* ── R2 ($50-audit fix round): relocate LEADING strategy tags. Generators
 * sometimes write "1.1 [construct] Let ..." — the tokenizer reads only the
 * TRAILING group, so the leading tag is dead decoration. Relocate known
 * strategy-class tags into the trailing group (deduped); citation-class tags
 * ([A#]/[F#]/[L#]/[C#]/[step p.q]) at line start are left untouched (moving
 * them would mangle prose). ── */
const LEAD_STRATEGY_TAG = /^(construct|choose|base|ih|assume-contra|assume-hyp|assume-case(?:\s+\w+)?|cases(?::.*)?|cases-exhaustive(?::.*)?|contrapositive-reduce|suffices(?::.*)?|discharge-(?:contradiction|contrapositive|induction|construct)(?::.*)?)$/i;
export function normalizeLeadingTags(proof: string): string {
  return String(proof || '').split('\n').map((line) => {
    const m = /^(\s*(?:\*\*)?\d+\.\d+(?:\*\*)?\s+)\[([^\[\]]+)\]\s*(\S.*)$/.exec(line);
    if (!m) return line;
    const [, head, lead, rest] = m;
    const leadToks = lead.split(',').map((t) => t.trim()).filter(Boolean);
    if (!leadToks.every((t) => LEAD_STRATEGY_TAG.test(t))) return line;
    const body = rest.trimEnd();
    const tm = /^(.*)\[([^\[\]]+)\](\s*\.?\s*∎?\s*)$/.exec(body);
    if (tm) {
      const trailToks = tm[2].split(',').map((t) => t.trim());
      const extra = leadToks.filter((t) => !trailToks.some((x) => x.toLowerCase() === t.toLowerCase()));
      return head + tm[1] + '[' + [...trailToks, ...extra].join(', ') + ']' + tm[3];
    }
    // No trailing group: QED-aware append.
    const qm = /^(.*?)(\s*\.?\s*∎\s*)$/.exec(body);
    if (qm) return head + qm[1] + ' [' + leadToks.join(', ') + ']' + qm[2];
    return head + body + ' [' + leadToks.join(', ') + ']';
  }).join('\n');
}

