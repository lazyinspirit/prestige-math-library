run='advanced-qft-supersymmetry-build-2026-10-23'; manifest=json.loads(Path(f'research/{run}-batch-1.pages.json').read_text()); ids=[x['id'] for p in manifest for x in p['items']]
def split_item(p):
 s=p.read_text(); m=re.match(r'"'^---'"\\r?\\n([\\s\\S]*?)\\r?\\n---\\r?\\n([\\s\\S]*)"'$'"',s)
 if not m: raise ValueError(f'malformed {p}')
 return yaml.safe_load(m.group(1)),m.group(2)
def section(body,h):
 m=re.search(rf'"'^## {re.escape(h)}'"\\s*\\r?\\n([\\s\\S]*?)(?="'^##'"\\s+|(?"'!['"\\s\\S]))',body,re.M); return m.group(1).strip() if m else ''
def facts(body):
