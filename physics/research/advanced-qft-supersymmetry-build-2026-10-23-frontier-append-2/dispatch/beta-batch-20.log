def source_quote(item, section, needle):
    text = Path('items', item + '.md').read_text()
    marker = '## ' + section + '\\n'
    start = text.index(marker) + len(marker)
    end = text.find('\\n## ', start)
    body = text[start:end if end >= 0 else None]
    if needle not in body:
        raise ValueError(f'quote not found in {item} / {section}: {needle}')
    return needle

