export function loadPhysicsRepository(root, plan = null, selectedPages = null) {
  root = realpathSync(resolve(root));
  const importsRaw = existsSync(join(root, 'research/math-imports.json')) ? readFileSync(join(root, 'research/math-imports.json'), 'utf8') : null;
  const imports = importsRaw === null ? { files: [] } : JSON.parse(importsRaw);
  const importedIds = new Set(imports.files.filter(f => f.path.startsWith('items/')).map(f => basename(f.path, '.md')));
  const items = markdownFiles(join(root, 'items')).map(file => {
    try { return readItem(file); }
    catch (error) { return { id: basename(file, '.md'), deps: [], body: '', file, frontmatterError: error.message }; }
  });
  const pages = markdownFiles(join(root, 'library')).filter(f => !basename(f).startsWith('_') && (selectedPages === null || selectedPages.has(basename(f, '.md')))).map(file => {
    let row;
    try { row = readItem(file); }
    catch (error) {
      if (selectedPages === null || selectedPages.has(basename(file, '.md'))) throw error;
      return null;
    }
    const categoryFile = join(root, 'library', file.slice(join(root, 'library').length + 1).split('/')[0], '_category.md');
    const imported = imports.files.some(f => join(root, f.path) === file);
    const library = imported ? 'mathematics' : existsSync(categoryFile) ? readItem(categoryFile).library : undefined;
    if ((selectedPages === null || selectedPages.has(row.id ?? row.page)) && row.library && library && row.library !== library) throw Error(`page/category library mismatch: ${file}`);
    return { ...row, library: row.library ?? library };
  }).filter(Boolean);
  if (plan) {
    for (const page of plan.pages ?? []) {
      const categoryFile = join(root, 'library', page.category ?? '', '_category.md');
      if ((selectedPages === null || selectedPages.has(page.id)) && existsSync(categoryFile)) {
        const categoryLibrary = readItem(categoryFile).library;
        if ((selectedPages === null || selectedPages.has(page.id)) && categoryLibrary && page.library && categoryLibrary !== page.library) throw Error(`planned page/category library mismatch: ${page.id}`);
      }
      pages.push({ ...page, library: page.library ?? (page.kind === 'P' ? pages.find(p => p.page === page.id)?.library : undefined) });
      for (const item of page.items ?? []) {
        const existing = items.find(i => i.id === item.id);
        if (!existing) items.push(item);
        else {
          if ((selectedPages === null || selectedPages.has(page.id)) && item.domain && existing.domain && item.domain !== existing.domain)
            throw Error(`planned/authored domain mismatch: ${item.id}`);
          if (selectedPages?.has(page.id)) {
            if (item.kind && existing.kind && item.kind !== existing.kind) throw Error(`planned/authored kind mismatch: ${item.id}`);
            if (existing.deps !== undefined && !Array.isArray(existing.deps)) throw Error(`invalid authored deps: ${item.id}`);
            const deps = [...new Set([...(Array.isArray(existing.deps) ? existing.deps : []), ...(item.deps ?? [])])];
            const dependency_roles = { ...(existing.dependency_roles ?? {}), ...(item.dependency_roles ?? {}) };
            items[items.indexOf(existing)] = { ...existing, ...item, deps, dependency_roles };
          }
        }
      }
    }
  }
  let originalItems = null;
  const importedReferenceContext = (consumer, token) => {
    if (!importedIds.has(consumer) || !imports.source_root || !/^[a-z]+-[a-z0-9]+(?:-[a-z0-9]+)*$/.test(token)) return null;
    const path = join(imports.source_root, 'items', `${token}.md`);
    if (existsSync(path)) {
      const original = readItem(path);
      return original.id === token ? { ...original, domain: original.domain ?? 'mathematics' } : null;
    }
    // Aliases are original-context identities too. Inspect only to resolve an
    // actual imported pointer; none of these rows enters the local item graph.
    originalItems ??= markdownFiles(join(imports.source_root, 'items')).map(readOriginalItemIdentity);
    const matches = originalItems.filter(item => Array.isArray(item.aliases) && item.aliases.includes(token));
    if (matches.length > 1) throw Error(`ambiguous imported nonlogical original reference ${token}`);
    if (!matches.length) return null;
    const original = readItem(matches[0].file);
    if (original.id !== matches[0].id || !Array.isArray(original.aliases) || !original.aliases.includes(token))
      throw Error(`imported nonlogical original identity changed during lookup: ${token}`);
    return { ...original, domain: original.domain ?? 'mathematics' };
  };
  const sourceContext = Object.freeze({});
  repositorySources.set(sourceContext, { root, importsRaw, importedIds: new Set(importedIds) });
  return { items, pages, importedIds, importedReferenceContext, sourceContext };
}
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { REPO } from './paths.mjs';
import { loadPhysicsRepository, validatePhysicsContent } from './physics-content.mjs';
import { verifyMathematicsImports } from './physics-imports.mjs';
import { frontierGateScope } from './frontier-gate-scope.mjs';
import { readRunManifestPages } from './run-manifest-pages.mjs';
const args = process.argv.slice(2), value = name => args[args.indexOf(name) + 1];
const root = args.includes('--root') ? resolve(value('--root')) : REPO;
try {
  if (args.includes('--step6-scope') && (!args.includes('--run') || args.includes('--plan')))
    throw Error('--step6-scope requires an authored --run frontier');
  let plan = args.includes('--plan') ? JSON.parse(readFileSync(resolve(root, value('--plan')), 'utf8')) : null;
  let proposedPages = null;
  if (args.includes('--pages-file')) {
    if (!plan || args.includes('--run')) throw Error('--pages-file requires --plan without --run');
    const ids = JSON.parse(readFileSync(resolve(root, value('--pages-file')), 'utf8'));
    if (!Array.isArray(ids) || !ids.length || ids.some(id => typeof id !== 'string' || !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(id)) || new Set(ids).size !== ids.length)
      throw Error('proposed page selection must contain nonempty unique page ids');
    proposedPages = ids.map(id => {
      const matches = plan.pages.filter(page => page.id === id);
      if (matches.length !== 1) throw Error(`proposed page ${id} must occur exactly once in plan`);
      const page = matches[0];
      if (!['A', 'B'].includes(page.kind) || !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(page.category ?? '') || !Number.isFinite(page.order) || !Array.isArray(page.items))
        throw Error(`invalid proposed page ${id}`);
      return page;
    });
  }
  verifyMathematicsImports(root, proposedPages ? { planning: true, proposedPages } : args.includes('--run') ? { run: value('--run'), planning: args.includes('--plan'), frontierOnly: args.includes('--step6-scope') } : {});
  const scope = proposedPages ? { pages: new Set(proposedPages.map(page => page.id)), items: new Set(proposedPages.flatMap(page => page.items.map(item => item.id))) }
    : args.includes('--run') ? frontierGateScope({ repo: root, run: value('--run') }, { requireItemFiles: !args.includes('--plan'), allowEmptyItems: args.includes('--plan') }) : null;
  if (scope && plan && !proposedPages) {
    const current = readRunManifestPages(root, value('--run'), { allowEmptyItems: true });
    for (const page of current) if (plan.pages.filter(p => p.id === page.id).length !== 1) throw Error(`current page ${page.id} must occur exactly once in plan`);
    const overlay = new Map(current.map(page => [page.id, page]));
    plan = { ...plan, pages: plan.pages.map(page => overlay.get(page.id) ?? page) };
  }
  const repo = loadPhysicsRepository(root, plan, scope?.pages ?? null);
  if (scope && !plan) for (const id of scope.pages)
    if (!repo.pages.some(page => (page.id ?? page.page) === id)) throw Error(`missing selected physics page ${id}`);
  const errors = validatePhysicsContent({ ...repo, requireBodies: !args.includes('--plan'), selectedItems: scope?.items ?? null, selectedPages: scope?.pages ?? null });
  if (args.includes('--json')) console.log(JSON.stringify({ errors, items: scope ? scope.items.size : repo.items.length }, null, 2));
  else {
    for (const error of errors) console.error(`ERROR ${error.code} [${error.id}]: ${error.message}`);
    console.log(`physics-content: ${errors.length} error(s), ${scope ? scope.items.size : repo.items.length} items checked`);
  }
  process.exitCode = errors.length ? 1 : 0;
} catch (error) { console.error(`physics-content: ${error.message}`); process.exitCode = 1; }

