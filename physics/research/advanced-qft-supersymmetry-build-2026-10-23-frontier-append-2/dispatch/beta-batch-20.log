def source_quote(item, section, needle):
    text = Path('items', item + '.md').read_text()
    marker = '## ' + section + '\\n'
    start = text.index(marker) + len(marker)
    end = text.find('\\n## ', start)
    body = text[start:end if end >= 0 else None]
    norm_body = re.sub(r'\\s+', ' ', body).strip()
    norm_needle = re.sub(r'\\s+', ' ', needle).strip()
    if norm_needle not in norm_body:
        raise ValueError(f'quote not found in {item} / {section}: {norm_needle}')
    return norm_needle

