// TypeScript port of pc.js `proposedPrecheck` (+ helpers), itself a JS port of harness.py
// proposed_precheck. Logic is byte-for-byte identical to pc.js — verified 0-diff via the parity
// suite in test/precheck.test.ts. Do NOT "improve" the logic; only types were added.

export interface PrecheckResult {
  err: string | null;
  strategy?: string;
  repaired?: boolean;
  proof?: string;
}

interface StepMeta {
  idx: number;
  label: string;
  text: string;
  cites?: string[];
}

export const QED_RE = /∎|■|□|\\blacksquare|\\square|\\qedsymbol|\\qed|\\halmos|\bQ\.?E\.?D\.?\b/i;
export const PROP_TAG =
  /^(given|f\d+|a\d+|l\d+|c\d+|step\s+\d+\.\d+|\d+\.\d+|algebra|assume-contra|assume-hyp|ih|assume-case(?:\s+\w+)?|base|construct|choose|suffices(?::.*)?|contrapositive-reduce|discharge-(?:contradiction|contrapositive|induction|construct)(?::.*)?|contradiction(?::.*)?|contrapositive(?::.*)?|induction(?::.*)?|cases(?::.*)?|cases-exhaustive(?::.*)?)$/;

export function tagPresent(tagname: string, text: string): boolean {
  const re = /\[([^\[\]]+)\]/g;
  let m: RegExpExecArray | null;
  while ((m = re.exec(text))) {
    for (const tok of m[1].split(',')) {
      const t = tok.trim().toLowerCase();
      if (t === tagname || t.startsWith(tagname + ':') || t.startsWith(tagname + ' ')) return true;
    }
  }
  return false;
}

export function tagCount(prefix: string, text: string): number {
  let n = 0;
  const re = /\[([^\[\]]+)\]/g;
  let m: RegExpExecArray | null;
  while ((m = re.exec(text))) {
    for (const tok of m[1].split(',')) if (tok.trim().toLowerCase().startsWith(prefix)) n++;
  }
  return n;
}

export function layerRepair(
  p0: string,
  lines: string[],
  meta: StepMeta[],
  cites: string[][],
  pinTerminal: boolean,
): [string, boolean] {
  const layerOf: Record<string, number> = {};
  meta.forEach((s, i) => {
    let L = 1;
    for (const c of cites[i]) L = Math.max(L, (layerOf[c] || 1) + 1);
    layerOf[s.label] = L;
  });
