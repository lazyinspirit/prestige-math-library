      continue;
    }
    if (seen.has(name)) error('boundary-duplicate', `${name} is listed twice`, id);
    seen.add(name);
    if (!['checked', 'not_applicable'].includes(status)) error('boundary-status', `${name} must be checked or not_applicable`, id);
    if (status === 'checked') {
