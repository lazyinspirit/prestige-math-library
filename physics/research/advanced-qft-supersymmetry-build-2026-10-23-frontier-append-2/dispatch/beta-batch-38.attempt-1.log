export function itemHash(s, id, extra = []) {
  return hash([...itemInputs(s, id, extra)].sort(([a], [b]) => a.localeCompare(b)));
}

// Use the same transitive closure as itemHash when checking who authored its
// current inputs. Both item text and run/planned dependency metadata contribute.
export function itemInputPaths(s, id, extra = []) {
  const paths = new Set();
  for (const key of itemInputs(s, id, extra).keys()) {
    const itemPath = join(s.root, 'items', `${safe(key)}.md`);
    if (existsSync(itemPath)) paths.add(itemPath);
    const live = s.items.get(key);
    if (live) paths.add(join(s.root, 'research', `${s.run}-batch-${live.page.batch}.pages.json`));
    else if (s.planned.has(key)) paths.add(join(s.root, 'research', 'plan-spec.json'));
  }
  return [...paths];
}
#!/usr/bin/env node
import { realpathSync as physicsRealpath } from 'node:fs';
// Step-1 scaffold labels and Step-3 author order. Out-of-run dependencies do
// not raise an in-run level; other gates check whether they are available.
import { readFileSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import { pathToFileURL } from 'node:url';

export function runPages(root, run) {
  if (!/^[a-zA-Z0-9_-]+$/.test(run ?? '')) throw Error('Invalid run');
  return readdirSync(join(root, 'research'))
    .filter(name => new RegExp(`^${run}-batch-\\d+\\.pages\\.json$`).test(name))
    .sort((a, b) => Number(a.match(/-batch-(\d+)/)[1]) - Number(b.match(/-batch-(\d+)/)[1]))
    .flatMap(name => JSON.parse(readFileSync(join(root, 'research', name), 'utf8'))
      .map(page => ({ ...page, batch: name.match(/-batch-(\d+)/)[1] })));
}

export function dependencyLevels(pages, { validateLabels = true } = {}) {
  const items = new Map(), errors = [], levels = new Map(), visiting = new Set();
  for (const page of pages) {
    if (!Array.isArray(page.items) || !page.items.length)
      errors.push(`${page.id}: empty scaffold inventory`);
    for (const item of Array.isArray(page.items) ? page.items : []) {
      if (!item?.id || typeof item.id !== 'string') {
        errors.push(`${page.id}: item has no ID`);
        continue;
      }
      if (items.has(item.id)) errors.push(`${item.id}: appears on more than one page`);
      else items.set(item.id, { item, page });
    }
  }
  const visit = (id, path = []) => {
    if (levels.has(id)) return levels.get(id);
    if (visiting.has(id)) {
      errors.push(`dependency cycle: ${[...path, id].join(' -> ')}`);
      return 0;
    }
    const item = items.get(id)?.item;
    if (!item) return 0;
    if (!Array.isArray(item.deps) || item.deps.some(dep => typeof dep !== 'string' || !dep)) {
      errors.push(`${id}: deps must be an array of item IDs`);
      return 0;
    }
    visiting.add(id);
    let level = 0;
    for (const dep of item.deps) if (items.has(dep)) level = Math.max(level, visit(dep, [...path, id]) + 1);
    visiting.delete(id);
    levels.set(id, level);
    return level;
  };
  for (const id of items.keys()) visit(id);
  for (const [id, { item }] of items) {
    if (!validateLabels) continue;
    if (!Number.isSafeInteger(item.dependency_level) || item.dependency_level < 0)
      errors.push(`${id}: dependency_level must be a nonnegative integer`);
    else if (item.dependency_level !== levels.get(id))
      errors.push(`${id}: dependency_level ${item.dependency_level} differs from computed ${levels.get(id)}`);
  }
  return { items, levels, errors };
}

export function orderedItems(pages, options) {
  const { items, levels, errors } = dependencyLevels(pages, options);
  if (errors.length) throw Error(errors.join('\n'));
  return [...items.entries()].map(([id, { item, page }]) => ({
    id, level: levels.get(id), batch: String(page.batch), page: page.id, order: Number(page.order), item,
  })).sort((a, b) => a.level - b.level || a.order - b.order || a.id.localeCompare(b.id));
}

if (process.argv[1] && import.meta.url === pathToFileURL(physicsRealpath(process.argv[1])).href) {
  try {
    const [command, flag, run] = process.argv.slice(2);
    if (command !== 'check' || flag !== '--run' || !run) throw Error('Usage: item-dependency-levels.mjs check --run RUN');
    const pages = runPages(process.cwd(), run);
    if (!pages.length) throw Error(`No manifests for ${run}`);
    const { items, levels, errors } = dependencyLevels(pages);
    if (errors.length) {
      for (const error of errors) console.error(`ERROR dependency-level: ${error}`);
      process.exitCode = 1;
    } else console.log(`item-dependency-levels: ${items.size} item(s) checked across ${pages.length} page(s); maximum level ${Math.max(0, ...levels.values())}`);
  } catch (error) { console.error(error.message); process.exitCode = 1; }
}
  {constructionScheduling=false, constructionSchedulingDuplicateProjection=false}={}) {
  const options = {constructionScheduling, constructionSchedulingDuplicateProjection};
  const snapshot = loadStep3(root, run, options), homes = new Map();
  for (const page of snapshot.pages) {
    assert(typeof page.id === 'string' && page.id && !homes.has(page.id),
      `Invalid or duplicate page ownership: ${page.id}`);
    homes.set(page.id, page.batch);
    assert(Array.isArray(page.requires ?? []) && (page.requires ?? []).every(id => typeof id === 'string' && id),
      `${page.id}: requires must name pages`);
    for (const item of page.items ?? []) assert(Array.isArray(item.deps ?? [])
      && (item.deps ?? []).every(id => typeof id === 'string' && id), `${item.id}: deps must name items`);
  }
  const batches = [...new Set(snapshot.pages.map(page => page.batch))].sort(compare);
  const pass = constructionScheduling
    ? { [constructionSchedulingDuplicateProjection ? 'scopeSchedulingProjectedSnapshot' : 'scopeSchedulingSnapshot']: snapshot }
    : { scopeSnapshot: snapshot };
  const graph = batches.map(batch => ({ batch, requires: prerequisiteBatches(root, run, batch, pass, options) }));
  const fineGraphs = validatedSchedulingGraphs(root, snapshot);
  // Equal-priority components preserve EVERY declared batch edge. Only the
  // original item/page graphs, not their ownership quotient, must be DAGs.
  const aggregate = aggregateDependencyOrder(new Map(graph.map(row => [row.batch, row.requires])));
  const rows = graph.map(({ batch, requires }) => ({ batch,
    dependency_level: aggregate.levels.get(batch), requires }))
    .sort((a, b) => a.dependency_level - b.dependency_level || compare(a.batch, b.batch));
  const projectedInputs = snapshot.schedulingManifestInputs ? new Map(snapshot.schedulingManifestInputs) : null;
  const manifests = batches.map(batch => [batch, projectedInputs?.get(batch)
    ?? readFileSync(join(root, 'research', `${run}-batch-${batch}.pages.json`), 'utf8')]);
  return { version: 1, run, input_sha256: digest({ manifests, graph, fineGraphs,
    ...(snapshot.schedulingIdentityInputs ? { schedulingIdentityInputs: snapshot.schedulingIdentityInputs } : {}),
    ...(snapshot.schedulingDuplicateProjection ? { schedulingDuplicateProjection: snapshot.schedulingDuplicateProjection } : {}) }),
    ...(snapshot.schedulingDuplicateProjection ? { schedulingDuplicateProjection: snapshot.schedulingDuplicateProjection } : {}), batches: rows };
}

export function writeBatchDependencyLevels(root, run, options={}) {
  const current = computeRunBatchDependencyLevels(root, run, options), path = batchDependencyLevelsPath(root, run);
  const temp = `${path}.${process.pid}.tmp`;
  writeFileSync(temp, JSON.stringify(current, null, 2) + '\n');
  renameSync(temp, path);
  return current;
}

export function checkBatchDependencyLevels(root, run) {
  const current = computeRunBatchDependencyLevels(root, run), path = batchDependencyLevelsPath(root, run);
  assert(existsSync(path), `Missing batch dependency levels: ${path}`);
  const recorded = JSON.parse(readFileSync(path, 'utf8'));
  assert(JSON.stringify(recorded) === JSON.stringify(current), `Stale batch dependency levels for ${run}; recompute before authoring`);
  return current;
}

if (process.argv[1] && import.meta.url === pathToFileURL(realpathSync(process.argv[1])).href) {
  try {
    const [command, ...args] = process.argv.slice(2);
    const option = name => args[args.indexOf(`--${name}`) + 1];
    assert(['write', 'check'].includes(command) && args.includes('--run'),
      'Usage: batch-dependency-levels.mjs write|check --run RUN [--root ROOT]');
    const root = args.includes('--root') ? resolve(option('root')) : process.cwd();
    const result = (command === 'write' ? writeBatchDependencyLevels : checkBatchDependencyLevels)(root, option('run'));
    console.log(`batch-dependency-levels: ${result.batches.length} batch(es); maximum level ${Math.max(...result.batches.map(row => row.dependency_level))}`);
  } catch (error) { console.error(error.message); process.exitCode = 1; }
}

