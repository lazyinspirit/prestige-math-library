const fs = require('node:fs');
const manifestPath = 'research/advanced-qft-supersymmetry-build-2026-10-23-batch-13.pages.json';
const contractsPath = 'research/advanced-qft-supersymmetry-build-2026-10-23-batch-13.proof-contracts.json';
const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
const sourceTexts = new Map();
function sectionText(file, heading) {
  const text = fs.readFileSync(file, 'utf8');
  const marker = "'`## ${heading}`;
  const start = text.indexOf(marker);
  if (start < 0) throw new Error(`Missing ${marker} in ${file}`);
  const bodyStart = text.indexOf('"'\\n', start) + 1;
  const rest = text.slice(bodyStart);
  const next = rest.search(/"'^## /m);
  return (next < 0 ? rest : rest.slice(0, next)).trim();
}
for (const page of manifest) for (const item of page.items) {
  const heading = item.kind === '"'definition' ? 'Definition' : item.kind === 'example' ? 'Example' : 'Statement';
  const value = sectionText(item.reference, heading);
  item.statement = value;
  sourceTexts.set(item.id, value);
}
const contracts = JSON.parse(fs.readFileSync(contractsPath, 'utf8'));
function refreshQuotes(value) {
  if (Array.isArray(value)) return value.forEach(refreshQuotes);
  if ("'!value || typeof value !== '"'object') return;
  if (typeof value.source === 'string' && typeof value.source_section === 'string' && 'quote' in value) {
    const section = value.source_section;
    const source = value.source;
    const match = manifest.flatMap(page => page.items).find(item => item.id === source);
    if (match) value.quote = sectionText(match.reference, section);
  }
  for (const child of Object.values(value)) refreshQuotes(child);
}
refreshQuotes(contracts);
fs.writeFileSync(manifestPath, JSON.stringify(manifest, null, 2) + '\\n');
fs.writeFileSync(contractsPath, JSON.stringify(contracts, null, 2) + '\\n');
console.log("'`Synchronized ${manifest.flatMap(page => page.items).length} manifest statements and source excerpts.`);
