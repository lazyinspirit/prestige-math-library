  if (!existsSync(path)) { console.error(`ERROR fetch-check-no-coverage: ${file}`); process.exit(1); }
  const cov = JSON.parse(readFileSync(path, 'utf8'));
  let changed = false;
  for (const page of cov.pages ?? []) {
