      if (resolutionErrors.length) {
        failures.push(`fetch-check-source-resolution: ${page.page}: ${source.url} — ${resolutionErrors.join('; ')}`);
        continue;
      }
      if (sourceDropped(source)) { dropped += 1; continue; }
      if (source.fetch_verified && !force) {
