    if (!m) continue;
    const stray = [...m[2].matchAll(/\\(.)/g)].filter((e) =>
      !'\\"'.includes(e[1]) && !/^(?:u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|x[0-9a-fA-F]{2})/.test(m[2].slice(e.index + 1)));
