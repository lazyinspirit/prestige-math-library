/* ── R2 ($50-audit fix round): relocate LEADING strategy tags. Generators
 * sometimes write "1.1 [construct] Let ..." — the tokenizer reads only the
 * TRAILING group, so the leading tag is dead decoration. Relocate known
 * strategy-class tags into the trailing group (deduped); citation-class tags
 * ([A#]/[F#]/[L#]/[C#]/[step p.q]) at line start are left untouched (moving
 * them would mangle prose). ── */
const LEAD_STRATEGY_TAG = /^(construct|choose|base|ih|assume-contra|assume-hyp|assume-case(?:\s+\w+)?|cases(?::.*)?|cases-exhaustive(?::.*)?|contrapositive-reduce|suffices(?::.*)?|discharge-(?:contradiction|contrapositive|induction|construct)(?::.*)?)$/i;
export function normalizeLeadingTags(proof: string): string {
  return String(proof || '').split('\n').map((line) => {
    const m = /^(\s*(?:\*\*)?\d+\.\d+(?:\*\*)?\s+)\[([^\[\]]+)\]\s*(\S.*)$/.exec(line);
    if (!m) return line;
    const [, head, lead, rest] = m;
    const leadToks = lead.split(',').map((t) => t.trim()).filter(Boolean);
    if (!leadToks.every((t) => LEAD_STRATEGY_TAG.test(t))) return line;
    const body = rest.trimEnd();
    const tm = /^(.*)\[([^\[\]]+)\](\s*\.?\s*∎?\s*)$/.exec(body);
    if (tm) {
      const trailToks = tm[2].split(',').map((t) => t.trim());
      const extra = leadToks.filter((t) => !trailToks.some((x) => x.toLowerCase() === t.toLowerCase()));
      return head + tm[1] + '[' + [...trailToks, ...extra].join(', ') + ']' + tm[3];
    }
    // No trailing group: QED-aware append.
    const qm = /^(.*?)(\s*\.?\s*∎\s*)$/.exec(body);
    if (qm) return head + qm[1] + ' [' + leadToks.join(', ') + ']' + qm[2];
    return head + body + ' [' + leadToks.join(', ') + ']';
  }).join('\n');
}
// The normative checker reads one line per step; Markdown reads one paragraph.
// Join only soft line breaks within numbered paragraphs. Keep paragraph/step
// boundaries and every mathematical token, citation and justification intact.
export function normalizeNumberedParagraphs(text) {
  return text.split(/(\r?\n[ \t]*\r?\n)/).map(block =>
    /^[ \t]*(?:\*\*)?\d+\.\d+\b/.test(block)
      ? block.replace(/\r?\n(?![ \t]*(?:\*\*)?\d+\.\d+\b)/g, ' ')
      : block
  ).join('');
}

/** Facts declarations plus proof steps, with existing legacy-body support. */
export function checkableText(md) {
  const fa = md.split(/\n## Facts & Assumptions\n/);
  if (fa.length >= 2) return normalizeNumberedParagraphs(fa[fa.length - 1].replace(/^## .*$/gm, '').trim());
  const body = md.split(/\n## (Proof|Refutation|Verification|Counterexample)\n/);
  if (body.length >= 3) return normalizeNumberedParagraphs(body[body.length - 1].trim());
  return null;
}

