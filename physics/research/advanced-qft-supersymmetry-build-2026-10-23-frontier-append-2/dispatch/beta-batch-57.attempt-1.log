export function layerRepair(
  p0: string,
  lines: string[],
  meta: StepMeta[],
  cites: string[][],
  pinTerminal: boolean,
): [string, boolean] {
  const layerOf: Record<string, number> = {};
  meta.forEach((s, i) => {
    let L = 1;
    for (const c of cites[i]) L = Math.max(L, (layerOf[c] || 1) + 1);
    layerOf[s.label] = L;
  });
  if (pinTerminal && meta.length) {
    let term: string | null = null;
    for (const s of meta) {
      if (QED_RE.test(lines[s.idx]) || /\[discharge-/i.test(lines[s.idx])) term = s.label;
    }
    if (term !== null) {
      const others = Object.keys(layerOf)
        .filter((k) => k !== term)
        .map((k) => layerOf[k]);
      if (others.length) layerOf[term] = Math.max.apply(null, others) + 1;
    }
  }
  const orderIdx = meta
    .map((_, i) => i)
    .sort((a, b) => layerOf[meta[a].label] - layerOf[meta[b].label] || a - b);
  const perLayer: Record<number, number> = {};
  const relabel: Record<string, string> = {};
  let changed = false;
  for (const i of orderIdx) {
    const L = layerOf[meta[i].label];
    perLayer[L] = (perLayer[L] || 0) + 1;
    const nl = L + '.' + perLayer[L];
    relabel[meta[i].label] = nl;
    if (nl !== meta[i].label) changed = true;
  }
  let reordered = false;
  for (let x = 1; x < orderIdx.length; x++) if (orderIdx[x] < orderIdx[x - 1]) reordered = true;
  if (!changed && !reordered) {
    // B1 fix (D6a, owner-approved 2026-07-17 — deliberate divergence from the n8n
    // parity source): the caller (induction base-promotion) may have mutated
    // `lines`; returning the original p0 here silently DROPPED the promoted
    // [base] tag the checker just credited. Honor the mutated lines.
    const joined = lines.join('\n');
    return joined === p0 ? [p0, false] : [joined, true];
  }
  const newLines = lines.slice();
  const slots = meta.map((s) => s.idx);
  orderIdx.forEach((i, k) => {
    newLines[slots[k]] = lines[meta[i].idx].replace(
      /^(\s*(?:\*\*)?)(\d+\.\d+)/,
      (_mm, g1, g2) => g1 + (relabel[g2] || g2),
    );
  });
  let out = newLines.join('\n');
  out = out.replace(
    /(steps?\s+)((?:\d+\.\d+)(?:(?:\s*,\s*|\s+and\s+|\s*&\s*)\d+\.\d+)*)/gi,
    (_mm, g1, g2) => g1 + g2.replace(/\d+\.\d+/g, (x: string) => relabel[x] || x),
  );
  return [out, true];
}

