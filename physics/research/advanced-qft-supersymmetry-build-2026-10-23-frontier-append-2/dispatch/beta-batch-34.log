        "title": "Gapped scalar EFT forward channel and matched coefficient data",
        "reference": "items/def-aqft-eft-scattering-channel.md",
        "design_state": "Step 1 authored draft; exact assigned contract; readiness recorded separately.",
        "dependency_level": 1,
        "deps": [
