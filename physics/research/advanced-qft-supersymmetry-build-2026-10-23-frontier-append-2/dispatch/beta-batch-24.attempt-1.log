id: prop-aqft-finite-gaussian-shell-composition
kind: proposition
domain: mathematics
library: physics
title: Successive finite Gaussian shells compose
status: draft
origin: pipeline
dependency_level: 0
deps:
  - def-axiom-of-choice
  - def-qftx-finite-gaussian-shell-transform
  - prop-qftx-finite-gaussian-shell-semigroup
justified_by: []
