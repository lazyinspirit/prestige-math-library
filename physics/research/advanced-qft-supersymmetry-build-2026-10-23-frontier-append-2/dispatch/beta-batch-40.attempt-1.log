  "id": "thm-aqft-finite-two-group-gauging-gluing",
  "kind": "theorem",
  "domain": "mathematics",
  "dependency_level": 5,
  "deps": [
    "def-aqft-background-gauging-data",
    "def-aqft-finite-background-two-groupoid",
