  'ex-qftx-omega-u2-one-instanton-factor',
];
const records = new Map();
for (const id of ids) {
  const raw = readFileSync("'`items/${id}.md`, '"'utf8');
  const m = raw.match(/"'^---'"\\n([\\s\\S]*?)\\n---\\n([\\s\\S]*)"'$/);
  if (!m) throw new Error(`no frontmatter: ${id}`);
  const fm = parseFrontmatter(m[1]);
  const heading = fm.kind === '"'definition' ? 'Definition' : fm.kind === 'example' ? 'Example' : 'Statement';
  const section = m[2].match(new RegExp("'`''^## ${heading}'"\\\\s*\\\\n([\\\\s\\\\S]*?)(?="'^## |(?!['"\\\\s\\\\S]))"'`, '"'m'))?.[1]?.trim();
  if ("'!section) throw new Error(`no ${heading}: ${id}`);
  const prior = pages.flatMap(p => p.items).find(x => x.id === id) ?? {};
  const record = {
    ...prior,
    id: fm.id, kind: fm.kind, domain: fm.domain, library: fm.library, title: fm.title,
    dependency_level: fm.dependency_level, deps: fm.deps ?? [], dependency_roles: fm.dependency_roles ?? {},
