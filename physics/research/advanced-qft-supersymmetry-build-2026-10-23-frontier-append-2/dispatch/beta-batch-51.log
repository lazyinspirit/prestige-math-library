      : 'Step 1 authored; current direct supplier readiness is recorded in the batch notes and decision ledger.',
    inventory_expansion_required: false, statement: section,
  };
  records.set(id, record);
}
pages[0].items = ids.slice(0, 3).map(id => records.get(id));
pages[1].items = ids.slice(3).map(id => records.get(id));
writeFileSync(manifestPath, JSON.stringify(pages, null, 2) + '\\n');
