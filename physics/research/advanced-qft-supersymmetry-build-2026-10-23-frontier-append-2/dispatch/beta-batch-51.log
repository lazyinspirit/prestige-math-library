    } else if (sourceItem.statementProvenance === 'ai-generated') {
      error('citation-ai-generated-statement', `${fact} cites ${source}, whose provenance.statement is ai-generated`, id);
    } else if (!SOURCE_SECTIONS.has(section)) {
