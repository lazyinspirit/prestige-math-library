from math import sqrt
O=(0,1,2)  # 0=1, 1=psi, 2=sigma

def fuse(a,b):
    if a==0: return (b,)
    if b==0: return (a,)
    if a==1 and b==1: return (0,)
    if (a,b) in ((1,2),(2,1)): return (2,)
    if a==2 and b==2: return (0,1)
