from itertools import product
from math import sqrt
O=(0,1,2);names={0:'1',1:'ψ',2:'σ'}
def fuse(a,b):
 if a==0:return (b,)
 if b==0:return (a,)
 if (a,b)==(1,1):return (0,)
 if (a,b) in ((1,2),(2,1)):return (2,)
 if (a,b)==(2,2):return (0,1)
def F(a,b,c,e,x,y):
 if x not in fuse(a,b) or e not in fuse(x,c) or y not in fuse(b,c) or e not in fuse(a,y):return 0.0
 if a==b==c==2 and e==2:return ((1,1),(1,-1))[x][y]/sqrt(2)
 if (a,b,c,e) in ((1,2,1,2),(2,1,2,1)):return -1.0
 return 1.0
def special(a,b,c,e):return (a==b==c==2 and e==2) or (a,b,c,e) in ((1,2,1,2),(2,1,2,1))
rows=[]
for a,b,c,d,e in product((1,2), repeat=5):
 hit=False; nz=0
 for f,g,k,l in product(O,repeat=4):
  lhs=F(f,c,d,e,g,l)*F(a,b,l,e,f,k)
  rhs=sum(F(a,b,c,g,f,h)*F(a,h,d,e,g,k)*F(b,c,d,k,h,l) for h in O)
  if lhs or rhs:
