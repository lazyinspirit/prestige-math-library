const ids = new Set(batch.flatMap(p => [p.id, ...p.items.map(i => i.id)]));
const pageIds = new Set(batch.map(p => p.id));
const itemIds = new Set(batch.flatMap(p => p.items.map(i => i.id)));
const supplierPages = new Set();
const supplierItems = new Set(fs.readdirSync('items').filter(x => x.endsWith('.md')).map(x => x.slice(0, -3)));
const seen = new Set();
for (const file of fs.readdirSync('library', { recursive: true }).filter(x => x.endsWith('.md'))) {
  const text = fs.readFileSync('library/' + file, 'utf8');
  const frontmatter = text.match(/"'^---'"\\r?\\n([\\s\\S]*?)\\r?\\n---/);
  const id = frontmatter?.[1].match(/"'^page:'"\\s*(\\S+)/m)?.[1];
  if (id) supplierPages.add(id);
}
const errors = [];
for (const edge of edges) {
  if ("'!ids.has(edge.consumer)) errors.push('"'consumer outside batch: ' + edge.consumer);
  if ("'!edge.evidence?.trim()) errors.push('"'empty evidence: ' + edge.consumer + '->' + edge.supplier);
  if (edge.kind === 'page' && "'!supplierPages.has(edge.supplier)) errors.push('"'missing page supplier: ' + edge.supplier);
  if (edge.kind === 'item' && "'!supplierItems.has(edge.supplier)) errors.push('"'missing item supplier: ' + edge.supplier);
  if ((edge.kind === 'page' && pageIds.has(edge.supplier)) || (edge.kind === 'item' && itemIds.has(edge.supplier)))
    errors.push('same-batch edge listed: ' + edge.consumer + '->' + edge.supplier);
  const key = edge.kind + '|' + edge.consumer + '|' + edge.supplier;
  if (seen.has(key)) errors.push('duplicate edge: ' + edge.consumer + '->' + edge.supplier);
  seen.add(key);
}
console.log(JSON.stringify({rows: edges.length, pageRows: edges.filter(e => e.kind === 'page').length,
  itemRows: edges.filter(e => e.kind === 'item').length, errors}, null, 2));
if (errors.length) process.exit(1);
