errors=[]
if set(ids)"'!=set(doc['"'scope']) or set(ids)"'!=set(doc['"'contracts']): errors.append('scope mismatch')
for iid,c in doc['contracts'].items():
  md=Path(f'items/{iid}.md').read_text()
  labels=set()
  for line in md.splitlines():
    m=re.match(r'"'^'"\\s*(?:\\*\\*)?(\\d+\\.\\d+)\\s',line)
    if m: labels.add(m.group(1))
  for d in c.get('derivations',[]):
    if d.get('step') not in labels: errors.append(f\"{iid}: bad step {d.get('step')}\")
  for q in c.get('citations',[]):
    src=Path(f\"items/{q['source']}.md\")
    if not src.exists() or q['quote'] not in src.read_text(): errors.append(f\"{iid}: inexact quote {q.get('fact')}\")
    if any(s not in labels for s in q.get('uses',[])): errors.append(f\"{iid}: bad citation step {q.get('fact')}\")
print(json.dumps({'items':len(ids),'contracts':len(doc['contracts']),'scope_matches':set(ids)==set(doc['scope']),'errors':errors},indent=2))
if errors: raise SystemExit(1)
