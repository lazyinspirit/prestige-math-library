+  lem-qftx-bv-master-equation-brst-nilpotence: mathematical-premise
+proof_strategy: direct
+provenance:
+  statement: ai-generated
+  proof: ai-generated
+generation:
+  role: example
+sources:
+  references: []
+verification:
