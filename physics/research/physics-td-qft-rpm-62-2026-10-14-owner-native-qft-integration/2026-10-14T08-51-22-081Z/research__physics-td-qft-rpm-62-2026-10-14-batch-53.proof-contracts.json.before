    "texp-qft-qed-infrared-sequence": {
      "citations": [
        {
          "fact": "A1",
          "source": "def-countable-choice",
          "source_section": "Definition",
          "quote": "Axiom of Countable Choice",
          "uses": [
            "1.1",
