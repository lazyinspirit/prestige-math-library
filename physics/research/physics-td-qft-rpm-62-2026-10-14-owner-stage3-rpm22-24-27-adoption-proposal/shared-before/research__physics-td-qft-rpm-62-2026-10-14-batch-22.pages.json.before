        },
        "dependency_level": 3,
        "sources": {
          "references": [
            {
              "title": "David Tong, String Theory, complete lecture notes, \u00a71.1.2 relativistic particle and einbein",
              "url": "https://www.damtp.cam.ac.uk/user/tong/string/string1.pdf"
            },
