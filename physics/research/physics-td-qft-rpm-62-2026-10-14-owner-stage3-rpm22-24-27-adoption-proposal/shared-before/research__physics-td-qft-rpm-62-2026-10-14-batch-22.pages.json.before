      {
        "id": "thm-rpm-proper-time-parametrization",
        "kind": "theorem",
        "domain": "mathematics",
        "title": "Proper-time parameter and normalized tangent",
        "statement": "Let $x:I\\to M$ be a $C^2$ future timelike curve on a nonempty open interval $I$, with parameter $s$ and tangent $T=dx/ds$. Fix $c>0$, $s_0\\in I$, and $\\tau_0\\in\\mathbb R$, and define $\\ell(s)=\\sqrt{-g(T,T)}$ and $\\tau(s)=\\tau_0+c^{-1}\\int_{s_0}^s\\ell(r)\\,dr$. Then $\\tau'(s)=\\ell(s)/c>0$, so $\\tau$ is an increasing $C^2$ coordinate on its open image $J=\\tau(I)$. The tangent with respect to this parameter is $U=dx/d\\tau=cT/\\ell$ and satisfies $g(U,U)=-c^2$. This is a mathematical reparametrization result; by itself it does not identify $\\tau$ with a physical clock reading.",
        "deps": [
          "def-rpm-spacetime-observer-and-worldline",
          "def-gr-timelike-worldline-and-proper-time",
          "thm-ftc-first-part",
          "thm-chain-rule-for-total-derivatives",
          "thm-euclidean-inverse-function-theorem",
          "cor-mean-value-theorem"
        ],
