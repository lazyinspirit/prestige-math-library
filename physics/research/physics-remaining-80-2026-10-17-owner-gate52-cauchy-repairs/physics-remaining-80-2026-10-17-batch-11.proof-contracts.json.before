    "ex-emg-zero-scalar-controlled-reduction": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-emg-trivial-potential-charged-scalar-system",
          "source_section": "Definition",
          "quote": "The associated **classical charged-scalar Einstein\u2013Maxwell system** is",
          "uses": [
            "1.1",
            "2.1"
          ]
        },
        {
          "fact": "F2",
          "source": "def-emg-trivial-potential-charged-scalar-system",
          "source_section": "Definition",
          "quote": "The associated **classical charged-scalar Einstein\u2013Maxwell system** is",
          "uses": [
            "1.1",
            "2.1"
          ]
        },
        {
          "fact": "L1",
          "source": "thm-emg-local-classical-charged-scalar-development",
          "source_section": "Statement",
          "quote": "Assume the Axiom of Countable Choice $\\mathrm{AC}_\\omega$ and Dependent Choice $\\mathrm{DC}$ ([[def-countable-choice]], [[def-dependent-choice]]). Fix an integer $s\\ge5$, constants $c>0$, $G_N>0$, $\\mu_0>0$, $K_\\varphi>0$, $\\lambda,\\Lambda\\in\\mathbb R$, and a real $V\\in C^\\infty(\\mathcal U)$ on an open $\\mathcal U\\subseteq\\mathbb R$ containing the attained values of $|\\varphi|^2$. Use the system and units of [[def-emg-trivial-potential-charged-scalar-system]].",
          "uses": [
            "3.1"
          ]
        },
        {
          "fact": "A1",
          "source": "thm-emg-local-classical-charged-scalar-development",
          "source_section": "Statement",
          "quote": "Assume the Axiom of Countable Choice $\\mathrm{AC}_\\omega$ and Dependent Choice $\\mathrm{DC}$ ([[def-countable-choice]], [[def-dependent-choice]]). Fix an integer $s\\ge5$, constants $c>0$, $G_N>0$, $\\mu_0>0$, $K_\\varphi>0$, $\\lambda,\\Lambda\\in\\mathbb R$, and a real $V\\in C^\\infty(\\mathcal U)$ on an open $\\mathcal U\\subseteq\\mathbb R$ containing the attained values of $|\\varphi|^2$. Use the system and units of [[def-emg-trivial-potential-charged-scalar-system]].",
          "uses": [
            "1.1",
            "3.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "step-1-1",
          "step": "1.1",
          "claim": "Since $\\varphi=0$ and $\\pi=0$, the scalar equation is $0-V'(0)\\,0=0$ and $j^a=0$. Also $L_\\varphi=V(0)=0$, so $T^\\varphi_{ab}=0$. The condition $V(0)=0$ is what removes the remaining term $-\\tfrac12K_\\varphi g_{ab}V(0)$.",
          "inputs": [
            "F1",
            "F2",
            "A1",
            "algebra"
          ]
        },
        {
          "id": "step-2-1",
          "step": "2.1",
          "claim": "Substituting $j=0$ and $T^\\varphi=0$ into the system of [F1] leaves exactly $G_{ab}+\\Lambda g_{ab}=\\kappa T^{\\mathrm{EM}}_{ab}$, $dF=0$, and $\\nabla_aF^{ab}=0$. Conversely, an exact-potential source-free solution with $\\varphi=\\pi=0$ satisfies each charged-scalar equation by step 1.1 and each remaining equation by its source-free hypothesis.",
          "inputs": [
            "F1",
            "F2",
            "step 1.1",
            "algebra"
          ]
        },
        {
          "id": "step-3-1",
          "step": "3.1",
          "claim": "For exact-potential electrovacuum initial data, setting $\\varphi_0=0$, $\\pi_n=0$, and hence $\\pi_i=0$ makes $j=0$ and $T^\\varphi=0$ on the initial slice. The sourced Maxwell and total-stress Einstein constraints in [L1] then reduce to the source-free electrovacuum constraints. Applying [L1] under [A2] gives a smooth local solution. On that solution the scalar block for $(\\varphi,\\pi)$ is a homogeneous first-order wave/transport system with the metric, $A$ and $F$ as given smooth coefficients: the potential term is the smooth coefficient $V\\prime(|\\varphi|^2)$ times $\\varphi$, and every other scalar source is linear in $\\varphi,\\pi$. The symmetric scalar-block energy with zero initial scalar data therefore satisfies $E\\prime\\le CE$ and is zero by the same local uniqueness argument in [L1]. Thus $\\varphi=\\pi=0$ persists. Step 2.1 then identifies the resulting equations with the zero-scalar branch. No global existence claim follows.",
          "inputs": [
            "A1",
            "A2",
            "L1",
            "step 1.1",
            "step 2.1"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "No empty-domain, empty-state, or empty-boundary claim is made.",
          "evidence": "Statement: solution/substitution is local and vacuous on an empty region."
        },
        {
          "case": "zero",
          "status": "checked",
          "evidence": "Proof1.1 checks phi=pi=0 and V(0)=0; proof3.1 explicitly propagates zero scalar data by homogeneous scalar energy."
        },
        {
          "case": "one",
