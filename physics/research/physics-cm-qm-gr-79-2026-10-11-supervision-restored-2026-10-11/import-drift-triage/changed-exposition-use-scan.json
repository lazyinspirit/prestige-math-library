{
  "scope": "Current owned manifest item body paragraphs only; keyword search is candidate finding, not proof review",
  "patterns": [
    {
      "id": "DC-equivalence",
      "regex": "start[- ]free|prescribed[- ]start|finite.{0,12}R[- ]paths|starting point may be dropped"
    },
    {
      "id": "Cantor-alternative",
      "regex": "Cantor pairing|triangular numbers|division.with.remainder|natural half"
    },
    {
      "id": "comparability-orientation",
      "regex": "comparability.{0,80}(choice|axiom)|Hartogs|cardinal-comparability-iff-ac"
    },
    {
      "id": "independence-orientation",
      "regex": "Feferman|nonprovability|consistency of ZF|Con\\(.{0,10}ZF|unrestricted countable.union"
    },
    {
      "id": "real-exponent-orientation",
      "regex": "rem-real-exponents-deferred|supremum.{0,80}(power law|exponent)|continuity.{0,40}logically necessary|sequence limits.{0,40}necessary"
    }
  ],
  "matches": []
}
