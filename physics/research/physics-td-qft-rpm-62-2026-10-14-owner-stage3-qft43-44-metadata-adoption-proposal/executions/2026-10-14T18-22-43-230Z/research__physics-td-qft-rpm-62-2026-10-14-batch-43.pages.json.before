    "items": [
      {
        "id": "ex-qftmath-timeordered-jump",
        "kind": "example",
        "domain": "mathematics",
        "library": "mathematics",
        "physical_scope": null,
        "title": "Timeordered derivative jump gives iδ Green source",
        "reference": "research/plan-quantum-field-theory-track.md#tempered-time-ordered-scalar-two-point-carrier",
        "design_state": "Planned mode derivative-jump verification; complete half-line distributional proof authored.",
        "dependency_level": 6,
        "deps": [
          "lem-qft-free-time-ordered-kernel"
        ],
        "dependency_roles": {
          "lem-qft-free-time-ordered-kernel": "mathematical-premise"
        },
        "inventory_expansion_required": false,
        "proof_strategy": "direct",
        "statement": "Let $\\mu\\ge0$, $\\omega_\\mu(\\mathbf k)=\\sqrt{|\\mathbf k|^2+\\mu^2}$, and for a fixed $\\mathbf k$ with $\\omega_\\mu(\\mathbf k)>0$ set\n$$g_{\\omega_\\mu}(t)=\\frac{e^{-i\\omega_\\mu(\\mathbf k)|t|}}{2\\omega_\\mu(\\mathbf k)}.$$\nThis is the time-mode factor of the tempered scalar carrier in [[lem-qft-free-time-ordered-kernel]]. Its first derivative has jump $-i$ at $t=0$, giving the Green source $i\\delta_0$ after applying the $(-,+,+,+)$ Klein–Gordon operator and Fourier-inverting the spatial momentum.",
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "David Tong, Quantum Field Theory, author-hosted complete lecture notes, Chapter 2, §2.7.1",
              "url": "https://www.damtp.cam.ac.uk/user/tong/qft/qfthtml/S2.html",
              "locator": "Complete HTML Chapter 2, time-ordered two-point function and Klein–Gordon Green function, equations 2.168–2.174."
            },
            {
              "title": "Mark Srednicki, Quantum Field Theory, author-hosted 2006 prepublication book draft, §8",
              "url": "https://www.physics.ucsb.edu/~mark/ms-qft-DRAFT.pdf",
              "locator": "Complete 616-page draft, §8, equations 8.11–8.15, with the source's separate prefactor-i convention."
            }
          ]
        }
      }
    ]
  }
