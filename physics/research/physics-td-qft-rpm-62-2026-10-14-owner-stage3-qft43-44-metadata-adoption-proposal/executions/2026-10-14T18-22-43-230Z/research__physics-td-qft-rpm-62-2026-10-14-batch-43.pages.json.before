        "physical_scope": null,
        "title": "Tempered time-ordered scalar two-point carrier",
        "reference": "research/plan-quantum-field-theory-track.md#tempered-time-ordered-scalar-two-point-carrier",
        "design_state": "Planned tempered scalar time-ordered carrier with fixed local Fourier and metric conventions; conditional distributional construction and Green-source proof authored.",
        "dependency_level": 5,
        "deps": [
