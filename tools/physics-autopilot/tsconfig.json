{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "verbatimModuleSyntax": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false
  },
  "include": [
    "src/**/*.mts",
    "bin/**/*.mts",
    "stages/**/*.mts",
    "test/**/*.mts"
  ],
  "//": "strictNullChecks and strictPropertyInitialization are OFF pending an incremental pass \u2014 129 diagnostics remain behind them. The checks that caught the audit findings (property existence on a declared type) are ON and enforced by `npm run typecheck`."
}