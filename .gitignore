# Raw subagent dispatch transcripts.
#
# These are write-only evidence: tools/dispatch.mjs creates them and no tool
# ever reads one back. They were 742 MB across 2115 files and grew by 400-700
# files per audit wave. They are NOT deleted -- they remain on disk gzipped
# (5.3x) and every historical byte stays in git history, recoverable with
#   git show <commit>:research/audit/wave<k>-dispatch/<role>-<label>.log
# The concise per-build/per-wave record lives in research/BUILD-AUDIT-INDEX.md.
research/**/*-dispatch/*.log
research/**/*-dispatch/*.log.gz

# Touch snapshots for concluded waves/levels. Same treatment: gzipped on disk,
# full contents retained in git history. Snapshots for halted (resumable) waves
# stay tracked and uncompressed so tools/touchlog.mjs can still read them.
research/*-touches.json.gz
research/audit/*-touches.json.gz
