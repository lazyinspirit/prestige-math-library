**/auth.json
**/credentials.json
# Generated worker runtime; keep canonical reports and receipts.
research/**/*.log
research/**/*.log.gz
research/**/*.prompt.md
research/**/rollout-*.jsonl
research/**/*.workspace/work/
research/**/scope-reviewer-session/
research/**/scope-repairer-session/

# Raw subagent dispatch transcripts.
#
# Keep transcripts out of Git. Before cleaning concluded runs, preserve
# numeric telemetry and a source inventory. Concluded transient files may be
# deleted after verification; ignored files may never have been committed.
# See research/run-telemetry/README.md for retained measurements and gaps.

# Touch snapshots for concluded waves/levels. Same treatment: gzipped on disk,
# full contents retained in git history. Snapshots for halted (resumable) waves
# stay tracked and uncompressed so tools/touchlog.mjs can still read them.
research/*touches*.json.gz
research/audit/*touches*.json.gz

# Local Claude Code settings (machine-specific, not part of the repo contract)
.claude/settings.local.json

# autopilot engine runtime state — logs, events and stage state.
# Belongs to the run, not to the library's history.
.autopilot/

# session working area — never repo content; a probe left in a tracked namespace
# is how a test fixture became a live engine input once
scratchpad/

# agent worktrees — created per agent run, never part of the repo
.claude/worktrees/
.autopilot-*/
