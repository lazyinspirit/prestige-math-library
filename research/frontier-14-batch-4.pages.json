[
  {
    "order": 90,
    "id": "triangularisation-and-jordan-canonical-form",
    "kind": "A",
    "category": "linear-algebra",
    "title": "Triangularisation, Generalised Eigenspaces and Jordan Canonical Form",
    "companion": "triangularisation-and-jordan-canonical-form-examples",
    "requires": [
      "diagonalisation-and-the-minimal-polynomial"
    ],
    "items": [
      {
        "id": "def-quotient-vector-space-and-canonical-projection",
        "kind": "definition",
        "title": "The quotient vector space V/W and its canonical projection",
        "deps": ["def-vector-space", "def-linear-subspace"]
      },
      {
        "id": "prop-quotient-vector-space-operations-and-projection",
        "kind": "proposition",
        "title": "Quotient operations are well defined, and the canonical projection is linear with kernel W",
        "strategy": "direct",
        "deps": ["def-quotient-vector-space-and-canonical-projection", "def-linear-map"]
      },
      {
        "id": "lem-quotient-basis-lifts-to-an-adapted-basis",
        "kind": "lemma",
        "title": "A basis of W together with representatives of a basis of V/W is a basis of V; hence dim(V/W) = dim V - dim W",
        "strategy": "direct",
        "deps": ["prop-quotient-vector-space-operations-and-projection", "def-linear-basis", "def-dimension"]
      },
      {
        "id": "thm-quotient-vector-space-universal-property",
        "kind": "theorem",
        "title": "Universal property of the quotient vector space",
        "strategy": "direct",
        "deps": ["prop-quotient-vector-space-operations-and-projection", "def-kernel-and-image-of-a-linear-map"]
      },
      {
        "id": "thm-first-isomorphism-theorem-for-vector-spaces",
        "kind": "theorem",
        "title": "First isomorphism theorem for vector spaces: V/ker T is isomorphic to im T",
        "strategy": "direct",
        "deps": ["thm-quotient-vector-space-universal-property", "thm-linear-kernel-image-and-injectivity"]
      },
      {
        "id": "def-invariant-subspace-and-induced-quotient-operator",
        "kind": "definition",
        "title": "Invariant subspaces, restrictions, and induced quotient operators",
        "deps": ["def-quotient-vector-space-and-canonical-projection", "def-linear-map"]
      },
      {
        "id": "prop-induced-quotient-operator-is-well-defined",
        "kind": "proposition",
        "title": "Invariance makes the induced quotient operator well defined and linear, with pi T = T bar pi",
        "strategy": "direct",
        "deps": ["def-invariant-subspace-and-induced-quotient-operator", "prop-quotient-vector-space-operations-and-projection"]
      },
      {
        "id": "prop-polynomial-calculus-on-restrictions-and-quotients",
        "kind": "proposition",
        "title": "Polynomial evaluation commutes with restriction and passage to an invariant quotient; the two minimal polynomials divide the original",
        "strategy": "direct",
        "deps": ["prop-induced-quotient-operator-is-well-defined", "def-polynomial-evaluation-at-an-endomorphism", "thm-minimal-polynomial-is-well-defined-and-controls-annihilators", "def-invariant-subspace-and-induced-quotient-operator"]
      },
      {
        "id": "prop-characteristic-polynomial-factors-over-an-invariant-subspace",
        "kind": "proposition",
        "title": "For an invariant subspace W, chi_T = chi_(T|W) chi_(T bar on V/W)",
        "strategy": "direct",
        "deps": ["def-invariant-subspace-and-induced-quotient-operator", "prop-induced-quotient-operator-is-well-defined", "lem-quotient-basis-lifts-to-an-adapted-basis", "lem-characteristic-polynomial-of-block-triangular-matrix", "def-characteristic-polynomial-of-an-operator"]
      },
      {
        "id": "def-triangularisable-endomorphism",
        "kind": "definition",
        "title": "Triangularisable endomorphisms and simultaneous triangularisability",
        "deps": ["def-coordinate-column-and-matrix-of-a-linear-map"]
      },
      {
        "id": "prop-complete-invariant-flags-and-upper-triangular-matrices",
        "kind": "proposition",
        "title": "An ordered basis is upper triangular for T exactly when its successive spans form a complete T-invariant flag",
        "strategy": "direct",
        "deps": ["def-triangularisable-endomorphism", "def-invariant-subspace-and-induced-quotient-operator", "def-coordinate-column-and-matrix-of-a-linear-map"]
      },
      {
        "id": "thm-triangularisation-splitting-criterion",
        "kind": "theorem",
        "title": "T is triangularisable iff its minimal polynomial splits iff its characteristic polynomial splits",
        "strategy": "induction",
        "deps": ["prop-complete-invariant-flags-and-upper-triangular-matrices", "prop-characteristic-polynomial-factors-over-an-invariant-subspace", "thm-minimal-and-characteristic-polynomials-have-the-same-irreducible-factors", "thm-spectrum-is-the-root-set-of-the-characteristic-polynomial"]
      },
      {
        "id": "cor-endomorphisms-over-an-algebraically-closed-field-are-triangularisable",
        "kind": "corollary",
        "title": "Every finite-dimensional endomorphism over an algebraically closed field is triangularisable",
        "strategy": "induction",
        "deps": ["thm-triangularisation-splitting-criterion", "def-algebraically-closed-field", "cor-factor-theorem-over-a-commutative-ring"]
      },
      {
        "id": "thm-simultaneous-triangularisation-of-commuting-operators",
        "kind": "theorem",
        "title": "A commuting family whose characteristic polynomials split is simultaneously triangularisable",
        "strategy": "induction",
        "deps": ["thm-triangularisation-splitting-criterion", "prop-characteristic-polynomial-factors-over-an-invariant-subspace", "prop-complete-invariant-flags-and-upper-triangular-matrices"]
      },
      {
        "id": "def-nilpotent-endomorphism",
        "kind": "definition",
        "title": "Nilpotent endomorphisms and their nilpotency index",
        "deps": ["def-linear-map"]
      },
      {
        "id": "thm-nilpotent-endomorphism-characterisations",
        "kind": "theorem",
        "title": "Nilpotence is equivalent to a power-of-x minimal polynomial, characteristic polynomial x^n, and a strictly upper-triangular form",
        "strategy": "direct",
        "deps": ["def-nilpotent-endomorphism", "thm-triangularisation-splitting-criterion", "thm-minimal-polynomial-is-well-defined-and-controls-annihilators", "thm-minimal-and-characteristic-polynomials-have-the-same-irreducible-factors", "lem-characteristic-polynomial-is-monic-and-has-extreme-coefficients", "thm-cayley-hamilton"]
      },
      {
        "id": "lem-kernel-and-rank-sequences-of-powers",
        "kind": "lemma",
        "title": "Kernels of successive powers increase, ranks decrease, and equality at one stage forces stabilisation",
        "strategy": "direct",
        "deps": ["def-kernel-and-image-of-a-linear-map", "def-rank-and-nullity", "thm-rank-nullity"]
      },
      {
        "id": "thm-stabilised-kernel-image-decomposition",
        "kind": "theorem",
        "title": "At a stabilised power, V is the direct sum of ker(T^m) and im(T^m)",
        "strategy": "direct",
        "deps": ["lem-kernel-and-rank-sequences-of-powers", "thm-rank-nullity", "def-internal-direct-sum"]
      },
      {
        "id": "def-jordan-block-and-jordan-string",
        "kind": "definition",
        "title": "Jordan blocks J_m(lambda), Jordan strings, and their initial and terminal vectors",
        "deps": ["def-coordinate-column-and-matrix-of-a-linear-map", "def-eigenvalue-eigenvector-eigenspace-and-spectrum"]
      },
      {
        "id": "lem-independent-initial-vectors-give-independent-jordan-strings",
        "kind": "lemma",
        "title": "Jordan strings with linearly independent initial vectors have linearly independent union",
        "strategy": "induction",
        "deps": ["def-jordan-block-and-jordan-string", "def-linear-independence"]
      },
      {
        "id": "thm-nilpotent-jordan-string-basis",
        "kind": "theorem",
        "title": "Every finite-dimensional nilpotent endomorphism has a basis of Jordan strings",
        "strategy": "induction",
        "deps": ["def-nilpotent-endomorphism", "lem-independent-initial-vectors-give-independent-jordan-strings", "thm-rank-nullity", "thm-every-independent-set-extends-to-a-basis"]
      },
      {
        "id": "thm-power-ranks-determine-nilpotent-jordan-blocks",
        "kind": "theorem",
        "title": "The ranks or nullities of the powers of a nilpotent endomorphism determine every Jordan block multiplicity",
        "strategy": "direct",
        "deps": ["thm-nilpotent-jordan-string-basis", "lem-kernel-and-rank-sequences-of-powers", "def-rank-and-nullity"]
      },
      {
        "id": "cor-nilpotent-similarity-classified-by-power-ranks",
        "kind": "corollary",
        "title": "Two nilpotent endomorphisms are similar iff the ranks of all their powers agree",
        "strategy": "direct",
        "deps": ["thm-power-ranks-determine-nilpotent-jordan-blocks", "thm-similarity-is-an-equivalence-relation-and-models-basis-change"]
      },
      {
        "id": "prop-generalised-eigenspaces-and-algebraic-multiplicity",
        "kind": "proposition",
        "title": "For an endomorphism with split characteristic polynomial, each stabilised generalised eigenspace carries scalar plus nilpotent and has dimension equal to the eigenvalue's algebraic multiplicity",
        "strategy": "direct",
        "deps": ["def-primary-component-and-generalised-eigenspace", "cor-generalised-eigenspace-decomposition-for-a-split-minimal-polynomial", "thm-minimal-and-characteristic-polynomials-have-the-same-irreducible-factors", "thm-nilpotent-endomorphism-characterisations", "prop-characteristic-polynomial-factors-over-an-invariant-subspace"]
      },
      {
        "id": "def-jordan-canonical-form",
        "kind": "definition",
        "title": "Jordan bases and Jordan canonical forms over the base field",
        "deps": ["def-jordan-block-and-jordan-string"]
      },
      {
        "id": "thm-jordan-form-exists-iff-the-characteristic-polynomial-splits",
        "kind": "theorem",
        "title": "An endomorphism has a Jordan canonical form over F iff its characteristic polynomial splits over F",
        "strategy": "direct",
        "deps": ["def-jordan-canonical-form", "prop-generalised-eigenspaces-and-algebraic-multiplicity", "thm-nilpotent-jordan-string-basis", "lem-characteristic-polynomial-of-block-triangular-matrix"]
      },
      {
        "id": "cor-endomorphisms-over-an-algebraically-closed-field-have-jordan-form",
        "kind": "corollary",
        "title": "Every finite-dimensional endomorphism over an algebraically closed field has Jordan canonical form",
        "strategy": "induction",
        "deps": ["thm-jordan-form-exists-iff-the-characteristic-polynomial-splits", "def-algebraically-closed-field", "cor-factor-theorem-over-a-commutative-ring"]
      },
      {
        "id": "thm-jordan-form-uniqueness-from-ranks-of-powers",
        "kind": "theorem",
        "title": "The ranks of (T-lambda I)^k determine the Jordan form uniquely up to block order",
        "strategy": "direct",
        "deps": ["def-jordan-canonical-form", "thm-power-ranks-determine-nilpotent-jordan-blocks", "prop-generalised-eigenspaces-and-algebraic-multiplicity", "def-rank-and-nullity", "def-internal-direct-sum"]
      },
      {
        "id": "cor-jordan-block-data-controls-eigenspaces-and-polynomials",
        "kind": "corollary",
        "title": "For an endomorphism with split characteristic polynomial, Jordan blocks read off algebraic and geometric multiplicities and the minimal polynomial",
        "strategy": "direct",
        "deps": ["thm-jordan-form-uniqueness-from-ranks-of-powers", "thm-minimal-polynomial-is-well-defined-and-controls-annihilators", "def-eigenvalue-eigenvector-eigenspace-and-spectrum"]
      },
      {
        "id": "thm-similarity-classification-by-jordan-canonical-form",
        "kind": "theorem",
        "title": "Two matrices with split characteristic polynomials are similar iff they have the same Jordan form up to block order",
        "strategy": "direct",
        "deps": ["thm-jordan-form-exists-iff-the-characteristic-polynomial-splits", "thm-jordan-form-uniqueness-from-ranks-of-powers", "thm-similarity-is-an-equivalence-relation-and-models-basis-change"]
      },
      {
        "id": "def-cyclic-subspace-vector-and-vector-annihilator",
        "kind": "definition",
        "title": "Cyclic subspaces, cyclic vectors, and the monic annihilator of a vector",
        "deps": ["def-polynomial-evaluation-at-an-endomorphism", "def-invariant-subspace-and-induced-quotient-operator"]
      },
      {
        "id": "prop-vector-annihilator-is-well-defined",
        "kind": "proposition",
        "title": "The annihilator of a vector is a nonzero principal ideal with a unique monic generator dividing mu_T",
        "strategy": "direct",
        "deps": ["def-cyclic-subspace-vector-and-vector-annihilator", "thm-minimal-polynomial-is-well-defined-and-controls-annihilators", "cor-polynomial-ring-over-a-field-is-a-pid"]
      },
      {
        "id": "thm-cyclic-subspace-power-basis-and-companion-matrix",
        "kind": "theorem",
        "title": "A vector annihilator of degree d gives a power basis of its cyclic subspace and the companion matrix of that annihilator",
        "strategy": "direct",
        "deps": ["prop-vector-annihilator-is-well-defined", "thm-polynomial-division-algorithm-over-a-field", "def-coordinate-column-and-matrix-of-a-linear-map", "def-cyclic-subspace-vector-and-vector-annihilator"]
      },
      {
        "id": "lem-a-vector-realises-the-minimal-polynomial",
        "kind": "lemma",
        "title": "Every finite-dimensional endomorphism has a vector whose annihilator is its minimal polynomial",
        "strategy": "direct",
        "deps": ["prop-vector-annihilator-is-well-defined", "thm-primary-decomposition-for-an-endomorphism", "thm-minimal-polynomial-is-well-defined-and-controls-annihilators", "def-cyclic-subspace-vector-and-vector-annihilator", "thm-polynomial-ring-over-a-field-is-a-ufd"]
      },
      {
        "id": "thm-cyclic-vector-criterion-by-minimal-and-characteristic-polynomials",
        "kind": "theorem",
        "title": "An endomorphism has a cyclic vector iff its minimal and characteristic polynomials are equal",
        "strategy": "direct",
        "deps": ["thm-cyclic-subspace-power-basis-and-companion-matrix", "lem-a-vector-realises-the-minimal-polynomial", "lem-characteristic-polynomial-is-monic-and-has-extreme-coefficients", "thm-minimal-polynomial-is-well-defined-and-controls-annihilators", "thm-cayley-hamilton"]
      },
      {
        "id": "cor-the-commutant-of-a-cyclic-endomorphism-is-polynomial",
        "kind": "corollary",
        "title": "Every endomorphism commuting with a cyclic endomorphism is a polynomial in it",
        "strategy": "direct",
        "deps": ["def-cyclic-subspace-vector-and-vector-annihilator", "thm-cyclic-subspace-power-basis-and-companion-matrix", "def-polynomial-evaluation-at-an-endomorphism"]
      }
    ]
  },
  {
    "order": 91,
    "id": "triangularisation-and-jordan-canonical-form-examples",
    "kind": "B",
    "category": "linear-algebra",
    "title": "Triangularisation and Jordan Form: Examples and Counterexamples",
    "companion": "triangularisation-and-jordan-canonical-form",
    "requires": [
      "triangularisation-and-jordan-canonical-form"
    ],
    "items": [
      {
        "id": "ex-quotient-of-f-three-by-a-line-and-canonical-projection",
        "kind": "example",
        "title": "The quotient of F^3 by a coordinate line and its canonical projection",
        "strategy": "computation",
        "deps": ["prop-quotient-vector-space-operations-and-projection", "lem-quotient-basis-lifts-to-an-adapted-basis"]
      },
      {
        "id": "ex-first-isomorphism-theorem-for-a-coordinate-map",
        "kind": "example",
        "title": "The first isomorphism theorem for (x,y,z) mapped to (x+y,y+z)",
        "strategy": "computation",
        "deps": ["thm-first-isomorphism-theorem-for-vector-spaces"]
      },
      {
        "id": "ex-a-split-triangularisable-but-nondiagonalisable-operator",
        "kind": "example",
        "title": "A 3 by 3 split operator that is triangularisable but not diagonalisable",
        "strategy": "computation",
        "deps": ["thm-triangularisation-splitting-criterion", "thm-diagonalisable-iff-minimal-polynomial-splits-with-distinct-roots"]
      },
      {
        "id": "ex-an-invariant-flag-producing-upper-triangular-form",
        "kind": "example",
        "title": "Building an upper-triangular matrix from a complete invariant flag",
        "strategy": "computation",
        "deps": ["prop-complete-invariant-flags-and-upper-triangular-matrices"]
      },
      {
        "id": "ex-building-a-jordan-string-basis-for-a-nilpotent-operator",
        "kind": "example",
        "title": "Building a Jordan-string basis for a nilpotent operator on F^6",
        "strategy": "computation",
        "deps": ["thm-nilpotent-jordan-string-basis", "def-jordan-block-and-jordan-string"]
      },
      {
        "id": "ex-recovering-nilpotent-blocks-from-ranks-of-powers",
        "kind": "example",
        "title": "Recovering the blocks J_3(0), J_2(0), J_1(0) from ranks of powers",
        "strategy": "computation",
        "deps": ["thm-power-ranks-determine-nilpotent-jordan-blocks"]
      },
      {
        "id": "ex-jordan-form-with-two-eigenvalues-from-power-ranks",
        "kind": "example",
        "title": "A 5 by 5 Jordan form recovered from the ranks of powers at two eigenvalues",
        "strategy": "computation",
        "deps": ["cor-jordan-block-data-controls-eigenspaces-and-polynomials", "thm-jordan-form-uniqueness-from-ranks-of-powers"]
      },
      {
        "id": "ex-quarter-turn-jordan-form-after-scalar-extension",
        "kind": "example",
        "title": "The real quarter-turn acquires diagonal Jordan form after extending scalars to C",
        "strategy": "computation",
        "deps": ["thm-jordan-form-exists-iff-the-characteristic-polynomial-splits"]
      },
      {
        "id": "fs-every-endomorphism-is-triangularisable",
        "kind": "false-statement",
        "title": "False: every finite-dimensional endomorphism is triangularisable over its base field",
        "strategy": "counterexample",
        "deps": ["thm-triangularisation-splitting-criterion"]
      },
      {
        "id": "fs-every-endomorphism-has-jordan-form-over-its-base-field",
        "kind": "false-statement",
        "title": "False: every finite-dimensional endomorphism has Jordan form over its base field",
        "strategy": "counterexample",
        "deps": ["thm-jordan-form-exists-iff-the-characteristic-polynomial-splits"]
      },
      {
        "id": "fs-equal-characteristic-and-minimal-polynomials-imply-similarity",
        "kind": "false-statement",
        "title": "False: equal characteristic and minimal polynomials imply similarity",
        "strategy": "counterexample",
        "deps": ["thm-similarity-classification-by-jordan-canonical-form", "cor-jordan-block-data-controls-eigenspaces-and-polynomials"]
      },
      {
        "id": "fs-jordan-canonical-form-is-a-unique-matrix",
        "kind": "false-statement",
        "title": "False: Jordan canonical form is a unique matrix without fixing the block order",
        "strategy": "counterexample",
        "deps": ["thm-jordan-form-uniqueness-from-ranks-of-powers"]
      },
      {
        "id": "fs-geometric-multiplicity-determines-jordan-block-sizes",
        "kind": "false-statement",
        "title": "False: geometric multiplicity alone determines the Jordan block sizes",
        "strategy": "counterexample",
        "deps": ["thm-jordan-form-uniqueness-from-ranks-of-powers", "cor-jordan-block-data-controls-eigenspaces-and-polynomials"]
      },
      {
        "id": "ex-jordan-chevalley-decomposition-from-jordan-blocks",
        "kind": "example",
        "title": "Computing the diagonal and nilpotent parts of a split Jordan matrix",
        "strategy": "computation",
        "deps": ["cor-primary-projections-are-polynomials-in-the-endomorphism", "prop-generalised-eigenspaces-and-algebraic-multiplicity"]
      },
      {
        "id": "fs-every-endomorphism-has-a-commuting-diagonal-plus-nilpotent-decomposition",
        "kind": "false-statement",
        "title": "False: every endomorphism has a commuting diagonal-plus-nilpotent decomposition over its base field",
        "strategy": "counterexample",
        "deps": ["thm-simultaneous-triangularisation-of-commuting-operators", "def-diagonalisable-endomorphism", "def-nilpotent-endomorphism"]
      },
      {
        "id": "ex-a-cyclic-companion-operator",
        "kind": "example",
        "title": "A companion operator with a visible cyclic vector and equal minimal and characteristic polynomials",
        "strategy": "computation",
        "deps": ["thm-cyclic-subspace-power-basis-and-companion-matrix", "thm-cyclic-vector-criterion-by-minimal-and-characteristic-polynomials"]
      },
      {
        "id": "cex-the-identity-on-f-two-has-no-cyclic-vector",
        "kind": "counterexample",
        "title": "The identity on F^2 has no cyclic vector",
        "strategy": "counterexample",
        "deps": ["thm-cyclic-vector-criterion-by-minimal-and-characteristic-polynomials"]
      }
    ]
  }
]
