  "refuter_findings": [
    {
      "obligation": "refuter:12:1",
      "id": "def-simplicial-subcomplex-star-closure-and-link",
      "location": "Definition",
      "defect": "false-claim",
      "evidence": "The definition calls the open star “the union of the relative interiors of simplices in \\(\\operatorname{St}_K(\\sigma)\\),” while defining \\(\\operatorname{St}_K(\\sigma)=\\{\\tau:\\sigma\\cup\\tau\\in K\\}\\). For the path with edges \\(\\{v,w\\},\\{w,z\\}\\) and \\(\\sigma=\\{v\\}\\), this set of simplices is \\(\\{\\varnothing,\\{v\\},\\{w\\},\\{v,w\\}\\}\\), so the stated union is the closed edge \\(|\\{v,w\\}|\\). It is not open in the realization of the path, since every neighborhood of \\(w\\) meets the interior of \\(|\\{w,z\\}|\\). The standard open star instead takes interiors of cofaces containing \\(\\sigma\\).",
      "severity": "fatal",
      "observed_sha256": "94acb2fc881c471ea4a9bd846fe9c44fdd7fb564b0e7ce30edd031a9942be988"
    },
    {
      "obligation": "refuter:12:2",
      "id": "prop-simplicial-homology-of-a-disjoint-union-is-the-direct-sum",
      "location": "1.1",
      "defect": "unlicensed-inference",
      "evidence": "Step 1.1 says “Every simplex of \\(K\\) lies in exactly one summand \\(K_\\alpha\\).” But the scoped abstract-complex definition requires \\(\\varnothing\\in K_\\alpha\\) for every summand, so the empty simplex is shared whenever there is more than one summand. The chain-group decomposition only needs the corrected statement for nonempty simplices, since \\(C_n\\) is generated by them for \\(n\\ge0\\).",
      "severity": "nonfatal",
      "observed_sha256": "f4aeb2af0cae864230a7ec736c2f5ef3ce228627270d38153c2c405f6207bce4"
    }
  ],
