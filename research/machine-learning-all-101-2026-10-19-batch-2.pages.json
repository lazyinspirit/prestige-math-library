      {
        "id": "lem-standard-borel-label-kernel-over-arbitrary-instance-space",
        "kind": "lemma",
        "title": "A standard-Borel label has a conditional kernel over an arbitrary measurable instance space",
        "deps": [
          "def-axiom-of-choice",
          "def-standard-borel-space",
          "def-probability-measure",
          "def-regular-conditional-distribution",
          "def-measure-kernel-and-probability-kernel",
          "def-product-sigma-algebra-and-finite-product-sigma-algebras",
          "def-measurable-function-between-measurable-spaces",
          "thm-existence-of-regular-conditional-distributions-for-standard-borel-targets",
          "lem-q-and-irrationals-dense-r",
          "thm-change-of-variables-for-expectation",
          "prop-closure-properties-of-measurable-functions-used-by-the-integral"
        ],
        "dependency_level": 0,
        "statement": "Assume the Axiom of Choice. Let $(\\mathsf X,\\Sigma_X)$ be a nonempty measurable space, let $(\\mathsf Y,\\Sigma_Y)$ be a nonempty standard Borel space, and let $P$ be a probability measure on $(\\mathsf X\\times\\mathsf Y,\\Sigma_X\\otimes\\Sigma_Y)$. Put $P_X(C)=P(C\\times\\mathsf Y)$. There exists an everywhere probability kernel $K:(\\mathsf X,\\Sigma_X)\\to(\\mathsf Y,\\Sigma_Y)$ such that\n\n$$P(C\\times A)=\\int_C K(x,A)\\,P_X(dx)\\qquad(C\\in\\Sigma_X,\\ A\\in\\Sigma_Y).$$\n\nNo standard-Borel, countable-generation, or completeness hypothesis is imposed on the instance space.",
        "justified_by": []
      },
