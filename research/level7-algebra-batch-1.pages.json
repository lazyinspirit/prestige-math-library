      {
        "id": "ex-klein-four-group",
        "kind": "example",
        "title": "The Klein four-group as the subgroup $\\{\\mathrm{id}, (12)(34), (13)(24), (14)(23)\\}$ of $\\operatorname{Sym}(\\{1,2,3,4\\})$: abelian of order $4$, non-cyclic, every non-identity element of order $2$",
        "strategy": "direct",
