      },
      {
        "id": "cex-power-of-a-product-in-a-nonabelian-group",
        "kind": "counterexample",
        "title": "$(gh)^{n} = g^{n}h^{n}$ fails without commutativity: two transpositions in $\\operatorname{Sym}(\\{1,2,3\\})$ with $(gh)^{2} \\ne g^{2}h^{2}$",
        "strategy": "direct",
        "deps": [
