        "id": "ex-symmetries-of-a-square",
        "kind": "example",
        "title": "The eight vertex permutations of a square form a non-abelian subgroup of $\\operatorname{Sym}(\\{1,2,3,4\\})$ of order $8$, generated by a $4$-cycle and one diagonal swap",
        "strategy": "direct",
        "deps": [
          "def-symmetric-group",
