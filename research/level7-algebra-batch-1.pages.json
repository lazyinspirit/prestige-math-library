        "kind": "example",
        "title": "$n\\mathbb{Z}$ is a subgroup of $(\\mathbb{Z}, +)$ for every $n \\in \\mathbb{Z}$, and every subgroup of $(\\mathbb{Z}, +)$ has this form",
        "strategy": "direct",
