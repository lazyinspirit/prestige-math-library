          "def-integers",
          "def-int-operations",
          "def-int-order",
          "thm-int-comm-ring",
          "def-countable",
          "def-equinumerous"
        ]
      },
      {
        "id": "ex-symmetric-group-on-three-letters",
        "kind": "example",
        "title": "$\\operatorname{Sym}(\\{1,2,3\\})$ has exactly six elements, is non-abelian, and its elements have orders $1$, $2$ and $3$",
        "strategy": "direct",
        "deps": [
