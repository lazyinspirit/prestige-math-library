[
  {
    "order": 20,
    "id": "monoids-groups-and-subgroups",
    "kind": "A",
    "category": "abstract-algebra",
    "title": "Binary Operations, Monoids, Groups and Subgroups",
    "companion": "monoids-groups-and-subgroups-examples",
    "requires": [
      "countability-and-uncountability",
      "construction-of-r-via-cauchy-sequences"
    ],
    "items": [
      {
        "id": "def-equivalence-relation",
        "kind": "definition",
        "title": "Equivalence relation, equivalence class, and the quotient set $A/{\\sim}$",
        "deps": []
      },
      {
        "id": "lem-equivalence-classes-partition",
        "kind": "lemma",
        "title": "The equivalence classes of an equivalence relation are nonempty, cover $A$, and are pairwise equal or disjoint; conversely every such cover arises from exactly one equivalence relation",
        "strategy": "direct",
        "deps": [
          "def-equivalence-relation"
        ]
      },
      {
        "id": "def-binary-operation",
        "kind": "definition",
        "title": "Binary operation on a set; associativity, commutativity, and a subset closed under the operation",
        "deps": []
      },
      {
        "id": "def-identity-element",
        "kind": "definition",
        "title": "Left identity, right identity, and two-sided identity for a binary operation",
        "deps": [
          "def-binary-operation"
        ]
      },
      {
        "id": "lem-identity-unique",
        "kind": "lemma",
        "title": "A left identity and a right identity for the same binary operation are equal; hence there is at most one two-sided identity",
        "strategy": "direct",
        "deps": [
          "def-binary-operation",
          "def-identity-element"
        ]
      },
      {
        "id": "def-semigroup-and-monoid",
        "kind": "definition",
        "title": "Semigroup and monoid",
        "deps": [
          "def-binary-operation",
          "def-identity-element",
          "lem-identity-unique"
        ]
      },
      {
        "id": "def-invertible-element",
        "kind": "definition",
        "title": "Left inverse, right inverse, and invertible element of a monoid",
        "deps": [
          "def-semigroup-and-monoid",
          "def-identity-element",
          "def-binary-operation"
        ]
      },
      {
        "id": "lem-inverse-unique",
        "kind": "lemma",
        "title": "In a monoid, a left inverse and a right inverse of the same element are equal; hence an invertible element has exactly one inverse, and it is two-sided",
        "strategy": "direct",
        "deps": [
          "def-semigroup-and-monoid",
          "def-invertible-element",
          "def-identity-element",
          "def-binary-operation"
        ]
      },
      {
        "id": "def-group",
        "kind": "definition",
        "title": "Group and abelian group",
        "deps": [
          "def-semigroup-and-monoid",
          "def-invertible-element",
          "lem-inverse-unique",
          "def-identity-element",
          "def-binary-operation"
        ]
      },
      {
        "id": "lem-group-inverse-laws",
        "kind": "lemma",
        "title": "In a group $e^{-1} = e$, $(g^{-1})^{-1} = g$ and $(gh)^{-1} = h^{-1}g^{-1}$, the order of the last product being essential",
        "strategy": "direct",
        "deps": [
          "def-group",
          "def-invertible-element",
          "lem-inverse-unique",
          "def-identity-element"
        ]
      },
      {
        "id": "lem-group-cancellation",
        "kind": "lemma",
        "title": "Cancellation in a group: $gx = gy$ or $xg = yg$ forces $x = y$; equivalently left and right translation by $g$ are bijections of $G$, so $gx = h$ and $xg = h$ each have exactly one solution",
        "strategy": "direct",
        "deps": [
          "def-group",
          "lem-group-inverse-laws",
          "def-injection-surjection-bijection",
          "def-identity-element"
        ]
      },
      {
        "id": "lem-monoid-units-form-a-group",
        "kind": "lemma",
        "title": "The invertible elements of a monoid form a group under the restricted operation",
        "strategy": "direct",
        "deps": [
          "def-semigroup-and-monoid",
          "def-invertible-element",
          "lem-inverse-unique",
          "def-group",
          "def-binary-operation"
        ]
      },
      {
        "id": "def-symmetric-group",
        "kind": "definition",
        "title": "The symmetric group $\\operatorname{Sym}(X)$: the bijections of a set $X$ under composition",
        "deps": [
          "def-injection-surjection-bijection",
          "def-binary-operation",
          "def-identity-element"
        ]
      },
      {
        "id": "lem-symmetric-group-is-a-group",
        "kind": "lemma",
        "title": "$\\operatorname{Sym}(X)$ is a group under composition, and it is non-abelian whenever $X$ has at least three distinct elements",
        "strategy": "direct",
        "deps": [
          "def-symmetric-group",
          "def-group",
          "def-injection-surjection-bijection",
          "def-semigroup-and-monoid",
          "def-invertible-element"
        ]
      },
      {
        "id": "def-monoid-finite-product",
        "kind": "definition",
        "title": "The product $g_0 g_1 \\cdots g_{n-1}$ of a finite list in a monoid, by recursion, with the empty product ($n = 0$) equal to the identity",
        "deps": [
          "def-semigroup-and-monoid",
          "thm-recursion",
          "def-natural-numbers",
          "def-nat-addition",
          "def-binary-operation"
        ]
      },
      {
        "id": "thm-generalised-associativity",
        "kind": "theorem",
        "title": "Generalised associativity: in a monoid the product of a finite list does not depend on the bracketing, and in a commutative monoid it does not depend on the order of the factors either",
        "strategy": "induction",
        "deps": [
          "def-monoid-finite-product",
          "def-semigroup-and-monoid",
          "thm-induction-principle",
          "def-symmetric-group",
          "def-natural-numbers",
          "def-nat-order",
          "def-nat-addition"
        ]
      },
      {
        "id": "def-group-power",
        "kind": "definition",
        "title": "Powers $g^{n}$: natural exponents in a monoid and integer exponents in a group, with $g^{0} = e$",
        "deps": [
          "def-semigroup-and-monoid",
          "def-group",
          "def-invertible-element",
          "lem-inverse-unique",
          "thm-recursion",
          "def-natural-numbers",
          "def-integers",
          "def-int-operations",
          "def-int-order",
          "lem-nat-embeds-int",
          "lem-nat-trichotomy"
        ]
      },
      {
        "id": "lem-group-power-laws",
        "kind": "lemma",
        "title": "Exponent laws in a group: $g^{m+n} = g^{m}g^{n}$ and $(g^{m})^{n} = g^{mn}$ for all $m, n \\in \\mathbb{Z}$, and $(gh)^{n} = g^{n}h^{n}$ **when $g$ and $h$ commute**",
        "strategy": "induction",
        "deps": [
          "def-group-power",
          "def-group",
          "lem-group-inverse-laws",
          "thm-induction-principle",
          "thm-int-comm-ring",
          "thm-int-ordered-ring",
          "def-int-operations",
          "def-int-order",
          "lem-nat-embeds-int",
          "lem-nat-trichotomy"
        ]
      },
      {
        "id": "def-subgroup",
        "kind": "definition",
        "title": "Subgroup",
        "deps": [
          "def-group",
          "def-binary-operation",
          "def-identity-element",
          "def-invertible-element"
        ]
      },
      {
        "id": "lem-subgroup-criterion",
        "kind": "lemma",
        "title": "One-step subgroup test: a nonempty $H \\subseteq G$ is a subgroup iff $gh^{-1} \\in H$ for all $g, h \\in H$; the identity and the inverses of $H$ are then those of $G$",
        "strategy": "direct",
        "deps": [
          "def-subgroup",
          "def-group",
          "lem-group-inverse-laws",
          "lem-group-cancellation",
          "lem-identity-unique",
          "lem-inverse-unique"
        ]
      },
      {
        "id": "lem-intersection-of-subgroups",
        "kind": "lemma",
        "title": "The intersection of a nonempty family of subgroups of $G$ is a subgroup of $G$",
        "strategy": "direct",
        "deps": [
          "def-subgroup",
          "lem-subgroup-criterion",
          "def-group"
        ]
      },
      {
        "id": "def-generated-subgroup",
        "kind": "definition",
        "title": "The subgroup $\\langle S \\rangle$ generated by a subset, the cyclic subgroup $\\langle g \\rangle$, and cyclic groups",
        "deps": [
          "def-subgroup",
          "lem-intersection-of-subgroups",
          "def-group"
        ]
      },
      {
        "id": "lem-cyclic-subgroup-is-the-set-of-powers",
        "kind": "lemma",
        "title": "$\\langle g \\rangle = \\{\\, g^{n} : n \\in \\mathbb{Z} \\,\\}$, and every cyclic group is abelian",
        "strategy": "direct",
        "deps": [
          "def-generated-subgroup",
          "def-group-power",
          "lem-group-power-laws",
          "lem-subgroup-criterion",
          "def-subgroup",
          "def-integers"
        ]
      },
      {
        "id": "thm-division-algorithm-in-z",
        "kind": "theorem",
        "title": "Division with remainder in $\\mathbb{Z}$: for $a \\in \\mathbb{Z}$ and $b > 0$ there are unique $q, r \\in \\mathbb{Z}$ with $a = qb + r$ and $0 \\le r < b$",
        "strategy": "direct",
        "deps": [
          "def-integers",
          "def-int-operations",
          "def-int-order",
          "thm-int-comm-ring",
          "thm-int-ordered-ring",
          "lem-int-cancellation",
          "lem-nat-embeds-int",
          "thm-well-ordering-principle",
          "def-natural-numbers",
          "def-nat-order"
        ]
      },
      {
        "id": "lem-order-of-element-exists",
        "kind": "lemma",
        "title": "In a finite group, every element $g$ satisfies $g^{n} = e$ for some natural $n \\ge 1$",
        "strategy": "direct",
        "deps": [
          "def-group",
          "def-group-power",
          "lem-group-power-laws",
          "lem-group-cancellation",
          "def-countable",
          "lem-pigeonhole",
          "def-equinumerous",
          "def-injection-surjection-bijection",
          "def-nat-order",
          "lem-nat-order-is-membership",
          "def-natural-numbers"
        ]
      },
      {
        "id": "def-order-in-a-group",
        "kind": "definition",
        "title": "The order $|G|$ of a finite group and the order $\\operatorname{ord}(g)$ of an element, with $\\operatorname{ord}(g) = \\infty$ when no positive power of $g$ is the identity",
        "deps": [
          "def-group",
          "def-group-power",
          "lem-order-of-element-exists",
          "thm-well-ordering-principle",
          "def-countable",
          "def-equinumerous",
          "lem-pigeonhole",
          "def-natural-numbers",
          "def-nat-order"
        ]
      },
      {
        "id": "lem-order-characterisation",
        "kind": "lemma",
        "title": "If $\\operatorname{ord}(g) = n$ then $g^{k} = e$ iff $k$ is an integer multiple of $n$, the powers $g^{0}, \\dots, g^{n-1}$ are distinct, and $\\langle g \\rangle$ has exactly $n$ elements; if $g$ has infinite order then $g^{j} = g^{k}$ only for $j = k$",
        "strategy": "direct",
        "deps": [
          "def-order-in-a-group",
          "def-group-power",
          "lem-group-power-laws",
          "lem-group-cancellation",
          "lem-cyclic-subgroup-is-the-set-of-powers",
          "thm-division-algorithm-in-z",
          "def-countable",
          "def-equinumerous",
          "def-injection-surjection-bijection",
          "def-int-order",
          "lem-nat-order-is-membership"
        ]
      },
      {
        "id": "def-group-homomorphism",
        "kind": "definition",
        "title": "Monoid homomorphism and group homomorphism",
        "deps": [
          "def-semigroup-and-monoid",
          "def-group",
          "def-identity-element",
          "def-binary-operation"
        ]
      },
      {
        "id": "lem-group-homomorphism-basic-properties",
        "kind": "lemma",
        "title": "A group homomorphism automatically satisfies $f(e) = e'$ and $f(g^{-1}) = f(g)^{-1}$, and $f(g^{n}) = f(g)^{n}$ for every $n \\in \\mathbb{Z}$; for monoid homomorphisms preservation of the identity must be assumed",
        "strategy": "direct",
        "deps": [
          "def-group-homomorphism",
          "def-group",
          "def-semigroup-and-monoid",
          "lem-group-cancellation",
          "lem-group-inverse-laws",
          "def-group-power",
          "lem-group-power-laws",
          "thm-induction-principle"
        ]
      }
    ]
  },
  {
