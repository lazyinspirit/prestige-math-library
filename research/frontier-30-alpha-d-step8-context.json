  "load_bearing": [
    {
      "id": "thm-hahn-banach-dominated-extension",
      "statement": "Let X be a real vector space, M a linear subspace, p:X→R sublinear, and f:M→R linear with f≤p on M. Then f has a linear extension F:X→R with F≤p on X.",
      "used_by": [
        "thm-hahn-banach-norm-preserving-extension",
        "ex-banach-limit-from-hahn-banach"
      ]
    },
    {
      "id": "thm-complex-hahn-banach-norm-preserving-extension",
      "statement": "A bounded complex linear functional on a linear subspace of a complex normed space extends to the whole space with the same norm.",
      "used_by": [
        "thm-dual-norms-every-vector",
        "thm-norm-preserving-extension-from-any-subspace"
      ]
    },
    {
      "id": "lem-principal-symbol-under-a-c-one-coordinate-change",
      "statement": "For x=Phi(y), the transformed principal symbol is p_m(Phi(y),D Phi(y)^{-T} eta), and derivatives of Phi of order at least 2 contribute only lower-order terms.",
      "used_by": [
        "thm-two-variable-type-and-characteristic-directions-are-coordinate-invariant"
      ]
    },
    {
      "id": "lem-transport-characteristics-depend-c-one-on-initial-position",
      "statement": "Near a base characteristic on a compact interval, nearby characteristics exist on that interval and are C^1 in initial position, with Jacobian Y'=D_xa(X,t)Y and Y(t_0)=I.",
      "used_by": [
        "thm-local-linear-transport-cauchy-problem"
      ]
    },
    {
      "id": "thm-inhomogeneous-linear-transport-formula",
      "statement": "A C^1 solution of u_t+a·grad_x u+cu=f is given along a characteristic by the stated integrating-factor formula, and conversely a C^1 function satisfying it solves the equation.",
      "used_by": [
        "thm-local-linear-transport-cauchy-problem",
        "ex-transport-with-growth-and-source"
      ]
    },
    {
      "id": "thm-frobenius-local-coordinate-theorem",
      "statement": "For a rank-k smooth distribution, integrability is equivalent to involutivity; in that case it is locally spanned by the first k coordinate vector fields.",
      "used_by": [
        "cor-frobenius-local-first-integrals",
        "def-flat-chart-for-a-distribution",
        "ex-coordinate-plane-distribution-and-its-affine-leaves"
      ]
    },
    {
      "id": "thm-existence-and-uniqueness-of-maximal-connected-integral-manifolds",
      "statement": "For an integrable distribution, each tangent-curve reachability class has the unique smooth leaf structure making its inclusion an injective integral immersion, and every connected integral manifold through p factors uniquely through that leaf.",
      "used_by": [
        "cor-maximal-integral-manifolds-partition-the-manifold",
        "thm-regular-foliations-and-integrable-distributions-correspond",
        "prop-every-leaf-is-initial-among-smooth-maps-tangent-to-the-distribution",
        "prop-embedded-leaves-need-not-be-closed-and-leaves-need-not-be-embedded",
        "ex-leaves-of-a-lie-subalgebra-distribution"
      ]
    }
  ],
