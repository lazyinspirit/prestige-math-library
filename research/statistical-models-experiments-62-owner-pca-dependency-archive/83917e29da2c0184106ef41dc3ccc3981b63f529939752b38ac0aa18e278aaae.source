[
  {
    "order": 1928,
    "id": "principal-components-and-eigenspace-stability",
    "kind": "A",
    "category": "statistical-models-and-experiments",
    "title": "PCA and eigengap stability",
    "companion": "principal-components-and-eigenspace-stability-examples",
    "requires": [
