[
  {
    "order": 60,
    "id": "free-groups-and-presentations",
    "kind": "A",
    "category": "abstract-algebra",
    "title": "Free Groups and Presentations",
    "companion": "free-groups-and-presentations-examples",
    "requires": [
      "group-homomorphisms-and-the-isomorphism-theorems"
    ],
    "items": [
      {
        "id": "prop-free-equivalence-is-an-equivalence-and-a-congruence",
        "kind": "proposition",
        "title": "Free equivalence is an equivalence relation and concatenation respects it",
        "strategy": "direct",
        "deps": [
          "def-alphabet-words-and-reduction",
          "def-equivalence-relation"
        ]
      },
      {
        "id": "def-word-quotient-model-of-the-free-group",
        "kind": "definition",
        "title": "The word-quotient model $F_{\\mathrm{word}}(X):=W(X)/{\\sim}$ with multiplication induced by concatenation",
        "deps": [
          "def-alphabet-words-and-reduction",
          "def-equivalence-relation",
          "prop-free-equivalence-is-an-equivalence-and-a-congruence"
        ]
      },
      {
        "id": "thm-word-quotient-model-is-a-group",
        "kind": "theorem",
        "title": "$F_{\\mathrm{word}}(X)$ is a group under $[w][v]=[wv]$",
        "strategy": "direct",
        "deps": [
          "def-word-quotient-model-of-the-free-group",
          "prop-free-equivalence-is-an-equivalence-and-a-congruence",
          "def-group"
        ]
      },
      {
        "id": "lem-formal-letters-act-by-permutations-on-reduced-words",
        "kind": "lemma",
        "title": "Formal letters act by mutually inverse permutations on the set of reduced words",
        "strategy": "constructive",
        "deps": [
          "def-alphabet-words-and-reduction",
          "def-symmetric-group",
          "thm-induction-principle"
        ]
      },
      {
        "id": "thm-normal-form-for-the-word-quotient-model",
        "kind": "theorem",
        "title": "Every class in $W(X)/{\\sim}$ contains exactly one reduced word",
        "strategy": "induction",
        "deps": [
          "def-word-quotient-model-of-the-free-group",
          "def-alphabet-words-and-reduction",
          "lem-formal-letters-act-by-permutations-on-reduced-words",
          "thm-induction-principle"
        ]
      },
      {
        "id": "thm-word-quotient-model-is-free",
        "kind": "theorem",
        "title": "The word-quotient group $W(X)/{\\sim}$ satisfies the universal property of the free group on $X$",
        "strategy": "constructive",
        "deps": [
          "def-word-quotient-model-of-the-free-group",
          "thm-word-quotient-model-is-a-group",
          "def-free-group",
          "def-group",
          "def-group-homomorphism"
        ]
      },
      {
        "id": "cor-generators-embed-in-the-word-quotient",
        "kind": "corollary",
        "title": "The generator map $X\\to W(X)/{\\sim}$ is injective",
        "strategy": "direct",
        "deps": [
          "thm-normal-form-for-the-word-quotient-model",
          "thm-word-quotient-model-is-free"
        ]
      },
      {
        "id": "cor-word-quotient-and-reduced-word-models-are-uniquely-isomorphic",
        "kind": "corollary",
        "title": "The word-quotient and reduced-word models are uniquely isomorphic compatibly with $X$",
        "strategy": "direct",
        "deps": [
          "thm-word-quotient-model-is-free",
          "thm-normal-form-for-the-word-quotient-model",
          "thm-reduced-words-form-the-free-group",
          "thm-free-groups-unique-up-to-unique-isomorphism"
        ]
      },
      {
        "id": "def-free-basis",
        "kind": "definition",
        "title": "A free basis of a group",
        "deps": [
          "def-free-group"
        ]
      },
      {
        "id": "thm-finite-free-bases-have-the-same-cardinality",
        "kind": "theorem",
        "title": "Any two finite free bases of the same group have the same cardinality",
        "strategy": "direct",
        "deps": [
          "def-free-basis",
          "def-symmetric-group",
          "lem-symmetric-group-is-a-group",
          "def-finite-cardinality",
          "thm-cardinality-of-a-set-of-functions",
          "def-nat-power",
          "lem-power-monotone",
          "lem-nat-trichotomy"
        ]
      },
      {
        "id": "def-rank-of-a-finite-rank-free-group",
        "kind": "definition",
        "title": "The rank of a free group admitting a finite basis",
        "deps": [
          "def-free-basis",
          "thm-finite-free-bases-have-the-same-cardinality"
        ]
      },
      {
        "id": "def-relators-relations-and-finite-presentations",
        "kind": "definition",
        "title": "Relators and relations; finitely generated, finitely related, and finite presentations",
        "deps": [
          "def-generated-subgroup",
          "def-group-presentation",
          "def-finite-cardinality"
        ]
      },
      {
        "id": "prop-normal-closure-is-products-of-conjugates",
        "kind": "proposition",
        "title": "The normal closure of $R$ is the set of finite products of conjugates of elements of $R$ and their inverses",
        "strategy": "direct",
        "deps": [
          "def-normal-closure",
          "def-normal-subgroup",
          "def-subgroup",
          "def-group",
          "lem-group-inverse-laws"
        ]
      },
      {
        "id": "prop-equality-of-words-in-a-presentation",
        "kind": "proposition",
        "title": "In $\\langle X\\mid R\\rangle$, the words $u$ and $v$ represent the same element if and only if $u^{-1}v\\in\\langle\\!\\langle R\\rangle\\!\\rangle$",
        "strategy": "direct",
        "deps": [
          "def-group-presentation",
          "prop-normal-closure-is-products-of-conjugates",
          "lem-coset-membership-and-equality",
          "def-quotient-group"
        ]
      },
      {
        "id": "thm-von-dyck",
        "kind": "theorem",
        "title": "Von Dyck's theorem: maps of generators that satisfy the relators extend uniquely from a presented group",
        "strategy": "constructive",
        "deps": [
          "def-group-presentation",
          "def-free-group",
          "def-normal-closure",
          "def-generated-subgroup",
          "thm-quotient-group-universal-property",
          "prop-canonical-quotient-map",
          "def-kernel-and-image-of-group-homomorphism",
          "thm-image-subgroup-and-kernel-normal",
          "def-group-homomorphism"
        ]
      },
      {
        "id": "cor-every-finite-group-is-finitely-presented",
        "kind": "corollary",
        "title": "Every finite group has a finite presentation from its multiplication table",
        "strategy": "constructive",
        "deps": [
          "def-group-presentation",
          "def-relators-relations-and-finite-presentations",
          "thm-von-dyck",
          "def-finite-cardinality",
          "thm-product-rule"
        ]
      },
      {
        "id": "def-abelianisation-of-a-group",
        "kind": "definition",
        "title": "The abelianisation $G^{\\mathrm{ab}}:=G/[G,G]$ and its canonical map",
        "deps": [
          "def-commutator-and-commutator-subgroup",
          "lem-commutator-subgroup-is-normal",
          "def-quotient-group",
          "prop-canonical-quotient-map"
        ]
      },
      {
        "id": "def-free-abelian-group",
        "kind": "definition",
        "title": "Free abelian group on a set",
        "deps": [
          "def-group",
          "def-group-homomorphism"
        ]
      },
      {
        "id": "thm-abelianisation-of-a-free-group-is-free-abelian",
        "kind": "theorem",
        "title": "The abelianisation of the free group on $X$ is the free abelian group on $X$",
        "strategy": "constructive",
        "deps": [
          "def-free-group",
          "def-abelianisation-of-a-group",
          "def-free-abelian-group",
          "thm-quotient-abelian-iff-contains-commutator-subgroup",
          "thm-quotient-group-universal-property",
          "def-commutator-and-commutator-subgroup"
        ]
      },
      {
        "id": "def-tietze-transformations",
        "kind": "definition",
        "title": "Tietze transformations: dictionary generators, redundant relators, renaming, and their inverses",
        "deps": [
          "def-group-presentation",
          "prop-normal-closure-is-products-of-conjugates",
          "def-free-group"
        ]
      },
      {
        "id": "prop-tietze-transformations-preserve-presented-groups",
        "kind": "proposition",
        "title": "Each Tietze transformation preserves the isomorphism type of the presented group",
        "strategy": "constructive",
        "deps": [
          "def-tietze-transformations",
          "thm-von-dyck",
          "prop-equality-of-words-in-a-presentation",
          "prop-normal-closure-is-products-of-conjugates"
        ]
      },
      {
        "id": "thm-tietze-transformations-connect-finite-presentations",
        "kind": "theorem",
        "title": "Two finite presentations define isomorphic groups if and only if a finite sequence of Tietze transformations and inverses connects them",
        "strategy": "constructive",
        "deps": [
          "def-tietze-transformations",
          "prop-tietze-transformations-preserve-presented-groups",
          "prop-equality-of-words-in-a-presentation",
          "thm-von-dyck",
          "def-relators-relations-and-finite-presentations",
          "prop-canonical-quotient-map",
          "thm-induction-principle"
        ]
      },
      {
        "id": "def-cyclically-reduced-word",
        "kind": "definition",
        "title": "Cyclically reduced words",
        "deps": [
          "def-alphabet-words-and-reduction"
        ]
      },
      {
        "id": "lem-cyclic-reduction-normal-form",
        "kind": "lemma",
        "title": "Every nonempty reduced word has the form $tct^{-1}$ with $c$ nonempty and cyclically reduced",
        "strategy": "induction",
        "deps": [
          "def-cyclically-reduced-word",
          "def-alphabet-words-and-reduction",
          "thm-induction-principle"
        ]
      },
      {
        "id": "thm-free-groups-are-torsion-free",
        "kind": "theorem",
        "title": "Free groups are torsion-free",
        "strategy": "direct",
        "deps": [
          "lem-cyclic-reduction-normal-form",
          "thm-reduced-words-form-the-free-group",
          "thm-free-groups-unique-up-to-unique-isomorphism",
          "def-cyclically-reduced-word",
          "def-group-power",
          "def-order-in-a-group",
          "thm-induction-principle"
        ]
      },
      {
        "id": "thm-conjugacy-of-cyclically-reduced-words",
        "kind": "theorem",
        "title": "Two cyclically reduced words in a free group are conjugate if and only if one is a cyclic permutation of the other",
        "strategy": "induction",
        "deps": [
          "def-cyclically-reduced-word",
          "thm-reduced-words-form-the-free-group",
          "thm-free-groups-unique-up-to-unique-isomorphism",
          "thm-induction-principle"
        ]
      }
    ]
  },
  {
    "order": 61,
    "id": "free-groups-and-presentations-examples",
    "kind": "B",
    "category": "abstract-algebra",
    "title": "Free Groups and Presentations: Examples and Counterexamples",
    "requires": [
      "free-groups-and-presentations"
    ],
    "forwardRefs": [],
    "items": [
      {
        "id": "ex-free-group-on-the-empty-set",
        "kind": "example",
        "title": "The free group on the empty set is the trivial group",
        "strategy": "direct",
        "deps": [
          "thm-normal-form-for-the-word-quotient-model",
          "thm-word-quotient-model-is-free"
        ]
      },
      {
        "id": "ex-free-group-on-one-generator",
        "kind": "example",
        "title": "The free group on one generator is isomorphic to $(\\mathbb Z,+)$",
        "strategy": "constructive",
        "deps": [
          "thm-normal-form-for-the-word-quotient-model",
          "thm-word-quotient-model-is-free",
          "thm-classification-of-cyclic-groups",
          "def-group-power"
        ]
      },
      {
        "id": "ex-free-group-on-two-generators-is-not-abelian",
        "kind": "example",
        "title": "A free group whose basis contains two distinct elements is not abelian",
        "strategy": "direct",
        "deps": [
          "thm-normal-form-for-the-word-quotient-model",
          "thm-word-quotient-model-is-free",
          "thm-free-groups-unique-up-to-unique-isomorphism"
        ]
      },
      {
        "id": "ex-presentation-of-a-finite-cyclic-group",
        "kind": "example",
        "title": "$\\langle a\\mid a^n\\rangle\\cong(\\mathbb Z/n,+)$ for every $n\\geq 1$",
        "strategy": "constructive",
        "deps": [
          "def-group-presentation",
          "thm-von-dyck",
          "thm-division-algorithm-in-z",
          "thm-integers-modulo-n-basic-algebra",
          "thm-standard-representatives-modulo-n",
          "def-group-power",
          "lem-group-power-laws",
          "thm-induction-principle"
        ]
      },
      {
        "id": "ex-presentation-of-a-dihedral-group",
        "kind": "example",
        "title": "$D_n\\cong\\langle r,s\\mid r^n,\\ s^2,\\ srs^{-1}r\\rangle$ for the symmetry group $D_n$ of a regular $n$-gon, $n\\geq 3$",
        "strategy": "constructive",
        "deps": [
          "def-group-presentation",
          "thm-von-dyck",
          "def-symmetric-group",
          "lem-symmetric-group-is-a-group",
          "def-generated-subgroup",
          "thm-integers-modulo-n-basic-algebra",
          "thm-standard-representatives-modulo-n",
          "thm-sum-rule",
          "thm-induction-principle"
        ]
      },
      {
        "id": "ex-presentation-of-the-klein-four-group",
        "kind": "example",
        "title": "$\\langle a,b\\mid a^2,\\ b^2,\\ aba^{-1}b^{-1}\\rangle\\cong(\\mathbb Z/2)\\times(\\mathbb Z/2)$",
        "strategy": "constructive",
        "deps": [
          "def-group-presentation",
          "thm-von-dyck",
          "thm-integers-modulo-n-basic-algebra",
          "thm-standard-representatives-modulo-n",
          "thm-external-direct-product-is-a-group",
          "def-group",
          "thm-induction-principle"
        ]
      },
      {
        "id": "ex-presentation-of-z-squared",
        "kind": "example",
        "title": "$\\langle a,b\\mid aba^{-1}b^{-1}\\rangle\\cong(\\mathbb Z,+)\\times(\\mathbb Z,+)$",
        "strategy": "constructive",
        "deps": [
          "def-group-presentation",
          "thm-von-dyck",
          "thm-int-comm-ring",
          "thm-external-direct-product-is-a-group",
          "lem-group-power-laws",
          "thm-induction-principle"
        ]
      },
      {
        "id": "ex-presentation-of-the-symmetric-group-on-three-letters",
        "kind": "example",
        "title": "$\\operatorname{Sym}(\\{0,1,2\\})\\cong\\langle s,t\\mid s^2,\\ t^2,\\ (st)^3\\rangle$",
        "strategy": "constructive",
        "deps": [
          "def-group-presentation",
          "thm-von-dyck",
          "def-symmetric-group",
          "lem-symmetric-group-is-a-group",
          "thm-number-of-bijections-of-a-finite-set",
          "thm-induction-principle"
        ]
      },
      {
        "id": "cex-delete-only-relator-rewriting-misses-ba",
        "kind": "counterexample",
        "title": "In $\\langle a,b\\mid ab\\rangle$, the trivial word $ba$ is stuck under free cancellation and delete-only relator rewriting",
        "strategy": "direct",
        "deps": [
          "def-group-presentation",
          "def-group"
        ]
      },
      {
        "id": "cex-delete-only-relator-rewriting-can-require-lengthening",
        "kind": "counterexample",
        "title": "In $\\langle a,b\\mid aba^{-1}b^{-1}\\rangle$, the trivial word $a^2b^2a^{-2}b^{-2}$ is stuck under free cancellation and delete-only relator rewriting",
        "strategy": "direct",
        "deps": [
          "def-group-presentation",
          "def-group",
          "lem-group-power-laws"
        ]
      },
      {
        "id": "cex-delete-only-relator-rewriting-is-order-dependent",
        "kind": "counterexample",
        "title": "In $\\langle a,b\\mid ab,\\ aba\\rangle$, delete-only relator rewriting sends $aba$ either to the empty word or to the stuck word $a$",
        "strategy": "direct",
        "deps": [
          "def-group-presentation",
          "def-group"
        ]
      }
    ]
  }
]
