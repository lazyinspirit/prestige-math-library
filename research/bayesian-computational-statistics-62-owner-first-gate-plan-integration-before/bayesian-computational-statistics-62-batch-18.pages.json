      {
        "id": "cor-dirichlet-normal-mixture-interval-mass-refinement",
        "kind": "corollary",
        "title": "An interval-mass condition removes the Gaussian-bias logarithm",
        "deps": [
          "thm-dirichlet-normal-mixture-posterior-contraction",
          "lem-dirichlet-normal-mixture-interval-mass-local-prior-mass",
          "lem-dirichlet-normal-mixture-density-well-defined",
          "lem-iid-posterior-denominator-lower-bound-from-kl-mass",
          "lem-dirichlet-normal-mixture-posterior-sieve-tail",
          "lem-dirichlet-normal-mixture-countable-band-entropy-sum",
          "lem-iid-posterior-contraction-under-countable-sieves"
        ],
        "dependency_level": 10,
        "statement": "Under the hypotheses of [[thm-dirichlet-normal-mixture-posterior-contraction]],\nassume additionally that $\\operatorname{supp}(p_0)$ is a finite union of\nintervals and there are $a,c>0$ such that $P_0(I)\\ge c\\lambda(I)^a$ for\nevery interval $I$ contained in the support. Then the source's sharpened\nHellinger contraction rate is\n$$\\max\\{(n\\sigma_n)^{-1/2}\\log n,\\ n^{-1/2}\\sigma_n^{-\\eta},\\ \\sigma_n^2\\},\\qquad \\eta>\\frac{\\gamma}{2(\\gamma-1)}.$$\nIf $G$ is compactly supported in $(0,\\infty)$, the middle term is omitted.\n\n"
      }
