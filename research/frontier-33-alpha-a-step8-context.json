  "load_bearing": [
    {
      "id": "thm-kolmogorov-three-series-theorem",
      "statement": "For independent real random variables, sum X_n converges almost surely iff the large-jump probability, truncated-mean, and truncated-variance series converge for a fixed positive cutoff; this holds for some cutoff iff it holds for every cutoff.",
      "used_by": [
        "ex-rademacher-series-convergence-threshold",
        "ex-a-random-series-that-converges-conditionally-almost-surely",
        "ex-three-series-with-rare-large-jumps"
      ]
    },
    {
      "id": "thm-truncated-centering-criterion-for-an-iid-weak-law",
      "statement": "For IID real variables, deterministic centers mu_n with S_n/n-mu_n ->0 in probability exist iff n P(|X_1|>n)->0; the truncated expectation is an admissible center.",
      "used_by": [
        "cex-iid-cauchy-averages-have-no-deterministic-weak-centering",
        "ex-truncated-centering-weak-law-with-infinite-mean"
      ]
    },
    {
      "id": "thm-independent-series-probability-and-almost-sure-convergence-agree",
      "statement": "For independent partial sums, Cauchy convergence in probability, convergence in probability to a finite real variable, and almost-sure convergence to a finite real variable are equivalent; the limits agree almost surely.",
      "used_by": []
    },
    {
      "id": "thm-hausdorff-measure-is-metric-and-borel-measurable",
      "statement": "Under Countable Choice, H^s is a metric outer measure; every Borel set is Carathéodory measurable and the restriction to the full Carathéodory sigma-algebra is complete.",
      "used_by": [
        "prop-zero-dimensional-hausdorff-measure-counts",
        "thm-hausdorff-measure-has-borel-hulls",
        "thm-hausdorff-n-measure-is-proportional-to-lebesgue-measure"
      ]
    },
    {
      "id": "thm-hausdorff-dimension-critical-exponent",
      "statement": "For d=dim_H A, finite s<d gives H^s(A)=infinity and finite s>d gives H^s(A)=0; finite positive H^s(A) forces d=s.",
      "used_by": [
        "thm-hausdorff-dimension-is-countably-stable",
        "cor-euclidean-hausdorff-dimension",
        "thm-cantor-set-hausdorff-dimension-and-exact-measure",
        "prop-binary-digit-restriction-hausdorff-dimension"
      ]
    },
    {
      "id": "thm-hausdorff-mass-distribution-principle",
      "statement": "A finite Borel measure with positive Borel-hull outer mass on A and an upper diameter-power bound yields H^s(A)>=mu*(A)/C>0 and dim_H A>=s.",
      "used_by": [
        "thm-cantor-set-hausdorff-dimension-and-exact-measure",
        "prop-binary-digit-restriction-hausdorff-dimension",
        "ex-sierpinski-gasket-dimension-by-hand"
      ]
    },
    {
      "id": "lem-fourier-partial-sum-operator-norm-equals-the-lebesgue-constant",
      "statement": "For every N and x_0, the norm of f -> S_N f(x_0), and of S_N on C(T), equals ||D_N||_1; for N>=1 it is at least (3pi)^-1 log(N+1).",
      "used_by": [
        "cex-continuous-function-with-divergent-fourier-series-at-a-point",
        "ex-fourier-partial-sum-operators-and-uniform-boundedness",
        "cex-carleson-maximal-operator-is-not-strong-type-one-one"
      ]
    },
    {
      "id": "lem-fourier-maximal-weak-bound-closes-almost-everywhere-convergence",
      "statement": "A weak L^p bound for the Carleson maximal operator implies S_N f -> f almost everywhere for every f in L^p(T).",
      "used_by": [
        "cor-lp-fourier-series-converges-almost-everywhere-for-p-greater-than-one",
        "rem-the-lone-endpoint-is-excluded-from-carleson-hunt"
      ]
    }
  ],
