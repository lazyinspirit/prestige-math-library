          "claim": "Construct K(s)=Var_2(T̂|S_1=s) as the finite conditional expectation of the squared residual; verify its event integrals, identify the supplied conditional-variance class, then apply total-variance decomposition under AC.",
          "inputs": [
            "A1",
            "F1",
            "F3",
            "F4",
            "F5",
            "F6",
            "F10",
            "F11",
            "step 1.1",
            "step 2.1",
            "algebra"
          ]
        },
        {
          "id": "step-3-3",
          "step": "3.3",
          "claim": "Expand the variance of the first-stage HT estimator of the true PSU totals into covariances and substitute Cov(I_i^(1),I_r^(1))=Δ^(1)_ir.",
          "inputs": [
            "F7",
