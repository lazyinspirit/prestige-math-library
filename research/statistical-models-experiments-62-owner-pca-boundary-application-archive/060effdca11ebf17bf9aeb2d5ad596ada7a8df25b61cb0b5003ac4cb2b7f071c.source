            "F9",
            "F10",
            "F11",
            "step 2.1",
            "algebra"
          ]
        },
        {
          "id": "step-4-1",
          "step": "4.1",
          "claim": "Product-law conditional independence makes cross-PSU conditional covariances zero; add the within-PSU variances and average PSU inclusion indicators to obtain Σ_i V_i/π_i^(1).",
          "inputs": [
            "F1",
            "F7",
            "F8",
            "F9",
            "F10",
            "F11",
            "step 1.1",
            "step 1.2",
            "step 3.2",
            "algebra"
          ]
        },
        {
          "id": "step-5-1",
          "step": "5.1",
          "claim": "Substitute the within-stage expression from steps 1.2 and 4.1 and the between-stage expression from step 3.3 into step 3.2; unbiasedness is from step 3.1.",
          "inputs": [
            "step 1.2",
            "step 3.1",
            "step 3.2",
            "step 3.3",
            "step 4.1",
            "algebra"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
