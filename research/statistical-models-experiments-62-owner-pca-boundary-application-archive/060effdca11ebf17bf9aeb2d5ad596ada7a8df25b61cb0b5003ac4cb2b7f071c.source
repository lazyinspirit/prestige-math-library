      "supplier_interfaces": [
        {
          "supplier": "def-cluster-sampling-design-and-cluster-totals",
          "source_section": "Definition",
          "excerpt": "Let the finite element population be partitioned into\nnonempty finite sets\n$$\\mathcal U=\\bigsqcup_{i=1}^{M}U_i,$$\nwhere $M\\ge1$ and $U_i$ is the set of secondary sampling units (SSUs) in the\n$i$th primary sampling unit (PSU).",
          "use": "Supplies the finite PSU/SSU partition and fixed cluster totals.",
          "status": "current local draft inspected"
        },
        {
          "supplier": "def-finite-population-and-sampling-design",
          "source_section": "Definition",
          "excerpt": "A **sampling design** on $U$ is a nonempty finite set\n$\\mathcal S_d\\subseteq\\mathcal P(U)$ and a function\n$p_d:\\mathcal S_d\\to(0,1]$ with $\\sum_{s\\in\\mathcal S_d}p_d(s)=1$.",
