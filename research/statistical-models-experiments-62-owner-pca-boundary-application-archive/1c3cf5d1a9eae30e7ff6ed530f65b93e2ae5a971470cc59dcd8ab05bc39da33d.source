    "thm-neyman-allocation-minimizes-stratified-variance": {
      "risk": "medium",
      "kind": "theorem",
      "citations": [
        {
          "fact": "F1",
          "source": "def-stratified-sampling-design-and-estimator",
          "source_section": "Definition",
          "quote": "S_h^2=\\frac1{N_h-1}\\sum_{i\\in U_h}(y_i-\\bar y_h)^2",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F2",
          "source": "thm-stratified-total-unbiasedness-and-variance",
          "source_section": "Statement",
          "quote": "\\operatorname{Var}_d(\\widehat T_{st})=\\sum_{h:n_h<N_h}N_h^2\\left(1-\\frac{n_h}{N_h}\\right)\\frac{S_h^2}{n_h}",
          "uses": [
            "1.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "remove-allocation-independent-fpc-term",
          "step": "1.1",
          "claim": "Each variable stratum term equals a_h^2/x_h minus N_h S_h^2, so minimizing at fixed sum reduces to minimizing sum a_h^2/x_h.",
          "inputs": [
            "given",
            "F1",
            "F2",
            "algebra"
          ]
        },
        {
          "id": "pairwise-square-lower-bound",
          "step": "2.1",
          "claim": "The finite pairwise-square identity gives (sum a_h^2/x_h)(sum x_h) >= (sum a_h)^2, with equality exactly when a_h/x_h is constant.",
          "inputs": [
            "given",
            "step 1.1",
            "algebra"
          ]
        },
        {
          "id": "attain-and-normalize",
          "step": "3.1",
          "claim": "The normalized allocation x_h=n* a_h/sum a_k is positive, feasible, and uniquely satisfies the equality condition, so it attains the global minimum.",
          "inputs": [
            "given",
            "step 1.1",
            "step 2.1",
            "algebra"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "Statement explicitly requires nonempty J, S_h>0 for h in J and nstar>0. For J empty the budget sum would be0 and cannot equal nstar; Proof3.1 divides by the strictly positive sum_{h in J}N_h S_h, so that empty optimization problem is outside scope.",
          "reviewed": {
            "upheld": true,
            "by": "owner-delegated-focused-boundary-review",
            "reason": "Statement explicitly requires nonempty J, S_h>0 for h in J and nstar>0. For J empty the budget sum would be0 and cannot equal nstar; Proof3.1 divides by the strictly positive sum_{h in J}N_h S_h, so that empty optimization problem is outside scope."
          }
        },
        {
          "case": "zero",
          "status": "not_applicable",
          "reason": "The statement requires S_h>0 for each variable noncertainty stratum; zero-variance cases are treated in the separate example."
        },
        {
          "case": "one",
          "status": "checked",
          "evidence": "Statement includes singleton J; step 3.1 gives x_h=n^star under the sole positive budget constraint."
        },
        {
          "case": "degenerate",
