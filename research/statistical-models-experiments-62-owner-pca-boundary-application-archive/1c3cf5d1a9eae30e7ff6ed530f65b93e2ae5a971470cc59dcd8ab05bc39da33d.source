          "source": "def-moments-variance-and-covariance",
          "source_section": "Definition",
          "quote": "\\operatorname{Cov}(X,Y):=\\mathbb E[(X-\\mathbb E[X])(Y-\\mathbb E[Y])].",
          "uses": [
            "1.2",
            "1.3"
          ]
        },
        {
