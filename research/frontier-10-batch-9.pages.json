          "def-elementary-row-operations-and-row-equivalence"
        ]
      },
      {
        "id": "lem-nonzero-echelon-rows-form-a-basis-of-the-row-space",
        "kind": "lemma",
        "title": "The nonzero rows of a row echelon form form a basis of the original row space",
        "strategy": "direct",
        "deps": [
          "lem-row-operations-preserve-row-space",
          "def-row-echelon-reduced-row-echelon-and-pivots",
          "def-linear-basis",
          "def-linear-independence"
