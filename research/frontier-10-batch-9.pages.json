        "deps": [
          "def-matrix-space",
          "def-field"
        ]
      },
      {
        "id": "thm-gaussian-elimination-produces-row-echelon-form",
        "kind": "theorem",
        "title": "Gaussian elimination reduces every finite matrix over a field to row echelon form",
        "strategy": "constructive induction",
        "deps": [
          "def-elementary-row-operations-and-row-equivalence",
          "def-row-echelon-reduced-row-echelon-and-pivots",
          "thm-induction-principle"
