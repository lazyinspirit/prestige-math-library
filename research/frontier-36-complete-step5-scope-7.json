  "refuter_findings": [
    {
      "obligation": "refuter:7:1",
      "id": "def-associated-sheaf-module-affine-scheme",
      "location": "Definition",
      "defect": "false-claim",
      "evidence": "The definition says: “Then $g\\in\\sqrt{(f)}$, so $f^n=gh$ for some $n\\ge1$ and some $h\\in A$.” Take $A=k[x,y]$, $f=x$, and $g=xy$. Then $D(g)\\subseteq D(f)$ and $g\\in(f)$, but no $x^n=xyh$ exists in $A$ since $y$ does not divide $x^n$. The restriction construction is valid with the corrected relation $g^N=fh$, which makes $f$ a unit after inverting $g$.",
      "severity": "fatal",
      "observed_sha256": "b6245fdad80057568aa742f73ac8e0853ee749668c4ab82f5e2b55f60fc62c4c"
    },
    {
      "obligation": "refuter:7:2",
      "id": "def-fitting-ideal-sheaf",
      "location": "Definition",
      "defect": "ill-formed",
      "evidence": "The definition states that the ideal is zero precisely when all $(n-k)\\times(n-k)$ minors vanish, while earlier it defines $I_r=A$ for $r\\le0$. For a nonzero ring and a presentation with $n=1$, taking $k=2$ gives $\\operatorname{Fitt}_2=I_{-1}=A$, but $(-1)\\times(-1)$ minors are undefined. The minor criterion needs a range restriction or an explicit boundary-case formulation.",
      "severity": "nonfatal",
      "observed_sha256": "e0f5fb6d1654dca615d214350a448a6ceb5366b1f986f398a954e5ddfdbda653"
    }
  ],
