        "cex-bad-cover-circle-cech-misses-h1"
      ]
    },
    {
      "id": "lem-koszul-coherence-for-derived-sheaf-tensor",
      "statement": "For bounded-above complexes of abelian sheaves under the standing smallness or supplied cofinal-denominator hypothesis, the derived tensor product has canonical natural associator, symmetry and unit isomorphisms satisfying the pentagon, triangle and hexagon identities; shifted-unit symmetry is the sign (-1)^(pq).",
      "used_by": [
        "def-cup-product-sheaf-cohomology",
        "thm-cup-product-graded-associative-natural"
      ]
    },
    {
      "id": "thm-cup-product-graded-associative-natural",
      "statement": "Under AC and the cup-product setting's supplied-resolution and smallness hypotheses, cup products for tensor pairings are bilinear and natural; for a unital sheaf of rings they are associative and unital, and commutative multiplication gives graded commutativity with sign (-1)^(pq).",
      "used_by": [
        "def-cup-product-sheaf-cohomology"
      ]
    },
    {
      "id": "thm-valuative-criterion-separatedness",
      "statement": "A morphism is separated if and only if every valuation-ring diagram of the stated kind has at most one dotted lift.",
