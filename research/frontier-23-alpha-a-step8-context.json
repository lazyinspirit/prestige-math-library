    {
      "id": "def-fundamental-group-of-a-graph-of-groups-relative-to-a-maximal-tree",
      "statement": "Let $\\mathcal G$ be a graph of groups on a connected graph $X$, and let $T\\subseteq X$ be a maximal subtree. The **fundamental group** $\\pi_1(\\mathcal G,T)$ is the quotient of the path group $\\Pi(\\mathcal G)$ by the additional relations $$e=1\\qquad(e\\in E(T)).$$",
      "used_by": [
        "def-reduced-graph-of-groups-word",
        "thm-normal-form-for-fundamental-groups-of-graphs-of-groups",
