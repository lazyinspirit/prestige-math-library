        "thm-kurosh-subgroup-theorem"
      ]
    },
    {
      "id": "def-word-problem-for-a-fixed-finite-presentation",
      "statement": "Fix a finite presentation $\\mathcal P=\\langle X\\mid R\\rangle$. Its **word problem** is the decision problem whose input is a word $w$ on $X\\sqcup X^{-1}$ and whose question is whether $w$ represents the identity in the group presented by $\\mathcal P$.",
      "used_by": [
        "def-uniform-word-problem-for-finite-presentations",
