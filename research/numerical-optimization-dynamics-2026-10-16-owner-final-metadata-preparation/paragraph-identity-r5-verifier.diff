+// Paragraph identity is authenticated from root's direct map and archived source,
+// never inferred from a coincident step number after a phase insertion/reorder.
+function loadPhaseIdentity(specPath, reader) {
+  const entries=new Map();
+  if(!specPath)return entries;
+  const spec=JSON.parse(reader(specPath));
+  const config=Array.isArray(spec)?{maps:spec}:spec;
+  const receipt=optionForPhase('--phase-receipt')??config.root_receipt;
+  if(!receipt)throw Error('Phase identity requires the actual root application receipt');
+  reader(receipt);
+  const rows=config.map_file?JSON.parse(reader(config.map_file)):(config.maps??[]);
+  const origin=config.map_file??specPath;
+  for(const row of [...rows,...(config.extra_maps??[])]){
+    const file=row.path,id=path.basename(file,'.md'),map=row.old_to_final_step_labels;
+    if(!file?.startsWith('items/')||!map||entries.has(id))throw Error('Invalid/duplicate phase identity '+file);
+    if(new Set(Object.values(map)).size!==Object.values(map).length)throw Error('Noninjective phase identity '+id);
+    if(row.root_receipt)reader(row.root_receipt);
+    const before=row.before_file??path.join(path.dirname(origin),'before',file);
+    const original=numberedProofSteps(splitFrontmatter(reader(before)).body);
+    entries.set(id,{map,original:new Map(original.map(st=>[st.id,st])),before});
+  }
+  for(const id of config.rewritten_items??[]){if(entries.has(id))throw Error('Rewritten item also has old-paragraph phase map '+id);entries.set(id,{rewritten:true});}
+  return entries;
+}
+function paragraphClaim(text,map={},order=Object.keys(map)){
+  const refs=/(steps?\s+)((?:\d+\.\d+)(?:(?:\s*,\s*(?:and\s+)?|\s+and\s+|\s*&\s*|\s*[–—-]\s*)\d+\.\d+)*)/gi;
+  return String(text??'').replace(refs,(_,prefix,labels)=>{
+    const expanded=[];
+    for(const part of labels.match(/\d+\.\d+(?:\s*[–—-]\s*\d+\.\d+)?/g)??[]){
+      const ends=part.match(/\d+\.\d+/g);
+      if(ends.length===1)expanded.push(ends[0]);
+      else{const a=order.indexOf(ends[0]),z=order.indexOf(ends[1]);if(a<0||z<a)throw Error('Unbound/reversed paragraph reference range '+part);expanded.push(...order.slice(a,z+1));}
+    }
+    return 'step-references:'+expanded.map(label=>map[label]??label).join(',');
+  })
+    .replaceAll('\\{t_{ii}\\}','\\{t_{ii}}')
+    .replaceAll('\\lbrackih,s\\rbrack','[ih,s]')
+    .replaceAll('\\lbrackih,(i+1)h\\rbrack','[ih,(i+1)h]')
+    .replace(/\s+/g,'').replace(/∎$/,'');
+}
+function proofIdentities(id,steps,contract,phases){
+  const prior=['derivations','routine_steps'].flatMap(group=>(contract[group]??[]).map(row=>({row,group})));
+  const currentOrder=steps.map(st=>st.id),phase=phases.get(id),inverse=new Map(Object.entries(phase?.map??{}).map(([a,b])=>[b,a])),used=new Set(),out=new Map();
+  for(const step of steps){
+    let candidates=[];
+    if(phase?.rewritten){out.set(step.id,null);continue;}
+    if(phase){
+      const oldLabel=inverse.get(step.id);
+      if(oldLabel===undefined){out.set(step.id,null);continue;} // explicitly inserted new paragraph
+      const source=phase.original.get(oldLabel);
+      if(!source||paragraphClaim(source.claim,phase.map,[...phase.original.keys()])!==paragraphClaim(step.claim,{},currentOrder))throw Error('Mapped source paragraph identity drift '+id+' '+oldLabel+' -> '+step.id);
+      // Direct inverse-map candidate must actually carry that paragraph's claim.
+      const direct=prior.filter(x=>x.row.step===oldLabel&&paragraphClaim(x.row.claim,{},[...phase.original.keys()])===paragraphClaim(source.claim,{},[...phase.original.keys()]));
+      candidates=direct.length?direct:prior.filter(x=>paragraphClaim(x.row.claim,{},currentOrder)===paragraphClaim(step.claim,{},currentOrder)||paragraphClaim(x.row.claim,phase.map,[...phase.original.keys()])===paragraphClaim(step.claim,{},currentOrder));
+    }else{
+      // Rewritten paragraphs (e.g. a new proof) receive no invented old identity.
+      const direct=prior.filter(x=>x.row.step===step.id&&paragraphClaim(x.row.claim,{},currentOrder)===paragraphClaim(step.claim,{},currentOrder));
+      candidates=direct.length?direct:prior.filter(x=>paragraphClaim(x.row.claim,{},currentOrder)===paragraphClaim(step.claim,{},currentOrder));
+    }
+    if(candidates.length>1)throw Error('Ambiguous original paragraph identity '+id+' '+step.id);
+    const match=candidates[0]??null;
+    if(match){if(used.has(match.row))throw Error('Original paragraph reused '+id);used.add(match.row);}
+    out.set(step.id,match);
+  }
+  return out;
