+// Independently compare the actual fact paragraphs/pairs, preserving only genuine
+// same-pair auxiliary fields. No new source-reading or body-inspected status.
+function verifySupplierInterfaces(id,s,contract,prior){
+  const pairs=[...s.facts].flatMap(([fact,f])=>[...new Set(f.links)].map(supplier=>({fact,supplier,paragraph:f.text.trim()})));
+  const rows=contract.supplier_interfaces??[];
+  check(rows.length===pairs.length,{kind:'supplier-interface-current-pair-count',id});
+  for(const pair of pairs){
+    const matches=rows.filter(x=>x.fact===pair.fact&&(x.supplier??x.source)===pair.supplier),row=matches[0];
+    check(matches.length===1&&row.required_hypotheses===pair.paragraph,{kind:'supplier-interface-full-current-fact-paragraph',id,fact:pair.fact,supplier:pair.supplier});
+    if(!row)continue;
+    const exact=(prior.supplier_interfaces??[]).find(x=>x.fact===pair.fact&&(x.supplier??x.source)===pair.supplier);
+    const legacy=(prior.supplier_interfaces??[]).filter(x=>!x.fact&&(x.supplier??x.source)===pair.supplier);
+    const old=exact??(legacy.length===1&&pairs.filter(x=>x.supplier===pair.supplier).length===1?legacy[0]:null);
+    if(old){for(const key of Object.keys(old))if(!['fact','supplier','required_hypotheses'].includes(key))check(eq(row[key],old[key]),{kind:'supplier-interface-same-pair-other-field-preserved',id,fact:pair.fact,supplier:pair.supplier,field:key});}
+    else check(Object.keys(row).every(k=>['fact','supplier','required_hypotheses'].includes(k)),{kind:'new-supplier-interface-no-invented-reading-status',id,fact:pair.fact,supplier:pair.supplier});
+  }
