import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';
import {createRequire} from 'node:module';
const root=process.cwd(), web=path.resolve(root,'../prestige-intelligence/web');
const out=path.join(root,'research/math-library-rendering-repairs-2026-10-23/diagram-checks/thm-nine-lemma-in-an-abelian-category');
const raw=fs.readFileSync(root+'/items/thm-nine-lemma-in-an-abelian-category.md','utf8');
const source=raw.match(/```tikzcd\n([\s\S]*?)\n```/)![1];
process.chdir(web);
const {renderTikz}=await import(web+'/lib/tikz.ts');
const svg=await renderTikz(source,'tikzcd');
fs.writeFileSync(out+'/diagram.svg',svg);
fs.writeFileSync(out+'/diagram.html','<!doctype html><html><body style="margin:0;background:black;color:white"><main style="padding:48px">'+svg+'</main></body></html>');
const req=createRequire(web+'/package.json');
const {chromium}=req('/home/lazyinspirit/.npm/_npx/e41f203b7505f1fb/node_modules/playwright');
const browser=await chromium.launch({headless:true,args:['--allow-file-access-from-files','--disable-background-networking']});
const page=await browser.newPage({viewport:{width:700,height:300},deviceScaleFactor:2});
await page.route('**/*',(r:any)=>r.request().url().startsWith('file:')||r.request().url().startsWith('data:')?r.continue():r.abort());
await page.goto('file://'+out+'/diagram.html');await page.evaluate(()=>document.fonts.ready);
await page.screenshot({path:out+'/diagram.png'});
fs.writeFileSync(out+'/compile-result.json',JSON.stringify({raw_sha256:crypto.createHash('sha256').update(raw).digest('hex'),source_sha256:crypto.createHash('sha256').update(source).digest('hex'),renderer:'Actual application renderTikz, fresh isolated TMPDIR cache, node-tikzjax TeX compilation',svg_sha256:crypto.createHash('sha256').update(svg).digest('hex'),svg_count:await page.locator('svg').count(),capture:'1400x600 native pixels, deviceScaleFactor 2, no resizing',compiled_at:new Date().toISOString()},null,2)+'\n');
await browser.close();console.log('Fresh TeX compile and local capture completed.');
