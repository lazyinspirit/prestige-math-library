  "load_bearing": [
    {
      "id": "def-koszul-complex-of-a-sequence-with-coefficients",
      "statement": "Let x=(x_1,...,x_n) in a commutative unital ring R. The Koszul complex K(x;M) has K_p=Λ^pR^n⊗_RM and differential determined by d(e_i⊗m)=x_im and the graded Leibniz rule.",
      "used_by": [
        "lem-koszul-differential-coordinate-formula",
        "lem-koszul-differential-is-well-defined-and-squares-to-zero",
        "lem-koszul-complex-concatenation-tensor-isomorphism",
        "lem-koszul-generator-contraction-homotopy",
        "lem-koszul-complex-localises-termwise"
      ]
    },
    {
      "id": "def-regular-sequence-on-a-module",
      "statement": "A finite ordered sequence x_1,...,x_n is M-regular when each preceding quotient is nonzero and multiplication by x_i is injective on it, and M/(x)M is nonzero.",
      "used_by": [
        "thm-regular-sequences-give-acyclic-koszul-complexes",
        "thm-localisation-and-flat-base-change-of-regular-sequences",
        "thm-koszul-acyclicity-characterises-local-regular-sequences",
        "thm-regularity-notions-and-permutation-invariance-local"
      ]
    },
    {
      "id": "thm-koszul-acyclicity-characterises-local-regular-sequences",
      "statement": "For a finite module over a Noetherian local ring and x⊂m with nonzero terminal quotient, x is regular if and only if H_i(K(x;M))=0 for all i>0.",
      "used_by": [
        "cor-local-koszul-acyclicity-iff-regular-sequence",
        "lem-regular-sequence-permutation-adjacent-swap",
        "lem-h-one-regular-local-implies-koszul-regular",
        "cor-regularity-notions-coincide-local-finite"
      ]
    },
    {
      "id": "def-projective-algebraic-set",
      "statement": "For homogeneous T⊂k[x_0,...,x_n], V_+(T) consists of projective points on which every F∈T vanishes; projective algebraic sets are such sets.",
      "used_by": [
        "thm-projective-zariski-topology",
        "def-projective-closure-affine-set",
        "def-homogeneous-coordinate-ring",
        "def-affine-cone-projective-set",
        "thm-closed-projective-embedding-by-homogeneous-generators"
      ]
    },
    {
      "id": "thm-ideal-projective-closure-saturation",
      "statement": "If A=V(I)⊂A_k^n and I=I(A), then I_+(Abar^proj)=I^h:x_0^∞.",
      "used_by": [
        "cex-naive-homogenization-adds-component",
        "ex-projective-closure-parabola"
      ]
    },
    {
      "id": "thm-structure-sheaf-affine-scheme",
      "statement": "For every ring A, the basic-open localization data extend uniquely to a sheaf of rings O_Spec A on all opens of Spec A.",
      "used_by": [
        "thm-sections-basic-open-affine-scheme",
        "thm-stalk-structure-sheaf-prime-localization",
        "thm-global-sections-affine-scheme",
        "thm-affine-scheme-ring-anti-equivalence"
      ]
    },
    {
      "id": "thm-affine-scheme-ring-anti-equivalence",
      "statement": "For commutative unital rings A,B, Hom_CRing(A,B) is naturally bijective with Hom_LRS(Spec B,Spec A); consequently Spec is a contravariant equivalence with quasi-inverse global sections.",
      "used_by": [
        "cor-affine-scheme-isomorphism-ring-isomorphism",
        "def-functor-of-points-affine-scheme",
        "thm-affine-schemes-determined-by-functor-of-points",
        "rem-spec-contravariance-and-points"
      ]
    }
  ],
