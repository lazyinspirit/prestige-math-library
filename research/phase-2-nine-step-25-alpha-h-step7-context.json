  "load_bearing": [
    {
      "id": "lem-bounded-real-ultralimits-and-free-tail-extension",
      "statement": "Assuming AC, there is a free ultrafilter on \\(\\mathbb N\\); every bounded real sequence has a unique ultralimit along a supplied ultrafilter, with the stated algebra, order, large-set, and ordinary-limit rules.",
      "used_by": [
        "lem-rescaled-ultradistance-is-a-quotient-metric",
        "lem-geodesic-segments-have-isometric-ultralimits",
        "lem-sublinear-minsize-makes-every-cone-geodesic-a-limit-geodesic",
        "thm-sublinear-triangle-minsize-implies-hyperbolicity",
        "ex-asymptotic-cones-of-lines-and-trees",
        "ex-scaling-distinguishes-sublinear-minsize-from-bounded-perimeter"
      ]
    },
    {
      "id": "lem-geodesic-segments-have-isometric-ultralimits",
      "statement": "Assume AC. Rescaled ultralimits of pointed geodesic spaces are geodesic, and a boundedly based family of finite segments has represented limit isometric to its extended limiting parameter interval.",
      "used_by": [
        "lem-tree-cones-give-uniform-two-side-control",
        "thm-all-asymptotic-cones-are-trees-implies-uniform-slimness",
        "lem-sublinear-minsize-makes-every-cone-geodesic-a-limit-geodesic",
        "ex-asymptotic-cones-of-lines-and-trees"
      ]
    },
    {
      "id": "lem-triangle-extrema-and-real-tree-tripod-rules",
      "statement": "Minsize and slimness attain extrema on finite chosen triangles; unique arcs, tripod triangles, and 0-slim triangles are equivalent, with the stated finite-Hausdorff ray and line rules.",
      "used_by": [
        "lem-tree-cones-give-uniform-two-side-control",
        "thm-all-asymptotic-cones-are-trees-implies-uniform-slimness",
        "lem-sublinear-minsize-makes-every-cone-geodesic-a-limit-geodesic",
        "thm-sublinear-triangle-minsize-implies-hyperbolicity",
        "lem-point-wedges-preserve-a-common-triangle-minsize-bound",
        "ex-asymptotic-cones-of-lines-and-trees"
      ]
    },
    {
      "id": "thm-sublinear-triangle-minsize-implies-hyperbolicity",
      "statement": "Assume AC. Every nonempty geodesic space with \\(m_X(P)/P\\to0\\) has a finite uniform slimness constant; the empty space is separately vacuously slim.",
      "used_by": [
        "thm-linear-relator-area-implies-slim-geodesic-triangles",
        "lem-uniform-filling-data-give-a-uniform-slimness-bound"
      ]
    },
    {
      "id": "lem-relator-disks-give-area-controlled-coarse-fillings",
      "statement": "For a finite presentation with relator length bound \\(L\\), every null word has an \\(r=\\max(1,L)\\)-edge coarse filling with \\(N\\le20(L+1)(\\operatorname{Area}(w)+|w|+1)\\); geodesic triangles admit marked null-word approximations with the stated Hausdorff error.",
      "used_by": [
        "thm-linear-relator-area-implies-slim-geodesic-triangles"
      ]
    },
    {
      "id": "lem-coarse-triangle-minsize-is-bounded-by-square-root-area",
      "statement": "An \\(r\\)-edge coarse triangular filling with \\(N\\) triangles bounds coarse minsize by \\(2r\\sqrt N+2r\\), and bounds continuous-side minsize by that quantity plus twice the side-set Hausdorff error.",
      "used_by": [
        "thm-linear-relator-area-implies-slim-geodesic-triangles"
      ]
    },
    {
      "id": "thm-linear-relator-area-implies-slim-geodesic-triangles",
      "statement": "Assuming AC, a finite presentation with \\(\\operatorname{Area}(w)\\le K|w|\\) has uniformly slim Cayley triangles, and its minsize profile is bounded by \\(A(K,L)\\sqrt{P+7}+B(L)\\).",
      "used_by": [
        "lem-uniform-filling-data-give-a-uniform-slimness-bound"
      ]
    }
  ],
