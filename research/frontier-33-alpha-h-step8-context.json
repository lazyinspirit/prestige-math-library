  "load_bearing": [
    {
      "id": "thm-structural-recursion-on-set-coded-syntax",
      "statement": "Constructor induction is valid for the term and formula sets; for supplied set-valued constructor operations there is a unique evaluation obeying those rules.",
      "used_by": [
        "thm-set-structure-satisfaction-recursion",
        "def-free-variables-and-syntactic-substitution",
        "def-term-denotation-in-a-set-structure"
      ]
    },
    {
      "id": "prop-capture-avoiding-substitution",
      "statement": "There is a canonical total capture-avoiding substitution φ⟨t/x⟩, and M,s ⊨ φ⟨t/x⟩ iff M,s[x:=⟦t⟧s] ⊨ φ.",
      "used_by": [
        "cor-semantic-equivalence-under-substitution",
        "def-relativization-to-a-definable-class",
        "fs-v-has-a-definable-truth-predicate"
      ]
    },
    {
      "id": "thm-foundation-equivalent-to-hierarchy-exhaustion",
      "statement": "Over ZF without Foundation, Foundation, membership induction, and every set belonging to some cumulative-hierarchy stage are equivalent.",
      "used_by": [
        "def-membership-rank-of-a-set",
        "thm-membership-rank-and-hierarchy-levels",
        "cor-universe-is-the-class-union-of-its-stages"
      ]
    },
    {
      "id": "thm-membership-rank-and-hierarchy-levels",
      "statement": "In ZF, x ∈ Vα iff rank(x)<α, and x⊆Vα iff rank(x)≤α.",
      "used_by": [
        "cor-universe-is-the-class-union-of-its-stages",
        "prop-ranks-of-ordinals-and-hierarchy-stages",
        "thm-h-kappa-is-a-transitive-set",
        "prop-minimum-rank-selection-and-collection"
      ]
    },
    {
      "id": "thm-multiple-choice-equivalent-to-choice-in-zf",
      "statement": "In ZF, if P(α) is well-orderable for every ordinal α, then AC holds. In particular MC iff AC.",
      "used_by": [
        "ex-weak-choice-implication-map",
        "rem-weak-choice-nonimplication-destinations"
      ]
    },
    {
      "id": "thm-halbeisen-shelah-no-powerset-sequence-injection",
      "statement": "In ZF, if ω injects into X, there is no injection P(X)→Seq(X).",
      "used_by": [
        "lem-local-gch-absorbs-sums-and-squares",
        "lem-local-gch-hartogs-dichotomy",
        "thm-specker-two-local-gch"
      ]
    },
    {
      "id": "thm-specker-two-local-gch",
      "statement": "In ZF, if ω injects into X and CH(X) and CH(P(X)) hold, then P(X)≈h(X); in particular X is well-orderable.",
      "used_by": [
        "thm-sierpinski-arbitrary-set-gch-implies-choice",
        "ex-local-gch-at-omega-and-its-power-set"
      ]
    },
    {
      "id": "thm-fodor-pressing-down",
      "statement": "For regular uncountable κ, every regressive map on a stationary S⊆κ∖{0} has a stationary fibre.",
      "used_by": [
        "lem-unbounded-stationary-fibres-yield-a-partition",
        "lem-splitting-stationary-sets-of-fixed-cofinality",
        "thm-solovay-stationary-partition",
        "ex-transfinite-subway-pressing-down"
      ]
    },
    {
      "id": "thm-solovay-stationary-partition",
      "statement": "In ZFC, every stationary subset S of a regular uncountable cardinal κ is the disjoint union of κ stationary sets.",
      "used_by": [
        "cor-club-filter-not-an-ultrafilter",
        "def-stationary-antichains-modulo-nonstationary"
      ]
    },
    {
      "id": "thm-elementary-initial-segments-form-a-club",
      "statement": "For a regular uncountable κ and a structure on κ in a finitary language of size less than κ, the nonzero elementary initial segments form a club.",
      "used_by": [
        "thm-stationarity-via-elementary-initial-segments"
      ]
    }
  ],
