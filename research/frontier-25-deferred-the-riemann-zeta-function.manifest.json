[
  {
    "order": 345,
    "id": "the-riemann-zeta-function",
    "kind": "A",
    "category": "complex-analysis",
    "title": "The Riemann Zeta Function",
    "companion": "the-riemann-zeta-function-examples",
    "requires": [
      "the-gamma-function",
      "mittag-leffler-and-runges-theorem",
      "primes-and-the-fundamental-theorem-of-arithmetic"
    ],
    "items": [
      {
        "id": "lem-riemann-zeta-dirichlet-series-converges-locally-uniformly",
        "kind": "lemma",
        "title": "The Dirichlet series for zeta converges absolutely and locally uniformly on the half-plane Re s greater than 1",
        "deps": [
          "def-complex-exponential",
          "def-natural-logarithm",
          "thm-weierstrass-m-test-for-complex-function-series",
          "thm-p-series-rational"
        ]
      },
      {
        "id": "def-riemann-zeta-function",
        "kind": "definition",
        "title": "The Riemann zeta function on the half-plane Re s greater than 1",
        "deps": [
          "lem-riemann-zeta-dirichlet-series-converges-locally-uniformly"
        ]
      },
      {
        "id": "thm-euler-product-for-riemann-zeta",
        "kind": "theorem",
        "title": "The Riemann zeta function has its Euler product on the half-plane Re s greater than 1",
        "deps": [
          "def-riemann-zeta-function",
          "thm-absolute-convergence-criterion-for-complex-infinite-products",
          "thm-fundamental-theorem-of-arithmetic",
          "thm-canonical-prime-factorisation"
        ]
      },
      {
        "id": "cor-riemann-zeta-is-zero-free-for-real-part-greater-than-one",
        "kind": "corollary",
        "title": "The Riemann zeta function has no zeros when Re s is greater than 1",
        "deps": [
          "thm-euler-product-for-riemann-zeta",
          "thm-absolute-convergence-criterion-for-complex-infinite-products"
        ]
      },
      {
        "id": "rem-agreement-with-the-existing-infinitude-of-primes",
        "kind": "remark",
        "title": "The pole of zeta at 1 recovers Euclid's infinitude of primes without reminting it on this page",
        "deps": [
          "thm-euler-product-for-riemann-zeta",
          "thm-euclid-infinitude-of-primes"
        ]
      },
      {
        "id": "thm-riemann-zeta-continuation-to-the-right-half-plane",
        "kind": "theorem",
        "title": "For Re s greater than 0, zeta admits the fractional-part integral formula with a simple residue-one pole at 1",
        "deps": [
          "def-riemann-zeta-function",
          "def-natural-logarithm",
          "thm-p-series-rational"
        ]
      },
      {
        "id": "thm-dirichlet-eta-representation",
        "kind": "theorem",
        "title": "The Dirichlet eta series is holomorphic on Re s greater than 0 and equals the prefactor times zeta there",
        "deps": [
          "def-riemann-zeta-function",
          "thm-riemann-zeta-continuation-to-the-right-half-plane",
          "thm-weierstrass-m-test-for-complex-function-series",
          "def-complex-exponential",
          "def-natural-logarithm"
        ]
      },
      {
        "id": "def-jacobi-theta-function",
        "kind": "definition",
        "title": "The Jacobi theta function theta(t)=sum over all integers of exp(-pi n squared t) for t greater than 0",
        "deps": [
          "def-complex-exponential"
        ]
      },
      {
        "id": "thm-jacobi-theta-transformation",
        "kind": "theorem",
        "title": "The Jacobi theta function satisfies theta(t)=t to the minus one-half theta(1/t)",
        "deps": [
          "def-jacobi-theta-function",
          "thm-gaussian-integral"
        ]
      },
      {
        "id": "thm-theta-mellin-representation-of-completed-zeta",
        "kind": "theorem",
        "title": "The completed zeta function has its Mellin-theta integral representation on Re s greater than 1",
        "deps": [
          "def-riemann-zeta-function",
          "def-jacobi-theta-function",
          "def-euler-gamma-function",
          "thm-tonelli-theorem-for-sigma-finite-product-spaces"
        ]
      },
      {
        "id": "def-completed-riemann-zeta-function",
        "kind": "definition",
        "title": "The completed zeta function Lambda(s)=pi to the minus s over 2 times Gamma(s over 2) times zeta(s)",
        "deps": [
          "def-riemann-zeta-function",
          "def-euler-gamma-function"
        ]
      },
      {
        "id": "thm-riemann-zeta-meromorphic-continuation",
        "kind": "theorem",
        "title": "The Riemann zeta function extends meromorphically to the complex plane with its only pole at 1",
        "deps": [
          "thm-riemann-zeta-continuation-to-the-right-half-plane",
          "thm-jacobi-theta-transformation",
          "thm-theta-mellin-representation-of-completed-zeta",
          "def-completed-riemann-zeta-function"
        ]
      },
      {
        "id": "thm-completed-riemann-zeta-functional-equation",
        "kind": "theorem",
        "title": "The completed zeta function satisfies Lambda(s)=Lambda(1-s)",
        "deps": [
          "def-completed-riemann-zeta-function",
          "thm-jacobi-theta-transformation",
          "thm-theta-mellin-representation-of-completed-zeta",
          "thm-riemann-zeta-meromorphic-continuation"
        ]
      },
      {
        "id": "thm-riemann-zeta-functional-equation",
        "kind": "theorem",
        "title": "The Riemann zeta function satisfies the classical sine-gamma functional equation",
        "deps": [
          "thm-completed-riemann-zeta-functional-equation",
          "thm-euler-reflection-formula",
          "thm-legendre-duplication-formula"
        ]
      },
      {
        "id": "def-riemann-xi-function",
        "kind": "definition",
        "title": "The Riemann xi function xi(s)=one-half s(s-1)Lambda(s)",
        "deps": [
          "def-completed-riemann-zeta-function"
        ]
      },
      {
        "id": "thm-riemann-xi-is-entire-of-order-one",
        "kind": "theorem",
        "title": "The Riemann xi function is entire of order one, real on the real axis, and symmetric under s to 1 minus s",
        "deps": [
          "def-riemann-xi-function",
          "thm-riemann-zeta-meromorphic-continuation",
          "thm-completed-riemann-zeta-functional-equation",
          "thm-stirling-formula-gamma"
        ]
      },
      {
        "id": "thm-riemann-zeta-is-zero-free-on-the-closed-right-half-plane",
        "kind": "theorem",
        "title": "The Riemann zeta function has no zeros on the closed half-plane Re s at least 1, except for its pole at 1",
        "deps": [
          "cor-riemann-zeta-is-zero-free-for-real-part-greater-than-one",
          "thm-riemann-zeta-continuation-to-the-right-half-plane",
          "thm-dirichlet-eta-representation",
          "thm-riemann-zeta-functional-equation"
        ]
      },
      {
        "id": "thm-trivial-zeros-and-critical-strip",
        "kind": "theorem",
        "title": "The only zeros of zeta on the nonpositive real axis are the negative even integers, and every other zero lies in the open critical strip",
        "deps": [
          "thm-riemann-zeta-functional-equation",
          "thm-riemann-zeta-is-zero-free-on-the-closed-right-half-plane"
        ]
      },
      {
        "id": "thm-hadamard-product-for-riemann-xi",
        "kind": "theorem",
        "title": "The Riemann xi function has its genus-one Hadamard product over the nontrivial zeros of zeta",
        "deps": [
          "def-riemann-xi-function",
          "thm-riemann-xi-is-entire-of-order-one",
          "thm-hadamard-factorization-for-finite-order-entire-functions"
        ]
      },
      {
        "id": "def-bernoulli-numbers-by-their-generating-function",
        "kind": "definition",
        "title": "The Bernoulli numbers are defined by the generating series t over exp(t) minus 1",
        "deps": []
      },
      {
        "id": "thm-special-values-of-riemann-zeta-at-integers",
        "kind": "theorem",
        "title": "The Riemann zeta function has the standard Bernoulli special values at the positive even and nonpositive integers",
        "deps": [
          "thm-riemann-zeta-functional-equation",
          "def-bernoulli-numbers-by-their-generating-function",
          "thm-sine-has-its-weierstrass-product"
        ]
      },
      {
        "id": "rem-dirichlet-series-continuation-and-regularized-sums",
        "kind": "remark",
        "title": "The analytic continuation of zeta is not the same object as the defining Dirichlet series outside Re s greater than 1",
        "deps": [
          "thm-riemann-zeta-meromorphic-continuation",
          "thm-special-values-of-riemann-zeta-at-integers"
        ]
      }
    ]
  },
  {
    "order": 346,
    "id": "the-riemann-zeta-function-examples",
    "kind": "B",
    "category": "complex-analysis",
    "title": "The Riemann Zeta Function — Examples",
    "companion": "the-riemann-zeta-function",
    "requires": [
      "the-riemann-zeta-function"
    ],
    "items": [
      {
        "id": "ex-euler-product-numerically-approximates-zeta-at-two",
        "kind": "example",
        "title": "A short Euler-product truncation already numerically approximates zeta at 2",
        "deps": [
          "thm-euler-product-for-riemann-zeta",
          "thm-special-values-of-riemann-zeta-at-integers"
        ]
      },
      {
        "id": "ex-zeta-two-from-the-sine-product",
        "kind": "example",
        "title": "The value zeta(2)=pi squared over 6 follows from the sine product",
        "deps": [
          "thm-special-values-of-riemann-zeta-at-integers",
          "thm-sine-has-its-weierstrass-product"
        ]
      },
      {
        "id": "ex-zeta-zero-equals-minus-one-half",
        "kind": "example",
        "title": "The functional equation gives zeta(0)=-1/2 without substituting into a zero-times-pole expression",
        "deps": [
          "thm-riemann-zeta-functional-equation",
          "thm-riemann-zeta-meromorphic-continuation"
        ]
      },
      {
        "id": "ex-splitting-the-theta-mellin-integral-isolates-the-two-polar-terms",
        "kind": "example",
        "title": "Splitting the theta Mellin integral at 1 isolates the two polar terms of completed zeta",
        "deps": [
          "thm-theta-mellin-representation-of-completed-zeta",
          "thm-completed-riemann-zeta-functional-equation"
        ]
      },
      {
        "id": "ex-zeta-minus-two-vanishes-by-the-sine-factor",
        "kind": "example",
        "title": "The functional equation shows that zeta(-2)=0 through the sine factor",
        "deps": [
          "thm-trivial-zeros-and-critical-strip"
        ]
      },
      {
        "id": "ex-symmetric-finite-zero-products-model-the-xi-hadamard-product",
        "kind": "example",
        "title": "Symmetric finite zero products model the genus-one product for xi",
        "deps": [
          "thm-hadamard-product-for-riemann-xi"
        ]
      },
      {
        "id": "cex-the-eta-series-represents-the-continuation-where-the-dirichlet-series-diverges",
        "kind": "counterexample",
        "title": "The eta series can represent the continued zeta function where the defining Dirichlet series diverges",
        "deps": [
          "thm-dirichlet-eta-representation"
        ]
      },
      {
        "id": "cex-the-harmonic-series-shows-the-defining-series-diverges-at-one",
        "kind": "counterexample",
        "title": "The defining Dirichlet series for zeta diverges at s=1 because it becomes the harmonic series",
        "deps": [
          "def-riemann-zeta-function"
        ]
      },
      {
        "id": "fs-riemann-zeta-is-given-by-its-dirichlet-series-for-all-s-not-one",
        "kind": "false-statement",
        "title": "FALSE: zeta is given by the same Dirichlet series for every complex s other than 1",
        "deps": [
          "cex-the-eta-series-represents-the-continuation-where-the-dirichlet-series-diverges",
          "cex-the-harmonic-series-shows-the-defining-series-diverges-at-one"
        ]
      },
      {
        "id": "fs-zeta-minus-one-is-the-ordinary-sum-one-plus-two-plus-three-and-so-on",
        "kind": "false-statement",
        "title": "FALSE: zeta(-1) is the ordinary sum 1+2+3 and so on",
        "deps": [
          "thm-special-values-of-riemann-zeta-at-integers",
          "rem-dirichlet-series-continuation-and-regularized-sums"
        ]
      },
      {
        "id": "fs-riemann-zeta-is-entire",
        "kind": "false-statement",
        "title": "FALSE: the Riemann zeta function is entire",
        "deps": [
          "thm-riemann-zeta-meromorphic-continuation"
        ]
      },
      {
        "id": "fs-the-functional-equation-alone-characterizes-zeta",
        "kind": "false-statement",
        "title": "FALSE: the classical functional equation alone characterizes the Riemann zeta function",
        "deps": [
          "thm-riemann-zeta-functional-equation"
        ]
      }
    ]
  }
]
