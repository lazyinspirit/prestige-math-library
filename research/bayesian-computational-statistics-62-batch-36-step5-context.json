  "load_bearing": [
    {
      "id": "lem-gaussian-anchored-conditional-quantile-coupling",
      "statement": "For the stated independent bounded-plus-Gaussian sums in dimensions at most four, positive Gaussian covariance fraction gives jointly measurable root and conditional quantile transports with the displayed moderate-region error bounds; the conclusion includes the scalar unequal-variance form and supplied measurable parameters.",
      "used_by": [
        "lem-bounded-vector-log-cubed-gaussian-coupling",
        "lem-heterogeneous-bounded-atom-vector-log-cubed-gaussian-coupling"
      ]
    },
    {
      "id": "lem-adjacent-iid-finite-moment-vector-strong-approximation",
      "statement": "Assume AC. For centered X_i=h(U_i,U_{i+1}) in dimension one or two, with standard-Borel iid seeds and a finite qth moment for q>2, Γ is positive semidefinite and, for every 2<p<q, a preserving extension admits independent Gaussian increments of covariance Γ with maximal partial-sum error o(n^(1/p)) almost surely, including singular Γ.",
      "used_by": [
        "thm-geometrically-ergodic-chain-strong-invariance-principle"
      ]
    },
    {
      "id": "lem-geometric-markov-chain-has-adjacent-iid-split-tours",
      "statement": "Under AC, the stated all-state geometric bound on a nonempty standard-Borel chain and a finite centered observable with stationary vth moment, v>1, give delayed adjacent-iid calendar tours under every initial law, iid exponentially integrable lengths, centered rewards, every envelope moment 1≤q<v, and the full-tour occupation identity.",
      "used_by": [
        "thm-geometrically-ergodic-chain-strong-invariance-principle"
      ]
    },
    {
      "id": "lem-harris-geometric-ergodicity-has-integrable-rate-envelope",
      "statement": "Assuming only AC, invariance, and an everywhere finite measurable common geometric-rate bound on an arbitrary measurable space, there is an everywhere finite measurable geometric envelope integrable under π, possibly at a slower rate.",
      "used_by": [
        "thm-mcmc-clt-sufficient-regimes",
        "lem-zero-variance-geometric-markov-sums-have-strong-rate",
        "thm-geometrically-ergodic-chain-strong-invariance-principle",
        "thm-overlapping-batch-means-strong-consistency"
      ]
    },
    {
      "id": "thm-strong-mixing-clt-with-moment-conditions",
      "statement": "Assume AC. A centered strictly stationary square-integrable real sequence has absolute covariance summability and a CLT with its nonnegative covariance-sum variance under any of the stated bounded/summable-alpha, power-moment/powered-alpha-summability, or exponential-alpha/logarithmic-moment regimes, including zero variance.",
      "used_by": [
        "thm-mcmc-clt-sufficient-regimes",
        "thm-geometrically-ergodic-chain-strong-invariance-principle",
        "thm-overlapping-batch-means-strong-consistency"
      ]
    },
    {
      "id": "lem-obm-consistency-from-strong-brownian-approximation",
      "statement": "Assume AC. The stated preserving-extension approximation |S_k−σB(k)|≤K k^α log k, with σ≥0 and 0<α<1/2, implies almost-sure consistency of the exact OBM estimator under its displayed deterministic batch-rate and summability assumptions, without stationarity or batch monotonicity.",
      "used_by": [
        "thm-overlapping-batch-means-strong-consistency"
      ]
    },
    {
      "id": "lem-zero-variance-geometric-markov-sums-have-strong-rate",
      "statement": "Under the stated stationary exponential strong-mixing bound, finite centered qth moment q>2, and zero covariance sum, maximal partial sums are o(n^(1/p)) almost surely for every 2<p<q. Pointwise all-state total-variation convergence transfers this conclusion to every initial law.",
      "used_by": [
        "thm-overlapping-batch-means-strong-consistency"
      ]
    },
    {
      "id": "thm-poisson-equation-martingale-decomposition-clt",
      "statement": "Assume AC. For the stated stationary Markov chain with ergodic canonical shift, centered f∈L²(π), and L² solution f=g−Pg, the telescoping martingale decomposition gives a CLT with variance E[D_1²], including zero; absolute covariance summability additionally identifies this variance with the covariance sum.",
      "used_by": [
        "ex-poisson-equation-ar1-long-run-variance"
      ]
    }
  ],
