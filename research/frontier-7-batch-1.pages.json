          "lem-coset-membership-and-equality"
        ]
      },
      {
        "id": "ex-three-cycle-quotient-of-s3",
        "kind": "example",
        "title": "The three-cycle subgroup of $\\operatorname{Sym}(\\{1,2,3\\})$ is normal and its quotient has two elements",
        "strategy": "direct",
        "deps": [
          "thm-index-two-subgroup-is-normal",
          "thm-quotient-group-laws",
          "cor-order-of-a-quotient-group",
          "def-symmetric-group",
          "lem-symmetric-group-is-a-group",
          "def-generated-subgroup",
          "def-index"
        ]
      },
      {
        "id": "ex-z-mod-four-as-a-quotient-group",
        "kind": "example",
        "title": "The four cosets of $4\\mathbb Z$ in $(\\mathbb Z,+)$ reproduce addition modulo $4$",
        "strategy": "direct",
        "deps": [
          "prop-integers-modulo-n-as-a-quotient-group",
          "def-integers-modulo-n",
          "def-addition-and-multiplication-modulo-n"
        ]
      },
      {
        "id": "ex-trivial-and-total-quotients",
        "kind": "example",
        "title": "$G/\\{e\\}$ reproduces $G$, while $G/G$ is the one-element quotient group",
        "strategy": "direct",
        "deps": [
          "thm-quotient-group-laws",
          "def-subgroup",
          "def-coset"
        ]
      },
      {
        "id": "ex-center-and-commutator-subgroup-of-an-abelian-group",
        "kind": "example",
        "title": "For an abelian group $G$, $Z(G)=G$ and $[G,G]=\\{e\\}$",
        "strategy": "direct",
        "deps": [
          "def-center-of-a-group",
          "def-commutator-and-commutator-subgroup",
          "def-generated-subgroup",
          "def-group"
        ]
      }
    ]
  },
  {
    "order": 211,
    "id": "eulerian-and-hamiltonian-graphs",
    "kind": "A",
    "category": "combinatorics",
    "title": "Eulerian Circuits, Hamiltonian Cycles and Tournaments",
    "companion": "eulerian-and-hamiltonian-graphs-examples",
    "requires": [
