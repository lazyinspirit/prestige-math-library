        "title": "In an even multigraph or balanced digraph, a trail maximal among unused incident edges returns to its start",
        "strategy": "direct",
        "deps": [
          "def-euler-trail-and-circuit",
          "def-multigraph-and-digraph-degrees-and-connectivity"
