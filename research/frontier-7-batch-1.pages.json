[
  {
    "order": 34,
    "id": "normal-subgroups-and-quotient-groups",
    "kind": "A",
    "category": "abstract-algebra",
    "title": "Normal Subgroups and Quotient Groups",
    "companion": "normal-subgroups-and-quotient-groups-examples",
    "requires": [
      "cosets-and-lagranges-theorem"
    ],
    "items": [
      {
        "id": "def-normal-subgroup",
        "kind": "definition",
        "title": "Normal subgroup: invariance under conjugation",
        "deps": [
          "def-subgroup",
          "def-coset"
        ]
      },
      {
        "id": "thm-normal-subgroup-characterisations",
        "kind": "theorem",
        "title": "Equivalent characterisations of a normal subgroup by conjugates and left and right cosets",
        "strategy": "direct",
        "deps": [
          "def-normal-subgroup",
          "lem-coset-membership-and-equality",
          "lem-group-inverse-laws"
        ]
      },
      {
        "id": "cor-subgroups-of-abelian-groups-are-normal",
        "kind": "corollary",
        "title": "Every subgroup of an abelian group is normal",
        "strategy": "direct",
        "deps": [
          "thm-normal-subgroup-characterisations",
          "def-group"
        ]
      },
      {
        "id": "thm-index-two-subgroup-is-normal",
        "kind": "theorem",
        "title": "Every subgroup of index two is normal",
        "strategy": "direct",
        "deps": [
          "thm-normal-subgroup-characterisations",
          "def-index",
          "lem-coset-partition",
          "lem-left-and-right-cosets-equinumerous",
          "lem-coset-membership-and-equality"
        ]
      },
      {
        "id": "lem-intersection-of-normal-subgroups",
        "kind": "lemma",
        "title": "The intersection of a nonempty family of normal subgroups is normal",
        "strategy": "direct",
        "deps": [
          "lem-intersection-of-subgroups",
          "thm-normal-subgroup-characterisations"
        ]
      },
      {
        "id": "def-normal-closure",
        "kind": "definition",
        "title": "The normal closure of a subset of a group",
        "deps": [
          "lem-intersection-of-normal-subgroups",
          "def-normal-subgroup"
        ]
      },
      {
        "id": "def-center-of-a-group",
        "kind": "definition",
        "title": "The center $Z(G)$ of a group",
        "deps": [
          "def-group"
        ]
      },
      {
        "id": "lem-center-is-normal",
        "kind": "lemma",
        "title": "The center of a group is a normal subgroup",
        "strategy": "direct",
        "deps": [
          "def-center-of-a-group",
          "thm-normal-subgroup-characterisations",
          "def-subgroup"
        ]
      },
      {
        "id": "def-commutator-and-commutator-subgroup",
        "kind": "definition",
        "title": "Commutators $[g,h]=ghg^{-1}h^{-1}$ and the commutator subgroup $[G,G]$",
        "deps": [
          "def-generated-subgroup",
          "lem-group-inverse-laws"
        ]
      },
      {
        "id": "lem-commutator-subgroup-is-normal",
        "kind": "lemma",
        "title": "The commutator subgroup is normal",
        "strategy": "direct",
        "deps": [
          "def-commutator-and-commutator-subgroup",
          "thm-normal-subgroup-characterisations",
          "def-generated-subgroup",
          "def-subgroup"
        ]
      },
      {
        "id": "def-quotient-group",
        "kind": "definition",
        "title": "The quotient group $G/N$ and coset product $(gN)(hN)=ghN$",
        "deps": [
          "def-normal-subgroup",
          "def-index",
          "def-coset"
        ]
      },
      {
        "id": "thm-coset-multiplication-well-defined-iff-normal",
        "kind": "theorem",
        "title": "Coset multiplication $(gH)(hH)=ghH$ is well defined if and only if $H$ is normal",
        "strategy": "direct",
        "deps": [
          "def-quotient-group",
          "thm-normal-subgroup-characterisations",
          "lem-coset-membership-and-equality",
          "def-subgroup"
        ]
      },
      {
        "id": "thm-quotient-group-laws",
        "kind": "theorem",
        "title": "For $N\\mathrel{\\trianglelefteq}G$, the cosets form a group with identity $N$ and inverse $(gN)^{-1}=g^{-1}N$",
        "strategy": "direct",
        "deps": [
          "def-quotient-group",
          "thm-coset-multiplication-well-defined-iff-normal",
          "def-group",
          "lem-group-inverse-laws"
        ]
      },
      {
        "id": "prop-canonical-quotient-map",
        "kind": "proposition",
        "title": "The canonical projection $\\pi:G\\to G/N$, $\\pi(g)=gN$, is a surjective group homomorphism",
        "strategy": "direct",
        "deps": [
          "thm-quotient-group-laws",
          "def-group-homomorphism",
          "def-injection-surjection-bijection",
          "def-coset"
        ]
      },
      {
        "id": "cor-order-of-a-quotient-group",
        "kind": "corollary",
        "title": "$|G/N|=[G:N]$, and for finite $G$ this equals $|G|/|N|$",
        "strategy": "direct",
        "deps": [
          "thm-quotient-group-laws",
          "def-index",
          "thm-lagrange",
          "def-order-in-a-group"
        ]
      },
      {
        "id": "thm-quotient-abelian-iff-contains-commutator-subgroup",
        "kind": "theorem",
        "title": "$G/N$ is abelian if and only if $[G,G]\\subseteq N$",
        "strategy": "direct",
        "deps": [
          "thm-quotient-group-laws",
          "def-commutator-and-commutator-subgroup",
          "def-generated-subgroup",
          "lem-coset-membership-and-equality",
          "def-group"
        ]
      },
      {
        "id": "cor-quotient-of-an-abelian-group-is-abelian",
        "kind": "corollary",
        "title": "Every quotient group of an abelian group is abelian",
        "strategy": "direct",
        "deps": [
          "thm-quotient-group-laws",
          "def-group"
        ]
      },
      {
        "id": "prop-integers-modulo-n-as-a-quotient-group",
        "kind": "proposition",
        "title": "For every $n\\in\\mathbb N$, the congruence-class group $(\\mathbb Z/n,+)$ is the quotient group $(\\mathbb Z,+)/n\\mathbb Z$",
        "strategy": "direct",
        "deps": [
          "thm-quotient-group-laws",
          "cor-subgroups-of-abelian-groups-are-normal",
          "thm-int-comm-ring",
          "def-subgroup",
          "def-congruence-modulo-an-integer",
          "def-integers-modulo-n",
          "def-addition-and-multiplication-modulo-n",
          "thm-integers-modulo-n-basic-algebra"
        ]
      }
    ]
  },
  {
    "order": 35,
    "id": "normal-subgroups-and-quotient-groups-examples",
