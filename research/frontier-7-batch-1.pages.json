        "kind": "theorem",
        "title": "Camion's theorem: every strongly connected tournament on at least three vertices has a directed Hamilton cycle",
        "strategy": "contradiction",
        "deps": [
          "def-tournament",
          "def-directed-walk-trail-path-cycle-and-strong-connectivity",
          "lem-tournament-cycle-insertion",
          "def-finite-cardinality"
        ]
      }
