      },
      {
        "id": "lem-bondy-chvatal-closure-well-defined",
        "kind": "lemma",
        "title": "The Bondy-Chvatal closure is independent of the order of eligible edge additions",
        "strategy": "induction",
        "deps": [
          "def-bondy-chvatal-closure",
          "def-graph-adjacency-incidence-neighbourhood-and-degree",
          "thm-induction-principle",
          "def-finite-cardinality"
        ]
      },
      {
        "id": "thm-bondy-chvatal-closure-theorem",
        "kind": "theorem",
        "title": "A graph is Hamiltonian if and only if its Bondy-Chvatal closure is Hamiltonian",
