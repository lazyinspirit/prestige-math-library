[
  {
    "order": 169,
    "id": "uniform-convergence-of-functions",
    "kind": "A",
    "category": "real-analysis",
    "title": "Sequences and Series of Functions; Uniform Convergence",
    "companion": "uniform-convergence-of-functions-examples",
    "requires": [
      "rn-as-a-normed-space",
      "vector-spaces-and-subspaces",
      "monotone-sequences-and-cauchy-completeness",
      "metric-spaces",
      "completeness-and-uniform-continuity",
      "compactness-in-metric-spaces",
      "series-and-nonnegative-tests",
      "absolute-convergence-and-rearrangement",
      "the-derivative-and-mean-value-theorems",
      "the-riemann-integral",
      "properties-of-the-integral-and-the-working-ftc"
    ],
    "items": [
      {
        "id": "def-pointwise-uniform-and-uniformly-cauchy-convergence",
        "kind": "definition",
        "title": "Pointwise convergence, uniform convergence, and the uniformly Cauchy condition for sequences of real-valued functions",
        "deps": [
          "def-function-space",
          "def-real-limit"
        ]
      },
      {
        "id": "lem-uniform-convergence-implies-pointwise-convergence-real-functions",
        "kind": "lemma",
        "title": "Uniform convergence of real-valued functions implies pointwise convergence",
        "strategy": "direct",
        "deps": [
          "def-pointwise-uniform-and-uniformly-cauchy-convergence"
        ]
      },
      {
        "id": "thm-uniform-cauchy-criterion-real-functions",
        "kind": "theorem",
        "title": "A sequence of real-valued functions converges uniformly if and only if it is uniformly Cauchy",
        "strategy": "direct",
        "deps": [
          "def-pointwise-uniform-and-uniformly-cauchy-convergence",
          "thm-cauchy-criterion-via-lub",
          "lem-of-triangle-inequality"
        ]
      },
      {
        "id": "def-series-of-real-functions",
        "kind": "definition",
        "title": "A series of real-valued functions and its pointwise and uniform convergence through its partial sums",
        "deps": [
          "def-function-space",
          "def-series",
          "def-pointwise-uniform-and-uniformly-cauchy-convergence"
        ]
      },
      {
        "id": "cor-uniform-cauchy-criterion-function-series",
        "kind": "corollary",
        "title": "A series of real-valued functions converges uniformly if and only if its tails are uniformly small",
        "strategy": "direct",
        "deps": [
          "def-series-of-real-functions",
          "thm-uniform-cauchy-criterion-real-functions"
        ]
      },
      {
        "id": "prop-sup-metric-characterises-uniform-convergence-real-functions",
        "kind": "proposition",
        "title": "For bounded real-valued functions, convergence and Cauchyness in the supremum metric are exactly uniform convergence and uniform Cauchyness",
        "strategy": "direct",
        "deps": [
          "def-pointwise-uniform-and-uniformly-cauchy-convergence",
          "lem-sup-metric-is-a-metric",
          "def-metric-convergence",
          "def-cauchy-in-metric"
        ]
      },
      {
        "id": "lem-uniform-limits-linear-combinations",
        "kind": "lemma",
        "title": "Uniform limits respect sums and scalar multiples",
        "strategy": "direct",
        "deps": [
          "def-pointwise-uniform-and-uniformly-cauchy-convergence",
          "lem-of-abs-value",
          "lem-of-triangle-inequality"
        ]
      },
      {
        "id": "lem-uniform-product-limit-under-boundedness",
        "kind": "lemma",
        "title": "Products of uniformly convergent real-valued sequences converge uniformly when both limit functions are bounded",
        "strategy": "direct",
        "deps": [
          "def-pointwise-uniform-and-uniformly-cauchy-convergence",
          "def-bounded-set",
          "lem-of-abs-value",
          "lem-of-triangle-inequality"
        ]
      },
      {
        "id": "thm-uniform-limit-continuous-real-functions",
        "kind": "theorem",
        "title": "The uniform limit of continuous real-valued functions on a metric space is continuous",
        "strategy": "direct",
        "deps": [
          "def-pointwise-uniform-and-uniformly-cauchy-convergence",
          "def-metric-continuity",
          "lem-real-line-is-a-metric-space",
          "lem-of-triangle-inequality"
        ]
      },
      {
        "id": "def-continuous-real-functions-on-a-compact-metric-space",
        "kind": "definition",
        "title": "The space $C(K,\\mathbb{R})$ of continuous real-valued functions on a nonempty compact metric space",
        "deps": [
          "def-function-space",
          "def-metric-continuity",
          "def-metric-compactness",
          "lem-real-line-is-a-metric-space"
        ]
      },
      {
        "id": "lem-continuous-real-function-on-compact-is-bounded",
        "kind": "lemma",
        "title": "Every continuous real-valued function on a compact metric space is bounded",
        "strategy": "direct",
        "deps": [
          "def-continuous-real-functions-on-a-compact-metric-space",
          "thm-continuous-image-of-a-compact-space-is-compact",
          "thm-compact-subset-is-closed-and-bounded"
        ]
      },
      {
        "id": "thm-c-k-complete-in-the-sup-metric",
        "kind": "theorem",
        "title": "$C(K,\\mathbb{R})$ is complete in the supremum metric for every nonempty compact metric space $K$",
        "strategy": "direct",
        "deps": [
          "def-continuous-real-functions-on-a-compact-metric-space",
          "lem-continuous-real-function-on-compact-is-bounded",
          "lem-sup-metric-is-a-metric",
          "prop-sup-metric-characterises-uniform-convergence-real-functions",
          "thm-uniform-cauchy-criterion-real-functions",
          "thm-uniform-limit-continuous-real-functions",
          "def-complete-metric-space"
        ]
      },
      {
        "id": "lem-uniform-integral-error-bound",
        "kind": "lemma",
        "title": "A uniform error bound controls the difference of two Riemann integrals",
        "strategy": "direct",
        "deps": [
          "thm-linearity-of-the-integral",
          "thm-monotonicity-of-the-integral",
          "lem-of-abs-value"
        ]
      },
      {
        "id": "thm-uniform-limit-interchanges-riemann-integration",
        "kind": "theorem",
        "title": "A uniform limit of Riemann-integrable functions is Riemann integrable, and its integral is the limit of their integrals",
        "strategy": "direct",
        "deps": [
          "def-pointwise-uniform-and-uniformly-cauchy-convergence",
          "thm-riemann-criterion",
          "lem-uniform-integral-error-bound",
          "def-darboux-integral"
        ]
      },
      {
        "id": "thm-uniform-derivative-limit-on-a-closed-interval",
        "kind": "theorem",
        "title": "If continuously differentiable functions converge at one point and their derivatives converge uniformly on a closed interval, then the functions converge uniformly to a differentiable function whose derivative is the derivative limit",
        "strategy": "constructive",
        "deps": [
          "def-pointwise-uniform-and-uniformly-cauchy-convergence",
          "thm-uniform-limit-continuous-real-functions",
          "thm-uniform-limit-interchanges-riemann-integration",
          "thm-ftc-first-part",
          "thm-ftc-second-part",
          "def-derivative",
          "lem-uniform-integral-error-bound"
        ]
      },
      {
        "id": "thm-weierstrass-m-test-for-function-series",
        "kind": "theorem",
        "title": "The Weierstrass M-test gives absolute pointwise convergence and uniform convergence of a function series",
        "strategy": "direct",
        "deps": [
          "cor-uniform-cauchy-criterion-function-series",
          "thm-series-cauchy-criterion",
          "thm-direct-comparison-test",
          "lem-of-abs-value"
        ]
      },
      {
        "id": "thm-uniform-dirichlet-test-for-function-series",
        "kind": "theorem",
        "title": "Uniform Dirichlet test: uniformly bounded partial sums times a nonnegative pointwise-decreasing family converging uniformly to zero give a uniformly convergent function series",
        "strategy": "direct",
        "deps": [
          "cor-uniform-cauchy-criterion-function-series",
          "lem-abel-summation-by-parts",
          "def-finite-sum",
          "lem-finite-sum-laws",
          "lem-of-abs-value"
        ]
      },
      {
        "id": "thm-uniform-abel-test-for-function-series",
        "kind": "theorem",
        "title": "Uniform Abel test: a uniformly convergent function series times a uniformly bounded pointwise-monotone family gives a uniformly convergent product series",
        "strategy": "direct",
        "deps": [
          "cor-uniform-cauchy-criterion-function-series",
          "lem-abel-summation-by-parts",
          "def-finite-sum",
          "lem-finite-sum-laws",
          "lem-of-abs-value"
        ]
      },
      {
        "id": "thm-dini-on-a-closed-interval",
        "kind": "theorem",
        "title": "Dini's theorem on a closed interval: monotone pointwise convergence of continuous functions to a continuous limit is uniform",
        "strategy": "direct",
        "deps": [
          "def-pointwise-uniform-and-uniformly-cauchy-convergence",
          "def-continuity-real",
          "thm-algebra-of-function-limits",
          "thm-heine-borel-r",
          "lem-compactness-is-intrinsic",
          "def-metric-compactness",
          "lem-real-line-is-a-metric-space",
          "thm-metric-continuity-characterisations",
          "lem-finite-set-has-max",
          "def-max-min",
          "lem-of-triangle-inequality"
        ]
      },
      {
        "id": "rem-uniform-convergence-agrees-with-the-later-uniform-topology",
        "kind": "remark",
        "title": "Agreement of the quantified real-valued definition with the later uniform-metric and uniform-topology formulations",
        "deps": [
          "def-pointwise-uniform-and-uniformly-cauchy-convergence",
          "prop-sup-metric-characterises-uniform-convergence-real-functions"
        ],
        "forward_refs": [
          "def-topology-of-uniform-convergence",
          "lem-uniform-convergence-in-the-uniform-metric",
          "thm-uniform-limit-theorem",
          "thm-dini"
        ]
      }
    ]
  },
  {
    "order": 170,
    "id": "uniform-convergence-of-functions-examples",
    "kind": "B",
    "category": "real-analysis",
    "title": "Sequences and Series of Functions; Uniform Convergence: Examples and Counterexamples",
    "requires": [
      "uniform-convergence-of-functions"
    ],
    "forwardRefs": [],
    "items": [
      {
        "id": "cex-powers-on-the-unit-interval-converge-pointwise-not-uniformly",
        "kind": "counterexample",
        "title": "$f_k(x)=x^{k+1}$ converges pointwise to the discontinuous endpoint indicator, but not uniformly, on $[0,1]$",
        "strategy": "direct",
        "deps": [
          "def-pointwise-uniform-and-uniformly-cauchy-convergence",
          "thm-dini-on-a-closed-interval",
          "def-integer-power",
          "lem-geometric-sequence-null",
          "def-continuity-real",
          "thm-algebra-of-function-limits"
        ]
      },
      {
        "id": "cex-shrinking-rectangles-have-integral-one",
        "kind": "counterexample",
        "title": "Shrinking rectangles converge pointwise to zero while every integral equals one",
        "strategy": "direct",
        "deps": [
          "def-pointwise-uniform-and-uniformly-cauchy-convergence",
          "def-darboux-integral",
          "thm-additivity-over-subintervals",
          "lem-integral-elementary-bounds",
          "cor-archimedean-reciprocal",
          "def-canonical-natural"
        ]
      },
      {
        "id": "cex-dini-needs-a-compact-domain",
        "kind": "counterexample",
        "title": "Dini's theorem fails on $[0,\\infty)$: $x/(\\iota(k+1)+x)$ decreases pointwise to zero but not uniformly",
        "strategy": "direct",
        "deps": [
          "thm-dini-on-a-closed-interval",
          "def-continuity-real",
          "thm-algebra-of-function-limits",
          "cor-archimedean-reciprocal",
          "def-canonical-natural"
        ]
      },
      {
        "id": "cex-dini-needs-continuous-approximants",
        "kind": "counterexample",
        "title": "Dini's theorem fails for discontinuous approximants: indicators of $(0,1/\\iota(k+1))$ decrease pointwise to zero but not uniformly",
        "strategy": "direct",
        "deps": [
          "thm-dini-on-a-closed-interval",
          "cor-archimedean-reciprocal",
          "def-canonical-natural"
        ]
      },
      {
        "id": "cex-dini-needs-a-continuous-limit",
        "kind": "counterexample",
        "title": "Dini's theorem fails for a discontinuous limit: powers on $[0,1]$ decrease pointwise to the endpoint indicator but not uniformly",
        "strategy": "direct",
        "deps": [
          "thm-dini-on-a-closed-interval",
          "cex-powers-on-the-unit-interval-converge-pointwise-not-uniformly"
        ]
      },
      {
        "id": "cex-dini-needs-monotonicity",
        "kind": "counterexample",
        "title": "Continuous triangular spikes on $[0,1]$ converge pointwise to zero but not uniformly when monotonicity is absent",
        "strategy": "direct",
        "deps": [
          "thm-dini-on-a-closed-interval",
          "def-continuity-real",
          "cor-archimedean-reciprocal",
          "def-canonical-natural"
        ]
      },
      {
        "id": "cex-m-over-m-plus-n-has-noncommuting-iterated-limits",
        "kind": "counterexample",
        "title": "The double sequence $(m+1)/(m+n+2)$ has unequal iterated limits",
        "strategy": "direct",
        "deps": [
          "def-real-limit",
          "thm-algebra-of-limits",
          "cor-archimedean-reciprocal",
          "def-canonical-natural"
        ]
      },
      {
        "id": "cex-uniform-convergence-does-not-control-derivatives",
        "kind": "counterexample",
        "title": "$x/(1+\\iota(k+1)^2x^2)$ converges uniformly to zero on $\\mathbb{R}$ while every derivative at zero equals one",
        "strategy": "direct",
        "deps": [
          "def-pointwise-uniform-and-uniformly-cauchy-convergence",
          "def-derivative",
          "def-canonical-natural",
          "cor-archimedean-reciprocal",
          "lem-of-square-positive",
          "lem-of-abs-value"
        ]
      },
      {
        "id": "cex-uniform-product-limit-needs-boundedness",
        "kind": "counterexample",
        "title": "Uniform convergence of two factor sequences does not force uniform convergence of their products on an unbounded domain",
        "strategy": "direct",
        "deps": [
          "lem-uniform-product-limit-under-boundedness",
          "def-pointwise-uniform-and-uniformly-cauchy-convergence",
          "def-canonical-natural",
          "cor-archimedean-reciprocal"
        ]
      },
      {
        "id": "cex-uniform-derivative-limit-needs-basepoint-convergence",
        "kind": "counterexample",
        "title": "Uniform convergence of the derivatives does not imply convergence of the functions without convergence at one base point",
        "strategy": "direct",
        "deps": [
          "thm-uniform-derivative-limit-on-a-closed-interval",
          "def-derivative",
          "def-canonical-natural",
          "thm-of-archimedean"
        ]
      }
    ]
  }
]
