      "id": "thm-two-piece-pcp-of-proximity",
      "statement": "Rejection probability below eta = 1/800 implies that both external tables are within distance delta0 = 1/100 of the Walsh–Hadamard encodings of one satisfying named pair; it also yields an arity-six assignment tester with rejection ratio 1/1000.",
      "used_by": [
        "def-composition-with-an-assignment-tester",
        "lem-composition-preserves-perfect-completeness",
        "lem-composition-transfers-rejection-ratio",
        "thm-alphabet-reduction-step"
      ]
    },
    {
      "id": "thm-alphabet-reduction-step",
      "statement": "For every finite alphabet of size at least two, the deterministic map to the fixed 66-symbol alphabet preserves value one and has unsatisfaction at least 1/48000 times the input unsatisfaction.",
      "used_by": [
        "def-dinur-pcp-transformation",
        "lem-one-transformation-preserves-satisfiability",
        "lem-one-transformation-amplifies-gap",
        "thm-gap-csp-is-np-hard"
      ]
    },
    {
      "id": "lem-composition-transfers-rejection-ratio",
      "statement": "UNSAT(H) is at least 1/8000 times UNSAT(G), including the proved local robust-distance bound and averaging over the equally padded gadgets.",
      "used_by": [
        "thm-alphabet-reduction-step",
        "lem-alphabet-reduction-controls-size-and-degree"
      ]
    },
    {
      "id": "lem-one-transformation-amplifies-gap",
      "statement": "For the fixed transformation T, UNSAT(T(G)) is at least min(2 UNSAT(G), alpha) for every finite graph over the fixed alphabet.",
      "used_by": [
        "lem-logarithmically-many-iterations-reach-constant-gap",
        "thm-gap-csp-is-np-hard"
      ]
    },
    {
      "id": "lem-logarithmically-many-iterations-reach-constant-gap",
      "statement": "After ceil(log2 m) iterations, every graph with m at least one edge and positive unsatisfaction has unsatisfaction at least alpha; zero-unsatisfaction inputs remain at zero.",
      "used_by": [
        "thm-gap-csp-is-np-hard"
      ]
    },
    {
      "id": "thm-gap-csp-is-np-hard",
      "statement": "Every language in NP has a deterministic polynomial-time reduction to explicit binary graphs over the fixed 66-symbol alphabet, mapping yes instances to value one and no instances to value at most 1 - alpha.",
      "used_by": [
        "thm-pcp-theorem-np-equals-pcp-log-n-o-one"
      ]
    },
    {
      "id": "thm-pcp-theorem-np-equals-pcp-log-n-o-one",
      "statement": "NP equals PCP(log n, O(1)) under the stated shorthand: perfect completeness, constant soundness below one, one fixed polynomial-length proof, logarithmic randomness and constant nonadaptive bit queries.",
      "used_by": []
    },
    {
      "id": "thm-spectral-multiplicity-model-for-separable-abelian-von-neumann-algebras",
      "statement": "A separably acting abelian von Neumann algebra has a spectral multiplicity model for its fixed self-adjoint generator, with measure class and multiplicity unique almost everywhere.",
      "used_by": [
        "ex-multiplicity-two-diagonal-representation"
      ]
    },
    {
      "id": "thm-decomposable-operators-are-the-commutant-of-diagonal-multiplication",
      "statement": "Decomposable operators are exactly the commutant of the diagonal multiplication algebra on the direct integral.",
      "used_by": [
        "thm-spectral-multiplicity-model-for-separable-abelian-von-neumann-algebras",
        "ex-multiplicity-two-diagonal-representation"
      ]
    },
    {
      "id": "thm-direct-integrals-of-measurable-hilbert-fields-are-hilbert-spaces",
      "statement": "The direct integral of a measurable Hilbert field is a Hilbert space under the stated measure and section conventions.",
      "used_by": [
        "thm-measurable-essentially-bounded-operator-fields-act-decomposably",
        "thm-decomposable-operators-are-the-commutant-of-diagonal-multiplication",
        "thm-spectral-multiplicity-model-for-separable-abelian-von-neumann-algebras"
      ]
    },
    {
      "id": "thm-lidskii-for-trace-class-operators",
      "statement": "For a trace-class operator on an arbitrary complex Hilbert space, its trace is the absolutely convergent sum of nonzero eigenvalues counted with algebraic multiplicity.",
      "used_by": [
        "prop-fredholm-determinant-properties-for-trace-class-operators",
        "thm-lidskii-for-trace-class-operators"
      ]
    },
    {
      "id": "prop-fredholm-determinant-properties-for-trace-class-operators",
      "statement": "The trace-class Fredholm determinant is entire, has the stated growth and trace-norm continuity, is multiplicative, and its zeros occur exactly at the noninvertibility points with the stated algebraic multiplicities.",
      "used_by": [
        "thm-lidskii-for-trace-class-operators",
        "ex-diagonal-trace-class-fredholm-determinant",
        "ex-fredholm-determinant-of-a-finite-rank-operator"
      ]
    },
    {
      "id": "lem-blr-testing-supplies-nearby-linear-decoders",
      "statement": "If the BLR rejection probability is below one half, a lexicographically first Fourier maximizer gives a Walsh–Hadamard word at distance at most that rejection probability; below one quarter it is unique.",
      "used_by": [
        "thm-constant-query-exponential-pcp-for-quadratic-equations",
        "thm-two-piece-pcp-of-proximity"
      ]
    },
    {
      "id": "lem-tensor-consistency-test-soundness",
      "statement": "If the decoded tensor differs from the tensor square of the decoded vector, the self-corrected tensor test rejects with probability at least 1/4 - 4 delta_f - 2 delta_g.",
      "used_by": [
        "thm-constant-query-exponential-pcp-for-quadratic-equations",
        "thm-two-piece-pcp-of-proximity"
      ]
    },
    {
      "id": "thm-pcp-error-amplification",
      "statement": "Independent repetition with the same fixed proof raises the acceptance probability to the repetition count's power and multiplies randomness and query bounds by that count.",
