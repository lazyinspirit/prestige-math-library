        },
        "dependency_level": 3
      },
      {
        "id": "thm-z-estimator-asymptotic-linearity-and-normality",
        "kind": "theorem",
        "title": "Asymptotic linearity and normality of iid Z-estimators",
        "statement": "For iid observations, an o_P(n^{-1/2}) estimating-equation root that is consistent, has a nonsingular derivative of P\u03c8_\u03b8 at \u03b8\u2080, finite score covariance, and local stochastic equicontinuity satisfies \u221an(\u03b8\u0302_n\u2212\u03b8\u2080)=\u2212V^{-1}G_n\u03c8_{\u03b8\u2080}+o_P(1)\u21d2N_d(0,V^{-1}\u03a3V^{-T}); AC is assumed through the library multivariate iid CLT.",
        "deps": [
          "def-z-estimator",
          "def-estimator-sequence-in-iid-experiments",
