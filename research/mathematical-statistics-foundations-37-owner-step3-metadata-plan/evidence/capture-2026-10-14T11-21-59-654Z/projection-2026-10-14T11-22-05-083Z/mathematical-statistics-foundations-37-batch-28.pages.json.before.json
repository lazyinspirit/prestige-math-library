            }
          ]
        },
        "dependency_level": 0
      },
      {
        "id": "def-dqm-submodel-through-a-law",
        "kind": "definition",
        "title": "A dominated differentiable-in-quadratic-mean submodel",
        "statement": "For a one-sided path P_t through P=P₀ dominated by a fixed sigma-finite measure μ, define DQM at zero by the L²(μ) expansion √p_t=√p+(t/2)s√p+o(t), with supplied density versions and score s∈L²(P).",
        "deps": [
          "def-dominated-statistical-experiment",
          "def-likelihood-density",
          "thm-radon-nikodym-density-exists-and-is-unique-up-to-almost-everywhere-equality",
          "lem-radon-nikodym-density-of-a-finite-positive-measure-has-a-nonnegative-representative",
          "def-l-p-space-as-a-quotient-by-null-functions",
          "thm-the-l-p-norm-descends-to-the-quotient-and-makes-l-p-a-normed-space",
          "def-axiom-of-choice"
        ],
        "provenance": {
          "statement": "literature-derived",
          "proof": "not-applicable"
        },
        "sources": {
          "references": [
            {
              "title": "A. W. van der Vaart, Semiparametric Statistics, Lecture 1 §1.2, Definition 1.6",
              "url": "https://sites.stat.washington.edu/jaw/COURSES/EPWG/stflour.pdf"
            },
            {
              "title": "Edward H. Kennedy, Semiparametric theory, §4",
              "url": "https://arxiv.org/pdf/1709.06418"
            }
          ]
        },
        "dependency_level": 3
      },
      {
        "id": "thm-mean-zero-square-integrable-space-is-hilbert",
        "kind": "theorem",
        "title": "The mean-zero L² space is a Hilbert space",
        "statement": "Under Countable Choice, L²₀(P) is a closed real linear subspace of L²(P), hence a real Hilbert space.",
        "strategy": "Identify expectation with the inner product against 1, use Cauchy–Schwarz to show its kernel is closed, and inherit completeness from L²(P).",
        "deps": [
          "def-mean-zero-square-integrable-space",
          "def-countable-choice",
          "def-hilbert-space",
          "lem-l-two-with-the-integral-pairing-is-a-hilbert-space",
          "thm-cauchy-schwarz-in-an-inner-product-space"
        ],
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "A. W. van der Vaart, Semiparametric Statistics, Lecture 1 §1.2",
              "url": "https://sites.stat.washington.edu/jaw/COURSES/EPWG/stflour.pdf"
            },
            {
              "title": "Theo Bühler and Dietmar Salamon, Functional Analysis, §§1.3.3 and 5.3.1",
              "url": "https://uomustansiriyah.edu.iq/media/lectures/9/9_2021_09_21!12_02_01_AM.pdf"
            }
          ]
        },
        "proof_strategy": "direct",
        "dependency_level": 1
      },
      {
        "id": "thm-dqm-score-mean-zero",
        "kind": "theorem",
        "title": "A DQM score has mean zero and is unique",
        "statement": "For a DQM path with score s∈L²(P), P s=0; any two scores satisfying the expansion agree P-almost surely.",
        "strategy": "Expand the squared L² norm of the square-root density around √p and use that every p_t is a probability density; subtract two expansions for uniqueness.",
        "deps": [
          "def-dqm-submodel-through-a-law",
          "def-mean-zero-square-integrable-space",
          "def-likelihood-density",
          "thm-radon-nikodym-density-exists-and-is-unique-up-to-almost-everywhere-equality",
          "cor-cauchy-schwarz-inequality-for-l-two",
          "thm-linearity-of-the-lebesgue-integral-on-l-one",
          "def-axiom-of-choice"
        ],
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "A. W. van der Vaart, Semiparametric Statistics, Lecture 1 §1.2, Lemma 1.8",
              "url": "https://sites.stat.washington.edu/jaw/COURSES/EPWG/stflour.pdf"
            },
            {
              "title": "Edward H. Kennedy, Semiparametric theory, §4",
              "url": "https://arxiv.org/pdf/1709.06418"
            }
          ]
        },
        "proof_strategy": "direct",
        "dependency_level": 4
      },
      {
        "id": "def-tangent-set",
        "kind": "definition",
        "title": "Tangent set of a statistical model at a law",
        "statement": "For a model through P and a declared collection of allowed DQM submodels, its tangent set is the set of their unique scores in L²₀(P).",
        "deps": [
          "def-dqm-submodel-through-a-law",
          "thm-dqm-score-mean-zero",
          "def-mean-zero-square-integrable-space"
        ],
        "provenance": {
