            },
            {
              "title": "Edward H. Kennedy, Semiparametric theory, §4",
              "url": "https://arxiv.org/pdf/1709.06418"
            }
          ]
        },
        "dependency_level": 5
      },
      {
        "id": "def-tangent-space",
        "kind": "definition",
        "title": "Closed tangent space",
        "statement": "The tangent space is the norm closure in L²₀(P) of all finite real linear combinations of scores in the tangent set; the tangent set itself need not be linear.",
        "deps": [
          "def-tangent-set",
          "def-mean-zero-square-integrable-space",
          "def-countable-choice",
          "thm-mean-zero-square-integrable-space-is-hilbert"
