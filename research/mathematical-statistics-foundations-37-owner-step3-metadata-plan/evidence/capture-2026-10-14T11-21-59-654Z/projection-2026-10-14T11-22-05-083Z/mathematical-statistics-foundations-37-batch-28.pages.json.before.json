        "dependency_level": 7
      },
      {
        "id": "def-nuisance-tangent-space",
        "kind": "definition",
        "title": "Nuisance tangent space",
        "statement": "For a specified finite-dimensional target functional ψ on a model through P, the nuisance tangent space is the closed linear span of scores of designated DQM submodels with zero right derivative of ψ at P.",
        "deps": [
