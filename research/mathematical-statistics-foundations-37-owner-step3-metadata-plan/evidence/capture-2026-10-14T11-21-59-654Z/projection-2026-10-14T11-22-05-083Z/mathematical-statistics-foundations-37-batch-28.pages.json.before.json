        "provenance": {
          "statement": "literature-derived",
          "proof": "not-applicable"
        },
        "sources": {
          "references": [
            {
              "title": "A. W. van der Vaart, Semiparametric Statistics, Lecture 1 §1.2",
              "url": "https://sites.stat.washington.edu/jaw/COURSES/EPWG/stflour.pdf"
            },
            {
              "title": "Edward H. Kennedy, Semiparametric theory, §4",
              "url": "https://arxiv.org/pdf/1709.06418"
            }
          ]
        },
        "dependency_level": 6
      },
      {
        "id": "thm-tangent-space-is-closed-linear-subspace",
        "kind": "theorem",
        "title": "A tangent space is a closed linear subspace",
        "statement": "For every tangent set in L²₀(P), its closed linear span is a closed linear subspace of the Hilbert space L²₀(P).",
        "strategy": "Show the finite span is linear; prove its norm closure is linear and closed; inherit completeness from the ambient Hilbert space.",
        "deps": [
          "def-tangent-space",
          "def-linear-subspace",
          "def-countable-choice",
