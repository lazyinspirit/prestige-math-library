      {
        "id": "thm-local-asymptotic-minimax-bound",
        "kind": "theorem",
        "title": "Local asymptotic minimax bound",
        "deps": [
          "def-lan-experiment",
          "def-euclidean-inner-product",
          "def-borel-and-lebesgue-measurable-function-on-rn",
          "def-loss-function-and-risk",
