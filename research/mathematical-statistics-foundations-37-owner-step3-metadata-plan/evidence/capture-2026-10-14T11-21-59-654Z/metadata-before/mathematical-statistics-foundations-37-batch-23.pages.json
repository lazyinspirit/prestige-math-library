      {
        "id": "lem-finite-prior-lan-bayes-envelope-convergence",
        "kind": "lemma",
        "title": "Finite-prior Bayes envelopes converge under pointwise LAN",
        "statement": "Assume AC. In a pointwise LAN experiment [[def-lan-experiment]] with $K\\succ0$, fix $h_1,\\ldots,h_s\\in\\mathbb R^d$ and weights $w_i>0$ summing to one. Let $g:\\mathbb R^d\\to[0,M]$ be Lipschitz. The Bayes values for estimating $h$ with loss $g(a-h)$ and this finite prior, allowing all measurable randomized rules, converge to the corresponding Bayes value in the Gaussian shift $Y\\mid h\\sim N_d(h,K^{-1})$. No likelihood-field uniformity or measurable-selection hypothesis is required.",
        "deps": [
          "def-lan-experiment",
          "thm-vector-slutsky",
          "thm-continuous-mapping-theorem",
          "thm-mean-one-likelihood-ratio-limit-implies-contiguity",
