    "items": [
      {
        "id": "def-leapfrog-step-map",
        "kind": "definition",
        "title": "One-step leapfrog map as force and drift shears",
        "deps": [
          "def-jacobian-matrix-and-gradient",
          "thm-cholesky-factorisation-exists-iff-hermitian-positive-definite-and-is-unique"
        ],
        "statement": "For U in C^1(R^d), an SPD mass matrix M, and epsilon > 0, define the kick K_a(q,p)=(q,p-a grad U(q)), drift D_b(q,p)=(q+b M^{-1}p,p), and one-step leapfrog map Phi_epsilon=K_(epsilon/2) composed with D_epsilon composed with K_(epsilon/2). Its L-step map is Phi_epsilon^L; the momentum-flipped proposal map is R composed with Phi_epsilon^L, where R(q,p)=(q,-p).",
        "provenance": {
          "statement": "literature-derived",
          "proof": "not-applicable"
        },
        "sources": {
          "references": [
            {
              "title": "Radford M. Neal, MCMC Using Hamiltonian Dynamics, Handbook of Markov Chain Monte Carlo, Chapter 5",
              "url": "https://sites.stat.columbia.edu/gelman/bayescomputation/Neal2011.pdf"
            },
            {
              "title": "Michael Betancourt, A Conceptual Introduction to Hamiltonian Monte Carlo",
              "url": "https://arxiv.org/pdf/1701.02434"
            }
          ]
        },
        "dependency_level": 0
      },
      {
        "id": "thm-exact-hamiltonian-flow-preserves-energy-and-volume",
        "kind": "theorem",
        "title": "A complete C2 Hamiltonian flow preserves energy and phase volume",
        "deps": [
