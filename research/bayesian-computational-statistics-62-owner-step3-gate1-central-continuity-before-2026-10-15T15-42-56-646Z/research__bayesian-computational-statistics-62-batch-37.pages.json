          "lem-ac-supplies-sequential-choices-for-probability-constructions",
          "thm-cholesky-factorisation-exists-iff-hermitian-positive-definite-and-is-unique",
          "thm-exact-hamiltonian-flow-preserves-energy-and-volume"
        ],
        "statement": "For a finite-dimensional continuously differentiable potential U with 0 < Z_U=integral exp(-U(q))dq < infinity, define pi(q)=exp(-U(q))/Z_U, an SPD mass M, K(p)=p^T M^{-1}p/2, H=U+K, and refreshed p distributed as N_d(0,M), independently of q. Hamilton's equations are qdot=M^{-1}p and pdot=-grad U(q). A finite leapfrog trajectory with momentum flip is Metropolized using min(1,exp(-H(q*,p*)+H(q,p))). Exact-flow properties are asserted only for U in C^2 with a complete Hamiltonian vector field.",
        "provenance": {
          "statement": "literature-derived",
          "proof": "not-applicable"
        },
        "sources": {
          "references": [
            {
              "title": "Radford M. Neal, MCMC Using Hamiltonian Dynamics, Handbook of Markov Chain Monte Carlo, Chapter 5",
              "url": "https://sites.stat.columbia.edu/gelman/bayescomputation/Neal2011.pdf"
            },
            {
              "title": "Michael Betancourt, A Conceptual Introduction to Hamiltonian Monte Carlo",
              "url": "https://arxiv.org/pdf/1701.02434"
            }
          ]
        },
        "dependency_level": 2
      },
      {
        "id": "alg-leapfrog-hamiltonian-monte-carlo",
        "kind": "algorithm",
        "title": "Leapfrog Hamiltonian Monte Carlo",
        "deps": [
          "alg-metropolis-hastings-kernel",
          "def-hamiltonian-monte-carlo",
          "def-leapfrog-step-map"
        ],
        "statement": "Given a current q, U, SPD M, epsilon > 0, and finite integer L >= 1, independently refresh p from N_d(0,M), apply the one-step leapfrog map L times, flip the final momentum, accept the phase-space proposal with probability min(1,exp(-H(q*,p*)+H(q,p))), retain q on rejection, and return the accepted or retained position.",
        "provenance": {
          "statement": "literature-derived",
          "proof": "not-applicable"
        },
        "sources": {
          "references": [
