          "thm-cauchy-schwarz-and-the-euclidean-norm",
          "thm-chain-rule-for-total-derivatives",
          "thm-c-one-change-of-variables-for-nonnegative-lebesgue-measurable-functions",
          "thm-determinant-differential-and-jacobis-formula",
          "thm-determinant-multiplicative",
          "thm-determinant-of-a-triangular-matrix",
          "thm-real-square-matrix-invertible-iff-determinant-nonzero",
          "thm-cholesky-factorisation-exists-iff-hermitian-positive-definite-and-is-unique"
        ],
        "statement": "Assume Countable Choice. For U in C^2 and SPD M, a complete Hamiltonian vector field has a unique global C^1 flow that conserves H and has determinant-one derivative, hence preserves phase volume by change of variables. A globally Lipschitz gradient is a sufficient condition for completeness and the stated Gronwall stability bound.",
        "proof_strategy": "direct",
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-generated"
        },
        "sources": {
