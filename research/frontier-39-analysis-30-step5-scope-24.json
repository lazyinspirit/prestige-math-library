    {
      "obligation": "refuter:24:1",
      "id": "def-associated-graded-variety-of-a-two-sided-ideal",
      "location": "Remark — “Proper ideals and the empty case”",
      "defect": "false-claim",
      "evidence": "The remark says “the ideal I of interest later is proper and nonzero,” but the later associated-variety proposition allows any finite-dimensional complex Lie algebra and any two-sided ideal. Take g=0, so U(g)=C; the simple C-module C has annihilator I=0, which is primitive and proper but not nonzero. No restriction excluding this case is stated.",
      "severity": "fatal",
