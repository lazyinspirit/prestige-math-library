              "url": "https://publish.illinois.edu/ruiloja/files/2023/07/compactfoliations.pdf",
              "locator": "\u00a71, PDF pp. 1\u20132 (linearization form of Reeb stability)"
            }
          ]
        },
        "dependency_level": 9,
