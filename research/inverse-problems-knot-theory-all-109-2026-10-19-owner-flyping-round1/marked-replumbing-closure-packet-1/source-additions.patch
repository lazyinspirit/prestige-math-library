+provenance:
+  statement: ai-altered
+  proof: ai-altered
+sources:
+  references:
+    - title: "Thomas Kindred, A geometric proof of the flyping theorem, Section 2.5 and Proposition2.34, PDF pp.15–16; direct three-dimensional proof for a supplied marked disk-flip model"
+      url: "https://arxiv.org/pdf/2008.06490v3"
+    - title: "C. McA. Gordon and R. A. Litherland, On the Signature of a Link (1978), normal-transfer pairing, printed pp.55–57"
+      url: "https://gdz.sub.uni-goettingen.de/download/pdf/PPN356556735_0047/PPN356556735_0047.pdf"
