        "sources": {
          "references": [
            {
              "title": "Tim D. Cochran, Kent E. Orr, and Peter Teichner, Knot concordance, Whitney towers and L²-signatures, Remark 2.6",
              "url": "https://arxiv.org/pdf/math/9908117"
            },
            {
              "title": "Charles A. Weibel, An Introduction to Homological Algebra, Chapter 3",
              "url": "https://math.mit.edu/~hrm/palestine/weibel/03-tor_and_ext.pdf"
            }
