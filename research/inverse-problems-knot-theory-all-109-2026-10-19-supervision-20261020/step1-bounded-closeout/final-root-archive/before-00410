      {
        "id": "lem-killing-deep-derived-normal-subgroups-preserves-mixed-derived-quotients",
        "kind": "lemma",
        "title": "Deep derived relations preserve finite mixed-coefficient quotients",
        "deps": [],
        "justified_by": [],
        "provenance": {
