        "dependency_level": 4,
        "justified_by": [],
        "statement": "For every smooth oriented knot K with a chosen product tubular neighbourhood N(K) = S^1 x D^2, define its exterior by E_K = S^3 minus int N(K) and its boundary torus by T_K = partial E_K. Let i:T_K -> E_K be inclusion and p:T_K -> S^1 the product projection to the oriented core. Every primitive class c in H_1(T_K; Z) with p_*c = 1 in H_1(S^1; Z) is in ker i_*. Here primitive means that c is not an integer multiple m d of another class with |m|>1.",
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-generated"
        },
        "sources": {
          "references": [
            {
              "title": "Alessia Cattabriga and Stefano Francaviglia, Knot Theory and Applications: Lecture Notes",
              "url": "https://poisson.phc.dm.unipi.it/~camponovo/libri/knot.pdf",
              "locator": "Remark 4.4.4 and the peripheral basis discussion, Section 4.4"
            },
            {
              "title": "Allen Hatcher, Algebraic Topology",
              "url": "https://pi.math.cornell.edu/~hatcher/AT/ATch3.pdf",
              "locator": "Theorem 3.44 and Corollary 3.45, pp. 254-256"
            }
          ]
        },
        "strategy": "Refute the universal claim by the primitive class [lambda]+[mu]; its core projection has degree one, but its exterior image is the nonzero meridian generator."
      }
