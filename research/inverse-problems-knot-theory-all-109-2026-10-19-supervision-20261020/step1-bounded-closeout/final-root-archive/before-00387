        "dependency_level": 0,
        "justified_by": [],
        "statement": "Given a smooth oriented knot K in the standard oriented three-sphere and a chosen closed tubular neighbourhood N(K) obtained from a normal-bundle tubular map, define its exterior E_K to be the three-sphere with the interior of N(K) removed. Retain the boundary torus T_K = partial E_K; orient E_K by restriction of the fixed orientation of the three-sphere. The chosen tube is part of the data.",
        "provenance": {
          "statement": "literature-derived",
          "proof": "not-applicable"
        },
        "sources": {
          "references": [
            {
              "title": "Alessia Cattabriga and Stefano Francaviglia, Knot Theory and Applications: Lecture Notes",
              "url": "https://poisson.phc.dm.unipi.it/~camponovo/libri/knot.pdf",
              "locator": "Section 4.1, compact exterior convention"
            },
            {
              "title": "Allen Hatcher, Algebraic Topology",
              "url": "https://pi.math.cornell.edu/~hatcher/AT/ATch3.pdf",
              "locator": "Theorem 3.44 and Corollary 3.45, pp. 254-256"
            }
          ]
        },
        "strategy": "Definition for a supplied tube; later local lemmas establish existence, compactness, the boundary torus, and tube-independence claims actually used on this page."
      },
      {
        "id": "lem-knot-normal-circle-bundle-trivialization",
        "kind": "lemma",
        "title": "The oriented normal bundle of a knot is trivial",
        "deps": [
