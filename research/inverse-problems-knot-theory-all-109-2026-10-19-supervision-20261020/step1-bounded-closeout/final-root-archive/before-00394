      {
        "id": "lem-link-wirtinger-local-meridian-conjugacy",
        "kind": "lemma",
        "title": "Local meridian conjugacy at a labeled link crossing",
        "deps": [
          "lem-link-wirtinger-crossing-ball-cover",
