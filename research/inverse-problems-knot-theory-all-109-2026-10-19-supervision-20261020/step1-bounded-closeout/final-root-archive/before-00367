    "items": [
      {
        "id": "def-ip-tv-functional-on-l2-distributional-variation",
        "kind": "definition",
        "title": "Distributional TV as an extended functional on L²",
        "deps": [
          "def-ip-spatial-bv-and-distributional-tv",
          "def-calligraphic-l-p-on-a-measure-space",
          "def-real-and-complex-inner-product-space",
          "thm-cauchy-schwarz-in-an-inner-product-space"
        ],
        "statement": "For an open Ω⊂R² and u∈L²(Ω), define TV₂(u;Ω) as the supremum of ∫Ωu div φ over compactly supported smooth vector fields φ with |φ|≤1; this is finite exactly on the L² domain of finite distributional variation and does not require u∈L¹(Ω).",
        "sources": {
          "references": [
            {
              "title": "José A. Iglesias, Gwenael Mercier, and Otmar Scherzer, A note on convergence of solutions of total variation regularized linear inverse problems, §1.1",
              "url": "https://arxiv.org/pdf/1711.06495"
            },
            {
              "title": "Gláucio Terra, Introduction to Geometric Measure Theory — Lecture Notes, version 1.6, §7.4",
              "url": "https://www.ime.usp.br/~glaucio/mat6704/textos/GMTLecureNotes.pdf"
            }
          ]
        },
        "provenance": {
          "statement": "literature-derived",
          "proof": "not-applicable"
        },
        "dependency_level": 2
      },
      {
        "id": "def-ip-tv-level-set-representatives-and-boundaries",
        "kind": "definition",
        "title": "Canonical TV level sets and their boundaries",
        "deps": [
          "def-ip-spatial-bv-and-distributional-tv",
          "def-countable-choice",
          "thm-lebesgue-differentiation-theorem-for-locally-integrable-functions-on-r-n",
          "def-ip-boundary-tv-conventions",
          "def-metric-space"
        ],
        "statement": "For full-space and bounded-domain zero-extension geometry, form E_t={u>t} for t>0 and E_t={u<t} for t<0 in R²; canonical representatives are density-one points and boundaries are ambient topological boundaries, independent of null changes. For Neumann problems zero extension is geometric only; TV remains relative to Ω. Empty boundary pairs have Hausdorff distance zero; exactly one empty boundary gives infinite distance.",
        "sources": {
          "references": [
            {
              "title": "José A. Iglesias, Gwenael Mercier, and Otmar Scherzer, A note on convergence of solutions of total variation regularized linear inverse problems, §3",
              "url": "https://arxiv.org/pdf/1711.06495"
            },
            {
              "title": "Antonin Chambolle, Vincent Duval, Gabriel Peyré, and Clarice Poon, Geometric properties of solutions to the total variation denoising problem, §2.1",
              "url": "https://arxiv.org/pdf/1602.00087"
            }
          ]
        },
        "provenance": {
          "statement": "literature-derived",
          "proof": "not-applicable"
        },
        "dependency_level": 3
      },
      {
        "id": "def-ip-tv-variational-curvature",
        "kind": "definition",
        "title": "Variational curvature of a finite-perimeter set",
        "deps": [
          "def-ip-spatial-bv-and-distributional-tv",
          "def-ip-boundary-tv-conventions"
        ],
        "statement": "For full-space, Dirichlet, or Neumann perimeter, a set has variational curvature κ when it minimizes the model-specific perimeter minus ∫κ over finite-measure finite-perimeter compactly supported perturbations; bounded Dirichlet also admits a separate global obstacle-curvature condition on Ω.",
        "sources": {
          "references": [
            {
              "title": "José A. Iglesias, Gwenael Mercier, and Otmar Scherzer, A note on convergence of solutions of total variation regularized linear inverse problems, Definition 4",
              "url": "https://arxiv.org/pdf/1711.06495"
            },
            {
              "title": "Antonin Chambolle, Vincent Duval, Gabriel Peyré, and Clarice Poon, Geometric properties of solutions to the total variation denoising problem, §2.6",
              "url": "https://arxiv.org/pdf/1602.00087"
            }
          ]
        },
        "provenance": {
          "statement": "literature-derived",
          "proof": "not-applicable"
        },
        "dependency_level": 3
      },
      {
        "id": "lem-ip-tv-l2-finite-variation-has-radon-derivative",
        "kind": "lemma",
        "title": "Finite L² distributional variation has a finite Radon derivative",
        "deps": [
          "def-ip-tv-functional-on-l2-distributional-variation",
          "def-countable-choice",
          "lem-ip-euclidean-radon-representation-under-countable-choice",
          "lem-ip-smooth-compact-support-dense-in-c0",
          "lem-ip-vector-radon-variation-is-radon",
          "def-ip-spatial-bv-and-distributional-tv"
        ],
        "statement": "Assume Countable Choice. If Ω⊂R² is open, u∈L²(Ω), and TV₂(u;Ω)<∞, then Du is a finite vector Radon measure and |Du|(Ω)=TV₂(u;Ω).",
        "sources": {
          "references": [
            {
              "title": "José A. Iglesias, Gwenael Mercier, and Otmar Scherzer, A note on convergence of solutions of total variation regularized linear inverse problems, §1.1",
              "url": "https://arxiv.org/pdf/1711.06495"
            },
            {
              "title": "Gláucio Terra, Introduction to Geometric Measure Theory — Lecture Notes, version 1.6, §7.4",
              "url": "https://www.ime.usp.br/~glaucio/mat6704/textos/GMTLecureNotes.pdf"
            }
          ]
        },
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
        "proof_strategy": "direct",
        "dependency_level": 3
      },
      {
        "id": "lem-ip-tv-l2-functional-properties",
        "kind": "lemma",
        "title": "Convexity, lower semicontinuity, and BV agreement of L² TV",
        "deps": [
          "def-ip-tv-functional-on-l2-distributional-variation",
          "lem-ip-bv-test-field-characterization-and-lsc",
          "thm-cauchy-schwarz-in-an-inner-product-space"
        ],
        "statement": "The extended distributional-TV functional on L² is proper, convex, lower semicontinuous, and positively one-homogeneous; on L²∩BV it agrees with the spatial TV defined from the distributional derivative.",
        "sources": {
          "references": [
            {
              "title": "José A. Iglesias, Gwenael Mercier, and Otmar Scherzer, A note on convergence of solutions of total variation regularized linear inverse problems, §1.1",
              "url": "https://arxiv.org/pdf/1711.06495"
            },
            {
              "title": "Gláucio Terra, Introduction to Geometric Measure Theory — Lecture Notes, version 1.6, §7.4",
