      {
        "id": "lem-ip-neumann-bv-sobolev-poincare",
        "kind": "lemma",
        "title": "BV Sobolev–Poincaré inequality for Neumann TV",
        "deps": [
          "def-countable-choice",
          "def-ip-boundary-tv-conventions",
          "def-ip-spatial-bv-and-distributional-tv",
          "lem-ip-bv-compactness-lower-semicontinuity",
          "lem-ip-bv-extension-and-translation",
          "lem-ip-bv-sobolev-inequality",
          "lem-ip-bv-zero-gradient-constant-on-connected-domain"
        ],
        "statement": "Assume Countable Choice. For every nonempty bounded connected Lipschitz Ω⊂R² there is CΩ<∞ such that every u∈BV(Ω) satisfies ||u−uΩ||L²(Ω)≤CΩ TV(u;Ω), where uΩ is its mean over Ω.",
        "sources": {
          "references": [
            {
              "title": "José A. Iglesias, Gwenael Mercier, and Otmar Scherzer, A note on convergence of solutions of total variation regularized linear inverse problems, §4.3",
