      {
        "id": "lem-ip-tv-dual-attainment-and-certificate-limit",
        "kind": "lemma",
        "title": "Dual attainment and convergence of TV source certificates",
        "deps": [
          "def-ip-tv-dual-source-certificate",
          "def-ip-bregman-distance",
          "def-ip-spatial-bv-and-distributional-tv",
          "def-ip-boundary-tv-conventions",
          "def-ip-banach-convex-subgradient-and-dual-pairing",
          "def-ip-variational-source-condition",
          "lem-ip-banach-fenchel-duality-for-regularization",
          "thm-ip-vsc-nonlinear-regularization-rate",
          "def-countable-choice",
          "def-real-and-complex-inner-product-space",
          "thm-cauchy-schwarz-in-an-inner-product-space",
          "thm-bolzano-weierstrass",
          "thm-riesz-representation-for-hilbert-space"
        ],
        "statement": "Under the Hilbert-space TV source condition, the quadratic dual problem has a unique maximizer for each positive regularization parameter, exact-data dual maximizers converge strongly to the minimum-norm limit certificate, and noisy dual fields differ by at most ||w||/α (and their adjoint images by at most ||A*||||w||/α). Each supplied primal minimizer satisfies the stated extremality relations and correctly normalized value identity.",
        "sources": {
          "references": [
            {
              "title": "José A. Iglesias, Gwenael Mercier, and Otmar Scherzer, A note on convergence of solutions of total variation regularized linear inverse problems, Theorem 1, Proposition 3, and their complete proofs",
              "url": "https://arxiv.org/pdf/1711.06495"
            },
            {
              "title": "Barbara Kaltenbacher, Convergence rates under a range invariance condition with application to electrical impedance tomography, Theorem 3 and complete proof",
              "url": "https://arxiv.org/pdf/2403.18704"
            },
            {
              "title": "Jonathan M. Borwein and Jon D. Vanderwerff, Convex Functions: Constructions, Characterizations and Counterexamples, Proposition 4.4.1(a)",
              "url": "https://carmamaths.org/jon/Preprints/Books/CUP/cup-final.pdf"
            }
          ]
        },
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
        "proof_strategy": "direct",
        "dependency_level": 5
      },
      {
        "id": "lem-ip-tv-l2-coarea-formula",
        "kind": "lemma",
        "title": "Coarea for finite-variation L² functions",
        "deps": [
          "def-ip-tv-functional-on-l2-distributional-variation",
          "lem-ip-bv-coarea-formula",
          "lem-ip-bv-test-field-characterization-and-lsc",
          "def-countable-choice",
          "thm-tonelli-theorem-for-sigma-finite-product-spaces",
          "thm-tonelli-and-fubini-for-completed-product-measures",
          "thm-fatou-lemma",
          "thm-monotone-convergence-for-the-integral",
          "lem-ip-tv-l2-cutoff-approximation"
        ],
        "statement": "Assume Countable Choice. For u∈L²(R²) with TV₂(u;R²)<∞, its nonzero superlevel and sublevel sets have finite measure, have finite perimeter for almost every level, and their perimeter integrals over positive and negative levels sum to TV₂(u;R²).",
        "sources": {
          "references": [
            {
              "title": "José A. Iglesias, Gwenael Mercier, and Otmar Scherzer, A note on convergence of solutions of total variation regularized linear inverse problems, §3.1",
              "url": "https://arxiv.org/pdf/1711.06495"
