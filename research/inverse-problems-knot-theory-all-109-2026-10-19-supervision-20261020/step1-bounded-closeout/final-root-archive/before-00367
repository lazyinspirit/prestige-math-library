        "proof_strategy": "direct",
        "dependency_level": 3
      },
      {
        "id": "def-ip-tv-dual-source-certificate",
        "kind": "definition",
        "title": "Dual source certificates for TV regularization",
        "deps": [
          "def-ip-spatial-bv-and-distributional-tv",
          "def-ip-boundary-tv-conventions",
          "def-ip-banach-convex-subgradient-and-dual-pairing",
          "def-ip-bregman-distance",
          "def-calligraphic-l-p-on-a-measure-space",
          "def-l-p-space-as-a-quotient-by-null-functions",
          "def-real-and-complex-inner-product-space",
          "thm-riesz-representation-for-hilbert-space",
          "def-ip-tv-functional-on-l2-distributional-variation",
          "lem-ip-tv-l2-functional-properties"
        ],
        "statement": "For bounded real-linear A between real L² spaces and a selected full-space, Dirichlet, or Neumann TV functional R, an exact minimum-TV truth u† has a dual source certificate p† when A*p†∈∂R(u†); in the full-space branch R is the extended local-distributional TV on L² and vector subgradients use the Riesz identification.",
        "sources": {
          "references": [
            {
              "title": "José A. Iglesias, Gwenael Mercier, and Otmar Scherzer, A note on convergence of solutions of total variation regularized linear inverse problems, Definition 1 and Theorem 1",
              "url": "https://arxiv.org/pdf/1711.06495"
            },
            {
              "title": "Antonin Chambolle, Vincent Duval, Gabriel Peyré, and Clarice Poon, Geometric properties of solutions to the total variation denoising problem, §§1.3 and 3.1",
              "url": "https://arxiv.org/pdf/1602.00087"
            },
            {
              "title": "Barbara Kaltenbacher, Convergence rates under a range invariance condition with application to electrical impedance tomography, Definition (1.25)",
              "url": "https://arxiv.org/pdf/2403.18704"
            }
          ]
        },
        "provenance": {
          "statement": "literature-derived",
          "proof": "not-applicable"
        },
        "dependency_level": 4
      },
      {
        "id": "lem-ip-planar-isoperimetric-inequality-for-finite-perimeter-sets",
        "kind": "lemma",
        "title": "Sharp planar isoperimetric inequality for finite-perimeter sets",
        "deps": [
          "def-ip-spatial-bv-and-distributional-tv",
          "lem-ip-bv-smooth-coarea",
          "lem-ip-bv-strict-approximation",
          "lem-ip-bv-test-field-characterization-and-lsc",
          "def-countable-choice",
          "thm-morse-sard-for-euclidean-maps",
          "lem-a-compact-connected-one-dimensional-manifold-without-boundary-is-a-circle",
          "cor-greens-theorem-from-general-stokes",
          "thm-parseval-identity-for-fourier-series",
          "lem-ip-vector-radon-variation-is-radon"
        ],
        "statement": "Every finite-measure set E⊂R² of finite perimeter satisfies 4π|E|≤P(E;R²)².",
        "sources": {
          "references": [
            {
              "title": "José A. Iglesias, Gwenael Mercier, and Otmar Scherzer, A note on convergence of solutions of total variation regularized linear inverse problems, §3.4",
              "url": "https://arxiv.org/pdf/1711.06495"
            },
            {
              "title": "Gláucio Terra, Introduction to Geometric Measure Theory — Lecture Notes, version 1.6, §7.6",
              "url": "https://www.ime.usp.br/~glaucio/mat6704/textos/GMTLecureNotes.pdf"
