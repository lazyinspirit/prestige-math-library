            {
              "title": "Gláucio Terra, Introduction to Geometric Measure Theory — Lecture Notes, version 1.6, §5.3",
              "url": "https://www.ime.usp.br/~glaucio/mat6704/textos/GMTLecureNotes.pdf"
            }
          ]
        },
        "provenance": {
