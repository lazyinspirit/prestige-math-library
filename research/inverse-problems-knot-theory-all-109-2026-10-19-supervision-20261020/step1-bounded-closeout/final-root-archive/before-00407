      {
        "id": "def-bounding-chain-torsion-linking-pairing",
        "kind": "definition",
        "title": "Bounding-chain expression for a torsion linking pairing",
        "deps": [],
        "dependency_level": 0,
        "justified_by": [],
        "statement": "Let $Y$ be a closed oriented $3$-manifold and let $x,y\\in\\operatorname{Tor}H_1(Y;\\mathbb Z)$. For choices of an integer $n>0$ and an integral $2$-chain $C$ with $\\partial C=nx$, the bounding-chain expression is $(C\\cdot y)/n\\bmod\\mathbb Z\\in\\mathbb Q/\\mathbb Z$, where $C$ and $y$ are placed transversely and intersection signs use the orientation of $Y$. This expression is the torsion linking pairing when its independence of the choices is established.",
        "provenance": {
          "statement": "literature-derived",
          "proof": "not-applicable"
        },
        "strategy": "direct"
      },
      {
        "id": "def-finite-linking-form-and-metabolizer",
        "kind": "definition",
        "title": "Finite nonsingular linking forms and metabolizers",
        "deps": [],
        "dependency_level": 0,
        "justified_by": [],
        "statement": "A finite nonsingular linking form is a pair $(A,\\lambda)$, where $A$ is a finite abelian group and $\\lambda:A\\times A\\to\\mathbb Q/\\mathbb Z$ is symmetric and induces an isomorphism $A\\to\\operatorname{Hom}(A,\\mathbb Q/\\mathbb Z)$. For $P\\le A$, put $P^\\perp=\\{a\\in A:\\lambda(a,p)=0\\text{ for every }p\\in P\\}$. A metabolizer is a subgroup $P$ with $P=P^\\perp$; equivalently, $\\lambda$ vanishes on $P\\times P$ and $|P|^2=|A|$.",
        "provenance": {
          "statement": "literature-derived",
          "proof": "not-applicable"
        },
        "strategy": "direct"
      },
      {
        "id": "def-oriented-bordism-group-of-a-space",
        "kind": "definition",
        "title": "Oriented bordism groups of maps to a space",
        "deps": [],
        "dependency_level": 0,
        "justified_by": [],
        "statement": "Let $X$ be a path-connected CW space. The oriented bordism set $\\Omega_n^{SO}(X)$ consists of classes of pairs $(M,f)$, where $M$ is a closed smooth oriented $n$-manifold and $f:M\\to X$. Two pairs are bordant when there is a compact oriented $(n+1)$-manifold $W$ with $\\partial W=M_0\\sqcup(-M_1)$ and a map $F:W\\to X$ restricting to $f_0$ and $f_1$ on the boundary. Disjoint union defines the operation. For a group $G$, $K(G,1)$ denotes a connected CW space with fundamental group $G$ and contractible universal cover.",
        "provenance": {
          "statement": "literature-derived",
          "proof": "not-applicable"
        },
        "strategy": "not-applicable"
      },
      {
        "id": "def-poly-torsion-free-abelian-group",
        "kind": "definition",
        "title": "Poly-torsion-free abelian groups",
        "deps": [
          "def-group-ring"
        ],
        "justified_by": [],
        "dependency_level": 0,
        "statement": "A group G is poly-torsion-free abelian (PTFA) if it admits a finite subnormal series\n1=G_0 ◁ G_1 ◁ ⋯ ◁ G_m=G\nin which every quotient G_{j+1}/G_j is torsion-free abelian. The trivial group is PTFA, using the length-zero series. The term “subnormal” means each G_j is normal in G_{j+1}; normality in all of G is not required.",
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-generated"
        },
        "sources": {
          "scraped": [],
          "references": [
            {
              "title": "Tim D. Cochran, Kent E. Orr, and Peter Teichner, “Knot concordance, Whitney towers and L²-signatures”",
              "url": "https://arxiv.org/pdf/math/9908117",
              "locator": "§2.1, PTFA group definition"
            }
          ]
        },
        "proof_strategy": "direct"
      },
      {
        "id": "lem-choice-free-local-coefficient-duality-on-a-coordinate-ball",
        "kind": "lemma",
        "title": "Local-coefficient cap duality on a coordinate ball without choice",
        "deps": [
          "def-compactly-supported-cohomology-with-local-coefficients",
          "def-cup-and-cap-products-with-local-coefficient-pairings",
          "lem-canonical-twisted-fundamental-classes-over-compact-subsets",
          "thm-excision-and-mayer-vietoris-with-local-coefficients",
          "thm-pair-long-exact-sequences-with-local-coefficients"
        ],
        "justified_by": [],
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-generated"
        },
        "sources": {
          "references": [
            {
              "title": "Hatcher, Algebraic Topology, local calculation in Poincare duality and local coefficients",
              "url": "https://pi.math.cornell.edu/~hatcher/AT/AT.pdf"
            }
          ]
        },
        "statement": "Let $B$ be an oriented coordinate ball of dimension $n\\ge0$ and let $\\mathcal L$ be a local system of abelian groups on $B$. Cap with the integral support orientation classes gives isomorphisms\n$$H_c^k(B;\\mathcal L)\\xrightarrow{\\sim}H_{n-k}(B;\\mathcal L)$$\nin every integer degree. Under a coordinate contraction trivialization with fiber $A$, both sides are $A$ for $k=n$ and zero otherwise, and the displayed nonzero map is the identity on $A$. No choice principle is assumed; any commuting coefficient-ring action is respected.",
        "proof_strategy": "direct",
        "dependency_level": 0
      },
      {
        "id": "lem-choice-free-wall-chain-finiteness-from-explicit-domination",
        "kind": "lemma",
        "title": "Choice-free Wall chain finiteness from an explicit finite domination",
        "deps": [
          "def-chain-map",
          "def-chain-homotopy",
          "def-chain-homotopy-equivalence",
          "def-projective-module",
          "lem-finite-choice"
        ],
        "justified_by": [],
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "Andrew Ranicki, The algebraic theory of finiteness obstruction, Math. Scand. 57 (1985), 105–126",
              "url": "https://www.maths.ed.ac.uk/~v1ranick/papers/finite.pdf",
              "locator": "Section 3, Proposition 3.1, printed pp.118–121; all block and homotopy identities needed here are proved below with a fixed sign convention"
            },
            {
              "title": "Steve Ferry and Andrew Ranicki, A survey of Wall's finiteness obstruction",
              "url": "https://www.maths.ed.ac.uk/~v1ranick/papers/ferran.pdf",
              "locator": "Sections 1–3; the distinction between finite domination, finite projective chains and finite CW type"
            },
            {
              "title": "Allen Hatcher, Algebraic Topology",
              "url": "https://pi.math.cornell.edu/~hatcher/AT/AT.pdf",
              "locator": "Appendix A, printed pp.525–529, especially A.8–A.11; topological context only"
            }
          ]
        },
        "proof_strategy": "direct",
        "statement": "Work in ZF. Let $A$ be any associative unital ring and let $C$ be a chain complex of unital right $A$-modules with $C_n=0$ for $n<0$. Supply a chain complex $F$ with $F_n=0$ outside $0\\le n\\le m$, each $F_n$ supplied as a finite free right $A$-module, chain maps $f:C\\to F$ and $g:F\\to C$, and right $A$-linear maps $h_n:C_n\\to C_{n+1}$ such that\n$$1_C-gf=d_Ch+hd_C.$$\nThen there is a chain complex $E$ of finitely generated projective right $A$-modules, zero outside $0\\le n\\le N$ for some finite $N$, together with explicitly constructed chain maps $a:C\\to E$, $b:E\\to C$ and chain homotopies\n$$1_C-ba=dH+Hd,\\qquad 1_E-ab=dL+Ld.$$\nThe modules of $E$ below its top degree can be taken finite free, and its top module is the image of an explicit idempotent on $\\bigoplus_{j=0}^mF_j$.\n\nNeither freeness nor projectivity nor finite generation of the modules of $C$ is required. Thus the result applies in particular to the nonnegative singular or cellular free chain complexes with specified bases. More generally it applies after reindexing whenever $C$ and $F$ have a common finite lower bound. It makes no assertion for inputs unbounded below and no assertion that $E$ is finite free or that any underlying space has finite CW type. No form of the Axiom of Choice is assumed.",
        "dependency_level": 0
      },
      {
        "id": "lem-compact-connected-manifold-fundamental-group-has-finite-generators-in-zf",
        "kind": "lemma",
        "title": "Compact manifold fundamental groups have finite generators without choice",
        "deps": [],
        "justified_by": [],
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-generated"
        },
        "sources": {
          "references": [
            {
              "title": "Hatcher, Algebraic Topology, fundamental groups and finite graph generators",
              "url": "https://pi.math.cornell.edu/~hatcher/AT/AT.pdf"
            }
          ]
        },
        "statement": "Let $M$ be a compact connected Hausdorff topological manifold and $o\\in M$. There is a finite based graph mapped continuously into $M$ such that its induced fundamental-group map is onto. Consequently $\\pi_1(M,o)$ has a finite generating list, without a choice principle. No triangulation or smooth structure on $M$ is assumed.",
        "proof_strategy": "direct",
        "dependency_level": 0
      },
      {
        "id": "lem-compact-manifold-twisted-singular-chains-admit-one-vertex-reduction",
        "kind": "lemma",
        "title": "A compact manifold's twisted singular chains admit a one-vertex reduction without choice",
        "deps": [
          "def-singular-and-cellular-chain-complexes-with-local-coefficients"
        ],
        "justified_by": [],
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-generated"
        },
        "sources": {
          "references": [
            {
              "title": "Hatcher, Algebraic Topology, singular chains and local coefficients, Chapters2 and3.H",
              "url": "https://pi.math.cornell.edu/~hatcher/AT/AT.pdf"
            }
          ]
        },
        "statement": "Let $M$ be a compact connected Hausdorff manifold, $o\\in M$, and $R$ a unital ring. One can construct paths $\\gamma_x$ from $o$ to every $x\\in M$, with $\\gamma_o$ constant, by fixed rules from one finite atlas and finitely many connecting paths. Let $\\mathcal R$ be a right-$R$ local system with a supplied identification $\\mathcal R_o=R$ and transport given by left multiplication by units, with monodromy image $H\\le R^\\times$. Its twisted singular complex has an explicit chain decomposition $C_*(M;\\mathcal R)=C'_*\\oplus Q_*$ after a change of free bases, where $C'_0=R$, $C'_* $ is free, and $Q_*$ is contractible with its only nonzero differential an identity from degree one to degree zero. Moreover\n$$\\operatorname{im}(d'_1)=\\sum_{h\\in H}(h-1)R.$$\nThe decomposition and its dual cochain homotopy equivalences require no choice principle. In particular this image is principal if $H$ is cyclic, if it equals $R$, or if every right ideal of $R$ is principal.",
        "proof_strategy": "direct",
        "dependency_level": 0
      },
      {
        "id": "lem-compact-support-local-coefficient-mayer-vietoris-and-cap-ladder",
        "kind": "lemma",
        "title": "Compact-support local Mayer–Vietoris and its cap ladder without choice",
        "deps": [
          "def-compactly-supported-cohomology-with-local-coefficients",
          "def-cup-and-cap-products-with-local-coefficient-pairings",
          "lem-canonical-twisted-fundamental-classes-over-compact-subsets",
          "thm-excision-and-mayer-vietoris-with-local-coefficients"
        ],
        "justified_by": [],
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-generated"
        },
        "sources": {
          "references": [
            {
              "title": "Hatcher, Algebraic Topology, proof of Poincare duality and local coefficients, Chapters 3.3 and 3.H",
              "url": "https://pi.math.cornell.edu/~hatcher/AT/AT.pdf"
            }
          ]
        },
        "statement": "Let $X$ be a Hausdorff manifold, $X=U\\cup V$ an open cover, and $\\mathcal L$ a local system of abelian groups. There is a natural exact sequence\n$$\\cdots\\to H_c^p(U\\cap V;\\mathcal L)\\to H_c^p(U;\\mathcal L)\\oplus H_c^p(V;\\mathcal L)\\to H_c^p(X;\\mathcal L)\\to H_c^{p+1}(U\\cap V;\\mathcal L)\\to\\cdots.$$\nThe maps into the union are extension maps obtained by excision. If $X$ is oriented of dimension $n$, cap with its compatible integral compact-support orientation classes compares this sequence with homology Mayer–Vietoris in degrees $n-p$. The ladder commutes when the homology connecting map leaving degree $n-p$ is multiplied by $(-1)^{p+1}$. No choice principle is assumed. All maps respect a coefficient-ring action commuting with the local transports.",
        "proof_strategy": "direct",
        "dependency_level": 0
      },
      {
        "id": "lem-finite-order-smooth-line-bundles-have-torsion-reduced-bundle-class",
        "kind": "lemma",
        "title": "Finite-order smooth line bundles have torsion reduced bundle class",
        "deps": [
          "def-axiom-of-choice"
        ],
        "justified_by": [],
        "statement": "Let $X$ be a compact smooth manifold and $L\\to X$ a smooth complex line bundle with a specified isomorphism $L^{\\otimes d}\\cong\\mathbf1$ for a positive integer $d$. Let $K^0_{\\mathrm{sm}}(X)$ denote the Grothendieck ring of finite-rank smooth complex vector bundles, with direct sum as addition, tensor product as multiplication and the trivial complex line as unit. Then $[L]-1$ is torsion in its additive group. Explicitly, a finite construction gives an integer $m\\ge1$ for which\n$$(1-[L])^m=0,\\qquad d^{m-1}([L]-1)=0.$$\nConsequently every additive homomorphism $I:K^0_{\\mathrm{sm}}(X)\\to\\mathbb Z$ satisfies $I([L])=I(1)$. No stable triviality of $L$, rational characteristic-class formula or index theorem is assumed.",
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-generated"
        },
        "sources": {
          "references": [
            {
              "title": "Michael Atiyah, K-Theory",
              "locator": "Grothendieck group of vector bundles, tensor products and exterior powers; the finite nilpotence and torsion calculation needed here is proved in full rather than imported."
            }
          ]
        },
        "proof_strategy": "direct",
        "dependency_level": 0
      },
      {
        "id": "lem-finite-von-neumann-module-dimension-and-dense-quotients",
        "kind": "lemma",
        "title": "Finite von Neumann modules, Hilbert closures, and dimension-zero quotients",
        "deps": [
          "def-axiom-of-choice",
          "def-tracial-state-and-faithful-normal-trace-on-a-von-neumann-algebra",
          "thm-double-commutant-theorem-for-concrete-von-neumann-algebras",
          "thm-spectral-theorem-for-bounded-normal-operators-pvm-form",
          "thm-polar-decomposition-for-bounded-operators"
        ],
        "justified_by": [],
        "statement": "Assume AC. Let $G$ be a discrete group, let $A=\\mathcal N G\\subseteq\\mathcal B(\\ell^2(G))$ have its canonical faithful normal trace $\\tau$, and give matrices the unnormalized trace $\\tau_r((a_{ij}))=\\sum_{i=1}^r\\tau(a_{ii})$. For a projection $p\\in M_r(A)$ put $\\dim_A(pA^r)=\\tau_r(p)$; for any right $A$-module take the supremum of dimensions of its finitely generated projective submodules. These dimensions are independent of the projective representation. If $L\\subseteq pA^r$ is any submodule and $q$ is the projection onto its Hilbert closure in $p\\ell^2(G)^r$, then $q\\in M_r(A)$, $q\\le p$, and\n$$\\dim_A L=\\tau_r(q),\\qquad \\dim_A(pA^r/L)=\\tau_r(p)-\\tau_r(q).$$\nIn particular a Hilbert-dense submodule has dimension-zero quotient. Modules of dimension zero are closed under submodules, quotients, extensions and filtered colimits. For any matrix $B\\in M_{r,s}(A)$, its kernel and Hilbert-closed image are projection modules, its algebraic image is isomorphic to its support projection module, and\n$$\\tau_s(P_{\\ker B})+\\tau_r(P_{\\overline{\\operatorname{im}B}})=s.$$",
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "Jae Choon Cha and Kent E. Orr, L2-signatures, homology localization, and amenable groups",
              "url": "https://arxiv.org/pdf/0910.3700",
              "locator": "Section 6.1, dimension convention and properties; their cited dimension machinery is proved here in the finite-module form needed locally."
            }
          ]
        },
        "proof_strategy": "direct",
        "dependency_level": 0
      },
      {
        "id": "lem-finitely-generated-torsion-free-abelian-freeness-without-choice",
        "kind": "lemma",
        "title": "Finite torsion-free abelian freeness by explicit rational coordinates without choice",
        "deps": [
          "def-group",
          "def-vector-space",
          "thm-rat-field",
          "lem-subgroups-of-z-are-cyclic"
        ],
        "justified_by": [],
        "proof_strategy": "direct",
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "C. Löh, Geometric Group Theory: An Introduction, finitely generated abelian groups",
              "url": "https://loeh.app.uni-regensburg.de/teaching/ggt_ws1415/lecture_notes_old.pdf"
            },
            {
              "title": "Keith Conrad, Modules over a PID",
              "url": "https://kconrad.math.uconn.edu/blurbs/linmultialg/modulesoverPID.pdf"
            }
          ]
        },
        "statement": "Every finitely generated torsion-free abelian group $A$ is isomorphic to $\\mathbb Z^r$ for some finite integer $r\\ge0$. Here torsion-free means $na=0$ with $n\\in\\mathbb Z\\setminus\\{0\\}$ implies $a=0$. More precisely, a fixed finite generating list yields an embedding of $A$ into a finite-rank integer lattice, and every subgroup of $\\mathbb Z^r$ has a basis of at most $r$ elements. These conclusions require no form of the Axiom of Choice and no general PID factorization or structure theorem.",
        "dependency_level": 0
      },
      {
        "id": "lem-folner-group-ring-domains-have-ore-fractions",
        "kind": "lemma",
        "title": "Finite Folner sets give both Ore conditions and a constructed skew field of fractions",
        "deps": [
          "def-group-ring",
          "thm-group-ring-is-a-unital-algebra-with-basis-g",
          "def-folner-set-and-folner-condition",
          "def-ring",
          "def-division-ring",
          "thm-rank-nullity"
        ],
        "justified_by": [],
        "proof_strategy": "direct",
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "Tim D. Cochran, Kent E. Orr, and Peter Teichner, Knot concordance, Whitney towers and L²-signatures, §2.1",
              "url": "https://arxiv.org/pdf/math/9908117"
            },
            {
              "title": "C. Löh, Geometric Group Theory: An Introduction",
              "url": "https://loeh.app.uni-regensburg.de/teaching/ggt_ws1415/lecture_notes_old.pdf"
            }
          ]
        },
        "statement": "Let $k$ be a commutative field and let $G$ satisfy the finite left Folner condition. If $k[G]$ has no zero divisors, then it satisfies both Ore conditions: for nonzero $a,b\\in k[G]$ there exist nonzero $x,y$ with $ax=by$, and nonzero $u,v$ with $ua=vb$. Moreover it embeds as a unital subring in a division ring $D$ in which each element has the form $as^{-1}$ for $a\\in k[G]$ and $0\\ne s\\in k[G]$. Thus this is a skew field of fractions, rather than only a ring in which some denominators are invertible. The construction uses no choice axiom.",
        "dependency_level": 0
      },
      {
        "id": "thm-compact-manifolds-are-retracts-of-finite-polyhedra-without-choice",
        "kind": "theorem",
        "title": "Compact manifolds are retracts of finite polyhedra without choice",
        "deps": [
          "def-cw-complex-with-closure-finiteness-and-weak-topology"
        ],
        "justified_by": [],
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-generated"
        },
        "sources": {
          "references": [
            {
              "title": "Hatcher, Algebraic Topology, Appendix",
              "url": "https://pi.math.cornell.edu/~hatcher/AT/ATapp.pdf",
              "locator": "Neighborhood retracts and finite domination"
            }
          ]
        },
        "statement": "Every compact Hausdorff topological manifold $M$, with boundary allowed, admits an embedding $e:M\\hookrightarrow\\mathbb R^N$, an open neighborhood $U$ of $e(M)$ and a retraction $r:U\\to e(M)$. Moreover there is a finite Euclidean cubical complex $L$ with $e(M)\\subseteq L\\subseteq U$, so that $r|_L$ makes $M$ an actual retract of a finite CW complex. No choice principle, smooth or PL structure, triangulation of $M$, or general locally contractible-space retraction theorem is assumed.",
        "proof_strategy": "direct",
        "dependency_level": 0
      },
      {
        "id": "thm-explicit-mitoses-give-functorial-integrally-acyclic-group-envelopes",
        "kind": "theorem",
        "title": "Explicit mitoses give functorial integrally acyclic group envelopes",
        "deps": [
          "def-axiom-of-choice",
          "def-hnn-extension-and-stable-letter",
          "cor-the-base-group-embeds-in-its-hnn-extension",
          "prop-universal-property-of-an-hnn-extension",
          "def-unnormalized-homogeneous-bar-resolution",
          "lem-diagonal-bar-coinvariants-compute-group-homology"
        ],
        "justified_by": [],
        "statement": "Assume AC. There is an explicit functor $A$ from groups to groups and a natural transformation $\\iota:\\mathrm{id}\\to A$ such that each $\\iota_G:G\\to A(G)$ is injective and\n$$H_j(A(G);\\mathbb Z)=0\\quad(j>0),\\qquad H_0(A(G);\\mathbb Z)=\\mathbb Z.$$\nOne may take $A(G)$ to be the increasing union of the iterated mitoses $G_0=G$, $G_{r+1}=m(G_r)$, where\n$$m(K)=\\langle K,u,t\\mid [h,ugu^{-1}]=1,\\ t g t^{-1}=gugu^{-1}\\ (g,h\\in K)\\rangle.$$\nFor every $n\\ge0$ there is a specified partial chain homotopy, in degrees at most $n$, between the trivial homomorphism and $G\\hookrightarrow G_n$ on integral unnormalized bar chains. It is zero in degree zero, has finite values on every basis simplex, and is natural in $G$. In particular every integral positive-degree bar cycle from any stage bounds after finitely many further mitoses. If $G$ is countable, $A(G)$ is countable.",
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "Jae Choon Cha, A topological approach to Cheeger-Gromov universal bounds for von Neumann rho-invariants",
              "url": "https://arxiv.org/pdf/1405.1805",
              "locator": "Complete printed pages 11–14 and 25–34 read; Theorem 2.1 and section 5. The chain homotopies and their signs are proved locally below."
            }
          ]
        },
        "proof_strategy": "direct",
        "dependency_level": 0
      },
      {
        "id": "def-smooth-slice-disk-exterior",
        "kind": "definition",
        "title": "Exterior of a smooth proper disk",
        "deps": [
          "def-locally-flat-proper-surface-and-concordance-collars",
          "thm-tubular-neighbourhood-theorem-in-a-smooth-ambient-manifold",
          "def-axiom-of-choice"
        ],
        "dependency_level": 1,
        "justified_by": [],
        "statement": "Assume AC. Let $D\\subset B^4$ be a smooth proper disk with boundary $K\\subset S^3$. Choose a closed tubular neighborhood $N(D)\\cong D^2\\times D^2$ meeting $S^3$ in $\\partial D\\times D^2$, and let $X_D$ be the closure of $B^4\\setminus\\operatorname{int}N(D)$, with corners rounded. The positive meridian is the oriented circle $\\{x\\}\\times\\partial D^2$ in the overlap $D^2\\times S^1$, oriented by the ambient and disk orientations.",
        "provenance": {
