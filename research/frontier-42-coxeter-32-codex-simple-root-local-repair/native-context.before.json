  "concerns": [
    {
      "id": "lem-cg-affine-type-crystallographic-alcove-diagrams",
      "concern": "Statement (6) says, “The B2/C2 coincidence is only a coincidence of the finite Coxeter diagram.” This wording is too restrictive: clause (1) also establishes their common affine (4,4) diagram, and the opened root-system classification records B2=C2 as root systems. Distinguish the two chosen dual coordinate length assignments without suggesting that their coincidence stops at the finite diagram.",
      "severity": "presentation"
    }
  ],
  "alerts": [
    {
      "item": "thm-simple-roots-form-a-basis-and-every-root-has-one-sign-of-integral-coordinates",
      "finding": "Proof 2.1 asserts that a relation with “disjoint nonempty index sets and all c_i,c_j>0” is “the shape of every nontrivial real linear relation,” then asserts that the common vector γ is nonzero. Both require the omitted regular-vector argument: pairing a nonzero nonnegative combination of positive roots with the Given regular vector v gives a strictly positive number. This excludes one-signed relations and proves γ≠0. The owned affine-reflection lemma explicitly supplies this justification when applying the theorem to the dual root system; the supplier itself leaves it unstated.",
      "severity": "gap-a-reader-closes"
    }
  ],
