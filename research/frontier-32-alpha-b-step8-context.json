  "concerns": [
    {
      "id": "lem-finite-lch-partition-of-unity-near-a-compact-set",
      "concern": "In proof step 2.1, the text says that shrinking to \"{g=1}^circ intersect {h>1/2}\" leaves an open neighbourhood of K. From the cited cutoff lemma one only has g=1 on K, not that K is contained in the interior of {g=1}. The asserted neighbourhood conclusion therefore does not follow as written. It is repairable by first choosing an open O with K subset O and compact closure O contained in W, then taking a cutoff equal to 1 on closure O.",
      "severity": "gap-a-reader-closes"
    },
    {
      "id": "thm-c-c-is-dense-in-l-p-for-radon-measures",
      "concern": "Proof step 2.1 asserts |f-1_E| <= 1_{U\\setminus K} for a cutoff satisfying 1_K<=f<=1_U. At x in K\\setminus E, the left side can equal 1 while the displayed right side is 0. The standard repair is |f-1_E| <= 1_{U\\setminus K}+1_{U\\setminus E}, with U chosen so mu(U\\setminus E) is small and K chosen so mu(U\\setminus K) is small.",
      "severity": "gap-a-reader-closes"
    }
  ],
