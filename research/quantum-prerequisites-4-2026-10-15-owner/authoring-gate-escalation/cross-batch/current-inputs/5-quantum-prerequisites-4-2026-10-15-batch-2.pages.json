          ]
        }
      },
      {
        "id": "def-equivalent-complex-norms",
        "kind": "definition",
        "title": "Equivalent complex norms",
        "statement": "Two complex norms M and N on the same complex vector space are equivalent when positive real constants c,C satisfy cM(v)<=N(v)<=CM(v) for every v.",
        "deps": ["def-complex-norm-and-complex-normed-space", "def-complete-ordered-field"],
