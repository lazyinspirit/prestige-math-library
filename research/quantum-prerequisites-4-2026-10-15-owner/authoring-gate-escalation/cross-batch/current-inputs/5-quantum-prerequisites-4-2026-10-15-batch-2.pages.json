    "items": [
      {
        "id": "def-complex-norm-and-complex-normed-space",
        "kind": "definition",
        "title": "Complex norm and complex normed space",
        "statement": "A norm on a complex vector space V is a finite-real-valued function N that separates zero, satisfies N(lambda v)=|lambda|_C N(v) for every lambda in C and v in V, and satisfies the triangle inequality.",
        "deps": ["def-vector-space", "def-complex-numbers-and-arithmetic", "def-complex-conjugate-real-imaginary-part-and-modulus"],
        "justified_by": [],
        "dependency_level": 0,
        "provenance": {"statement": "ai-altered", "proof": "not-applicable"},
        "sources": {
          "references": [
            {"title": "Tomasz Kochanek, Functional analysis, Lecture 1", "url": "https://www.impan.pl/~tkoch/FA_lecturenotes/lecture1.pdf"},
            {"title": "M. Winklmeier, Functional Analysis lecture notes", "url": "https://math.uniandes.edu.co/~mwinklme/teaching/FuncAna/FA-lecture_notes.pdf"}
          ]
        }
      },
      {
        "id": "lem-complex-modulus-of-real-embedding-equals-real-absolute-value",
        "kind": "lemma",
        "title": "Complex modulus restricts to real absolute value",
        "statement": "For every real r, the complex modulus of its canonical embedding into C equals the real absolute value of r.",
        "deps": ["def-complex-numbers-and-arithmetic", "def-complex-conjugate-real-imaginary-part-and-modulus", "def-abs-value", "lem-of-abs-value", "lem-of-square-positive", "lem-of-zero-mult", "thm-of-square-roots"],
        "justified_by": [],
