          ]
        }
      },
      {
        "id": "def-complex-normed-subspace",
        "kind": "definition",
        "title": "A complex normed subspace",
        "statement": "A complex normed subspace is a complex-linear subspace W of a complex normed space (V,N), equipped with the restricted norm N_W=N|_W.",
        "deps": ["def-complex-norm-and-complex-normed-space", "def-linear-subspace"],
        "justified_by": [],
