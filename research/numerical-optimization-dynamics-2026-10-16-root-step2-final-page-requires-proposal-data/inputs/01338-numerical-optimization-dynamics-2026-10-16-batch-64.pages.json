      {
        "id": "thm-robbins-monro-strongly-monotone-root-convergence",
        "kind": "theorem",
        "title": "Robbins–Monro converges almost surely for a strongly monotone root",
        "statement": "For a strongly monotone drift with a root, conditionally unbiased stochastic updates with a uniform conditional second-moment bound converge almost surely under square-summable, nonsummable positive stepsizes.",
