      {
        "id": "lem-strong-convexity-implies-strong-monotonicity-of-gradient",
        "kind": "lemma",
        "title": "Strong convexity makes a differentiable gradient strongly monotone",
        "statement": "If f is differentiable on an open convex neighborhood and its restriction to a convex set is μ-strongly convex in the strong-Jensen sense, then its gradient satisfies the μ-strong monotonicity inequality on that set.",
        "deps": [
