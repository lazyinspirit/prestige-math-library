      {
        "id": "def-projected-stochastic-gradient-update",
        "kind": "definition",
        "title": "Projected stochastic-gradient update",
        "statement": "For a nonempty closed convex C in Euclidean space, define projected SGD by x_{k+1}=P_C(x_k−α_kG_k), using the unique Euclidean projection supplied by the proximal indicator interface.",
