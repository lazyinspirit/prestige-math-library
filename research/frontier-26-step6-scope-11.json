  "refuter_findings": [
    {
      "obligation": "refuter:11:1",
      "id": "def-universal-turing-machine",
      "location": "Definition",
      "defect": "ill-formed",
      "evidence": "It quantifies over “every binary input word w.” But def-effective-encoding-of-turing-machines defines the input alphabet as “Σ_s:={1,…,s},” while def-halting-computation-and-divergence fixes an input as “w∈Σ*.” In particular, binary symbol 0 is excluded from Σ_s for every coded machine. Thus “M diverges on input w” is not defined by the library’s computation semantics for the quantified choice w=0; a compatible encoding of each machine’s input words, or a restriction on w, is missing.",
      "severity": "fatal",
      "observed_sha256": "5d6145ce5c8fe482d27fec20b48defe141c4b703fa6ccd3e7611631102f5e2e2"
    },
    {
      "obligation": "refuter:11:2",
      "id": "cex-universality-decides-halting",
      "location": "Counterexample, step 1.1",
      "defect": "ill-formed",
      "evidence": "The step asserts that M_loop “has an infinite run on input 0.” For the chosen coding, def-effective-encoding-of-turing-machines sets every machine’s input alphabet to Σ_s={1,…,s}, whereas def-halting-computation-and-divergence defines runs only for w∈Σ*. Therefore 0 is not an input word of M_loop under the current definitions, so this is not a valid machine/input instance.",
      "severity": "fatal",
      "observed_sha256": "f19df15c0c56719a1358bfe49aa1529c4bca9eff1c60822c2cf4626bfba59ed2"
    },
    {
      "obligation": "refuter:11:3",
      "id": "fs-universality-decides-halting",
      "location": "Refutation, step 1.1",
      "defect": "ill-formed",
      "evidence": "The proof says that M_loop diverges “in particular on w=0.” Under def-effective-encoding-of-turing-machines, coded machines have input alphabet Σ_s={1,…,s}; def-halting-computation-and-divergence only defines a computation on w∈Σ*. Hence w=0 is outside the machine’s input language and the asserted divergence, and thus the counterinstance used in steps 2.1–3.1, is undefined.",
      "severity": "fatal",
      "observed_sha256": "59d3c3b57f1de4bb5552b6aa4e605ad1ed315c4d08e548c6accfdf6d1a0cdb71"
    },
    {
      "obligation": "refuter:11:4",
      "id": "lem-multitape-simulation-has-quadratic-time-overhead",
      "location": "Statement",
      "defect": "false-claim",
      "evidence": "The claimed space bound is c_M(|w|+t) for every t≥0. At w=ε and t=0 this is 0 cells. Yet its cited simulator encoding explicitly has “k simulated tapes as marked blocks,” and proof step 1.1 itself bounds each represented tape interval by |w|+j+1, so the initial configuration has at least one explicitly represented marked blank cell. Step 2.1 drops this necessary additive constant when it concludes c'_M(|w|+j). No positive c_M can make the stated zero-cell bound hold at this endpoint.",
      "severity": "fatal",
      "observed_sha256": "0fc36e57c83207ca6aa57e030d7ad3376c21d38745877aa35c659a710ba5057d"
    }
  ],
