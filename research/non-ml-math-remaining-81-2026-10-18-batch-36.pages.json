      {
        "id": "lem-euclidean-spin-sphere-bundle-local-sections",
        "kind": "lemma",
        "page": "pin-spin-and-clifford-module-representations",
        "dependency_level": 7,
        "title": "Euclidean Spin sphere bundle and explicit rotor sections",
        "deps": [
          "lem-cartan-dieudonne-real-nondegenerate-reflection-factorization",
          "lem-twisted-clifford-adjoint-reflection-and-scalar-kernel",
          "lem-normalized-pin-spin-product-and-norm-laws",
          "thm-real-pin-spin-image-kernel-and-compactness"
        ],
        "justified_by": [],
        "proof_strategy": "direct",
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "Konstantin Wernli, Lecture Notes on Spin Geometry, §1.5.3, pp. 29–31",
              "url": "https://arxiv.org/pdf/1911.09766"
            },
            {
              "title": "Jean Gallier, Clifford Algebras, Clifford Groups, and a Generalization of the Quaternions: The Pin and Spin Groups, §1.8",
              "url": "https://arxiv.org/pdf/0805.0311"
            }
          ]
        },
        "statement": "Let $n\\ge2$ and let $V=\\mathbb R^n$ have its positive-definite inner product. Give $S^{n-1}=\\{v:Q(v)=1\\}$ the subspace topology and let\n\n$$p:\\operatorname{Spin}_{\\mathrm{full}}(n)\\to S^{n-1},\\qquad p(x)=\\rho_x(e_n).$$\n\nThen $p$ is onto, the stabilizer of $e_n$ is the embedded $\\operatorname{Spin}_{\\mathrm{full}}(n-1)$ generated by even products from $e_n^\\perp$, and $p$ is a locally trivial right $\\operatorname{Spin}_{\\mathrm{full}}(n-1)$ bundle. For unit $a$, write $U_a=\\{v\\in S^{n-1}:B(v,a)>-1\\}$. For $v\\in U_a$, the rotor\n\n$$s_a(v)=\\frac{1+va}{\\sqrt{2(1+B(v,a))}}$$\n\nsatisfies $\\rho_{s_a(v)}(a)=v$; in particular, $s_{e_n}$ is a local section of $p$ on $U_{e_n}$. Translating this section by Spin gives local sections of $p$ on the caps $U_a$. The bundle admits a finite partition of unity whose functions have closed supports contained in the corresponding local chart domains.",
        "status": "draft"
      },
