    "lem-largest-sample-covariance-eigenvalue-upper-bound": {
      "citations": [
        {
          "fact": "F1",
          "source": "lem-sample-covariance-spectrum-confinement",
          "source_section": "Statement",
          "quote": "Let $(\\xi_{ij})_{i,j\\ge1}$ be one infinite real iid array with $E\\xi_{11}=0$, $E\\xi_{11}^2=1$ and $E|\\xi_{11}|^4<\\infty$. Let $X_h=(\\xi_{ij})_{i\\le h,j\\le p_h}$ with $p_h/h\\to\\gamma\\in(0,\\infty)$, $N_h=\\max(h,p_h)$ and $m_h=\\min(h,p_h)$. Orient $X_h$ or its transpose as a matrix $Z_h$ with $m_h$ rows and $N_h$ columns, and put $A_h=Z_h/\\sqrt{N_h}$ and $y=\\min(\\gamma,\\gamma^{-1})\\in(0,1]$. Then almost surely\n$$\\limsup_h\\left\\|A_hA_h^{\\mathsf T}-(1+y)I_{m_h}\\right\\|_{\\mathrm{op}}\\le2\\sqrt y.$$\nNo weak convergence of empirical spectral measures is assumed.",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F2",
          "source": "thm-singular-value-decomposition",
          "source_section": "Statement",
          "quote": "Let $T:V\\to W$ be a linear map between finite-dimensional real or complex inner\nproduct spaces, and let $r$ be the number of positive singular values of $T$.\nThen there exist orthonormal bases $(e_1,\\dots,e_n)$ of $V$ and\n$(f_1,\\dots,f_m)$ of $W$, together with singular values\n\n$$s_1\\ge\\cdots\\ge s_r>0,$$\n\nsuch that\n\n$$Tv=\\sum_{j=1}^r s_j\\langle v,e_j\\rangle f_j$$\n\nfor every $v\\in V$.",
          "uses": [
            "1.1",
            "2.1"
          ]
        },
        {
          "fact": "F2",
          "source": "thm-operator-norm-is-the-largest-singular-value",
          "source_section": "Statement",
          "quote": "Let $T:V\\to W$ be a linear map between finite-dimensional real or complex inner\nproduct spaces.\n\nIf $V=0$, then\n\n$$\\lVert T\\rVert=0.$$\n\nIf $V\\ne0$ and $s_1$ is the largest singular value of $T$, then\n\n$$\\lVert T\\rVert=s_1.$$\n\nIn the nonzero case, the maximum in\nThe operator norm is zero on the zero domain and otherwise is max_{||v||=1} ||Tv|| is attained at\na right-singular vector for $s_1$.",
          "uses": [
            "1.1",
            "2.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "local-derivation-1",
          "step": "1.1",
          "claim": "Set $N_n=\\max(n,p_n)$, $m_n=\\min(n,p_n)$, $c_n=N_n/n\\to c=\\max(1,\\gamma)$ and $y_n=m_n/N_n\\to y=\\min(\\gamma,\\gamma^{-1})$. Orient $X_n$ or its transpose as $Z_n$ with $m_n$ rows and $N_n$ columns. By F1, almost surely $\\limsup\\|Z_nZ_n^{\\mathsf T}/N_n-(1+y)I\\|\\le2\\sqrt y$. For each unit vector $v$, its quadratic form is at most $1+y$ plus this norm, so $\\limsup\\lambda_{\\max}(Z_nZ_n^{\\mathsf T}/N_n)\\le(1+\\sqrt y)^2$.",
          "inputs": [
            "given",
            "F1",
            "F2",
            "algebra"
          ]
        },
        {
          "id": "local-derivation-2",
          "step": "2.1",
          "claim": "By F2, $\\lambda_{\\max}(S_n)=c_n\\lambda_{\\max}(Z_nZ_n^{\\mathsf T}/N_n)$. The previous bound gives $\\limsup\\lambda_{\\max}(S_n)\\le c(1+\\sqrt y)^2$. If $\\gamma\\le1$ this constant is $(1+\\sqrt\\gamma)^2$; if $\\gamma\\ge1$ it is $\\gamma(1+\\gamma^{-1/2})^2=(1+\\sqrt\\gamma)^2$. The same identity holds at $\\gamma=1$, even if the orientation changes infinitely often.",
          "inputs": [
            "F2",
            "step 1.1",
            "algebra"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "The largest-edge upper lemma orients the rectangle by its larger dimension and converts sharp confinement back to the original normalization. Both rectangular dimensions are positive; the unit-vector quadratic forms and largest finite eigenvalue do not concern an empty matrix.",
          "template_review": {
            "upheld": true,
            "by": "/root/step2_reverse68",
            "reason": "The largest-edge upper lemma orients the rectangle by its larger dimension and converts sharp confinement back to the original normalization. Both rectangular dimensions are positive; the unit-vector quadratic forms and largest finite eigenvalue do not concern an empty matrix.",
            "item_sha256": "dbe4ee4b896859c8a2be64271a0edda280a97d314260888c775e5aa5b165faea",
            "row_sha256": "e17ff80fa3f14c6da2a8ae31b64a4c23a07c419293f5d4a9e689e6097ea152b5"
          }
        },
        {
