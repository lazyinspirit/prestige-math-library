    "lem-rank-one-resolvent-update-and-trace-bound": {
      "citations": [
        {
          "fact": "F1",
          "source": "cor-real-spectral-theorem-for-self-adjoint-endomorphisms",
          "source_section": "Statement",
          "quote": "Let $V$ be a finite-dimensional real inner product space and let $T:V\\to V$ be\nself-adjoint. Then $V$ has an orthonormal basis consisting of eigenvectors of\n$T$.",
          "uses": [
            "1.1",
            "3.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "derivation-1-1",
          "step": "1.1",
          "claim": "By [F1], write $B=U\\operatorname{diag}(\\lambda_1,\\ldots,\\lambda_d)U^{\\mathsf T}$ with $\\lambda_j\\ge0$. Thus $R$ exists, is normal, and $$x^{\\mathsf T}Rx=\\sum_j\\frac{(U^{\\mathsf T}x)_j^2}{\\lambda_j-z},\\qquad \\operatorname{Im}(x^{\\mathsf T}Rx)=\\eta\\sum_j\\frac{(U^{\\mathsf T}x)_j^2}{(\\lambda_j-u)^2+\\eta^2}.$$ If $x\\ne0$, this imaginary part is strictly positive, so $1+x^{\\mathsf T}Rx\\ne0$; if $x=0$, the denominator is $1$.",
          "inputs": [
            "given",
            "F1",
            "algebra"
          ]
        },
        {
          "id": "derivation-1-2",
          "step": "2.1",
          "claim": "Direct multiplication verifies $$(B+xx^{\\mathsf T}-zI)\\left(R-\\frac{Rxx^{\\mathsf T}R}{1+x^{\\mathsf T}Rx}\\right)=I.$$ Since $B+xx^{\\mathsf T}$ is also real symmetric and $z\\notin\\mathbb R$, its resolvent exists; hence the displayed expression is $R_x$.",
          "inputs": [
            "step 1.1",
            "algebra"
          ]
        },
        {
          "id": "derivation-2-1",
          "step": "3.1",
          "claim": "Taking traces in step 2.1 gives $$\\operatorname{tr}(R_x-R)=-\\frac{x^{\\mathsf T}R^2x}{1+x^{\\mathsf T}Rx}.$$ In the eigenbasis of [F1], $$|x^{\\mathsf T}R^2x|\\le\\sum_j\\frac{(U^{\\mathsf T}x)_j^2}{(\\lambda_j-u)^2+\\eta^2} =\\frac{\\operatorname{Im}(x^{\\mathsf T}Rx)}{\\eta}.$$ Also $|1+x^{\\mathsf T}Rx|\\ge\\operatorname{Im}(x^{\\mathsf T}Rx)$ when $x\\ne0$; for $x=0$ the trace difference is zero. Combining these inequalities proves the stated $1/\\eta$ bound.",
          "inputs": [
            "F1",
            "step 2.1",
            "algebra"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "The Statement has no empty-index or empty-domain case."
        },
