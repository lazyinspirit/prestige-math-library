    "lem-sample-covariance-empirical-law-is-a-probability-measure": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-sample-covariance-empirical-spectral-distribution",
          "source_section": "Definition",
          "quote": "For positive integers $n$ and $p$, let $X\\in\\mathbb R^{n\\times p}$ and define its (uncentered, unit-variance-normalized) sample covariance matrix by\n$$S(X):=\\frac1nX^{\\mathsf T}X\\in\\mathbb R^{p\\times p}.$$\nIt is real symmetric and non-negative. If its eigenvalues, counted with multiplicity, are $\\lambda_1(S(X)),\\ldots,\\lambda_p(S(X))$, its empirical spectral distribution (ESD), normalized by the matrix dimension $p$, is\n$$\\mu_{S(X)}:=\\frac1p\\sum_{j=1}^p\\delta_{\\lambda_j(S(X))}.$$\nThe largest eigenvalue is $\\lambda_{\\max}(S(X)):=\\max_j\\lambda_j(S(X))$. When $S(X)$ has at least one positive eigenvalue, its smallest positive eigenvalue is $\\lambda_{\\min}^{+}(S(X)):=\\min\\{\\lambda_j(S(X)):\\lambda_j(S(X))>0\\}$. For a sequence $(X_n)_{n\\ge1}$ with $X_n\\in\\mathbb R^{n\\times p_n}$ and positive integer $p_n$ for every $n\\ge1$, write $S_n=S(X_n)$ and $\\mu_n=\\mu_{S_n}$.",
          "uses": [
            "1.1",
            "2.1"
          ]
        },
        {
          "fact": "F2",
          "source": "cor-real-spectral-theorem-for-self-adjoint-endomorphisms",
          "source_section": "Statement",
          "quote": "Let $V$ be a finite-dimensional real inner product space and let $T:V\\to V$ be\nself-adjoint. Then $V$ has an orthonormal basis consisting of eigenvectors of\n$T$.",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F3",
          "source": "lem-finite-empirical-measure-is-a-probability-law",
          "source_section": "Statement",
          "quote": "Let $(X,\\mathcal A)$ be a measurable space, let $n\\ge1$, and let $x_1,\\ldots,x_n\\in X$. Define\n\n$$P_n(A):=\\frac1n\\sum_{i=1}^n\\delta_{x_i}(A),\\qquad A\\in\\mathcal A.$$\n\nThen $P_n$ is a probability measure on $(X,\\mathcal A)$.",
          "uses": [
            "2.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "derivation-1-1",
          "step": "1.1",
          "claim": "The matrix $S(X)$ is symmetric because $(X^{\\mathsf T}X)^{\\mathsf T}=X^{\\mathsf T}X$. For every $v\\in\\mathbb R^p$, $$v^{\\mathsf T}S(X)v=\\frac1n\\|Xv\\|_2^2\\ge0.$$ By [F2], its eigenvalues are real; if $S(X)v=\\lambda v$ with $v\\ne0$, the displayed quadratic-form identity gives $\\lambda\\|v\\|_2^2\\ge0$, hence $\\lambda\\ge0$.",
          "inputs": [
            "given",
            "F1",
            "F2",
            "algebra"
          ]
        },
        {
          "id": "derivation-2-1",
          "step": "2.1",
          "claim": "Apply [F3] to the finite list $\\lambda_1(S(X)),\\ldots,\\lambda_p(S(X))$ in the Borel space $\\mathbb R$. The resulting empirical measure is exactly [F1] and is a Borel probability measure. Step 1.1 shows it assigns no mass outside $[0,\\infty)$.",
          "inputs": [
            "F1",
            "F3",
            "step 1.1"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "case": "empty",
