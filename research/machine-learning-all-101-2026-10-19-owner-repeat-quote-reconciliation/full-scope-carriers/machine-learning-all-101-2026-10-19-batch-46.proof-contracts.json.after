    "thm-smallest-positive-eigenvalue-sample-covariance-edge": {
      "citations": [
        {
          "fact": "F1",
          "source": "thm-bai-yin-smallest-singular-value-limits",
          "source_section": "Statement",
          "quote": "Let $(\\xi_{ij})_{i,j\\ge1}$ be one infinite iid array of real random variables with mean zero, variance one and finite fourth moment. For each positive integer $n$, let $p_n$ be a positive integer and let $X_n=(\\xi_{ij})_{1\\le i\\le n,1\\le j\\le p_n}$ and suppose $p_n/n\\to\\gamma\\in(0,\\infty)$. Let $s_{r_n}(X_n)$ be the smallest among the $r_n:=\\min(n,p_n)$ singular values, counting zero values. Then, almost surely: if $\\gamma<1$, $s_{r_n}(X_n)/\\sqrt n\\to1-\\sqrt\\gamma$, so $X_n$ has full column rank for all sufficiently large $n$; if $\\gamma>1$, $s_{r_n}(X_n)/\\sqrt n\\to\\sqrt\\gamma-1$, so $X_n$ has full row rank for all sufficiently large $n$; and if $\\gamma=1$, the smallest positive singular value is eventually defined and, divided by $\\sqrt n$, tends to zero.",
          "uses": [
            "1.1",
            "2.1",
            "3.1"
          ]
        },
        {
          "fact": "F2",
          "source": "thm-singular-value-decomposition",
          "source_section": "Statement",
          "quote": "Let $T:V\\to W$ be a linear map between finite-dimensional real or complex inner\nproduct spaces, and let $r$ be the number of positive singular values of $T$.\nThen there exist orthonormal bases $(e_1,\\dots,e_n)$ of $V$ and\n$(f_1,\\dots,f_m)$ of $W$, together with singular values\n\n$$s_1\\ge\\cdots\\ge s_r>0,$$\n\nsuch that\n\n$$Tv=\\sum_{j=1}^r s_j\\langle v,e_j\\rangle f_j$$\n\nfor every $v\\in V$.",
          "uses": [
            "1.1",
            "2.1",
            "3.1"
          ]
        },
        {
          "fact": "F2",
          "source": "cor-rank-equals-number-of-nonzero-singular-values",
          "source_section": "Statement",
          "quote": "Let $T:V\\to W$ be a linear map between finite-dimensional real or complex inner\nproduct spaces. Then $\\operatorname{rank} T$ equals the number of positive\nsingular values of $T$.",
          "uses": [
            "1.1",
            "2.1",
            "3.1"
          ]
        },
        {
          "fact": "F2",
          "source": "cor-real-spectral-theorem-for-self-adjoint-endomorphisms",
          "source_section": "Statement",
          "quote": "Let $V$ be a finite-dimensional real inner product space and let $T:V\\to V$ be\nself-adjoint. Then $V$ has an orthonormal basis consisting of eigenvectors of\n$T$.",
          "uses": [
            "1.1",
            "2.1",
            "3.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "local-derivation-1",
          "step": "1.1",
          "claim": "When $\\gamma<1$, F1 gives full column rank eventually. Thus F2 gives no covariance zero eigenvalues eventually, and the least eigenvalue is $s_{p_n}(X_n)^2/n\\to(1-\\sqrt\\gamma)^2$.",
          "inputs": [
            "given",
            "F1",
            "F2",
            "algebra"
          ]
        },
        {
          "id": "local-derivation-2",
          "step": "2.1",
          "claim": "When $\\gamma>1$, F1 gives full row rank eventually. Then F2 gives exactly $p_n-n$ zero eigenvalues and identifies the smallest positive eigenvalue with $s_n(X_n)^2/n\\to(\\sqrt\\gamma-1)^2$.",
          "inputs": [
            "F1",
            "F2",
            "algebra",
            "step 1.1"
          ]
        },
        {
          "id": "local-derivation-3",
          "step": "3.1",
          "claim": "When $\\gamma=1$, F1 gives an eventually defined smallest positive singular value whose ratio to $\\sqrt n$ tends to zero. F2 squares this ratio to obtain $\\lambda_{\\min}^{+}(S_n)\\to0$. Intersecting the relevant probability-one supplier events proves every asserted almost-sure conclusion.",
          "inputs": [
            "F1",
            "F2",
            "algebra",
            "step 2.1"
          ]
        }
      ],
