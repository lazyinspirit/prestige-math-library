    "thm-largest-eigenvalue-sample-covariance-edge": {
      "citations": [
        {
          "fact": "F1",
          "source": "lem-largest-sample-covariance-eigenvalue-upper-bound",
          "source_section": "Statement",
          "quote": "Let $(\\xi_{ij})_{i,j\\ge1}$ be one infinite iid array of real random variables with mean zero, variance one and finite fourth moment. For each positive integer $n$, let $p_n$ be a positive integer and let $X_n=(\\xi_{ij})_{1\\le i\\le n,1\\le j\\le p_n}$ and suppose $p_n/n\\to\\gamma\\in(0,\\infty)$. For $S_n=X_n^{\\mathsf T}X_n/n$, with $b_\\gamma=(1+\\sqrt\\gamma)^2$, the upper-edge bound is\n$$\\limsup_{n\\to\\infty}\\lambda_{\\max}(S_n)\\le b_\\gamma\\quad\\text{almost surely}.$$",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F2",
          "source": "lem-largest-sample-covariance-eigenvalue-lower-bound",
          "source_section": "Statement",
          "quote": "Let $(\\xi_{ij})_{i,j\\ge1}$ be one infinite iid array of real random variables with mean zero, variance one and finite fourth moment. For each positive integer $n$, let $p_n$ be a positive integer and let $X_n=(\\xi_{ij})_{1\\le i\\le n,1\\le j\\le p_n}$ and suppose $p_n/n\\to\\gamma\\in(0,\\infty)$. For $S_n=X_n^{\\mathsf T}X_n/n$ and $b_\\gamma=(1+\\sqrt\\gamma)^2$, the separate lower-edge estimate is\n$$\\liminf_{n\\to\\infty}\\lambda_{\\max}(S_n)\\ge b_\\gamma\\quad\\text{almost surely}.$$",
          "uses": [
            "1.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "local-derivation-1",
          "step": "1.1",
          "claim": "The two suppliers apply to exactly the same upper-left blocks, law, normalization and aspect ratio as in the Statement. Intersect their probability-one events to obtain the upper bound in F1 and lower bound in F2 simultaneously.",
          "inputs": [
            "given",
            "F1",
            "F2"
          ]
        },
        {
          "id": "local-derivation-2",
          "step": "2.1",
          "claim": "On this event the liminf and limsup of $\\lambda_{\\max}(S_n)$ coincide with $(1+\\sqrt\\gamma)^2$. Thus the sequence converges to that value almost surely.",
          "inputs": [
            "step 1.1",
            "algebra"
          ]
        }
      ],
      "routine_steps": [],
