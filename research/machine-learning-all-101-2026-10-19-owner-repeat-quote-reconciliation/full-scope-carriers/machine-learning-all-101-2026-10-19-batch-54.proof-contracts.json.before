        {
          "fact": "F23",
          "source": "cor-expectation-of-an-indicator-is-probability",
          "source_section": "Statement",
          "quote": "Let $(\\Omega,\\mathcal F,\\mathbb P)$ be a probability space and let $A\\in\\mathcal F$.\nThen the indicator $\\mathbf 1_A$ satisfies\n$$\\mathbb E[\\mathbf 1_A]=\\mathbb P(A).$$",
          "uses": [
