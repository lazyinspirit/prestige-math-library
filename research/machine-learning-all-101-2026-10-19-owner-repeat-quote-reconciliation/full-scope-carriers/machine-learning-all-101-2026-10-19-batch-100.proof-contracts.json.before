  "contracts": {
    "ex-threshold-median-query-binary-search": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-pool-based-realizable-active-learning",
          "source_section": "Definition",
          "quote": "Let $(\\mathcal X,\\Sigma)$ be a nonempty measurable space, let $D_X$ be a probability measure on it, and let $\\mathcal H$ be a finite nonempty set of measurable classifiers $h:\\mathcal X\\to\\{0,1\\}$. A finite pool-based realizable active-learning instance consists of an ordered pool $U=(u_1,\\ldots,u_m)\\in\\mathcal X^m$ for some $m\\ge0$, an unknown target $h^*\\in\\mathcal H$, and a deterministic exact label oracle $\\mathcal O:\\mathcal X\\to\\{0,1\\}$ satisfying $\\mathcal O(x)=h^*(x)$ at every queried point. A fresh feature $X\\sim D_X$ has target label $h^*(X)$; the pool itself need not be sampled from $D_X$. For a set $Q\\subseteq\\{1,\\ldots,m\\}$ of queried indices with observed labels $(y_i)_{i\\in Q}$, the version space is $V(Q,y)=\\{h\\in\\mathcal H:h(u_i)=y_i\\text{ for every }i\\in Q\\}$. For any $V\\subseteq\\mathcal H$, its disagreement region is $\\operatorname{DIS}(V)=\\{x\\in\\mathcal X:\\exists h,g\\in V,\\ h(x)\\ne g(x)\\}$. Since $V$ is finite and every classifier is measurable, $\\operatorname{DIS}(V)$ is measurable. The pointwise exact-oracle assumption is stronger than standard distributional PAC realizability: zero population risk only requires agreement almost surely under the joint law and does not prescribe oracle values at every pool point.",
          "uses": [
            "1.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "derive-1-1",
          "step": "1.1",
          "claim": "Suppose the current candidate interval is $[a,b]$ with $s=b-a+1\\ge2$. Then $j=a+\\lfloor s/2\\rfloor$ satisfies $a<j\\le b$. Among candidate indices, the label at $x_j$ is $1$ exactly for $k<j$, namely $k\\in[a,j-1]$, and is $0$ exactly for $k\\ge j$, namely $k\\in[j,b]$. These branches have sizes $\\lfloor s/2\\rfloor$ and $\\lceil s/2\\rceil$. By [F1], the exact oracle retains the branch containing $k^*$, so the target remains in the updated interval and the new size is at most $\\lceil s/2\\rceil$.",
          "inputs": [
            "given",
            "F1",
            "algebra"
          ]
        },
        {
          "id": "derive-2-1",
          "step": "2.1",
          "claim": "Starting from $s_0=n+1$, repeated ceiling-halving gives $s_r\\le\\lceil(n+1)/2^r\\rceil$: if this holds at $r$, then $s_{r+1}\\le\\lceil s_r/2\\rceil\\le\\lceil(n+1)/2^{r+1}\\rceil$. For the least $q$ with $2^q\\ge n+1$, this bound is at most $1$. Since the target remains in the interval by step 1.1, the selector stops with the singleton $\\{k^*\\}$ after at most $q$ queries.",
          "inputs": [
            "given",
            "step 1.1",
            "algebra"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "status": "not_applicable",
          "reason": "The example assumes $n\\ge1$, so an empty pool is excluded.",
          "case": "empty"
        },
        {
          "status": "not_applicable",
          "reason": "At least two thresholds are present because $n\\ge1$; the initial interval is not already a singleton.",
          "case": "zero"
        },
        {
          "status": "checked",
          "evidence": "Step 1.1 gives the two nonempty branches for n=1, so one query identifies the target.",
          "case": "one"
        },
        {
          "status": "checked",
          "evidence": "Step 1.1 verifies target retention for either endpoint target k*=0 or k*=n.",
          "case": "degenerate"
        },
        {
          "status": "checked",
          "evidence": "Step 1.1 proves a<j<=b for every nonsingleton interval, including the first and last pool indices.",
          "case": "endpoints"
        },
        {
          "status": "checked",
          "evidence": "Step 1.1 uses the deterministic integer median formula; no choice axiom is needed.",
          "case": "nonempty-choice"
        },
        {
          "status": "not_applicable",
          "reason": "The claim is one-way and contains no biconditional.",
          "case": "iff-forward"
