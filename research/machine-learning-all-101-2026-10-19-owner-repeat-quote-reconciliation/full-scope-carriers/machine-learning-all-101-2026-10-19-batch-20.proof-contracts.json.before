    "thm-equal-spherical-mixture-low-variance-kmeans-limit": {
      "citations": [
        {
          "fact": "F1",
          "source": "thm-exponential-limits-and-range",
          "source_section": "Statement",
          "quote": "$$\\exp(x)\\to+\\infty\\quad(x\\to+\\infty),\\qquad \\exp(x)\\to0\\quad(x\\to-\\infty),$$\nand the range of $\\exp$ is contained in $(0,\\infty)$ and is unbounded above with infimum $0$.",
          "uses": [
            "1.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "d-1-1",
          "claim": "Fix $i$ and write $R_i(\\sigma):=\\sum_{k\\in M_i}\\pi_k+\\sum_{k\\notin M_i}\\pi_k\\exp(-(d_{ik}-d_i^*)/(2\\sigma^2))$. Every difference in the second sum is strictly positive, so each exponential there tends to zero by [F1], since its exponent tends to $-\\infty$ as $\\sigma\\downarrow0$; the sum is finite. Hence $R_i(\\sigma)\\to\\sum_{k\\in M_i}\\pi_k>0$.",
          "step": "1.1",
          "inputs": [
            "given",
            "A1",
            "F1",
            "algebra"
          ]
        },
        {
          "id": "d-2-1",
          "claim": "Factoring $\\exp(-d_i^*/(2\\sigma^2))$ from the denominator of $\\rho_{ik}^{(\\sigma)}$ gives $\\rho_{ik}^{(\\sigma)}=\\pi_k\\exp(-(d_{ik}-d_i^*)/(2\\sigma^2))/R_i(\\sigma)$. If $k\\in M_i$, its exponential is one and the limit is $\\pi_k/\\sum_{j\\in M_i}\\pi_j$; if $k\\notin M_i$, its positive distance gap makes the numerator tend to zero while the denominator tends to a positive number. This proves the stated responsibility limits.",
          "step": "2.1",
          "inputs": [
            "given",
            "A1",
            "step 1.1",
            "algebra"
          ]
        },
        {
          "id": "d-2-2",
          "claim": "The same factorization gives $-2\\sigma^2\\log\\sum_k\\pi_k e^{-d_{ik}/(2\\sigma^2)}=d_i^*-2\\sigma^2\\log R_i(\\sigma)$. The nearest terms give $R_i(\\sigma)\\ge\\sum_{k\\in M_i}\\pi_k>0$, while $d_{ik}-d_i^*\\ge0$ and $\\sum_k\\pi_k=1$ give $R_i(\\sigma)\\le1$. Thus $\\log R_i(\\sigma)$ stays between two finite constants, so the second term tends to zero. Summing over the finite set of observations gives $\\Psi_\\sigma\\to\\sum_i d_i^*$.",
          "step": "2.2",
          "inputs": [
            "given",
            "A1",
            "step 1.1",
            "algebra"
          ]
        },
        {
          "id": "d-3-1",
          "claim": "For each labeling $z\\in\\{1,\\ldots,K\\}^n$, $d_{i,z_i}\\ge d_i^*$ for every $i$, so $\\sum_i d_{i,z_i}\\ge\\sum_i d_i^*$. Define $z_i:=\\min M_i$, which exists because $M_i$ is a nonempty finite subset of $\\{1,\\ldots,K\\}$. This labeling attains equality, proving the displayed minimum without any choice principle.",
          "step": "3.1",
          "inputs": [
            "given",
            "A1",
            "step 2.2",
            "construct",
            "algebra"
          ]
        }
      ],
