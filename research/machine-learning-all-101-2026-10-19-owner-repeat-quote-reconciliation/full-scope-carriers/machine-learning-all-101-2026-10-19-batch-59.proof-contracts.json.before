        },
        {
          "id": "compare-likelihood-gradients",
          "claim": "By [F4], the exact negative log-likelihood gradient at $0$ is $0-p_0(1)=-1/2$. By [F3], the population stop-gradient CD-1 direction is $0-q_{1,0}(1)=-1/4$, so it differs from the exact likelihood gradient.",
          "step": "3.1",
          "inputs": [
