      "derivations": [
        {
          "id": "verify-invariant-model-kernel",
          "claim": "Direct normalization gives $Z_\\theta=1+e^{-\\theta}$ and the displayed $p_\\theta$. By [F9], its coordinates are positive. Each row of $K_\\theta$ sums to $1/2+\\sum_y p_\\theta(y)/2=1$, every entry is positive, and $\\sum_xp_\\theta(x)K_\\theta(x,y)=\\frac12p_\\theta(y)+\\frac12p_\\theta(y)\\sum_xp_\\theta(x)=p_\\theta(y)$, so $K_\\theta$ is an admissible invariant kernel.",
          "step": "1.1",
          "inputs": [
            "given",
            "F1",
            "F9",
            "construct",
            "algebra"
          ]
        },
        {
          "id": "compute-reconstruction-and-derivatives",
          "claim": "At $\\theta=0$, $p_0(0)=p_0(1)=1/2$ and $q_0=\\delta_0$, so [F2] gives $q_{1,0}(1)=K_0(0,1)=p_0(1)/2=1/4$ and $q_{1,0}(0)=3/4$. Also $E'_\\theta(0)=0$ and $E'_\\theta(1)=1$. By [F6] and [F7], $(e^{-\\theta})'=-e^{-\\theta}$; applying the quotient rule [F5] to $u/(1+u)$, where $u=e^{-\\theta}$, gives $p'_\\theta(1)=u'/(1+u)^2=-e^{-\\theta}/(1+e^{-\\theta})^2=-p_\\theta(1)p_\\theta(0)$. Hence $p'_0(1)=-1/4$; the scalar rule [F5] applied to $q_{1,\\theta}(1)=p_\\theta(1)/2$ gives $q'_{1,0}(1)=-1/8$ and, since $q_{1,\\theta}(0)=1-q_{1,\\theta}(1)$, $q'_{1,0}(0)=1/8$.",
          "step": "2.1",
          "inputs": [
            "given",
            "F1",
            "F2",
            "F5",
            "F6",
            "F7",
            "F8",
            "step 1.1",
            "algebra"
