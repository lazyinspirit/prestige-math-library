  "load_bearing": [
    {
      "id": "lem-normalized-point-blowups-dominate-local-normal-surface-modifications",
      "statement": "Assume AC and DC. Let A be a normal two-dimensional Noetherian local domain essentially of finite type over a field or a complete equicharacteristic Noetherian local ring, S a normal integral modification of Spec A, and Y→S an integral modification with normal Y. A finite sequence of proper normalized point blowups of S, centred above the finite non-isomorphism set, dominates Y. It remains projective over A when S is projective; for regular S the blowups are ordinary regular point blowups.",
      "used_by": [
        "lem-birational-surface-morphism-factors-through-blowup-at-a-non-isomorphism-point",
        "lem-finite-domination-of-surface-modifications-via-relative-hilbert-scheme",
        "def-rational-normal-surface-singularity-and-bounded-modification-h1",
        "lem-regular-local-surface-is-rational-by-point-blowup-domination",
        "lem-rational-normal-surface-reduced-to-invertible-canonical-module",
        "lem-complete-normal-surface-regular-resolution-converts-to-normalized-point-blowups"
      ]
    },
    {
      "id": "lem-surface-finite-type-formal-fibres",
      "statement": "Assume AC and DC. Let A be a field or a complete equicharacteristic Noetherian local ring and B an essentially finite-type A-algebra. For primes q⊆p of B, the formal fibre of the completion of B_p over κ(q) is geometrically regular.",
      "used_by": [
        "lem-surface-regular-fibres-preserve-normality",
        "lem-surface-finite-type-normalization-finite",
        "lem-normal-surface-normalization-commutes-with-base-completion"
      ]
    },
    {
      "id": "lem-surface-finite-type-normalization-finite",
      "statement": "Assume AC and DC. Every integral finite-type algebra over a field or a complete equicharacteristic Noetherian local base has finite normalization, and so do its localizations. Integral schemes of finite type over these bases consequently have finite scheme normalization.",
      "used_by": [
        "lem-normalized-point-blowups-dominate-local-normal-surface-modifications",
        "lem-finite-domination-of-surface-modifications-via-relative-hilbert-scheme",
        "lem-normal-surface-normalization-commutes-with-base-completion",
        "thm-complete-equicharacteristic-normal-surface-resolution-by-normalized-point-blowups",
        "thm-resolution-of-normal-surface-singularities"
      ]
    },
    {
      "id": "lem-normal-projective-surface-dualizing-module-over-regular-local-base",
      "statement": "Assume AC and DC. Let R be regular Noetherian local of dimension two, A a finite normal local R-domain of dimension two with R→A injective and local, and X a normal integral two-dimensional scheme projective over R with a proper birational map to Spec A. With ω_A=Hom_R(A,R), D_X=ω_X[2] and D_A=ω_A[2]; ω_X is coherent, CM, torsion-free of generic rank one. Evaluation identifies RΓ(X,ω_X) with RHom_A(RΓ(X,O_X),ω_A), and its trace is dual to the structure-cohomology unit.",
      "used_by": [
        "lem-projective-normal-surface-grauert-riemenschneider-vanishing",
        "lem-normal-surface-trace-cokernel-dualizes-h1-and-bounds-it",
        "lem-regular-base-dualizing-traces-compose-on-rational-modifications",
        "lem-complete-regular-surface-degree-p-extension-has-bounded-h1"
      ]
    },
    {
      "id": "lem-projective-normal-surface-modification-h1-injects-off-special-fibre",
      "statement": "Assume AC and DC. For a normal two-dimensional Noetherian local domain A essentially of finite type over a field or complete equicharacteristic local base, a projective normal modification X, and U the inverse image of the punctured spectrum, H¹(X,O_X)→H¹(U,O_U) is injective.",
      "used_by": [
        "lem-normal-surface-modification-no-derived-residue-map",
        "lem-normal-surface-modification-uniform-principal-torsion-bound"
      ]
    },
    {
      "id": "lem-normal-surface-trace-cokernel-dualizes-h1-and-bounds-it",
      "statement": "Assume AC and DC. Let R be regular local of dimension two and A a finite normal local R-domain in the permitted class. For a projective normal modification X, with M=H¹(X,O_X), there is a canonical exact sequence 0→Γ(X,ω_X)→ω_A→Ext²_R(M,R)→0. The last module has the same A-annihilator as M. A fixed nonzero element annihilating every such cokernel implies bounded modification H¹. For rational A the trace is an isomorphism and gives f*ω_A→ω_X.",
      "used_by": [
        "lem-rational-singular-point-blowup-canonical-pullback-surjective",
        "lem-complete-regular-surface-degree-p-extension-has-bounded-h1"
      ]
    },
    {
      "id": "lem-complete-regular-surface-degree-p-extension-has-bounded-h1",
      "statement": "Assume AC and DC. Let A=k[[u,v]] have characteristic p>0, let L/K be a purely inseparable degree-p extension of its fraction field, and let B be the finite normalization of A in L. Then normal modification H¹ over B is uniformly bounded.",
      "used_by": [
        "thm-complete-equicharacteristic-normal-surface-resolution-by-normalized-point-blowups"
      ]
    },
    {
      "id": "lem-double-plus-simple-cubic-rational-surface-branch-terminates",
      "statement": "Assume AC and DC. Let A be a rational Gorenstein normal local surface in the permitted canonical-module setting, with normal completion and generators m=(x,y,z). If z²+a xy² belongs to z m²+(x,y)⁴ for a unit a, all its singular point-blowup branches terminate. A continuing square branch has unchanged residue field and the same x defining every successive exceptional divisor.",
      "used_by": [
        "lem-triple-cubic-rational-surface-branch-reduces-in-two-steps",
        "thm-rational-gorenstein-normal-surface-singularity-resolved-by-point-blowups"
      ]
    },
    {
      "id": "thm-rational-gorenstein-normal-surface-singularity-resolved-by-point-blowups",
      "statement": "Assume AC and DC. A rational Gorenstein normal local surface domain in the permitted canonical-module setting with normal completion is resolved by finitely many ordinary blowups at singular closed points. Every model is normal, its closed local rings are rational, and its canonical module is invertible. The terminal model is regular and projective over the local base, and is unchanged off the original closed point.",
      "used_by": [
        "lem-complete-normal-surface-regular-resolution-converts-to-normalized-point-blowups",
        "thm-complete-equicharacteristic-normal-surface-resolution-by-normalized-point-blowups"
      ]
    },
    {
      "id": "thm-complete-equicharacteristic-normal-surface-resolution-by-normalized-point-blowups",
      "statement": "Assume AC and DC. Every complete equicharacteristic Noetherian normal local domain A of dimension two admits a regular resolution by finitely many normalized point blowups at singular closed points. All normalizations are finite and the resulting morphism is projective, birational, and an isomorphism off the original closed point.",
      "used_by": [
        "thm-resolution-of-normal-surface-singularities"
      ]
    },
    {
      "id": "thm-resolution-of-normal-surface-singularities",
      "statement": "Assume AC and DC. Every normal integral finite-type scheme of dimension two over a field of arbitrary characteristic admits a finite sequence of point blowups above its singular points followed by finite normalization, with normal models proper over the original scheme and regular terminal model. The composite is proper, birational and an isomorphism over the regular locus. Smoothness follows over a perfect field; properness over the field is not required.",
      "used_by": [
        "rem-surface-contraction-and-resolution-scope-boundaries"
      ]
    },
    {
      "id": "thm-factorization-of-birational-morphisms-of-smooth-surfaces",
      "statement": "Assume AC. Every birational morphism between integral regular finite-type k-schemes of pure dimension two that are proper over k is a composition of blowups at closed points with regular two-dimensional local rings and an isomorphism. Equivalently, every proper birational morphism of such surfaces is, up to isomorphism, a composition of contractions of exceptional curves of the first kind.",
      "used_by": [
        "rem-surface-contraction-and-resolution-scope-boundaries"
      ]
    }
  ],
