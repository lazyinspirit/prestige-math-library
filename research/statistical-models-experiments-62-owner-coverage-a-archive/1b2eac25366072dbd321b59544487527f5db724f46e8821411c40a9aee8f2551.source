    "items": [
      {
        "id": "def-biological-and-technical-replication-model",
        "kind": "definition",
        "title": "Biological and technical replication model",
        "statement": "For n biological units and m technical measurements per unit, define the two-level random-intercept model Y_ij = mu + tau_i + B_i + E_ij, with explicit unit roles, common finite variances, and the stated independence assumptions. Technical repeats are measurements of the same material and do not by themselves add biological units.",
        "strategy": "Define the scientific, assignment, biological, and technical roles explicitly; state the balanced two-level model and every distributional independence and moment assumption without implying Gaussianity or empirical adequacy.",
        "deps": [
          "def-scientific-statistical-model-contract",
          "def-linear-mixed-model",
          "def-random-element-and-real-random-variable",
          "def-expectation-of-a-nonnegative-or-integrable-random-variable",
          "def-moments-variance-and-covariance",
          "def-independent-random-elements"
        ],
        "justified_by": [],
        "dependency_level": 3,
        "sources": {
          "references": [
            {
              "title": "Gary W. Oehlert, A First Course in Design and Analysis of Experiments, Chapter 1 §§1.3 and 1.5, printed pp. 6, 8–10",
              "url": "https://users.stat.umn.edu/~gary/book/fcdae.pdf"
            },
            {
              "title": "Susan Holmes and Wolfgang Huber, Modern Statistics for Modern Biology, Chapter 13 §§13.3.2, 13.4.2, 13.4.5",
              "url": "https://www.huber.embl.de/msmb/13-chap.html"
            }
          ]
        },
        "provenance": {
          "statement": "literature-derived",
          "proof": "not-applicable"
        }
      },
      {
        "id": "thm-mean-and-variance-under-biological-and-technical-replication",
        "kind": "theorem",
        "title": "Mean and variance under balanced biological and technical replication",
        "statement": "For fixed treatment contributions tau_i, the mean of all nm observations has expectation mu + n^(-1) sum_i tau_i and variance sigma_b^2/n + sigma_e^2/(nm). If tau is random under an assignment-averaged law, the exact variance adds Var(tau-bar) and the two covariance terms with the biological and technical averages; independence removes those terms, and iid equal-variance treatment contributions add sigma_tau^2/n.",
        "strategy": "Expand the balanced mean, use finite covariance bilinearity, and show off-diagonal covariances vanish only for the mutually independent centered biological and technical components; retain assignment covariance terms unless independence is stated.",
        "deps": [
          "def-biological-and-technical-replication-model",
          "def-moments-variance-and-covariance",
          "thm-covariance-bilinearity-and-symmetry",
          "thm-factorization-of-expectations-for-independent-variables",
          "def-independent-random-elements",
          "cor-expectation-linearity-monotonicity-and-modulus-bound"
        ],
        "justified_by": [],
        "dependency_level": 4,
        "sources": {
          "references": [
            {
              "title": "Gary W. Oehlert, A First Course in Design and Analysis of Experiments, Chapter 1 §1.5, printed pp. 8–10",
              "url": "https://users.stat.umn.edu/~gary/book/fcdae.pdf"
            },
            {
              "title": "Susan Holmes and Wolfgang Huber, Modern Statistics for Modern Biology, Chapter 13 §§13.3.2, 13.4.2, 13.4.5",
              "url": "https://www.huber.embl.de/msmb/13-chap.html"
            }
          ]
        },
        "proof_strategy": "direct",
        "provenance": {
