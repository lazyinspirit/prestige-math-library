    "items": [
      {
        "id": "def-two-level-full-factorial-design",
        "kind": "definition",
        "title": "Two-level full factorial designs and coded effects",
        "statement": "For k≥1, use every run x∈{-1,+1}^{[k]} once, index the columns by A⊆[k], and set x_A=∏_{j∈A}x_j with x_∅=1. The design matrix has entries X_{x,A}=x_A. For a response table y, define β̂_A(y)=2^{-k}Σ_x x_Ay_x; for nonempty A define the factorial effect as the difference between the mean responses in the x_A=+1 and x_A=-1 run groups.",
        "deps": [],
        "provenance": {
          "statement": "literature-derived",
          "proof": "not-applicable"
        },
        "sources": {
          "references": [
            {
              "title": "Gary W. Oehlert, A First Course in Design and Analysis of Experiments, Chapter 8, §§8.2 and 8.5",
              "url": "https://users.stat.umn.edu/~gary/book/fcdae.pdf"
            },
            {
              "title": "NIST/SEMATECH e-Handbook of Statistical Methods, §5.3.3.3.1, Two-level full factorial designs",
              "url": "https://www.itl.nist.gov/div898/handbook/pri/section3/pri3331.htm"
            },
            {
              "title": "NIST/SEMATECH e-Handbook of Statistical Methods, §5.3.3.3.2, Full factorial example",
              "url": "https://www.itl.nist.gov/div898/handbook/pri/section3/pri3332.htm"
            }
          ]
        },
        "dependency_level": 0
      },
      {
        "id": "thm-full-two-level-factorial-contrast-orthogonality",
        "kind": "theorem",
        "title": "Orthogonality of the full two-level factorial contrasts",
        "statement": "For the complete 2^k-run design, columns c_A=(x_A(x))_{x∈{-1,+1}^{[k]}} satisfy ⟨c_A,c_B⟩=2^k when A=B and 0 otherwise. Thus XᵀX=2^kI and 2^{-k}XᵀX=I. The result is a deterministic property of the full design matrix.",
        "strategy": "Expand each column product as the sign monomial indexed by A△B; if A≠B, flipping one coordinate in A△B pairs every summand with its negative.",
        "deps": [
          "def-two-level-full-factorial-design",
          "def-orthogonal-vectors-sets-and-orthonormal-bases",
          "prop-standard-coordinate-inner-products"
        ],
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
        "proof_strategy": "direct",
        "sources": {
          "references": [
            {
              "title": "Gary W. Oehlert, A First Course in Design and Analysis of Experiments, Chapter 8, §§8.2 and 8.6",
              "url": "https://users.stat.umn.edu/~gary/book/fcdae.pdf"
            },
            {
              "title": "NIST/SEMATECH e-Handbook of Statistical Methods, §5.3.3.3.1, Two-level full factorial designs",
              "url": "https://www.itl.nist.gov/div898/handbook/pri/section3/pri3331.htm"
            }
          ]
        },
        "dependency_level": 1
      },
      {
        "id": "thm-full-factorial-estimator-and-effect-variances",
        "kind": "theorem",
        "title": "Coefficient and factorial-effect variances under equal replication",
        "statement": "In the full-factorial model Y_{x,s}=Σ_{B⊆[k]}β_Bx_B+ε_{x,s}, with r≥1 observations at each run and mutually independent errors satisfying E[ε_{x,s}²]<∞ and common variance σ², define β̂_A=2^{-k}Σ_xx_AȲ_x. Then Var(β̂_A)=σ²/(r2^k) for every A, and for nonempty A the difference-of-means effect estimate τ̂_A=2β̂_A has variance 4σ²/(r2^k). No Gaussian law or zero-interaction assumption is used.",
        "strategy": "Use the contrast Gram identity to isolate β_A. Multiply each error by its ±1 contrast sign, apply variance addition for a finite independent family, then express the effect as twice its coefficient.",
        "deps": [
          "def-two-level-full-factorial-design",
          "thm-full-two-level-factorial-contrast-orthogonality",
          "def-random-element-and-real-random-variable",
          "def-independent-random-elements",
          "def-expectation-of-a-nonnegative-or-integrable-random-variable",
          "def-moments-variance-and-covariance",
          "lem-variance-and-covariance-identities-for-random-variables",
          "cor-variance-adds-for-pairwise-independent-random-variables"
        ],
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
        "proof_strategy": "direct",
        "sources": {
          "references": [
            {
              "title": "Gary W. Oehlert, A First Course in Design and Analysis of Experiments, Chapter 8, §§8.5–8.6",
              "url": "https://users.stat.umn.edu/~gary/book/fcdae.pdf"
            },
