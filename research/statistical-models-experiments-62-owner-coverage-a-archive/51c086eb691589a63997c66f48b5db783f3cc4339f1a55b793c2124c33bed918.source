    "items": [
      {
        "id": "ex-unbalanced-full-factorial-loses-orthogonality",
        "kind": "example",
        "title": "Unequal replication removes factorial-column orthogonality",
        "statement": "A two-factor full factorial with one extra replicate in the (−1,−1) cell still contains all four treatment combinations, but the intercept and A columns have weighted inner product −1 rather than 0. It therefore loses the equal-replication orthogonality used by the full-factorial Gram identity without making the four effect columns linearly dependent.",
        "deps": [
          "def-two-level-full-factorial-design",
          "def-orthogonal-vectors-sets-and-orthonormal-bases",
          "prop-standard-coordinate-inner-products",
          "thm-full-two-level-factorial-contrast-orthogonality"
        ],
