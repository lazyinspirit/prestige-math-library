        "dependency_level": 2
      },
      {
        "id": "ex-two-factor-interaction-and-scale-dependence",
        "kind": "example",
        "title": "A two-factor interaction depends on response scale",
        "statement": "For a positive 2×2 response table with values 1, 2, 3, 6, the coded AB factorial effect on the raw response scale is 1, while its effect on the logarithmic scale is 0. This verifies that a full-factorial interaction is defined relative to the response scale and that the design alone does not impose additivity.",
        "deps": [
          "def-two-level-full-factorial-design",
