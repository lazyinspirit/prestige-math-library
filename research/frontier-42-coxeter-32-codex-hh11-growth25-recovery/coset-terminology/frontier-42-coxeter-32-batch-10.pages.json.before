    "kind": "example",
    "title": "Reflection subgroups that are parabolic but not standard, and one that is not parabolic",
    "deps": [
     "def-cg-parabolic-quotient-and-two-sided-minima",
     "def-hh-coxeter-matrix-word-group-and-length",
