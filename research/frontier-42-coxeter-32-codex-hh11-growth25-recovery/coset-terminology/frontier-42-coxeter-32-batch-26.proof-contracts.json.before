        {
          "fact": "F9",
          "source": "thm-finite-simplicial-approximation-for-maps-of-pairs",
          "source_section": "Statement",
          "quote": "Let $K$ be finite, $A\\subseteq K$ and $B\\subseteq L$ subcomplexes, and $f:(|K|,|A|)\\to(|L|,|B|)$ continuous. For all sufficiently large integers $r$, there is a simplicial approximation $g:(\\operatorname{sd}^rK,\\operatorname{sd}^rA)\\to(L,B)$, homotopic as a map of pairs to $f b_K^r$. Here $b_K^r$ is the composite barycentric homeomorphism. No pointwise fixing of a positive-dimensional restriction is asserted.",
          "uses": [
