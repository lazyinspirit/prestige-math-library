            "1.4",
            "1.5",
            "2.1"
          ]
        },
        {
          "fact": "L2",
          "source": "def-coset",
          "source_section": "Definition",
          "quote": "For $g\\in G$, the **left coset** and **right coset** of $H$ represented by $g$ are $$gH:=\\{gh:h\\in H\\},\\qquad Hg:=\\{hg:h\\in H\\}.$$",
          "uses": [
            "1.1",
            "1.3",
            "1.4",
            "1.5",
            "1.6",
            "3.1"
          ]
        },
        {
          "fact": "L3",
          "source": "def-subgroup",
          "source_section": "Definition",
          "quote": "- **(S1)** $e \\in H$; - **(S2)** $H$ is closed under the operation: $x, y \\in H$ implies $xy \\in H$ ([[def-binary-operation]]); - **(S3)** $H$ is closed under inverses: $x \\in H$ implies $x^{-1} \\in H$.",
          "uses": [
            "1.1",
            "1.3",
            "1.6",
            "3.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "derivation-1.1",
          "step": "1.1",
          "claim": "Suppose $wW_T=w'W_{T'}$.",
          "inputs": [
            "L3",
            "L1",
            "F2",
            "L2",
            "given"
          ]
        },
        {
          "id": "derivation-1.2",
          "step": "1.2",
          "claim": "Conversely, if $T=T'$ and $w^{-1}w'\\in W_T$, then $w'\\in wW_T$ by [L1], so $w'W_T=wW_T$ by [L1]; together with $T=T'$ this is $wW_T=w'W_{T'}$.",
          "inputs": [
            "L1",
            "given"
          ]
        },
        {
          "id": "derivation-1.3",
          "step": "1.3",
          "claim": "Suppose $wW_T\\subseteq w'W_{T'}$.",
          "inputs": [
            "L1",
            "L3",
            "F2",
            "L2",
            "given"
          ]
        },
        {
          "id": "derivation-1.4",
          "step": "1.4",
          "claim": "Conversely, if $T\\subseteq T'$ and $w^{-1}w'\\in W_{T'}$, then $W_T\\le W_{T'}$ by [F1], so $wW_T\\subseteq wW_{T'}=w'W_{T'}$ by [L2].",
          "inputs": [
            "F1",
            "L2",
            "L1",
            "F2",
            "given"
          ]
        },
        {
          "id": "derivation-1.5",
          "step": "1.5",
          "claim": "Assume $u\\in wW_T\\cap w'W_{T'}$.",
          "inputs": [
            "L1",
            "F4",
            "F3",
            "L2",
            "given"
          ]
        },
        {
          "id": "derivation-1.6",
          "step": "1.6",
          "claim": "The intersection is nonempty if and only if $w^{-1}w'\\in W_TW_{T'}$: indeed $wW_T\\cap w'W_{T'}\\neq\\emptyset$ means that $wa=w'b$ for some $a\\in W_T$, $b\\in W_{T'}$, which is equivalent by the group laws [F4] to $w^{-1}w'=ab^{-1}\\in W_TW_{T'}$ because $W_{T'}$ is closed under inverses by [L3].",
          "inputs": [
            "F4",
            "L3",
            "L2",
            "given"
          ]
        },
        {
          "id": "derivation-2.1",
          "step": "2.1",
          "claim": "The projection $\\pi$ is well-defined by [step 1.1]; for fixed $T$ the criterion $wW_T=w'W_T\\iff w^{-1}w'\\in W_T$ is [step 1.1] and [step 1.2] together; and two cosets of $W_T$ are disjoint when they are unequal, since if $u$ lies in both then $wW_T=uW_T=w'W_T$ by [L1].",
          "inputs": [
            "step 1.1",
            "step 1.2",
            "L1",
            "given"
          ]
        },
        {
          "id": "derivation-2.2",
          "step": "2.2",
          "claim": "The meet statement of (3): by [step 1.5] the intersection $p=wW_T\\cap w'W_{T'}$ of two cosets is a member of $WS$ when nonempty, with $\\pi(p)=T\\cap T'$ (spherical, since $T\\cap T'\\subseteq T\\in\\mathbb S$ and $\\mathbb S$ is downward closed by [F5]); it is contained in both cosets, so it is a lower bound.",
          "inputs": [
            "step 1.5",
            "F5",
            "given"
          ]
        },
        {
          "id": "derivation-2.3",
          "step": "2.3",
          "claim": "The quotient poset of (4): left multiplication is order-preserving and $\\pi$-invariant because $(v\\cdot wW_T)=(vw)W_T$ has type $T$ ([step 1.1]); it is transitive on the cosets of a fixed parabolic, as $v:=w'w^{-1}$ sends $wW_T$ to $w'W_T$ by [F4].",
          "inputs": [
            "step 1.1",
            "F4",
            "step 1.3",
            "step 1.4",
            "given"
          ]
        },
        {
          "id": "derivation-3.1",
          "step": "3.1",
          "claim": "The minimal elements of $WS$ are exactly the singletons $wW_\\emptyset=\\{w\\}$.",
          "inputs": [
            "F2",
            "F5",
            "L3",
            "step 1.3",
            "step 1.1",
            "F4",
            "L2",
            "step 2.3",
            "given"
          ]
        }
      ],
