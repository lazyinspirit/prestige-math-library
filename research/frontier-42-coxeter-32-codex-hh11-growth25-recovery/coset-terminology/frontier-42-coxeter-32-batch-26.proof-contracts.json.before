            "given"
          ]
        },
        {
          "id": "derivation-2.2",
          "step": "2.2",
          "claim": "Every continuous loop in $\\Sigma^1$ based at $1$ is based-homotopic to a finite edge walk.",
          "inputs": [
            "F9",
            "F1",
            "F4",
            "F5",
            "F8",
            "F6",
            "step 1.1",
            "given"
          ]
