      "derivations": [
        {
          "id": "derivation-1.1",
          "step": "1.1",
          "claim": "Since $C=\\{y:B(y,e_s)\\ge0\\ \\text{for all }s\\}$ and $x\\in C^\\circ$, each $d_s=B(x,e_s)$ is positive; and by [F4] every $y\\in V$ satisfies $y=\\sum_{s\\in S}B(y,e_s)v_s$, so for $y\\in C$ all coefficients $B(y,e_s)$ are $\\ge0$.",
          "inputs": [
            "F4",
            "given"
          ]
        },
        {
          "id": "derivation-1.2",
          "step": "1.2",
          "claim": "We prove (1) by induction on $k=\\ell(v)$.",
          "inputs": [
            "F1",
            "F3",
            "given"
          ]
        },
        {
          "id": "derivation-1.3",
          "step": "1.3",
          "claim": "We record the convex-combination principle: if $\\ell$ is linear and $S_0\\subseteq Wx$ is the set on which $\\ell$ attains its maximum over $Wx$, then the maximizer set of $\\ell$ on $P=\\operatorname{conv}(Wx)$ is $\\operatorname{conv}(S_0)$.",
          "inputs": [
            "F9",
            "given"
          ]
        },
        {
          "id": "derivation-2.1",
          "step": "2.1",
          "claim": "If $v\\neq1$ then $k\\ge1$, so the expansion of [step 1.2] is a sum with all coefficients $2d_{s_i}$ positive of positive roots, which lie in $V_+\\setminus\\{0\\}$ by [F2]; hence $x-\\rho(v)x\\in V_+\\setminus\\{0\\}$.",
          "inputs": [
            "step 1.2",
            "F2",
            "step 1.1",
            "given"
          ]
        },
        {
          "id": "derivation-2.2",
          "step": "2.2",
          "claim": "Equality case of (2).",
          "inputs": [
            "step 1.2",
            "step 1.1",
            "F1",
            "given"
          ]
        },
        {
          "id": "derivation-3.1",
