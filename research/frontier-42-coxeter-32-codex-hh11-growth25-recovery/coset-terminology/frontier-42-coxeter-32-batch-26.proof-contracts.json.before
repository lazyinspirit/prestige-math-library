        {
          "id": "derivation-2.1",
          "step": "2.1",
          "claim": "Suppose a loop $\\beta$ in $\\Sigma^2$ based at a vertex $v$ is null-homotopic in $\\Sigma$, so it has a based homotopy $H\\colon I^2\\to\\Sigma$ with $H(s,0)=\\beta(s)$, $H(s,1)=v$, and $H(0,t)=H(1,t)=v$.",
          "inputs": [
            "step 1.1",
