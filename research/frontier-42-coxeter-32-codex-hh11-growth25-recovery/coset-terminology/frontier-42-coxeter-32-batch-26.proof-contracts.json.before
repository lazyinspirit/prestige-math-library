    "thm-cg-davis-complex-is-simply-connected": {
      "citations": [
        {
          "fact": "F1",
          "source": "lem-cg-davis-cellulation-cw-structure-and-cayley-skeleta",
          "source_section": "Statement",
          "quote": "**(3) Skeleta.** The skeleta ([[def-skeleta-cw-subcomplex-and-relative-cw-complex]]) are: $\\Sigma^0=W$, the cosets $wW_\\emptyset=\\{w\\}$; $\\Sigma^1$ is the (undirected, $S$-labelled) Cayley graph of $(W,S)$ ([[def-cayley-graph]], [[def-directed-labelled-cayley-graph]]), each $1$-cell $wW_{\\{s\\}}=\\{w,ws\\}$ being an edge labelled $s$; and $\\Sigma^2$ is Davis's reduced Cayley $2$-complex of the Coxeter presentation $W=\\langle S\\mid s^2\\ (s\\in S),\\ (st)^{m(s,t)}\\ (s\\ne t,\\ m(s,t)<\\infty)\\rangle$: the involution relators $s^2$ contribute only edge backtracks, with no $2$-cells, and the finite pair-relator circuits are identified up to cyclic shift and reversal; its $2$-cells are the cosets $wW_{\\{s,t\\}}$ with $m(s,t)<\\infty$, each a $2m(s,t)$-gon whose boundary closed edge path is $w,ws,wst,\\dots,w(st)^{m(s,t)}=w$.",
          "uses": [
            "1.1",
            "2.1",
            "2.2",
            "3.2"
          ]
        },
        {
          "fact": "F2",
          "source": "def-cw-complex-with-closure-finiteness-and-weak-topology",
          "source_section": "Definition",
          "quote": "A **CW complex** is a Hausdorff space $X$ with a filtration",
          "uses": [
            "1.1",
            "2.1"
          ]
        },
        {
          "fact": "F2",
          "source": "def-skeleta-cw-subcomplex-and-relative-cw-complex",
          "source_section": "Definition",
          "quote": "A **CW subcomplex** $A\\subseteq X$ is a union of open cells such that, whenever $A$ contains an open cell $e$, it contains the whole closure $\\overline e$.",
          "uses": [
            "1.1",
            "2.1"
          ]
        },
        {
          "fact": "F2",
          "source": "lem-cg-davis-cellulation-cw-structure-and-cayley-skeleta",
          "source_section": "Statement",
          "quote": "the cellulation is a CW complex in the sense of",
          "uses": [
            "1.1",
            "2.1"
          ]
        },
        {
          "fact": "F3",
          "source": "thm-cellular-approximation-for-maps-of-cw-pairs",
          "source_section": "Statement",
          "quote": "If $X\\setminus A$ has finitely many cells, then, without any choice principle, $f$ is homotopic rel $A$ through maps of pairs to a cellular map $g$",
          "uses": [
            "1.1",
            "2.1",
            "4.1"
          ]
        },
        {
          "fact": "F4",
          "source": "def-group-presentation",
          "source_section": "Definition",
          "quote": "is the quotient by the normal closure of $R$.",
          "uses": [
            "2.2"
          ]
        },
        {
          "fact": "F4",
          "source": "def-hh-coxeter-matrix-word-group-and-length",
          "source_section": "Definition",
          "quote": "$$R:=\\{s^2:s\\in S\\}\\cup\\{(st)^{m(s,t)}:s,t\\in S,\\ m(s,t)<\\infty\\},$$",
          "uses": [
