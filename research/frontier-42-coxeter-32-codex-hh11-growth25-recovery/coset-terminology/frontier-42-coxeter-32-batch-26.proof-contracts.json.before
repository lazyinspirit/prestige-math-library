          ]
        }
      ],
      "derivations": [
        {
          "id": "derivation-1.1",
          "step": "1.1",
          "claim": "A loop in either $X=\\Sigma$ or $X=\\Sigma^2$ based at a vertex $v$ is homotopic rel $v$ in $X$ to an edge loop.",
          "inputs": [
