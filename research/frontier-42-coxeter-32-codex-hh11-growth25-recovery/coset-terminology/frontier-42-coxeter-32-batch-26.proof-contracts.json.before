            "3.1"
          ]
        },
        {
          "fact": "F3",
          "source": "thm-cg-parabolic-intersections-and-coset-factorization",
          "source_section": "Statement",
          "quote": "$$W_I\\cap W_J=W_{I\\cap J}.$$",
          "uses": [
            "1.5"
          ]
        },
        {
          "fact": "F4",
          "source": "def-group",
          "source_section": "Definition",
          "quote": "- **(G1)** $(x * y) * z = x * (y * z)$ for all $x, y, z \\in G$; - **(G2)** $e * x = x = x * e$ for every $x \\in G$; - **(G3)** for every $x \\in G$ there is $y \\in G$ with $y * x = e = x * y$.",
          "uses": [
            "1.5",
            "1.6",
            "2.3",
            "3.1"
          ]
        },
        {
          "fact": "F5",
          "source": "def-cg-spherical-nerve-coset-poset-and-davis-realization",
          "source_section": "Definition",
          "quote": "it has least element $\\emptyset$ because $W_\\emptyset=\\{1\\}$. If $T\\in\\mathbb S$ and $T'\\subseteq T$, then $W_{T'}\\le W_T$ ([[def-generated-subgroup]]), so $T'$ is spherical by [[lem-finite-coset-partition]]: $\\mathbb S$ is downward closed.",
          "uses": [
            "2.2",
            "3.1"
          ]
        },
        {
          "fact": "L1",
          "source": "lem-coset-membership-and-equality",
          "source_section": "Statement",
          "quote": "$$x\\in aH\\iff a^{-1}x\\in H,$$ and $$aH=bH\\iff a^{-1}b\\in H.$$",
          "uses": [
