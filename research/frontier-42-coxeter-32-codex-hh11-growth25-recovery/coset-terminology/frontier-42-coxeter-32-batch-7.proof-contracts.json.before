          ]
        },
        {
          "fact": "F7",
          "source": "cor-trigonometric-parity-and-pythagorean-identity",
          "source_section": "Statement",
          "quote": "For every real $x$,\n$$\\sin(-x)=-\\sin x,\\qquad\\cos(-x)=\\cos x,\\qquad\\sin^2x+\\cos^2x=1.$$\nConsequently $|\\sin x|\\le1$ and $|\\cos x|\\le1$.",
          "uses": [
