   {
    "id": "ex-cg-s4-lifting-squares",
    "kind": "example",
    "title": "The four lifting squares in S4",
    "deps": [
     "thm-cg-bruhat-lifting-and-cover-criterion",
     "thm-cg-bruhat-subword-characterization",
     "def-cg-bruhat-order-by-reflection-chains",
