import fs from'node:fs';import path from'node:path';import{pathToFileURL}from'node:url';import{precheckSource}from'../../tools/paths.mjs';
const{proposedPrecheck}=await import(pathToFileURL(precheckSource()).href);const b=path.dirname(new URL(import.meta.url).pathname);const rows=JSON.parse(fs.readFileSync(path.join(b,'candidate-inventory.json'),'utf8'));const results=[];
function checkable(s){const heads=[...s.matchAll(/^## (Proof|Refutation|Verification|Counterexample)\s*$/gm)];const last=heads.at(-1)?.index;if(last===undefined)return null;let tail=s.slice(last),end=tail.search(/^## (Remarks|Sources|Source notes|References|Bibliography)\s*$/m);if(end>=0)s=s.slice(0,last+end);const fa=s.split(/\n## Facts & Assumptions\n/);return fa.length>=2?fa.at(-1).replace(/^## .*$/gm,'').trim():s.split(/\n## (Proof|Refutation|Verification|Counterexample)\n/).at(-1).trim()}
for(const row of rows){const p=path.join(b,'proposed',row.path);let s=fs.readFileSync(p,'utf8');const text=checkable(s);if(text===null)continue;const strategy=s.match(/^proof_strategy:\s*(\S+)/m)?.[1];if(!strategy)continue;let r;const remaps=[];for(let round=0;round<5;round++){r=proposedPrecheck(checkable(s),strategy);if(r.err||!r.repaired)break;const proofHead=/^## (Proof|Refutation|Verification|Counterexample)\s*\n/m.exec(s);let start=proofHead.index+proofHead[0].length;let endRel=s.slice(start).search(/^## /m);let end=endRel<0?s.length:start+endRel;const section=s.slice(start,end);const oldLines=section.split('\n').filter(x=>/^\d+\.\d+\s/.test(x));const newLines=r.proof.split('\n').filter(x=>/^\d+\.\d+\s/.test(x));if(oldLines.length!==newLines.length)throw Error('step count changed '+row.path);const first=section.search(/^\d+\.\d+\s/m);if(first<0)throw Error('missing proofstep');s=s.slice(0,start)+section.slice(0,first)+newLines.join('\n\n')+'\n\n'+s.slice(end);remaps.push({round,old:oldLines,new:newLines});}
fs.writeFileSync(p,s);results.push({path:row.path,status:r.err?'fail':r.repaired?'still-repair':'pass',error:r.err??null,relabel_rounds:remaps.length,remaps});}
fs.writeFileSync(path.join(b,'candidate-precheck-normalization.json'),JSON.stringify(results,null,2)+'\n');console.log(JSON.stringify({checked:results.length,unresolved:results.filter(x=>x.status!=='pass').map(({remaps,...v})=>v),relabeled:results.filter(x=>x.relabel_rounds).length},null,2));
