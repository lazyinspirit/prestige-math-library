  "load_bearing": [
    {
      "id": "thm-morse-functions-and-handle-decompositions-correspond",
      "statement": "Assume countable choice. On a compact collared triad, every adapted excellent Morse function determines a finite handle decomposition relative to the incoming face, with one handle of the critical point's index per critical point. Given an adapted field, the attaching sphere is the transported boundary of its local unstable disk. Conversely every finite relative handle decomposition is realized by an adapted excellent Morse function with one critical point per handle, of the same index, ordered by the prescribed handle order.",
      "used_by": [
        "lem-a-handle-decomposition-gives-a-relative-cw-complex",
        "thm-handle-duality-from-negating-a-morse-function",
        "prop-morse-handle-chain-complex-computes-singular-homology",
        "cor-morse-euler-characteristic-identity"
      ]
    },
    {
      "id": "lem-handle-attachments-are-relative-cell-attachments-up-to-homotopy",
      "statement": "For a rounded k-handle attached to a smooth n-manifold N with boundary, 0≤k≤n, the pair (N′,N) is homotopy equivalent relative to N to N with one k-cell attached along the core attaching sphere. The collapse map and core inclusion are homotopy inverses of pairs.",
      "used_by": [
        "lem-a-handle-decomposition-gives-a-relative-cw-complex",
        "thm-upper-boundary-of-the-surgery-trace-is-the-surged-manifold",
        "lem-p-surgery-kills-the-represented-pi-p-class-when-p-is-below-the-middle"
      ]
    },
    {
      "id": "lem-interior-slab-handle-attachment",
      "statement": "Assume countable choice. For an adapted pair on a compact triad and regular 0<a<b<1, a compact interior band with exactly one critical point of index k adds one rounded k-handle. Finitely many critical points of index k at one common value add disjoint k-handles in any order. The lower sublevel is respected up to homotopy of pairs through the common pushed-in lower copy, without asserting pointwise fixation of the entire original lower sublevel.",
      "used_by": [
        "thm-morse-functions-and-handle-decompositions-correspond",
        "lem-handles-of-equal-index-can-be-attached-on-one-level",
        "prop-relative-morse-inequalities-for-a-cobordism"
      ]
    },
    {
      "id": "thm-morse-rearrangement-by-index",
      "statement": "Assume countable choice. For an adapted excellent pair (f,X) on a compact triad, there are an adapted complete downward gradient-like field X′ for f and an adapted excellent Morse function g adjusted to (f,X′), with g(p)<g(q) whenever ind(p)<ind(q). Adjusted means the same critical points and indices, translation of f near each critical point, equality with f near the boundary, and X′ downward gradient-like for g.",
      "used_by": [
        "thm-self-indexing-morse-function-existence",
        "prop-morse-handle-chain-complex-computes-singular-homology"
      ]
    },
    {
      "id": "thm-self-indexing-morse-function-existence",
      "statement": "Assume countable choice. An adapted excellent pair on a compact triad can be replaced by an adapted Morse function and adapted complete field with the original critical points and indices and original boundary function, all points of each index at one level, and levels strictly increasing with index. A boundary-fixing increasing reparametrization permits critical value (ind(p)+1)/(n+2).",
      "used_by": [
        "prop-connected-cobordisms-admit-presentations-without-superfluous-zero-handles",
        "prop-morse-handle-chain-complex-computes-singular-homology"
      ]
    },
    {
      "id": "lem-a-handle-decomposition-gives-a-relative-cw-complex",
      "statement": "Assume countable choice. A compact triad with a finite handle decomposition has a finite CW model of pairs (X,A) homotopy equivalent to (W,M₀), with one relative cell of the corresponding index per handle. A is a finite CW model of M₀; if a finite CW structure on M₀ is supplied, A=M₀ and the equivalence can be relative to M₀. The given handle order need not be skeletal order.",
      "used_by": [
        "cor-morse-euler-characteristic-identity",
        "lem-p-surgery-kills-the-represented-pi-p-class-when-p-is-below-the-middle"
      ]
    },
    {
      "id": "lem-one-handle-changes-relative-homology-in-one-degree",
      "statement": "Assume countable choice and field coefficients F. A rounded k-handle attachment has relative homology F in degree k and zero otherwise, generated by the core class; its connector gives the oriented attaching-sphere class. A compact regular-endpoint Morse band whose nondegenerate critical points share one value has relative homology dimension in degree i equal to its number of index-i critical points, with core classes as a basis.",
      "used_by": [
        "thm-morse-polynomial-identity",
        "prop-relative-morse-inequalities-for-a-cobordism",
        "prop-morse-handle-chain-complex-computes-singular-homology"
      ]
    },
    {
      "id": "prop-morse-handle-chain-complex-computes-singular-homology",
      "statement": "Assume countable choice. For a closed smooth n-manifold, a Morse function f and a field F, there is an index-ordered finite handle presentation with exactly mₖ(f) handles of index k and a finite-dimensional handle chain complex. Its basis consists of relative core classes, its differential is the successive-stage triple connector, its differential squares to zero, and its homology is Hₖ(M;F).",
      "used_by": [
        "cor-morse-euler-characteristic-identity",
        "lem-perfectness-is-equivalent-to-vanishing-morse-correction-polynomial",
        "lem-handle-boundary-coefficients-are-attaching-belt-intersection-numbers",
        "ex-perfect-morse-function-on-a-torus"
      ]
    },
    {
      "id": "thm-morse-polynomial-identity",
      "statement": "Assume countable choice. For a Morse function f on a closed smooth n-manifold and a field F, there is a unique polynomial Q with nonnegative integer coefficients such that M_f(t)=P_{M,F}(t)+(1+t)Q(t). The alternating partial-sum inequalities hold, with equality of total alternating sums; all Betti numbers are finite and vanish above n.",
      "used_by": [
        "cor-strong-morse-inequalities",
        "cor-weak-morse-inequalities",
        "cor-total-critical-point-lower-bound",
        "cor-morse-euler-characteristic-identity",
        "lem-perfectness-is-equivalent-to-vanishing-morse-correction-polynomial"
      ]
    },
    {
      "id": "thm-upper-boundary-of-the-surgery-trace-is-the-surged-manifold",
      "statement": "Assume countable choice. For framed p-surgery on a closed smooth m-manifold, 0≤p≤m−1 and q=m−p, the trace's outgoing face is the surgered manifold. Relative to the respective faces, the trace has the cell models M with a (p+1)-cell attached along the underlying sphere and M_φ with a q-cell attached along the belt sphere. Characteristic disks include collar paths to the faces.",
      "used_by": [
        "thm-surgery-is-reversed-by-dual-surgery",
        "lem-p-surgery-kills-the-represented-pi-p-class-when-p-is-below-the-middle",
        "prop-homology-effect-of-surgery-away-from-the-middle-dimensions",
        "prop-surgery-on-a-normal-map-preserves-its-normal-bordism-class"
      ]
    },
    {
      "id": "lem-p-surgery-kills-the-represented-pi-p-class-when-p-is-below-the-middle",
      "statement": "Assume countable choice. For a closed connected smooth m-manifold and a framed embedded p-sphere representing z, with p≥1 and p≤q−2 where q=m−p, the trace comparison induces isomorphisms on πᵢ for 1≤i≤p−1 and a surjection on πₚ. Its kernel is the image of the relative connecting homomorphism and contains z. When M is simply connected the kernel is generated by z, giving πₚ(M_φ)≅πₚ(M)/⟨z⟩.",
      "used_by": [
        "lem-framing-obstruction-lives-in-the-normal-bundle-of-the-surgery-sphere",
        "prop-surgery-on-a-normal-map-preserves-its-normal-bordism-class",
        "rem-middle-dimensional-surgery-has-an-intersection-form-obstruction"
      ]
    },
    {
      "id": "prop-surgery-on-a-normal-map-preserves-its-normal-bordism-class",
      "statement": "Assume countable choice. For a degree-one normal map between closed connected oriented smooth m-manifolds, an orientation-compatible framed surgery datum with a supplied target nullhomotopy and supplied extension B of the stable normal data yields a trace map and a degree-one outgoing normal map normally bordant to the original. A smooth trace map requires smooth incoming f. For p≥1 and p≤q−2, the represented sphere class is killed.",
      "used_by": [
        "rem-middle-dimensional-surgery-has-an-intersection-form-obstruction",
        "rem-smooth-four-dimensional-surgery-is-not-covered-by-the-high-dimensional-program"
      ]
    }
  ],
