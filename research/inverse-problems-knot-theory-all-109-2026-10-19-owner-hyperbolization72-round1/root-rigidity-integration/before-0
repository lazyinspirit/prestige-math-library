      {
        "id": "def-ideal-tetrahedron-shape-and-cusp-holonomy",
        "kind": "definition",
        "title": "Ideal tetrahedron shape and cusp holonomy",
        "deps": [],
        "dependency_level": 0,
        "statement": "Use the upper half-space model $$ \\mathbb H^3=\\{(x+iy,t):x,y\\in\\mathbb R,\\ t>0\\},\\qquad ds^2=t^{-2}(dx^2+dy^2+dt^2), $$ whose ideal boundary is $\\mathbb C\\cup\\{\\infty\\}$. An oriented ideal tetrahedron in normalized position has ideal vertices $0,1,\\infty,z$, where $\\operatorname{Im}z>0$. Its three edge-shape parameters are $$ z,\\qquad z'=\\frac1{1-z},\\qquad z''=\\frac{z-1}{z}, $$ each assigned to one pair of opposite edges; the parameter at a corner of a truncated ideal vertex triangle is the parameter of the incident edge. For an oriented path $\\gamma$ in a triangulated torus link of ideal vertices, its cusp multiplier $H(\\gamma)$ is the product of the corner parameters encountered along $\\gamma$, using the parameter when the path cuts off that corner on its left and its reciprocal when it cuts off the corner on its right.",
        "justified_by": [],
        "provenance": {
          "statement": "literature-derived",
          "proof": "not-applicable"
        },
        "strategy": "not-applicable"
      },
      {
        "id": "lem-torus-curves-same-primitive-class-isotopic-kt18-local",
        "kind": "lemma",
        "title": "Essential torus curves with the same primitive class are isotopic",
        "deps": [
          "thm-cellular-homology-computes-singular-homology"
        ],
        "dependency_level": 0,
        "statement": "Let $T$ be a torus. Every essential smoothly embedded simple closed curve $c\\subset T$ represents a primitive element of $H_1(T;\\mathbb Z)$. If $c,d\\subset T$ are essential smoothly embedded simple closed curves with $[c]=\\pm[d]$, then they are ambient isotopic in $T$ and cobound an annulus.",
        "justified_by": [],
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
        "strategy": "direct"
      },
      {
        "id": "lem-lobachevsky-fourier-expansion-and-pi-third-bound",
        "kind": "lemma",
        "title": "Lobachevsky Fourier expansion and a certified π/3 value",
        "deps": [
          "def-lobachevsky-function"
        ],
        "dependency_level": 1,
        "statement": "For every real $\\theta$, $\\Lambda$ is continuous, odd, and $\\pi$-periodic, with $\\Lambda(\\pi/2)=0$ and $$ \\Lambda(2\\theta)=2\\Lambda(\\theta)+2\\Lambda(\\theta+\\pi/2). $$ For $0\\le\\theta\\le\\pi$, $$ \\Lambda(\\theta)=\\frac12\\sum_{n=1}^{\\infty}\\frac{\\sin(2n\\theta)}{n^2}. $$ In particular, $$ \\Lambda(\\pi/3)=\\frac{\\sqrt3}{4}\\sum_{k=0}^{\\infty} \\left(\\frac1{(3k+1)^2}-\\frac1{(3k+2)^2}\\right). $$ For every integer $N\\ge1$, the positive remainder after the terms $k=0,\\ldots,N$ is at most $\\sqrt3/(72N^2)$.",
        "justified_by": [],
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
        "strategy": "direct"
      },
      {
        "id": "lem-ideal-tetrahedron-shape-parameter-relations",
        "kind": "lemma",
        "title": "Shape parameters of an ideal tetrahedron",
        "deps": [
          "def-ideal-tetrahedron-shape-and-cusp-holonomy"
        ],
        "dependency_level": 1,
        "statement": "For an oriented ideal tetrahedron with normalized vertices $0,1,\\infty,z$ and $\\operatorname{Im}z>0$, its three edge-shape parameters are $z$, $z'=1/(1-z)$, and $z''=(z-1)/z$. They satisfy $zz'z''=-1$, and their arguments in $(0,\\pi)$ are the three dihedral angles, whose sum is $\\pi$. For $\\omega=e^{i\\pi/3}$, the choice $z=\\omega$ gives $z=z'=z''=\\omega$ and all six dihedral angles equal to $\\pi/3$.",
        "justified_by": [],
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
        "strategy": "direct"
      },
      {
