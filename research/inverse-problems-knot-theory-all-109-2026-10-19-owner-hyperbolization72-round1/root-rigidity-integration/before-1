      "derivations": [
        {
          "id": "step-1-1",
          "claim": "Let $Q$ be a fundamental parallelogram of area $A$. Integrating the density from [F1] over $Q\\times[1,\\infty)$ gives $\\operatorname{Vol}(C)=\\int_Q\\int_1^\\infty t^{-3}\\,dt\\,dx\\,dy=A[1/(2t^2)]_1^\\infty=A/2$. The improper integral converges because $t^{-3}$ is integrable on $[1,\\infty)$.",
          "step": "1.1",
