  "refuter_findings": [
    {
      "obligation": "refuter:9:1",
      "id": "cex-the-figure-eight-is-an-immersed-image-not-an-embedded-submanifold",
      "location": "2.1",
      "defect": "false-claim",
      "evidence": "The step says the image passes through (0,0) “twice, at t=0 and t=pi.” On the stated domain R, gamma(2pi)=(sin(2pi),sin(4pi))=(0,0), and in fact gamma(kpi)=(0,0) for every integer k. The transverse-crossing conclusion can still be obtained from t=0 and t=pi, but the asserted count is false.",
      "severity": "fatal",
      "observed_sha256": "4583ea610b9bb4b502188e0f717956137fac9ff058091f331d986aed2000b516"
    },
    {
      "obligation": "refuter:9:2",
      "id": "cor-a-discrete-embedded-submanifold-is-closed-locally-and-countable",
      "location": "2.1",
      "defect": "unlicensed-inference",
      "evidence": "The step infers countability from “the family of all singletons is an open basis” and says a second-countable space cannot have uncountably many such basis elements. But def-second-countable-space states only that the topology has some at-most-countable basis; a second-countable space may also have uncountable bases. The needed argument—that every singleton must occur in a fixed countable basis of a discrete space—is absent.",
      "severity": "nonfatal",
      "observed_sha256": "61cc22736284775846192dfa609d16af2a5a821fbb207772e096129e24cb284a"
    },
    {
      "obligation": "refuter:9:3",
      "id": "thm-a-regular-level-set-is-an-embedded-submanifold",
      "location": "Statement",
      "defect": "missing-hypothesis",
      "evidence": "The statement permits an empty fibre and asserts codimension n with no n<=m condition. Take F:R->R^2, F(x)=(x,0), and q=(0,1). The fibre is empty, so q is regular by def-regular-and-critical-points-and-values, but def-codimension-and-hypersurface defines codimension of an embedded k-submanifold as m-k; no nonnegative k has 1-k=2. Step 1.1's assertion that the empty subset is an embedded submanifold “of every codimension” is not supplied by the definition. The statement needs n<=m or an explicit exceptional convention for empty fibres.",
      "severity": "fatal",
      "observed_sha256": "506e7319fca9de47fdc8c9386e4eed8293dd048903d5ae0655b6e29d4706f6af"
    },
    {
      "obligation": "refuter:9:4",
      "id": "thm-constant-rank-theorem-for-manifolds",
      "location": "[L1]",
      "defect": "citation-inaccurate",
      "evidence": "[L1] cites thm-coordinate-formula-for-the-differential for the claim that the differential is represented by the Jacobian. Its current Statement writes dF_p(partial_x^i)=sum_{j=1}^m (partial F^j/partial x^i) partial_y^j, although the target chart has dimension n. For m=1 and n=2 it omits the second target coordinate; for m>n it names nonexistent target coordinates. Thus that cited statement does not license L1 for this theorem's unrestricted dimensions m and n.",
      "severity": "fatal",
      "observed_sha256": "3169786315e46e479cccaac92ec95e42a257576fb729b479cd7f42a0e56cf877"
    }
