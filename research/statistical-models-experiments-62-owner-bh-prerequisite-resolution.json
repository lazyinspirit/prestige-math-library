    {
      "id": "lem-benjamini-hochberg-leave-one-out-identity",
      "path": "items/lem-benjamini-hochberg-leave-one-out-identity.md",
      "raw_sha256": "f6cb74d88a80bc1dab917bca5464c8b56918e1e6418b3773d494dd1deeff1c51",
      "archive": "research/statistical-models-experiments-62-owner-bh-archive/f6cb74d88a80bc1dab917bca5464c8b56918e1e6418b3773d494dd1deeff1c51.source",
      "disposition": "unchanged-sound supporting subject",
      "finding": "Proof is sound. The maximal qualifying deletion rank need not make all earlier ranks qualify; proof only uses at least s values below the s-th threshold. For positive R<m maximality separates rank R+1 strictly, so no tie can straddle the rejection cutoff. At R=0 no p-value can be zero. At R=m all values pass q. m=1 gives S_i=0 and direct indicator at q. Two deletion cases prove the identity without distributional assumptions."
    },
    {
      "id": "thm-benjamini-hochberg-independent-fdr",
      "path": "items/thm-benjamini-hochberg-independent-fdr.md",
      "raw_sha256": "770f51cd3dbbff7e6e01c13b8e7b3a01fffe023fe9416a66cf74658b8a89b973",
      "archive": "research/statistical-models-experiments-62-owner-bh-archive/770f51cd3dbbff7e6e01c13b8e7b3a01fffe023fe9416a66cf74658b8a89b973.source",
      "disposition": "unchanged-sound; historical prerequisite hold resolved",
      "finding": "Historical missing page inventory is now resolved by actual batch52 definition. Mutual independence groups each true-null p-value with its complement; S_i is measurable from that complement. Uniformity at each deterministic t_r=(r+1)q/m and a finite partition give q/m per null. Empty true-null family gives the empty sum zero. Arbitrary alternative laws and alternative ties are permitted. Exact equality and all original hypotheses retained."
    },
    {
      "id": "ex-benjamini-hochberg-fdr-versus-fwer",
      "path": "items/ex-benjamini-hochberg-fdr-versus-fwer.md",
      "raw_sha256": "ac4cdcf29385026db305f8a2ef2871065caddd1c6513b9b38dc0b26a1b76bd70",
      "archive": "research/statistical-models-experiments-62-owner-bh-archive/ac4cdcf29385026db305f8a2ef2871065caddd1c6513b9b38dc0b26a1b76bd70.source",
      "disposition": "unchanged-sound; historical prerequisite hold resolved",
      "finding": "Constant-zero false-null p-value is independent of the exact-uniform true null. R=2 iff P1<=1/2, otherwise R=1; V is 1 iff both rejected. FDR=1/4, FWER=1/2. The measure-zero P1=0 tie still yields R=2. Global-null comparison is the pointwise V=R identity, independent of BH."
    }
