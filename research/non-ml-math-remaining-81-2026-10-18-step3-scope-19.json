  "refuter_findings": [
    {
      "obligation": "refuter:19:1",
      "id": "lem-finite-conditional-codebook-covering",
      "location": "Proof 1.1",
      "defect": "false-claim",
      "evidence": "The Statement draws codewords from “P_{U|V}^{⊗n}(·|v^n),” but Proof 1.1 says a triple frequency has mean “P̂_{vⁿxⁿ}(v,x)P_{U|X,V}(u|x,v).” Under the stated codebook law, the mean is P̂(v,x)P_{U|V}(u|v). For V constant and U=X a fair bit, a fixed typical xⁿ has actual mean frequency for (X,U)=(0,0) near 1/4, not the claimed target 1/2. Thus the claimed concentration on the target-typical set does not follow, and Step 2.1’s one-word probability lower bound lacks its stated premise.",
      "severity": "fatal",
      "observed_sha256": "485f71b3502f8d0cec67abc885d1ec09f34f74ae85ca29a97ecac2e71d325019"
    }
