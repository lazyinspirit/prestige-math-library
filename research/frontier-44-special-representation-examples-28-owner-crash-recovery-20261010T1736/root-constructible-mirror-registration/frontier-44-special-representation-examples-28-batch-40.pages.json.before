        "id": "ex-dualizing-and-closed-support-shifts-on-the-complex-line",
        "kind": "example",
        "title": "Dualizing and support shifts on the complex line",
        "deps": [
          "def-axiom-of-choice",
          "def-compactly-supported-global-sections",
          "def-derived-category-of-an-abelian-category",
          "def-derived-hom-in-the-bounded-setting",
