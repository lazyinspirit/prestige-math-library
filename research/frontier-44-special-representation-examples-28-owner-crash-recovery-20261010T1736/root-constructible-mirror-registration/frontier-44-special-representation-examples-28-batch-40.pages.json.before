        },
        "axiom_use": "AC is assumed and consumed through the injective models of the ordinary-operations and exceptional-adjunction suppliers and through the c-soft acyclicity supplier; the support, base-change, projection and trace comparisons are otherwise canonical restriction/tensor formulas.",
        "dependency_level": 15
      },
      {
        "id": "thm-verdier-duality-on-oriented-stratified-complex-varieties",
        "kind": "theorem",
        "title": "Constructible Verdier duality and complex orientation",
        "deps": [
          "def-algebraically-constructible-complex-of-analytic-field-sheaves",
