    {
      "id": "prop-a-morphism-carries-members-to-members-and-preserves-equivalence",
      "statement": "If $x:X \\to A$ is a member of $A$, then $f x:X \\to B$ is a member of $B$. If $x \\equiv y$ as members of $A$, then $f x \\equiv f y$ as members of $B$.",
      "used_by": [
        "thm-chasing-rule-monicity-detected-by-members",
