    },
    {
      "id": "def-exact-sequence-and-short-exact-sequence-in-an-abelian-category",
      "statement": "A sequence of morphisms in an abelian category is exact when it is exact at every interior object ... $0\\to A\\xrightarrow{i}B\\xrightarrow{p}C\\to 0$ is a short exact sequence when it is exact at $A$, at $B$, and at $C$.",
      "used_by": [
        "thm-a-short-exact-sequence-is-a-kernel-cokernel-pair",
        "thm-degenerate-exactness-criteria",
        "def-split-short-exact-sequence-in-an-abelian-category",
        "thm-a-square-is-cartesian-exactly-when-a-short-sequence-is-exact",
        "thm-ab5-is-equivalent-to-exactness-of-filtered-colimits"
      ]
    },
    {
      "id": "thm-degenerate-exactness-criteria",
      "statement": "In an abelian category: $0 \\to K \\xrightarrow{u} A$ is exact iff $u$ is monic; $0 \\to K \\xrightarrow{u} A \\xrightarrow{v} B$ is exact iff $u$ is a kernel of $v$; $A \\xrightarrow{v} B \\xrightarrow{w} C \\to 0$ is exact iff $w$ is a cokernel of $v$; and $0 \\to A \\xrightarrow{u} B \\xrightarrow{v} C \\to 0$ is exact iff $u$ is monic and $v$ is a cokernel of $u$, equivalently iff $u$ is a kernel of $v$ and $v$ is epic.",
      "used_by": [
        "thm-a-square-is-cartesian-exactly-when-a-short-sequence-is-exact",
        "thm-a-cartesian-square-over-an-epimorphism-is-also-cocartesian",
        "thm-the-kernel-row-and-cokernel-row-of-a-morphism-of-short-exact-sequences-are-exact-at-two-nodes-each",
        "thm-hom-is-left-exact-in-each-variable",
        "thm-ab5-is-equivalent-to-exactness-of-filtered-colimits"
      ]
    },
    {
      "id": "thm-exactness-is-self-dual",
      "statement": "A composable pair $A\\xrightarrow{f}B\\xrightarrow{g}C$ is exact at $B$ in an abelian category $\\mathcal A$ if and only if the opposite pair $C\\xrightarrow{g^{\\mathrm{op}}}B\\xrightarrow{f^{\\mathrm{op}}}A$ is exact at $B$ in $\\mathcal A^{\\mathrm{op}}$.",
      "used_by": [
        "thm-the-kernel-row-and-cokernel-row-of-a-morphism-of-short-exact-sequences-are-exact-at-two-nodes-each",
