  "load_bearing": [
    {
      "id": "lem-affine-blowup-algebra-properties",
      "statement": "For a commutative ring A, ideal I and a∈I, A[I/a] is the degree-zero localization of R(I) at at. The image of a is a nonzerodivisor, IA[I/a]=aA[I/a], and localization at a is A_a. For I=(a,a₁,…,a_r), the incidence presentation surjects onto A[I/a] with kernel its a-power torsion. Reduced A gives reduced charts; a domain A and a≠0 give domain charts. The construction is independent of generators and fraction representatives.",
      "used_by": [
        "thm-affine-blowup-standard-charts",
        "thm-pullback-center-ideal-invertible",
        "thm-blowup-universal-property",
        "thm-blowup-regular-surface-closed-point-regular",
        "thm-blowup-closed-immersion-transform-universal"
      ]
    },
    {
      "id": "lem-hilbert-uniform-regularity-fixed-polynomial",
      "statement": "Assume AC and DC. For fixed n,p≥0 and numerical polynomial Q, every coherent K⊂O^p on P^n_k with polynomial Q is R(n,p,Q)-regular, independently of the field. Consequently fixed quotient polynomial bounds both kernel and quotient regularity; the assertion also holds for a fixed finite sum of twists.",
      "used_by": [
        "lem-hilbert-uniform-sections-after-flat-pullback",
        "lem-hilbert-projective-space-construction",
        "lem-hilbert-valuative-flat-closure",
        "lem-hilbert-regularity-independent-of-ambient-dimension"
      ]
    },
    {
      "id": "lem-hilbert-relative-regularity-and-base-change",
      "statement": "Assume AC and DC. On P^n_T for arbitrary T, a finitely presented quasi-coherent base-flat F with all geometric fibres m-regular has, for r≥m, zero positive direct images, finite locally free degree-zero direct image of rank the fibre polynomial at r, arbitrary base-change compatibility, and surjective evaluation. For the stated base-flat finitely presented exact sequence with fibrewise m-regular K,E,F, its direct-image sequence is exact, locally free and compatible with every base change.",
      "used_by": [
        "lem-hilbert-uniform-sections-after-flat-pullback",
        "lem-hilbert-universal-scheme-theoretic-flattening",
        "lem-hilbert-projective-space-construction",
        "lem-hilbert-coherent-projective-bundle-construction"
      ]
    },
    {
      "id": "lem-hilbert-universal-scheme-theoretic-flattening",
      "statement": "Assume AC and DC. For coherent F on P^n_S with S Noetherian, finitely many fibre Hilbert polynomials occur. Each P has a locally closed S_P, empty if unrealized, such that for every T→S, F_T is flat with every fibre polynomial P iff the map factors through S_P. The coproduct universally represents flat pullbacks after decomposition into open and closed polynomial loci; no reduction is implicit.",
      "used_by": [
        "lem-hilbert-projective-space-construction",
        "lem-hilbert-coherent-projective-bundle-construction",
        "cex-fibrewise-subschemes-without-flatness-do-not-form-a-hilbert-family"
      ]
    },
    {
      "id": "thm-blowup-universal-property",
      "statement": "Assume AC. For a finite-type quasi-coherent center ideal I on X with zero scheme Z, every X-scheme Y whose scheme-theoretic inverse image of Z is effective Cartier has a unique X-morphism to Bl_I X; the blowup is final in this category.",
      "used_by": [
        "cor-blowup-unique-up-to-unique-isomorphism",
        "thm-blowup-effective-cartier-divisor-isomorphism",
        "thm-blowup-closed-immersion-transform-universal"
      ]
    },
    {
      "id": "thm-blowup-closed-immersion-transform-universal",
      "statement": "Assume AC. For finite-type quasi-coherent I on any scheme X and closed W⊂X, the strict transform is canonically Bl_{IO_W}W over W. Its chart ideal is the saturation of the extended ideal of W by the chart denominator. Strict transform commutes with finite scheme-theoretic unions.",
      "used_by": [
        "lem-regularization-of-curve-on-noetherian-ambient-by-point-blowups",
        "thm-separation-of-regular-curve-components-by-point-blowups"
      ]
    },
    {
      "id": "thm-blowup-regular-surface-closed-point-regular",
      "statement": "Assume AC. Blowing up a closed point of a regular finite-type k-scheme of pure dimension two gives a regular scheme of pure dimension two. E is effective Cartier, canonically P_κ(m/m²), and O_E(E)=O(-1). Over the local ring the two incidence quotient charts glue by inverse ratios, with exceptional local dimensions one generically and two at closed points. If S is smooth and p k-rational, the blowup is smooth; no general imperfect-field smoothness assertion is made.",
      "used_by": [
        "thm-blowup-smooth-surface-point-charts",
        "lem-blowup-multiplicity-euler-characteristic-drop",
        "thm-resolution-plane-curves-by-point-blowups",
        "lem-blowup-intersection-matrix-at-smooth-point"
      ]
    },
    {
      "id": "lem-blowup-multiplicity-euler-characteristic-drop",
      "statement": "Assume AC. For a reduced effective Cartier curve C on a regular surface proper over k with an ample invertible sheaf, blowing up a closed point of C of residue degree r and positive local-equation order m gives π*C=C′+mE, χ_k(O_C′)=χ_k(O_C)+r·m(m−1)/2, and δ_k(C′)=δ_k(C)−r·m(m−1)/2.",
      "used_by": [
        "thm-resolution-plane-curves-by-point-blowups"
      ]
    },
    {
      "id": "lem-hilbert-regularity-independent-of-ambient-dimension",
      "statement": "Assume AC and DC. For every numerical polynomial P there is b(P)≥0 bounding regularity of both kernel and quotient of every coherent O^p→F on every P^n over every field with polynomial P, independently of n and p. For realizable nonzero P, a=b(ΔP) and b(P)=a+max(0,P(a))+1 suffice; b(0)=0.",
      "used_by": [
        "lem-hilbert-coherent-projective-bundle-construction"
      ]
    },
    {
      "id": "thm-hilbert-scheme-represents-projective-flat-families",
      "statement": "Assume AC and DC. Over any locally Noetherian S, a finitely presented projective X/S in the coherent-bundle convention and relatively ample L have, for each P, a proper finitely presented representative on all S-schemes, globally embedded in a coherent projective bundle, with universal embedded flat finitely presented family. A specified global projective-space embedding inducing L gives H-projectivity. The full representative is the coproduct over P, locally finitely presented and potentially non-quasi-compact. Every base change, including non-Noetherian targets, preserves these representing properties and families.",
      "used_by": [
        "lem-universal-family-and-hilbert-polynomial-strata",
        "ex-full-hilbert-functor-of-p1-has-infinitely-many-strata"
      ]
    },
    {
      "id": "lem-closed-subgroup-scheme-valued-point-criterion",
      "statement": "For a finite-type k-group scheme G and closed subscheme H⊂G, H has the unique induced closed-subgroup structure iff H(R)⊂G(R) is a subgroup for every commutative unital k-algebra R; equivalently identity, restricted multiplication and restricted inverse factor through H. No reducedness, smoothness or algebraic closedness is imposed.",
      "used_by": [
        "cex-alpha-p-mu-p-rational-points-do-not-detect-scheme"
      ]
    }
  ],
