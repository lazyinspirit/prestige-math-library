  "load_bearing": [
    {
      "id": "thm-frattini-quotient-is-the-largest-elementary-abelian-quotient",
      "statement": "For a finite p-group P, the quotient P/Φ(P) is elementary abelian, and for N normal in P the quotient P/N is elementary abelian if and only if Φ(P)≤N.",
      "used_by": [
        "thm-frattini-subgroup-formula-for-a-finite-p-group",
        "cor-frattini-free-finite-p-groups-are-elementary-abelian",
        "def-generator-rank-of-a-finite-p-group",
        "thm-burnside-basis-theorem",
        "cor-every-nonfrattini-element-belongs-to-a-minimal-generating-set",
        "cor-maximal-subgroups-of-a-finite-p-group-are-frattini-hyperplanes",
        "thm-automorphisms-act-linearly-on-the-frattini-quotient"
      ]
    },
    {
      "id": "thm-frattini-subgroup-formula-for-a-finite-p-group",
      "statement": "For every finite p-group P, the subgroup P^p is characteristic and Φ(P)=P′P^p, where P′=[P,P] and P^p is the subgroup generated by the pth powers.",
      "used_by": [
        "prop-frattini-subgroup-monotonicity-for-subgroups-of-finite-p-groups",
        "prop-frattini-subgroup-of-a-quotient-finite-p-group",
        "prop-frattini-subgroup-of-a-direct-product-of-finite-p-groups",
        "cor-frattini-subgroup-of-a-finite-two-group-is-the-square-subgroup",
        "ex-frattini-subgroup-of-a-cyclic-p-group",
        "ex-generator-rank-of-upper-unitriangular-groups"
      ]
    },
    {
      "id": "thm-burnside-basis-theorem",
      "statement": "A subset X of a finite p-group P is a minimal generating set if and only if the quotient map restricts to a bijection from X onto a basis of P/Φ(P). Equivalently, the indexed family (xΦ(P)) indexed by x∈X is a basis.",
      "used_by": [
        "cor-minimal-generating-sets-of-a-finite-p-group-have-equal-size",
        "cor-every-nonfrattini-element-belongs-to-a-minimal-generating-set",
        "cor-nontrivial-finite-p-group-is-cyclic-iff-generator-rank-one",
        "thm-hall-burnside-automorphism-theorem"
      ]
    },
    {
      "id": "lem-finite-elementary-abelian-p-groups-have-bases-and-basis-extension",
      "statement": "Every finite elementary abelian p-group has a basis; every independent subset extends to a basis, every spanning subset contains a basis, and all bases have the same finite size.",
      "used_by": [
        "thm-frattini-quotient-is-the-largest-elementary-abelian-quotient",
        "def-generator-rank-of-a-finite-p-group",
        "thm-burnside-basis-theorem",
        "cor-minimal-generating-sets-of-a-finite-p-group-have-equal-size",
        "cor-every-nonfrattini-element-belongs-to-a-minimal-generating-set",
        "cor-maximal-subgroups-of-a-finite-p-group-are-frattini-hyperplanes"
      ]
    },
    {
      "id": "cor-generation-is-detected-modulo-the-frattini-subgroup",
      "statement": "A subset S of a finite group G generates G if and only if its image generates G/Φ(G).",
      "used_by": [
        "thm-burnside-basis-theorem"
      ]
    },
    {
      "id": "lem-frattini-subgroup-is-characteristic",
      "statement": "For every finite group G, the subgroup Φ(G) is characteristic in G and hence normal.",
      "used_by": [
        "cor-generation-is-detected-modulo-the-frattini-subgroup",
        "thm-frattini-quotient-is-the-largest-elementary-abelian-quotient",
        "thm-automorphisms-act-linearly-on-the-frattini-quotient",
        "cex-frattini-image-under-a-nonsurjective-homomorphism"
      ]
    },
    {
      "id": "thm-hall-burnside-automorphism-theorem",
      "statement": "Let P be a finite p-group, and let A≤Aut(P) be a finite subgroup whose order is not divisible by p. If A acts trivially on P/Φ(P) through ρ_P, then A=1.",
      "used_by": [
        "cor-kernel-of-the-action-on-the-frattini-quotient-is-a-p-group",
        "ex-hall-burnside-detects-a-nontrivial-coprime-automorphism"
      ]
    }
  ],
