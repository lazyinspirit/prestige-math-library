  ],
  "forwardRefs": [],
  "items": [
   {
    "id": "ex-rational-function-field-order",
    "kind": "example",
    "title": "The rational function field $\\mathbb{R}(t)$ ordered by the eventual sign is an ordered field, worked out",
    "deps": [
     "cex-ordered-field-not-archimedean",
     "def-ordered-field",
     "def-field"
    ],
    "strategy": "direct"
   },
   {
    "id": "ex-field-ordered-in-two-ways",
    "kind": "example",
    "title": "$\\mathbb{Q}(\\sqrt{2})$ carries exactly two distinct field orders, exchanged by the conjugation $\\sqrt{2} \\mapsto -\\sqrt{2}$",
    "deps": [
     "def-ordered-field",
     "def-field",
     "thm-of-square-roots",
     "fs-sqrt2-rational",
     "def-rationals",
