    "strategy": "direct"
   },
   {
    "id": "cex-stolz-cesaro-converse-fails",
    "kind": "counterexample",
    "title": "$a_k = (-1)^k$, $b_k = k$ have $a_k/b_k \\to 0$ while the difference quotient oscillates, so Stolz-Cesaro has no converse",
    "deps": [
