   },
   {
    "id": "cex-rolle-fails-over-a-non-complete-field",
    "kind": "counterexample",
    "title": "Over $\\mathbb{Q}$ there is a nonconstant differentiable function with identically zero derivative, so Rolle and the mean value theorem both fail",
    "deps": [
