      ]
    },
    {
      "id": "def-c-sparse-and-c-restricted-vertex-set",
      "statement": "A nonempty X is c-sparse when |N_G(x)∩X|≤c|X| for every x∈X, c-dense when each x has at most c|X| non-neighbours in X\\{x}, and c-restricted when either condition holds.",
      "used_by": [
        "lem-a-sparse-set-has-small-self-density",
        "lem-a-weakly-sparse-set-has-a-large-sparse-subset",
