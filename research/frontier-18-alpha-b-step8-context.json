        "cor-rodl-every-h-free-graph-has-a-linear-restricted-set"
      ]
    },
    {
      "id": "def-diagonal-lattice-path-and-its-height",
      "statement": "A diagonal path uses U=(1,1), D=(1,−1); from (0,a) it has v(i)=(i,h(i)) with height increments ±1, and h(i)=a+2μ(i)−i.",
      "used_by": [
        "lem-reflection-at-the-first-visit-to-a-level-is-a-bijection",
        "thm-reflection-principle-for-diagonal-lattice-paths",
        "thm-ballot-problem",
        "def-dyck-path-and-semilength",
        "thm-chung-feller"
      ]
    },
    {
      "id": "def-standard-bilinear-form-on-a-coordinate-space",
      "statement": "On F^n, ⟨x,y⟩=Σ_{i<n}x_i y_i is a symmetric nondegenerate bilinear form; over F_2, ⟨x,x⟩=Σ_i x_i and it is not an inner product.",
      "used_by": [
        "lem-the-standard-form-of-two-incidence-vectors-is-the-intersection-size",
        "thm-oddtown",
        "thm-eventown",
        "thm-every-maximal-eventown-family-is-maximum",
        "thm-nonuniform-fisher-inequality"
      ]
    },
    {
      "id": "def-cyclic-shift-and-the-periodic-partial-sum-function",
      "statement": "For m≥1, (σ^j a)_i=a_{(i+j) mod m}, ||a||=Σ_{i<m}a_i, and S_a(qm+r)=q||a||+Σ_{i<r}a_i for 0≤r<m.",
      "used_by": [
        "lem-cyclic-shift-is-an-action-of-the-integers-modulo-the-length",
        "lem-cyclic-shift-positivity-is-a-strict-right-minimum-of-the-partial-sums",
        "lem-strict-right-minima-of-a-quasiperiodic-partial-sum-function",
        "thm-cycle-lemma",
        "thm-chung-feller"
      ]
    },
    {
      "id": "def-catalan-number",
      "statement": "For n∈N, C_n:=|D_n| is the number of Dyck paths of semilength n; C_0=C_1=1.",
      "used_by": [
        "thm-catalan-numbers-by-reflection",
        "thm-catalan-numbers-by-the-cycle-lemma",
        "thm-catalan-recurrence",
        "def-catalan-generating-function",
        "thm-chung-feller"
      ]
    },
    {
      "id": "thm-gallai-modular-decomposition",
      "statement": "For |V(G)|≥2 exactly one holds: G is disconnected and its component quotient is edgeless; the complement is disconnected and the anticomponent quotient is complete; or both are connected and the maximal proper modules form a modular partition with prime quotient.",
      "used_by": [
        "cor-the-prime-quotient-has-at-least-four-vertices",
        "cor-the-modular-partition-with-a-prime-quotient-is-unique",
        "ex-the-modular-decomposition-of-a-blown-up-five-cycle"
      ]
    },
    {
      "id": "thm-substitution-preserves-the-erdos-hajnal-property",
      "statement": "If H_1 and H_2 have the Erdős–Hajnal property and H=H_1[v→H_2] is defined, then H has the Erdős–Hajnal property.",
      "used_by": [
        "cor-the-erdos-hajnal-conjecture-reduces-to-prime-graphs",
        "cor-blowing-up-a-vertex-preserves-the-erdos-hajnal-property",
        "ex-a-four-vertex-graph-with-the-erdos-hajnal-property-by-substitution"
      ]
    },
    {
      "id": "thm-nikiforov-few-induced-copies-force-a-linear-restricted-set",
      "statement": "For every graph H and ε∈(0,1/2), some δ>0 makes every nonempty G with ind_H(G)<(δ|V(G)|)^{|V(H)|} contain an ε-restricted set of size at least δ|V(G)|.",
      "used_by": [
        "cor-rodl-every-h-free-graph-has-a-linear-restricted-set",
        "cor-nikiforov-applies-to-every-linearly-large-induced-subgraph",
        "rem-the-size-of-the-constant-in-rodls-theorem"
      ]
    },
    {
      "id": "thm-combinatorial-nullstellensatz",
      "statement": "If deg f=Σ_i t_i, the coefficient of x_1^{t_1}⋯x_n^{t_n} is nonzero, and |S_i|>t_i, then f is nonzero at some point of S_1×⋯×S_n.",
      "used_by": [
        "thm-cauchy-davenport",
        "thm-alon-furedi-hyperplane-cover-of-the-cube",
        "ex-the-combinatorial-nullstellensatz-on-a-two-variable-polynomial"
      ]
    },
    {
      "id": "thm-sauer-shelah",
      "statement": "If a family F⊆P([n]) has VC dimension at most d, then |F|≤Σ_{i=0}^d binom(n,i).",
      "used_by": [
        "cor-sauer-shelah-polynomial-bound",
        "thm-sauer-shelah-by-multilinear-polynomials",
        "ex-a-family-of-vc-dimension-two-attaining-the-sauer-shelah-bound"
      ]
    },
    {
      "id": "thm-cycle-lemma",
      "statement": "If a has length m, every a_i≤1, and ||a||=k≥1, then exactly k starting indices j∈{0,…,m−1} give σ^j a with every nonempty partial sum positive.",
      "used_by": [
        "thm-catalan-numbers-by-the-cycle-lemma",
        "ex-the-cycle-lemma-on-a-word-of-length-seven"
      ]
    },
    {
      "id": "lem-sign-reversing-involution-on-intersecting-path-systems",
      "statement": "There is an involution on intersecting path systems that changes the endpoint permutation by odd sign: sgn(π′)=−sgn(π).",
      "used_by": [
        "thm-lindstrom-gessel-viennot",
        "ex-the-tail-swap-involution-on-an-intersecting-pair"
      ]
    },
    {
      "id": "thm-lindstrom-gessel-viennot",
      "statement": "The determinant of the matrix of monotone-path counts equals the signed sum of non-intersecting π-systems; for a compatible configuration only the identity system contributes.",
