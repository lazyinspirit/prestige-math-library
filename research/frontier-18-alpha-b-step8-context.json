  "load_bearing": [
    {
      "id": "def-module-of-a-graph",
      "statement": "A vertex set M is a module of G when every vertex outside M is adjacent to every vertex of M or to no vertex of M; the trivial modules are ∅, the singletons, and V(G).",
      "used_by": [
        "lem-module-criteria",
        "def-prime-graph",
        "def-substitution-of-a-graph-for-a-vertex",
        "def-modular-partition-and-quotient-graph",
