  "item_support": [
    {
      "item": "def-critical-detection-and-quantification-levels",
      "deps": [
        "def-statistical-experiment",
        "def-random-element-and-real-random-variable",
        "def-randomized-test",
        "def-test-size-and-power",
        "def-moments-variance-and-covariance",
        "def-expectation-of-a-nonnegative-or-integrable-random-variable",
        "def-borel-sigma-algebra",
        "cor-expectation-of-an-indicator-is-probability",
        "lem-probability-measure-basic-identities"
      ],
      "argument": "Defines the response-only experiment, exact and conservative blank threshold, false-negative probability, and CV-qualified least concentration. It makes existence conditional and does not assert a universal calibration formula."
    },
    {
      "item": "lem-standard-normal-cdf-quantiles-and-symmetry",
      "deps": [
        "def-standard-normal-and-normal-laws",
        "def-cumulative-distribution-function-of-a-random-variable",
        "def-probability-measure",
        "lem-normal-density-has-total-mass-one",
        "thm-derivative-of-exponential",
        "cor-integral-over-a-null-set-vanishes",
        "thm-continuity-from-above-for-measures",
        "thm-continuity-from-below-for-measures",
        "thm-intermediate-value",
        "thm-substitution-for-improper-integrals",
        "thm-lebesgue-measure-of-a-box-of-every-kind",
        "def-axiom-of-choice",
        "def-countable-choice",
        "lem-axiom-of-choice-implies-countable-choice",
        "lem-probability-measure-basic-identities"
      ],
      "argument": "The density is continuous, positive, even, and integrates to one. Probability set differences turn density integrals over intervals into CDF increments; continuity of measures gives the endpoint limits; IVT gives existence and strict increase gives unique quantiles. Reflection of the density and the zero singleton mass give z_(1-q)=-z_q. AC supplies the normal law; CC is inherited only for the zero-width-box null-set supplier."
    },
    {
      "item": "lem-normal-location-scale-mean-and-variance",
      "deps": [
        "def-standard-normal-and-normal-laws",
        "def-moments-variance-and-covariance",
        "lem-gaussian-even-moment-bound-for-brownian-increments",
        "thm-change-of-variables-for-expectation",
        "cor-cauchy-schwarz-for-random-variables",
        "cor-expectation-linearity-monotonicity-and-modulus-bound",
        "thm-dominated-convergence",
        "thm-substitution",
        "def-axiom-of-choice"
      ],
      "argument": "The Gaussian even-moment supplier gives E[Z^2]=1. Cauchy–Schwarz makes Z integrable; symmetry makes each centered truncation's mean zero; dominated convergence yields E[Z]=0. The location-scale push-forward and change-of-variables for expectation then give E[X]=m and Var(X)=sigma^2."
    },
    {
      "item": "thm-known-normal-blank-detection-and-quantification-limits",
      "deps": [
        "def-critical-detection-and-quantification-levels",
        "lem-standard-normal-cdf-quantiles-and-symmetry",
        "lem-normal-location-scale-mean-and-variance",
        "def-standard-normal-and-normal-laws",
        "def-cumulative-distribution-function-of-a-random-variable",
        "def-statistical-experiment",
        "def-borel-sigma-algebra",
        "def-measurable-function-between-measurable-spaces",
        "def-randomized-test",
        "def-test-size-and-power",
        "lem-measurable-rejection-function-defines-randomized-test",
        "cor-expectation-of-an-indicator-is-probability",
        "def-axiom-of-choice",
        "lem-probability-measure-basic-identities"
      ],
      "argument": "The threshold indicator is measurable and defines a test. At c=0 the normal quantile and probability-complement identity give exact false-positive probability alpha; the indicator-expectation identity equates it with test size. Under c, the affine normal CDF gives false-negative beta at the unique concentration (z_(1-alpha)+z_(1-beta))*sigma_0. The local moment lemma gives CV(c)=sigma_0/c, whose least qualifying concentration is sigma_0/k_Q."
    },
    {
      "item": "ex-known-blank-normal-detection-and-quantification-limits",
      "deps": [
        "def-critical-detection-and-quantification-levels",
        "lem-standard-normal-cdf-quantiles-and-symmetry",
        "thm-known-normal-blank-detection-and-quantification-limits"
      ],
      "argument": "Substitutes alpha=beta=0.05 and k_Q=0.10 into the proved exact formulas; the NIST known-blank row independently records the rounded numerical multipliers."
    },
    {
      "item": "ex-estimated-blank-variance-inflates-detection-limits",
      "deps": [
        "thm-known-normal-blank-detection-and-quantification-limits"
      ],
      "argument": "Under the explicit corrected-response law N(c,sigma_0^2+tau^2), applies the theorem with sigma_eff=sqrt(sigma_0^2+tau^2) and proves strict inflation when tau>0. No universal law for blank estimation is asserted."
    },
    {
      "item": "ex-detection-limit-assumptions-and-left-censoring",
      "deps": [
        "def-critical-detection-and-quantification-levels",
        "lem-standard-normal-cdf-quantiles-and-symmetry",
        "lem-normal-location-scale-mean-and-variance",
        "def-standard-normal-and-normal-laws",
        "def-cumulative-distribution-function-of-a-random-variable",
        "def-axiom-of-choice",
        "lem-probability-measure-basic-identities"
      ],
      "argument": "The blank law fixes L_C using the normal quantile and probability-complement identity. Solving the concentration-dependent false-negative equation gives a finite detection limit exactly when z_(1-beta)*rho*sigma_0<1. CV(c)=sigma_0/c+rho*sigma_0 gives the stated finite-L_Q condition. A report Y<=L_C has the CDF probability, while the threshold point has zero probability."
    }
  ],
