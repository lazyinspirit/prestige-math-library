  "refuter_findings": [
    {
      "obligation": "refuter:16:1",
      "id": "thm-unitary-induction-in-stages",
      "location": "3.1",
      "defect": "false-claim",
      "evidence": "Step 3.1 states `r_{xh}(eL)=r_x(hL) rho_HL(e)/rho_HL(h)`. But the Statement defines `r_x(hL)=rho_GL(xh)/(rho_GH(xh)rho_HL(h))`, which gives `r_{xh}(eL)=rho_GL(xh)/(rho_GH(xh)rho_HL(e))=r_x(hL) rho_HL(h)/rho_HL(e)`. The displayed factor is reciprocal, so the stated equality fails in general; it is used to conclude `r_x(hL)^{1/2}F(xh)=Xi(x)(h)`.",
      "severity": "fatal",
      "observed_sha256": "5715bdee10e3fc370da9e8139a74fd27fa4b5d3c6e69e56f47baa0fdeb278451"
    }
