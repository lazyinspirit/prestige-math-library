        "ex-jump-and-continuous-parts-of-x-plus-rational-jumps"
      ]
    },
    {
      "id": "thm-riesz-rising-sun-lemma",
      "statement": "For the rising-sun set of a continuous function on [a,b], each component has its stated endpoint relation F(c)<=F(d), with equality away from the initial endpoint.",
      "used_by": [
        "thm-one-sided-hardy-littlewood-inequality-for-continuous-monotone-functions"
      ]
    },
    {
      "id": "thm-one-sided-hardy-littlewood-inequality-for-continuous-monotone-functions",
      "statement": "For continuous nondecreasing F, the stated upper-right and lower-left Dini-derivative level sets satisfy the two one-sided measure inequalities.",
      "used_by": [
        "thm-continuous-monotone-functions-are-differentiable-almost-everywhere-via-rising-sun"
      ]
    },
    {
      "id": "thm-vitali-covering-theorem-for-fine-covers-on-the-line",
      "statement": "A fine closed-interval cover of E with finite outer measure has a countable disjoint subfamily covering E up to an outer-null remainder, and finite approximants with arbitrarily small remainder.",
      "used_by": [
        "thm-mini-vitali-fine-cover-characterisation-of-null-sets",
        "rem-roydens-vitali-route-is-a-third-proof"
      ]
    },
    {
      "id": "thm-fubini-term-by-term-differentiation-for-series-of-increasing-functions",
      "statement": "For a finite pointwise sum F=sum F_n of nondecreasing functions, F'=sum F_n' almost everywhere.",
      "used_by": [
        "fs-every-increasing-function-satisfies-newton-leibniz",
        "ex-a-strictly-increasing-singular-function-from-a-dense-cantor-series"
      ]
    },
    {
      "id": "thm-pi-system-criterion-for-independent-sigma-algebras",
      "statement": "Independent pi-systems each containing the whole space generate an independent family of sigma-algebras.",
      "used_by": [
