      "id": "thm-a-finite-cw-homotopy-equivalence-is-simple-if-and-only-if-its-whitehead-torsion-vanishes",
      "statement": "A homotopy equivalence f:X→Y of finite CW complexes is simple iff τ(f)=0 in ⊕_{D∈π₀Y} Wh(π₁D), with basepoint changes transported canonically. This is a statement about finite CW complexes, with no smooth handle or cobordism assertion.",
      "used_by": [
        "ex-the-whitehead-group-of-the-trivial-group-is-zero",
        "cex-ordinary-acyclicity-forgets-basis-and-group-ring-torsion"
      ]
    },
    {
      "id": "thm-eastons-theorem-for-regular-cardinals",
      "statement": "For a GBC + Global Choice + GCH ground (M,C), a definable Easton class function F on every infinite regular cardinal of M, and M-generic G for P(F), M[G] is a ZFC model preserving ordinals, cardinals and cofinalities, with 2^κ=F(κ) at every infinite regular κ of M.",
      "used_by": [
        "rem-easton-singular-cardinal-caveat"
      ]
    },
    {
      "id": "thm-the-e-graph-has-the-erdos-hajnal-property",
      "statement": "There exists ε_E>0 such that every nonempty finite simple graph G with no induced copy of E has a clique or stable set of size at least |V(G)|^ε_E.",
