      ]
    },
    {
      "id": "thm-the-bird-graph-has-the-erdos-hajnal-property",
      "statement": "There exists ε_B>0 such that every nonempty finite simple graph G with no induced copy of Bird has a clique or stable set of size at least |V(G)|^ε_B.",
