    "after_citation": {
      "fact": "F2",
      "source": "lem-relu-bounded-product-approximation",
      "source_section": "Statement",
      "quote": "Fix $M>0$. For every $0<\\varepsilon<M^2$, there is a ReLU network $P_{M,\\varepsilon}$ on $[-M,M]^2$ that satisfies $|P_{M,\\varepsilon}(x,y)-xy|\\le\\varepsilon$ and $P_{M,\\varepsilon}(x,0)=P_{M,\\varepsilon}(0,y)=0$. Its depth, number of weights, and number of computation units are at most $C_M(1+\\log(M^2/\\varepsilon))$, where $C_M$ depends only on $M$.",
      "uses": [
        "1.2"
      ],
      "local_source_proof_consequence": {
