  "load_bearing": [
    {
      "id": "thm-ip-equals-pspace",
      "statement": "IP = PSPACE, where IP is the class of languages with a constant-error interactive proof and PSPACE is the class of languages decidable in polynomial space.",
      "used_by": [
        "cor-ip-is-closed-under-complement",
        "thm-ip-can-be-given-perfect-completeness"
      ]
    },
    {
      "id": "lem-multilinearization-preserves-boolean-values",
      "statement": "Multilinearization preserves Boolean values and bounds individual degree.",
      "used_by": [
        "def-multilinearization-operator",
        "lem-ordered-arithmetization-evaluates-to-the-truth-value",
        "def-shamir-protocol-for-tqbf",
        "lem-honest-prover-maintains-the-claim-invariant",
        "lem-each-round-has-polynomial-communication",
        "lem-first-false-claim-survives-with-root-bound-probability",
        "ex-multilinearization-preserves-boolean-values"
      ]
    },
    {
      "id": "lem-total-soundness-follows-by-union-bound",
      "statement": "The total TQBF soundness bound follows by union-bounding the first repaired false claim.",
      "used_by": [
        "def-shamir-protocol-for-tqbf",
        "thm-tqbf-has-a-polynomial-round-interactive-proof",
        "fs-the-verifier-trusts-the-final-field-value",
        "ex-ip-can-be-given-perfect-completeness"
      ]
    },
    {
      "id": "thm-gap-amplification-step",
      "statement": "For each fixed t≥t₀, the construction gives a complete uniform gap-preserving graph reduction with output gap at least β√t·min(UNSAT(G),c/t), perfect completeness, polynomial-time encoding, and parameters independent of input graph size; its alphabet grows with t.",
      "used_by": [
        "def-degree-reduction-by-expander-clouds",
        "thm-degree-reduction-preserves-unsatisfaction",
        "def-constraint-graph-powering",
        "lem-plurality-consistency-along-middle-walk-positions",
        "lem-powering-amplifies-small-gaps"
      ]
    },
    {
      "id": "lem-powering-amplifies-small-gaps",
      "statement": "For d-regular nonempty-edge G with α≤α₀ and every labeling φ of G_t, UNSATφ(G_t) ≥ β√t·min(UNSAT(G),1/t), for constants β>0,t₀ depending only on d, |Σ|,α₀ and t≥t₀.",
      "used_by": [
        "lem-plurality-consistency-along-middle-walk-positions",
        "lem-expander-walk-violated-edge-collision-bound",
        "lem-overlap-controlled-union-lower-bound",
        "lem-powering-preserves-perfect-satisfiability",
        "thm-gap-amplification-step"
      ]
    },
    {
      "id": "thm-explicit-code-construction-and-distance",
      "statement": "A deterministic uniform binary code family has N(k)<128k, rate>1/128, relative distance≥1/8, and an encoder computable in polynomial time in k.",
      "used_by": [
        "def-explicit-constant-rate-constant-distance-code",
        "def-reed-solomon-outer-code-and-binary-linear-inner-code"
      ]
    },
    {
      "id": "lem-exponential-base-assignment-tester-from-quadratic-oracles",
      "statement": "For each circuit and named input coordinates, the construction yields a binary arity-at-most-6 assignment tester with absolute rejection ratio ρ≥1/500 and at most 2^{q(s+m)} constraints for a fixed polynomial q.",
      "used_by": [
        "def-hadamard-linearity-constraint-system",
        "thm-linearity-test-rejects-proportionally-to-distance",
        "def-quadratic-consistency-test",
        "lem-quadratic-test-soundness",
        "lem-trivial-circuit-constraint-system-is-a-weak-assignment-tester"
      ]
    },
    {
      "id": "thm-bimodule-tensor-exactness-and-projective-preservation",
      "statement": "For graded (B,A)-bimodule M, M⊗A− is exact if M is right A-flat; it preserves finite graded projectives if M is finite graded projective as a left B-module. Neither hypothesis is asserted to imply the other.",
      "used_by": [
        "prop-restriction-and-extension-of-scalars-on-graded-module-categories",
        "ex-right-flat-bimodule-with-nonprojective-output",
        "ex-left-projective-bimodule-with-nonexact-tensor"
      ]
    },
    {
      "id": "thm-graded-bimodule-tensor-hom-adjunction",
      "statement": "The graded tensor–Hom currying bijection uses the direct sum of homogeneous B-linear maps; separately, the ungraded bijection uses all ungraded maps.",
      "used_by": [
        "prop-restriction-and-extension-of-scalars-on-graded-module-categories"
      ]
    },
    {
      "id": "thm-homological-gaussian-elimination-splits-off-a-contractible-two-term-complex",
      "statement": "With the stated invertible differential block, X is isomorphic as a cochain complex to the candidate reduction plus the contractible two-term pivot complex, and the explicit projection/inclusion give a homotopy equivalence.",
      "used_by": [
        "prop-homological-gaussian-elimination-gives-a-strong-deformation-retract",
        "cor-homological-gaussian-elimination-preserves-homotopy-type-and-homology",
        "prop-additive-functors-preserve-chosen-homological-gaussian-cancellations",
        "prop-transfer-of-chain-maps-across-gaussian-reductions-and-naturality-limits",
        "cex-a-nonunit-differential-entry-cannot-be-gaussian-cancelled"
      ]
    },
    {
      "id": "prop-homological-gaussian-elimination-gives-a-strong-deformation-retract",
      "statement": "The explicit p, ι, h satisfy pι=1, 1−ιp=dh+hd, ph=0, hι=0 and h²=0.",
      "used_by": [
        "cor-homological-gaussian-elimination-preserves-homotopy-type-and-homology",
        "thm-finite-iterated-homological-gaussian-elimination",
        "prop-additive-functors-preserve-chosen-homological-gaussian-cancellations",
        "prop-transfer-of-chain-maps-across-gaussian-reductions-and-naturality-limits",
        "ex-two-finite-cancellation-orders-and-their-composite-retracts"
      ]
    },
    {
      "id": "thm-finite-iterated-homological-gaussian-elimination",
      "statement": "A finite sequence of cancellations at invertible pivots in each current complex composes to strong deformation retract data; the statement makes no assertion for infinite sequences.",
      "used_by": [
        "ex-two-finite-cancellation-orders-and-their-composite-retracts"
      ]
    },
    {
      "id": "prop-transfer-of-chain-maps-across-gaussian-reductions-and-naturality-limits",
      "statement": "Transferred maps preserve identities and composition on homotopy classes, with the stated dk+kd defect; strict composition is not asserted and can fail.",
      "used_by": [
        "cex-gaussian-reduction-is-not-strictly-natural-for-arbitrary-chain-maps"
      ]
    }
  ],
