    "proposal": "research/non-ml-math-remaining-81-2026-10-18-owner-step2-qre-resolution/batch21-owner-addendum/proposal/items/lem-it-operator-jensen-negative-log.md",
    "proposal_sha256": "7466d574ed27105bbbcfd2a720818f22f90eaf9a9f29e790777e3a297ae352d9",
    "deps": [
      "lem-it-inverse-compression-resolvent",
