  {
    "id": "lem-it-relative-modular-representation",
    "target": "items/lem-it-relative-modular-representation.md",
    "current_sha256": "2ac79136808fe4500c8dd1fc0a83eee0a6949ec000616ba495e28889122717f2",
    "proposal": "research/non-ml-math-remaining-81-2026-10-18-owner-step2-qre-resolution/batch21-owner-addendum/proposal/items/lem-it-relative-modular-representation.md",
    "proposal_sha256": "60a66362dc7c0396758c166287e2ff10ff73ca49957827902744117c9742a7de",
    "deps": [
      "def-it-finite-dimensional-quantum-relative-entropy",
      "def-real-and-complex-inner-product-space",
      "thm-non-negative-operator-characterisations",
      "thm-non-negative-square-root-exists-and-is-unique",
      "thm-trace-of-ab-equals-trace-of-ba",
      "def-trace-of-an-endomorphism",
      "thm-adjoint-exists-and-is-unique-in-finite-dimension",
      "def-adjoint-of-a-linear-map-between-inner-product-spaces"
    ],
    "public_export": {
      "section": "Statement",
      "text": "Let $A,B$ be positive-definite operators on a nonzero finite-dimensional complex inner-product space $H$. On $\\mathcal L(H)$, with Hilbert-Schmidt inner product $\\langle X,Y\\rangle_{\\rm HS}:=\\operatorname{tr}(XY^*)$, define $\\Delta_{B,A}(X):=BXA^{-1}$. Then $\\Delta_{B,A}$ is positive definite and\n\n$$D(A\\|B)=\\langle(-\\ln\\Delta_{B,A})(A^{1/2}),A^{1/2}\\rangle_{\\rm HS}.$$\n\nThe logarithm of $\\Delta_{B,A}$ is defined by its positive eigenvalues."
    },
    "source_packet": "research/non-ml-math-remaining-81-2026-10-18-owner-step2-qre-resolution/batch21-owner-addendum"
  },
  {
