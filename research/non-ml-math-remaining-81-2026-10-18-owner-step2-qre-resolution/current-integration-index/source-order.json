    "proposal": "research/non-ml-math-remaining-81-2026-10-18-owner-step2-qre-resolution/batch24-owner-addendum/proposal/items/lem-it-finite-unitary-averaging-decoupling-bound.md",
    "proposal_sha256": "280a8d0c25570a530f84cb5ba485a567e0b7436362f880bca04b38426927a3b8",
    "deps": [
