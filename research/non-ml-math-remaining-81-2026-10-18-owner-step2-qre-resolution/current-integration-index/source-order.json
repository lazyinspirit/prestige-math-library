    "proposal": "research/non-ml-math-remaining-81-2026-10-18-owner-step2-qre-resolution/batch21-owner-addendum/proposal/items/lem-it-finite-povm-measurement-channel.md",
    "proposal_sha256": "71ea2d8810d9a5b67bb9705c320d34606ab2c8aa0374913bb6185e786e27a494",
    "deps": [
