    "proposal": "research/non-ml-math-remaining-81-2026-10-18-owner-step2-qre-resolution/batch24-owner-addendum/proposal/items/thm-it-finite-entropy-chain-rule.md",
    "proposal_sha256": "4714a2d8e0c93cc134c567e05a201fb7f66d7e85d09f31fd6017c5f5bafad568",
    "deps": [
      "def-it-finite-conditional-entropy",
      "def-it-finite-mutual-information",
      "def-it-finite-conditional-mutual-information",
      "thm-it-finite-conditional-mutual-information-identities-and-equality",
