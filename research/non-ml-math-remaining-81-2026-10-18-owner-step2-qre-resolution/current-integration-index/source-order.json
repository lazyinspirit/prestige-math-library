    "proposal": "research/non-ml-math-remaining-81-2026-10-18-owner-step2-qre-resolution/batch21-owner-addendum/proposal/items/ex-it-dephasing-quantum-relative-entropy-dpi.md",
    "proposal_sha256": "4104001f51637469836e1f9f8fe38285ef8a1878670402a2009b3f92f569fd88",
    "deps": [
