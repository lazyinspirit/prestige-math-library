[ 
  {
    "kind": "A",
    "category": "abstract-algebra",
    "id": "cyclic-groups-and-direct-products",
    "title": "Cyclic Groups and Direct Products",
    "companion": "cyclic-groups-and-direct-products-examples",
    "requires": [
      "group-homomorphisms-and-the-isomorphism-theorems"
    ],
    "items": [
      {
        "id": "def-external-direct-product-of-groups",
        "kind": "definition",
        "title": "The external direct product $G\\times H$ with componentwise multiplication",
        "deps": [
          "def-group"
        ]
      },
      {
        "id": "thm-external-direct-product-is-a-group",
        "kind": "theorem",
        "title": "$G\\times H$ is a group with identity $(e_G,e_H)$, coordinatewise inverses, and homomorphic coordinate projections",
        "strategy": "direct",
        "deps": [
          "def-external-direct-product-of-groups",
          "def-group",
          "def-group-homomorphism"
        ]
      },
      {
        "id": "prop-order-of-finite-direct-product",
        "kind": "proposition",
        "title": "For finite groups $G$ and $H$, $|G\\times H|=|G|\\,|H|$",
        "strategy": "direct",
        "deps": [
          "thm-external-direct-product-is-a-group",
          "def-order-in-a-group",
          "thm-product-rule"
        ]
      },
      {
        "id": "thm-order-of-element-in-direct-product",
        "kind": "theorem",
        "title": "If $g$ and $h$ have finite orders $m$ and $n$, then $\\operatorname{ord}(g,h)=\\operatorname{lcm}(m,n)$ in $G\\times H$",
        "strategy": "direct",
        "deps": [
          "thm-external-direct-product-is-a-group",
          "def-order-in-a-group",
          "lem-order-characterisation",
          "def-lcm",
          "thm-gcd-lcm-product",
          "thm-induction-principle"
        ]
      },
      {
        "id": "thm-classification-of-cyclic-groups",
        "kind": "theorem",
        "title": "Every cyclic group is isomorphic to $(\\mathbb Z,+)$ or to $(\\mathbb Z/n,+)$ for its finite order $n\\ge1$",
        "strategy": "direct",
        "deps": [
          "def-generated-subgroup",
          "lem-cyclic-subgroup-is-the-set-of-powers",
          "def-order-in-a-group",
          "lem-order-characterisation",
          "def-group-homomorphism",
          "lem-group-power-laws",
          "def-group-isomorphism-and-automorphism",
          "prop-integers-modulo-n-as-a-quotient-group"
        ]
      },
      {
        "id": "thm-subgroups-of-cyclic-groups-are-cyclic",
        "kind": "theorem",
        "title": "Every subgroup of a cyclic group is cyclic; the least positive exponent in a nontrivial subgroup supplies a generator",
        "strategy": "direct",
        "deps": [
          "def-subgroup",
          "def-generated-subgroup",
          "lem-cyclic-subgroup-is-the-set-of-powers",
          "lem-group-power-laws",
          "thm-division-algorithm-in-z",
          "thm-well-ordering-principle"
        ]
      }
    ],
    "order": 38
  },
  {
    "kind": "B",
    "category": "abstract-algebra",
    "id": "cyclic-groups-and-direct-products-examples",
    "title": "Cyclic Groups and Direct Products: Examples and Counterexamples",
    "requires": [
      "cyclic-groups-and-direct-products"
    ],
    "forwardRefs": [],
    "items": [
      {
        "id": "ex-klein-four-group-as-a-direct-product",
        "kind": "example",
        "title": "The Klein four-group as the direct product of two groups of order $2$",
        "strategy": "direct",
        "deps": [
          "thm-external-direct-product-is-a-group",
          "prop-integers-modulo-n-as-a-quotient-group",
          "def-addition-and-multiplication-modulo-n"
        ]
      },
      {
        "id": "cex-z-four-not-isomorphic-z-two-squared",
        "kind": "counterexample",
        "title": "The cyclic group $\\mathbb Z/4$ is not isomorphic to $\\mathbb Z/2\\times\\mathbb Z/2$",
        "strategy": "direct",
        "deps": [
          "thm-order-of-element-in-direct-product",
          "prop-integers-modulo-n-as-a-quotient-group",
          "lem-group-homomorphism-basic-properties",
          "def-group-isomorphism-and-automorphism"
        ]
      }
    ],
    "order": 39
  },
  {
    "kind": "A",
    "category": "abstract-algebra",
    "id": "group-actions-and-cayleys-theorem",
    "title": "Group Actions, Orbits, Stabilisers and Cayley's Theorem",
    "companion": "group-actions-and-cayleys-theorem-examples",
    "requires": [
      "group-homomorphisms-and-the-isomorphism-theorems"
    ],
    "items": [
      {
        "id": "def-group-action",
        "kind": "definition",
        "title": "Left group actions, transitive actions, and faithful actions",
        "deps": [
          "def-group"
        ]
      },
      {
        "id": "thm-group-actions-correspond-to-homomorphisms",
        "kind": "theorem",
        "title": "Actions of $G$ on $X$ correspond exactly to homomorphisms $G\\to\\operatorname{Sym}(X)$",
        "strategy": "direct",
        "deps": [
          "def-group-action",
          "def-group-homomorphism",
          "lem-group-homomorphism-basic-properties",
          "def-symmetric-group",
          "lem-symmetric-group-is-a-group"
        ]
      },
      {
        "id": "def-orbit-and-stabilizer",
        "kind": "definition",
        "title": "The orbit $G\\cdot x$ and stabilizer $G_x$ of a point in a group action",
        "deps": [
          "def-group-action"
        ]
      },
      {
        "id": "lem-stabilizer-is-a-subgroup",
        "kind": "lemma",
        "title": "The stabilizer $G_x$ is a subgroup of $G$",
        "strategy": "direct",
        "deps": [
          "def-orbit-and-stabilizer",
          "def-group-action",
          "def-subgroup",
          "lem-subgroup-criterion"
        ]
      },
      {
        "id": "thm-orbits-partition-the-set",
        "kind": "theorem",
        "title": "The orbits of a group action are the equivalence classes of $x\\sim y$ iff $y=g\\cdot x$ for some $g$, and hence partition the acted-on set",
        "strategy": "direct",
        "deps": [
          "def-group-action",
          "def-orbit-and-stabilizer",
          "def-equivalence-relation",
          "lem-equivalence-classes-partition"
        ]
      },
      {
        "id": "thm-cayleys-theorem",
        "kind": "theorem",
        "title": "Cayley's theorem: every group $G$ is isomorphic to a subgroup of $\\operatorname{Sym}(G)$",
        "strategy": "direct",
        "deps": [
          "def-group-action",
          "thm-group-actions-correspond-to-homomorphisms",
          "def-group-isomorphism-and-automorphism",
          "thm-image-subgroup-and-kernel-normal",
          "thm-group-homomorphism-injective-iff-trivial-kernel",
          "def-symmetric-group"
        ]
      }
    ],
    "order": 42
  },
  {
    "kind": "B",
    "category": "abstract-algebra",
    "id": "group-actions-and-cayleys-theorem-examples",
    "title": "Group Actions: Examples and Counterexamples",
    "requires": [
      "group-actions-and-cayleys-theorem"
    ],
    "forwardRefs": [],
    "items": [
      {
        "id": "ex-trivial-action-of-z-two-is-not-faithful",
        "kind": "example",
        "title": "The trivial action of $\\mathbb Z/2$ on a singleton is transitive but not faithful",
        "strategy": "direct",
        "deps": [
          "def-group-action",
          "thm-group-actions-correspond-to-homomorphisms",
          "prop-integers-modulo-n-as-a-quotient-group"
        ]
      }
    ],
    "order": 43
  }
]
