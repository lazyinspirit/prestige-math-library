[
  {
    "order": 523,
    "id": "stable-unstable-manifolds-and-morse-smale-transversality",
    "kind": "A",
    "category": "differential-topology",
    "title": "Stable Unstable Manifolds and Morse Smale Transversality",
    "companion": "stable-unstable-manifolds-and-morse-smale-transversality-examples",
    "requires": [
      "gradient-like-vector-fields-and-morse-trajectories-examples",
      "complete-metrizability-and-baire"
    ],
    "items": [
      {
        "id": "def-morse-smale-pair",
        "kind": "definition",
        "deps": [
          "def-downward-gradient-like-vector-field",
          "def-stable-and-unstable-sets-of-a-critical-point",
          "thm-global-stable-and-unstable-manifolds-are-immersed-euclidean-spaces",
          "def-transverse-smooth-maps"
        ],
        "title": "Morse--Smale pairs"
      },
      {
        "id": "def-parametrized-morse-trajectory-space",
        "kind": "definition",
        "deps": [
          "def-downward-gradient-like-vector-field",
          "def-stable-and-unstable-sets-of-a-critical-point",
          "thm-fundamental-theorem-on-flows"
        ],
        "title": "Parametrized Morse trajectory space",
        "strategy": "For a fixed complete downward gradient-like field, define full connecting flow lines with their endpoint limits and identify them with the stable-unstable intersection by evaluation and flow uniqueness."
      },
      {
        "id": "prop-parametrized-morse-trajectory-space-is-a-manifold",
        "kind": "proposition",
        "deps": [
          "def-morse-smale-pair",
          "def-parametrized-morse-trajectory-space",
          "thm-global-stable-and-unstable-manifolds-are-immersed-euclidean-spaces",
          "thm-transverse-fibre-product-theorem"
        ],
        "title": "A parametrized Morse trajectory space is a manifold"
      },
      {
        "id": "lem-time-translation-acts-freely-on-nonconstant-trajectories",
        "kind": "lemma",
        "deps": [
          "def-parametrized-morse-trajectory-space",
          "def-downward-gradient-like-vector-field",
          "thm-fundamental-theorem-on-flows"
        ],
        "title": "Time translation acts freely on nonconstant trajectories",
        "strategy": "A nonzero stabilizer would make the connecting orbit periodic, contradicting strict decrease of f along the nonconstant gradient-like orbit."
      },
      {
        "id": "def-unparametrized-morse-trajectory-moduli-space",
        "kind": "definition",
        "deps": [
          "def-parametrized-morse-trajectory-space",
          "lem-time-translation-acts-freely-on-nonconstant-trajectories"
        ],
        "title": "Unparametrized Morse trajectory moduli space"
      },
      {
        "id": "lem-evaluation-on-a-regular-level-identifies-unparametrized-trajectories",
        "kind": "lemma",
        "deps": [
          "def-unparametrized-morse-trajectory-moduli-space",
          "def-parametrized-morse-trajectory-space",
          "def-downward-gradient-like-vector-field",
          "thm-a-regular-level-set-is-an-embedded-submanifold",
          "thm-fundamental-theorem-on-flows"
        ],
        "title": "A regular level identifies unparametrized trajectories",
        "strategy": "Use strict decrease of f along the gradient-like flow and the endpoint limits to obtain a unique crossing of the chosen regular level."
      },
      {
        "id": "thm-unparametrized-trajectory-space-is-a-smooth-manifold",
        "kind": "theorem",
        "deps": [
          "def-morse-smale-pair",
          "prop-parametrized-morse-trajectory-space-is-a-manifold",
          "def-unparametrized-morse-trajectory-moduli-space",
          "lem-evaluation-on-a-regular-level-identifies-unparametrized-trajectories",
          "thm-transverse-fibre-product-theorem"
        ],
        "title": "The unparametrized trajectory space is a smooth manifold"
      },
      {
        "id": "cor-no-morse-smale-trajectories-for-nonpositive-index-drop",
        "kind": "corollary",
        "deps": [
          "thm-unparametrized-trajectory-space-is-a-smooth-manifold"
        ],
        "title": "No Morse--Smale trajectories for nonpositive index drop"
      },
      {
        "id": "lem-morse-smale-transversality-is-equivalent-to-surjectivity-of-the-linearized-flow-operator",
        "kind": "lemma",
        "deps": [
          "def-morse-smale-pair",
          "def-parametrized-morse-trajectory-space",
          "prop-parametrized-morse-trajectory-space-is-a-manifold",
          "def-riemannian-metric-symmetric-cotangent-connection-and-covariant-hessian",
          "thm-a-riemannian-metric-has-a-unique-levi-civita-connection-on-the-cotangent-bundle"
        ],
        "title": "Morse--Smale transversality and surjectivity of the linearized flow operator",
        "strategy": "Specify the C1_0-to-C0_0 operator using the tangent Levi-Civita connection, apply exponential-dichotomy Fredholm theory, and identify the dual cokernel with the annihilator of the stable-unstable tangent sum."
      },
      {
        "id": "def-fredholm-maps-and-regular-values-on-countable-banach-manifolds",
        "kind": "definition",
        "deps": [],
        "title": "Fredholm maps and regular values on countable-base Banach manifolds"
      },
      {
        "id": "thm-sard-smale-residual-regular-values-for-fredholm-maps",
        "kind": "theorem",
        "deps": [
          "def-fredholm-maps-and-regular-values-on-countable-banach-manifolds",
          "def-nowhere-dense-meagre-and-residual-subsets",
          "thm-morse-sard-for-euclidean-maps"
        ],
        "title": "Sard--Smale residual regular values for Fredholm maps",
        "strategy": "Cover the source by countably many closed locally proper pieces, apply Lyapunov-Schmidt reduction and finite Sard on each, and express the critical values as a countable union of nowhere-dense closed images."
      },
      {
        "id": "lem-universal-metric-trajectory-projection-is-fredholm",
        "kind": "lemma",
        "deps": [
          "def-parametrized-morse-trajectory-space",
          "def-fredholm-maps-and-regular-values-on-countable-banach-manifolds",
          "def-riemannian-metric-symmetric-cotangent-connection-and-covariant-hessian",
          "lem-morse-smale-transversality-is-equivalent-to-surjectivity-of-the-linearized-flow-operator"
        ],
        "title": "The universal metric--trajectory projection is Fredholm",
        "strategy": "Use localized metric variations to make the universal section transverse, compute the parametrized projection index, and subtract the free time-translation direction only after quotienting."
      },
      {
        "id": "lem-baire-diagonal-passage-from-finite-regularity-to-smooth-metrics",
        "kind": "lemma",
        "deps": [
          "def-nowhere-dense-meagre-and-residual-subsets",
          "thm-baire-category-for-complete-metric-spaces",
          "thm-sard-smale-residual-regular-values-for-fredholm-maps",
          "lem-universal-metric-trajectory-projection-is-fredholm"
        ],
        "title": "Baire diagonal passage from finite regularity to smooth metrics",
        "strategy": "Use countably many locally proper moduli pieces, prove their regularity sets open and dense directly in the smooth topology via smooth finite-regularity perturbations, then apply Baire under dependent choice."
      },
      {
        "id": "thm-morse-smale-metrics-are-residual-for-a-fixed-morse-function",
        "kind": "theorem",
        "deps": [
          "def-morse-smale-pair",
          "def-riemannian-metric-symmetric-cotangent-connection-and-covariant-hessian",
          "def-nowhere-dense-meagre-and-residual-subsets",
          "thm-sard-smale-residual-regular-values-for-fredholm-maps",
          "lem-universal-metric-trajectory-projection-is-fredholm",
          "lem-baire-diagonal-passage-from-finite-regularity-to-smooth-metrics"
        ],
        "title": "Morse--Smale metrics are residual for a fixed Morse function",
        "strategy": "Under dependent choice, intersect the finitely many pairwise residual transversality sets for the critical points of the fixed compact Morse function."
      },
      {
        "id": "thm-relative-morse-smale-perturbation-of-a-gradient-like-field",
        "kind": "theorem",
        "deps": [
          "def-morse-smale-pair",
          "def-downward-gradient-like-vector-field",
          "cor-a-morse-function-on-a-compact-manifold-has-finitely-many-critical-points",
          "thm-parametric-transversality",
          "thm-a-regular-level-set-is-an-embedded-submanifold"
        ],
        "title": "Relative Morse--Smale perturbation of a gradient-like field",
        "strategy": "Induct on stable destinations in descending critical-value order; move each stable sphere by a compactly supported normal displacement outside fixed small critical balls. Earlier destinations and both tangent manifolds at their intersections remain above every later support."
      },
      {
        "id": "prop-index-one-trajectory-spaces-are-zero-dimensional",
        "kind": "proposition",
        "deps": [
          "thm-unparametrized-trajectory-space-is-a-smooth-manifold"
        ],
        "title": "Index-one trajectory spaces are zero-dimensional"
      },
      {
        "id": "prop-index-two-trajectory-spaces-are-one-dimensional",
        "kind": "proposition",
        "deps": [
          "thm-unparametrized-trajectory-space-is-a-smooth-manifold"
        ],
        "title": "Index-two trajectory spaces are one-dimensional"
      },
      {
        "id": "lem-broken-morse-trajectories-have-strictly-decreasing-critical-values-and-indices",
        "kind": "lemma",
        "deps": [
          "def-parametrized-morse-trajectory-space",
          "def-downward-gradient-like-vector-field",
          "def-morse-smale-pair",
          "cor-no-morse-smale-trajectories-for-nonpositive-index-drop"
        ],
        "title": "Broken Morse trajectories have strictly decreasing critical values and indices",
        "strategy": "Use strict decrease of f for each gradient-like component and the nonpositive-index-drop emptiness result for each Morse-Smale component."
      },
      {
        "id": "rem-morse-smale-residuality-does-not-assert-simultaneous-genericity-for-all-data",
        "kind": "remark",
        "deps": [
          "thm-morse-smale-metrics-are-residual-for-a-fixed-morse-function",
          "thm-relative-morse-smale-perturbation-of-a-gradient-like-field"
        ],
        "title": "Morse--Smale residuality does not assert simultaneous genericity for all data"
      },
      {
        "id": "rem-ambient-orientability-is-not-required-for-morse-smale-transversality",
        "kind": "remark",
        "deps": [
          "def-morse-smale-pair",
          "thm-unparametrized-trajectory-space-is-a-smooth-manifold"
        ],
        "title": "Ambient orientability is not required for Morse--Smale transversality"
      }
    ]
  },
  {
