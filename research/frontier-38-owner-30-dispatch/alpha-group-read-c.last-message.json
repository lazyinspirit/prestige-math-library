  "load_bearing": [
    {
      "id": "thm-transverse-preimage-for-manifolds-with-boundary",
      "statement": "For a smooth map F from a manifold with boundary W to a boundaryless manifold N, transverse to a closed embedded Z both on W and on its boundary, F⁻¹(Z) is an embedded submanifold with boundary of codimension codim Z, with tangent space {v : dF(v) ∈ TZ}. Its boundary is its intersection with ∂W; it is neat in positive expected dimension. Boundary intersections are impossible in expected dimension zero, and negative expected dimension forces the empty preimage.",
      "used_by": [
        "thm-mod-two-intersection-number-is-homotopy-invariant",
        "lem-preimage-orientation-agrees-with-the-local-intersection-sign",
        "lem-oriented-boundary-of-an-intersection-trace-has-opposite-end-signs",
        "cor-a-null-cobordant-cycle-has-zero-intersection-with-a-disjoint-boundary"
      ]
    },
    {
      "id": "lem-boundary-of-a-compact-one-manifold-has-even-cardinality",
      "statement": "Assume ACω. A compact smooth 1-manifold, possibly with boundary and including the empty manifold, is diffeomorphic to a finite disjoint union of circles and closed intervals. Its boundary therefore has even cardinality.",
      "used_by": [
        "lem-oriented-boundary-of-a-compact-oriented-one-manifold-has-zero-signed-count",
        "thm-mod-two-intersection-number-is-homotopy-invariant",
        "cor-a-null-cobordant-cycle-has-zero-intersection-with-a-disjoint-boundary"
      ]
    },
    {
      "id": "thm-mod-two-intersection-number-is-homotopy-invariant",
      "statement": "Assume ACω. For compact boundaryless X, closed embedded Z in M, complementary dimensions, and a smooth family F:[0,1] × X → M transverse to Z including on its boundary faces, F⁻¹(Z) is a compact 1-manifold with boundary F0⁻¹(Z) disjoint union F1⁻¹(Z), and the endpoint cardinalities agree modulo two. Consequently I2 of arbitrary smooth maps is well defined and homotopy invariant.",
      "used_by": [
        "def-mod-two-intersection-number",
        "thm-oriented-intersection-number-is-homotopy-invariant",
        "ex-two-projective-lines-have-one-mod-two-intersection"
      ]
    },
    {
      "id": "lem-oriented-boundary-of-an-intersection-trace-has-opposite-end-signs",
      "statement": "Assume ACω. In the compact oriented complementary-dimensional transverse-family setting, orient F⁻¹(Z) by the prescribed preimage convention from [0,1] × X. Its outward-normal-first boundary signs are negative local intersection signs at time zero and positive local intersection signs at time one; their sum is I(F1,Z) − I(F0,Z).",
      "used_by": ["thm-oriented-intersection-number-is-homotopy-invariant"]
    },
    {
      "id": "lem-collar-gluing-and-corner-smoothing-give-transitivity",
      "statement": "Two supplied bordisms from M0 to M1 and from M1 to M2 glue along their common boundary using their outgoing and incoming collars to give a compact smooth bordism from M0 to M2. Their orientations glue in the oriented theory. Construction and transitivity need no choice; comparison of different collar presentations assumes ACω.",
      "used_by": [
        "thm-smooth-cobordism-is-an-equivalence-relation",
        "thm-cartesian-product-makes-bordism-a-graded-ring"
      ]
    },
    {
      "id": "lem-fundamental-class-of-a-boundary-pushes-forward-to-zero",
      "statement": "For compact R-oriented W with boundary M carrying its induced orientation, inclusion i:M → W satisfies i_*[M] = 0, and ⟨i*α,[M]⟩ = 0 for every α ∈ H^n(W;R). Canonical mod-two orientations apply without orientability, and the result is choice-free.",
      "used_by": [
        "prop-zero-dimensional-bordism-groups",
        "prop-boundaries-have-zero-stiefel-whitney-numbers",
        "prop-oriented-boundaries-have-zero-pontryagin-numbers"
      ]
    },
    {
      "id": "thm-disjoint-union-makes-bordism-classes-abelian-groups",
      "statement": "For each n ≥ 0, disjoint union makes Ωn^O and Ωn^SO abelian groups with the empty class as zero. Every unoriented class is its own inverse; the inverse of [M,o] is [-M]. No choice principle is used.",
      "used_by": [
        "prop-zero-dimensional-bordism-groups",
        "thm-cartesian-product-makes-bordism-a-graded-ring",
        "ex-the-pair-of-pants-is-a-cobordism-realizing-addition-of-circles"
      ]
    },
    {
      "id": "lem-tubular-charts-realize-a-prescribed-normal-identification",
      "statement": "Assume ACω. For a closed smooth embedding i:S → M and a supplied smooth bundle isomorphism α:E → ν(S), there is a tubular diffeomorphism from a neighbourhood of the zero section in E onto a neighbourhood of i(S), fixing that section and inducing exactly α on the normal quotient.",
      "used_by": ["def-pontryagin-thom-collapse-of-an-embedded-submanifold"]
    },
    {
      "id": "lem-collapse-map-is-independent-of-tubular-neighbourhood-and-radius-up-to-based-homotopy",
      "statement": "For compact S in X and fixed normal datum (E,α), collapses from any two compatible tubular charts, sufficiently small positive radii and supplied metrics have the same based homotopy class after canonical radial identification of metric targets.",
      "used_by": ["def-pontryagin-thom-collapse-of-an-embedded-submanifold"]
    },
    {
      "id": "prop-transverse-preimage-carries-a-pulled-back-normal-structure",
      "statement": "A continuous map to Th(E), smooth near its zero-section preimage and transverse there, has an embedded preimage of codimension rank E and an induced normal-bundle isomorphism to the pulled-back E, under the stated ACω smooth-bundle hypothesis. Boundary transversality gives a neat preimage and compatible boundary normal data. The zero stratum is closed in every rank and clopen in rank zero.",
      "used_by": ["lem-based-homotopies-transverse-to-the-zero-section-give-normal-cobordisms"]
    },
    {
      "id": "lem-thom-disk-sphere-quotient-identifies-relative-and-reduced-cohomology",
      "statement": "For a finite-rank real bundle with supplied continuous metric, the quotient map (D,S) → (D/S,{*}) induces a natural isomorphism from reduced cohomology of the based quotient to H^k(D,S;G), for every abelian G and integer k. Ordinary and compactly generated quotients, rank zero and empty bases are included; no additional choice is used.",
      "used_by": ["def-thom-class-and-thom-isomorphism-interface"]
    },
    {
      "id": "prop-collapse-pullback-of-the-thom-class-is-the-poincare-dual",
      "statement": "Assume AC. For an embedding i:S^s → M^m of closed smooth oriented manifolds, orient ν normal first relative to TS. With front-evaluation cap, the collapse satisfies c*uν ∩ [M] = i_*[S], hence c*uν = PDM(i_*[S]). The corresponding formula holds mod two without orientations and over commutative rings with compatible supplied orientations, including rank zero.",
      "used_by": ["thom-spaces-normal-data-and-collapse-maps"]
    }
  ],
