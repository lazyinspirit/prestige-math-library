  "load_bearing": [
    {
      "id": "lem-calderon-zygmund-decomposition-at-height-lambda",
      "statement": "Assume Countable Choice. For f∈L¹(Rⁿ) and λ>0, the maximal all-generation dyadic cubes give f=g+Σb_j a.e., with ∫b_j=0, ||b_j||₁≤2^(n+1)λ|Q_j|, ||g||₁≤||f||₁, |g|≤2ⁿλ a.e., ||g||₂²≤2ⁿλ||f||₁, and Σ|Q_j|≤λ⁻¹||f||₁; g and b_j have the displayed cube-average formulas.",
      "used_by": [
        "lem-cz-good-part-has-controlled-ltwo-image",
        "thm-calderon-zygmund-operator-has-weak-type-one-one",
        "thm-maximal-truncations-are-weak-one-one-and-strong-lp",
        "ex-calderon-zygmund-decomposition-of-an-interval-indicator"
      ]
    },
    {
      "id": "thm-calderon-zygmund-singular-integrals-are-bounded-on-lp",
      "statement": "Assume Countable Choice. A CZ operator with kernel constants A₁,A₂ and L² norm B extends uniquely to Lp for every 1<p<∞, with ||Tf||p≤C_n(A₂+B)max(p,(p−1)⁻¹)||f||p; the constant can be chosen independent of p.",
      "used_by": [
        "thm-maximal-truncations-are-weak-one-one-and-strong-lp",
        "cor-hilbert-transform-is-bounded-on-lp",
        "cor-riesz-transforms-are-bounded-on-lp",
        "thm-mihlin-fourier-multiplier-theorem"
      ]
    },
    {
      "id": "lem-stationary-phase-for-a-nondegenerate-compactly-supported-phase",
      "statement": "For d≥1, a smooth compactly supported amplitude and a smooth real phase, a nonvanishing gradient near the support gives O(λ⁻ᴺ) for every N≥0 and λ>0. Exactly one stationary point in the interior of the amplitude support, with invertible Hessian, gives O(λ^(-d/2)) for λ≥1 and centered kth parameter derivatives O(λ^(-d/2−k)), with the stated derivative and nondegeneracy controls.",
      "used_by": [
        "lem-stationary-phase-decay-for-spherical-surface-measure",
        "lem-localized-curved-patch-measure-transform-decay"
      ]
    },
    {
      "id": "lem-localized-curved-patch-measure-transform-decay",
      "statement": "Assume Countable Choice. For a smooth graph h and a∈C_c∞(U), with det D²h nonzero on supp a, the localized graph measure has inverse transform bounded by C_a(1+|x|)^(-(n−1)/2). The same holds for the specified compactly supported localization on a smooth hypersurface with nonvanishing curvature on its support.",
      "used_by": [
        "lem-graph-patch-extension-family-has-dispersive-and-ltwo-slice-bounds",
        "cor-stein-tomas-for-compact-hypersurfaces-with-nonzero-curvature",
        "cex-flat-hyperplanes-do-not-have-spherical-stationary-phase-decay"
      ]
    },
    {
      "id": "lem-stein-tomas-tt-star-bound-from-fractional-integration",
      "statement": "Assume Countable Choice. For the curved graph-patch data of the slice-family lemma and p=2(n+1)/(n+3), ||f*check μ||p′≤C_a||f||p for every Schwartz f on Rⁿ.",
      "used_by": [
        "thm-stein-tomas-spherical-restriction-theorem",
        "cor-stein-tomas-for-compact-hypersurfaces-with-nonzero-curvature"
      ]
    },
    {
      "id": "thm-maximal-truncations-are-weak-one-one-and-strong-lp",
      "statement": "Under Countable Choice and the stated pointwise size, δ-Hölder, cancellation, principal-value, convolution, L² and off-support hypotheses, T** and T* are weak (1,1), and strongly Lp-bounded for every 1<p<∞, with the displayed constants proportional to A₁+A₂′+A₃+B.",
      "used_by": ["cor-principal-value-truncations-converge-almost-everywhere"]
    },
    {
      "id": "lem-mihlin-dyadic-pieces-sum-to-an-off-support-kernel-representation",
      "statement": "Assume Countable Choice and the dyadic Mihlin-piece setting. The symmetric partial sums converge to m∨ in S′, the kernel series converges almost everywhere off zero to a function agreeing with that distribution there, and this function has annular size and Hörmander constants at most C_n A.",
      "used_by": ["thm-mihlin-fourier-multiplier-theorem"]
    },
    {
      "id": "lem-dual-identity-neighbourhood-is-compact",
      "statement": "Assume full Choice. For an LCH abelian group G, a symmetric compact identity neighbourhood K, and D={z∈T:|z−1|≤1/2}, N={γ∈Ĝ:γ[K]⊆D} is equicontinuous, compact in the compact-open topology of C(G,T), and a neighbourhood of the identity character.",
      "used_by": ["thm-dual-of-an-lca-group-is-locally-compact-abelian"]
    },
    {
      "id": "lem-continuous-characters-of-the-real-line-are-exponentials",
      "statement": "Every continuous homomorphism from the additive real line to the multiplicative unit circle is t↦exp(2πiξt) for a unique real ξ; conversely every such map is a continuous character.",
      "used_by": [
        "ex-pontryagin-dual-of-the-circle-is-the-integers",
        "ex-pontryagin-dual-of-euclidean-space"
      ]
    },
    {
      "id": "thm-compact-groups-have-discrete-duals-and-discrete-groups-have-compact-duals",
      "statement": "(1) If G is a compact abelian topological group, Ĝ is discrete. (2) If G is discrete abelian, Ĝ is compact assuming full Choice, used only through Tychonoff.",
      "used_by": [
        "lem-duals-of-finite-products-and-discrete-direct-sums",
        "ex-pontryagin-dual-of-the-circle-is-the-integers",
        "ex-pontryagin-dual-of-a-finite-cyclic-group",
        "ex-peter-weyl-for-the-circle-without-reminting-pontryagin-duality"
      ]
    }
  ],
