  "refuter_findings": [
    {
      "obligation": "refuter:7:1",
      "id": "lem-local-logarithmic-derivative-zeta",
      "location": "Statement",
      "defect": "false-claim",
      "evidence": "The Statement says it holds “Uniformly for $-1\\le\\sigma\\le2$ and $s=\\sigma+it$ whose ordinate is not that of a nontrivial zero.” Take $s=1$ (so $\\sigma=1,t=0$). No nontrivial zeta zero has ordinate $0$, so this satisfies the written condition, but $\\zeta'/\\zeta$ has a pole at $s=1$. The finite displayed local zero sum and its $O(\\log 2)$ remainder are finite there, so they cannot equal the left side. The statement needs to exclude $s=1$.",
      "severity": "fatal",
      "observed_sha256": "2fd68936e16812bab326ef33daaaa5d4bb6a69a74a93609f87b63565b368c7d9"
    }
  ],
