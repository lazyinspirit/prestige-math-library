  "load_bearing": [
    {
      "id": "def-valuation-on-a-field",
      "statement": "A valuation on K is a map v:K to Gamma union {infinity} satisfying the exact-zero, multiplicative, and ultrametric laws.",
      "used_by": [
        "def-discrete-valuation",
        "thm-every-valuation-ring-arises-from-its-value-group",
