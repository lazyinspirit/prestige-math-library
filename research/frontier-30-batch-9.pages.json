[
  {
    "order": 365.033,
    "id": "enriched-categories",
    "kind": "A",
    "category": "category-theory",
    "title": "Enriched Categories",
    "companion": "enriched-categories-examples",
    "requires": [
      "duality-and-rigidity-in-monoidal-categories-examples"
    ],
    "items": [
      {
        "id": "def-enriched-category",
        "kind": "definition",
        "title": "Enriched category over a monoidal base",
        "deps": [
          "def-monoidal-category"
        ]
      },
      {
        "id": "rem-the-order-of-the-tensor-factors-in-composition",
        "kind": "remark",
        "title": "The order of tensor factors in enriched composition is fixed once and for all on this page",
        "deps": [
          "def-enriched-category"
        ]
      },
      {
        "id": "def-enriched-functor",
        "kind": "definition",
        "title": "Enriched functor",
        "deps": [
          "def-enriched-category"
        ]
      },
      {
        "id": "rem-how-much-of-the-theory-needs-symmetry-closedness-and-completeness",
        "kind": "remark",
        "title": "How much of the theory needs symmetry, closedness, and completeness",
        "deps": [
          "def-enriched-category",
          "def-symmetric-monoidal-category",
          "def-left-closed-and-right-closed-monoidal-category"
        ]
      },
      {
        "id": "def-enriched-natural-transformation",
        "kind": "definition",
        "title": "Enriched natural transformation",
        "deps": [
          "def-enriched-functor"
        ]
      },
      {
        "id": "thm-the-compact-square-form-of-enriched-naturality",
        "kind": "theorem",
        "title": "The lozenge and compact-square forms of enriched naturality are equivalent",
        "strategy": "Use Kelly's canonical maps induced by a component of the transformation to rewrite the lozenge equation as a commuting square in the base.",
        "deps": [
          "def-enriched-natural-transformation"
        ]
      },
      {
        "id": "rem-enriched-naturality-is-strictly-stronger-than-ordinary-naturality",
        "kind": "remark",
        "title": "Enriched naturality is strictly stronger than ordinary naturality of the underlying components",
        "deps": [
          "def-enriched-natural-transformation",
          "thm-the-compact-square-form-of-enriched-naturality"
        ]
      },
      {
        "id": "thm-enriched-categories-functors-and-natural-transformations-form-a-two-category",
        "kind": "theorem",
        "title": "Set-object enriched categories, enriched functors, and enriched natural transformations form a strict 2-category",
        "deps": [
          "def-enriched-category",
          "def-enriched-functor",
          "def-enriched-natural-transformation",
          "def-strict-two-category"
        ]
      },
      {
        "id": "def-the-underlying-ordinary-category-of-an-enriched-category",
        "kind": "definition",
        "title": "The underlying ordinary category of an enriched category",
        "deps": [
          "def-enriched-category"
        ]
      },
      {
        "id": "thm-the-underlying-category-construction-is-a-two-functor",
        "kind": "theorem",
        "title": "The underlying-category construction is a 2-functor",
        "deps": [
          "def-the-underlying-ordinary-category-of-an-enriched-category",
          "def-enriched-functor",
          "def-enriched-natural-transformation"
        ]
      },
      {
        "id": "rem-the-underlying-category-can-lose-information",
        "kind": "remark",
        "title": "The underlying category can lose genuinely enriched information",
        "deps": [
          "def-the-underlying-ordinary-category-of-an-enriched-category"
        ]
      },
      {
        "id": "thm-a-category-enriched-in-categories-is-exactly-a-small-object-strict-two-category-with-small-homs",
        "kind": "theorem",
        "title": "A Cat-enriched category is exactly a strict 2-category with a set of objects and small hom-categories",
        "strategy": "Unpack the cartesian monoidal structure on Cat so that enriched composition becomes horizontal composition, and recover 2-cells as morphisms in the hom-categories.",
        "deps": [
          "def-enriched-category",
          "def-strict-two-category",
          "thm-the-category-of-small-categories-is-cartesian-closed"
        ]
      },
      {
        "id": "thm-a-category-enriched-in-a-preorder-is-a-preorder-and-one-enriched-in-sets-is-an-ordinary-category",
        "kind": "theorem",
        "title": "Enrichment in a preorder recovers a preorder, and enrichment in sets recovers an ordinary category",
        "deps": [
          "def-enriched-category",
          "def-preorder",
          "def-category"
        ]
      },
      {
        "id": "thm-a-category-enriched-in-abelian-groups-is-exactly-a-preadditive-category",
        "kind": "theorem",
        "title": "Ab-enriched categories are exactly preadditive categories",
        "strategy": "Use the universal property of the tensor product over Z to package bilinear composition into the single enrichment morphism, and extract bilinearity back from that morphism.",
        "deps": [
          "def-enriched-category",
          "def-preadditive-category",
          "thm-the-category-of-abelian-groups-is-monoidal-under-the-tensor-product",
          "thm-the-hom-bifunctor-of-a-preadditive-category-takes-values-in-abelian-groups"
        ]
      },
      {
        "id": "cor-an-additive-category-is-an-ab-enriched-category-with-a-zero-object-and-finite-biproducts",
        "kind": "corollary",
        "title": "An additive category is an Ab-enriched category with a zero object and finite biproducts",
        "deps": [
          "thm-a-category-enriched-in-abelian-groups-is-exactly-a-preadditive-category",
          "def-additive-category"
        ]
      },
      {
        "id": "rem-the-commutative-monoid-case",
        "kind": "remark",
        "title": "The commutative-monoid enrichment of a semiadditive category remains only a sourced remark here",
        "deps": [
          "thm-a-category-with-finite-biproducts-is-enriched-in-commutative-monoids",
          "def-semiadditive-category"
        ]
      },
      {
        "id": "thm-a-closed-monoidal-category-is-enriched-in-itself",
        "kind": "theorem",
        "title": "A closed monoidal category is enriched in itself",
        "deps": [
          "def-left-closed-and-right-closed-monoidal-category",
          "thm-the-internal-hom-composition-morphism",
          "thm-the-unit-is-an-internal-hom-unit"
        ]
      },
      {
        "id": "def-representable-enriched-functor",
        "kind": "definition",
        "title": "Representable enriched functor",
        "deps": [
          "thm-a-closed-monoidal-category-is-enriched-in-itself",
          "def-enriched-functor"
        ]
      },
      {
        "id": "thm-a-category-enriched-in-the-two-element-lattice-is-a-preordered-set",
        "kind": "theorem",
        "title": "A category enriched in the two-element lattice is a preordered set",
        "deps": [
          "def-enriched-category",
          "def-preorder"
        ]
      },
      {
        "id": "thm-weak-enriched-yoneda-lemma",
        "kind": "theorem",
        "title": "Weak enriched Yoneda lemma",
        "strategy": "Evaluate a V-natural transformation at the identity element of the represented object and reconstruct the family from that element.",
        "deps": [
          "def-representable-enriched-functor",
          "def-enriched-natural-transformation",
          "thm-the-compact-square-form-of-enriched-naturality",
          "def-the-internal-hom-and-its-evaluation-morphism",
          "thm-the-unit-is-an-internal-hom-unit"
        ]
      },
      {
        "id": "thm-strong-enriched-yoneda-lemma-as-a-particular-end",
        "kind": "theorem",
        "title": "Strong enriched Yoneda lemma as a particular end",
        "strategy": "Show that Kelly's particular end represents the same functor as the weak Yoneda bijection, so the set-level correspondence lifts to an isomorphism in the base.",
        "deps": [
          "thm-weak-enriched-yoneda-lemma",
          "thm-a-closed-monoidal-category-is-enriched-in-itself",
          "def-the-internal-hom-and-its-evaluation-morphism",
          "thm-the-unit-is-an-internal-hom-unit"
        ]
      },
      {
        "id": "rem-the-particular-yoneda-end-and-the-enriched-functor-category-are-different-size-claims",
        "kind": "remark",
        "title": "The particular Yoneda end and the enriched functor category have different size requirements",
        "deps": [
          "thm-strong-enriched-yoneda-lemma-as-a-particular-end",
          "def-functor-category"
        ]
      },
      {
        "id": "cor-the-enriched-yoneda-embedding-is-fully-faithful",
        "kind": "corollary",
        "title": "The enriched Yoneda assignment is fully faithful",
        "deps": [
          "thm-strong-enriched-yoneda-lemma-as-a-particular-end",
          "def-representable-enriched-functor"
        ]
      },
      {
        "id": "def-cotensor-and-tensor",
        "kind": "definition",
        "title": "Tensor and cotensor in a V-category",
        "deps": [
          "def-enriched-category",
          "thm-a-closed-monoidal-category-is-enriched-in-itself",
          "def-set-weighted-limit-and-weighted-colimit"
        ]
      },
      {
        "id": "cex-a-bijection-of-underlying-hom-sets-does-not-establish-a-cotensor",
        "kind": "counterexample",
        "title": "A bijection on underlying hom-sets need not exhibit a cotensor",
        "deps": [
          "def-cotensor-and-tensor",
          "rem-the-underlying-category-can-lose-information"
        ]
      },
      {
        "id": "def-enriched-weighted-limit",
        "kind": "definition",
        "title": "Enriched weighted limit",
        "deps": [
          "def-set-weighted-limit-and-weighted-colimit",
          "def-enriched-functor",
          "thm-a-closed-monoidal-category-is-enriched-in-itself"
        ]
      },
      {
        "id": "thm-the-free-enriched-category-two-adjunction",
        "kind": "theorem",
        "title": "The free enriched category is left 2-adjoint to the underlying-category construction",
        "strategy": "Use Kelly's free V-category and the displayed hom-category isomorphisms to build the 2-adjunction explicitly.",
        "deps": [
          "def-the-underlying-ordinary-category-of-an-enriched-category",
          "def-enriched-category",
          "def-enriched-functor"
        ]
      },
      {
        "id": "def-conical-limit-in-an-enriched-category",
        "kind": "definition",
        "title": "Conical enriched limit",
        "deps": [
          "def-enriched-weighted-limit",
          "thm-the-free-enriched-category-two-adjunction"
        ]
      },
      {
        "id": "thm-there-is-in-general-no-constant-enriched-functor",
        "kind": "theorem",
        "title": "Constant enriched functors need not exist",
        "deps": [
          "def-enriched-category",
          "def-enriched-functor",
          "def-the-underlying-ordinary-category-of-an-enriched-category"
        ]
      },
      {
        "id": "thm-conical-limits-do-not-suffice-in-the-enriched-setting",
        "kind": "theorem",
        "title": "Conical weights are a proper special case of enriched weights",
        "deps": [
          "def-conical-limit-in-an-enriched-category",
          "def-cotensor-and-tensor"
        ]
      },
      {
        "id": "thm-a-conical-limit-is-stronger-than-a-limit-in-the-underlying-category",
        "kind": "theorem",
        "title": "A conical enriched limit is stronger than a limit in the underlying category",
        "strategy": "Use Riehl's Cat-enriched witness where the underlying category has the limit but the enriched hom-category comparison fails.",
        "deps": [
          "def-conical-limit-in-an-enriched-category",
          "rem-the-underlying-category-can-lose-information"
        ]
      },
      {
        "id": "thm-when-a-category-is-tensored-every-limit-in-it-is-a-conical-enriched-limit",
        "kind": "theorem",
        "title": "When a category is tensored, every limit in it is a conical enriched limit",
        "strategy": "Represented enriched hom-functors become right adjoints in the tensored case, so they preserve ordinary limits and detect the enriched conical universal property.",
        "deps": [
          "def-cotensor-and-tensor",
          "def-conical-limit-in-an-enriched-category"
        ]
      },
      {
        "id": "thm-enriched-completeness-is-cotensors-plus-small-conical-limits",
        "kind": "theorem",
        "title": "Enriched completeness is cotensors plus small conical limits",
        "deps": [
          "def-cotensor-and-tensor",
          "def-conical-limit-in-an-enriched-category",
          "def-enriched-weighted-limit",
          "thm-when-a-category-is-tensored-every-limit-in-it-is-a-conical-enriched-limit"
        ]
      },
      {
        "id": "rem-this-does-not-reduce-indexed-limits-to-conical-ones",
        "kind": "remark",
        "title": "The completeness test does not reduce indexed limits to conical ones",
        "deps": [
          "thm-enriched-completeness-is-cotensors-plus-small-conical-limits",
          "thm-conical-limits-do-not-suffice-in-the-enriched-setting"
        ]
      },
      {
        "id": "thm-a-lax-monoidal-functor-induces-a-change-of-base-on-enriched-categories",
        "kind": "theorem",
        "title": "A lax monoidal functor induces change of base on enriched categories",
        "deps": [
          "def-lax-strong-and-strict-monoidal-functor",
          "def-enriched-category"
        ]
      },
      {
        "id": "thm-change-of-base-extends-to-functors-and-natural-transformations-and-is-a-two-functor",
        "kind": "theorem",
        "title": "Change of base extends to enriched functors and natural transformations as a 2-functor",
        "deps": [
          "thm-a-lax-monoidal-functor-induces-a-change-of-base-on-enriched-categories",
          "def-enriched-functor",
          "def-enriched-natural-transformation"
        ]
      },
      {
        "id": "cor-the-underlying-ordinary-category-is-an-instance-of-change-of-base",
        "kind": "corollary",
        "title": "The underlying ordinary category is change of base along the underlying-hom functor",
        "deps": [
          "thm-change-of-base-extends-to-functors-and-natural-transformations-and-is-a-two-functor",
          "thm-the-underlying-category-construction-is-a-two-functor"
        ]
      },
      {
        "id": "rem-what-is-not-proved-about-change-of-base",
        "kind": "remark",
        "title": "What this page does not prove about change of base",
        "deps": [
          "cor-the-underlying-ordinary-category-is-an-instance-of-change-of-base"
        ]
      },
      {
        "id": "def-enriched-adjunction",
        "kind": "definition",
        "title": "Enriched adjunction",
        "deps": [
          "def-enriched-functor",
          "thm-a-closed-monoidal-category-is-enriched-in-itself",
          "rem-the-underlying-category-can-lose-information"
        ]
      },
      {
        "id": "thm-a-right-enriched-adjoint-preserves-weighted-limits",
        "kind": "theorem",
        "title": "Right enriched adjoints preserve weighted limits",
        "strategy": "Transpose the weighted universal property across the enriched hom-isomorphism that defines the adjunction.",
        "deps": [
          "def-enriched-adjunction",
          "def-enriched-weighted-limit"
        ]
      },
      {
        "id": "thm-enriched-adjoint-functor-theorem-for-cotensored-categories",
        "kind": "theorem",
        "title": "Enriched adjoint functor theorem for cotensored categories",
        "strategy": "Use the equivalence between enriched adjunction data and ordinary adjunction data whose right adjoint preserves cotensors, and dualize for tensors.",
        "deps": [
          "def-enriched-adjunction",
          "def-cotensor-and-tensor"
        ]
      },
      {
        "id": "thm-a-category-is-tensored-exactly-when-every-covariant-hom-has-a-left-enriched-adjoint",
        "kind": "theorem",
        "title": "A V-category is tensored exactly when each covariant hom has a left enriched adjoint",
        "deps": [
          "def-cotensor-and-tensor",
          "def-enriched-adjunction",
          "def-representable-enriched-functor"
        ]
      },
      {
        "id": "thm-every-enriched-functor-into-the-base-is-a-weighted-colimit-of-representables",
        "kind": "theorem",
        "title": "Every enriched functor into the base is a weighted colimit of representables when the displayed weighted colimit exists",
        "strategy": "Use the enriched Yoneda embedding and the hom-weighted colimit formula to recover the functor from representables under the stated smallness and existence hypotheses.",
        "deps": [
          "thm-strong-enriched-yoneda-lemma-as-a-particular-end",
          "def-enriched-weighted-limit",
          "def-representable-enriched-functor"
        ]
      }
    ]
  },
  {
    "order": 365.034,
    "id": "enriched-categories-examples",
    "kind": "B",
    "category": "category-theory",
    "title": "Enriched Categories — Examples",
    "companion": "enriched-categories",
    "requires": [
