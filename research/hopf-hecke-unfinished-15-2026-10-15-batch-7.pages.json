      {
        "id": "thm-hh-hopf-maschke-integral-averaging",
        "kind": "theorem",
        "title": "Hopf–Maschke theorem by integral averaging",
        "deps": [
          "def-hh-hopf-algebra-and-antipode",
          "def-hh-left-right-integrals-and-integral-functionals",
          "thm-hh-antipode-uniqueness-anti-multiplication-and-anti-comultiplication",
          "lem-hh-finite-matrix-and-module-preliminaries",
          "def-left-and-right-modules",
          "def-submodule",
          "def-semisimple-module",
          "def-semisimple-ring"
        ],
        "dependency_level": 5,
        "statement": "Let $H\\ne0$ be a finite-dimensional Hopf algebra as in [[def-hh-hopf-algebra-and-antipode]] over a field $k$. Then $H$ is semisimple as a ring ([[def-semisimple-ring]]), that is, its left regular module is a direct sum of simple left submodules ([[def-semisimple-module]]), if and only if there exists a left integral $\\Lambda\\in H$ with $\\varepsilon(\\Lambda)\\ne0$. In that case $\\Lambda$ can be normalized so that $\\varepsilon(\\Lambda)=1$."
      },
      {
        "id": "thm-hh-finite-integrals-are-one-dimensional-and-antipode-is-bijective",
        "kind": "theorem",
        "title": "Finite Hopf algebras have one-dimensional integral spaces and bijective antipode",
        "deps": [
          "def-hh-hopf-algebra-and-antipode",
          "def-hh-left-right-integrals-and-integral-functionals",
          "lem-hh-finite-dual-regular-hopf-module-construction",
          "thm-hh-fundamental-theorem-of-hopf-modules",
          "thm-hh-finite-dimensional-dual-hopf-algebra",
          "thm-hh-antipode-uniqueness-anti-multiplication-and-anti-comultiplication",
          "thm-hh-finite-algebra-coalgebra-duality",
          "thm-rank-nullity",
          "thm-dual-family-is-a-basis-in-finite-dimension"
        ],
        "dependency_level": 7,
        "statement": "Let $H$ be a nonzero finite-dimensional Hopf algebra over a field $k$. Each of $\\int_H^\\ell$, $\\int_H^r$, $\\int_{H^*}^\\ell$, and $\\int_{H^*}^r$ is one-dimensional. The antipodes of $H$ and $H^*$ are bijective; each sends the left-integral space isomorphically onto the right-integral space."
      },
