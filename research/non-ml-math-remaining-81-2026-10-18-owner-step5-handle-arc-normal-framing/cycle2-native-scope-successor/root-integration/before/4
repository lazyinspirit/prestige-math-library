    "thm-qa-37-exhaustive-b6-compiler-terminates": {
      "risk": "high",
      "kind": "theorem",
      "citations": [
        {
          "fact": "F1",
          "source": "lem-qc-tqc-b6-joint-su5-su8-density",
          "source_section": "Statement",
          "quote": "Assume $\\mathrm{AC}_\\omega$. For the normalized simultaneous six-$\\tau$\nFibonacci B6 representation on\n$V(\\tau^6\\to1)\\oplus V(\\tau^6\\to\\tau)\\cong\\mathbb C^5\\oplus\\mathbb C^8$,\nthe closure in $U(5)\\times U(8)$ contains $SU(5)\\times SU(8)$.",
          "uses": [
