    "lem-hh-sl2-q3-lattice-tree-and-iwahori-orbits": {
      "citations": [
        {
          "fact": "F1",
          "source": "cor-zp-is-the-valuation-ring-of-qp",
          "source_section": "Statement",
          "quote": "Under the comparison of\n[[thm-p-adic-completion-agrees-with-the-fraction-field-of-zp]], the $(p)$-adic\ncompletion $\\mathbb Z_p$ of $\\mathbb Z$ identifies with\n\n$$\\{x \\in \\mathbb Q_p : |x|_p \\le 1\\}.$$",
          "uses": [
            "1.1",
            "2.2"
          ]
        },
        {
          "fact": "F2",
          "source": "thm-p-adic-digit-expansion",
          "source_section": "Statement",
          "quote": "Every nonzero $x \\in \\mathbb Q_p$ can be written uniquely in the form\n\n$$x = \\sum_{n=N}^{\\infty} a_n p^n,$$\n\nwhere $N \\in \\mathbb Z$, $a_N \\ne 0$, and each digit $a_n$ lies in\n$\\{0,\\dots,p-1\\}$. The zero element has the all-zero expansion.",
          "uses": [
