  "refuter_findings": [
    {
      "obligation": "refuter:12:1",
      "id": "def-barycentric-subdivision-prism-homotopy",
      "location": "Definition",
      "defect": "ill-formed",
      "evidence": "The preceding cone definition permits $b_\\sigma z$ only for “a chain $z$ on its boundary,” but this definition sets $T(\\sigma)=b_\\sigma(\\sigma-S\\sigma-T\\partial\\sigma)$. For a nonconstant singular 1-simplex, $T\\partial\\sigma=0$, so the proposed input is the degree-one chain $\\sigma-S\\sigma$, consisting of $\\sigma$ and its two subdivided restrictions. It is not a chain on the boundary of $\\sigma$ (whose image consists only of the two endpoint 0-simplices). Thus the stated domain of $b_\\sigma$ does not admit the displayed input, so $T$ is not defined as the claimed degree-one operator.",
      "severity": "fatal",
      "observed_sha256": "51aa4379e51b03669f021875f0329e845e5790f7799c44ce801d789bb63d3135"
    }
  ],
