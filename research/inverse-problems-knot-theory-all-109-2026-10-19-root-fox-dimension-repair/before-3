        {
          "id": "step-1.2",
          "step": "1.2",
          "claim": "Evaluate each relator word by matrix multiplication, replacing each inverse letter by the adjugate matrix from [F2]. Every entry of $r_j(A_1,\\ldots,A_n)-I_2$ is therefore a polynomial in the coordinates.",
          "inputs": [
            "F2",
            "step 1.1",
            "algebra"
          ]
