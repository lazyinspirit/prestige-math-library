  "before_interfaces": {
    "lem-knot-floer-mirror-complex-duality": [
      "## Statement\n\nLet $K$ be a smooth oriented knot with a supplied regular admissible doubly pointed Heegaard diagram and normalized finite filtered hat complex $C_K$ whose total homology is $\\mathbb F_2$. Let $K^\\dagger$ be its reverse mirror under the fixed orientation-reversing reflection convention, with the reflected Seifert surface and reflected regular diagram. For a finite filtered complex $C$, define its dual complex $C^\\vee=\\operatorname{Hom}_{\\mathbb F_2}(C,\\mathbb F_2)$ with transposed differential and filtration\n$$F_sC^\\vee=\\{\\lambda\\in C^\\vee:\\lambda(F_{-s-1}C)=0\\}.$$\nThen the reflected diagram's normalized filtered hat complex is filtered chain isomorphic to $C_K^\\vee$. In particular, its total homology is $\\mathbb F_2$ and\n$$\\tau_{\\mathcal H^\\dagger,F^\\dagger}(K^\\dagger)=-\\tau_{\\mathcal H,F}(K).$$"
    ],
    "lem-tau-additive-for-filtered-tensor-products": [
      "## Statement\n\nLet $C$ and $D$ be finite integer-filtered chain complexes over $\\mathbb F_2$, with increasing bounded exhaustive filtrations by subcomplexes and with $H(C)\\cong H(D)\\cong\\mathbb F_2$. Give $C\\otimes D$ the tensor differential and the convolution filtration\n$$F_s(C\\otimes D)=\\sum_{p+q\\le s}F_pC\\otimes F_qD.$$\nThen $H(C\\otimes D)\\cong\\mathbb F_2$ and\n$$\\tau(C\\otimes D)=\\tau(C)+\\tau(D).$$"
    ],
    "lem-tau-of-the-unknot-is-zero": [
      "## Statement\n\nFor the standard oriented unknot $U$ and its standard genus-zero one-pointed Heegaard diagram, the normalized Alexander-filtered hat complex has total homology $\\mathbb F_2$ generated at filtration level $0$. Consequently the diagramwise threshold is $\\tau_{\\mathcal H,F}(U)=0$."
    ],
    "lem-tau-connected-sum-filtered-tensor-product": [
      "## Statement\n\nAssume the Axiom of Countable Choice. Let $K$ and $J$ be smooth oriented knots in the standard oriented three-sphere, with chosen minimum-genus oriented Seifert surfaces. A normalized $CFK^\\infty(K)$ is a free finite-rank chain complex over $\\mathbb F_2[U,U^{-1}]$ with two integer filtrations $(i,j)$, where multiplication by $U$ lowers both coordinates by one. Give the connected sum $K\\#J$ the fixed oriented gluing convention and the sum filtrations and Maslov/Alexander gradings. Then $CFK^\\infty(K\\#J)$ is bifiltered chain homotopy equivalent to $CFK^\\infty(K)\\otimes_{\\mathbb F_2[U,U^{-1}]}CFK^\\infty(J)$, with an equivalence and homotopies preserving both filtration coordinates. Moreover, the normalized finite filtered hat complex of $K\\#J$ is filtered chain homotopy equivalent to $C_K\\otimes C_J$ with tensor filtration $F_s(C_K\\otimes C_J)=\\sum_{p+q\\le s}F_pC_K\\otimes F_qC_J$. Consequently,\n$$\\tau(K\\#J)=\\tau(K)+\\tau(J).$$"
    ],
    "lem-knot-floer-large-surgery-and-filtered-cobordism-input": [
      "## Statement\n\nAssume the Axiom of Countable Choice. Let $S$ be a connected compact smooth oriented surface properly embedded in $S^3\\times[0,1]$, with product collars and oriented boundary $-K_0\\times\\{0\\}\\sqcup K_1\\times\\{1\\}$ for smooth oriented knots $K_0,K_1$. Let $g$ be the genus of $S$, and use the standard absolute Alexander normalization for the endpoint knot Floer complexes. Then\n$$|\\tau(K_1)-\\tau(K_0)|\\le g.$$\nIn particular, a smooth concordance annulus gives equal tau values, and a genus-$g$ surface from a knot to the unknot gives the four-ball genus estimate."
    ],
    "thm-tau-is-concordance-invariant-and-four-ball-genus-bound": [
      "## Statement\n\nAssume the Axiom of Countable Choice. For every smooth oriented knot $K$ in the standard oriented three-sphere, the common normalized filtered knot Floer threshold $\\tau(K)$ is independent of the admissible diagram and is invariant under smooth concordance. For all smooth oriented knots $K,J$, it satisfies\n$$\\tau(K\\#J)=\\tau(K)+\\tau(J).$$\nIf $g_4^{\\mathrm{sm}}(K)$ is the minimum genus of a smooth compact connected oriented properly embedded surface in the four-ball with boundary $K$, then\n$$|\\tau(K)|\\le g_4^{\\mathrm{sm}}(K).$$"
    ],
