  "before_interfaces": {
    "def-ip-index-source-ball": [
      "## Definition\n\nAssume Countable Choice. Let $X$ and $Y$ be real or complex Hilbert spaces over the same scalar field and let $K:X\\to Y$ be compact. Write $\\kappa:=\\|K\\|$, $S:=K^*K$, and $|K|:=S^{1/2}$, and let $\\Lambda_K$ be zero together with the positive eigenvalues of $|K|$. An admissible spectral index is a bounded function $\\psi:\\Lambda_K\\to[0,\\infty)$ with $\\psi(0)=0$. Define $\\psi(|K|)$ by the compact spectral multiplier of $S$ with scalar function $t\\mapsto\\psi(\\sqrt t)$. For $\\rho>0$ define $X_{\\psi,\\rho}(K):=\\{\\psi(|K|)w:w\\in X,\\ \\|w\\|_X\\le\\rho\\}$. For $\\nu>0$, $\\psi_\\nu(t)=t^\\nu$ defines the power source ball $X_{\\nu,\\rho}(K)$. If $\\kappa>0$ and $q>0$, define the logarithmic spectral-index candidate by $\\psi_{\\log,q}(0)=0$ and $\\psi_{\\log,q}(t)=(1+\\log(\\kappa/t))^{-q}$ for positive $t\\in\\Lambda_K$; when it is bounded, it defines $X_{\\log,q,\\rho}(K)$."
    ],
    "def-ip-centered-modulus-of-continuity": [
      "## Definition\n\nFor a compact operator $K:X\\to Y$ between real or complex Hilbert spaces over the same scalar field, write $N(K):=\\{x\\in X:Kx=0\\}$. For a set $M$ with $0\\in M\\subseteq N(K)^\\perp$ and $\\delta\\ge0$, define $\\varepsilon_K(M,\\delta):=\\sup\\{\\|x\\|_X:x\\in M,\\ \\|Kx\\|_Y\\le\\delta\\}\\in[0,+\\infty]$."
    ],
    "lem-ip-index-source-elements-are-minimum-norm": [
      "## Statement\n\nAssume Countable Choice. Let $K:X\\to Y$ be compact between real or complex Hilbert spaces over the same scalar field, let $\\psi$ be a bounded nonnegative spectral index with $\\psi(0)=0$, and let $x=\\psi(|K|)w$ for some $w\\in X$. Then $x\\in N(K)^\\perp$; consequently, among all $z\\in X$ satisfying $Kz=Kx$, $x$ is the unique vector of minimum norm."
    ],
    "def-ip-power-source-set": [
      "## Definition\n\nAssume Countable Choice. Let $K:X\\to Y$ be compact between real or complex Hilbert spaces over the same scalar field and let $\\nu,\\rho>0$. The power source ball is $X_{\\nu,\\rho}(K):=\\{|K|^\\nu w:w\\in X,\\ \\|w\\|_X\\le\\rho\\}$, where $|K|^\\nu=(K^*K)^{\\nu/2}$ is defined by compact spectral calculus. It lies in $N(K)^\\perp$ and consists of minimum-norm representatives of the exact data $Kx$. In the convention $S=K^*K$ this is the source condition $x=S^{\\nu/2}w$."
    ],
    "lem-ip-spectral-interpolation-for-power-source-balls": [
      "## Statement\n\nAssume Countable Choice. Let $K:X\\to Y$ be compact between real or complex Hilbert spaces over the same scalar field, let $\\nu>0$ and $w\\in X$, and put $x=|K|^\\nu w$. Then $\\|x\\|_X\\le\\|Kx\\|_Y^{\\nu/(\\nu+1)}\\|w\\|_X^{1/(\\nu+1)}$."
    ],
    "thm-ip-deterministic-minimax-lower-bound-on-source-balls": [
      "## Statement\n\nAssume Countable Choice. Let $K:X\\to Y$ be compact between real or complex Hilbert spaces over the same scalar field, $\\nu,\\rho>0$, and let $X_{\\nu,\\rho}(K)$ be its power source ball. For any deterministic reconstruction map $A:Y\\to X$ and any $\\delta\\ge0$, define $E_\\delta(A):=\\sup\\{\\|A(Kx+\\eta)-x\\|_X:x\\in X_{\\nu,\\rho}(K),\\ \\eta\\in Y,\\ \\|\\eta\\|_Y\\le\\delta\\}$. Then $E_\\delta(A)\\ge\\varepsilon_K(X_{\\nu,\\rho}(K),\\delta)$, and therefore $\\inf_{A:Y\\to X}E_\\delta(A)\\ge\\varepsilon_K(X_{\\nu,\\rho}(K),\\delta)$. For any $M\\subseteq X$ with $0\\in M$, define the two-truth modulus $\\widetilde\\varepsilon_K(M,\\delta):=\\sup\\{\\|x_1-x_2\\|_X:x_1,x_2\\in M,\\ \\|K(x_1-x_2)\\|_Y\\le2\\delta\\}$. Then $\\widetilde\\varepsilon_K(X_{\\nu,\\rho}(K),\\delta)=2\\varepsilon_K(X_{\\nu,\\rho}(K),\\delta)$."
    ],
    "thm-ip-source-ball-modulus-of-continuity": [
      "## Statement\n\nAssume Countable Choice. Let $K:X\\to Y$ be compact between real or complex Hilbert spaces over the same scalar field and $\\nu,\\rho>0$. For every $\\delta\\ge0$, $\\varepsilon_K(X_{\\nu,\\rho}(K),\\delta)\\le\\delta^{\\nu/(\\nu+1)}\\rho^{1/(\\nu+1)}$. For every positive singular value $s_j$ with right singular vector $v_j$, equality holds at $\\delta_j=\\rho s_j^{\\nu+1}$, witnessed by $x_j=\\rho s_j^\\nu v_j$. If $K$ has infinite rank, these $\\delta_j$ form a null sequence; if $K$ has finite positive rank, equality is asserted only at its finitely many positive singular values; if $K=0$, the source ball and modulus are $\\{0\\}$ and $0$."
    ],
    "ex-ip-polynomial-singular-decay-source-balls": [],
    "ex-ip-exponential-singular-decay-source-balls": []
  }
