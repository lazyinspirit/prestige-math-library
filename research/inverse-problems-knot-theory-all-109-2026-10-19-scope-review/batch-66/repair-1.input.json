  "before_interfaces": {
    "lem-square-integer-cokernel-finiteness-and-order": [
      "## Statement\n\nLet $n$ be a nonnegative integer and let $A$ be an $n\\times n$ matrix with integer entries. Define $\\operatorname{coker}(A)=\\mathbb Z^n/A\\mathbb Z^n$. Then $\\operatorname{coker}(A)$ is finite if and only if $\\det A\\ne0$, and in that case its order is $|\\det A|$. For the empty $0\\times0$ matrix, take $\\det A=1$ and $\\operatorname{coker}(A)=0$."
    ],
    "lem-cyclic-cover-linking-form-inverse-matrix": [
      "## Statement\n\nAssume the Axiom of Choice. Let $J=J_1\\cup\\cdots\\cup J_n$ be an oriented link of $n\\ge1$ smooth components in $S^3$. Choose pairwise disjoint closed tubular neighborhoods $N(J_i)$, let $X=S^3\\setminus\\operatorname{int}(\\bigcup_iN(J_i))$, and let $\\mu_i$ be the positive meridian of $J_i$. Let $\\lambda_i$ be the longitude parallel to $J_i$ with zero self-linking. Alexander duality identifies $H_1(X;\\mathbb Z)$ with $\\mathbb Z^n$ on the meridian basis $[\\mu_1],\\ldots,[\\mu_n]$; for $i\\ne j$, define $\\operatorname{lk}_{S^3}(J_i,J_j)$ to be the $j$-th coordinate of $[\\lambda_i]$, the usual oriented linking number. Use the boundary-torus intersection convention $\\mu_i\\mathbin{\\cdot}\\lambda_i=+1$. Give $J_i$ an integer framing $f_i$ and fill along $\\delta_i=\\lambda_i+f_i\\mu_i$. Let $A$ be the symmetric integer matrix with $A_{ii}=f_i$ and $A_{ij}=\\operatorname{lk}_{S^3}(J_i,J_j)$ for $i\\ne j$. Assume $\\det A\\ne0$, and let $Y$ be the resulting oriented surgery manifold, oriented as the boundary of the 4-dimensional surgery handlebody with outward normal first. Then $H_1(Y;\\mathbb Z)\\cong\\mathbb Z^n/A\\mathbb Z^n$. For torsion classes $[C],[D]\\in H_1(Y;\\mathbb Z)$ represented by oriented 1-cycles, choose $m>0$ and an integral 2-chain $F$ with $\\partial F=mC$ and define $\\lambda_Y([C],[D])=(F\\mathbin{\\cdot}D)/m\\pmod{\\mathbb Z}$, where the intersection is signed by the orientation of $Y$. If $x,y\\in\\mathbb Z^n$ are meridian-coordinate representatives of $[C],[D]$, then\n$$\n\\lambda_Y([x],[y])=-x^TA^{-1}y\\pmod{\\mathbb Z}.\n$$"
    ],
    "def-cyclic-branched-cover-of-a-knot": [
      "## Definition\n\nAssume the Axiom of Choice. Let $K$ be a smooth oriented knot in the standard oriented $3$-sphere, choose its compact exterior $E_K$ with boundary torus $T_K$, and let $\\mu$ and $\\lambda$ be its positive meridian and preferred longitude. The exterior homology theorem gives $H_1(E_K;\\mathbb Z)=\\mathbb Z[\\mu]$. Let $\\phi:\\pi_1(E_K)\\to\\mathbb Z$ be the composite of abelianization with the homomorphism $[\\mu]\\mapsto1$. For an integer $q\\ge2$, let $\\phi_q$ be the composite $\\pi_1(E_K)\\xrightarrow{\\phi}\\mathbb Z\\to\\mathbb Z/q\\mathbb Z$, and let $p_q:E_q\\to E_K$ be the connected cover classified by $\\ker\\phi_q$. On $T_K$, the homomorphism sends $[\\mu]\\mapsto1$ and $[\\lambda]\\mapsto0$, so the preimage of $T_K$ is a connected torus cover whose fundamental group corresponds to $\\langle\\mu^q,\\lambda\\rangle$. Let $\\widetilde\\mu$ be the closed lift of $\\mu^q$. Attach a solid torus to $E_q$ with its meridian identified with $\\widetilde\\mu$; the resulting oriented closed $3$-manifold is the $q$-fold cyclic branched cover $\\Sigma_q(K)$. In tubular coordinates near $K$, the extended map to $S^3$ has local form $(s,w)\\mapsto(s,w^q)$, and the deck group $\\mathbb Z/q\\mathbb Z$ acts by $w\\mapsto e^{2\\pi i/q}w$."
    ],
    "lem-cyclic-branched-cover-homology-is-alexander-module-coinvariants": [
      "## Statement\n\nAssume the Axiom of Choice. Let $K$ be a smooth oriented knot, let $X_K=S^3\\setminus K$, and let $q\\ge2$. Let $A_K=H_1(\\widetilde X_K;\\mathbb Z)$ be the one-variable Alexander module with the positive-meridian deck action $t$. Then, as abelian groups,\n$$\nH_1(\\Sigma_q(K);\\mathbb Z)\\cong A_K/(t^q-1)A_K.\n$$"
    ],
    "lem-branched-cover-surgery-presentation-from-seifert-surface": [
      "## Statement\n\nAssume the Axiom of Choice. Let $K$ bound a connected compact oriented Seifert surface $F$ of genus $g$. Choose a disk-band decomposition of $F$ with one disk and $2g$ bands, and use its band-core basis $a_1,\\ldots,a_{2g}$ to form the positive-push Seifert matrix $V_{ij}=\\operatorname{lk}(a_i^+,a_j)$. For $q\\ge2$, define the symmetric block matrix $M_q(V)$ of size $2g(q-1)$ by specifying its $2g\\times2g$ blocks, indexed by $1\\le k,\\ell\\le q-1$:\n$$(M_q(V))_{k\\ell}=\\begin{cases}V+V^T,&k=\\ell,\\\\-V^T,&\\ell=k+1,\\\\-V,&k=\\ell+1,\\\\0,&|k-\\ell|\\ge2.\\end{cases}$$\nPush the interior of $F$ into $B^4$ while keeping $K$ on $S^3=\\partial B^4$, cut $B^4$ along a thickened copy of the pushed-in surface, and take $q$ copies. For $i=1,\\ldots,q-1$, glue the positive face of copy $i$ to the negative face of copy $i+1$ by reflecting the normal coordinate; do not glue the last positive face to the first negative face. Call the resulting $q$-fold cyclic branched cover $W_q(F)$. It has one $0$-handle and $2g(q-1)$ $2$-handles, and its framed attaching link has linking matrix $M_q(V)$. The boundary branched cover, with the boundary marking induced by the covering map, is $\\Sigma_q(K)$."
    ],
    "lem-cyclic-branched-cover-seifert-block-matrix": [
      "## Statement\n\nAssume the Axiom of Choice. Let $K$ be a smooth oriented knot, let $F$ be a connected compact oriented Seifert surface of genus $g$, and choose any ordered integral basis $a_1,\\ldots,a_{2g}$ of $H_1(F;\\mathbb Z)$ with positive-push Seifert matrix $V_{ij}=\\operatorname{lk}(a_i^+,a_j)$. For an integer $q\\ge2$, let $M_q(V)$ be the symmetric block matrix of size $2g(q-1)$ whose $2g\\times2g$ block in position $(k,\\ell)$, for $1\\le k,\\ell\\le q-1$, is $V+V^T$ if $k=\\ell$, $-V^T$ if $\\ell=k+1$, $-V$ if $k=\\ell+1$, and $0$ if $|k-\\ell|\\ge2$. Then\n$$\nH_1(\\Sigma_q(K);\\mathbb Z)\\cong\\operatorname{coker}(M_q(V)).\n$$\nFor $q=2$ this presentation matrix is $V+V^T$; when $g=0$ the empty matrix has trivial cokernel."
    ],
    "lem-double-branched-cover-homology-from-seifert-matrix": [
      "## Statement\n\nAssume the Axiom of Choice. Let $K$ be a smooth oriented knot, let $F$ be a connected compact oriented Seifert surface of genus $g$, and let $V$ be its positive-push Seifert matrix in any ordered integral basis of $H_1(F;\\mathbb Z)$. Then\n$$\nH_1(\\Sigma_2(K);\\mathbb Z)\\cong\\operatorname{coker}(V+V^T).\n$$\nFor $g=0$, the matrix is empty and the cokernel is trivial."
    ],
    "lem-cyclic-cover-order-root-product-and-rational-sphere-test": [
      "## Statement\n\nAssume the Axiom of Choice. Let $K$ be a smooth oriented knot, let $F$ be a connected compact oriented Seifert surface of genus $g$, and let $V$ be its positive-push Seifert matrix in an ordered integral basis of $H_1(F;\\mathbb Z)$. Write $\\Delta_K(t)$ for the Alexander polynomial normalized up to multiplication by $\\pm t^k$, and let $q\\ge2$ with $\\zeta_q$ a primitive $q$-th root of unity. Then $H_1(\\Sigma_q(K);\\mathbb Z)$ is finite if and only if $\\Delta_K(\\zeta_q^j)\\ne0$ for every $1\\le j<q$, and, when it is finite,\n$$\n|H_1(\\Sigma_q(K);\\mathbb Z)|=\\prod_{j=1}^{q-1}|\\Delta_K(\\zeta_q^j)|.\n$$\nThe same criterion and order hold when $\\Delta_K(t)$ is replaced by $\\det(V-tV^T)$."
    ],
    "thm-knot-determinant-is-order-of-double-cover-homology": [
      "## Statement\n\nAssume the Axiom of Choice. Let $K$ be a smooth oriented knot with Alexander polynomial $\\Delta_K(t)$ normalized up to multiplication by $\\pm t^k$. Then $H_1(\\Sigma_2(K);\\mathbb Z)$ is finite if and only if $\\Delta_K(-1)\\ne0$, and in that case\n$$\n|H_1(\\Sigma_2(K);\\mathbb Z)|=|\\Delta_K(-1)|.\n$$\nMoreover, $\\Delta_K(-1)$ is odd, so the first homology of every double branched cover is finite."
    ],
    "thm-knot-cyclic-cover-order-from-alexander-polynomial": [
      "## Statement\n\nAssume the Axiom of Choice. Let $K$ be a smooth oriented knot and let $q\\ge2$. If $\\zeta_q$ is any primitive $q$-th root of unity, then $H_1(\\Sigma_q(K);\\mathbb Z)$ is finite exactly when $\\Delta_K(\\zeta_q^j)\\ne0$ for every $1\\le j<q$, and in that case\n$$\n|H_1(\\Sigma_q(K);\\mathbb Z)|=\\prod_{j=1}^{q-1}|\\Delta_K(\\zeta_q^j)|.\n$$"
    ],
