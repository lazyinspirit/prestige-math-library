        "id": "lem-continuation-solutions-have-critical-limits",
        "kind": "lemma",
        "title": "Continuation solutions have critical limits and exponential decay",
        "deps": [
          "def-regular-continuation-datum-between-morse-smale-pairs",
          "def-morse-smale-pair",
