{
  "sources": [
    {
      "id": "thm-pac-mdp-value-functions",
      "target": "items/thm-pac-mdp-value-functions.md",
      "sha256": "da92c847d2dd516f1094e2c1152c42b8b1b5c3fed57b8b76fd362d55bf050d22",
      "asserts": "For each stationary policy $\\pi$, its value $V^\\pi$ satisfies its Bellman equation.",
      "exact_current_source_inclusion": true
    },
    {
      "id": "lem-pac-mdp-adaptive-sample-concentration",
      "target": "items/lem-pac-mdp-adaptive-sample-concentration.md",
      "sha256": "6ec2b86eaae01d688caebcee8c2a593e03cd860b7bb73108e10db40a26eba52b",
      "asserts": "$$\\mathbb P\\!\\left(\\left|\\frac1m\\sum_{i=1}^m R_i-r(s,a)\\right|>x\\right)\\le 2e^{-2mx^2}\\qquad(x>0).$$",
      "exact_current_source_inclusion": true
    },
    {
      "id": "lem-pac-mdp-value-simulation",
      "target": "items/lem-pac-mdp-value-simulation.md",
      "sha256": "8cfa58a63c1f386e9781dcf670440bcc1f607eb56f386238e8377f9ad470a1b4",
      "asserts": "$$\\|V_1^\\pi-V_2^\\pi\\|_\\infty\\le\\frac{\\alpha+\\gamma V\\beta}{1-\\gamma},\\qquad \\|V_1^*-V_2^*\\|_\\infty\\le\\frac{\\alpha+\\gamma V\\beta}{1-\\gamma}.$$",
      "exact_current_source_inclusion": true
    },
    {
      "id": "thm-pac-mdp-escape-event-reduction",
      "target": "items/thm-pac-mdp-escape-event-reduction.md",
      "sha256": "12bd30def11b1503835c6de7ec74ad16b1d5e282eababec3281144b97cfb8d73",
      "asserts": "Then, with probability at least $1-2\\rho$, the PAC-MDP count satisfies $N_{4\\eta}\\le HM$.",
      "exact_current_source_inclusion": true
    },
    {
      "id": "lem-r-max-empirical-model-accuracy",
      "target": "items/lem-r-max-empirical-model-accuracy.md",
      "sha256": "7605d7cdf81171b19f66791de14bf951f7cc989a2fcb622e8b68b54c7d0ecd8a",
      "asserts": "every stationary-policy value in $\\widehat M_{K_t}$ differs from its value in $M_{K_t}$ by at most $\\eta/8$",
      "exact_current_source_inclusion": true
    },
    {
      "id": "lem-delayed-q-learning-optimism-and-update-counts",
      "target": "items/lem-delayed-q-learning-optimism-and-update-counts.md",
      "sha256": "84b9ac082d20de7147e0f8adaf0e08f1eb7b72ab3749467042f3b8b65016ed66",
      "asserts": "The additive $1$ in each pair's update allowance is necessary, including when $U(s,a)=V^*(s)$.",
      "exact_current_source_inclusion": true
    },
    {
      "id": "thm-r-max-pac-bound",
      "target": "items/thm-r-max-pac-bound.md",
      "sha256": "f8e9333883e4028ad860ca5cb9e04acb988120c18e60de3601f8566eb27b5a84",
      "asserts": "Then $\\mathbb P(N_\\epsilon\\le HM)\\ge1-\\delta$.",
      "exact_current_source_inclusion": true
    },
    {
      "id": "thm-delayed-q-learning-pac-bound",
      "target": "items/thm-delayed-q-learning-pac-bound.md",
      "sha256": "41efe4ed860e37f6bfd81aa67d6e6e68a5396db457df6d4732d5d7701a6cd89c",
      "asserts": "The additive term remains when all heuristic slacks vanish.",
      "exact_current_source_inclusion": true
    },
    {
      "id": "ex-pac-mdp-nonpermanent-bad-steps",
      "target": "items/ex-pac-mdp-nonpermanent-bad-steps.md",
      "sha256": "18b94adb539acdff6f1df8d3484633f118362a9a12d698aafccae370a879e7a6",
      "asserts": "For $\\epsilon=1/2$, it has exactly $n+1$ bad steps, including one after a good step.",
      "exact_current_source_inclusion": true
    },
    {
      "id": "ex-pac-mdp-inadmissible-heuristic-fails",
      "target": "items/ex-pac-mdp-inadmissible-heuristic-fails.md",
      "sha256": "6fca20aa66f9105babd27671b7a82632aa1383690ee9a3236d37900ae1145683",
      "asserts": "It observes only $b$, chooses $b$ forever, and is $1/2$-bad at every time.",
      "exact_current_source_inclusion": true
    },
    {
      "id": "ex-pac-mdp-delayed-q-zero-slack",
      "target": "items/ex-pac-mdp-delayed-q-zero-slack.md",
      "sha256": "a607b1071e465ee14500293cce27c100038e9137423b0dc23869c161ac45b44e",
      "asserts": "Delayed Q-learning selects $b$ for its first $m$ samples and then lowers $Q(s,b)$, even though $\\sum_{s,a}[U(s,a)-V^*(s)]_+=0$.",
      "exact_current_source_inclusion": true
    }
  ]
}
