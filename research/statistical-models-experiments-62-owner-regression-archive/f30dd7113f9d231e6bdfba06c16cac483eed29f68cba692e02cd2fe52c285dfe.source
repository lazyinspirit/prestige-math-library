    "ex-technical-biological-units-and-repeated-visits": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-scientific-statistical-model-contract",
          "source_section": "Definition",
          "quote": "A **scientific statistical model contract** is an explicit record of the following fields for a specified analysis.",
          "uses": [
            "1.2",
            "3.1"
          ]
        },
        {
          "fact": "F2",
          "source": "def-statistical-experiment",
          "source_section": "Definition",
          "quote": "An **experiment** is a measurable space $(\\mathcal X,\\mathcal A)$, a set $\\Theta$ of parameter labels, and a family $(P_\\theta)_{\\theta\\in\\Theta}$ of probability measures on $(\\mathcal X,\\mathcal A)$",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F3",
          "source": "def-measurable-space",
          "source_section": "Definition",
          "quote": "A **measurable space** is a pair $(X,\\mathcal A)$ consisting of a set $X$ and a sigma-algebra $\\mathcal A$ on $X$ ([[def-sigma-algebra]]).",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F4",
          "source": "def-measure",
          "source_section": "Definition",
          "quote": "The second condition is **countable additivity**.",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F5",
          "source": "def-probability-measure",
          "source_section": "Definition",
          "quote": "A **probability measure** on a measurable space $(X,\\mathcal A)$ is a measure $\\mathbb P$ with $\\mathbb P(X)=1$",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F6",
          "source": "def-measurable-function-between-measurable-spaces",
          "source_section": "Definition",
          "quote": "A function $f : X \\to Y$ is **measurable** when",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F7",
          "source": "def-random-element-and-real-random-variable",
          "source_section": "Definition",
          "quote": "A **random element** of $S$ is a measurable map",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F8",
          "source": "def-law-or-distribution-of-a-random-element",
          "source_section": "Definition",
          "quote": "$$\\mathbb P_X:\\Sigma\\to[0,+\\infty],\\qquad \\mathbb P_X(B):=\\mathbb P(X^{-1}(B)).$$",
          "uses": [
            "2.1",
            "3.1"
          ]
        },
        {
          "fact": "F9",
          "source": "lem-law-of-a-random-element-is-a-probability-measure",
          "source_section": "Statement",
          "quote": "Let $X:(\\Omega,\\mathcal F,\\mathbb P)\\to(S,\\Sigma)$ be a random element. Then $\\mathbb P_X$ is a probability measure on $(S,\\Sigma)$.",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F10",
          "source": "def-parametric-statistical-model",
          "source_section": "Definition",
          "quote": "Its **parametric statistical model** is the parameter map",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F11",
          "source": "def-estimand-on-a-statistical-model",
          "source_section": "Definition",
          "quote": "an **estimand** or **parameter target** is a specified function",
          "uses": [
            "1.2"
          ]
        }
      ],
      "derivations": [
        {
          "id": "d1",
          "step": "1.1",
          "claim": "The assignment set has 70 elements, and its normalized counting function has empty-set mass zero, total mass one, and countable additivity because only finitely many disjoint subsets can be nonempty.",
          "inputs": [
            "given",
            "F4",
            "F5",
            "algebra",
            "construct"
          ]
        },
        {
          "id": "d2",
          "step": "1.2",
          "claim": "The eight biological and assignment units contribute 48 response coordinates across two visits and three technical readings, and the displayed finite-schedule contrast is the estimand.",
          "inputs": [
            "given",
            "F1",
            "F11",
            "algebra"
          ]
        },
        {
          "id": "d3",
          "step": "2.1",
          "claim": "The full-power-set data space is measurable; every record-map preimage is measurable; its law is a probability measure, so the parameterized laws define an experiment and parametric model.",
          "inputs": [
            "given",
            "F2",
            "F3",
            "F6",
            "F7",
            "F8",
            "F9",
            "F10",
            "step 1.1",
            "construct"
          ]
        },
        {
          "id": "d4",
          "step": "3.1",
          "claim": "The records generated by all assignments form a measurable full-probability support set, and the stated model averages over the assignment law.",
          "inputs": [
            "given",
            "F1",
            "F8",
            "step 2.1",
            "construct"
          ]
        }
      ],
