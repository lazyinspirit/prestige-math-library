          "case": "empty",
          "status": "not_applicable",
          "reason": "The example fixes eight participants and 70 assignments, so an empty study is outside its stated setup."
        },
        {
          "case": "zero",
          "status": "checked",
          "evidence": "Step 1.1 explicitly assigns zero mass to the empty set, and the construction has no denominator involving a response or offset."
        },
