    "ex-unvalidated-calibration-offset-is-not-identifiable": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-statistical-experiment",
          "source_section": "Definition",
          "quote": "An **experiment** is a measurable space $(\\mathcal X,\\mathcal A)$, a set $\\Theta$ of parameter labels, and a family $(P_\\theta)_{\\theta\\in\\Theta}$ of probability measures on $(\\mathcal X,\\mathcal A)$",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F2",
          "source": "def-parametric-statistical-model",
          "source_section": "Definition",
          "quote": "Its **parametric statistical model** is the parameter map",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F3",
          "source": "def-dirac-measure",
          "source_section": "Definition",
          "quote": "$$\\delta_{x_0}(E):=\\begin{cases}1,&x_0\\in E,\\\\0,&x_0\\notin E,\\end{cases}\\qquad E\\in\\mathcal A.$$",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F4",
          "source": "prop-dirac-measure-is-a-probability-measure",
          "source_section": "Statement",
          "quote": "For $x_0\\in X$, the Dirac set function $\\delta_{x_0}$ is a probability measure on every sigma-algebra on $X$.",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F5",
          "source": "def-estimand-on-a-statistical-model",
          "source_section": "Definition",
          "quote": "an **estimand** or **parameter target** is a specified function",
          "uses": [
            "1.2"
          ]
        },
        {
          "fact": "F6",
          "source": "def-identifiability-of-an-estimand",
          "source_section": "Definition",
          "quote": "An estimand $\\psi:\\Theta\\to\\mathcal T_0$ is **identifiable** in a parametric model $\\mathsf P$ when $$ P_\\theta=P_\\eta\\quad\\Longrightarrow\\quad\\psi(\\theta)=\\psi(\\eta)\\qquad(\\theta,\\eta\\in\\Theta), $$",
          "uses": [
            "1.2",
            "2.1"
          ]
        },
        {
          "fact": "F7",
          "source": "def-scientific-statistical-model-contract",
          "source_section": "Definition",
          "quote": "They do not assert that an empirical law equals a proposed model, that a design was implemented as specified, that calibration is valid, or that any scientific or physical application is adequate.",
          "uses": [
            "2.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "d1",
          "step": "1.1",
          "claim": "Every parameter pair assigns a probability measure to the stated measurable sample space, so the family is an experiment and its parameter map is a parametric model.",
          "inputs": [
            "given",
            "F1",
            "F2",
            "F4",
            "construct"
          ]
        },
        {
          "id": "d2",
          "step": "1.2",
          "claim": "The target q is a function from the parameter set to R and is therefore the stated estimand; the supplier definition gives the identifiability criterion.",
          "inputs": [
            "given",
            "F5",
            "F6"
          ]
        },
        {
          "id": "d3",
          "step": "2.1",
          "claim": "The explicit parameter shift preserves every event probability while changing q, which violates the identifiability implication and establishes no physical calibration fact.",
          "inputs": [
            "given",
            "F3",
            "F6",
            "F7",
            "algebra",
            "step 1.2"
          ]
        }
      ],
      "routine_steps": [],
      "finite_smoke": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "The sample space R and parameter space R squared are nonempty."
        },
        {
          "case": "zero",
          "status": "checked",
          "evidence": "Step 2.1 applies at q=0 and b=0; the explicit shift to (1,-1) preserves the reading and changes the target."
        },
        {
          "case": "one",
          "status": "checked",
          "evidence": "The example is exactly a single-reading model, and step 2.1 proves nonidentifiability for that observation law."
        },
        {
          "case": "degenerate",
          "status": "checked",
          "evidence": "Step 1.1 defines every sampling law as a Dirac law, so the proof includes degenerate observation distributions."
        },
        {
          "case": "endpoints",
          "status": "not_applicable",
          "reason": "The parameter set R squared has no boundary endpoints in this model."
        },
        {
          "case": "nonempty-choice",
          "status": "checked",
          "evidence": "Step 2.1 constructs the witness (q+1,b-1) directly and uses no selection principle."
        },
        {
          "case": "iff-forward",
          "status": "not_applicable",
          "reason": "The example proves failure of the one-way identifiability implication and states no biconditional."
        },
        {
          "case": "iff-reverse",
          "status": "not_applicable",
          "reason": "The example proves failure of the one-way identifiability implication and states no biconditional."
        }
      ]
