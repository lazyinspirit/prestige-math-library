    "cex-quotient-rule-needs-a-nonzero-limit": {
      "citations": [
        {
          "fact": "F1",
          "source": "ex-the-reciprocal-of-k-plus-one-is-null",
          "source_section": "Example",
          "quote": "The sequence of reals $x_k := (k+1)^{-1}$, with $k+1 = \\sigma(k)$ the successor of $k$ read in $\\mathbb{R}$ through the canonical-natural embedding ([[lem-of-naturals-positive]]), converges to $0$ ([[def-real-limit]], [[def-sequence]]). Every term is defined and positive.",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F2",
          "source": "lem-reciprocal-of-null-diverges",
          "source_section": "Statement",
          "quote": "Let $(x_k)$ be a sequence of reals with $x_k > 0$ for every $k \\in \\mathbb{N}$ ([[def-sequence]], [[def-real-order]]). Then $$(x_k) \\text{ converges to } 0 \\iff (1/x_k) \\text{ diverges to } +\\infty,$$ with convergence as in [[def-real-limit]] and divergence to $+\\infty$ as in [[def-divergence-to-infinity]].",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F3",
          "source": "def-divergence-to-infinity",
          "source_section": "Definition",
          "quote": "- $(x_k)$ **diverges to $+\\infty$**, written $x_k \\to +\\infty$, when for every $M \\in \\mathbb{R}$ there is $K \\in \\mathbb{N}$ such that $x_k > M$ for all $k \\ge K$.",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F4",
          "source": "def-field",
          "source_section": "Definition",
          "quote": "**(M)** Multiplication is associative and commutative **on all of $F$**, and $x \\cdot 1 = x$ for every $x \\in F$; moreover $(F \\setminus \\{0\\}, \\cdot)$ is an abelian group with identity $1$, so every $x \\ne 0$ has a multiplicative inverse $x^{-1}$ with $x \\cdot x^{-1} = 1$.",
          "uses": [
            "2.2"
          ]
        },
        {
          "fact": "F5",
          "source": "lem-convergent-implies-bounded",
          "source_section": "Statement",
          "quote": "Let $(x_k)$ be a sequence of reals converging to $x \\in \\mathbb{R}$ ([[def-sequence]], [[def-real-limit]]). Then $(x_k)$ is bounded: there is $M \\in \\mathbb{R}$ with $|x_k| \\le M$ for every $k \\in \\mathbb{N}$.",
          "uses": [
            "3.1"
          ]
        },
        {
          "fact": "F5",
          "source": "def-divergence-to-infinity",
          "source_section": "Definition",
          "quote": "- $(x_k)$ **diverges to $+\\infty$**, written $x_k \\to +\\infty$, when for every $M \\in \\mathbb{R}$ there is $K \\in \\mathbb{N}$ such that $x_k > M$ for all $k \\ge K$.",
          "uses": [
            "3.1"
          ]
        },
        {
          "fact": "F5",
          "source": "def-sequence",
          "source_section": "Definition",
          "quote": "- $(x_k)$ is **bounded** if there is $M \\in \\mathbb{R}$ with $|x_k| \\le M$ for every $k \\in \\mathbb{N}$; it is **unbounded** otherwise.",
          "uses": [
            "3.1"
          ]
        },
        {
          "fact": "F6",
          "source": "thm-algebra-of-limits",
          "source_section": "Statement",
          "quote": "and if in addition $y \\ne 0$ and $y_k \\ne 0$ for every $k \\in \\mathbb{N}$, then $$\\frac{1}{y_k} \\to \\frac{1}{y} \\qquad \\text{and} \\qquad \\frac{x_k}{y_k} \\to \\frac{x}{y}.$$",
          "uses": [
            "3.1"
          ]
        },
        {
