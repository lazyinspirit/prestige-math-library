      "citations": [
        {
          "fact": "F1",
          "source": "fs-bounded-implies-convergent",
          "source_section": "Statement",
          "quote": "The sequence usually written $x_k = (-1)^k$ is introduced here by recursion ([[thm-recursion]]), as the unique $(s_k)$ with $s_0 = 1$ and $s_{\\sigma(k)} = -s_k$.",
