    "ex-the-reciprocal-of-k-plus-one-is-null": {
      "citations": [
        {
          "fact": "F1",
          "source": "lem-rat-embeds-dense",
          "source_section": "Statement",
          "quote": "Consequently, strictly between any two reals lies a rational.",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F2",
          "source": "lem-rat-archimedean",
          "source_section": "Statement",
          "quote": "Consequently, for every rational $\\varepsilon > 0$ there is a natural $n \\ge 1$ with $1/n < \\varepsilon$.",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F3",
          "source": "lem-of-inverse-positive",
          "source_section": "Statement",
          "quote": "1. If $a > 0$ then $a^{-1} > 0$. 2. If $0 < a < b$ then $0 < b^{-1} < a^{-1}$.",
          "uses": [
            "3.1",
            "4.1"
          ]
        },
        {
          "fact": "F4",
          "source": "lem-of-naturals-positive",
          "source_section": "Statement",
          "quote": "- $n \\cdot 1_F > 0$ and $(n+1) \\cdot 1_F > n \\cdot 1_F$; - the map $n \\mapsto n \\cdot 1_F$ is strictly increasing, hence injective, on $\\{1, 2, 3, \\dots\\}$;",
          "uses": [
            "2.1",
            "4.1"
          ]
        },
        {
          "fact": "F5",
          "source": "lem-nat-order-add-compatible",
          "source_section": "Statement",
          "quote": "For all $m, n, k \\in \\mathbb{N}$: $m \\le n \\iff m + k \\le n + k$; and $m < n \\iff m + k < n + k$ ([[def-nat-order]]).",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F5",
          "source": "def-nat-order",
          "source_section": "Definition",
          "quote": "and the **strict order** by $m < n \\iff (m \\le n \\text{ and } m \\neq n)$, using addition ([[def-nat-addition]]).",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F6",
          "source": "def-abs-value",
          "source_section": "Definition",
          "quote": "$$|x| \\;:=\\; \\begin{cases} x & \\text{if } x \\ge 0, \\\\ -x & \\text{if } x < 0. \\end{cases}$$",
          "uses": [
            "4.1"
          ]
        },
        {
          "fact": "F7",
          "source": "def-real-limit",
          "source_section": "Definition",
          "quote": "A sequence $(x_k)$ of reals **converges** to $x \\in \\mathbb{R}$ when for every rational $\\varepsilon > 0$ there is $K$ with $|x_k - x| < \\hat\\varepsilon$ for all $k \\ge K$.",
          "uses": [
            "5.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "d-1.1",
          "claim": "For every real ε>0 there are a rational q with 0<q<ε and a natural N≥1 with N^{-1}<q.",
          "step": "1.1",
          "inputs": [
            "given",
            "F1",
            "F2"
          ]
        },
        {
          "id": "d-2.1",
          "claim": "For every natural k≥N one has N+1≤k+1 in ℕ, ι(N)>0, ι(N)<ι(N+1), and ι(N+1)≤ι(k+1).",
          "step": "2.1",
          "inputs": [
            "step 1.1",
            "F4",
            "F5"
          ]
        },
        {
          "id": "d-3.1",
          "claim": "For every k≥N, (k+1)^{-1} ≤ (N+1)^{-1} < N^{-1} < q < ε.",
          "step": "3.1",
          "inputs": [
            "step 2.1",
            "step 1.1",
            "F3"
          ]
        },
        {
          "id": "d-4.1",
          "claim": "Each x_k is positive, |x_k−0|=(k+1)^{-1}, and hence |x_k−0|<ε for all k≥N.",
          "step": "4.1",
          "inputs": [
            "step 3.1",
            "F3",
            "F4",
            "F6"
          ]
        },
        {
          "id": "d-5.1",
          "claim": "For every rational ε>0 the threshold N witnesses |x_k−0|<ε for all k≥N, so x_k→0.",
          "step": "5.1",
          "inputs": [
            "step 1.1",
            "step 4.1",
            "F7"
          ]
        }
      ],
