    "ex-successive-root-differences": {
      "citations": [
        {
          "fact": "F1",
          "source": "ex-square-roots-diverge-to-infinity",
          "source_section": "Example",
          "quote": "Let $\\sqrt{k}$ denote the unique nonnegative square root of the canonical natural $k \\in \\mathbb{R}$ ([[thm-of-square-roots]]). Then $(\\sqrt{k})_{k \\in \\mathbb{N}}$ diverges to $+\\infty$ ([[def-divergence-to-infinity]])",
          "uses": [
            "2.1",
            "3.1"
          ]
        },
        {
          "fact": "F2",
          "source": "lem-reciprocal-of-null-diverges",
          "source_section": "Statement",
          "quote": "Let $(x_k)$ be a sequence of reals with $x_k > 0$ for every $k \\in \\mathbb{N}$ ([[def-sequence]], [[def-real-order]]). Then $$(x_k) \\text{ converges to } 0 \\iff (1/x_k) \\text{ diverges to } +\\infty,$$ with convergence as in [[def-real-limit]] and divergence to $+\\infty$ as in [[def-divergence-to-infinity]].",
          "uses": [
            "3.1"
          ]
        },
        {
          "fact": "F3",
          "source": "thm-of-square-roots",
          "source_section": "Statement",
          "quote": "Let $F$ be a complete ordered field ([[def-complete-ordered-field]]). Then every $a \\in F$ with $a \\ge 0$ has a **unique** $s \\in F$ with $s \\ge 0$ and $s^2 = a$; we write $s = \\sqrt{a}$.",
          "uses": [
            "1.1",
            "1.2",
            "1.3"
          ]
        },
        {
          "fact": "F4",
          "source": "def-divergence-to-infinity",
          "source_section": "Definition",
          "quote": "- $(x_k)$ **diverges to $+\\infty$**, written $x_k \\to +\\infty$, when for every $M \\in \\mathbb{R}$ there is $K \\in \\mathbb{N}$ such that $x_k > M$ for all $k \\ge K$.",
          "uses": [
            "1.3",
            "2.1"
          ]
        },
        {
          "fact": "F5",
          "source": "def-field",
          "source_section": "Definition",
          "quote": "**(M)** Multiplication is associative and commutative **on all of $F$**, and $x \\cdot 1 = x$ for every $x \\in F$; moreover $(F \\setminus \\{0\\}, \\cdot)$ is an abelian group with identity $1$, so every $x \\ne 0$ has a multiplicative inverse $x^{-1}$ with $x \\cdot x^{-1} = 1$.",
          "uses": [
            "1.1",
            "3.1"
          ]
        },
        {
          "fact": "F6",
          "source": "lem-of-square-monotone",
          "source_section": "Statement",
          "quote": "For $a, b \\ge 0$: $$a < b \\iff a^2 < b^2, \\qquad a \\le b \\iff a^2 \\le b^2.$$",
          "uses": [
            "1.1",
            "1.3"
          ]
        },
        {
          "fact": "F7",
          "source": "lem-of-add-order",
          "source_section": "Statement",
          "quote": "1. **Translation invariance.** If $a < b$ then $a + c < b + c$. 2. **Adding inequalities.** If $a < b$ and $c < d$ then $a + c < b + d$.",
          "uses": [
            "1.1",
            "1.2"
          ]
        },
        {
          "fact": "F8",
          "source": "cor-of-one-positive",
          "source_section": "Statement",
          "quote": "In any ordered field $F$ with positive cone $P$, the multiplicative identity satisfies $0 < 1$; that is, $1 \\in P$.",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F9",
          "source": "thm-of-archimedean",
          "source_section": "Statement",
          "quote": "Every complete ordered field $F$ ([[def-complete-ordered-field]]) is Archimedean: for every $x \\in F$ there is a natural number $n \\ge 1$ with $x < n \\cdot 1_F$, where $n \\cdot 1_F$ is the canonical natural of the ordered field $F$ ([[def-ordered-field]]).",
          "uses": [
            "1.3"
          ]
        },
        {
          "fact": "F10",
          "source": "lem-of-naturals-positive",
          "source_section": "Statement",
          "quote": "- $n \\cdot 1_F > 0$ and $(n+1) \\cdot 1_F > n \\cdot 1_F$; - the map $n \\mapsto n \\cdot 1_F$ is strictly increasing, hence injective, on $\\{1, 2, 3, \\dots\\}$;",
          "uses": [
            "1.1",
            "1.3"
          ]
        },
        {
          "fact": "F11",
          "source": "lem-of-inverse-positive",
          "source_section": "Statement",
          "quote": "1. If $a > 0$ then $a^{-1} > 0$. 2. If $0 < a < b$ then $0 < b^{-1} < a^{-1}$.",
          "uses": [
            "3.1"
          ]
        }
      ],
      "derivations": [
