    {
      "id": "def-sharpp-and-gap-p-functions",
      "statement": "A #P function maps each input to the number of accepting paths of a binary-branching polynomial-time nondeterministic machine; a GapP function is accepting paths minus rejecting paths.",
      "used_by": [
        "prop-number-sat-is-in-sharpp",
        "thm-number-sat-is-sharpp-complete",
        "prop-fp-is-contained-in-sharpp",
