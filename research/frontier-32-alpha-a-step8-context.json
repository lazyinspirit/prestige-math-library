        "prop-np-is-contained-in-p-sharpp",
        "fs-sharpp-is-a-language-class"
      ]
    },
    {
      "id": "def-circuit-family-and-p-poly",
      "statement": "P/poly contains exactly the languages recognized by circuit families of polynomial size, with no requirement to construct C_n from n.",
      "used_by": [
        "thm-p-is-contained-in-p-poly",
        "thm-p-poly-equals-p-with-polynomial-advice",
        "thm-undecidable-languages-exist-in-p-poly",
        "thm-karp-lipton-collapse",
        "fs-polynomial-size-implies-uniform-generation"
      ]
    },
    {
      "id": "lem-cook-levin-can-be-made-parsimonious",
      "statement": "For every fixed polynomial-time nondeterministic machine N, one can compute in polynomial time a formula whose satisfying assignments are in bijection with N's accepting paths.",
      "used_by": [
        "thm-number-sat-is-sharpp-complete",
        "cor-majority-sat-is-pp-complete",
        "ex-cook-levin-can-be-made-parsimonious"
      ]
    },
    {
      "id": "def-ip",
      "statement": "IP consists of languages with polynomially bounded interaction, a probabilistic polynomial-time verifier, completeness at least 2/3, and soundness at most 1/3.",
      "used_by": [
        "prop-np-is-contained-in-ip",
        "def-private-coin-public-coin-and-arthur-merlin-protocol",
        "thm-ip-is-contained-in-pspace",
        "thm-graph-nonisomorphism-is-in-ip"
      ]
    },
    {
      "id": "def-martin-lof-test-and-random-sequence",
      "statement": "A Martin-Löf test is a uniformly effectively open sequence (U_n) with μ(U_n)≤2^(-n); X is Martin-Löf random if it avoids the intersection of every such test.",
      "used_by": [
        "lem-universal-martin-lof-test-exists",
        "thm-levin-schnorr-characterization",
        "thm-martin-lof-randomness-implies-computable-randomness",
        "fs-normality-implies-algorithmic-randomness"
      ]
    },
    {
      "id": "thm-kraft-inequality",
      "statement": "If D is prefix-free, then Σ_{p∈D}2^(-|p|)≤1; conversely, a computably enumerable Kraft-bounded request list has an effective prefix-free allocation.",
      "used_by": [
        "thm-symmetry-of-information-up-to-logarithmic-terms",
        "thm-levin-schnorr-characterization",
        "thm-effective-dimension-is-liminf-prefix-complexity-rate"
      ]
    },
    {
      "id": "thm-computably-dominated-characterizes-truth-table-reducibility",
      "statement": "For X⊆N, X is computably dominated iff every Y≤_T X satisfies Y≤_tt X.",
      "used_by": [
        "thm-some-turing-reductions-are-not-truth-table-reductions",
        "ex-some-turing-reductions-are-not-truth-table-reductions"
      ]
    },
    {
      "id": "def-truth-table-reduction",
      "statement": "Y≤_tt X means that an oracle functional computes χ_Y from X and halts with a bit for every oracle and every input.",
      "used_by": [
        "lem-total-oracle-functional-has-computable-use-bound",
        "prop-truth-table-implies-turing-reduction",
        "thm-computably-dominated-characterizes-truth-table-reducibility",
        "ex-some-turing-reductions-are-not-truth-table-reductions"
      ]
    }
  ],
