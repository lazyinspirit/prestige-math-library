  "load_bearing": [
    {
      "id": "thm-snake-lemma-in-an-abelian-category",
      "statement": "For snake data ... there is an exact sequence 0 -> ker(f) -> ker(g) -> ker(h) -> coker(f) -> coker(g) -> coker(h) -> 0, where the middle map ker(h) -> coker(f) is the connecting morphism.",
