        "deps": [
          "def-sigma-algebra",
          "def-lambda-system",
          "def-monotone-class"
        ]
      },
      {
        "id": "thm-trace-is-a-sigma-algebra",
        "kind": "theorem",
        "title": "The trace of a sigma-algebra is a sigma-algebra on the traced subset",
        "strategy": "direct",
        "deps": [
          "def-trace-sigma-algebra"
        ]
      },
      {
        "id": "thm-generated-trace-commutes",
        "kind": "theorem",
        "title": "Generating a sigma-algebra commutes with taking traces",
        "strategy": "direct",
        "deps": [
          "thm-generated-sigma-algebra-exists-and-is-minimal",
          "def-trace-sigma-algebra",
          "thm-trace-is-a-sigma-algebra"
        ]
      },
      {
        "id": "lem-open-subsets-of-r-are-countable-unions-of-rational-intervals",
        "kind": "lemma",
        "title": "Every open subset of the real line is a countable union of open intervals with rational endpoints",
        "strategy": "direct",
        "deps": [
          "thm-rational-points-and-boxes-in-rn"
        ]
      },
      {
        "id": "thm-seven-generators-of-the-borel-sigma-algebra-on-r",
        "kind": "theorem",
        "title": "Seven generating families for the Borel sigma-algebra on the real line",
        "strategy": "direct",
        "deps": [
          "def-borel-sigma-algebra",
          "thm-generated-sigma-algebra-comparison-criterion",
          "lem-open-subsets-of-r-are-countable-unions-of-rational-intervals"
        ]
      },
      {
        "id": "thm-rational-box-generators-of-the-borel-sigma-algebra-on-rn",
        "kind": "theorem",
        "title": "For n at least one, open sets, closed sets, compact sets, open balls, boxes, rational open boxes, and rational half-open boxes generate the Borel sigma-algebra on R^n",
        "strategy": "direct",
        "deps": [
          "def-borel-sigma-algebra",
          "thm-generated-sigma-algebra-comparison-criterion",
          "thm-rational-points-and-boxes-in-rn",
