    ],
    "items": [
      {
        "id": "def-algebra-of-subsets",
        "kind": "definition",
        "title": "Algebras of subsets",
        "deps": []
      },
      {
        "id": "def-sigma-algebra",
        "kind": "definition",
        "title": "Sigma-algebras",
        "deps": [
          "def-algebra-of-subsets"
        ]
      },
      {
        "id": "def-measurable-space",
        "kind": "definition",
        "title": "Measurable spaces and measurable sets",
        "deps": [
          "def-sigma-algebra"
        ]
      },
      {
        "id": "def-generated-sigma-algebra",
        "kind": "definition",
        "title": "The sigma-algebra generated by a family of sets",
        "deps": [
          "def-sigma-algebra"
        ]
      },
      {
        "id": "thm-generated-sigma-algebra-exists-and-is-minimal",
        "kind": "theorem",
        "title": "Nonempty intersections of sigma-algebras are sigma-algebras, so the generated sigma-algebra exists and is minimal",
        "strategy": "direct",
        "deps": [
          "def-generated-sigma-algebra"
        ]
      },
      {
        "id": "def-pi-system",
        "kind": "definition",
        "title": "Pi-systems",
        "deps": []
      },
      {
        "id": "def-lambda-system",
        "kind": "definition",
        "title": "Lambda-systems, or Dynkin systems",
        "deps": []
      },
      {
        "id": "prop-complement-and-disjoint-union-axioms-for-a-lambda-system",
        "kind": "proposition",
        "title": "A family is a lambda-system exactly when it contains $X$ and is closed under complements and countable disjoint unions",
        "strategy": "Forward: complements come from $A\\subseteq X$; finite disjoint unions are built by induction as complements of relative differences, and the partial unions increase. Reverse: $B\\setminus A$ is the complement of the disjoint union $A\\sqcup(X\\setminus B)$, and an increasing union is disjointified.",
        "deps": [
          "def-lambda-system"
        ]
      },
      {
        "id": "def-generated-lambda-system",
        "kind": "definition",
        "title": "The lambda-system generated by a family of sets",
        "deps": [
          "def-lambda-system"
        ]
      },
      {
        "id": "lem-generated-lambda-system-exists-and-is-minimal",
        "kind": "lemma",
        "title": "The generated lambda-system exists and is minimal",
        "strategy": "direct",
        "deps": [
          "def-generated-lambda-system"
        ]
      },
      {
        "id": "def-monotone-class",
        "kind": "definition",
        "title": "Monotone classes of sets",
        "deps": []
      },
      {
        "id": "def-generated-monotone-class",
        "kind": "definition",
        "title": "The monotone class generated by a family of sets",
        "deps": [
          "def-monotone-class"
        ]
      },
      {
        "id": "lem-generated-monotone-class-exists-and-is-minimal",
        "kind": "lemma",
        "title": "The generated monotone class exists and is minimal",
        "strategy": "direct",
        "deps": [
          "def-generated-monotone-class"
        ]
      },
      {
        "id": "def-borel-sigma-algebra",
        "kind": "definition",
        "title": "The Borel sigma-algebra of a topological space",
        "deps": [
          "def-generated-sigma-algebra",
          "thm-generated-sigma-algebra-exists-and-is-minimal",
          "def-topological-space"
        ]
      },
      {
        "id": "def-trace-sigma-algebra",
        "kind": "definition",
        "title": "The trace of a sigma-algebra on a subset",
        "deps": [
          "def-sigma-algebra"
        ]
      },
      {
        "id": "def-set-limsup-and-liminf",
        "kind": "definition",
        "title": "Limit superior and limit inferior of a sequence of sets",
        "deps": []
      },
      {
        "id": "thm-sigma-algebra-closure-laws",
        "kind": "theorem",
        "title": "Sigma-algebras are closed under countable intersections, differences, symmetric differences, and set limits",
        "strategy": "direct",
        "deps": [
          "def-sigma-algebra",
          "def-set-limsup-and-liminf"
        ]
      },
      {
        "id": "prop-set-limsup-and-liminf-membership",
        "kind": "proposition",
        "title": "Set liminf means eventual membership, set limsup means repeated membership, and liminf is contained in limsup",
        "strategy": "direct",
        "deps": [
          "def-set-limsup-and-liminf"
        ]
      },
      {
        "id": "thm-generated-sigma-algebra-calculus",
        "kind": "theorem",
        "title": "Generated sigma-algebras are monotone in their generators and idempotent",
        "strategy": "direct",
        "deps": [
          "thm-generated-sigma-algebra-exists-and-is-minimal"
        ]
      },
      {
        "id": "thm-generated-sigma-algebra-comparison-criterion",
        "kind": "theorem",
        "title": "Two families generate the same sigma-algebra when each lies in the sigma-algebra generated by the other",
        "strategy": "direct",
        "deps": [
          "thm-generated-sigma-algebra-calculus"
        ]
      },
      {
        "id": "lem-algebra-with-countable-disjoint-unions-is-sigma",
        "kind": "lemma",
        "title": "An algebra closed under countable disjoint unions is a sigma-algebra",
        "strategy": "direct",
        "deps": [
          "def-algebra-of-subsets",
          "def-sigma-algebra"
        ]
      },
      {
        "id": "lem-algebra-with-increasing-unions-is-sigma",
        "kind": "lemma",
        "title": "An algebra closed under increasing countable unions is a sigma-algebra",
        "strategy": "direct",
        "deps": [
          "def-algebra-of-subsets",
          "def-sigma-algebra"
        ]
      },
      {
        "id": "lem-lambda-system-with-finite-intersections-is-sigma",
        "kind": "lemma",
        "title": "A lambda-system closed under finite intersections is a sigma-algebra",
        "strategy": "direct",
        "deps": [
          "def-lambda-system",
          "def-sigma-algebra"
        ]
      },
      {
        "id": "lem-lambda-good-sets",
        "kind": "lemma",
        "title": "For a member A of a lambda-system D, the sets B with A intersection B in D form a lambda-system",
        "strategy": "direct",
        "deps": [
          "def-lambda-system"
        ]
      },
      {
        "id": "lem-generated-lambda-system-closed-under-intersections",
        "kind": "lemma",
        "title": "The lambda-system generated by a pi-system is closed under finite intersections",
        "strategy": "direct",
        "deps": [
          "def-pi-system",
          "lem-generated-lambda-system-exists-and-is-minimal",
          "lem-lambda-good-sets"
        ]
      },
      {
        "id": "thm-dynkin-pi-lambda",
        "kind": "theorem",
        "title": "Dynkin's pi-lambda theorem",
        "strategy": "direct",
        "deps": [
          "lem-generated-lambda-system-closed-under-intersections",
          "lem-lambda-system-with-finite-intersections-is-sigma",
          "lem-generated-lambda-system-exists-and-is-minimal",
          "thm-generated-sigma-algebra-exists-and-is-minimal"
        ]
      },
      {
        "id": "lem-generated-monotone-class-closed-under-complements",
        "kind": "lemma",
        "title": "The monotone class generated by an algebra is closed under complements",
        "strategy": "direct",
        "deps": [
          "def-algebra-of-subsets",
          "lem-generated-monotone-class-exists-and-is-minimal"
        ]
      },
      {
        "id": "lem-monotone-good-sets-for-algebra-elements",
        "kind": "lemma",
        "title": "Every member of the generated monotone class intersects every original algebra member inside the generated class",
        "strategy": "direct",
        "deps": [
          "def-algebra-of-subsets",
          "lem-generated-monotone-class-exists-and-is-minimal"
        ]
      },
      {
        "id": "lem-generated-monotone-class-closed-under-intersections",
        "kind": "lemma",
        "title": "The monotone class generated by an algebra is closed under finite intersections",
        "strategy": "direct",
        "deps": [
          "lem-generated-monotone-class-exists-and-is-minimal",
          "lem-monotone-good-sets-for-algebra-elements"
        ]
      },
      {
        "id": "thm-monotone-class",
        "kind": "theorem",
        "title": "The monotone class generated by an algebra equals the sigma-algebra it generates",
        "strategy": "direct",
        "deps": [
          "thm-generated-sigma-algebra-exists-and-is-minimal",
          "lem-generated-monotone-class-exists-and-is-minimal",
          "lem-generated-monotone-class-closed-under-complements",
          "lem-generated-monotone-class-closed-under-intersections",
          "lem-algebra-with-increasing-unions-is-sigma"
