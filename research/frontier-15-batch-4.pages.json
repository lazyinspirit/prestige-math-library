        "id": "lem-listed-infinite-sigma-algebra-has-a-disjoint-sequence",
        "kind": "lemma",
        "title": "A sigma-algebra with a listed infinite subfamily contains a disjoint sequence of nonempty members",
        "strategy": "constructive",
        "deps": [
          "def-sigma-algebra",
          "def-countable"
        ]
      },
      {
        "id": "thm-infinite-sigma-algebra-has-continuum-many-members",
        "kind": "theorem",
        "title": "Assuming countable choice, every infinite sigma-algebra contains a copy of the power set of the natural numbers",
        "strategy": "constructive",
        "deps": [
          "lem-listed-infinite-sigma-algebra-has-a-disjoint-sequence",
          "def-countable-choice",
          "thm-cantor-powerset",
          "def-equinumerous"
        ]
      },
      {
        "id": "cor-no-sigma-algebra-is-countably-infinite",
        "kind": "corollary",
        "title": "No sigma-algebra is countably infinite",
        "strategy": "contradiction",
        "deps": [
          "lem-listed-infinite-sigma-algebra-has-a-disjoint-sequence",
          "thm-cantor-powerset",
          "thm-schroder-bernstein",
          "def-countable"
        ]
      },
      {
        "id": "thm-sigma-algebra-generated-by-a-countable-partition",
        "kind": "theorem",
        "title": "A countable partition generates exactly the unions of its blocks, and the resulting sigma-algebra is countable exactly for a finite partition",
        "strategy": "direct",
        "deps": [
          "thm-generated-sigma-algebra-exists-and-is-minimal",
          "def-countable",
          "thm-cantor-powerset",
          "thm-schroder-bernstein"
        ]
      }
    ]
