        "id": "thm-cardinality-of-the-borel-sigma-algebra-on-rn",
        "kind": "theorem",
        "title": "Assuming the Axiom of Choice, the Borel sigma-algebra on R^n has cardinality continuum for n at least one",
        "strategy": "direct",
        "deps": [
          "thm-cardinality-bound-for-generated-sigma-algebras",
          "thm-rational-box-generators-of-the-borel-sigma-algebra-on-rn",
          "thm-rationals-countable",
          "lem-cardinal-operations-are-well-defined",
