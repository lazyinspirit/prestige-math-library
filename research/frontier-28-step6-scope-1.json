      "observed_sha256": "b3e59be2d9d4ce81efc1f71078ec21f3773b1734979a1f7a1644efa69b21d578"
    },
    {
      "obligation": "refuter:1:6",
      "id": "thm-torsion-theorem-for-c-prime-one-sixth-groups",
      "location": "Proof 2.1",
      "defect": "unlicensed-inference",
      "evidence": "The cited Greendlinger lemma gives only a face with an outer arc longer than half its perimeter. The proof then says “Standard periodic-overlap cancellation then forces the relator ... to be a proper power ... and the boundary word u to be conjugate to a power” without a supplied lemma or argument connecting repetition on u^n to a second occurrence in that relator. This is the essential torsion-theorem inference, not a consequence stated by [L1].",
