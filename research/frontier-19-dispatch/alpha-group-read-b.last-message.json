,"matters_for":["lem-support-membership-by-annihilator","lem-support-of-a-cyclic-module-is-its-vanishing-set","thm-support-and-annihilator-of-a-finite-module","thm-support-in-a-short-exact-sequence","thm-support-under-localisation"]},{"convention":"The Jacobson radical is the intersection of maximal ideals, with the explicit empty-intersection convention J(0)=0.","fixed_by":"def-jacobson-radical-of-a-ring","matters_for":["thm-jacobson-radical-unit-characterisation","thm-nakayama-lemma","ex-nakayama-jacobson-hypothesis-is-essential"]},{"convention":"The maximal-ideal local criteria and Nakayama results explicitly assume the Axiom of Choice.","fixed_by":"thm-local-criterion-for-zero-modules-and-maps","matters_for":["thm-local-criterion-for-exactness-of-modules","thm-nakayama-lemma","cor-nakayama-generators-modulo-an-ideal","cor-minimal-generators-over-a-local-ring","ex-local-test-for-an-isomorphism"]}],"load_bearing":[{"id":"def-discriminant-of-binary-quadratic-form","statement":"The discriminant of f=(a,b,c)=ax²+bxy+cy² is Δ(f):=b²−4ac.","used_by":["prop-binary-quadratic-form-discriminants-modulo-four","def-principal-binary-quadratic-form","prop-proper-equivalence-preserves-discriminant-and-primitivity","prop-discriminant-square-mod-four-n-criterion-for-primitive-representation","prop-positive-definite-binary-form-criterion","lem-reduced-forms-with-the-same-leading-coefficient-are-equal","lem-leading-coefficient-bound-for-a-reduced-form","def-binary-quadratic-form-class-number","cex-same-discriminant-does-not-imply-proper-equivalence","cex-indefinite-classes-have-cycles-of-reduced-forms"]},{"id":"thm-field-norm-and-trace-by-embeddings","statement":"For a finite K/F, algebraic closure Ω, Σ=Hom_F(K,Ω), and inseparable degree i, Tr_{K/F}(a)=iΣ_{σ∈Σ}σ(a) and N_{K/F}(a)=(∏_{σ∈Σ}σ(a))^i.","used_by":["thm-basic-laws-for-field-norm-and-trace","thm-trace-form-is-nondegenerate-iff-separable","thm-hilberts-theorem-90","ex-norm-and-trace-in-a-quadratic-extension","ex-norm-and-trace-in-a-finite-field-extension","ex-trace-vanishes-on-a-purely-inseparable-extension","ex-x-cubed-minus-two-over-q-omega-is-cyclic","ex-q-zeta-three-cuberoot-two-cuberoot-three-is-a-kummer-extension","fs-the-norm-is-always-the-product-of-the-embeddings"]},{"id":"def-localisation-of-a-module","statement":"For commutative R, multiplicative S, and an R-module M, S^−1M is the set of classes of (m,s) under (m,s)∼(n,t) iff u(tm−sn)=0 for some u∈S, with (m/s)+(n/t)=(tm+sn)/(st) and (a/u)(m/s)=am/(us).","used_by":["lem-localised-module-fraction-equivalence-is-an-equivalence-relation","lem-localised-module-addition-independent-of-representatives","lem-localised-module-scalar-action-independent-of-representatives","thm-universal-property-localisation-of-a-module","lem-zero-in-a-localised-module","lem-localisation-preserves-surjectivity","lem-localised-hom-finite-free-case","ex-localisation-kills-exactly-s-torsion","ex-localisation-does-not-commute-with-products"]},{"id":"def-proper-equivalence-of-binary-quadratic-forms","statement":"Integral forms f and g are properly equivalent when some M=[[p,q],[r,s]]∈SL₂(Z) satisfies g(x,y)=f(px+qy,rx+sy) for all integers x,y; then g=f|M.","used_by":["lem-binary-quadratic-form-substitution-is-a-right-action","thm-proper-equivalence-preserves-representations","prop-proper-equivalence-preserves-discriminant-and-primitivity","prop-discriminant-square-mod-four-n-criterion-for-primitive-representation","lem-gauss-reduction-step-improves-a-positive-definite-form","lem-leading-coefficient-is-minimal-in-a-reduced-class","lem-reduced-forms-with-the-same-leading-coefficient-are-equal","ex-proper-versus-improper-equivalence-of-forms"]},{"id":"thm-unique-reduced-positive-definite-binary-quadratic-form","statement":"Each proper-equivalence class of positive-definite integral binary quadratic forms contains exactly one reduced form.","used_by":["cor-finiteness-of-positive-definite-binary-form-classes","cor-binary-quadratic-form-equivalence-is-decidable","ex-reduced-forms-of-discriminant-minus-four","ex-reduced-forms-of-discriminant-minus-eight","ex-reduced-forms-of-discriminant-minus-twenty","ex-reduced-forms-of-discriminant-minus-twenty-three","cex-same-represented-integers-do-not-imply-proper-equivalence","cex-indefinite-classes-have-cycles-of-reduced-forms"]},{"id":"def-reduced-positive-definite-binary-quadratic-form","statement":"A positive-definite form (a,b,c) is reduced when |b|≤a≤c and b≥0 whenever |b|=a or a=c.","used_by":["lem-gauss-reduction-step-improves-a-positive-definite-form","thm-reduction-of-positive-definite-binary-quadratic-forms","lem-leading-coefficient-is-minimal-in-a-reduced-class","lem-reduced-forms-with-the-same-leading-coefficient-are-equal","lem-leading-coefficient-bound-for-a-reduced-form","ex-reducing-a-large-binary-quadratic-form","cex-same-represented-integers-do-not-imply-proper-equivalence"]},{"id":"thm-cyclic-degree-n-extensions-with-roots-of-unity-are-kummer","statement":"If n≥1, char(F)∤n, F contains a primitive n-th root of unity, and [K:F]=n, then K/F is cyclic iff K=F(α), α^n∈F, and x^n−α^n is irreducible over F.","used_by":["def-kummer-extension","thm-kummer-pairing-is-perfect","thm-kummer-correspondence","thm-solvable-by-radicals-implies-a-solvable-galois-group","thm-solvable-galois-group-implies-solvable-by-radicals","ex-x-cubed-minus-two-over-q-omega-is-cyclic","ex-cardano-from-the-lagrange-resolvent"]},{"id":"lem-zero-in-a-localised-module","statement":"For m∈M and s∈S, m/s=0 in S^−1M iff um=0 for some u∈S.","used_by":["lem-localisation-preserves-injectivity","lem-localised-hom-finite-free-case","thm-localisation-of-hom-for-finitely-presented-modules","thm-local-criterion-for-zero-modules-and-maps","lem-support-membership-by-annihilator","ex-localising-an-abelian-group-at-a-prime","ex-localisation-kills-exactly-s-torsion"]},{"id":"def-support-of-a-module","statement":"For a commutative ring R and R-module M, Supp_R(M):={p prime : M_p≠0}.","used_by":["lem-support-membership-by-annihilator","lem-support-of-a-cyclic-module-is-its-vanishing-set","thm-support-in-a-short-exact-sequence","thm-support-of-arbitrary-direct-sums","thm-support-under-localisation","cor-finite-module-locally-zero-near-a-prime","ex-support-of-a-cyclic-module"]},{"id":"thm-localisation-of-modules-is-tensor-product","statement":"For commutative R, multiplicative S, and an R-module M, Φ:(S^−1R)⊗_R M→S^−1M, Φ((a/s)⊗m)=am/s, is an S^−1R-module isomorphism with inverse m/s↦(1/s)⊗m.","used_by":["thm-localisation-of-modules-commutes-with-quotients-and-sums","thm-localisation-of-modules-is-exact","thm-support-of-a-tensor-product-of-finite-modules","ex-localising-an-abelian-group-at-a-prime"]},{"id":"thm-localisation-of-modules-is-exact","statement":"Localising a short exact sequence 0→M′→M→M″→0 gives a short exact sequence 0→S^−1M′→S^−1M→S^−1M″→0.","used_by":["cor-localisation-commutes-with-kernels-images-and-cokernels","lem-localised-hom-finite-presentation-kernel-step","thm-support-in-a-short-exact-sequence"]},{"id":"thm-kummer-pairing-is-perfect","statement":"Under char(F)∤n and μ_n⊆F, for finite B/(F×)^n and K=F(B^{1/n}), ⟨σ,b(F×)^n⟩=σ(β)/β with β^n=b is a well-defined bilinear pairing Gal(K/F)×B/(F×)^n→μ_n, nondegenerate in both variables.","used_by":["cor-degree-of-f-adjoin-an-nth-root-by-coset-order","thm-kummer-correspondence"]},{"id":"thm-support-and-annihilator-of-a-finite-module","statement":"If M is finitely generated, then Supp_R(M)={p prime : Ann_R(M)⊆p}.","used_by":["thm-support-of-a-tensor-product-of-finite-modules","cor-finite-module-locally-zero-near-a-prime"]},{"id":"thm-nakayama-lemma","statement":"Assuming Choice, if I⊆J(R), M is finitely generated, and IM=M, then M=0.","used_by":["cor-nakayama-generators-modulo-an-ideal","ex-nakayama-jacobson-hypothesis-is-essential","ex-nakayama-finite-generation-is-essential"]}],"published_dependencies":[{"id":"cor-cyclotomic-extensions-are-abelian","used_for":"Abelian kernel after adjoining roots of unity.","op