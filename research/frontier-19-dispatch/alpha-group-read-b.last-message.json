-characteristic","used_for":"Artin–Schreier characterization.","opened":true},{"id":"def-roots-of-unity-in-a-field","used_for":"Resolvents, Kummer extensions, and radical normal closures.","opened":true},{"id":"def-separable-degree","used_for":"Norm/trace embedding formulas.","opened":true},{"id":"def-separable-elements-and-separable-extensions","used_for":"Embedding formulas and trace-form criterion.","opened":true},{"id":"def-trace-of-an-endomorphism","used_for":"Definition and basic laws of field trace.","opened":true},{"id":"lem-congruence-respects-integer-arithmetic","used_for":"Discriminants modulo four.","opened":true},{"id":"lem-conjugating-a-cycle-relabels-its-entries","used_for":"S_4 solvability and prime-degree transitive subgroup theorem.","opened":true},{"id":"lem-coprime-criterion","used_for":"Primitive-representation discriminant criterion.","opened":true},{"id":"lem-hom-from-a-finite-free-module","used_for":"Finite-free Hom localisation.","opened":true},{"id":"lem-hom-module-over-a-commutative-ring","used_for":"Natural localisation map on Hom.","opened":true},{"id":"lem-p-power-polynomial-is-irreducible-when-its-constant-is-not-a-pth-power","used_for":"Purely inseparable norm/trace example.","opened":true},{"id":"lem-product-basis-for-a-tower-of-finite-extensions","used_for":"Tower laws for norm and trace.","opened":true},{"id":"prop-elementary-tensor-formulas-descend-exactly-when-balanced","used_for":"Tensor description of module localisation.","opened":true},{"id":"prop-iterated-localisation","used_for":"Support under localisation.","opened":true},{"id":"prop-resolvent-cubic-formula-and-discriminant","used_for":"Quartic resolvent example.","opened":true},{"id":"prop-splitting-field-of-x-n-minus-a","used_for":"Cyclic Kummer theorem and radical normal closure.","opened":true},{"id":"thm-a-five-and-symmetric-groups-from-degree-five-are-not-solvable","used_for":"Abel–Ruffini corollary.","opened":true},{"id":"thm-adjacent-transpositions-generate-the-sym