[
  {
    "order": 173,
    "id": "power-series-and-real-analytic-functions",
    "kind": "A",
    "category": "real-analysis",
    "title": "Power Series and Real-Analytic Functions",
    "companion": "power-series-and-real-analytic-functions-examples",
    "requires": [
      "uniform-convergence-of-functions",
      "absolute-convergence-and-rearrangement",
      "equivalent-forms-of-completeness",
      "finite-counting-and-binomial-coefficients",
      "properties-of-the-integral-and-the-working-ftc"
    ],
    "items": [
      {
        "id": "def-real-power-series-and-radius-of-convergence",
        "kind": "definition",
        "title": "A real power series about a centre, its interval of convergence, and its radius in $[0,+\\infty]$",
        "deps": [
          "def-series",
          "def-integer-power",
          "def-extended-reals",
          "def-interval"
        ]
      },
      {
        "id": "thm-cauchy-hadamard-for-real-power-series",
        "kind": "theorem",
        "title": "Cauchy–Hadamard: the reciprocal radius is $\\limsup_{k\\to\\infty}|a_{k+1}|^{1/(k+1)}$, with the zero and infinite cases included",
        "strategy": "direct",
        "deps": [
          "def-real-power-series-and-radius-of-convergence",
          "def-limsup-liminf",
          "lem-limsup-exists",
          "lem-limsup-epsilon-characterisation",
          "thm-root-test",
          "def-absolute-and-conditional-convergence"
        ]
      },
      {
        "id": "cor-power-series-convergence-dichotomy",
        "kind": "corollary",
        "title": "A real power series converges absolutely inside its radius and diverges outside it, while either behaviour may occur at an endpoint",
        "strategy": "direct",
        "deps": [
          "thm-cauchy-hadamard-for-real-power-series",
          "def-real-power-series-and-radius-of-convergence",
          "thm-root-test"
        ]
      },
      {
        "id": "thm-power-series-uniform-on-compact-subintervals",
        "kind": "theorem",
        "title": "A power series converges absolutely and uniformly on every closed interval strictly inside its interval of convergence",
        "strategy": "direct",
        "deps": [
          "cor-power-series-convergence-dichotomy",
          "thm-weierstrass-m-test-for-function-series",
          "def-series-of-real-functions",
          "def-interval"
        ]
      },
      {
        "id": "cor-power-series-sums-are-continuous",
        "kind": "corollary",
        "title": "The sum of a real power series is continuous at every point strictly inside its interval of convergence",
        "strategy": "direct",
        "deps": [
          "thm-power-series-uniform-on-compact-subintervals",
          "thm-uniform-limit-continuous-real-functions",
          "thm-algebra-of-continuous-functions"
        ]
      },
      {
        "id": "lem-derived-and-integrated-power-series-have-the-same-radius",
        "kind": "lemma",
        "title": "A power series, its formal derivative, and its zero-constant-term formal antiderivative have the same radius of convergence",
        "strategy": "direct",
        "deps": [
          "thm-cauchy-hadamard-for-real-power-series",
          "lem-nth-root-of-n-tends-to-one",
          "thm-algebra-of-limits",
          "def-canonical-natural"
        ]
      },
      {
        "id": "thm-termwise-differentiation-of-a-real-power-series",
        "kind": "theorem",
        "title": "Inside its radius a real power series may be differentiated term by term, and the differentiated series has the same radius",
        "strategy": "direct",
        "deps": [
          "lem-derived-and-integrated-power-series-have-the-same-radius",
          "thm-power-series-uniform-on-compact-subintervals",
          "thm-uniform-derivative-limit-on-a-closed-interval",
          "lem-derivative-of-a-power",
          "def-derivative"
        ]
      },
      {
        "id": "cor-termwise-integration-of-a-real-power-series",
        "kind": "corollary",
        "title": "Inside its radius a real power series may be integrated term by term on every closed subinterval",
        "strategy": "direct",
      "deps": [
        "lem-derived-and-integrated-power-series-have-the-same-radius",
        "thm-power-series-uniform-on-compact-subintervals",
        "thm-uniform-limit-interchanges-riemann-integration",
        "thm-ftc-first-part"
        ]
      },
      {
        "id": "cor-power-series-sums-are-smooth-with-coefficient-formula",
        "kind": "corollary",
        "title": "A power-series sum is infinitely differentiable inside its radius and satisfies $a_n=f^{(n)}(c)/\\iota(n!)$ at its centre",
        "strategy": "induction",
        "deps": [
          "thm-termwise-differentiation-of-a-real-power-series",
          "def-factorial-and-falling-factorial",
          "def-canonical-natural",
          "thm-induction-principle"
        ]
      },
      {
        "id": "lem-power-series-reexpansion-double-series",
        "kind": "lemma",
        "title": "The binomial double series used to re-expand a power series at an interior point is absolutely convergent and may be regrouped",
        "strategy": "direct",
        "deps": [
          "cor-power-series-convergence-dichotomy",
          "thm-binomial-theorem",
          "thm-double-series-fubini",
          "def-absolute-and-conditional-convergence"
        ]
      },
      {
        "id": "thm-power-series-reexpansion-at-an-interior-point",
        "kind": "theorem",
        "title": "A power-series sum may be re-expanded about every interior point, with coefficients given by its derivatives there",
        "strategy": "direct",
        "deps": [
          "lem-power-series-reexpansion-double-series",
          "cor-power-series-sums-are-smooth-with-coefficient-formula",
          "thm-binomial-theorem"
        ]
      },
      {
        "id": "def-real-analytic-function",
        "kind": "definition",
        "title": "A real-analytic function on an open subset of $\\mathbb{R}$ is locally represented by a convergent real power series",
        "deps": [
          "def-real-power-series-and-radius-of-convergence",
          "def-open-and-closed-in-r",
          "def-neighbourhood-r"
        ]
      },
      {
        "id": "thm-power-series-sums-are-real-analytic",
        "kind": "theorem",
        "title": "The sum of a real power series is real analytic throughout the open interval determined by its radius",
        "strategy": "direct",
        "deps": [
          "def-real-analytic-function",
          "thm-power-series-reexpansion-at-an-interior-point"
        ]
      },
      {
        "id": "cor-real-analytic-functions-are-smooth",
        "kind": "corollary",
        "title": "Every real-analytic function is infinitely differentiable",
        "strategy": "direct",
        "deps": [
          "def-real-analytic-function",
          "cor-power-series-sums-are-smooth-with-coefficient-formula"
        ]
      },
      {
        "id": "lem-zero-of-a-real-analytic-function-is-isolated-or-locally-identical",
        "kind": "lemma",
        "title": "At a zero of a real-analytic function, either some first nonzero coefficient makes the zero isolated or every local coefficient vanishes",
        "strategy": "cases",
        "deps": [
          "def-real-analytic-function",
          "cor-power-series-sums-are-smooth-with-coefficient-formula",
          "cor-power-series-sums-are-continuous",
          "lem-sign-preservation-near-a-limit"
        ]
      },
      {
        "id": "thm-identity-theorem-for-real-analytic-functions-on-an-interval",
        "kind": "theorem",
        "title": "Two real-analytic functions on an open interval that agree on a set with an accumulation point in that interval agree throughout the interval",
        "strategy": "direct",
        "deps": [
          "lem-zero-of-a-real-analytic-function-is-isolated-or-locally-identical",
          "def-real-analytic-function",
          "thm-connected-subsets-of-r-are-intervals",
          "def-connected-r",
          "thm-algebra-of-derivatives"
        ]
      },
      {
        "id": "lem-cauchy-product-of-real-power-series",
        "kind": "lemma",
        "title": "Inside the common radius the product of two power-series sums is represented by the Cauchy product of their coefficients",
        "strategy": "direct",
        "deps": [
          "cor-power-series-convergence-dichotomy",
          "def-cauchy-product",
          "cor-cauchy-product-absolute"
        ]
      },
      {
        "id": "lem-local-composition-of-real-power-series",
        "kind": "lemma",
        "title": "A composition of convergent real power series has a convergent power-series expansion wherever the inner series maps a neighbourhood into the outer disk of convergence",
        "strategy": "direct",
        "deps": [
          "lem-cauchy-product-of-real-power-series",
          "thm-double-series-fubini",
          "cor-power-series-sums-are-continuous",
          "cor-power-series-convergence-dichotomy"
        ]
      },
      {
        "id": "lem-local-reciprocal-of-a-real-power-series",
        "kind": "lemma",
        "title": "A convergent real power series with nonzero constant term has a convergent reciprocal power series on a smaller neighbourhood",
        "strategy": "constructive",
        "deps": [
          "lem-cauchy-product-of-real-power-series",
          "thm-geometric-series",
          "cor-power-series-sums-are-continuous",
          "cor-power-series-convergence-dichotomy"
        ]
      },
      {
        "id": "thm-real-analytic-functions-closed-under-algebra-quotients-and-composition",
        "kind": "theorem",
        "title": "Real-analytic functions are closed under sums, products and compositions, and under quotients where the denominator is nonzero",
        "strategy": "direct",
        "deps": [
          "def-real-analytic-function",
          "lem-cauchy-product-of-real-power-series",
          "lem-local-composition-of-real-power-series",
          "lem-local-reciprocal-of-a-real-power-series"
        ]
      },
      {
        "id": "def-abel-and-cesaro-summability-of-a-series",
        "kind": "definition",
        "title": "Abel summability by $\\lim_{x\\uparrow1}\\sum a_nx^n$ and Cesaro summability by the Cesaro means of the partial sums",
        "deps": [
          "def-series",
          "def-cesaro-mean",
          "def-function-limit",
          "def-real-power-series-and-radius-of-convergence"
        ]
      },
      {
        "id": "thm-abel-limit-theorem",
        "kind": "theorem",
        "title": "Abel's limit theorem: if a real series converges to $s$, then its power series tends to $s$ as $x\\uparrow1$",
        "strategy": "direct",
        "deps": [
          "def-abel-and-cesaro-summability-of-a-series",
          "lem-abel-summation-by-parts",
          "thm-geometric-series",
          "lem-convergent-implies-bounded",
          "def-function-limit"
        ]
      },
      {
        "id": "lem-abel-transform-of-cesaro-means",
        "kind": "lemma",
        "title": "For $0<x<1$, the Abel transform of a series is $(1-x)^2\\sum_{n\\ge0}(n+1)\\sigma_nx^n$, where $\\sigma_n$ are the Cesaro means of its partial sums",
        "strategy": "direct",
        "deps": [
          "def-abel-and-cesaro-summability-of-a-series",
          "lem-abel-summation-by-parts",
          "thm-double-series-fubini",
          "thm-geometric-series",
          "def-canonical-natural"
        ]
      },
      {
        "id": "thm-frobenius-cesaro-implies-abel-summability",
        "kind": "theorem",
        "title": "Frobenius' theorem: Cesaro summability of a real series implies Abel summability to the same value",
        "strategy": "direct",
        "deps": [
          "lem-abel-transform-of-cesaro-means",
          "thm-abel-limit-theorem",
          "def-cesaro-mean",
          "def-abel-and-cesaro-summability-of-a-series"
        ]
      },
      {
        "id": "cor-convergent-series-are-cesaro-and-abel-summable",
        "kind": "corollary",
        "title": "Every convergent real series is Cesaro summable and Abel summable to its ordinary sum",
        "strategy": "direct",
        "deps": [
          "thm-cesaro-mean-theorem",
          "thm-abel-limit-theorem",
          "def-abel-and-cesaro-summability-of-a-series"
        ]
      },
      {
        "id": "lem-tauber-block-estimate",
        "kind": "lemma",
        "title": "If $\\iota(n+1)a_n\\to0$, short multiplicative blocks of the coefficients have uniformly small sums",
        "strategy": "direct",
        "deps": [
          "def-real-limit",
          "def-canonical-natural",
          "lem-abel-summation-by-parts",
          "thm-of-archimedean"
        ]
      },
      {
        "id": "thm-tauber-converse-for-abel-summability",
        "kind": "theorem",
        "title": "Tauber's theorem: an Abel-summable series with $\\iota(n+1)a_n\\to0$ converges ordinarily to its Abel sum",
        "strategy": "direct",
        "deps": [
          "def-abel-and-cesaro-summability-of-a-series",
          "lem-tauber-block-estimate",
          "thm-geometric-series",
          "lem-abel-summation-by-parts",
          "def-real-limit"
        ]
      },
      {
        "id": "fs-power-series-uniform-on-its-open-interval",
        "kind": "false-statement",
        "title": "FALSE: every power series converges uniformly on its entire open interval of convergence",
        "strategy": "direct",
        "deps": [
          "thm-power-series-uniform-on-compact-subintervals",
          "thm-geometric-series",
          "def-pointwise-uniform-and-uniformly-cauchy-convergence"
        ]
      },
      {
        "id": "fs-power-series-convergence-at-one-point-forces-global-convergence",
        "kind": "false-statement",
        "title": "FALSE: convergence of a power series at one point other than its centre forces convergence at every real point",
        "strategy": "direct",
        "deps": [
          "cor-power-series-convergence-dichotomy",
          "thm-geometric-series"
        ]
      },
      {
        "id": "fs-abel-summability-implies-ordinary-convergence",
        "kind": "false-statement",
        "title": "FALSE: Abel summability alone implies ordinary convergence of a series",
        "strategy": "direct",
        "deps": [
          "def-abel-and-cesaro-summability-of-a-series",
          "thm-geometric-series",
          "def-series"
        ]
      }
    ]
  },
  {
