  "load_bearing": [
    {
      "id": "thm-compatible-dual-haar-normalisation",
      "statement": "Assume AC and DC. For fixed Haar measure m_G on an LCA group, there is a unique Haar scale on its dual giving absolutely integrable-transform inversion almost everywhere for every element of the span of positive C_c convolution squares; rescaling m_G by c rescales the dual measure by c−1.",
      "used_by": ["thm-lca-fourier-inversion-for-integrable-transform", "thm-lca-plancherel-isometric-extension", "lem-dual-compact-sets-give-a-neighbourhood-basis-on-the-original-lca-group"]
    },
    {
      "id": "lem-fourier-stieltjes-transforms-determine-finite-radon-measures",
      "statement": "Assume AC and DC. A finite regular complex Borel measure on Ĝ whose inverse transform vanishes at every x∈G is zero; equivalently, equal inverse transforms determine equal such measures.",
      "used_by": ["thm-bochner-theorem-for-lca-groups", "thm-compatible-dual-haar-normalisation", "lem-lca-transform-range-is-dense-in-ltwo-of-the-dual", "thm-pontryagin-biduality"]
    },
    {
      "id": "thm-pontryagin-biduality",
      "statement": "Assume AC and DC. For an LCA group G, Φ:G→Ĝ̂, Φ(x)(γ)=γ(x), is an isomorphism of topological groups.",
      "used_by": ["lem-annihilator-reverses-inclusion-and-double-annihilator-closes", "lem-character-extension-from-a-closed-subgroup-of-an-lca-group", "thm-dual-of-a-closed-subgroup-is-the-dual-quotient", "thm-compact-discrete-duality-for-lca-groups", "cor-pontryagin-duality-is-a-contravariant-involution"]
    },
    {
      "id": "thm-hille-yosida-generation-theorem",
      "statement": "Assume DC. For closed densely defined A on a Banach space and M≥1, ω∈R, generation with ||T(t)||≤Me^(ωt) is equivalent to (ω,∞)⊆ρ(A) and ||R(λ,A)^n||≤M(λ−ω)^(−n) for every real λ>ω and every n≥1.",
      "used_by": ["cor-contraction-hille-yosida-theorem", "thm-lumer-phillips-generation-theorem", "cex-first-resolvent-estimate-does-not-give-hille-yosida-bound"]
    },
    {
      "id": "thm-laplace-transform-formula-for-the-semigroup-resolvent",
      "statement": "Assume DC. If ||T(t)||≤Me^(ωt), then every real λ>ω lies in ρ(A), R(λ,A)x=∫₀∞e^(−λt)T(t)x dt, and ||R(λ,A)||≤M/(λ−ω).",
      "used_by": ["cor-resolvent-power-estimates-for-semigroup-generators", "thm-bounded-yosida-semigroups-converge-to-the-generated-semigroup", "thm-well-posed-abstract-cauchy-problem-if-and-only-if-generation", "lem-laplace-transform-uniqueness-identifies-two-exponentially-bounded-semigroups"]
    },
    {
      "id": "thm-bochner-theorem-for-lca-groups",
      "statement": "Assume AC and DC. A continuous function φ on an LCA group is positive definite iff it has a unique finite positive Radon representing measure μ on the dual, with φ(x)=∫γ(x)dμ(γ) and μ(Ĝ)=φ(0).",
      "used_by": ["cor-normalised-positive-definite-functions-correspond-to-probability-measures", "thm-compatible-dual-haar-normalisation", "lem-continuous-characters-separate-points-of-an-lca-group", "ex-a-character-is-positive-definite"]
    },
    {
      "id": "thm-lca-plancherel-isometric-extension",
      "statement": "Assume AC and DC and compatible dual Haar normalisation. The Fourier transform is a linear isometry on L1(G)∩L2(G), a dense subspace of L2(G), and extends uniquely to a linear isometry L2(G)→L2(Ĝ). Surjectivity is not asserted here.",
      "used_by": ["lem-lca-transform-range-is-dense-in-ltwo-of-the-dual", "thm-plancherel-theorem-for-lca-groups"]
    },
    {
      "id": "thm-plancherel-theorem-for-lca-groups",
      "statement": "Assume AC and DC. With compatible Haar measures, the Fourier transform extends uniquely to a unitary operator L2(G)→L2(Ĝ), preserving inner products and being bijective.",
      "used_by": ["lem-positive-compactly-supported-transform-bump-on-the-dual", "cor-fourier-series-and-discrete-transforms-are-lca-plancherel-special-cases", "thm-pontryagin-biduality"]
    },
    {
      "id": "thm-variation-of-constants-formula",
      "statement": "Assume DC. For a C0-semigroup generator, initial x∈X and Bochner-integrable forcing, the Duhamel formula defines the unique mild and integral solution and is satisfied by every classical solution. It is classical when x∈D(A) and forcing is C1 or has the stated Bochner-primitive representation.",
      "used_by": ["ex-dirichlet-heat-semigroup-from-the-laplacian", "cex-a-mild-solution-need-not-be-classical"]
    },
    {
      "id": "thm-principal-structure-theorem-for-lca-groups",
      "statement": "Assume AC and DC. Every LCA group contains an open, hence closed, subgroup topologically isomorphic to R^n×W for n≥0 and compact W.",
      "used_by": ["pontryagin-duality-for-locally-compact-abelian-groups"]
    }
  ],
