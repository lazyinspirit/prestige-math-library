  "load_bearing": [
    {
      "id": "thm-lax-milgram",
      "statement": "Assume Countable Choice. On a real or complex Hilbert space, every bounded coercive sesquilinear form a with coercivity constant α>0 and bounded conjugate-linear datum F has a unique u satisfying a(u,v)=F(v) for every v, with α‖u‖≤‖F‖. Symmetry is not required.",
      "used_by": [
        "cor-lax-milgram-inverse-has-norm-at-most-one-over-alpha",
        "cor-symmetric-lax-milgram-is-energy-minimisation",
        "thm-existence-and-uniqueness-for-the-weak-dirichlet-poisson-problem",
        "thm-lax-milgram-solvability-for-coercive-divergence-form-equations",
        "thm-weak-neumann-poisson-solvability-on-the-mean-zero-subspace",
        "cor-positive-reaction-restores-coercivity-without-dirichlet-poincare",
        "def-shifted-elliptic-solution-operator"
      ]
    },
    {
      "id": "thm-weyl-character-formula",
      "statement": "Assume the Axiom of Choice. For every dominant integral λ, ch L(λ)=A(λ+ρ)A(ρ)⁻¹ in the completed character ring, where A(ρ)⁻¹=e^(−ρ)∏_{α∈Φ⁺}(1−e^(−α))⁻¹. No ordinary-function quotient is intended before formal cancellation.",
      "used_by": [
        "thm-kostant-weight-multiplicity-formula",
        "lem-regularized-evaluation-of-the-weyl-character-quotient-at-one",
        "lem-weyl-alternation-extracts-a-dominant-highest-weight-coefficient",
        "thm-steinberg-tensor-product-multiplicity-formula",
        "cor-minuscule-tensor-product-rule",
        "cor-borel-weil-bott-euler-character-is-the-weyl-character"
      ]
    },
    {
      "id": "lem-w-one-two-is-a-hilbert-space",
      "statement": "Assume Countable Choice. For every open Ω⊆Rⁿ, n≥1, over R or C, the pairing (u,v)=(u,v)_L²+Σ_i(D_i u,D_i v)_L² makes H¹(Ω) a Hilbert space with exactly its W¹,² norm; H¹₀ is a closed Hilbert subspace.",
      "used_by": [
        "thm-every-h-minus-one-functional-has-ltwo-plus-divergence-form",
        "thm-existence-and-uniqueness-for-the-weak-dirichlet-poisson-problem",
        "thm-lax-milgram-solvability-for-coercive-divergence-form-equations",
        "thm-weak-neumann-poisson-solvability-on-the-mean-zero-subspace",
        "cor-positive-reaction-restores-coercivity-without-dirichlet-poincare"
      ]
    },
    {
      "id": "lem-elliptic-form-is-well-defined-and-bounded",
      "statement": "Assume Countable Choice. Measurable essentially bounded divergence-form coefficients with component bounds M_a,M_b,M_c define an absolutely convergent, class-independent bounded sesquilinear form on H¹, with |a(u,v)|≤(nM_a+nM_b+M_c)‖u‖_H¹‖v‖_H¹. The same bound restricts to H¹₀; ellipticity is unnecessary for this lemma.",
      "used_by": [
        "lem-coercivity-of-the-principal-dirichlet-form",
        "thm-lax-milgram-solvability-for-coercive-divergence-form-equations",
        "cor-inhomogeneous-weak-dirichlet-problem-by-a-trace-lifting",
        "thm-garding-inequality-for-a-divergence-form-elliptic-operator"
      ]
    },
    {
      "id": "lem-geometric-series-invertibility-in-the-completed-character-ring",
      "statement": "If u is supported in −Q₊ excluding zero, then 1+u is invertible with coefficientwise-finite inverse Σ_{k≥0}(−u)^k. Monomials, the positive-root denominator product, and A(ρ) are consequently invertible in the completed ring.",
      "used_by": [
        "thm-weyl-denominator-identity",
        "lem-bgg-euler-character-gives-the-weyl-numerator",
        "thm-weyl-character-formula",
        "def-kostant-partition-function",
        "cor-minuscule-tensor-product-rule"
      ]
    },
    {
      "id": "thm-lax-milgram-solvability-for-coercive-divergence-form-equations",
      "statement": "Assume AC and Countable Choice. On a nonempty open set bounded in one direction, if α₀=θ−√n C_P M_b−C_P²M_c>0, every F∈H⁻¹ has a unique weak solution u∈H¹₀ of Lu=F, with ‖u‖_H¹₀≤(1+C_P²)‖F‖_H⁻¹/α₀.",
      "used_by": [
        "cor-inhomogeneous-weak-dirichlet-problem-by-a-trace-lifting",
        "cor-weak-solution-depends-continuously-on-data",
        "cex-a-large-adverse-zero-order-term-destroys-dirichlet-coercivity",
        "thm-rayleigh-principle-for-the-first-dirichlet-eigenvalue"
      ]
    },
    {
      "id": "lem-highest-weight-vectors-in-a-schur-tensor-product-are-lr-tableaux",
      "statement": "Assume AC, r≥1 and ℓ(λ),ℓ(μ)≤r. The product s_λs_μ equals the sum of s_(λ+wt(T)) over semistandard tableaux T of shape μ for which λ+wt(T_{≥j}) is a partition for every j≥1. For ℓ(ν)≤r, the number with λ+wt(T)=ν equals the LR tableau count c^ν_{λμ} and the tensor multiplicity of S_ν(Cʳ).",
      "used_by": [
        "thm-littlewood-richardson-tensor-product-rule"
      ]
    },
    {
      "id": "thm-littlewood-richardson-tensor-product-rule",
      "statement": "Assume AC. For V=Cʳ, r≥1, and partitions λ,μ of lengths at most r, S_λ(V)⊗S_μ(V)≅⊕_{ℓ(ν)≤r}S_ν(V)^{⊕c^ν_{λμ}}, with the finite sum using the rank-independent LR tableau coefficients. Equivalently s_λs_μ=Σ_{ℓ(ν)≤r}c^ν_{λμ}s_ν.",
      "used_by": [
        "cor-horizontal-pieri-rule",
        "cor-vertical-pieri-rule",
        "prop-littlewood-richardson-coefficients-stabilize-with-rank",
        "ex-littlewood-richardson-product-s21-times-s1",
        "ex-a-littlewood-richardson-coefficient-greater-than-one",
        "cex-a-partition-with-too-many-rows-vanishes-at-fixed-rank"
      ]
    },
    {
      "id": "lem-shifted-norm-of-a-weight-is-maximal-only-at-the-top-weight",
      "statement": "Assume AC. For dominant integral λ and an actual weight μ of L(λ), (μ+ρ,μ+ρ)≤(λ+ρ,λ+ρ), with equality if and only if μ=λ.",
      "used_by": [
        "cor-freudenthal-recursion-terminates-from-the-highest-weight"
      ]
    },
    {
      "id": "lem-minuscule-weights-are-the-weyl-orbit",
      "statement": "Assume AC. For dominant integral ω of a finite-dimensional complex simple Lie algebra, minuscule, having every weight of L(ω) in Wω, and having no distinct dominant integral λ with ω−λ∈Q₊ are equivalent. A minuscule module has exactly the orbit weights, each with multiplicity one.",
      "used_by": [
        "cor-minuscule-tensor-product-rule",
        "ex-three-tensor-three-for-sl3"
      ]
    }
  ],
