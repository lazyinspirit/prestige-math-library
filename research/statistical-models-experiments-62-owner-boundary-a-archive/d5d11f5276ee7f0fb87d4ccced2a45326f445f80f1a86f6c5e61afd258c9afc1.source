    "thm-stratified-total-unbiasedness-and-variance": {
      "risk": "medium",
      "kind": "theorem",
      "citations": [
        {
          "fact": "F1",
          "source": "def-stratified-sampling-design-and-estimator",
          "source_section": "Definition",
          "quote": "\\prod_{h=1}^H\\binom{N_h}{n_h}^{-1}",
          "uses": [
            "1.1",
            "1.2",
            "1.3"
          ]
        },
        {
          "fact": "F2",
          "source": "def-finite-population-and-sampling-design",
          "source_section": "Definition",
          "quote": "expectation here average over the design while holding every $y_i$ fixed.",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F3",
          "source": "thm-horvitz-thompson-total-is-design-unbiased",
          "source_section": "Statement",
          "quote": "E_y^d[\\widehat T_{HT}]=T(y)",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F4",
          "source": "thm-srswor-mean-variance-and-finite-population-correction",
          "source_section": "Statement",
          "quote": "\\operatorname{Var}_d(\\bar y_S)=\\left(1-\\frac nN\\right)\\frac{S_U^2}{n}",
          "uses": [
            "1.2"
          ]
        },
        {
          "fact": "F5",
          "source": "def-moments-variance-and-covariance",
          "source_section": "Definition",
          "quote": "\\operatorname{Cov}(X,Y):=\\mathbb E[(X-\\mathbb E[X])(Y-\\mathbb E[Y])].",
          "uses": [
            "1.2",
            "1.3"
          ]
        },
        {
          "fact": "F6",
          "source": "thm-variance-of-a-finite-sum",
          "source_section": "Statement",
          "quote": "Equivalently, it is $\\sum_{i,j\\in I}\\operatorname{Cov}(X_i,X_j)$.",
          "uses": [
            "2.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "positive-stratum-inclusion-and-ht-identity",
          "step": "1.1",
          "claim": "Counting within-stratum samples gives pi_i=n_h/N_h>0, and substitution identifies the estimator with the HT total; the HT theorem yields unbiasedness.",
          "inputs": [
            "F1",
            "F2",
            "F3",
            "algebra"
          ]
        },
        {
          "id": "within-stratum-variance-and-certainty",
          "step": "1.2",
          "claim": "The SRSWOR variance theorem gives each noncertainty contribution, while each certainty total is constant and has zero variance.",
          "inputs": [
            "F1",
            "F4",
            "F5",
            "algebra"
          ]
        },
        {
          "id": "cross-stratum-covariance-factorization",
          "step": "1.3",
          "claim": "The product law factors the finite expectation E[Z_h Z_k] into E[Z_h]E[Z_k], so distinct stratum totals have zero covariance.",
          "inputs": [
            "F1",
            "F5",
            "algebra"
          ]
        },
        {
          "id": "sum-of-stratum-variances",
          "step": "2.1",
          "claim": "The finite-sum variance formula and zero cross covariances give the stated variance sum; step 1.1 already proves unbiasedness.",
          "inputs": [
            "F6",
            "step 1.1",
            "step 1.2",
            "step 1.3",
            "algebra"
          ]
        }
      ],
