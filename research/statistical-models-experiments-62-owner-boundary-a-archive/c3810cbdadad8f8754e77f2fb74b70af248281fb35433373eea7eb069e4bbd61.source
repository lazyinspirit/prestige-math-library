  "contracts": {
    "def-inclusion-covariance-difference": {
      "citations": [],
      "derivations": [],
      "routine_steps": [],
      "finite_smoke": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "The supplier definition requires a nonempty finite population, so no empty population is in this definition's domain."
        },
        {
          "case": "zero",
          "status": "checked",
          "evidence": "Definition: Delta_ij is a difference of probabilities and uses no division, so zero first- or second-order inclusion probabilities cause no undefined value."
        },
        {
          "case": "one",
          "status": "checked",
          "evidence": "Definition: the diagonal convention pi_ii=pi_i gives Delta_ii=pi_i(1-pi_i), including a one-unit population."
        },
        {
          "case": "degenerate",
          "status": "checked",
          "evidence": "Definition: if pi_i is 0 or 1, the formula remains defined and gives the corresponding diagonal value."
        },
        {
          "case": "endpoints",
          "status": "not_applicable",
          "reason": "There is no interval, limiting value, or endpoint hypothesis in this finite-pair definition."
        },
        {
          "case": "nonempty-choice",
          "status": "not_applicable",
          "reason": "The definition selects no object from a family and uses no choice principle."
        },
        {
          "case": "iff-forward",
          "status": "not_applicable",
          "reason": "The definition asserts no biconditional."
        },
        {
          "case": "iff-reverse",
          "status": "not_applicable",
          "reason": "The definition asserts no biconditional."
        }
      ]
    },
    "def-simple-random-sampling-without-replacement": {
      "citations": [],
      "derivations": [],
      "routine_steps": [],
      "finite_smoke": [],
      "boundaries": [
        {
          "case": "empty",
