    "thm-horvitz-thompson-variance-and-pair-inclusion-estimator": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-finite-population-and-sampling-design",
          "source_section": "Definition",
          "quote": "$$\\pi_{ij}:=P_d(\\{s\\in\\mathcal S_d:i,j\\in s\\}).$$",
          "uses": [
            "1.1",
            "2.1",
            "3.1",
            "4.1"
          ]
        },
        {
          "fact": "F2",
          "source": "def-inclusion-covariance-difference",
          "source_section": "Definition",
          "quote": "$$\\Delta_{ij}:=\\pi_{ij}-\\pi_i\\pi_j,$$",
          "uses": [
            "3.1"
          ]
        },
        {
          "fact": "F3",
          "source": "def-moments-variance-and-covariance",
          "source_section": "Definition",
          "quote": "If $X$ is square-integrable, its **variance** is $$\\operatorname{Var}(X):=\\mathbb E[(X-\\mathbb E[X])^2].$$ If $X$ and $Y$ are square-integrable real random variables on the same probability space, their **covariance** is $$\\operatorname{Cov}(X,Y):=\\mathbb E[(X-\\mathbb E[X])(Y-\\mathbb E[Y])].$$",
          "uses": [
            "3.1"
          ]
        },
        {
          "fact": "F4",
          "source": "cor-expectation-of-an-indicator-is-probability",
          "source_section": "Statement",
          "quote": "$$\\mathbb E[\\mathbf 1_A]=\\mathbb P(A).$$",
          "uses": [
            "3.1",
            "4.1"
          ]
        },
        {
          "fact": "F5",
          "source": "thm-variance-of-a-finite-sum",
          "source_section": "Statement",
          "quote": "Equivalently, it is $\\sum_{i,j\\in I}\\operatorname{Cov}(X_i,X_j)$.",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F6",
          "source": "thm-covariance-bilinearity-and-symmetry",
          "source_section": "Statement",
          "quote": "$$\\operatorname{Cov}\\!\\left(\\sum_{i\\in I}a_iX_i,\\sum_{j\\in J}b_jY_j\\right)=\\sum_{i\\in I}\\sum_{j\\in J}a_ib_j\\operatorname{Cov}(X_i,Y_j).$$",
          "uses": [
            "3.1"
          ]
        },
        {
          "fact": "F7",
          "source": "cor-expectation-linearity-monotonicity-and-modulus-bound",
          "source_section": "Statement",
          "quote": "For scalars $a,b$, $$\\mathbb E[aX+bY]=a\\,\\mathbb E[X]+b\\,\\mathbb E[Y].$$",
          "uses": [
            "4.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "d1",
          "step": "1.1",
          "claim": "The finite support and positive pi_i make every weighted inclusion indicator square-integrable and identify the HT total as their finite sum.",
          "inputs": [
            "given",
            "F1",
            "choose"
          ]
        },
        {
          "id": "d2",
          "step": "2.1",
          "claim": "The finite-sum variance theorem rewrites the total variance as the double sum of pairwise covariances.",
          "inputs": [
            "F1",
            "F5",
            "step 1.1"
          ]
        },
        {
          "id": "d3",
          "step": "3.1",
          "claim": "Covariance bilinearity pulls out the HT weights, and the indicator moment identity gives Cov(I_i,I_j)=Delta_ij; substitution proves the variance formula.",
          "inputs": [
            "F1",
            "F2",
            "F3",
            "F4",
            "F6",
            "step 2.1",
            "algebra"
          ]
        },
        {
          "id": "d4",
          "step": "4.1",
          "claim": "Taking expectation of the pair-inclusion expression cancels each positive pi_ij and reproduces the variance formula.",
          "inputs": [
            "given",
            "F1",
            "F4",
            "F7",
            "step 3.1",
            "algebra"
          ]
        },
        {
          "id": "d5",
          "step": "5.1",
          "claim": "A zero pi_ij leaves the corresponding all-pairs coefficient undefined; dropping that term changes the expression and does not prove another estimator impossible.",
          "inputs": [
            "given",
            "step 4.1",
            "algebra"
          ]
        }
      ],
      "routine_steps": [],
      "finite_smoke": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "The supplier design has nonempty finite population and nonempty support."
        },
        {
          "case": "zero",
          "status": "checked",
          "evidence": "Step 5.1 treats zero pair support without division; the first-order variance formula assumes pi_i>0 as stated."
        },
        {
          "case": "one",
          "status": "checked",
          "evidence": "Steps 1.1, 2.1, and 3.1 use finite sums and remain valid for a one-unit population when pi_1>0."
        },
        {
          "case": "degenerate",
          "status": "checked",
          "evidence": "Step 3.1 gives zero variance when every y_i is zero or the design is a census."
        },
        {
          "case": "endpoints",
          "status": "not_applicable",
          "reason": "There is no interval or endpoint parameter in the theorem."
        },
        {
          "case": "nonempty-choice",
          "status": "not_applicable",
          "reason": "Steps 1.1-2.1 use finite sums only and invoke no choice principle."
        },
        {
          "case": "iff-forward",
          "status": "not_applicable",
          "reason": "The statement contains no biconditional."
        },
        {
          "case": "iff-reverse",
          "status": "not_applicable",
          "reason": "The statement contains no biconditional."
        }
      ]
    },
    "thm-sen-yates-grundy-variance-identity": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-finite-population-and-sampling-design",
          "source_section": "Definition",
          "quote": "$$I_i(s):=\\begin{cases}1,&i\\in s,\\\\0,&i\\notin s,\\end{cases}$$",
          "uses": [
            "1.1",
            "2.1",
            "3.1",
            "4.1"
          ]
        },
        {
          "fact": "F2",
          "source": "def-inclusion-covariance-difference",
          "source_section": "Definition",
          "quote": "$$\\Delta_{ij}:=\\pi_{ij}-\\pi_i\\pi_j,$$",
          "uses": [
            "1.1",
            "2.1"
          ]
        },
        {
          "fact": "F3",
          "source": "thm-horvitz-thompson-variance-and-pair-inclusion-estimator",
          "source_section": "Statement",
          "quote": "$$\\operatorname{Var}_d(\\widehat T_{HT})=\\sum_{i,j\\in U}\\frac{\\Delta_{ij}y_i y_j}{\\pi_i\\pi_j},$$",
          "uses": [
            "2.1",
            "3.1"
          ]
        },
        {
          "fact": "F4",
          "source": "cor-expectation-of-an-indicator-is-probability",
          "source_section": "Statement",
          "quote": "$$\\mathbb E[\\mathbf 1_A]=\\mathbb P(A).$$",
          "uses": [
            "1.1",
            "3.1"
          ]
        },
        {
          "fact": "F5",
          "source": "cor-expectation-linearity-monotonicity-and-modulus-bound",
          "source_section": "Statement",
          "quote": "For scalars $a,b$, $$\\mathbb E[aX+bY]=a\\,\\mathbb E[X]+b\\,\\mathbb E[Y].$$",
          "uses": [
            "1.1",
            "3.1"
          ]
        },
        {
          "fact": "F6",
          "source": "def-moments-variance-and-covariance",
          "source_section": "Definition",
          "quote": "If $X$ is square-integrable, its **variance** is $$\\operatorname{Var}(X):=\\mathbb E[(X-\\mathbb E[X])^2].$$",
          "uses": [
            "2.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "d1",
          "step": "1.1",
          "claim": "Fixed sample size gives sum_j I_j=n; multiplying by I_i and taking expectations proves sum_j Delta_ij=0.",
          "inputs": [
            "F1",
            "F2",
            "F4",
            "F5",
            "algebra"
          ]
        },
        {
          "id": "d2",
          "step": "2.1",
          "claim": "Symmetry gives zero column sums; expanding the squared differences cancels row and column terms and recovers the HT variance double sum.",
          "inputs": [
            "F1",
            "F2",
            "F3",
            "F6",
            "step 1.1",
            "algebra"
          ]
        },
        {
          "id": "d3",
          "step": "3.1",
          "claim": "Under positive pair support, linearity and E[I_iI_j]=pi_ij show the sample SYG expression is unbiased by the identity from step 1.2.",
          "inputs": [
            "given",
            "F1",
            "F3",
            "F4",
            "F5",
            "step 2.1",
            "algebra"
          ]
        },
        {
          "id": "d4",
          "step": "4.1",
          "claim": "Pairing symmetric ordered terms gives a sum over i<j; nonpositive Delta makes every sample summand nonnegative.",
          "inputs": [
            "given",
            "F1",
            "step 3.1",
            "algebra"
          ]
        }
      ],
      "routine_steps": [],
      "finite_smoke": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "The finite-population supplier requires a nonempty population and the design support is nonempty."
        },
        {
          "case": "zero",
          "status": "checked",
          "evidence": "The variance identity itself allows zero pair support; step 3.1 states the sample estimate only under positive pi_ij."
        },
        {
          "case": "one",
          "status": "checked",
          "evidence": "Step 1.1's row-sum identity applies to fixed sample size one; the estimator condition remains separately explicit."
        },
        {
          "case": "degenerate",
          "status": "checked",
          "evidence": "With census or constant y_i, step 3.1 gives zero true variance and the squared-difference expression is zero."
        },
        {
          "case": "endpoints",
          "status": "not_applicable",
          "reason": "There is no interval-valued parameter in this theorem."
        },
        {
          "case": "nonempty-choice",
          "status": "checked",
          "evidence": "Steps 1.1, 2.1, 3.1, and 4.1 use finite sums on U and make no arbitrary selection."
        },
        {
          "case": "iff-forward",
          "status": "not_applicable",
          "reason": "The statement is not an if-and-only-if claim."
        },
        {
          "case": "iff-reverse",
          "status": "not_applicable",
          "reason": "The statement is not an if-and-only-if claim."
        }
      ]
    },
    "thm-srswor-mean-variance-and-finite-population-correction": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-finite-population-and-sampling-design",
          "source_section": "Definition",
          "quote": "$$\\pi_i:=P_d(\\{s\\in\\mathcal S_d:i\\in s\\}),$$",
          "uses": [
            "2.1",
            "3.1",
            "4.1"
          ]
        },
        {
          "fact": "F2",
          "source": "def-simple-random-sampling-without-replacement",
          "source_section": "Definition",
          "quote": "$$p_d(s)=\\binom{N}{n}^{-1}.$$",
          "uses": [
            "1.1",
            "4.1"
          ]
        },
        {
          "fact": "F3",
          "source": "def-inclusion-covariance-difference",
          "source_section": "Definition",
          "quote": "$$\\Delta_{ij}:=\\pi_{ij}-\\pi_i\\pi_j,$$",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F4",
          "source": "thm-horvitz-thompson-variance-and-pair-inclusion-estimator",
          "source_section": "Statement",
          "quote": "$$\\operatorname{Var}_d(\\widehat T_{HT})=\\sum_{i,j\\in U}\\frac{\\Delta_{ij}y_i y_j}{\\pi_i\\pi_j},$$",
          "uses": [
            "3.1"
          ]
        },
        {
          "fact": "F5",
          "source": "def-moments-variance-and-covariance",
          "source_section": "Definition",
          "quote": "If $X$ and $Y$ are square-integrable real random variables on the same probability space, their **covariance** is $$\\operatorname{Cov}(X,Y):=\\mathbb E[(X-\\mathbb E[X])(Y-\\mathbb E[Y])].$$",
          "uses": [
            "2.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "d1",
          "step": "1.1",
          "claim": "Counting n-subsets containing a fixed unit or pair gives pi_i=n/N and pi_ij=n(n-1)/(N(N-1)), with n=1 handled separately.",
          "inputs": [
            "given",
            "F2",
            "choose",
            "algebra"
          ]
        },
        {
          "id": "d2",
          "step": "2.1",
          "claim": "Expanding centered covariance and substituting the inclusion probabilities yields the negative distinct-indicator covariance.",
          "inputs": [
            "F1",
            "F3",
            "F5",
            "step 1.1",
            "algebra"
          ]
        },
        {
          "id": "d3",
          "step": "3.1",
          "claim": "The sample mean is the HT mean; the HT variance formula and the diagonal/off-diagonal coefficients simplify to the finite-population correction.",
          "inputs": [
            "F1",
            "F4",
            "step 1.1",
            "step 2.1",
            "algebra"
          ]
        },
        {
          "id": "d4",
          "step": "4.1",
          "claim": "The census has zero variance and the n=1 formula remains defined although the sample variance denominator does not.",
          "inputs": [
            "F1",
            "F2",
            "step 3.1",
            "algebra"
          ]
        }
      ],
      "routine_steps": [],
      "finite_smoke": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "The theorem assumes N>1 and a nonempty finite population."
        },
        {
          "case": "zero",
          "status": "checked",
          "evidence": "Step 1.1 includes n=1, where distinct pi_ij are zero; no inverse-pair estimator is used."
        },
        {
          "case": "one",
          "status": "checked",
          "evidence": "Step 4.1 computes the n=1 variance as (1-1/N)S_U^2 and states the unavailable sample variance denominator."
        },
        {
          "case": "degenerate",
          "status": "checked",
          "evidence": "If all population values are equal then S_U^2=0 and step 3.1 gives zero design variance."
        },
        {
          "case": "endpoints",
          "status": "checked",
          "evidence": "Steps 1.1 and 4.1 include both n=1 and n=N."
        },
        {
          "case": "nonempty-choice",
          "status": "checked",
          "evidence": "Step 1.1 counts finite subsets directly and invokes no choice principle."
        },
        {
          "case": "iff-forward",
          "status": "not_applicable",
          "reason": "The theorem states equalities, not a biconditional."
        },
        {
          "case": "iff-reverse",
          "status": "not_applicable",
          "reason": "The theorem states equalities, not a biconditional."
        }
      ]
    },
    "ex-srswor-ht-variance-and-yates-grundy": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-simple-random-sampling-without-replacement",
          "source_section": "Definition",
          "quote": "$$p_d(s)=\\binom{N}{n}^{-1}.$$",
          "uses": [
            "1.1",
            "2.1",
            "2.2",
            "3.1"
          ]
        },
        {
          "fact": "F2",
          "source": "thm-horvitz-thompson-variance-and-pair-inclusion-estimator",
          "source_section": "Statement",
          "quote": "$$\\operatorname{Var}_d(\\widehat T_{HT})=\\sum_{i,j\\in U}\\frac{\\Delta_{ij}y_i y_j}{\\pi_i\\pi_j},$$",
          "uses": [
            "2.1",
            "2.2"
          ]
        },
        {
          "fact": "F3",
          "source": "thm-sen-yates-grundy-variance-identity",
          "source_section": "Statement",
          "quote": "$$\\widehat V_{SYG}:=-\\frac12\\sum_{i,j\\in U}I_iI_j\\frac{\\Delta_{ij}}{\\pi_{ij}}(x_i-x_j)^2$$",
          "uses": [
            "2.2"
          ]
        },
        {
          "fact": "F4",
          "source": "thm-srswor-mean-variance-and-finite-population-correction",
          "source_section": "Statement",
          "quote": "$$\\operatorname{Var}_d(\\bar y_S)=\\left(1-\\frac nN\\right)\\frac{S_U^2}{n}.$$",
          "uses": [
            "3.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "d1",
          "step": "1.1",
          "claim": "Enumerate the three equally likely samples, count first- and second-order inclusions, compute Delta, and compute the population variance.",
          "inputs": [
            "given",
            "F1",
            "choose",
            "algebra"
          ]
        },
        {
          "id": "d2",
          "step": "2.1",
          "claim": "Compute the three HT totals and average their squared deviations from total 7 to get variance 7/2.",
          "inputs": [
            "given",
            "F1",
            "F2",
            "step 1.1",
            "algebra"
          ]
        },
        {
          "id": "d3",
          "step": "2.2",
          "claim": "Substitute the scaled values into the pair-inclusion and SYG formulas, obtain 3/4, 27/4, 3, and average to 7/2.",
          "inputs": [
            "F1",
            "F2",
            "F3",
            "step 1.1",
            "algebra"
          ]
        },
        {
          "id": "d4",
          "step": "3.1",
          "claim": "Enumerate the three sample means, compute their variance 7/18, and verify the finite-population formula.",
          "inputs": [
            "F1",
            "F4",
            "step 1.1",
            "algebra"
          ]
        }
      ],
      "routine_steps": [],
      "finite_smoke": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "The example fixes a three-unit population and a nonempty size-two sample."
        },
        {
          "case": "zero",
          "status": "not_applicable",
          "reason": "The fixed population values are 1, 2, and 4; this calculation does not analyze a zero-valued schedule."
        },
        {
          "case": "one",
          "status": "not_applicable",
          "reason": "The example fixes n=2 and does not analyze singleton samples."
        },
        {
          "case": "degenerate",
          "status": "not_applicable",
          "reason": "The fixed schedule yields three distinct sample means and is not a degenerate design example."
        },
        {
          "case": "endpoints",
          "status": "not_applicable",
          "reason": "The example fixes n=2 between its census and singleton endpoints."
        },
        {
          "case": "nonempty-choice",
          "status": "checked",
          "evidence": "Steps 1.1, 2.1, 2.2, and 3.1 enumerate the three finite samples directly; no object is chosen from an arbitrary family."
        },
        {
          "case": "iff-forward",
          "status": "not_applicable",
          "reason": "The example verifies finite calculations and asserts no biconditional."
        },
        {
          "case": "iff-reverse",
          "status": "not_applicable",
          "reason": "The example verifies finite calculations and asserts no biconditional."
        }
      ]
    },
