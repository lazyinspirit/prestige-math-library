          ]
        },
        {
          "fact": "F2",
          "source": "def-locally-flat-proper-surface-and-concordance-collars",
          "source_section": "Definition",
          "quote": "Let $X$ be a four-dimensional manifold with boundary and let $W$ be a compact surface with boundary. An embedding $e:(W,\\partial W)\\to(X,\\partial X)$ is proper when $e^{-1}(\\partial X)=\\partial W$. It is locally flat at an interior point of $W$ when there are neighborhoods of the point and its image and a homeomorphism of pairs from those neighborhoods to $(\\mathbb R^4,\\mathbb R^2)$, with the standard linear plane $\\mathbb R^2\\subset\\mathbb R^4$. It is locally flat at a boundary point when there are such neighborhoods and a homeomorphism of pairs to $(\\mathbb R^4_+,\\mathbb R^2_+)$, where $\\mathbb R^4_+=\\{x_4\\geq0\\}$ and $\\mathbb R^2_+=\\{x_2=x_3=0,\\ x_4\\geq0\\}$; the line $\\partial\\mathbb R^2_+$ lies in $\\partial\\mathbb R^4_+$. A collar of a boundary circle of $W$ is an embedding of that circle times $[0,\\varepsilon)$ into $W$ that is the identity on the circle at parameter $0$; a concordance collar is required to agree with the corresponding product collar of the ambient end. A smooth proper surface has the analogous smooth charts and collars, which are also topological locally flat charts.",
          "uses": [
            "2.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "step-1-1",
          "claim": "The product arc $\\beta(s)=(p,s)$ has the same endpoints as $\\alpha$. Since $M$ is simply connected by [F1], the loop formed by traversing $\\alpha$ and then $\\beta$ backwards is null-homotopic, so there is a homotopy from $\\alpha$ to $\\beta$ fixed on the endpoint collars.",
