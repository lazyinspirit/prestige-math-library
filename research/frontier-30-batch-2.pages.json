[
  {
    "order": 256.001,
    "id": "zariski-topology-on-prime-spectra",
    "kind": "A",
    "category": "commutative-algebra",
    "title": "Zariski Topology on Prime Spectra",
    "companion": "zariski-topology-on-prime-spectra-examples",
    "requires": [
      "henselian-rings-and-equicharacteristic-cohen-structure-examples",
      "topological-spaces-and-continuity",
      "compactness"
    ],
    "items": [
      {
        "id": "def-irreducible-topological-space-and-subset",
        "kind": "definition",
        "title": "Irreducible topological spaces and irreducible subsets in the subspace topology",
        "deps": []
      },
      {
        "id": "def-noetherian-topological-space",
        "kind": "definition",
        "title": "Noetherian topological spaces via ACC on opens or DCC on closed subsets",
        "deps": []
      },
      {
        "id": "def-specialisation-and-generic-point",
        "kind": "definition",
        "title": "Specialisations, generalisations, and generic points",
        "deps": []
      },
      {
        "id": "lem-zariski-closed-set-axioms",
        "kind": "lemma",
        "title": "The vanishing sets define the Zariski topology on the prime spectrum",
        "deps": [
          "def-prime-spectrum-and-vanishing-sets",
          "lem-vanishing-set-identities"
        ]
      },
      {
        "id": "lem-every-zariski-closed-set-has-a-radical-defining-ideal",
        "kind": "lemma",
        "title": "Every Zariski-closed subset has a unique radical defining ideal",
        "deps": [
          "def-prime-spectrum-and-vanishing-sets",
          "thm-radical-as-intersection-of-primes",
          "lem-vanishing-sets-detect-radicals"
        ]
      },
      {
        "id": "lem-distinguished-opens-cover-every-open",
        "kind": "lemma",
        "title": "Every Zariski-open subset is a union of distinguished opens",
        "deps": [
          "lem-zariski-closed-set-axioms",
          "def-principal-distinguished-subset-of-spectrum"
        ]
      },
      {
        "id": "lem-distinguished-open-refinement-at-a-point",
        "kind": "lemma",
        "title": "Every point of a Zariski-open set has a distinguished-open neighbourhood inside it",
        "deps": [
          "lem-distinguished-opens-cover-every-open",
          "def-principal-distinguished-subset-of-spectrum"
        ]
      },
      {
        "id": "cor-spectrum-is-a-contravariant-topological-functor",
        "kind": "corollary",
        "title": "The prime-spectrum construction is a contravariant functor to topological spaces",
        "deps": [
          "lem-zariski-closed-set-axioms",
          "thm-prime-spectrum-map-by-contraction"
        ]
      },
      {
        "id": "lem-quotient-spectrum-map-is-closed",
        "kind": "lemma",
        "title": "The spectrum of a quotient is a closed subspace",
        "deps": [
          "lem-zariski-closed-set-axioms",
          "thm-prime-spectrum-of-a-quotient-bijection"
        ]
      },
      {
        "id": "lem-localisation-spectrum-map-homeomorphism-onto-image",
        "kind": "lemma",
        "title": "The spectrum of a localisation is the subspace of primes disjoint from the denominator set",
        "deps": [
          "lem-zariski-closed-set-axioms",
          "thm-prime-spectrum-of-a-localisation-bijection"
        ]
      },
      {
        "id": "cor-principal-localisation-spectrum-is-distinguished-open",
        "kind": "corollary",
        "title": "The spectrum of a principal localisation is the distinguished open D(f)",
        "deps": [
          "lem-localisation-spectrum-map-homeomorphism-onto-image",
          "def-principal-distinguished-subset-of-spectrum"
        ]
      },
      {
        "id": "lem-spectrum-compactness-open-cover-to-unit-ideal",
        "kind": "lemma",
        "title": "A distinguished-open cover of the spectrum forces the covering ideal to be the unit ideal",
        "deps": [
          "lem-distinguished-open-refinement-at-a-point",
          "thm-proper-ideal-contained-in-maximal-ideal"
        ]
      },
      {
        "id": "lem-spectrum-compactness-unit-expression-finite-subcover",
        "kind": "lemma",
        "title": "A finite unit-ideal expression yields a finite distinguished-open subcover",
        "deps": [
          "def-principal-distinguished-subset-of-spectrum",
          "lem-distinguished-subset-identities"
        ]
      },
      {
        "id": "thm-prime-spectrum-is-compact",
        "kind": "theorem",
        "title": "The prime spectrum is compact in the library's non-Hausdorff sense",
        "deps": [
          "def-compact-space",
          "lem-distinguished-open-refinement-at-a-point",
          "lem-spectrum-compactness-open-cover-to-unit-ideal",
          "lem-spectrum-compactness-unit-expression-finite-subcover"
        ]
      },
      {
        "id": "cor-every-distinguished-open-is-compact",
        "kind": "corollary",
        "title": "Every distinguished open subset is compact",
        "deps": [
          "def-compact-space",
          "cor-principal-localisation-spectrum-is-distinguished-open",
          "thm-prime-spectrum-is-compact"
        ]
      },
      {
        "id": "lem-closure-of-a-point-is-its-vanishing-set",
        "kind": "lemma",
        "title": "The closure of a prime is its vanishing set",
        "deps": [
          "def-prime-spectrum-and-vanishing-sets",
          "def-specialisation-and-generic-point",
          "lem-every-zariski-closed-set-has-a-radical-defining-ideal"
        ]
      },
      {
        "id": "cor-specialisation-order-is-prime-inclusion",
        "kind": "corollary",
        "title": "Specialisation in a prime spectrum is reverse inclusion",
        "deps": [
          "def-specialisation-and-generic-point",
          "lem-closure-of-a-point-is-its-vanishing-set"
        ]
      },
      {
        "id": "cor-spectrum-is-t-zero",
        "kind": "corollary",
        "title": "Distinct primes have distinct closures, so the spectrum is T0",
        "deps": [
          "cor-specialisation-order-is-prime-inclusion"
        ]
      },
      {
        "id": "cor-closed-points-of-spectrum-are-maximal-ideals",
        "kind": "corollary",
        "title": "The closed points of the prime spectrum are exactly the maximal ideals",
        "deps": [
          "lem-closure-of-a-point-is-its-vanishing-set",
          "def-prime-and-maximal-ideals"
        ]
      },
      {
        "id": "thm-irreducible-closed-subsets-and-prime-ideals",
        "kind": "theorem",
        "title": "A Zariski-closed subset is irreducible exactly when its radical defining ideal is prime, and then it has a unique generic point",
        "deps": [
          "def-irreducible-topological-space-and-subset",
          "def-specialisation-and-generic-point",
          "def-prime-and-maximal-ideals",
          "lem-every-zariski-closed-set-has-a-radical-defining-ideal",
          "lem-closure-of-a-point-is-its-vanishing-set",
          "cor-spectrum-is-t-zero",
          "lem-vanishing-set-identities"
        ]
      },
      {
        "id": "thm-irreducible-components-and-minimal-primes",
        "kind": "theorem",
        "title": "Irreducible components of the spectrum correspond to minimal prime ideals",
        "deps": [
          "def-irreducible-topological-space-and-subset",
          "def-prime-spectrum-and-vanishing-sets",
          "thm-irreducible-closed-subsets-and-prime-ideals",
          "lem-minimal-prime-over-an-ideal-exists"
        ]
      },
      {
        "id": "thm-noetherian-ring-has-noetherian-spectrum",
        "kind": "theorem",
        "title": "The spectrum of a Noetherian ring is a Noetherian topological space",
        "deps": [
          "def-noetherian-topological-space",
          "lem-every-zariski-closed-set-has-a-radical-defining-ideal",
          "thm-noetherian-ring-ideal-characterisations"
        ]
      },
      {
        "id": "cor-noetherian-spectrum-has-finitely-many-irreducible-components",
        "kind": "corollary",
        "title": "A Noetherian ring has only finitely many irreducible components in its spectrum",
        "deps": [
          "thm-irreducible-components-and-minimal-primes",
          "thm-noetherian-ring-has-finitely-many-minimal-primes"
        ]
      },
      {
        "id": "lem-clopen-subset-gives-idempotent-decomposition",
        "kind": "lemma",
        "title": "A clopen decomposition of the spectrum comes from a nontrivial idempotent",
        "deps": [
          "lem-every-zariski-closed-set-has-a-radical-defining-ideal",
          "cor-nilradical-as-intersection-of-primes",
          "thm-chinese-remainder-theorem-for-comaximal-ideals",
          "thm-proper-ideal-contained-in-maximal-ideal"
        ]
      },
      {
        "id": "lem-idempotent-gives-clopen-spectrum-partition",
        "kind": "lemma",
        "title": "An idempotent partitions the spectrum into complementary clopen subsets",
        "deps": [
          "def-principal-distinguished-subset-of-spectrum",
          "lem-distinguished-subset-identities",
          "def-prime-and-maximal-ideals"
        ]
      },
      {
        "id": "cor-spectrum-connected-iff-no-nontrivial-idempotents",
        "kind": "corollary",
        "title": "The prime spectrum is connected exactly when the ring has no idempotents other than zero and one",
        "deps": [
          "def-connected-space",
          "thm-connectedness-characterisations",
          "lem-clopen-subset-gives-idempotent-decomposition",
          "lem-idempotent-gives-clopen-spectrum-partition",
          "cor-nilradical-as-intersection-of-primes"
        ]
      },
      {
        "id": "lem-support-is-specialisation-closed",
        "kind": "lemma",
        "title": "The support of any module is closed under specialisation",
        "deps": [
          "def-support-of-a-module",
          "lem-support-membership-by-annihilator",
          "cor-specialisation-order-is-prime-inclusion"
        ]
      },
      {
        "id": "cor-closed-points-dense-in-affine-spectra",
        "kind": "corollary",
        "title": "In a finite-type algebra over a field, closed points are dense in every closed subset of the spectrum",
        "deps": [
          "lem-every-zariski-closed-set-has-a-radical-defining-ideal",
          "lem-distinguished-open-refinement-at-a-point",
          "cor-closed-points-of-spectrum-are-maximal-ideals",
          "cor-affine-closed-points-detect-radicals"
        ]
      }
    ]
  },
  {
    "order": 256.002,
    "id": "zariski-topology-on-prime-spectra-examples",
    "kind": "B",
    "category": "commutative-algebra",
    "title": "Zariski Topology on Prime Spectra — Examples",
    "companion": "zariski-topology-on-prime-spectra",
    "requires": [
