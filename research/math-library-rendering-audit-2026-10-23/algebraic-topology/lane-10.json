    {
      "id": "ex-universal-thom-class-steenrod-operation",
      "source": "items/ex-universal-thom-class-steenrod-operation.md",
      "pages": [
        "thom-spectra-and-unoriented-bordism-detection"
      ],
      "section": "Verification",
      "lines": [
        41
      ],
      "excerpt": "The stable-square supplier identifies every component of Sq^i(U) with w_i(γ_r)u_r and proves compatibility under the inverse-system maps. The rank bound makes w_3(γ_2)=0; instability kills Sq^3 on the degree-2 class u_2.",
      "symptom": "Carets and underscores in the mathematical notation appear literally in the rendered verification text, while nearby formulas in the item are typeset.",
      "classification": "confirmed",
      "screenshots": [
        "screenshots/ex-universal-thom-class-steenrod-operation--01.png"
