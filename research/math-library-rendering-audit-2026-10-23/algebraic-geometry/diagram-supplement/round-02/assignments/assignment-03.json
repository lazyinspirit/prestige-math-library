      ],
      "source_lines": {
        "50": "$$\\pi:\\mathbb P(\\mathcal E)=\\operatorname{Proj}_X\\operatorname{Sym}(\\mathcal E)\\longrightarrow X$$",
        "51": "be the projective bundle in the quotient convention, with tautological quotient",
        "52": "$\\pi^*\\mathcal E\\to\\mathcal O_{\\mathbb P(\\mathcal E)}(1)$",
        "53": "([[def-projective-bundle-scheme]],",
        "54": "[[def-relative-proj-quasi-coherent-graded-algebra]],",
        "55": "[[thm-projective-bundle-represents-line-quotients]]), and put",
        "56": "$\\xi:=c_1(\\mathcal O(1))$",
        "57": "([[def-intersection-with-a-cartier-divisor-and-first-chern-class]]); $\\pi$ is",
        "58": "smooth of relative dimension $r-1$",
        "59": "([[def-relative-dimension-smooth-morphism]]), so flat pullback $\\pi^*$ is",
        "60": "defined ([[lem-flat-pullback-chow-groups]], [[lem-smooth-fibres-smooth]]). Then",
        "61": "for every $d\\in\\mathbb Z$ the map",
        "62": "$$\\bigoplus_{i=0}^{r-1}A_{d+i}(X)\\longrightarrow A_{d+r-1}\\bigl(\\mathbb P(\\mathcal E)\\bigr),\\qquad (\\alpha_0,\\dots,\\alpha_{r-1})\\longmapsto\\sum_{i=0}^{r-1}\\xi^i\\cap\\pi^*\\alpha_i,$$",
        "63": "is an isomorphism of abelian groups. More precisely,",
        "64": "$\\pi_*(\\xi^s\\cap\\pi^*\\alpha)=0$ for $s<r-1$ and",
        "65": "$\\pi_*(\\xi^{r-1}\\cap\\pi^*\\alpha)=\\alpha$ for all $\\alpha\\in A_*(X)$",
        "66": "([[lem-proper-pushforward-of-cycles-well-defined]])."
      },
