    {
      "item_id": "thm-fat-cantor-set-has-positive-measure",
      "kind": "missing-diagram-candidate",
      "severity": "editorial-candidate",
      "source_snapshot": "snapshots/thm-fat-cantor-set-has-positive-measure.md",
      "source_lines": [
        40,
        62,
        66,
        100,
        114
      ],
      "rationale": "The theorem centers on the Smith\u2013Volterra\u2013Cantor construction: at each stage every retained interval is split into two closed pieces by removing an open middle interval, yielding a compact perfect nowhere dense set with positive interval-cover lower bound. A small stage-by-stage diagram can make the retained pieces and deleted gaps immediately legible and distinguish this fat construction from the ordinary middle-thirds Cantor set. This is a high-value teaching candidate, not a rendering defect.",
      "concrete_maps_and_relations": {
        "stage_sets": "S_n is the union of N_n=2^n closed intervals [e_j^(n),e_j^(n)+lambda_n] in [0,1], and S is their nested intersection.",
        "successor_rule": "Each [e_j^(n),e_j^(n)+lambda_n] retains [e_j^(n),e_j^(n)+lambda_(n+1)] and [e_j^(n)+g_n,e_j^(n)+lambda_n], removing M_j^(n)=(e_j^(n)+lambda_(n+1),e_j^(n)+g_n).",
        "sizes": "lambda_(n+1)<g_n, lambda_n=g_n+lambda_(n+1), and each gap has length g_n-lambda_(n+1)=4^(-n-1); with 2^n gaps at stage n, total deleted length is 2^(-n-2)."
      }
    }
  ],
