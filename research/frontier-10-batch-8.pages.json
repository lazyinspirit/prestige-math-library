      {
        "id": "thm-jordans-derangement-theorem",
        "kind": "theorem",
        "title": "Jordan's derangement theorem: a nontrivial transitive action of a finite group on a finite set with more than one element has a fixed-point-free element",
        "strategy": "contradiction",
        "deps": [
          "def-group-action",
          "def-fixed-point-sets-of-a-group-action",
          "thm-cauchy-frobenius-orbit-counting",
          "def-finite-cardinality",
          "thm-sum-rule",
          "def-sum-over-a-finite-index-set"
        ]
      }
    ],
    "enrichment_of_published": [
