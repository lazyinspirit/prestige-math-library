[
  {
    "order": 42,
    "id": "group-actions-and-cayleys-theorem",
    "kind": "A",
    "category": "abstract-algebra",
    "title": "Group Actions, Orbits, Stabilisers and Cayley's Theorem",
    "companion": "group-actions-and-cayleys-theorem-examples",
    "requires": [
      "group-homomorphisms-and-the-isomorphism-theorems"
    ],
    "items": [
      {
        "id": "def-equivariant-map-of-group-actions",
        "kind": "definition",
        "title": "Equivariant maps and isomorphisms of group actions",
        "deps": [
          "def-group-action",
          "def-function",
          "def-injection-surjection-bijection"
        ]
      },
      {
        "id": "def-free-group-action",
        "kind": "definition",
        "title": "A free group action has no nonidentity element fixing a point",
        "deps": [
          "def-group-action"
        ]
      },
      {
        "id": "def-fixed-point-sets-of-a-group-action",
        "kind": "definition",
        "title": "The fixed-point sets $X^g$ and $X^G$ of a group action",
        "deps": [
          "def-group-action"
        ]
      },
      {
        "id": "thm-orbit-stabilizer",
        "kind": "theorem",
        "title": "Orbit-stabiliser: $G/G_x\\to G\\cdot x$, $gG_x\\mapsto g\\cdot x$, is a well-defined bijection",
        "strategy": "constructive",
        "deps": [
          "def-orbit-and-stabilizer",
          "lem-stabilizer-is-a-subgroup",
          "def-coset",
          "lem-coset-membership-and-equality",
          "def-injection-surjection-bijection"
        ]
      },
      {
        "id": "cor-orbit-stabilizer-cardinality",
        "kind": "corollary",
        "title": "Orbit-stabiliser cardinality: $|G\\cdot x|=[G:G_x]$, and for finite $G$, $|G|=|G_x|\\,|G\\cdot x|$",
        "strategy": "direct",
        "deps": [
          "thm-orbit-stabilizer",
          "def-index",
          "def-finite-cardinality",
          "thm-lagrange"
        ]
      },
      {
        "id": "lem-stabilizers-in-one-orbit-are-conjugate",
        "kind": "lemma",
        "title": "If $y=g\\cdot x$, then $G_y=gG_xg^{-1}$",
        "strategy": "direct",
        "deps": [
          "def-orbit-and-stabilizer",
          "def-group-action",
          "thm-conjugation-is-an-automorphism"
        ]
      },
      {
        "id": "def-core-of-a-subgroup",
        "kind": "definition",
        "title": "The core $\\operatorname{Core}_G(H)=\\bigcap_{g\\in G}gHg^{-1}$ of a subgroup",
        "deps": [
          "def-subgroup",
          "thm-conjugation-is-an-automorphism"
        ]
      },
      {
        "id": "lem-core-is-largest-normal-subgroup-contained",
        "kind": "lemma",
        "title": "$\\operatorname{Core}_G(H)$ is the largest normal subgroup of $G$ contained in $H$",
        "strategy": "direct",
        "deps": [
          "def-core-of-a-subgroup",
          "def-normal-subgroup",
          "thm-normal-subgroup-characterisations",
          "lem-subgroup-criterion"
        ]
      },
      {
        "id": "thm-left-coset-action-and-its-kernel",
        "kind": "theorem",
        "title": "Left multiplication on $G/H$ is transitive, has stabiliser $H$ at $H$, and has kernel $\\operatorname{Core}_G(H)$",
        "strategy": "direct",
        "deps": [
          "def-group-action",
          "thm-group-actions-correspond-to-homomorphisms",
          "def-coset",
          "def-index",
          "lem-coset-membership-and-equality",
          "def-kernel-and-image-of-group-homomorphism",
          "def-core-of-a-subgroup",
          "lem-core-is-largest-normal-subgroup-contained"
        ]
      },
      {
        "id": "thm-finite-index-core-bound-and-finite-overgroups",
        "kind": "theorem",
        "title": "If $[G:H]=n<\\infty$, then $\\operatorname{Core}_G(H)\\trianglelefteq G$, $[G:\\operatorname{Core}_G(H)]\\mid n!$, and only finitely many subgroups contain $H$",
        "strategy": "direct",
        "deps": [
          "thm-left-coset-action-and-its-kernel",
          "lem-core-is-largest-normal-subgroup-contained",
          "thm-first-isomorphism-theorem-groups",
          "def-symmetric-group",
          "lem-symmetric-group-is-a-group",
          "thm-number-of-bijections-of-a-finite-set",
          "def-factorial-and-falling-factorial",
          "thm-lagrange",
          "def-index",
          "def-finite-cardinality",
          "def-order-in-a-group",
          "def-quotient-group",
          "prop-canonical-quotient-map",
          "cor-cardinality-of-the-power-set",
          "thm-subset-of-a-finite-set"
        ]
      },
      {
        "id": "thm-transitive-actions-are-coset-actions",
        "kind": "theorem",
        "title": "Every transitive $G$-set is equivariantly isomorphic to $G/G_x$ for any chosen point $x$",
        "strategy": "constructive",
        "deps": [
          "def-equivariant-map-of-group-actions",
          "def-group-action",
          "thm-orbit-stabilizer",
          "thm-left-coset-action-and-its-kernel"
        ]
      },
      {
        "id": "cor-faithful-transitive-actions-are-core-free-coset-actions",
        "kind": "corollary",
        "title": "A transitive action is faithful exactly when a point stabiliser is core-free",
        "strategy": "direct",
        "deps": [
          "def-group-action",
          "thm-transitive-actions-are-coset-actions",
          "thm-left-coset-action-and-its-kernel",
          "def-core-of-a-subgroup"
        ]
      },
      {
        "id": "def-conjugacy-class-and-centralizer",
        "kind": "definition",
        "title": "The conjugacy class $\\operatorname{Cl}_G(x)$ and centralizer $C_G(x)$ of an element",
        "deps": [
          "def-group"
        ]
      },
      {
        "id": "def-normalizer-of-a-subgroup",
        "kind": "definition",
        "title": "The normalizer $N_G(H)=\\{g\\in G:gHg^{-1}=H\\}$ of a subgroup",
        "deps": [
          "def-subgroup",
          "thm-conjugation-is-an-automorphism"
        ]
      },
      {
        "id": "lem-centralizers-and-normalizers-are-subgroups",
        "kind": "lemma",
        "title": "$C_G(x)$ and $N_G(H)$ are subgroups of $G$",
        "strategy": "direct",
        "deps": [
          "def-conjugacy-class-and-centralizer",
          "def-normalizer-of-a-subgroup",
          "lem-subgroup-criterion"
        ]
      },
      {
        "id": "thm-conjugacy-class-cardinality",
        "kind": "theorem",
        "title": "$G/C_G(x)\\to\\operatorname{Cl}_G(x)$ is a bijection, so $|\\operatorname{Cl}_G(x)|=[G:C_G(x)]$",
        "strategy": "direct",
        "deps": [
          "thm-orbit-stabilizer",
          "cor-orbit-stabilizer-cardinality",
          "def-conjugacy-class-and-centralizer",
          "lem-centralizers-and-normalizers-are-subgroups",
          "thm-conjugation-homomorphism",
          "thm-group-actions-correspond-to-homomorphisms"
        ]
      },
      {
        "id": "thm-conjugate-subgroups-are-counted-by-the-normalizer",
        "kind": "theorem",
        "title": "The conjugates of $H$ are in bijection with $G/N_G(H)$ and, for finite $G$, number $[G:N_G(H)]$",
        "strategy": "direct",
        "deps": [
          "thm-orbit-stabilizer",
          "cor-orbit-stabilizer-cardinality",
          "def-normalizer-of-a-subgroup",
          "lem-centralizers-and-normalizers-are-subgroups",
          "thm-conjugation-is-an-automorphism"
        ]
      },
      {
        "id": "thm-conjugates-of-proper-subgroup-do-not-cover-finite-group",
        "kind": "theorem",
        "title": "The conjugates of a proper subgroup do not cover a finite group",
        "strategy": "direct",
        "deps": [
          "thm-conjugate-subgroups-are-counted-by-the-normalizer",
          "def-normalizer-of-a-subgroup",
          "lem-centralizers-and-normalizers-are-subgroups",
          "thm-conjugation-is-an-automorphism",
          "def-index",
          "thm-lagrange",
          "def-finite-cardinality",
          "thm-subset-of-a-finite-set",
          "thm-sum-rule",
          "def-sum-over-a-finite-index-set"
        ]
      },
      {
        "id": "thm-class-equation",
        "kind": "theorem",
        "title": "The class equation $|G|=|Z(G)|+\\sum_i [G:C_G(x_i)]$ for a finite group",
        "strategy": "direct",
        "deps": [
          "thm-orbits-partition-the-set",
          "thm-conjugacy-class-cardinality",
          "def-conjugacy-class-and-centralizer",
          "def-center-of-a-group",
          "thm-sum-rule",
          "def-sum-over-a-finite-index-set"
        ]
      },
      {
        "id": "def-finite-p-group",
        "kind": "definition",
        "title": "A finite $p$-group has order $p^n$ for a prime $p$ and some $n\\in\\mathbb N$",
        "deps": [
          "def-group",
          "def-finite-cardinality",
          "def-prime",
          "def-nat-power"
        ]
      },
      {
        "id": "lem-subgroups-of-finite-p-groups-are-p-groups",
        "kind": "lemma",
        "title": "Every subgroup of a finite $p$-group has order a power of $p$",
        "strategy": "direct",
        "deps": [
          "def-finite-p-group",
          "thm-lagrange",
          "thm-canonical-prime-factorisation"
        ]
      },
      {
        "id": "cor-index-p-subgroups-of-finite-p-groups-are-normal",
        "kind": "corollary",
        "title": "Every subgroup of index $p$ in a finite $p$-group is normal",
        "strategy": "direct",
        "deps": [
          "def-finite-p-group",
          "lem-subgroups-of-finite-p-groups-are-p-groups",
          "thm-finite-index-core-bound-and-finite-overgroups",
          "lem-core-is-largest-normal-subgroup-contained",
          "cor-index-tower-finite",
          "def-factorial-and-falling-factorial",
          "cor-euclids-lemma-for-finite-products",
          "thm-canonical-prime-factorisation",
          "def-prime",
          "def-index",
          "def-normal-subgroup"
        ]
      },
      {
        "id": "thm-p-group-fixed-point-congruence",
        "kind": "theorem",
        "title": "If a finite $p$-group $P$ acts on a finite set $X$, then $|X|\\equiv|X^P|\\pmod p$",
        "strategy": "direct",
        "deps": [
          "def-finite-p-group",
          "def-fixed-point-sets-of-a-group-action",
          "thm-orbits-partition-the-set",
          "cor-orbit-stabilizer-cardinality",
          "lem-subgroups-of-finite-p-groups-are-p-groups",
          "def-congruence-modulo-an-integer",
          "thm-sum-rule",
          "def-sum-over-a-finite-index-set"
        ]
      },
      {
        "id": "cor-p-group-action-has-a-fixed-point",
        "kind": "corollary",
        "title": "A finite $p$-group action on $X$ has a global fixed point whenever $p\\nmid|X|$",
        "strategy": "contradiction",
        "deps": [
          "thm-p-group-fixed-point-congruence",
          "def-fixed-point-sets-of-a-group-action",
          "def-congruence-modulo-an-integer",
          "def-prime"
        ]
      },
      {
        "id": "thm-nontrivial-center-of-a-finite-p-group",
        "kind": "theorem",
        "title": "Every nontrivial finite $p$-group has nontrivial center, in fact $p$ divides $|Z(P)|$",
        "strategy": "direct",
        "deps": [
          "def-finite-p-group",
          "thm-p-group-fixed-point-congruence",
          "thm-conjugation-homomorphism",
          "thm-group-actions-correspond-to-homomorphisms",
          "def-center-of-a-group",
          "def-congruence-modulo-an-integer"
        ]
      },
      {
        "id": "lem-cyclic-quotient-by-center-implies-abelian",
        "kind": "lemma",
        "title": "If $G/Z(G)$ is cyclic, then $G$ is abelian",
        "strategy": "direct",
        "deps": [
          "def-center-of-a-group",
          "lem-center-is-normal",
          "def-quotient-group",
          "def-generated-subgroup",
          "lem-cyclic-subgroup-is-the-set-of-powers",
          "lem-group-power-laws"
        ]
      },
      {
        "id": "cor-groups-of-order-p-squared-are-abelian",
        "kind": "corollary",
        "title": "Every group of order $p^2$, for prime $p$, is abelian",
