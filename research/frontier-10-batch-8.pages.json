        "id": "thm-cauchy-frobenius-orbit-counting",
        "kind": "theorem",
        "title": "Cauchy-Frobenius orbit counting: $|G|\\,|X/G|=\\sum_{g\\in G}|X^g|$ for a finite group action",
        "strategy": "double-counting",
        "deps": [
          "def-fixed-point-sets-of-a-group-action",
          "thm-orbits-partition-the-set",
          "cor-orbit-stabilizer-cardinality",
          "thm-double-counting",
          "def-sum-over-a-finite-index-set"
