        "deps": [
          "thm-nontrivial-center-of-a-finite-p-group",
          "lem-cyclic-quotient-by-center-implies-abelian",
          "cor-order-of-a-quotient-group",
          "cor-prime-order-group-is-cyclic",
          "def-finite-p-group"
        ]
      },
      {
        "id": "thm-normal-subgroups-of-finite-p-groups-meet-the-center",
        "kind": "theorem",
        "title": "Every nontrivial normal subgroup of a finite $p$-group meets the center nontrivially",
        "strategy": "direct",
        "deps": [
          "def-finite-p-group",
          "thm-p-group-fixed-point-congruence",
          "def-normal-subgroup",
          "thm-normal-subgroup-characterisations",
          "thm-conjugation-is-an-automorphism",
          "def-center-of-a-group"
        ]
      },
      {
        "id": "thm-cauchys-theorem-for-finite-groups",
        "kind": "theorem",
        "title": "Cauchy's theorem: if a prime $p$ divides $|G|$, then $G$ has an element of order $p$",
        "strategy": "constructive",
        "deps": [
