  \draw[thick] (0.35,0) .. controls (0.8,0.65) and (1.5,0.65) .. (2.15,0);
  \draw[thick] (0.35,0.18) .. controls (0.8,0.83) and (1.5,0.83) .. (2.15,0.18);
  \draw[thick,blue] (0.35,0.09) .. controls (0.8,0.4) and (1.5,0.4) .. (2.15,0.09);
