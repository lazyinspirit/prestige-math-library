  {
    "op": "add",
    "path": "/contracts/thm-hh-fundamental-theorem-of-coalgebras/citations/-",
    "value": {
      "fact": "F13",
      "source": "thm-universal-property-of-free-modules",
      "source_section": "Statement",
      "quote": "Let $R$ be a unital ring, $X$ a set, and $M$ a left $R$-module. Every set map $u:X\\to M$ extends uniquely to an $R$-module homomorphism $\\bar u:R^{(X)}\\to M$ satisfying $\\bar u(e_x)=u(x)$. Explicitly,\n$$\\bar u\\left(\\sum_{x\\in F}r_xe_x\\right)=\\sum_{x\\in F}r_xu(x).$$",
      "uses": [
        "6.1"
      ]
    }
  },
