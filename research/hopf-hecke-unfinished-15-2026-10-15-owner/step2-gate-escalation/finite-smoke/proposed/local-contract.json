          "inputs": [
            "given",
            "F1",
            "F2",
            "algebra"
          ]
        },
        {
          "id": "rank-one-dimension-two",
          "claim": "The rank-one monic basis result at r=2 gives precisely 1 and X as a basis.",
          "step": "2.1",
          "inputs": [
            "F3",
            "step 1.1"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "The example fixes rank n=1 and level r=2."
        },
        {
          "case": "zero",
          "status": "checked",
          "evidence": "Step 1.1 uses a,b in F^\u00d7, so the inverse formula has nonzero denominator ab."
        },
        {
          "case": "one",
          "status": "checked",
          "evidence": "Step 2.1 gives the two-element basis for level two, including all allowed parameter values."
        },
        {
          "case": "degenerate",
          "status": "checked",
          "evidence": "Steps 1.1\u20132.1 remain valid when a=b; the repeated-root case is handled by the same monic basis."
        },
        {
          "case": "endpoints",
