          "case": "iff-reverse",
          "status": "not_applicable",
          "reason": "The example makes no iff claim."
        }
      ],
      "finite_smoke": [
        {
          "check": "cyclotomic-rank-one-f5-inverse",
          "asserts": "X^2=(a+b)X-ab,\\qquad X^{-1}=\\frac{a+b-X}{ab}.",
          "modulus": 5,
          "inverse_x_coefficient": -1
        }
      ]
