          ]
        },
        {
          "id": "repeated-root-content-collision",
          "claim": "The specialization makes both contents equal to one and gives a nonzero square-zero element, so the generic interpolation denominator vanishes.",
          "step": "2.1",
          "inputs": [
            "F2",
            "step 1.1",
            "algebra"
          ]
        }
      ],
      "routine_steps": [],
