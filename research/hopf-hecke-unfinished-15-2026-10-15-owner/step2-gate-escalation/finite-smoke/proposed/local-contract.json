        },
        {
          "fact": "F2",
          "source": "lem-hh-rank-one-cyclotomic-quotient-monic-basis",
          "source_section": "Statement",
          "quote": "the change of variable $\\varepsilon=X-c$ identifies this algebra with $F[\\varepsilon]/(\\varepsilon^r)$",
