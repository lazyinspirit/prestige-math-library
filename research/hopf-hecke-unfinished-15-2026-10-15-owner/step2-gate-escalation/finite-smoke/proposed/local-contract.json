      "risk": "low",
      "kind": "example",
      "citations": [
        {
          "fact": "F1",
          "source": "def-hh-multiplicative-cyclotomic-hecke-algebra",
          "source_section": "Definition",
          "quote": "$X_1^{\\pm1},\\ldots,X_n^{\\pm1}$",
          "uses": [
            "1.1"
