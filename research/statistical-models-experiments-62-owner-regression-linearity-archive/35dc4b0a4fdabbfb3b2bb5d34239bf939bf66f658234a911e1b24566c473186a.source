        },
        {
          "case": "degenerate",
          "status": "checked",
          "evidence": "Step 1.1 permits the zero functional and its zero Lipschitz bound."
        },
        {
          "case": "endpoints",
          "status": "not_applicable",
          "reason": "There is no interval or ordered parameter."
        },
        {
          "case": "nonempty-choice",
          "status": "checked",
          "evidence": "Step 1.1 takes one bound K from the supplied boundedness result; no family of choices is made."
        },
        {
          "case": "iff-forward",
