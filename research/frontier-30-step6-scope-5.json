    {
      "obligation": "refuter:5:1",
      "id": "thm-pairwise-independent-borel-cantelli-frequency-law",
      "location": "Statement",
      "defect": "ill-formed",
      "evidence": "The Statement defines, “For n∈N, put S_n:=... , a_n:=... . Then S_n/a_n→1 almost surely,” but divergence of the total sum does not ensure a_n>0 for every n. Take A_0=∅ and A_n=Ω for n≥1. These events are pairwise independent and their probability sum diverges, while S_0=a_0=0, so S_0/a_0 is undefined.",
      "severity": "fatal",
      "observed_sha256": "e24c8ee4c44ff3432d7ba8bed3e061ed85b27f606b041c57d53137a2295b4554"
    },
    {
      "obligation": "refuter:5:2",
