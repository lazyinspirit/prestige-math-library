    {
      "obligation": "refuter:37:1",
      "id": "lem-shin-parabolic-classical-approximation-and-boundary-attainment",
      "location": "8.1",
      "defect": "unlicensed-inference",
      "evidence": "Step 8.1 requires “a spatial mollifier whose support stays inside $U_n$ at every point of $U_n$.” A fixed positive-radius convolution kernel cannot satisfy this for every point of a nonempty open $U_n$: points arbitrarily close to its boundary have no such interior buffer. The needed convolution can instead be supported inside $U$, since $\\overline{U_n}\\subset U$; the stated proof step is therefore not licensed as written.",
      "severity": "nonfatal",
      "observed_sha256": "7dc4d28caa3a2c0527e6d63f0c3299d2aedaa874d53a991ad4ed482e3ca684ba"
    }
