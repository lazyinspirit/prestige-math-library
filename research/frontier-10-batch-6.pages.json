          "thm-finite-graph-ramsey-binomial-bound",
          "def-ramsey-colouring-and-arrow-notation",
          "thm-well-ordering-principle"
        ]
      },
      {
        "id": "cor-ramsey-recursion-and-diagonal-upper-bound",
