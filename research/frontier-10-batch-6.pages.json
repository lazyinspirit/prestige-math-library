        "title": "Finite graph Ramsey theorem: $\\binom{s+t-2}{s-1}\\to(s,t)^2$ for all positive $s,t$",
        "strategy": "induction",
        "deps": [
          "lem-two-colour-ramsey-arrow-recursion",
          "def-ramsey-colouring-and-arrow-notation",
          "def-binomial-coefficient",
