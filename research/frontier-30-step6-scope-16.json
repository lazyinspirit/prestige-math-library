  "refuter_findings": [
    {
      "obligation": "refuter:16:1",
      "id": "lem-rho-shift-intertwines-the-dot-and-ordinary-weyl-actions",
      "location": "Statement",
      "defect": "false-claim",
      "evidence": "The lemma defines $(Tf)(\\lambda)=f(\\lambda+\\rho)$ and claims dot-invariance of $f$ iff ordinary invariance of $Tf$. In $\\mathfrak{sl}_2$, write $t=\\lambda(h)$, so $\\rho(h)=1$ (as recorded in ex-sl2-casimir-and-its-highest-weight-eigenvalue) and the dot reflection is $t\\mapsto-t-2$. The polynomial $f(t)=t(t+2)$ is dot-invariant, but $(Tf)(t)=(t+1)(t+3)$ is not invariant under the ordinary reflection $t\\mapsto-t$; for example its values at $1$ and $-1$ are $8$ and $0$. The translation with the stated direction does not intertwine these actions.",
      "severity": "fatal",
      "observed_sha256": "b53a6d1e1f607538704b4c18f42d799cda1ab49b77de0f0d86d855e51ad74a94"
    },
