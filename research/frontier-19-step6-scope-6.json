  "refuter_findings": [
    {
      "obligation": "refuter:6:1",
      "id": "thm-bose-construction-produces-a-steiner-triple-system",
      "location": "Statement",
      "defect": "missing-hypothesis",
      "evidence": "`def-two-design` says: `Let v,k,\\lambda be natural numbers with 2\\le k<v ... A 2-(v,k,\\lambda) design ...`. `def-steiner-systems-and-steiner-triple-systems` says: `A Steiner triple system of order v ... is a 2-(v,3,1) design.` So under the library's own definitions an STS(v) requires `3<v`. But this theorem begins `Let m\\in\\mathbb N` and concludes a Steiner triple system on `6m+3` points. Taking `m=0` gives `n=1`, point set `(\\mathbb Z/1)\\times(\\mathbb Z/3)` with 3 points, and step 4.1 calls the result a `2-(3n,3,1)` design, i.e. a `2-(3,3,1)` design. That object is excluded by `k<v`. The claim needs the small-order exclusion, e.g. `m\\ge1`.",
      "severity": "fatal",
      "observed_sha256": "7aa01c8bd6592a9de7812d18e7a40d28b410cdb17c02e0f228aeb5054bd0fabf"
    },
    {
      "obligation": "refuter:6:2",
      "id": "thm-steiner-triple-systems-exist-exactly-when-v-congruent-one-or-three-mod-six",
      "location": "Statement",
      "defect": "missing-hypothesis",
      "evidence": "The same dependency texts force `STS(v)` to mean a `2-(v,3,1)` design with `2\\le 3<v`, so no Steiner triple system exists for `v=1` or `v=3` in this library. Yet the Statement says `A Steiner triple system of order v exists iff v\\equiv1 or 3 mod 6`, and both `v=1` and `v=3` satisfy that congruence. The proof reflects the problem: step 1.2 uses Bose at `v=6m+3`, which includes `v=3` via `m=0`, and step 1.3 explicitly says `v\\equiv1 mod6 forces v\\ge7`, which is false because `v=1` is a counterexample. The theorem needs a hypothesis excluding the small orders (equivalently `v>3`).",
      "severity": "fatal",
      "observed_sha256": "83ac0e89800748a2781c25777b63fda036e558f313b332db9cfef71b618c3ebb"
    }
  ],
