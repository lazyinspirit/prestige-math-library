  "load_bearing": [
    {
      "id": "thm-complex-holder-minkowski-and-the-quotient-norm",
      "statement": "On any measure space, complex Hölder holds at all conjugate endpoints, and the a.e. quotient is a complex normed Lp space for every \\(1\\le p\\le\\infty\\).",
      "used_by": [
        "thm-complex-lp-completeness-and-almost-everywhere-subsequences",
        "thm-complex-finite-simple-and-smooth-compact-support-density-for-finite-p",
        "def-complex-l-two-inner-product",
        "thm-complex-l-two-inner-product-is-well-defined-and-cauchy-schwarz",
        "lem-complex-lq-norm-from-finite-simple-dual-tests",
        "lem-complex-translation-and-approximate-identity-interfaces",
        "ex-complex-mollification-by-components"
      ]
    },
    {
      "id": "thm-complex-l-two-inner-product-is-well-defined-and-cauchy-schwarz",
      "statement": "The pairing \\(\\int f\\overline g\\) on complex L2 is a representative-independent first-variable-linear inner product with its L2 norm and the stated equality criterion, including finite tuples.",
      "used_by": [
        "lem-complex-lp-completeness-density-and-inner-product",
        "ex-complex-l-two-pairing-on-two-step-functions"
      ]
    },
    {
      "id": "thm-complex-lp-completeness-and-almost-everywhere-subsequences",
      "statement": "Assuming countable choice, complex Lp is complete for \\(1\\le p\\le\\infty\\), and norm convergence has an a.e.-convergent subsequence of measurable representatives.",
      "used_by": [
        "lem-complex-lp-completeness-density-and-inner-product"
      ]
    },
    {
      "id": "thm-complex-finite-simple-and-smooth-compact-support-density-for-finite-p",
      "statement": "Complex finite-simple finite-measure-support tests are dense for finite p; under countable choice complex \\(C_c^\\infty\\) is dense on Euclidean Lp; the complex L-infinity closure of Cc is precisely the classes with C0 representatives.",
      "used_by": [
        "lem-complex-lp-completeness-density-and-inner-product",
        "lem-complex-lq-norm-from-finite-simple-dual-tests"
      ]
    },
    {
      "id": "lem-complex-lq-norm-from-finite-simple-dual-tests",
      "statement": "The bilinear finite-simple dual-test supremum recovers the complex Lq size under the exact sigma-finite or semifinite hypotheses stated.",
      "used_by": [
        "ex-complex-phase-in-l-q-dual-norming"
      ]
    },
    {
      "id": "lem-complex-translation-and-approximate-identity-interfaces",
      "statement": "Under countable choice, complex Euclidean translations, convolutions, approximate identities, and real-mollifier smoothing have the stated finite-p, C0, and compact-support interfaces.",
      "used_by": [
        "ex-complex-mollification-by-components"
      ]
    },
    {
      "id": "thm-relative-hahn-banach-norm-preserving-extension",
      "statement": "Assuming HB, every bounded scalar-linear functional on any real or complex linear subspace extends to the ambient normed space preserving its norm.",
      "used_by": [
        "cor-relative-hahn-banach-dual-norming"
      ]
    },
    {
      "id": "cor-relative-hahn-banach-dual-norming",
      "statement": "Assuming HB, every nonzero vector has a norm-one functional taking its norm as a positive real value, and the dual unit ball realizes the norm of each fixed vector.",
      "used_by": [
        "cor-relative-hahn-banach-bidual-isometry",
        "ex-relative-separation-of-a-ball-and-an-exterior-point"
      ]
    },
    {
      "id": "lem-relative-open-convex-gauge-properties",
      "statement": "The gauge of an open convex neighbourhood of zero is real-sublinear, Lipschitz, and recovers that neighbourhood as \\(\\{p_U<1\\}\\).",
      "used_by": [
        "lem-relative-hahn-banach-separates-an-open-convex-set-from-a-point"
      ]
    },
    {
      "id": "lem-relative-hahn-banach-separates-an-open-convex-set-from-a-point",
      "statement": "Assuming HB, every nonempty open convex set and exterior point admit a nonzero continuous scalar-linear functional with strict real-part separation.",
      "used_by": [
        "thm-relative-hahn-banach-geometric-separation"
      ]
    },
    {
      "id": "lem-relative-compact-closed-sets-have-a-positive-distance-gap",
      "statement": "A nonempty compact set and a disjoint nonempty closed set in a normed space have a uniform positive norm-distance gap.",
      "used_by": [
        "thm-relative-hahn-banach-geometric-separation"
      ]
    },
    {
      "id": "thm-relative-hahn-banach-geometric-separation",
      "statement": "Assuming HB, the stated open-versus-convex and closed-versus-compact convex separation conclusions hold with their exact strictness and uniform-margin hypotheses.",
      "used_by": []
    }
  ],
