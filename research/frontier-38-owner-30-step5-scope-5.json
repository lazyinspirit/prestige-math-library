  "refuter_findings": [
    {
      "obligation": "refuter:5:1",
      "id": "rem-mihlin-does-not-assert-strong-endpoint-bounds",
      "location": "Statement, second paragraph, first sentence",
      "defect": "false-claim",
      "evidence": "The remark says: “Consequently no endpoint conclusion for a bounded Fourier multiplier with a jump or singularity in its symbol may be read off this page.” However, items/thm-mihlin-fourier-multiplier-theorem.md, proof 3.1, establishes that the kernel has annular and Hörmander constants at most C_n A, the operator has L2 norm ||m||∞, and “T_m is a Calderón–Zygmund operator.” The Statement of items/thm-calderon-zygmund-operator-has-weak-type-one-one.md then gives |{|T_m f|>λ}| ≤ C_n(A_2+B)λ^(-1)||f||_1. Under their shared Countable Choice hypothesis, these results yield a weak (1,1) endpoint for every Mihlin multiplier. In particular, m(ξ)=-i sgn(ξ) has an origin jump, satisfies the one-dimensional Mihlin conditions, and receives this endpoint conclusion from the page. The blanket page-level exclusion is therefore false.",
      "severity": "fatal",
      "observed_sha256": "bfd2f34327e2551a9a9aee9a025456cbf0c74cb226473c22613384a739bd6b0a"
    }
  ],
