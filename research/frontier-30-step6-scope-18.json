    {
      "obligation": "refuter:18:1",
      "id": "cex-noncompact-smallness-without-the-strong-topology-can-create-critical-points-at-infinity",
      "location": "2.1",
      "defect": "false-claim",
      "evidence": "The item computes \"g_n'(n)=1+n\\beta'(0)=1-n<0.\" For n=1 this equals 0, not a negative number. The later critical-point conclusion can be repaired, but the displayed strict inequality is false as written.",
