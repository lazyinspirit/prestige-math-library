        },
        {
          "case": "iff-reverse",
          "status": "checked",
          "evidence": "Step 2.1 shows |s|>=u_alpha(v) implies the squared inequality, and step 1.1 reverses the algebra to the mixture threshold."
        }
      ],
      "finite_checks": []
    },
