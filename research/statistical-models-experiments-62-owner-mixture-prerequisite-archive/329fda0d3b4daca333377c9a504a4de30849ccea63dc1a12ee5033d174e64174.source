        },
        {
          "fact": "F2",
          "source": "thm-taking-out-what-is-known",
          "source_section": "Statement",
          "quote": "The identity also holds for finite real $\\mathcal G$-measurable $Z$ whenever $ZX$ and $ZE[X\\mid\\mathcal G]$ are integrable.",
          "uses": [
            "1.1",
            "2.1"
          ]
        },
        {
          "fact": "F3",
          "source": "thm-monotone-convergence-for-the-integral",
          "source_section": "Statement",
          "quote": "Then $$\\int f_n\\,d\\mu\\uparrow\\int f\\,d\\mu.$$",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F4",
          "source": "def-martingale-submartingale-and-supermartingale",
          "source_section": "Definition",
          "quote": "$$E[X_{n+1}\\mid\\mathcal F_n]=X_n,\\qquad E[X_{n+1}\\mid\\mathcal F_n]\\ge X_n,\\qquad E[X_{n+1}\\mid\\mathcal F_n]\\le X_n\\quad\\text{almost surely}.$$ ",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F5",
          "source": "def-nonnegative-test-supermartingale",
          "source_section": "Definition",
          "quote": "A real-valued process $E=(E_t)_{t\\in\\mathbb N_0}$ is a **nonnegative test supermartingale for $\\mathcal P_0$** if, for every $P\\in\\mathcal P_0$, it is adapted and integrable under $P$",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "A1",
          "source": "def-axiom-of-choice",
          "source_section": "Definition",
          "quote": "The **Axiom of Choice** (AC) is the following statement.",
          "uses": [
            "2.1"
          ]
        }
      ],
      "derivations": [
