    "lem-conditional-subgaussian-exponential-process": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-conditional-subgaussian-increments",
          "source_section": "Definition",
          "quote": "The increments are **conditionally sub-Gaussian around $\\mu$ with proxy $\\sigma^2$** when, for every integer $t\\ge1$ and every fixed $\\lambda\\in\\mathbb R$, $e^{\\lambda(X_t-\\mu)}$ is integrable and",
