          "id": "step-1-1",
          "claim": "Use bounded truncations of the previous exponential factor, the conditional mgf bound, and monotone convergence to prove integrability inductively.",
          "step": "1.1",
          "inputs": [
            "given",
            "F1",
            "F2",
            "F3",
            "construct"
