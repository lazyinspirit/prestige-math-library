    "lem-gaussian-mixture-boundary-crossing-equivalence": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-gaussian-mixture-confidence-sequence-boundary",
          "source_section": "Definition",
          "quote": "For $v\\ge0$ define $$u_\\alpha(v):=\\sqrt{(v+\\rho)\\log\\!\\left(\\frac{v+\\rho}{\\alpha^2\\rho}\\right)}.$$",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F2",
          "source": "thm-natural-logarithm-laws",
          "source_section": "Statement",
          "quote": "The function $\\log:(0,\\infty)\\to\\mathbb R$ is continuous and strictly increasing,",
          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F3",
          "source": "thm-of-square-roots",
          "source_section": "Statement",
          "quote": "Then every $a \\in F$ with $a \\ge 0$ has a **unique** $s \\in F$ with $s \\ge 0$ and $s^2 = a$;",
          "uses": [
            "2.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "step-1-1",
          "claim": "Take logarithms of the positive mixture statistic and rearrange its threshold inequality into a squared boundary inequality.",
          "step": "1.1",
          "inputs": [
            "given",
            "F2",
            "algebra"
          ]
        },
        {
          "id": "step-2-1",
          "claim": "Use the positive logarithm argument and uniqueness of the nonnegative square root to identify the squared inequality with the absolute-value boundary.",
          "step": "2.1",
          "inputs": [
            "F1",
            "F3",
            "step 1.1"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "The lemma is a scalar algebraic equivalence with no parameter set."
        },
        {
          "case": "zero",
          "status": "checked",
          "evidence": "At s=0, step 1.1 gives a positive threshold while step 2.1 yields the equivalent false inequality."
        },
        {
          "case": "one",
          "status": "checked",
          "evidence": "Statement includes v=1 in its domain, and step 1.1 remains valid there."
        },
        {
          "case": "degenerate",
          "status": "checked",
          "evidence": "The case s=0 is covered in step 2.1."
        },
        {
          "case": "endpoints",
          "status": "checked",
          "evidence": "The endpoint v=0 is allowed, and alpha and rho stay in their strict domains in steps 1.1 and 2.1."
