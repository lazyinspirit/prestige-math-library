          "uses": [
            "1.1"
          ]
        },
        {
          "fact": "F3",
          "source": "lem-normal-density-has-total-mass-one",
          "source_section": "Statement",
          "quote": "Assume AC. The function $\\phi(x)=e^{-x^2/2}/\\sqrt{2\\pi}$ is positive and Borel measurable on $\\mathbb R$, with Lebesgue integral one.",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F4",
          "source": "thm-substitution",
          "source_section": "Statement",
          "quote": "Then $(f\\circ\\varphi)\\,\\varphi'$ is integrable on $[c,d]$ and",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F5",
          "source": "thm-monotone-convergence-for-the-integral",
          "source_section": "Statement",
          "quote": "Then $$\\int f_n\\,d\\mu\\uparrow\\int f\\,d\\mu.$$",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "A1",
          "source": "def-axiom-of-choice",
          "source_section": "Definition",
          "quote": "The **Axiom of Choice** (AC) is the following statement.",
          "uses": [
            "1.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "step-1-1",
          "claim": "Represent the centered normal mixer as the scaled standard-normal law and express the nonnegative mixture as an integral against its standard density.",
          "step": "1.1",
          "inputs": [
            "given",
            "F1",
