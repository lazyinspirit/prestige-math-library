    "cex-test-supermartingale-supremum-threshold-need-not-be-attained": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-probability-measure",
          "source_section": "Definition",
          "quote": "A **probability measure** on a measurable space $(X,\\mathcal A)$ is a measure $\\mathbb P$ with $\\mathbb P(X)=1$",
          "uses": [
            "1.1",
            "2.1",
            "4.1"
          ]
        },
        {
          "fact": "F2",
          "source": "def-conditional-expectation-given-a-sigma-algebra",
          "source_section": "Definition",
          "quote": "A **conditional-expectation version of $X$ given $\\mathcal G$** is a real, $\\mathcal G$-measurable, integrable function $Y$ such that $\\int_A Y\\,dP=\\int_A X\\,dP$ for every $A\\in\\mathcal G$.",
          "uses": [
            "3.1"
          ]
        },
        {
          "fact": "F3",
          "source": "def-conditional-expectation-as-an-ae-class",
          "source_section": "Definition",
          "quote": "Equalities and inequalities involving these classes mean almost-sure equalities and inequalities.",
          "uses": [
            "3.1"
          ]
        },
        {
          "fact": "F4",
          "source": "def-expectation-of-a-nonnegative-or-integrable-random-variable",
          "source_section": "Definition",
          "quote": "If $X:\\Omega\\to[0,+\\infty]$ is measurable, its **expectation** is the extended-valued integral",
          "uses": [
            "2.1",
            "4.1"
          ]
        },
        {
          "fact": "F5",
          "source": "prop-order-and-scalar-rules-for-the-nonnegative-integral",
          "source_section": "Statement",
          "quote": "If $f\\le g$, then $\\int f\\,d\\mu\\le\\int g\\,d\\mu$.",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F6",
          "source": "def-martingale-submartingale-and-supermartingale",
          "source_section": "Definition",
          "quote": "$$E[X_{n+1}\\mid\\mathcal F_n]=X_n,\\qquad E[X_{n+1}\\mid\\mathcal F_n]\\ge X_n,\\qquad E[X_{n+1}\\mid\\mathcal F_n]\\le X_n\\quad\\text{almost surely}.$$",
          "uses": [
            "3.1"
          ]
        },
        {
          "fact": "F7",
          "source": "def-nonnegative-test-supermartingale",
          "source_section": "Definition",
          "quote": "is a **nonnegative test supermartingale for $\\mathcal P_0$** if, for every $P\\in\\mathcal P_0$",
          "uses": [
            "4.1"
          ]
        },
        {
          "fact": "F8",
          "source": "thm-discrete-ville-inequality",
          "source_section": "Statement",
          "quote": "P\\!\\left(\\sup_{t\\ge0}M_t\\ge\\frac1\\alpha\\right)\\le\\alpha",
          "uses": [
            "5.1"
          ]
        },
        {
          "fact": "A1",
          "source": "def-axiom-of-choice",
          "source_section": "Definition",
          "quote": "Every family of nonempty sets has a choice function",
          "uses": [
            "3.1",
            "4.1",
            "5.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "derivation-1.1",
          "step": "1.1",
          "claim": "The explicit atomic sample space has total probability one and the sigma-algebras F_n form an increasing filtration.",
          "inputs": [
            "F1",
            "given",
            "construct",
            "algebra"
          ]
        },
        {
          "id": "derivation-2.1",
          "step": "2.1",
          "claim": "The defined process is measurable, nonnegative, bounded, and integrable at every finite time, with every value strictly below c.",
          "inputs": [
            "given",
            "F1",
            "F4",
            "F5",
            "step 1.1",
            "algebra"
          ]
        },
        {
          "id": "derivation-3.1",
          "step": "3.1",
          "claim": "The conditional mean of M_{n+1} on every atom of F_n equals M_n, so M is a martingale.",
          "inputs": [
            "F2",
            "F3",
            "F6",
