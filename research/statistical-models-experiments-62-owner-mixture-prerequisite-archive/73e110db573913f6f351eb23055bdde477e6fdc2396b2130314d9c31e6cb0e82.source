          "inputs": [
            "F1",
            "F4",
            "F7",
            "A1",
            "step 2.1",
            "step 3.1"
          ]
        },
        {
          "id": "derivation-5.1",
          "step": "5.1",
          "claim": "No finite-time value reaches two, but the path at a approaches two and has supremum two; therefore the supremum event has probability one quarter while the first-crossing event has probability zero.",
          "inputs": [
            "given",
            "F8",
            "A1",
            "step 2.1",
            "step 4.1",
            "algebra"
          ]
