  "load_bearing": [
    {
      "id": "cor-depth-as-first-nonzero-ext",
      "statement": "Let R be Noetherian, M finite, and I lie in the Jacobson radical. Then depth_I(M)=inf{i≥0: Ext^i_R(R/I,M)≠0}, with infimum of the empty set ∞.",
      "used_by": [
        "thm-depth-equals-maximal-regular-sequence-length",
        "lem-depth-radical-invariance-via-ext",
        "lem-depth-quotient-by-regular-element",
        "thm-depth-lemma",
        "lem-completion-reflects-depth"
      ]
    },
    {
      "id": "thm-depth-lemma",
      "statement": "For 0→A→B→C→0 over a Noetherian local ring, b≥min{a,c}, a≥min{b,c+1}, and c≥min{a−1,b}.",
      "used_by": [
        "cor-depth-lemma-unequal-depth-equalities",
        "ex-depth-of-a-union-of-planes",
        "ex-depth-lemma-three-inequalities"
      ]
    },
    {
      "id": "thm-parameters-and-regular-sequences-in-cohen-macaulay-modules",
      "statement": "For a nonzero finite module over a Noetherian local ring, Cohen--Macaulayness is equivalent to every, and to some, system of parameters being regular.",
      "used_by": [
        "ex-parameter-sequence-regular-in-a-hypersurface"
      ]
    },
    {
      "id": "cor-flat-local-depth-additivity",
      "statement": "For a flat local homomorphism (R,m)→(S,n) of Noetherian local rings, depth(S)=depth(R)+depth(S/mS).",
      "used_by": [
        "cor-flat-local-cohen-macaulay-fibre-criterion",
        "thm-depth-formula-for-flat-local-homomorphisms"
      ]
    },
    {
      "id": "thm-segre-image-rank-one-minors",
      "statement": "The image of the Segre map is precisely the nonzero projective matrices satisfying all 2 by 2 minor equations; it is a closed projective subvariety.",
      "used_by": [
        "cor-projective-variety-product-exists",
        "lem-incidence-locus-is-closed",
        "thm-multihomogeneous-map-to-projective-space",
        "cor-segre-veronese-embedding",
        "ex-segre-p1-times-p1-quadric"
      ]
    },
    {
      "id": "thm-plucker-image-closed",
      "statement": "The Plucker image of Gr(r,V) is a closed projective algebraic set cut out by the quadratic Plucker relations.",
      "used_by": [
        "lem-grassmannian-standard-affine-charts",
        "lem-incidence-locus-is-closed",
        "ex-grassmannian-lines-in-projective-three-space"
      ]
    },
    {
      "id": "def-sheaf-on-topological-space",
      "statement": "A sheaf is a presheaf satisfying locality and gluing for every open cover.",
      "used_by": [
        "thm-sheaf-equalizer-condition",
        "lem-sheaf-condition-check-on-basis",
        "thm-sheaf-morphism-isomorphism-stalkwise",
        "lem-second-plus-construction-is-sheaf"
      ]
    },
    {
      "id": "def-stalk-of-presheaf",
      "statement": "The stalk F_x is the filtered colimit of sections over neighbourhoods of x, equivalently local sections modulo equality on a smaller neighbourhood.",
      "used_by": [
        "lem-germ-equivalence-relation",
        "def-germ-of-section",
        "thm-sheaf-morphism-isomorphism-stalkwise",
        "def-etale-space-of-sheaf-of-sets",
        "thm-sheafification-preserves-stalks"
      ]
    },
    {
      "id": "def-sheafification",
      "statement": "The sheafification of a presheaf F is aF=F++.",
      "used_by": [
        "thm-sheafification-universal-property",
        "thm-sheafification-preserves-stalks",
        "cor-sheafification-idempotent",
        "lem-image-sheaf-is-sheafification-presheaf-image"
      ]
    },
    {
      "id": "thm-quasi-coherent-ideal-closed-subscheme-correspondence",
      "statement": "For a scheme X, quasi-coherent ideal sheaves and closed subschemes correspond mutually inversely via I↦V(I) and the kernel ideal sheaf.",
      "used_by": [
        "thm-scheme-theoretic-image-quasi-compact-morphism"
      ]
    },
    {
      "id": "thm-gluing-affine-schemes",
      "statement": "Affine schemes with compatible open-overlap isomorphisms satisfying identity and cocycle conditions glue uniquely up to unique isomorphism to a scheme covered by those affine charts.",
      "used_by": [
        "ex-projective-line-by-gluing-affines",
        "ex-doubled-origin-nonseparated-scheme"
      ]
    }
  ],
