  "conventions": [
    {
      "convention": "For a finite module M, depth_I(M) is the supremum of lengths of M-regular sequences in I when IM ≠ M, and is ∞ when IM = M; in particular depth_I(0) = ∞.",
      "fixed_by": "def-depth-with-respect-to-an-ideal",
      "matters_for": [
        "cor-depth-as-first-nonzero-ext",
        "lem-depth-quotient-by-regular-element",
        "thm-depth-lemma",
        "thm-depth-bounded-by-support-dimension",
        "ex-depth-infinity-zero-module-convention"
      ]
    },
    {
      "convention": "An M-regular sequence requires injectivity at every successive quotient and a nonzero terminal quotient.",
      "fixed_by": "def-regular-sequence-on-a-module",
      "matters_for": [
        "lem-depth-quotient-by-regular-element",
        "thm-depth-equals-maximal-regular-sequence-length",
        "thm-regular-quotients-and-cohen-macaulayness",
        "lem-completion-preserves-regular-sequences"
      ]
    },
    {
      "convention": "Local Cohen--Macaulay modules are nonzero finite modules with depth equal to support dimension; the zero module is excluded locally but is globally Cohen--Macaulay vacuously.",
      "fixed_by": "def-cohen-macaulay-local-module-and-ring",
      "matters_for": [
        "def-maximal-and-global-cohen-macaulay-modules",
        "thm-parameters-and-regular-sequences-in-cohen-macaulay-modules",
        "thm-localisation-of-cohen-macaulay-modules",
        "thm-completion-preserves-cohen-macaulayness"
      ]
    },
    {
      "convention": "Classical constructions on the products page are over a fixed algebraically closed field k; a classical variety is nonempty and irreducible.",
      "fixed_by": "def-product-varieties-universal-property",
      "matters_for": [
        "thm-affine-variety-product-coordinate-ring",
        "cor-projective-variety-product-exists",
        "cex-tensor-product-of-domains-not-domain"
      ]
    },
    {
      "convention": "Segre coordinates use the fixed lexicographic order of pairs (i,j); Veronese coordinates use a fixed ordering of degree-d monomials.",
      "fixed_by": "def-segre-map",
      "matters_for": [
        "thm-segre-image-rank-one-minors",
        "cor-segre-veronese-embedding",
        "ex-segre-p1-times-p1-quadric",
        "ex-segre-veronese-bidegree-two-three"
      ]
    },
    {
      "convention": "The open-set category has arrows V → U for V ⊆ U, so presheaves are contravariant and restrictions go from larger opens to smaller opens.",
      "fixed_by": "def-open-set-category-topological-space",
      "matters_for": [
        "def-presheaf-on-topological-space",
        "def-morphism-of-presheaves",
        "def-stalk-of-presheaf"
      ]
    },
    {
      "convention": "The sheaf axiom is required for every open cover, including the empty cover of the empty open set.",
      "fixed_by": "def-sheaf-on-topological-space",
      "matters_for": [
        "lem-sheaf-section-over-empty-set-terminal",
        "thm-sheaf-equalizer-condition",
        "ex-empty-space-unique-sheaf-sections"
      ]
    },
    {
      "convention": "A stalk is the filtered colimit over open neighbourhoods, concretely local sections modulo equality on a smaller open neighbourhood.",
      "fixed_by": "def-stalk-of-presheaf",
      "matters_for": [
        "lem-germ-equivalence-relation",
        "def-germ-of-section",
        "thm-sheaf-morphism-isomorphism-stalkwise",
        "thm-sheafification-preserves-stalks"
      ]
    },
    {
      "convention": "Sheafification is the double-plus construction aF = F++ with the composite single-chart unit map.",
      "fixed_by": "def-sheafification",
      "matters_for": [
        "thm-sheafification-universal-property",
        "thm-sheafification-preserves-stalks",
