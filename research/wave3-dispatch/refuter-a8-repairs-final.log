research/audit/wave3-real-analysis.proof-contracts.json-6058-     "step": "3.2",
research/audit/wave3-real-analysis.proof-contracts.json-6059-     "claim": "Claim 4: $a^{-r} = \\big(a^{1/N}\\big)^{-m} = \\Big(\\big(a^{1/N}\\big)^{m}\\Big)^{-1} = \\big(a^{r}\\big)^{-1}$.",
research/audit/wave3-real-analysis.proof-contracts.json-6060-     "inputs": [
research/audit/wave3-real-analysis.proof-contracts.json-6061-      "step 1.1",
research/audit/wave3-real-analysis.proof-contracts.json-6062-      "step 2.1",
