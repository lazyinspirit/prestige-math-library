    13	        thm-path-connected-implies-connected,
    14	        thm-connected-and-locally-path-connected-implies-path-connected,
    15	        thm-a-linear-continuum-is-connected, def-the-long-line,
    16	        thm-the-long-line-is-a-connected-linear-continuum, lem-the-oscillating-zigzag-curve,
    17	        rem-connectedness-conventions]
