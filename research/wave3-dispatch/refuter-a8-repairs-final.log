research/audit/wave3-real-analysis.proof-contracts.json-6088-    {
research/audit/wave3-real-analysis.proof-contracts.json:6089:     "id": "lem-rational-power-laws::4.1",
research/audit/wave3-real-analysis.proof-contracts.json-6090-     "step": "4.1",
research/audit/wave3-real-analysis.proof-contracts.json-6091-     "claim": "The supplementary nonnegative case, addition identity: the identity $a^{r+s} = a^{r}a^{s}$ involves the base $a$ only, so nothing need be assumed about $b$; for $a > 0$ it is step 3.1 verbatim, which uses only $a > 0$, and both sides are then positive rather than $0$; for $a = 0$ the exponents satisfy $r + s > 0$, so the left side is $0^{r+s} = 0$ and the right side is $0 \\cdot 0 = 0$.",
research/audit/wave3-real-analysis.proof-contracts.json-6092-     "inputs": [
research/audit/wave3-real-analysis.proof-contracts.json-6093-      "step 3.1",
