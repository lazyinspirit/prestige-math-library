      ]
    },
    {
      "id": "lem-zeta-explicit-formula-zero-free-error-balance",
      "statement": "For x≥2 and finite T≥3, ψ(x)-x=O(x exp(-c0 log x/log(T+2)) log²T + x log²(xT)/T + log x).",
      "used_by": [
        "thm-chebyshev-psi-prime-number-theorem-error",
        "ex-optimizing-the-prime-number-theorem-contour-height"
      ]
    },
    {
      "id": "thm-unique-extension-of-a-nonarchimedean-absolute-value",
      "statement": "For every finite L/K with K complete nonarchimedean, the unique extending absolute value is |x|_L=|N_{L/K}(x)|_K^(1/[L:K]); it is nonarchimedean and complete.",
      "used_by": [
        "lem-number-field-completions-as-local-polynomial-factors",
        "thm-decomposition-group-and-completion"
      ]
    },
    {
      "id": "thm-decomposition-inertia-exact-sequence",
      "statement": "For finite Galois L/K and P|p, residue action yields 1→I(P/p)→D(P/p)→Gal(κ(P)/κ(p))→1.",
      "used_by": [
        "cor-orders-of-decomposition-and-inertia-groups",
        "thm-decomposition-and-inertia-in-towers",
        "thm-decomposition-and-inertia-fixed-fields",
        "def-arithmetic-frobenius-coset"
      ]
    },
    {
      "id": "thm-frobenius-cycle-type-and-prime-splitting",
      "statement": "For monic separable F∈Z[T] and p not dividing Disc(F), p is unramified and the irreducible factor degrees of F mod p are the arithmetic-Frobenius cycle lengths on the roots.",
      "used_by": [
        "ex-gaussian-and-eisenstein-frobenius",
        "ex-frobenius-in-a-small-cyclotomic-field",
        "ex-nonabelian-frobenius-conjugacy-class",
        "cex-frobenius-cycle-type-needs-good-reduction"
      ]
