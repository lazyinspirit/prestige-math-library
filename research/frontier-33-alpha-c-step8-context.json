    {
      "id": "thm-riemann-zeta-classical-zero-free-region",
      "statement": "There is an absolute c0>0 such that zeta has no zero in σ≥1-c0/log(|t|+2); its pole at 1 is not a zero.",
      "used_by": [
        "lem-zeta-horizontal-logarithmic-derivative-comparison",
        "thm-zeta-bounds-in-classical-zero-free-region",
