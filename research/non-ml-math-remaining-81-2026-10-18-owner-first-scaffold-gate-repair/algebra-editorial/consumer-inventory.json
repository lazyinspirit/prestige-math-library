    "items/def-universal-enveloping-superalgebra.md": {
      "id": "def-universal-enveloping-superalgebra",
      "deps": [
        "def-lie-superalgebra-over-complex-numbers",
        "def-associative-superalgebra-over-complex-numbers",
        "def-tensor-algebra-of-a-vector-space",
