[
  {
    "order": 213,
    "id": "matchings-covers-menger-and-network-flows",
    "kind": "A",
    "category": "combinatorics",
    "title": "Matchings, Covers, Menger and Network Flows",
    "companion": "matchings-covers-menger-and-network-flows-examples",
    "requires": [
      "eulerian-and-hamiltonian-graphs",
      "incidence-algebras-and-mobius-inversion"
    ],
    "items": [
      {
        "id": "def-matching-maximum-perfect-and-matching-number",
        "kind": "definition",
        "title": "Matchings, saturated vertices, maximal and maximum matchings, perfect matchings and $\\nu(G)$",
        "deps": [
          "def-finite-simple-graph",
          "def-finite-cardinality"
        ]
      },
      {
        "id": "rem-maximal-versus-maximum-matching",
        "kind": "remark",
        "title": "Maximal means inclusion-maximal; maximum means largest cardinality",
        "deps": [
          "def-matching-maximum-perfect-and-matching-number"
        ]
      },
      {
        "id": "def-vertex-and-edge-covers-and-covering-numbers",
        "kind": "definition",
        "title": "Vertex covers, edge covers and the covering numbers $\\tau(G)$ and $\\rho(G)$",
        "deps": [
          "def-finite-simple-graph",
          "def-finite-cardinality"
        ]
      },
      {
        "id": "def-alternating-and-augmenting-path",
        "kind": "definition",
        "title": "Alternating and augmenting paths relative to a matching",
        "deps": [
          "def-matching-maximum-perfect-and-matching-number",
          "def-graph-walk-trail-path-and-cycle"
        ]
      },
      {
        "id": "lem-augmenting-path-switching",
        "kind": "lemma",
        "title": "Switching along an augmenting path increases a matching by one edge",
        "strategy": "constructive",
        "deps": [
          "def-alternating-and-augmenting-path",
          "def-matching-maximum-perfect-and-matching-number"
        ]
      },
      {
        "id": "lem-symmetric-difference-of-two-matchings",
        "kind": "lemma",
        "title": "The symmetric difference of two matchings is a disjoint union of alternating paths and even cycles",
        "strategy": "direct",
        "deps": [
          "def-matching-maximum-perfect-and-matching-number",
          "def-graph-walk-trail-path-and-cycle",
          "def-connected-graph-and-connected-component",
          "def-subgraph-induced-subgraph-and-spanning-subgraph"
        ]
      },
      {
        "id": "thm-berge-augmenting-path-characterisation",
        "kind": "theorem",
        "title": "Berge's theorem: a matching is maximum if and only if it has no augmenting path",
        "strategy": "direct",
        "deps": [
          "lem-augmenting-path-switching",
          "lem-symmetric-difference-of-two-matchings",
          "def-alternating-and-augmenting-path"
        ]
      },
      {
        "id": "def-bipartite-neighbourhood-hall-condition-and-sdr",
        "kind": "definition",
        "title": "Bipartite neighbourhoods, Hall's condition and systems of distinct representatives",
        "deps": [
          "def-bipartite-graph",
          "def-graph-adjacency-incidence-neighbourhood-and-degree",
          "def-finite-cardinality",
          "def-injection-surjection-bijection"
        ]
      },
      {
        "id": "lem-hall-induction-reductions",
        "kind": "lemma",
        "title": "Hall's condition passes to the strict and tight induction subinstances",
        "strategy": "direct",
        "deps": [
          "def-bipartite-neighbourhood-hall-condition-and-sdr",
          "def-subgraph-induced-subgraph-and-spanning-subgraph"
        ]
      },
      {
        "id": "thm-hall-marriage-finite-bipartite",
        "kind": "theorem",
        "title": "Hall's marriage theorem for a finite bipartite graph",
        "strategy": "induction",
        "deps": [
          "lem-hall-induction-reductions",
          "def-matching-maximum-perfect-and-matching-number",
          "thm-induction-principle"
        ]
      },
      {
        "id": "cor-hall-sdr-finite-families",
        "kind": "corollary",
        "title": "A finite family has an SDR if and only if every subfamily has a union at least as large as its index set",
        "strategy": "direct",
        "deps": [
          "thm-hall-marriage-finite-bipartite",
          "def-bipartite-neighbourhood-hall-condition-and-sdr"
        ]
      },
      {
        "id": "cor-hall-deficiency-formula",
        "kind": "corollary",
        "title": "The maximum matching from $X$ has size $|X|-\\max_{S\\subseteq X}(|S|-|N(S)|)$",
        "strategy": "direct",
        "deps": [
          "thm-hall-marriage-finite-bipartite",
          "def-bipartite-neighbourhood-hall-condition-and-sdr",
          "def-matching-maximum-perfect-and-matching-number"
        ]
      },
      {
        "id": "lem-konig-alternating-reachability-cover",
        "kind": "lemma",
        "title": "Alternating reachability from unmatched left vertices produces a vertex cover of the same size as a maximum matching",
        "strategy": "direct",
        "deps": [
          "thm-berge-augmenting-path-characterisation",
          "def-bipartite-neighbourhood-hall-condition-and-sdr",
          "def-vertex-and-edge-covers-and-covering-numbers"
        ]
      },
      {
        "id": "thm-konig-bipartite-matching-cover",
        "kind": "theorem",
        "title": "König's theorem: $\\nu(G)=\\tau(G)$ for every finite bipartite graph",
        "strategy": "direct",
        "deps": [
          "lem-konig-alternating-reachability-cover",
          "def-matching-maximum-perfect-and-matching-number",
          "def-vertex-and-edge-covers-and-covering-numbers"
        ]
      },
      {
        "id": "thm-gallai-matching-edge-cover-identity",
        "kind": "theorem",
        "title": "Gallai's identity: $\\nu(G)+\\rho(G)=|V(G)|$ when $G$ has no isolated vertex",
        "strategy": "constructive",
        "deps": [
          "def-matching-maximum-perfect-and-matching-number",
          "def-vertex-and-edge-covers-and-covering-numbers",
          "def-graph-adjacency-incidence-neighbourhood-and-degree",
          "def-connected-graph-and-connected-component"
        ]
      },
      {
        "id": "def-integral-network-flow-cut-and-residual-network",
        "kind": "definition",
        "title": "Finite integral networks, feasible flows, values, cuts and residual networks",
        "deps": [
          "def-multigraph-loop-and-digraph",
          "def-directed-walk-trail-path-cycle-and-strong-connectivity",
          "def-finite-cardinality",
          "def-finite-sum-in-a-commutative-monoid"
        ]
      },
      {
        "id": "lem-flow-cut-identity-and-weak-duality",
        "kind": "lemma",
        "title": "A flow's value is its net flow across every source-sink cut and never exceeds the cut capacity",
        "strategy": "direct",
        "deps": [
          "def-integral-network-flow-cut-and-residual-network",
          "def-finite-sum-in-a-commutative-monoid"
        ]
      },
      {
        "id": "lem-residual-augmentation",
        "kind": "lemma",
        "title": "Augmenting by the residual bottleneck preserves feasibility and increases the flow value",
        "strategy": "constructive",
        "deps": [
          "def-integral-network-flow-cut-and-residual-network",
          "def-directed-walk-trail-path-cycle-and-strong-connectivity"
        ]
      },
      {
        "id": "lem-no-augmenting-path-gives-tight-cut",
        "kind": "lemma",
        "title": "If the residual network has no source-sink path, its reachable set gives a cut whose capacity equals the flow value",
        "strategy": "direct",
        "deps": [
          "def-integral-network-flow-cut-and-residual-network",
          "lem-flow-cut-identity-and-weak-duality"
        ]
      },
      {
        "id": "thm-ford-fulkerson-integral-max-flow-min-cut",
        "kind": "theorem",
        "title": "Ford-Fulkerson terminates for finite integer capacities and proves max-flow min-cut with an integral maximum flow",
        "strategy": "constructive",
        "deps": [
          "lem-residual-augmentation",
          "lem-no-augmenting-path-gives-tight-cut",
          "lem-flow-cut-identity-and-weak-duality",
          "def-finite-cardinality"
        ]
      },
      {
        "id": "lem-integral-unit-flow-decomposition",
        "kind": "lemma",
        "title": "An integral flow decomposes into source-sink path flows and directed cycle flows; unit capacities make the paths arc-disjoint",
        "strategy": "induction",
        "deps": [
          "def-integral-network-flow-cut-and-residual-network",
          "def-directed-walk-trail-path-cycle-and-strong-connectivity",
          "thm-induction-principle"
        ]
      },
      {
        "id": "prop-bipartite-matching-flow-model",
        "kind": "proposition",
        "title": "The unit network for a bipartite graph identifies integral flows with matchings and finite cuts with vertex covers",
        "strategy": "direct",
        "deps": [
          "thm-ford-fulkerson-integral-max-flow-min-cut",
          "lem-integral-unit-flow-decomposition",
          "thm-konig-bipartite-matching-cover",
          "thm-hall-marriage-finite-bipartite"
        ]
      },
      {
        "id": "def-local-path-packings-and-separators",
        "kind": "definition",
        "title": "Arc-disjoint, edge-disjoint and internally vertex-disjoint path families and their local separators",
        "deps": [
          "def-graph-walk-trail-path-and-cycle",
          "def-directed-walk-trail-path-cycle-and-strong-connectivity",
          "def-graph-deletion-contraction-minor-and-subdivision"
        ]
      },
      {
        "id": "thm-menger-finite-directed-and-undirected-path-forms",
        "kind": "theorem",
        "title": "Menger's theorem: the finite directed and undirected arc, edge and nonadjacent-vertex forms",
        "strategy": "constructive",
        "deps": [
          "def-local-path-packings-and-separators",
          "thm-ford-fulkerson-integral-max-flow-min-cut",
          "lem-integral-unit-flow-decomposition",
          "def-multigraph-loop-and-digraph",
          "def-finite-cardinality"
        ]
      },
      {
        "id": "cor-whitney-k-connected-path-characterisation",
        "kind": "corollary",
        "title": "A finite graph on at least $k+1$ vertices is $k$-connected if and only if every two vertices have $k$ internally disjoint paths",
        "strategy": "direct",
        "deps": [
          "thm-menger-finite-directed-and-undirected-path-forms",
          "def-vertex-and-edge-connectivity",
          "def-graph-deletion-contraction-minor-and-subdivision",
          "def-graph-adjacency-incidence-neighbourhood-and-degree"
        ]
      }
    ]
  },
  {
