      "id": "thm-c1-dependence-of-solutions-on-initial-data",
      "location": "Proof step 3.1",
      "defect": "unlicensed-inference",
      "evidence": "The proof retains integrals from t_0 to t while claiming convergence uniformly on I=[t_0-h,t_0+h]. The cited Gronwall statement applies only for t_0 <= t; its time-reflected form requires integrals from t to t_0. Thus it does not license the asserted conclusion for the left half of I.",
      "severity": "fatal",
      "observed_sha256": "b38c5cee5a6765c2c2be178699e4f59215a2944712e81550bba19fe60a5a3808"
    },
    {
