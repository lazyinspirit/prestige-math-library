      {
        "id": "thm-cg-cone-cat-equivalence-and-polyhedral-link-criterion",
        "kind": "theorem",
        "title": "The cone and link criterion: $C(L)$ is CAT(0) if and only if $L$ is CAT(1)$, and the polyhedral link condition",
        "deps": [
