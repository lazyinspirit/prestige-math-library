      {
        "id": "lem-cg-alexandrov-comparison-triangle-gluing",
        "kind": "lemma",
        "title": "Alexandrov comparison: straightening a hinge, gluing comparison triangles, and patchwork",
        "deps": [
          "def-cg-cat-zero-cat-one-and-local-geodesic",
          "lem-cg-comparison-convexity-and-model-spaces",
          "def-cg-comparison-angle-and-alexandrov-angle",
          "def-metric-space",
          "def-metric-ball",
          "def-geodesic-and-geodesic-metric-space",
          "def-metric-continuity",
