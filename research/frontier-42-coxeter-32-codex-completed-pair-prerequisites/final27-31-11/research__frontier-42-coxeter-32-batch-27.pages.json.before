      {
        "id": "ex-cg-a-tilde-2-radical-vector-and-affine-slice",
        "kind": "example",
        "title": "The radical vector of A-tilde 2 and its Euclidean slice",
        "deps": [
          "def-cg-irreducible-affine-coxeter-type",
          "lem-cg-positive-radical-and-affine-gram-exclusions",
          "def-cg-standard-affine-diagrams",
