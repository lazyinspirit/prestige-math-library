  "refuter_findings": [
    {
      "obligation": "refuter:10:1",
      "id": "cw-complexes-and-cellular-homology",
      "location": "def-skeleta-cw-subcomplex-and-relative-cw-complex — Definition",
      "defect": "ill-formed",
      "evidence": "The definition says a union of cells is a subcomplex when it contains “every cell in the closure” of each included cell. This does not require the closure itself to be contained. Start with the minimal CW structure on S^1 and attach a 2-cell by a map whose image is a proper closed subarc of the open 1-cell. The union consisting only of the open 2-cell contains no whole 1-cell in its closure, so it satisfies the written condition, but its closure contains the subarc omitted from the union. It is not a CW subcomplex.",
      "severity": "fatal",
      "observed_sha256": "53011e85d12b9b3dada8093adf4c43182a1545e2dd353c5e41a10b3909180ded"
    },
    {
      "obligation": "refuter:10:2",
      "id": "cw-complexes-and-cellular-homology",
      "location": "prop-cw-skeleta-are-closed-and-cells-form-a-disjoint-partition — 1.1",
      "defect": "false-claim",
      "evidence": "Step 1.1 says X^n intersected with every closed cell is “either all of” that cell “or a union of boundary cells.” In the CW complex obtained by attaching a 2-cell to a proper subarc of the open 1-cell of the minimal S^1, X^1 intersected with the closed 2-cell is that proper subarc, not a union of cells. Thus the stated justification for applying the weak-topology clause is false.",
      "severity": "fatal",
      "observed_sha256": "53011e85d12b9b3dada8093adf4c43182a1545e2dd353c5e41a10b3909180ded"
    },
    {
      "obligation": "refuter:10:3",
      "id": "cw-complexes-and-cellular-homology",
      "location": "def-incidence-number-of-two-cw-cells — Definition",
      "defect": "ill-formed",
      "evidence": "The definition asserts that collapsing X^{n-1} minus e^{n-1}_β gives a quotient S^{n-1}, including n=1. For the standard one-vertex/one-edge CW structure on S^1, n=1 and X^0 minus e^0_β is empty, so X^0/emptyset is a one-point space, not S^0. Hence the stated map to S^0 and its induced endomorphism of reduced H_0(S^0;Z) are not defined. The final sentence about oriented reduced H_0 does not supply the missing map.",
      "severity": "fatal",
      "observed_sha256": "53011e85d12b9b3dada8093adf4c43182a1545e2dd353c5e41a10b3909180ded"
    },
    {
      "obligation": "refuter:10:4",
      "id": "cw-complexes-and-cellular-homology",
      "location": "thm-cellular-boundary-is-the-incidence-degree-matrix — Statement",
      "defect": "ill-formed",
      "evidence": "The displayed formula is asserted without excluding n=1, but its coefficient [e^n_α:e^{n-1}_β] is undefined in the one-vertex case by the preceding incidence-number definition. In particular, it cannot state a formula for d_1 as written; d_1 requires a separate endpoint calculation or an amended definition.",
      "severity": "fatal",
      "observed_sha256": "53011e85d12b9b3dada8093adf4c43182a1545e2dd353c5e41a10b3909180ded"
    },
    {
      "obligation": "refuter:10:5",
      "id": "cw-complexes-and-cellular-homology-examples",
      "location": "ex-cellular-homology-of-real-projective-space — 1.1",
      "defect": "false-claim",
      "evidence": "Step 1.1 gives the attaching incidence degree as 1+(-1)^{n-1}, while the Example states d_n=0 for odd n and d_n=2 for positive even n. At n=1 the displayed expression equals 2, and at n=2 it equals 0, exactly the reverse of the stated differential. Under the stated convention the needed expression is 1+(-1)^n.",
