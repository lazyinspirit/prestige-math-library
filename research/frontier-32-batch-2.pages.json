        ]
      },
      {
        "id": "def-prefix-free-machine-and-prefix-complexity",
        "kind": "definition",
        "title": "Prefix-free machines and prefix complexity",
        "strategy": "Define a prefix-free description machine M and its relative complexity K_M(x), with infinity when no description exists. Do not yet write an unqualified K or assume an optimal prefix machine; reserve that convention until the following invariance theorem constructs one.",
        "deps": [
          "def-description-machine-and-plain-kolmogorov-complexity"
        ]
      },
      {
        "id": "thm-kraft-inequality",
        "kind": "theorem",
        "title": "Kraft inequality and effective prefix-code allocation",
        "deps": [
          "def-prefix-free-machine-and-prefix-complexity"
        ]
      },
      {
        "id": "thm-invariance-for-prefix-complexity",
        "kind": "theorem",
        "title": "Invariance theorem for prefix complexity",
        "strategy": "Use the acceptable effective numbering to enumerate prefix-free description machines through a syntactic prefix-preserving presentation. Give each machine index a fixed self-delimiting code and let U(code(e)p)=M_e(p); the combined domain is prefix-free and K_U(x)<=K_{M_e}(x)+|code(e)|. Only after this construction fix K=K_U.",
        "deps": [
          "def-prefix-free-machine-and-prefix-complexity",
          "def-universal-and-acceptable-numbering"
        ]
      },
      {
        "id": "thm-symmetry-of-information-up-to-logarithmic-terms",
        "kind": "theorem",
        "title": "Symmetry of information up to logarithmic terms",
        "deps": [
          "def-conditional-kolmogorov-complexity",
          "def-prefix-free-machine-and-prefix-complexity",
          "thm-kraft-inequality",
          "thm-invariance-for-prefix-complexity"
        ],
        "strategy": "For finite strings x,y, prove C(x,y)=C(x|y)+C(y)+O(log(C(x)+2)+log(C(y)+2)) by the counting and self-delimiting-index argument of Shen's Theorem 11, and then swap x and y to obtain symmetry up to logarithmic terms. Keep plain C distinct from prefix K; prefix-free coding and Kraft allocation supply the self-delimiting bookkeeping, while the chosen optimal prefix machine is licensed by its preceding invariance theorem."
      },
      {
