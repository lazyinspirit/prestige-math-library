          "def-np-by-verifiers"
        ]
      },
      {
        "id": "lem-sequential-repetition-amplifies-error",
        "kind": "lemma",
        "title": "Sequential repetition amplifies completeness and soundness gaps",
        "strategy": "Run fresh verifier coins in each sequential copy and accept by a stated threshold. For completeness, the honest prover gives independent Bernoulli successes and the recorded Chernoff bound applies. For soundness against an adaptive prover, condition on every prior transcript: each next-copy success probability is still at most s, so an exponential-moment induction gives the same binomial upper-tail bound without falsely asserting independence of the cheating outcomes.",
        "deps": [
          "def-completeness-and-soundness",
          "lem-chernoff-bound-for-bernoulli-trials"
        ]
      },
      {
        "id": "def-private-coin-public-coin-and-arthur-merlin-protocol",
        "kind": "definition",
        "title": "Private-coin, public-coin, and Arthur--Merlin protocols",
        "deps": [
          "def-ip"
        ]
      },
      {
        "id": "lem-hashing-commits-public-randomness",
        "kind": "lemma",
        "title": "Pairwise-independent hashing controls fibre size",
        "deps": [
          "def-private-coin-public-coin-and-arthur-merlin-protocol",
          "def-pairwise-independent-hash-family"
        ],
        "strategy": "Compute the fibre-count mean and variance. Prove that accepting a valid preimage has probability at most 1/4 for mean at most 1/4 and at least 3/4 for mean at least 4; state explicit efficient-sampling and membership hypotheses for the public-coin implementation."
      },
      {
        "id": "thm-private-coin-ip-equals-public-coin-ip",
        "kind": "theorem",
        "title": "Private-coin IP equals public-coin IP",
        "deps": [
          "def-private-coin-public-coin-and-arthur-merlin-protocol",
          "lem-hashing-commits-public-randomness"
        ]
      },
      {
        "id": "def-protocol-game-tree-and-value",
        "kind": "definition",
        "title": "Protocol game trees and their values",
        "deps": [
          "def-interactive-proof-transcript-round-and-strategy"
        ]
      },
      {
        "id": "lem-optimal-prover-may-be-deterministic",
        "kind": "lemma",
        "title": "An optimal prover may be deterministic",
        "deps": [
          "def-protocol-game-tree-and-value"
        ]
      },
      {
        "id": "lem-protocol-value-is-computable-in-polynomial-space",
        "kind": "lemma",
        "title": "A polynomial-round protocol value is computable in polynomial space",
        "deps": [
          "def-protocol-game-tree-and-value",
          "lem-optimal-prover-may-be-deterministic",
          "def-pspace-and-npspace"
        ],
        "strategy": "Count compatible padded random tapes and recursively compute the optimal accepting count using public-message sums and prover-response maxima. Bound all integer accumulators by 2^r, output a binary numerator/denominator pair, and decide rational thresholds in PSPACE by cross multiplication."
      },
      {
        "id": "thm-ip-is-contained-in-pspace",
        "kind": "theorem",
        "title": "IP is contained in PSPACE",
        "deps": [
          "def-ip",
          "lem-protocol-value-is-computable-in-polynomial-space"
        ]
      },
      {
