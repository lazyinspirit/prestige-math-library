        "id": "lem-square-integrable-predictable-step-ito-integral-is-finite-sum",
        "kind": "lemma",
        "title": "A square-integrable predictable step Itô integral is its finite sum",
        "deps": [
          "def-axiom-of-choice",
          "def-d-dimensional-brownian-motion",
          "def-progressively-measurable-and-predictable-process",
          "def-elementary-predictable-brownian-integrand",
