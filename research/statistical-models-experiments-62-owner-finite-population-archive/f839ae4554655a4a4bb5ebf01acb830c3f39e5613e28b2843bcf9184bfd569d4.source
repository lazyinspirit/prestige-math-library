    "ex-zero-inclusion-probability-and-unobserved-unit": {
      "risk": "low",
      "kind": "example",
      "citations": [
        {"fact":"F1","source":"def-finite-population-and-sampling-design","source_section":"Definition","quote":"The observed record includes the selected unit labels and their values.","uses":["1.1","2.1"]},
        {"fact":"F2","source":"thm-zero-inclusion-probability-precludes-identification-and-universal-unbiasedness","source_section":"Statement","quote":"Let $i\\in U$ have $\\pi_i=0$ in a finite-population design as in [[def-finite-population-and-sampling-design]].","uses":["2.1"]},
        {"fact":"F3","source":"def-statistic-and-estimator","source_section":"Definition","quote":"A **statistic** with target measurable space $(\\mathcal Y,\\mathcal B)$ is a measurable map","uses":["2.1"]},
        {"fact":"F4","source":"def-unbiased-estimator-and-umvu","source_section":"Definition","quote":"It is **unbiased** if it is integrable under every $P_\\theta$ and","uses":["2.1"]}
      ],
      "derivations": [],
      "routine_steps": [
        {"id":"compute-unobserved-records","step":"1.1","claim":"The design has pi_2=0, identical observed records under y and y-prime, and totals zero and one.","inputs":["given","F1","algebra"]},
        {"id":"rule-out-unbiasedness-in-example","step":"2.1","claim":"Any estimator takes one value at the common record, so the two degenerate-law expectations cannot equal both totals; this verifies the general theorem's instance.","inputs":["F1","F2","F3","F4","step 1.1","algebra"]}
      ],
      "boundaries": [
        {"case":"empty","status":"not_applicable","reason":"The example has two units and one supported sample."},
        {"case":"zero","status":"checked","evidence":"Step 1.1 exhibits the zero-inclusion unit directly."},
        {"case":"one","status":"checked","evidence":"Step 1.1 uses a singleton sample from a two-unit population."},
        {"case":"degenerate","status":"checked","evidence":"The design has one outcome with probability one, handled in steps 1.1–2.1."},
        {"case":"endpoints","status":"not_applicable","reason":"No interval parameter or endpoint appears in the example."},
        {"case":"nonempty-choice","status":"not_applicable","reason":"The two populations and the sole sample are explicit; no choice principle is used."},
        {"case":"iff-forward","status":"not_applicable","reason":"The example is a countermodel to universal unbiasedness, not an equivalence."},
        {"case":"iff-reverse","status":"not_applicable","reason":"The example is a countermodel to universal unbiasedness, not an equivalence."}
      ],
