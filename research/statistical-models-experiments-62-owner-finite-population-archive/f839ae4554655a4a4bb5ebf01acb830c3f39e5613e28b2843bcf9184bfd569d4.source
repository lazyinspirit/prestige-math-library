        {"fact":"F1","source":"def-finite-population-and-sampling-design","source_section":"Definition","quote":"the **first-order inclusion probability**","uses":["1.1","2.1","3.1"]},
        {"fact":"F2","source":"thm-horvitz-thompson-total-is-design-unbiased","source_section":"Statement","quote":"Under the induced observed-data law $P_y^d$, these are estimators of the finite-population total and mean, respectively, and","uses":["2.1"]},
        {"fact":"F3","source":"def-expectation-on-a-finite-probability-space","source_section":"Definition","quote":"The **expectation** of a real random variable $X$ on a finite probability space $(\\Omega,w)$ is","uses":["2.1"]},
        {"fact":"F4","source":"def-unbiased-estimator-and-umvu","source_section":"Definition","quote":"It is **unbiased** if it is integrable under every $P_\\theta$ and","uses":["2.1"]}
      ],
      "derivations": [],
      "routine_steps": [
        {"id":"compute-certainty-unit-design","step":"1.1","claim":"The two-sample design has pi_1=1, pi_2=pi_3=1/2 and HT totals a+2b and a+2c.","inputs":["given","F1","algebra"]},
        {"id":"average-certainty-design","step":"2.1","claim":"The design average is a+b+c, and the A-page theorem and unbiasedness definition apply to its mean estimator.","inputs":["F1","F2","F3","F4","step 1.1","algebra"]},
        {"id":"evaluate-census-design","step":"3.1","claim":"With only sample U, every pi_i=1 and the HT total and mean equal their targets on the single outcome.","inputs":["given","F1","algebra"]}
      ],
      "boundaries": [
        {"case":"empty","status":"not_applicable","reason":"Both displayed designs have a nonempty population and normalized support."},
        {"case":"zero","status":"checked","evidence":"Step 1.1 remains valid for zero values among a,b,c because the weights are finite."},
        {"case":"one","status":"not_applicable","reason":"The certainty-unit design is explicitly three-unit; the general theorem covers N=1."},
        {"case":"degenerate","status":"checked","evidence":"Step 3.1 treats the one-outcome census design."},
        {"case":"endpoints","status":"not_applicable","reason":"No interval parameter or endpoint appears in the example."},
        {"case":"nonempty-choice","status":"not_applicable","reason":"Both finite designs are fully specified and use no choice principle."},
