    {
      "obligation": "refuter:13:1",
      "id": "ex-skyscraper-sheaf-exact-sequence",
      "location": "Facts & Assumptions [F1]",
      "defect": "false-claim",
      "evidence": "[F1] says that the skyscraper sheaf \"has stalk $A$ at $x$ and stalk $0$ at every other point.\" Let $X=\\{x,y\\}$ have topology $\\{\\varnothing,\\{x\\},X\\}$ and take nonzero $A$. The only open neighbourhood of $y$ is $X$, which contains $x$, so the definition gives $(i_{x,*}A)(X)=A$ and hence $(i_{x,*}A)_y=A$, not $0$. A $T_1$-type hypothesis, or a qualified stalk description, is needed.",
      "severity": "fatal",
      "observed_sha256": "1ac1692059a51ffc6e1008e7b0255b79ce3a006d8d37488cb0a954ad23001135"
    },
    {
      "obligation": "refuter:13:2",
      "id": "lem-pullback-modules-right-exact",
      "location": "Proof step 3.1",
      "defect": "unlicensed-inference",
      "evidence": "Step 3.1 says the stalk formula \"shows that $f^*$ is exact if and only if\" tensoring at each stalk is exact on all $\\mathcal O_{Y,f(x)}$-modules. Step 2.1 only treats stalk sequences arising from sequences of sheaves. For the converse, flatness quantifies over arbitrary stalk modules and needs a realization argument, for example applying exactness of $f^*$ to exact sequences of $\\mathcal O_Y$-module skyscrapers at $f(x)$. That argument is not supplied or cited.",
      "severity": "nonfatal",
      "observed_sha256": "a68756d1c4acab5fbda97a2d8829522e599bde740ba8acc42da83489b5fabe92"
    }
