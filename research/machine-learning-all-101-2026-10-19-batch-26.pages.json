        ],
        "dependency_level": 2
      },
      {
        "id": "thm-pc-oracle-correctness",
        "kind": "theorem",
        "title": "The PC algorithm recovers the oracle CPDAG",
        "strategy": "direct",
        "deps": [
          "def-causal-discovery-oracle-regime",
          "def-cpdag-markov-equivalence-class",
          "alg-pc-causal-discovery",
          "lem-pc-skeleton-separation",
          "lem-pc-separating-set-collider",
          "lem-meek-rules-complete-for-cpdag",
          "thm-dag-factorization-implies-d-separation-conditional-independence",
          "def-faithfulness-of-a-dag-model",
          "def-axiom-of-choice",
          "def-d-separation-in-a-dag"
        ],
        "dependency_level": 3,
        "statement": "Assume AC and the causally sufficient perfect-oracle discovery regime for a\nfinite observed DAG $G$ and its full-joint law. The population PC algorithm\nwith any fixed vertex order terminates and returns exactly the skeleton of $G$\nand records a d-separating set for every deleted pair. At its\ncollider-orientation stage it orients exactly the unshielded colliders of $G$;\nafter R1–R3 closure it returns the CPDAG for the Markov-equivalence class of\n$G$."
      },
