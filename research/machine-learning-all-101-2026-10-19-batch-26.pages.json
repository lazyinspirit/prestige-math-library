          "def-axiom-of-choice"
        ],
        "dependency_level": 1
      },
      {
        "id": "lem-pc-fisher-transform-uniform-concentration",
        "kind": "lemma",
        "title": "Uniform concentration of Gaussian sample partial correlations",
        "strategy": "direct",
        "deps": [
          "def-sample-partial-correlation",
          "def-gaussian-partial-correlation",
          "thm-gaussian-zero-partial-correlation-is-conditional-independence",
          "thm-nondegenerate-multivariate-normal-law-has-density",
          "def-axiom-of-choice",
          "def-multivariate-normal-law"
        ],
        "dependency_level": 2,
        "statement": "Fix $0\\le M<1$. There are constants $c_M>0$ and $C_M<\\infty$ such that the\nfollowing holds. Let $X^{(1)},\\ldots,X^{(n)}$ be independent observations from\na nondegenerate Gaussian law, and let $i,j,S$ be as in the definitions of\npopulation and sample partial correlation. Suppose\n$|\\rho_{ij\\mid S}|\\le M$ and $n-|S|-3>0$. Then, for $0<t\\le1$,\n$$ \\mathbb P\\!\\left(\\left|g(\\widehat\\rho_{ij\\mid S})-g(\\rho_{ij\\mid S})\\right|>t\\right) \\le C_M\\exp\\!\\left(-c_M(n-|S|-1)t^2\\right), $$\nwhere $g(r)=\\tfrac12\\log((1+r)/(1-r))$. The constants do not depend on\n$i,j,S,n$ or the Gaussian mean and covariance beyond the bound $M$."
      },
      {
        "id": "lem-meek-rules-complete-for-cpdag",
        "kind": "lemma",
        "title": "The background-free Meek rules complete a CPDAG",
        "strategy": "direct",
        "deps": [
          "alg-pc-causal-discovery",
          "def-cpdag-markov-equivalence-class",
          "thm-dag-markov-equivalence-skeleton-vstructures",
