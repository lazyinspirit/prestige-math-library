  "load_bearing": [
    {
      "id": "thm-banach-closed-range-theorem",
      "statement": "Assume DC and let T:X→Y be bounded linear between Banach spaces. The following are equivalent: ran T is norm closed; ran T* is norm closed; and dist(x,ker T)≤C‖Tx‖ for all x and some C>0. In that case ran T=⊥(ker T*) and ran T*=(ker T)⊥.",
      "used_by": [
        "thm-bounded-below-iff-transpose-is-surjective",
        "cor-transpose-preserves-invertibility"
      ]
    },
    {
      "id": "thm-bipolar-closure-for-linear-subspaces",
      "statement": "For a normed X and linear N≤X*, (⊥N)⊥=closure(N) in σ(X*,X); for M≤X, ⊥(M⊥)=closure(M) in norm.",
      "used_by": [
        "thm-kernel-range-annihilator-identities"
      ]
    },
    {
      "id": "thm-weak-maximum-principle-for-the-laplacian",
      "statement": "For bounded nonempty open Ω⊆R^n, if u∈C²(Ω)∩C(cl Ω) and Δu≥0, then max_clΩ u=max_∂Ω u; no connectedness or boundary smoothness is required.",
      "used_by": [
        "cor-weak-minimum-principle-for-the-laplacian",
        "thm-comparison-principle-for-classical-subharmonic-functions",
        "thm-hopf-boundary-point-lemma-for-the-laplacian",
        "thm-maximum-principle-with-limsup-control-at-infinity"
      ]
    },
    {
      "id": "thm-harnack-inequality-on-a-ball",
      "statement": "For u≥0 harmonic on B_R(a), u(x)≤(R/(R-|x-a|))^n u(a); it also supplies a uniform two-sided comparison on every concentric smaller closed ball.",
      "used_by": [
        "cor-harnack-inequality-on-compact-subsets",
        "thm-liouville-theorem-for-bounded-harmonic-functions",
        "ex-harnack-constant-from-the-poisson-kernel-ratio"
      ]
    },
    {
      "id": "lem-smooth-sphere-data-have-a-harmonic-replacement",
      "statement": "For smooth real data on ∂B_R(a), the displayed Poisson kernel gives the unique C∞ interior harmonic function continuous on the closed ball with those boundary values; the kernel is positive and has integral one.",
      "used_by": [
        "lem-derivative-estimate-proof-of-one-sided-harmonic-liouville",
        "cor-removable-singularity-for-bounded-harmonic-functions",
        "ex-harnack-constant-from-the-poisson-kernel-ratio"
      ]
    },
    {
      "id": "thm-dual-of-a-closed-subspace-is-a-dual-quotient",
      "statement": "For closed M≤X, restriction induces a linear isometric bijection X*/M⊥→M*; restriction has norm one for nonzero M and zero for M=0.",
      "used_by": [
        "cor-distance-to-annihilator-is-restriction-norm",
        "thm-banach-closed-range-theorem"
      ]
    }
  ],
