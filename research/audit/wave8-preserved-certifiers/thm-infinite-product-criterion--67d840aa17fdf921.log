research/audit/wave8-real-analysis-absolute-convergence.provenance.jsonl:17:{"id":"thm-infinite-product-criterion","statement":"ai-altered","proof":"ai-altered","evidence":"semantic-source","urls":["https://ejwingler.people.ysu.edu/TBB-Real.pdf","https://people.math.binghamton.edu/dikran/478/Ch6.pdf"],"rationale":"Thomson–Bruckner–Bruckner supports the positive product/series criterion, while Binghamton Chapter 6 supplies the logarithmic comparison behind the signed refinement. The item adds quantitative Weierstrass bounds, a (1-p_k) form, and an elementary local proof.","alpha_concurred":false,"at":"2026-08-09"}
