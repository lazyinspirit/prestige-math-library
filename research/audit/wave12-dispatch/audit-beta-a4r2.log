diff --git a/research/audit/wave12-real-analysis.apply-retag.mjs b/research/audit/wave12-real-analysis.apply-retag.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4f9c769abc770fafcbdad58764bb68d43d78f00c
--- /dev/null
+++ b/research/audit/wave12-real-analysis.apply-retag.mjs
@@ -0,0 +1,190 @@
+#!/usr/bin/env node
+// Wave 12 real-analysis A4 bulk provenance/source application.
+//
+// The mathematical determinations come only from the A1 ledger approved in
+// research/audit/wave12-A3.md. This helper edits frontmatter as text so the
+// legacy origin and verification fields stay byte-identical. It is idempotent
+// and supports a read-only --dry-run.
+
+import { existsSync, readFileSync, writeFileSync } from 'node:fs';
+
+const LEDGER = 'research/audit/wave12-real-analysis.provenance.jsonl';
+const MANIFEST = 'research/audit/wave12-real-analysis.pages.json';
+const CONTRACTS = 'research/audit/wave12-real-analysis.proof-contracts.json';
+const dryRun = process.argv.includes('--dry-run');
+const updateContracts = process.argv.includes('--update-contracts');
+
+const TITLES = new Map([
+  ['https://people.eecs.berkeley.edu/~demmel/ma221_Fall10/Lectures/Lecture_03.html',
+    'J. Demmel, MA221 Lecture 3: Vector Norms'],
+  ['https://www.math.uci.edu/~gzitelli/pdf/641/641part1.pdf',
+    'G. Zitelli, Math 641 Functional Analysis, Part I'],
+  ['https://www.jirka.org/ra/html/sec_svthedercont.html',
+    'J. Lebl, Basic Analysis I, Section 8.4'],
+  ['https://www.jirka.org/ra/realanal2-draft-v2.0.pdf',
+    'J. Lebl, Basic Analysis II, draft v2.0'],
+  ['https://arxiv.org/abs/1711.04136',
+    'T. Banakh, A Simple Inductive Proof of the Levy-Steinitz Theorem'],
+  ['https://arxiv.org/abs/2201.05874',
+    'T. Oertel, J. Paat and R. Weismantel, arXiv:2201.05874'],
+  ['https://web.math.princeton.edu/~js129/PDFs/teaching/MAT520_fall_2024/MAT520_Lecture_Notes.pdf',
+    'Princeton MAT520 Functional Analysis Lecture Notes'],
+  ['https://legacy-www.math.harvard.edu/archive/21a_fall_09/exhibits/bitch/index.html',
+    'Harvard Math 21a, separately continuous but not jointly continuous example'],
+  ['https://ramanujan.math.trinity.edu/wtrench/texts/trench_real_analysis.pdf',
+    'W. Trench, Introduction to Real Analysis'],
+  ['https://www.math.ualberta.ca/~xinweiyu/317.Q1.14w/LecNote317-02%20Infinite%20Series%20of%20Functions.pdf',
+    'University of Alberta Math 317, Infinite Series of Functions'],
+  ["https://en.wikipedia.org/wiki/Dini%27s_theorem",
+    "Dini's theorem (Wikipedia)"],
+]);
+
+const yamlQuote = (value) => JSON.stringify(value);
+
+const rows = new Map();
+for (const line of readFileSync(LEDGER, 'utf8').split('\n')) {
+  if (!line.trim()) continue;
+  const row = JSON.parse(line);
+  if (rows.has(row.id)) throw new Error(`duplicate ledger row for ${row.id}`);
+  rows.set(row.id, row);
+}
+
+const pages = JSON.parse(readFileSync(MANIFEST, 'utf8'));
+const scope = pages.flatMap((page) => page.items.map((item) => item.id));
+if (scope.length !== 61 || new Set(scope).size !== 61) {
+  throw new Error(`expected 61 distinct manifest ids, found ${scope.length}/${new Set(scope).size}`);
+}
+if (rows.size !== 61 || scope.some((id) => !rows.has(id)) || [...rows].some(([id]) => !scope.includes(id))) {
+  throw new Error('ledger and manifest scope do not match exactly');
+}
+
+let tagged = 0;
+let urlsAdded = 0;
+let authorshipRemoved = 0;
+let changed = 0;
+const report = [];
+
+for (const id of scope) {
+  const row = rows.get(id);
+  const file = `items/${id}.md`;
+  if (!existsSync(file)) throw new Error(`missing item file ${file}`);
+
+  const original = readFileSync(file, 'utf8');
+  const match = /^(---\n)([\s\S]*?\n)(---\n)([\s\S]*)$/.exec(original);
+  if (!match) throw new Error(`${file}: malformed frontmatter`);
+  const originalOrigin = /^origin:.*$/m.exec(match[2])?.[0];
+  if (!originalOrigin) throw new Error(`${file}: missing origin field`);
+
+  const lines = match[2].split('\n');
+  const changes = [];
+
+  const provenanceAt = lines.findIndex((line) => line === 'provenance:');
+  if (provenanceAt === -1) {
+    const originAt = lines.findIndex((line) => /^origin:/.test(line));
+    lines.splice(originAt + 1, 0,
+      'provenance:',
+      `  statement: ${row.statement}`,
+      `  proof: ${row.proof}`);
+    tagged += 1;
+    changes.push(`provenance ${row.statement}/${row.proof}`);
+  } else {
+    const statement = /^  statement:\s*(\S+)/.exec(lines[provenanceAt + 1] ?? '')?.[1];
+    const proof = /^  proof:\s*(\S+)/.exec(lines[provenanceAt + 2] ?? '')?.[1];
+    if (statement !== row.statement || proof !== row.proof) {
+      throw new Error(`${file}: existing provenance disagrees with the approved ledger`);
+    }
+  }
+
+  for (let i = lines.length - 1; i >= 0; i -= 1) {
+    if (/^authorship:/.test(lines[i])) {
+      lines.splice(i, 1);
+      authorshipRemoved += 1;
+      changes.push('legacy authorship removed');
+    }
+  }
+
+  const refsAt = lines.findIndex((line) => /^  references:\s*$/.test(line));
+  if (refsAt === -1) throw new Error(`${file}: missing block-form sources.references`);
+  let refsEnd = refsAt;
+  while (refsEnd + 1 < lines.length && /^ {4,}\S/.test(lines[refsEnd + 1])) refsEnd += 1;
+
+  const referenceText = lines.slice(refsAt, refsEnd + 1).join('\n');
+  const missingUrls = (row.urls ?? []).filter((url) => !referenceText.includes(url));
+  for (const url of missingUrls) {
+    const title = TITLES.get(url);
+    if (!title) throw new Error(`${file}: no approved display title for ${url}`);
+    lines.splice(refsEnd + 1, 0,
+      `    - title: ${yamlQuote(title)}`,
+      `      url: ${yamlQuote(url)}`);
+    refsEnd += 2;
+  }
+  if (missingUrls.length) {
+    urlsAdded += missingUrls.length;
+    changes.push(`+${missingUrls.length} source URL${missingUrls.length === 1 ? '' : 's'}`);
+  }
+
+  if (!changes.length) continue;
+  const updated = `${match[1]}${lines.join('\n')}${match[3]}${match[4]}`;
+  const updatedOrigin = /^origin:.*$/m.exec(/^(?:---\n)([\s\S]*?\n)(?:---\n)/.exec(updated)?.[1] ?? '')?.[0];
+  if (updatedOrigin !== originalOrigin) throw new Error(`${file}: origin changed unexpectedly`);
+  if (!dryRun) writeFileSync(file, updated);
+  changed += 1;
+  report.push(`${id}: ${changes.join('; ')}`);
+}
+
+for (const line of report) console.log(line);
+console.log(`\n${dryRun ? '[dry run] ' : ''}${changed}/61 items changed; ` +
+  `${tagged} provenance blocks, ${urlsAdded} source URL entries, ${authorshipRemoved} authorship fields removed`);
+
+if (updateContracts) {
+  const ledger = JSON.parse(readFileSync(CONTRACTS, 'utf8'));
+  const count = (selector) => Object.values(ledger.contracts)
+    .flatMap((contract) => selector(contract));
+  const beforeCitations = count((contract) => contract.citations).length;
+  const beforeSteps = count((contract) => [...contract.derivations, ...contract.routine_steps]).length;
+  const beforeBoundaries = count((contract) => contract.boundaries).length;
+  if (Object.keys(ledger.contracts).length !== 48 || beforeCitations !== 681 ||
+      beforeSteps !== 398 || beforeBoundaries !== 384) {
+    throw new Error(`unexpected pre-A4 contract accounting: ` +
+      `${Object.keys(ledger.contracts).length} contracts, ${beforeCitations} citations, ` +
+      `${beforeSteps} steps, ${beforeBoundaries} boundaries`);
+  }
+
+  const removals = new Map([
+    ['thm-cauchy-schwarz-and-the-euclidean-norm',
+      { expected: 2, remove: (citation) => citation.fact === 'L7' }],
+    ['lem-p-norms-are-norms-and-induce-the-published-metrics',
+      { expected: 1, remove: (citation) => citation.fact === 'L7' && citation.source === 'def-complete-ordered-field' }],
+    ['lem-every-norm-on-rn-is-continuous-for-the-euclidean-metric',
+      { expected: 1, remove: (citation) => citation.fact === 'L13' }],
+    ['cor-bolzano-weierstrass-in-rn',
+      { expected: 3, remove: (citation) => citation.fact === 'L7' || citation.fact === 'L8' }],
+    ['cor-vector-valued-ftc-and-lipschitz-bound',
+      { expected: 2, remove: (citation) => citation.fact === 'L7' }],
+    ['cex-the-one-norm-comes-from-no-inner-product',
+      { expected: 2, remove: (citation) => citation.fact === 'L6' }],
+    ['fs-the-rearrangement-sums-of-a-non-absolutely-convergent-series-fill-the-space',
+      { expected: 1, remove: (citation) => citation.fact === 'L5' }],
+    ['fs-componentwise-boundedness-gives-a-convergent-sequence-in-every-dimension',
+      { expected: 2, remove: (citation) => citation.fact === 'L7' }],
+  ]);
+
+  let removed = 0;
+  for (const [id, rule] of removals) {
+    const contract = ledger.contracts[id];
+    if (!contract) throw new Error(`missing proof contract for ${id}`);
+    const selected = contract.citations.filter(rule.remove);
+    if (selected.length !== rule.expected) {
+      throw new Error(`${id}: expected to remove ${rule.expected} citations, found ${selected.length}`);
+    }
+    contract.citations = contract.citations.filter((citation) => !rule.remove(citation));
+    removed += selected.length;
+  }
+  if (removed !== 14) throw new Error(`expected 14 contract citation removals, found ${removed}`);
+
+  const afterCitations = count((contract) => contract.citations).length;
+  if (afterCitations !== 667) throw new Error(`expected 667 final citations, found ${afterCitations}`);
+  if (!dryRun) writeFileSync(CONTRACTS, `${JSON.stringify(ledger, null, 2)}\n`);
+  console.log(`${dryRun ? '[dry run] ' : ''}proof contracts regenerated: ` +
+    `48 contracts, 398 steps, ${afterCitations} citations, 384 boundaries; ${removed} stale citations removed`);
+}

