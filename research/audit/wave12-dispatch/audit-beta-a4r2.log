diff --git a//tmp/wave12-field-classify.mjs b//tmp/wave12-field-classify.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..ae6b28de20a8f5db52365d7dcbad89858929da26
--- /dev/null
+++ b//tmp/wave12-field-classify.mjs
@@ -0,0 +1,50 @@
+import { readFileSync } from 'node:fs';
+
+const path = process.argv[2];
+const before = readFileSync(0, 'utf8');
+const now = readFileSync(path, 'utf8');
+const materialKeys = new Set([
+  'title', 'kind', 'status', 'deps', 'justified_by', 'forward_refs',
+  'external_refs', 'aliases', 'landmark', 'proved_here', 'short',
+  'proof_strategy', 'id',
+]);
+const retagKeys = new Set([
+  'provenance', 'sources', 'authorship', 'verification', 'pipeline_run',
+  'generation',
+]);
+const splitDoc = (text) => {
+  const match = text.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?/);
+  return match
+    ? { fm: match[1], body: text.slice(match[0].length) }
+    : { fm: '', body: text };
+};
+const blocks = (frontmatter) => {
+  const result = new Map();
+  let key = null;
+  let lines = [];
+  for (const line of frontmatter.split('\n')) {
+    const match = line.match(/^([A-Za-z_][\w-]*):(.*)$/);
+    if (match) {
+      if (key !== null) result.set(key, lines.join('\n'));
+      key = match[1];
+      lines = [match[2]];
+    } else if (key !== null) {
+      lines.push(line);
+    }
+  }
+  if (key !== null) result.set(key, lines.join('\n'));
+  return result;
+};
+
+const a = splitDoc(before);
+const b = splitDoc(now);
+const reasons = [];
+if (a.body !== b.body) reasons.push('body text');
+const aBlocks = blocks(a.fm);
+const bBlocks = blocks(b.fm);
+for (const key of new Set([...aBlocks.keys(), ...bBlocks.keys()])) {
+  if ((aBlocks.get(key) ?? null) === (bBlocks.get(key) ?? null)) continue;
+  if (materialKeys.has(key)) reasons.push(key);
+  else if (!retagKeys.has(key)) reasons.push(`${key} (unclassified)`);
+}
+console.log(JSON.stringify({ path, classification: reasons.length ? 'material' : 'pure', reasons }));
diff --git a//tmp/wave12-frontmatter-invariants.mjs b//tmp/wave12-frontmatter-invariants.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4e86bcd70510bcba33285013492ea4b04819d9d4
--- /dev/null
+++ b//tmp/wave12-frontmatter-invariants.mjs
@@ -0,0 +1,84 @@
+import { readFileSync } from 'node:fs';
+
+const path = process.argv[2];
+const id = path.replace(/^items\//, '').replace(/\.md$/, '');
+const before = readFileSync(0, 'utf8');
+const now = readFileSync(path, 'utf8');
+const ledger = new Map(
+  readFileSync('research/audit/wave12-real-analysis.provenance.jsonl', 'utf8')
+    .trim().split('\n').filter(Boolean).map((line) => {
+      const row = JSON.parse(line);
+      return [row.id, row];
+    }),
+);
+const material = new Set([
+  'thm-cauchy-schwarz-and-the-euclidean-norm',
+  'lem-p-norms-are-norms-and-induce-the-published-metrics',
+  'lem-every-norm-on-rn-is-continuous-for-the-euclidean-metric',
+  'cor-bolzano-weierstrass-in-rn',
+  'cor-vector-valued-ftc-and-lipschitz-bound',
+  'cex-the-one-norm-comes-from-no-inner-product',
+  'fs-the-rearrangement-sums-of-a-non-absolutely-convergent-series-fill-the-space',
+  'fs-componentwise-boundedness-gives-a-convergent-sequence-in-every-dimension',
+]);
+const split = (text) => {
+  const match = text.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?/);
+  if (!match) throw new Error(`no frontmatter: ${path}`);
+  return { fm: match[1], body: text.slice(match[0].length) };
+};
+const blocks = (fm) => {
+  const result = new Map();
+  let key = null;
+  let lines = [];
+  for (const line of fm.split('\n')) {
+    const match = line.match(/^([A-Za-z_][\w-]*):(.*)$/);
+    if (match) {
+      if (key !== null) result.set(key, lines.join('\n'));
+      key = match[1];
+      lines = [match[2]];
+    } else if (key !== null) lines.push(line);
+  }
+  if (key !== null) result.set(key, lines.join('\n'));
+  return result;
+};
+const list = (block = '') => {
+  const bracket = block.match(/^\s*\[([^\]]*)\]/);
+  if (bracket) return bracket[1].split(',').map((x) => x.trim().replace(/^['"]|['"]$/g, '')).filter(Boolean);
+  return block.split('\n').map((line) => line.match(/^\s*-\s+([^#]+?)(?:\s+#.*)?$/)?.[1]?.trim().replace(/^['"]|['"]$/g, '')).filter(Boolean);
+};
+const nested = (block, key) => block?.match(new RegExp(`^\\s+${key}:\\s*([^\\n]+)$`, 'm'))?.[1]?.trim().replace(/^['"]|['"]$/g, '') ?? null;
+const a = split(before);
+const b = split(now);
+const ab = blocks(a.fm);
+const bb = blocks(b.fm);
+const row = ledger.get(id);
+const errors = [];
+if (!row) errors.push('ledger row missing');
+if (ab.get('origin') !== bb.get('origin')) errors.push('origin changed');
+if (bb.has('authorship')) errors.push('legacy authorship retained');
+if (row) {
+  for (const key of ['statement', 'proof']) {
+    if (nested(bb.get('provenance'), key) !== row[key]) errors.push(`provenance.${key} mismatch`);
+  }
+  const sourceBlock = bb.get('sources') ?? '';
+  for (const url of row.urls) if (!sourceBlock.includes(`url: "${url}"`) && !sourceBlock.includes(`url: '${url}'`) && !sourceBlock.includes(`url: ${url}`)) errors.push(`source URL missing: ${url}`);
+}
+if (material.has(id)) {
+  if (bb.get('verification') !== '\n  precheck: pass') errors.push('material verification is not precheck-only');
+} else {
+  if (ab.get('verification') !== bb.get('verification')) errors.push('pure-retag verification changed');
+  if (a.body !== b.body) errors.push('pure-retag body changed');
+}
+const oldDeps = list(ab.get('deps'));
+const newDeps = list(bb.get('deps'));
+console.log(JSON.stringify({
+  id,
+  material: material.has(id),
+  errors,
+  urls: row?.urls.length ?? 0,
+  removedDeps: oldDeps.filter((x) => !newDeps.includes(x)),
+  addedDeps: newDeps.filter((x) => !oldDeps.includes(x)),
+  statement: row?.statement,
+  proof: row?.proof,
+  evidence: row?.evidence,
+}));
