  precheck: pass
sources:
  scraped: []
  references:
    - title: "Stephen Abbott, Understanding Analysis, 2nd ed., Exercise 2.3.13"
      url: "https://link.springer.com/chapter/10.1007/978-1-4939-2712-8_2"
pipeline_run: null
