research/audit/wave12-refuter-tasks/cex-dini-needs-a-continuous-limit.md-102-  "citations": [
research/audit/wave12-refuter-tasks/cex-dini-needs-a-continuous-limit.md-103-    {
research/audit/wave12-refuter-tasks/cex-dini-needs-a-continuous-limit.md-104-      "fact": "L1",
research/audit/wave12-refuter-tasks/cex-dini-needs-a-continuous-limit.md:105:      "source": "cex-powers-on-the-unit-interval-converge-pointwise-not-uniformly",
research/audit/wave12-refuter-tasks/cex-dini-needs-a-continuous-limit.md-106-      "source_section": "Statement refuted",
research/audit/wave12-refuter-tasks/cex-dini-needs-a-continuous-limit.md-107-      "quote": "**Refuted claim:** pointwise convergence of real-valued functions on a closed bounded interval implies uniform convergence. For $k\\in\\mathbb{N}$ define $f_k:[0,1]\\to\\mathbb{R}$ by $$f_k(x):=x^{k+1}.$$ Then $(f_k)$ converges pointwise to the endpoint indicator $$\\chi(x):=\\begin{cases}0,&0\\le x<1,\\\\1,&x=1,\\end{cases}$$ but the convergence is not uniform.",
research/audit/wave12-refuter-tasks/cex-dini-needs-a-continuous-limit.md-108-      "quote_selection": "full-source-section",
