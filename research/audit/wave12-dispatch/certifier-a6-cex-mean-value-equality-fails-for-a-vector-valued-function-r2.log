tools/item-hash.mjs-3-//
tools/item-hash.mjs-4-// WHY THIS IS SHARED. Two mechanisms have to answer the same question — "did the
tools/item-hash.mjs-5-// mathematics of this item change?" — and they must never disagree:
tools/item-hash.mjs-6-//
tools/item-hash.mjs-7-//   tools/touchlog.mjs     counts repairs per item across a level's stages, which
tools/item-hash.mjs-8-//                          drives the twice-touched escalation.
tools/item-hash.mjs-9-//   tools/step8-guard.mjs  enforces R1: a rejection Alpha classified nonfatal or a
tools/item-hash.mjs-10-//                          false positive closes WITHOUT a content edit.
tools/item-hash.mjs-11-//
tools/item-hash.mjs-12-// A second, cruder copy of this normalization is exactly the bug this file exists
--
tools/item-hash.mjs-26-import { createHash } from "node:crypto";
tools/item-hash.mjs-27-
tools/item-hash.mjs-28-/** Strip only the `verification:` frontmatter block; leave all mathematics. */
tools/item-hash.mjs-29-export const stripVerification = (text) => {
tools/item-hash.mjs-30-  const m = /^---\n([\s\S]*?)\n---\n([\s\S]*)$/.exec(text);
tools/item-hash.mjs-31-  if (!m) return text;                              // no frontmatter: hash as-is
tools/item-hash.mjs-32-  const fm = m[1].replace(/^verification:(?:\n(?:[ \t]+.*\n?)*|[^\n]*\n?)/m, "");
tools/item-hash.mjs-33-  return fm + "\n---\n" + m[2];
tools/item-hash.mjs-34-};
tools/item-hash.mjs-35-
tools/item-hash.mjs:36:/** Full sha256 of the normalized item text. */
tools/item-hash.mjs-37-export const itemContentHash = (text) =>
tools/item-hash.mjs-38-  createHash("sha256").update(stripVerification(text)).digest("hex");
tools/item-hash.mjs-39-
tools/item-hash.mjs-40-// touchlog snapshots store a 16-hex prefix per item; an adjudication row records
tools/item-hash.mjs-41-// the full digest, matching the "item SHA-256" language used for the audit
tools/item-hash.mjs-42-// workflow's targeted rejudge receipt. Compare through `shortHash` so the two
tools/item-hash.mjs-43-// representations can never disagree by length alone.
tools/item-hash.mjs-44-export const SHORT_HASH_LENGTH = 16;
tools/item-hash.mjs-45-export const shortHash = (hex) => hex.slice(0, SHORT_HASH_LENGTH);
