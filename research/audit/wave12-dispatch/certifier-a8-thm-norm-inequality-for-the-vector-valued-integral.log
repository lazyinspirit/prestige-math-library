./research/audit/wave11-dispatch/audit-beta-a1a2.log:40998:+     "quote": "([[def-continuity-real]], [[def-classification-of-discontinuities]]) is at most\ncountable ([[def-countable]]), then $f$ is Riemann integrable on $[a,b]$\n([[def-darboux-integral]]).",
./research/audit/wave11-dispatch/audit-beta-a1a2.log:41014:+     "source": "def-darboux-integral",
