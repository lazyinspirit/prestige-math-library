/bin/bash -lc "for f in items/def-lipschitz-holder-contraction.md items/def-norm-and-normed-space.md items/def-p-norms-on-rn.md items/lem-p-norms-are-norms-and-induce-the-published-metrics.md items/lem-metrics-on-rn.md items/lem-real-line-is-a-metric-space.md items/lem-of-abs-value.md; do awk 'FNR==1 {print \"\\nFILE: \" FILENAME} /"'^## (Statement|Definition)$/ {show=1} /''^## Facts & Assumptions$/ {show=0} show {print}'"' \""'$f"; done' in /home/lazyinspirit/Projects/prestige-math-library
