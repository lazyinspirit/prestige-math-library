research/audit/wave9-real-analysis.provenance.jsonl:42:{"id":"cex-upper-semicontinuous-need-not-attain-its-infimum","statement":"ai-altered","proof":"ai-generated","evidence":"semantic-source","urls":["https://en.wikipedia.org/wiki/Semi-continuity"],"rationale":"The source states the one-sided compactness theorem: upper semicontinuity guarantees a maximum, not a minimum. The item supplies a simple explicit counterexample to the reversed extremum.","alpha_concurred":false,"at":"2026-08-09"}
