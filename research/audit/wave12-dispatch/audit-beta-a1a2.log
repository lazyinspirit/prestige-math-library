research/audit/wave9-real-analysis.provenance.jsonl:33:{"id":"ex-thomae-values-and-oscillation-computed","statement":"ai-altered","proof":"ai-altered","evidence":"semantic-source","urls":["https://en.wikipedia.org/wiki/Thomae%27s_function","https://mathworld.wolfram.com/DirichletFunction.html"],"rationale":"The sources give Thomae’s values and continuity behaviour; the exact oscillation computation 1/q and the bounded-range clauses are a locally expanded semantic version.","alpha_concurred":false,"at":"2026-08-09"}
