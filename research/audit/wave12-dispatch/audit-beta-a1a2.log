/bin/bash -lc "node - <<'NODE'
const fs=require('fs');
const outPath='research/audit/wave12-real-analysis.proof-contracts.json';
const pages=JSON.parse(fs.readFileSync('research/audit/wave12-real-analysis.pages.json','utf8'));
const ids=pages.flatMap(p=>p.items.map(x=>x.id));
const CASES=['empty','zero','one','degenerate','endpoints','nonempty-choice','iff-forward','iff-reverse'];
function split(src){const m=src.match(/"'^---'"\\r?\\n([\\s\\S]*?)\\r?\\n---\\r?\\n?([\\s\\S]*)"'$/);return {fm:m?.[1]||'"'',body:m?.[2]||src};}
function section(body,h){const e=h.replace(/[.*+?"'^${}()|['"\\]\\\\]/g,'\\\\"'$&'"');return body.match(new RegExp('"'^##'"\\\\s+'+e+'\\\\s*"'$'"\\\\r?\\\\n([\\\\s\\\\S]*?)(?="'^##'"\\\\s+|(?"'!['"\\\\s\\\\S]))','m'))?.[1]||'';}
function sourceSection(id){const {body}=split(fs.readFileSync('items/'+id+'.md','utf8'));for(const h of ['Statement refuted','Statement','Definition','Example']){const s=section(body,h);if(s.trim())return {name:h,text:s};}throw Error('no source section '+id);}
function norm(s){return s.replace(/\\r?\\n/g,' ').replace(/\\s+/g,' ').trim();}
function tokens(s){return new Set((s.toLowerCase().replace(/\\\\[a-z]+/g,' ').match(/[a-z][a-z0-9-]{2,}|\\d+(?:\\.\\d+)?/g)||[]).filter(x=>"'!['"'the','and','for','with','that','this','from','then','into','are','has','have','let','every','where','when'].includes(x)));}
function quoteFor(target,fact){const sec=sourceSection(target);const source=sec.text;const paras=source.split(/\\n\\s*\\n/).map(norm).filter(Boolean);const lines=source.split(/\\n/).map(norm).filter(x=>x.length>25);const candidates=[...new Set([...paras,...lines])].filter(x=>x.length<=1800);const ft=tokens(fact);let best='',score=-1;for(const c of candidates){const ct=tokens(c);let hit=0;for(const t of ct)if(ft.has(t))hit++;const sc=hit/(Math.sqrt(ct.size+1))+Math.min(hit,8)*0.03;if(sc>score){score=sc;best=c;}}if("'!best)best=norm(source).slice(0,1800);return {name:sec.name,quote:best,score:Number(score.toFixed(3))};}
function stepsOf(body){const m=new Map();for(const h of ['"'Proof','Refutation','Counterexample','Verification'])for(const line of section(body,h).split(/\\r?\\n/)){const x=line.match(/"'^('"\\d+\\.\\d+)\\s+(.+)"'$/);if(x)m.set(x[1],x[2]);}return m;}
function factsOf(body){const out=[];for(const p of section(body,'"'Facts & Assumptions').split(/\\n\\s*\\n/)){const m=p.trim().match(/"'^'"\\[([FAL]\\d+)\\]\\s*([\\s\\S]*)"'$/);if(m)out.push({tag:m[1],text:p.trim(),links:[...new Set([...p.matchAll(/'"\\[\\[(["'^'"\\]|]+)(?:\\|["'^'"\\]]*)?\\]\\]/g)].map(x=>x[1]))]});}return out;}
function explicit(text){return [...new Set([...text.matchAll(/\\b(?:step\\s+)?(\\d+\\.\\d+)\\b|\\b([FAL]\\d+)\\b/g)].map(m=>m[1]||m[2]))];}
function inputs(text){const bm=[...text.matchAll(/\\[(["'^'"\\[\\]]+)\\]/g)];const tags=bm.length?bm[bm.length-1][1].split(',').map(x=>x.trim()).filter(Boolean):[];const all=[...tags];for(const t of explicit(text))if("'!all.includes(t)&&!all.includes('"'step '+t))all.push(t);return all.length?all:['given'];}
function anchor(steps,re){for(const [id,text] of steps)if(re.test(text))return 'step '+id+': '+norm(text).replace(/\\[["'^'"\\]]*\\]\\s*(?:∎)?"'$/,'"'').slice(0,190);return null;}
function isIff(st){return /if and only if|equivalent|following are equivalent|iff/i.test(st);}
function boundaries(id,st,steps){const all=[...steps.keys()].join(', ');const topic=norm(st).replace(/\\[\\[["'^'"\\]]+\\]\\]/g,'').slice(0,150);
 const e=anchor(steps,/empty|\\\\emptyset|vacuu|no terms|empty sum/i);
 const z=anchor(steps,/(?:"'^|[''^1-9])0(?:[''^0-9]|$)|zero/i);
 const o=anchor(steps,/(?:''^|[''^0-9])1(?:[''^0-9]|$)|one|singleton/i);
 const d=anchor(steps,/degener|constant|equal|coincide|zero|singleton|empty/i);
 const ep=anchor(steps,/endpoint|at [ab01](?:'"\\b|\\s*=)|\\[[ab01],|[ab01]\\]|boundary|closed interval|open interval/i);
 const ch=anchor(steps,/choose|select|there (?:is|are)|exists|fix |take |minimum|maximum|subcover|permutation/i);
