    zero: ['n', 'no index runs from zero'],
    one: ['c', 'step 1.1 and Remark 1: the Lipschitz constant is fixed at $1$ throughout, which is the hypothesis doing the work'],
    degenerate: ['c', 'step 3.1: the constant functions are the degenerate members, with $|c(x)-c(x\')| = 0$, and they are exactly what defeats pointwise boundedness'],
    endpoints: ['n', 'no order, interval or radius parameter occurs'],
    'nonempty-choice': ['c', 'no selection: step 1.1 sets $\\delta := \\varepsilon$ by formula'],
    'iff-forward': ['n', 'the three claims are separate assertions, not biconditionals'],
    'iff-reverse': ['n', 'the three claims are separate assertions, not biconditionals'],
  },
  'cex-pointwise-bounded-but-not-equicontinuous': {
    empty: ['n', '$I = [0,1]$ is nonempty by construction'],
    zero: ['c', 'step 2.1: the failure point is $0$, with $f_k(0) = 0$ and $f_k(a_k) = 1$'],
    one: ['c', 'step 2.1: the gap $|f_k(a_k) - f_k(0)| = 1$ exceeds $\\varepsilon = 1/2$'],
    degenerate: ['c', 'step 1.1: the values lie in $[0,1] \\subseteq B(0,2)$, so pointwise boundedness holds with a single ball at every point'],
    endpoints: ['c', 'step 2.1 and Remark 2: equicontinuity does hold at every $t > 0$; only the left endpoint $0$ fails, and that is enough'],
    'nonempty-choice': ['c', 'step 1.3 instantiates one $m$ per $\\delta$; the family is given by a formula'],
    'iff-forward': ['n', 'the refuted claim is an implication, refuted by one witness'],
    'iff-reverse': ['n', 'the refuted claim is an implication; the converse failure is the companion example, cited not reproved'],
  },
  'cex-the-pointwise-limit-of-continuous-functions-need-not-be-continuous': {
    empty: ['n', '$I = [0,1]$ is nonempty by construction'],
    zero: ['c', 'step 1.1 and [L1]: $k = 0$ is admitted, $a_0 = 1/\\iota(2) = 1/2$ and $1 - a_0 = 1/2$, both inside $I$'],
    one: ['c', 'steps 1.2 and 1.4: $r_k(1) = 1 = \\chi(1)$ is the single point at which the limit jumps'],
    degenerate: ['c', 'step 1.1: $0 < 1 - a_k < 1$, so both closed pieces are nondegenerate and genuinely cover $I$'],
    endpoints: ['c', 'step 1.1 checks the overlap endpoint $t = 1 - a_k$; step 1.4 works at the right endpoint $t = 1$, where the discontinuity sits'],
    'nonempty-choice': ['c', 'step 1.3 instantiates one $m$ per point; the ramps are given by a formula'],
    'iff-forward': ['n', 'the refuted claim is an implication, refuted by one witness'],
    'iff-reverse': ['n', 'the refuted claim is an implication; the surviving uniform statement is cited, not reproved'],
  },
  'ex-the-exponential-law-worked-on-the-line': {
    empty: ['n', 'all three spaces are $\\mathbb{R}$, nonempty by construction'],
    zero: ['c', 'step 1.1: the denominator $|x_0| + |z_0| + 1$ is at least $1$, so $\\delta$ is defined even at $x_0 = z_0 = 0$; and $F(0)$ is the zero map, a legitimate member'],
    one: ['c', 'step 1.1: $\\delta \\le 1$ is imposed so that the cross term $(|z_0| + \\delta)\\delta$ is bounded by $(|x_0| + |z_0| + 1)\\delta$'],
    degenerate: ['c', 'step 1.2: for $z = 0$ the transpose $F(0)$ is the constant zero map, Lipschitz with constant $0$, and [L4] still applies'],
    endpoints: ['c', 'step 2.2: the bound $|x| \\le \\iota(m)$ is used at the endpoints of $[-m,m]$, where it is attained'],
    'nonempty-choice': ['c', 'steps 1.1, 1.3 and 1.4 instantiate one $\\delta$, one pair $(K,\\varepsilon)$ and one $m$; nothing is selected over a family'],
    'iff-forward': ['c', 'step 6.1: $\\Phi$ sends the $f$ of claim 1 to the $F$ of claim 3'],
    'iff-reverse': ['c', 'step 6.1: the inverse sends $F$ back to $(x,z) \\mapsto F(z)(x) = xz$'],
  },
  'ex-dini-on-the-unit-interval': {
    empty: ['n', '$I = [0,1]$ is nonempty by construction, which is what Dini needs of the compact domain'],
    zero: ['c', 'step 1.1 and [L1]: $k = 0$ is admitted, $a_0 = 1/2$ and $s_0(t) = \\min\\{t, 1/2\\}$, a legitimate first term'],
    one: ['c', 'step 2.2: the discrepancy $t - s_k(t)$ is bounded by $a_k$, and at $t = 1$ it equals $a_k$ exactly'],
    degenerate: ['c', 'step 1.1: $0 < 1 - a_k < 1$, so both closed pieces are nondegenerate'],
    endpoints: ['c', 'step 2.2: the maximum discrepancy occurs at the right endpoint $t = 1$, and step 1.1 checks the overlap endpoint $t = 1 - a_k$'],
