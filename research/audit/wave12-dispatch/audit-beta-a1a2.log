// Generator for research/audit/wave5-topology-function-spaces.proof-contracts.json
// (Audit-Beta, wave 5, topology-function-spaces batch, step A2 / owner decision D1.)
//
// Mechanical parts, derived from the item files so they cannot drift:
//   - citations[]  : one entry per distinct wikilink in each [F#]/[A#]/[L#] fact,
//                    with `uses` = every numbered step whose tag list cites that fact.
//   - derivations[]: one entry per numbered step, exactly once, `inputs` taken
//                    verbatim from that step's own bracketed tag list.
// Hand-authored parts, supplied in the tables below:
//   - quote        : the exact clause of the cited item that licenses the fact.
//                    QUOTES[target] is the canonical clause where a target is cited
//                    for one and the same proposition throughout; QUOTE_OVERRIDE
//                    handles the targets cited for different clauses in different facts.
//                    Anything not covered is selected by best token overlap against the
//                    fact text and is emitted with `quote_selection: "overlap"` so the
//                    reviewer can see which quotes were not hand-anchored.
//   - boundaries[] : the eight-case worksheet of QUALITY-CONTROLS.md, per item.
// Every emitted quote is checked to be an exact substring of the cited item's
// Statement / Statement refuted / Definition / Example section; a miss is reported.

import fs from 'fs';

const IDS = fs.readFileSync('/tmp/fs-ids.txt', 'utf8').trim().split('\n');
const SECTION_RE = /##\s+(Statement refuted|Statement|Definition|Example)\b[\s\S]*?(?=\n##\s|$)/;

function sectionOf(id) {
  const t = fs.readFileSync(`items/${id}.md`, 'utf8');
  const body = t.split(/\n---\n/).slice(1).join('\n---\n');
  const m = body.match(SECTION_RE);
  return { name: m ? m[1] : 'Statement', text: (m ? m[0] : body).replace(/\s+/g, ' ').trim() };
}

// Canonical licensing clause per cited target, verified against the target on disk.
