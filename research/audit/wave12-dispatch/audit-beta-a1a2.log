const CASES = ['empty', 'zero', 'one', 'degenerate', 'endpoints', 'nonempty-choice', 'iff-forward', 'iff-reverse'];

function overlapQuote(sectionText, factText) {
  const sentences = sectionText.split(/(?<=[.;:])\s+/).filter(s => s.length > 25 && s.length < 320);
  if (!sentences.length) return null;
  const toks = new Set(factText.toLowerCase().match(/[a-z]{4,}/g) || []);
  let best = null, bestScore = -1;
  for (const s of sentences) {
    const st = new Set(s.toLowerCase().match(/[a-z]{4,}/g) || []);
    let hit = 0; for (const t of st) if (toks.has(t)) hit++;
    const score = hit / Math.sqrt(st.size + 1);
    if (score > bestScore) { bestScore = score; best = s; }
  }
  return best;
}

const contracts = {};
const scope = [];
const problems = [];
const sectionCache = {};

for (const id of IDS) {
  const t = fs.readFileSync(`items/${id}.md`, 'utf8');
  const body = t.split(/\n---\n/).slice(1).join('\n---\n');
  const facts = [...body.matchAll(/^\[(A\d+|L\d+|F\d+)\]([\s\S]*?)(?=\n\[(?:A|L|F)\d+\]|\n##\s)/gm)];
  const steps = [...body.matchAll(/^(\d+\.\d+)\s([\s\S]*?)\[([^\]]*)\]\s*(?:∎)?\s*$/gm)];
  if (!steps.length) continue;
  scope.push(id);

  const uses = {};
  for (const f of facts) uses[f[1]] = [];
  for (const s of steps) for (const tg of s[3].split(',').map(x => x.trim())) if (uses[tg]) uses[tg].push(s[1]);

  const citations = [];
  for (const f of facts) {
    const tag = f[1], factText = f[2];
    for (const target of new Set([...factText.matchAll(/\[\[([^\]]+)\]\]/g)].map(m => m[1]))) {
      if (!sectionCache[target]) sectionCache[target] = sectionOf(target);
      const sec = sectionCache[target];
      const key = `${id}|${tag}|${target}`;
      let quote = QUOTE_OVERRIDE[key] ?? QUOTES[target] ?? null;
      let selection = QUOTE_OVERRIDE[key] ? 'override' : (QUOTES[target] ? 'canonical' : 'overlap');
      const flat = q => q.replace(/\s+/g, ' ').trim();
      if (quote && !sec.text.includes(flat(quote))) { problems.push(`${key}: canonical quote absent from ${target} ${sec.name}`); quote = null; selection = 'overlap'; }
      if (!quote) { quote = overlapQuote(sec.text, factText); if (quote && !sec.text.includes(quote)) quote = null; }
      if (!quote) { problems.push(`${key}: NO QUOTE`); quote = ''; selection = 'missing'; }
      citations.push({ fact: tag, source: target, source_section: sec.name, quote: flat(quote), quote_selection: selection, uses: uses[tag] });
    }
  }

  // inputs = the step's own bracketed tag list, PLUS any earlier step its prose
  // names but the bracket omits. The omissions are recorded as finding N6: they
  // are always transitively present through a bracketed step, so they are a
  // nonfatal tag quirk, but the contract's input map must be the true one.
  const derivations = steps.map(s => {
    const tagged = s[3].split(',').map(x => x.trim());
    const prose = [...s[2].matchAll(/\bstep(?:s)?\s+(\d+\.\d+)(?:\s+and\s+(\d+\.\d+))?/g)]
      .flatMap(m => [m[1], m[2]]).filter(Boolean).map(x => `step ${x}`);
    const inputs = [...new Set([...tagged, ...prose.filter(p => p !== `step ${s[1]}`)])];
    return { id: `step-${s[1]}`, claim: s[2].replace(/\s+/g, ' ').trim().slice(0, 200), step: s[1], inputs };
  });

  const bt = B[id];
  if (!bt) problems.push(`${id}: NO BOUNDARY TABLE`);
  const boundaries = CASES.map(c => {
    const e = bt && bt[c];
    if (!e) return { case: c, status: 'checked', evidence: 'MISSING' };
    return e[0] === 'c'
      ? { case: c, status: 'checked', evidence: e[1] }
      : { case: c, status: 'not_applicable', reason: e[1] };
  });

  contracts[id] = {
    citations,
    derivations,
    routine_steps: [],
    boundaries,
    finite_smoke: [],
    risk_review: { status: 'pending', reviewer: 'Alpha', notes: 'Audit-Beta captured the contract at A2; Alpha routes high/critical items to a proof-refuter at A5/A6.' },
  };
}

const out = { version: 1, level: 'audit-wave5-topology-function-spaces', scope, contracts };
fs.writeFileSync('research/audit/wave5-topology-function-spaces.proof-contracts.json', JSON.stringify(out, null, 1) + '\n');

const totalCit = scope.reduce((n, id) => n + contracts[id].citations.length, 0);
const bySel = {};
for (const id of scope) for (const c of contracts[id].citations) bySel[c.quote_selection] = (bySel[c.quote_selection] || 0) + 1;
console.log(`items=${scope.length} citations=${totalCit} steps=${scope.reduce((n, id) => n + contracts[id].derivations.length, 0)}`);
console.log('quote_selection:', JSON.stringify(bySel));
console.log(problems.length ? 'PROBLEMS:\n' + problems.join('\n') : 'no problems');

