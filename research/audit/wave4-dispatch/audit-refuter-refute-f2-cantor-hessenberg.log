    32	      url: "https://people.math.harvard.edu/~wboney/fall16/settheory.pdf"
    33	    - title: "Cardinal number — cardinal arithmetic (Wikipedia)"
    34	      url: "https://en.wikipedia.org/wiki/Cardinal_number#Cardinal_arithmetic"
    35	    - title: "Aleph number (Wikipedia)"
    36	      url: "https://en.wikipedia.org/wiki/Aleph_number"
