     2	id: thm-alexander-subbase-lemma
     3	kind: theorem
     4	title: "Alexander's subbase lemma: if every cover by members of a fixed subbasis has a finite subcover then the space is compact; the proof is an application of Zorn's lemma"
     5	status: published
     6	origin: session
     7	deps: [def-compact-space, def-topology-basis-subbasis, thm-basis-criterion, thm-zorn, cor-ac-iff-zorn, def-axiom-of-choice, def-chain, def-maximal-element, def-partial-order, def-upper-bound, def-topological-space, lem-finite-choice, thm-induction-principle]
