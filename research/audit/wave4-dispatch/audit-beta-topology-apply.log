     1	---
     2	id: thm-baire-category-locally-compact-hausdorff
     3	kind: theorem
     4	title: "Assuming dependent choice, every locally compact Hausdorff space is a Baire space"
     5	status: published
     6	origin: session
     7	deps: [lem-dependent-choice-along-a-sequence-of-relations, def-baire-space, def-compact-space, thm-compact-iff-fip, thm-compact-subset-of-a-hausdorff-space-is-closed, def-locally-compact-space, thm-locally-compact-hausdorff-basics, def-hausdorff-space, def-dense-top, def-interior-closure-boundary-top, def-topological-space, def-subspace-topology-top, def-dependent-choice, def-sequence, def-natural-numbers]
     8	justified_by: []
     9	external_refs: [rem-baire-category-choice-strength]
    10	aliases: [thm-baire-category-lch]
    11	landmark: true
    12	short: "Baire category for locally compact Hausdorff"
    13	proof_strategy: direct
    14	verification:
    15	  precheck: pass
    16	  verified:
    17	    model: claude-fable-5
    18	    verdict: certify
    19	    date: 2026-07-29
    20	    scope: page
    21	    delegated_by: owner
    22	  judge:
    23	    model: z-ai/glm-5.2
