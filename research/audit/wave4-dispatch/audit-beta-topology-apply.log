    28	    - title: "Alexander subbase theorem (Wikipedia)"
    29	      url: "https://en.wikipedia.org/wiki/Alexander_subbase_theorem"
    30	    - title: "Zorn's lemma (Wikipedia)"
    31	      url: "https://en.wikipedia.org/wiki/Zorn%27s_lemma"
