}
const changed=execFileSync('"'git',['diff','--name-only','6c54914','--',...ids.map(id=>"'`items/${id}.md`),'"'library/topology/compactness.md'],{encoding:'utf8'}).trim().split(/\\n/).filter(Boolean);
const expected=new Set([...ids.map(id=>"'`items/${id}.md`),'"'library/topology/compactness.md']);
for (const p of changed) if ("'!expected.has(p)) problems.push(`unexpected scoped change ${p}`);
for (const p of expected) if (!changed.includes(p)) problems.push(`missing scoped change ${p}`);
console.log(JSON.stringify({manifestItems:ids.length,ledgerRows:rows.length,materialItems:material.size,pureRetags:ids.length-material.size,scopedChangedFiles:changed.length,problems},null,2));
