  }
  if (url.startsWith('https://en.wikipedia.org/wiki/')) {
    const slug = decodeURIComponent(url.split('/wiki/')[1]).replaceAll('_', ' ');
    return slug + ' (Wikipedia)';
  }
  throw new Error('No title mapping for ' + url);
}
let patch = '*** Begin Patch\\n';
let count = 0;
for (const row of rows) {
  if (material.has(row.id)) continue;
  const path = 'items/' + row.id + '.md';
