    26	  scraped: []
    27	  references:
    28	    - title: "Compact space (Wikipedia)"
    29	      url: "https://en.wikipedia.org/wiki/Compact_space"
    30	    - title: "Subspace topology (Wikipedia)"
    31	      url: "https://en.wikipedia.org/wiki/Subspace_topology"
