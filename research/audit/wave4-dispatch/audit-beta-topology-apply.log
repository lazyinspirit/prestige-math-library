 if (/'"\\nauthorship:/.test(text)) problems.push("'`${id}: legacy authorship`);
 for (const url of row?.urls||[]) if (!text.includes(`url: '"\\\""'${url}'"\\\""'`) && !text.includes(`url: '"'"'${url}'"'"'`) && !text.includes(`url: ${url}`)) problems.push(`${id}: source missing ${url}`);
