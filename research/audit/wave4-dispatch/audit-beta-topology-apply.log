const rows=fs.readFileSync('research/audit/wave4-topology.provenance.jsonl','utf8').trim().split(/\\n/).map(JSON.parse);
const byId=new Map(rows.map(x=>[x.id,x]));
const problems=[];
for (const id of ids) {
 const text=fs.readFileSync("'`items/${id}.md`,'"'utf8');
 const row=byId.get(id);
 if ("'!row) problems.push(`${id}: missing ledger row`);
