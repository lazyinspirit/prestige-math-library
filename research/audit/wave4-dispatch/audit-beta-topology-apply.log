/bin/bash -lc "node <<'NODE'
const fs = require('fs');
const input = 'research/audit/wave4-topology.proof-contracts.json';
const data = JSON.parse(fs.readFileSync(input, 'utf8'));
const oldText = 'the ambient reading without citing it. Taking the intrinsic reading as the\\ndefinition is what makes \"compact\" a property of the space "'$(A, '"\\\\mathcal{T}_A)"'$'"\\nalone, so that a set compact in one ambient space is compact in every other one\\nin which it sits as a subspace. This is exactly the convention already fixed for';
const newText = 'the ambient reading without citing it. Taking the intrinsic reading makes\\ncompactness a property of the topological space "'$(A, '"\\\\mathcal{T}_A)"'$ alone.'"\\nHence it is preserved when "'$A$ is embedded homeomorphically as a subspace, or'"\\nwhen another ambient space induces the same topology on "'$A$; it need not be'"\\npreserved if the induced topology changes. This is exactly the convention already fixed for';
let compactCount = 0;
let sequenceCount = 0;
for (const [id, contract] of Object.entries(data.contracts)) {
  for (const citation of contract.citations) {
    if (citation.source === 'def-compact-space') {
      if ("'!citation.quote.includes(oldText)) throw new Error('"'old compact quote fragment absent from ' + id + '/' + citation.fact);
      citation.quote = citation.quote.replace(oldText, newText);
      compactCount++;
    }
    if (
      (id === 'lem-dependent-choice-along-a-sequence-of-relations' && citation.fact === 'L1' && citation.source === 'def-sequence-convergence-top') ||
      (id === 'thm-baire-category-locally-compact-hausdorff' && citation.fact === 'L6' && citation.source === 'def-sequence-convergence-top')
    ) {
      citation.quote = 'A **sequence in "'$X$** is a function $x : '"\\\\mathbb{N} \\\\to X"'$, written $(x_k)$ with'"\\n"'$x_k := x(k)$.'"';
      sequenceCount++;
    }
  }
}
if (compactCount "'!== 29 || sequenceCount !== 2) throw new Error('"'unexpected counts ' + compactCount + '/' + sequenceCount);
fs.writeFileSync('/tmp/wave4-topology-proof-contracts.updated2.json', JSON.stringify(data, null, 2) + '\\n');
NODE
