     3	kind: false-statement
     4	title: "FALSE: a compact subset of a topological space is closed"
     5	status: published
     6	origin: session
     7	deps: [def-compact-space, thm-compact-subset-of-a-hausdorff-space-is-closed, def-standard-topologies, def-topological-space, def-hausdorff-space, def-subspace-topology-top]
