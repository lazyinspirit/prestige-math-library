    28	      url: "https://pldml.icm.edu.pl/pldml/element/bwmeta1.element.bwnjournal-article-fmv5i1p18bwm"
    29	    - title: "Tarski's theorem about choice (Wikipedia)"
    30	      url: "https://en.wikipedia.org/wiki/Tarski%27s_theorem_about_choice"
