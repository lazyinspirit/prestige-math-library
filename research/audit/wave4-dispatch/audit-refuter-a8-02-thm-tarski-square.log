30:  references:
31:    - title: "P. Koellner, Set Theory: The Independence Phenomenon, Ch. 3"
32:      url: "https://people.math.harvard.edu/~wboney/fall16/settheory.pdf"
33:    - title: "Cardinal number (Wikipedia)"
34:      url: "https://en.wikipedia.org/wiki/Cardinal_number"
35:    - title: "Von Neumann cardinal assignment (Wikipedia)"
36:      url: "https://en.wikipedia.org/wiki/Von_Neumann_cardinal_assignment"
