     4	title: "Basic closure properties of ordinals"
     5	status: published
     6	origin: session
     7	provenance:
     8	  statement: ai-altered
     9	  proof: ai-altered
    10	deps: [def-ordinal, def-well-order, lem-nat-transitive-irreflexive]
    11	justified_by: []
    12	aliases: [lem-ordinal-elementary-facts]
    13	landmark: false
    14	short: "elements, successors, unions, intersections of ordinals are ordinals"
    15	proof_strategy: direct
    16	verification:
    17	  precheck: pass
    18	  verified:
