        lem-peak-monotone-subsequence, thm-bolzano-weierstrass,
        lem-cauchy-sequence-bounded, lem-cauchy-with-convergent-subsequence,
        thm-cauchy-criterion-via-lub, lem-geometric-sequence-null,
