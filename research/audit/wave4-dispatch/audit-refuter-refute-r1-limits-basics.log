    31	      url: "https://en.wikipedia.org/wiki/Infimum_and_supremum"
    32	    - title: "W. Rudin, Principles of Mathematical Analysis, 3rd ed., Ch. 1"
    33	      url: "https://en.wikipedia.org/wiki/Principles_of_Mathematical_Analysis"
