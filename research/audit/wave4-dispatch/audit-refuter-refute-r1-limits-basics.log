    33	    - title: "Limit of a sequence (Wikipedia)"
    34	      url: "https://en.wikipedia.org/wiki/Limit_of_a_sequence"
    35	    - title: "T. Tao, Analysis I, 3rd ed., §6.1"
    36	      url: "https://terrytao.wordpress.com/books/analysis-i/"
