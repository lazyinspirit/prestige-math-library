    22	    - title: "Cauchy sequence (Wikipedia)"
    23	      url: "https://en.wikipedia.org/wiki/Cauchy_sequence"
    24	    - title: "W. Rudin, Principles of Mathematical Analysis, 3rd ed., Ch. 3 (Thm 3.11(b))"
    25	      url: "https://en.wikipedia.org/wiki/Principles_of_Mathematical_Analysis"
