    2	id: thm-product-universal-property
    3	kind: theorem
    4	title: "A map into a product is continuous iff each of its components is; the projections are continuous and open; and each projection is surjective when every factor is nonempty, which for an infinite index set uses the Axiom of Choice"
    5	status: published
    6	origin: session
    7	provenance:
    8	  statement: ai-altered
    9	  proof: ai-generated
   10	deps: [def-product-topology, thm-initial-and-final-characteristic-properties,
   11	       def-initial-and-final-topology, def-continuous-map-top,
   12	       def-homeomorphism-and-open-maps, def-axiom-of-choice, def-choice-function,
   13	       lem-finite-choice, def-topological-space, def-topology-basis-subbasis]
   14	justified_by: []
