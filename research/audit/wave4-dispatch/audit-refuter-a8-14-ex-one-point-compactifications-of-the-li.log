   21	    - title: "Interval (mathematics) (Wikipedia)"
   22	      url: "https://en.wikipedia.org/wiki/Interval_(mathematics)"
   23	    - title: "W. Rudin, Principles of Mathematical Analysis, 3rd ed., Ch. 2 (segments and cells)"
   24	      url: "https://en.wikipedia.org/wiki/Principles_of_Mathematical_Analysis"
