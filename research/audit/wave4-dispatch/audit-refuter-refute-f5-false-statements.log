    26	      url: "https://en.wikipedia.org/wiki/Axiom_of_countable_choice"
    27	    - title: "P. J. Cohen, The independence of the continuum hypothesis, Proc. Nat. Acad. Sci. USA 50 (1963), 1143-1148"
    28	      url: "https://pmc.ncbi.nlm.nih.gov/articles/PMC221287/"
