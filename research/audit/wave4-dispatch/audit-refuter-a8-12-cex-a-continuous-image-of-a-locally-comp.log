    24	  references:
    25	    - title: "Subspace topology (Wikipedia)"
    26	      url: "https://en.wikipedia.org/wiki/Subspace_topology"
    27	    - title: "J. Munkres, Topology, 2nd ed., §16"
    28	      url: "https://en.wikipedia.org/wiki/James_Munkres"
