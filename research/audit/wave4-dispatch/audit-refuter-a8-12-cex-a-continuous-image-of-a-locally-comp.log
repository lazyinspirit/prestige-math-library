research/audit/wave4-dispatch/audit-beta-foundations.log-545524-+    {
research/audit/wave4-dispatch/audit-beta-foundations.log-545525-+     "fact": "L1",
research/audit/wave4-dispatch/audit-beta-foundations.log-545526-+     "source": "def-complete-ordered-field",
research/audit/wave4-dispatch/audit-beta-foundations.log-545527-+     "source_section": "Definition",
research/audit/wave4-dispatch/audit-beta-foundations.log:545528:+     "quote": "Let $F$ be an ordered field ([[def-ordered-field]]) and $S \\subseteq F$.\n\n- $u \\in F$ is an **upper bound** of $S$ if $s \\le u$ for all $s \\in S$; $S$ is\n  **bounded above** if it has an upper bound.\n- $u \\in F$ is a **least upper bound** (or **supremum**, $\\sup S$) of $S$ if $u$\n  is an upper bound of $S$ and $u \\le u'$ for every upper bound $u'$ of $S$.\n\n$F$ is a **complete ordered field** (equivalently, $F$ has the\n**least-upper-bound property**, or is **Dedekind complete**) if every nonempty\n$S \\subseteq F$ that is bounded above has a least upper bound in $F$.",
research/audit/wave4-dispatch/audit-beta-foundations.log-545529-+     "uses": [
research/audit/wave4-dispatch/audit-beta-foundations.log-545530-+      "1.1",
research/audit/wave4-dispatch/audit-beta-foundations.log-545531-+      "1.3"
research/audit/wave4-dispatch/audit-beta-foundations.log-545532-+     ]
--
