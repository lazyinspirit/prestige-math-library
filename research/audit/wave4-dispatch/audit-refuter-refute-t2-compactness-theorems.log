    17	  scraped: []
    18	  references:
    19	    - title: "T. Tao, Analysis I, 3rd ed., §5.4"
    20	      url: "https://terrytao.wordpress.com/books/analysis-i/"
    21	    - title: "L. S. Krapp, Constructions of the real numbers: a set theoretical approach (Oxford, 2014)"
