+    endpoints: ['checked', 'Step 2.1 applies the estimate for every k>=N and includes the threshold index; the citation supporting k+1>N is separately flagged for precision repair.'],
+    'nonempty-choice': ['checked', 'Step 2.1 takes one Archimedean natural N and then uses an explicit reciprocal sequence; no arbitrary family choice occurs.'],
+    'iff-forward': ['not_applicable', 'The item refutes a one-way strict-order implication.'],
+    'iff-reverse': ['not_applicable', 'No biconditional is stated.'],
+  },
+  'fs-subsequence-convergence-implies-convergence': {
+    empty: ['not_applicable', 'The alternating witness and its subsequence have domain N; an empty subsequence is not part of the definition.'],
+    zero: ['checked', 'The Given construction fixes n_0=0, and step 1.1 uses that imported 0-based subsequence without omitting its first term.'],
+    one: ['checked', 'Steps 1.1 and 2.1 identify the witness subsequence as the constant sequence 1 and verify its limit.'],
+    degenerate: ['checked', 'Step 4.1 uses the identity subsequence to check the backward direction of the corrected every-subsequence characterization.'],
+    endpoints: ['checked', 'Steps 1.1-2.1 retain every index of the given increasing map, including its initial value.'],
+    'nonempty-choice': ['checked', 'Steps 1.1-3.1 reuse the explicitly recursive witness and index map and make no new subsequence choice.'],
+    'iff-forward': ['checked', 'Step 4.1 records the forward direction of the corrected iff by the inherited-limit theorem.'],
+    'iff-reverse': ['checked', 'Step 4.1 proves the reverse direction by applying the every-subsequence hypothesis to the identity subsequence.'],
+  },
+};
+
+const contracts = {};
+const scope = [];
+for (const id of ids) {
+  const body = bodyOf(id);
+  const stepMap = steps(body);
+  if (!stepMap.size) continue;
+  scope.push(id);
+  const factMap = facts(body);
+  const citations = [];
+  for (const [fact, links] of factMap) {
+    const uses = [...stepMap].filter(([, text]) => new RegExp(`\\b${fact}\\b`).test(text)).map(([step]) => step);
+    for (const source of links) citations.push({ fact, source, ...sourceClause(source), uses });
+  }
+  const notes = boundaryNotes[id];
+  if (!notes) throw new Error(`Missing boundary worksheet for ${id}`);
+  contracts[id] = {
+    citations,
+    derivations: [...stepMap].map(([step, claim]) => ({ id: `s${step}`, claim, step, inputs: explicitTokens(claim) })),
+    routine_steps: [],
+    boundaries: boundaryOrder.map((name) => {
