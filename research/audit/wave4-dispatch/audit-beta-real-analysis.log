@@ -0,0 +1,245 @@
+import { readFileSync, writeFileSync } from 'node:fs';
+
+const root = '/root/Projects/prestige-math-library';
+const manifest = JSON.parse(readFileSync(`${root}/research/audit/wave4-real-analysis.pages.json`, 'utf8'));
+const ids = manifest.flatMap((page) => page.items.map((item) => item.id));
+const sections = ['Proof', 'Refutation', 'Counterexample', 'Verification'];
+const boundaryOrder = ['empty', 'zero', 'one', 'degenerate', 'endpoints', 'nonempty-choice', 'iff-forward', 'iff-reverse'];
+
+function bodyOf(id) {
+  const source = readFileSync(`${root}/items/${id}.md`, 'utf8');
+  const match = source.match(/^---\r?\n[\s\S]*?\r?\n---\r?\n?([\s\S]*)$/);
+  return match ? match[1] : source;
+}
+
+function sectionText(body, heading) {
+  const escaped = heading.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+  const match = body.match(new RegExp(`^##\\s+${escaped}\\s*$\\r?\\n([\\s\\S]*?)(?=^##\\s+|(?![\\s\\S]))`, 'm'));
+  return match?.[1]?.trim() ?? '';
+}
+
+function sourceClause(id) {
+  const body = bodyOf(id);
+  for (const heading of ['Definition', 'Example', 'Statement refuted', 'Statement']) {
+    const quote = sectionText(body, heading);
+    if (quote) return { source_section: heading, quote };
+  }
+  throw new Error(`No normative source clause for ${id}`);
+}
+
+function facts(body) {
+  const out = new Map();
+  for (const paragraph of sectionText(body, 'Facts & Assumptions').split(/\n\s*\n/)) {
+    const match = paragraph.trim().match(/^\[([FAL]\d+)\]\s*([\s\S]*)$/);
+    if (!match) continue;
+    const links = [...paragraph.matchAll(/\[\[([^\]|]+)(?:\|[^\]]*)?\]\]/g)].map((link) => link[1]);
+    out.set(match[1], [...new Set(links)]);
+  }
+  return out;
+}
+
+function steps(body) {
+  const out = new Map();
+  for (const heading of sections) {
+    for (const line of sectionText(body, heading).split(/\r?\n/)) {
+      const match = line.match(/^(\d+\.\d+)\s+(.+)$/);
+      if (match) out.set(match[1], match[2]);
+    }
+  }
+  return out;
+}
+
+function explicitTokens(text) {
+  const out = new Set();
+  for (const match of text.matchAll(/\b(?:step\s+)?(\d+\.\d+)\b|\b([FAL]\d+)\b/g)) out.add(match[1] ?? match[2]);
+  return [...out];
+}
+
+const boundaryNotes = {
+  'lem-limit-of-tail': {
+    empty: ['not_applicable', 'Sequences have the fixed nonempty domain N; the theorem quantifies over tails, not over an arbitrary family that may be empty.'],
+    zero: ['checked', 'Step 1.2 checks the 0-th tail explicitly and identifies it with the original sequence.'],
+    one: ['checked', 'The statement quantifies over every tail index, including K=1, and step 1.1 uses the same index arithmetic without a special exception.'],
+    degenerate: ['checked', 'Step 3.1 covers eventual equality when the two sequences are identical, and step 1.2 covers the unchanged 0-th tail.'],
+    endpoints: ['checked', 'Steps 1.1 and 1.3 preserve the inclusive threshold convention k>=N at both the original and shifted endpoints.'],
+    'nonempty-choice': ['checked', 'Steps 1.1, 1.3, 1.4, and 1.5 use only the threshold supplied by the relevant convergence or Cauchy hypothesis and make no family-wide arbitrary choice.'],
+    'iff-forward': ['checked', 'Steps 1.1 and 1.4 prove the forward tail implications, and step 1.2 proves the all-tails to some-tail implication.'],
+    'iff-reverse': ['checked', 'Steps 1.3 and 1.5 prove the reverse implications from one convergent or Cauchy tail.'],
+  },
+  'lem-limit-unique': {
+    empty: ['not_applicable', 'The statement concerns a sequence on N and two alleged limits; no empty set or empty family is quantified over.'],
+    zero: ['checked', 'Steps 2.1 and 7.1 isolate the zero-distance boundary: |x-y|=0 is equivalent to the required conclusion x=y.'],
+    one: ['not_applicable', 'No singleton, unit index, or multiplicative identity is a boundary of the uniqueness statement.'],
+    degenerate: ['checked', 'The degenerate case x=y is exactly the conclusion; step 1.1 assumes only its negation and step 7.1 discharges that contradiction.'],
+    endpoints: ['checked', 'Steps 4.1 and 5.1 choose a common index at both inclusive convergence thresholds.'],
+    'nonempty-choice': ['checked', 'Step 3.1 makes one density choice of a positive rational and step 5.1 takes one common natural index; neither is a simultaneous choice from a family.'],
+    'iff-forward': ['not_applicable', 'The statement is a one-way uniqueness implication, not a biconditional.'],
+    'iff-reverse': ['not_applicable', 'The statement is a one-way uniqueness implication, not a biconditional.'],
+  },
+  'lem-convergent-implies-bounded': {
+    empty: ['not_applicable', 'The sequence domain N is nonempty; no empty family of terms is admitted.'],
+    zero: ['checked', 'Step 2.2 handles K=0 explicitly: the initial-term list is empty but the appended entry |x|+1 makes the maximum list nonempty.'],
+    one: ['checked', 'Step 1.1 uses the rational tolerance 1 and step 2.2 retains |x|+1 as an actual list entry.'],
+    degenerate: ['checked', 'The proof includes constant and zero sequences: the tail estimate and finite maximum in steps 2.1-3.2 remain valid without strict variation among terms.'],
+    endpoints: ['checked', 'Steps 3.1, 3.2, and 4.1 split every index exactly at k<K versus k>=K, with no omitted threshold term.'],
+    'nonempty-choice': ['checked', 'Step 2.2 proves the finite maximum list is nonempty even at K=0 before using the maximum lemma.'],
+    'iff-forward': ['not_applicable', 'The statement is the forward implication convergence implies boundedness.'],
+    'iff-reverse': ['not_applicable', 'The converse is false and is not part of this statement.'],
+  },
+  'lem-convergent-implies-cauchy': {
+    empty: ['not_applicable', 'The statement concerns a sequence on nonempty N, not an empty family.'],
+    zero: ['checked', 'Step 3.1 permits k=l and then bounds the zero distance by the same epsilon estimate.'],
+    one: ['checked', 'The statement quantifies over every positive rational, including epsilon=1, and steps 1.1-4.1 do not require a smaller special range.'],
