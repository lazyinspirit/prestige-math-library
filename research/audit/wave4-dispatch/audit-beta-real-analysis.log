+import { readFileSync, writeFileSync } from 'node:fs';
+
+const root = '/root/Projects/prestige-math-library';
+const manifest = JSON.parse(readFileSync(`${root}/research/audit/wave4-real-analysis.pages.json`, 'utf8'));
+const ids = manifest.flatMap((page) => page.items.map((item) => item.id));
+const sections = ['Proof', 'Refutation', 'Counterexample', 'Verification'];
+const boundaryOrder = ['empty', 'zero', 'one', 'degenerate', 'endpoints', 'nonempty-choice', 'iff-forward', 'iff-reverse'];
+
+function bodyOf(id) {
+  const source = readFileSync(`${root}/items/${id}.md`, 'utf8');
+  const match = source.match(/^---\r?\n[\s\S]*?\r?\n---\r?\n?([\s\S]*)$/);
+  return match ? match[1] : source;
+}
+
+function sectionText(body, heading) {
+  const escaped = heading.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+  const match = body.match(new RegExp(`^##\\s+${escaped}\\s*$\\r?\\n([\\s\\S]*?)(?=^##\\s+|(?![\\s\\S]))`, 'm'));
+  return match?.[1]?.trim() ?? '';
+}
+
+function sourceClause(id) {
+  const body = bodyOf(id);
+  for (const heading of ['Definition', 'Example', 'Statement refuted', 'Statement']) {
+    const quote = sectionText(body, heading);
+    if (quote) return { source_section: heading, quote };
+  }
+  throw new Error(`No normative source clause for ${id}`);
+}
+
+function facts(body) {
+  const out = new Map();
+  for (const paragraph of sectionText(body, 'Facts & Assumptions').split(/\n\s*\n/)) {
+    const match = paragraph.trim().match(/^\[([FAL]\d+)\]\s*([\s\S]*)$/);
+    if (!match) continue;
+    const links = [...paragraph.matchAll(/\[\[([^\]|]+)(?:\|[^\]]*)?\]\]/g)].map((link) => link[1]);
+    out.set(match[1], [...new Set(links)]);
+  }
+  return out;
+}
+
+function steps(body) {
+  const out = new Map();
+  for (const heading of sections) {
+    for (const line of sectionText(body, heading).split(/\r?\n/)) {
+      const match = line.match(/^(\d+\.\d+)\s+(.+)$/);
+      if (match) out.set(match[1], match[2]);
+    }
+  }
+  return out;
+}
+
+function explicitTokens(text) {
+  const out = new Set();
+  for (const match of text.matchAll(/\b(?:step\s+)?(\d+\.\d+)\b|\b([FAL]\d+)\b/g)) out.add(match[1] ?? match[2]);
+  const tag = text.match(/\[([^\]]+)\]\s*(?:∎)?$/);
+  for (const token of tag?.[1]?.split(',').map((value) => value.trim()) ?? []) {
+    const normal = token.replace(/^step\s+/, '');
+    if (normal && !out.has(normal)) out.add(normal);
+  }
+  return [...out];
+}
+
