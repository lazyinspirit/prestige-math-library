const fs=require('fs');for(const id of ['the-exponential-function','the-exponential-function-examples']){const s=fs.readFileSync("'`library/real-analysis/${id}.md`,'"'utf8');const b=s.replace(/"'^---['"\\s\\S]*?---\\s*/,'');const before=b.split(/"'^## /m)[0].trim();console.log(id,{paras:before?before.split(/'"\\n\\s*\\n/).length:0,words:(before.match(/\\b[\\w’-]+\\b/g)||[]).length});console.log(before)}
