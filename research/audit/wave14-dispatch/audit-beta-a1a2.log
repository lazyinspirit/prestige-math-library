function facts(b){let a=[];for(const p of sec(b,'Facts & Assumptions').split(/\\n\\s*\\n/)){const z=p.trim().match(/"'^'"\\[([FAL]\\d+)\\]\\s*([\\s\\S]*)"'$/);if(z)a.push({l:z[1],text:p,links:[...p.matchAll(/'"\\[\\[(["'^'"\\]|]+)(?:\\|["'^'"\\]]*)?\\]\\]/g)].map(q=>q[1])})}return a}
function words(s){return new Set((s.toLowerCase().replace(/\\[\\[["'^'"\\]]+\\]\\]/g,' ').match(/[a-z][a-z0-9-]{2,}/g)||[]).filter(w=>"'!['"'the','and','for','with','from','that','then','are','into','every','this','when','where','there','under','over','has','have'].includes(w)))}
function pick(text,body){let section;for(const h of ['Statement','Statement refuted','Definition','Example'])if(sec(body,h)){section=h;break} const st=sec(body,section);let ps=st.split(/\\n\\s*\\n/).map(x=>x.trim()).filter(Boolean);const fw=words(text); let best=ps[0],bs=-1;for(const p of ps){const pw=words(p);let s=0;for(const w of fw)if(pw.has(w))s++; if(s>bs){bs=s;best=p}}return {section,score:bs,q:best}}
for(const pg of m)for(const it of pg.items){const {body}=split(fs.readFileSync('items/'+it.id+'.md','utf8'));const ff=facts(body);if("'!ff.length)continue;console.log('"'\\n## '+it.id);for(const f of ff)for(const t of f.links){const tb=split(fs.readFileSync('items/'+t+'.md','utf8')).body,p=pick(f.text,tb);console.log("'`${f.l} -> ${t} [${p.section};${p.score}]: ${p.q.replace(/'"\\s+/g,' ').slice(0,300)}"'`)}}
