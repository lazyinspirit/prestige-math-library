function factsByLabel(body) {
  const facts = new Map();
  const text = sectionText(body, 'Facts & Assumptions');
  const paragraphs = text.split(/\n\s*\n/);
  for (const paragraph of paragraphs) {
    const match = paragraph.trim().match(/^\[([FAL]\d+)\]\s*([\s\S]*)$/);
    if (!match) continue;
