research/audit/wave7-dispatch/audit-beta-topology-uniform.log-285785-+          "fact": "L1",
research/audit/wave7-dispatch/audit-beta-topology-uniform.log-285786-+          "source": "thm-compact-hausdorff-open-cover-uniformity",
