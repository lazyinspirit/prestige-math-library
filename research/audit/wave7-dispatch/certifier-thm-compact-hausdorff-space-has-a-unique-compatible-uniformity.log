research/audit/wave7-dispatch/audit-beta-topology-uniform.log-274182-+        {
research/audit/wave7-dispatch/audit-beta-topology-uniform.log-274183-+          "fact": "L2",
research/audit/wave7-dispatch/audit-beta-topology-uniform.log-274184-+          "source": "def-uniformly-continuous-map",
research/audit/wave7-dispatch/audit-beta-topology-uniform.log-274185-+          "source_section": "Definition",
research/audit/wave7-dispatch/audit-beta-topology-uniform.log-274186-+          "quote": "For uniform spaces $(X,\\mathcal U_X)$ and $(Y,\\mathcal U_Y)$, a map $f:X\\to Y$ is **uniformly continuous** if for every $V\\in\\mathcal U_Y$ there is $U\\in\\mathcal U_X$ such that $(x,x')\\in U$ implies $(f(x),f(x'))\\in V$. The controlling entourage $U$ is independent of the point $x$.",
research/audit/wave7-dispatch/audit-beta-topology-uniform.log-274187-+          "uses": [
