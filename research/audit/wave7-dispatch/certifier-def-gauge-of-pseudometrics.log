research/audit/wave7-topology-uniform.proof-contracts.json-1209-          "source_section": "Statement",
research/audit/wave7-topology-uniform.proof-contracts.json-1210-          "quote": "Assuming dependent choice, for every entourage $U$ there are symmetric\nentourages $(E_n)_{n\\in\\mathbb N}$ such that $E_0=X\\times X$,\n$E_1\\subseteq U$, the sequence is decreasing, and\n$E_{n+1}^{\\circ3}\\subseteq E_n$ for every $n\\in\\mathbb N$.",
research/audit/wave7-topology-uniform.proof-contracts.json-1211-          "uses": [
research/audit/wave7-topology-uniform.proof-contracts.json-1212-            "1.1"
research/audit/wave7-topology-uniform.proof-contracts.json-1213-          ]
research/audit/wave7-topology-uniform.proof-contracts.json-1214-        },
research/audit/wave7-topology-uniform.proof-contracts.json-1215-        {
research/audit/wave7-topology-uniform.proof-contracts.json-1216-          "fact": "L2",
research/audit/wave7-topology-uniform.proof-contracts.json-1217-          "source": "lem-pseudometric-from-a-normal-entourage-sequence",
research/audit/wave7-topology-uniform.proof-contracts.json-1218-          "source_section": "Statement",
research/audit/wave7-topology-uniform.proof-contracts.json:1219:          "quote": "Given a decreasing symmetric sequence $(E_n)$ with $E_0=X\\times X$ and\n$E_{n+1}^{\\circ3}\\subseteq E_n$, there is a pseudometric $p$ on $X$ such that\n$$\nE_n\\subseteq\\{p\\le2^{-n}\\}\\subseteq E_{n-1}\n$$\nfor every $n\\ge1$. In particular, each set $\\{p<\\varepsilon\\}$ is an\nentourage, so $p$ is uniformly continuous for the original uniformity in the\nsense of [[def-gauge-of-pseudometrics]].",
research/audit/wave7-topology-uniform.proof-contracts.json-1220-          "uses": [
research/audit/wave7-topology-uniform.proof-contracts.json-1221-            "1.1"
research/audit/wave7-topology-uniform.proof-contracts.json-1222-          ]
research/audit/wave7-topology-uniform.proof-contracts.json-1223-        },
research/audit/wave7-topology-uniform.proof-contracts.json-1224-        {
research/audit/wave7-topology-uniform.proof-contracts.json-1225-          "fact": "L3",
research/audit/wave7-topology-uniform.proof-contracts.json:1226:          "source": "def-gauge-of-pseudometrics",
research/audit/wave7-topology-uniform.proof-contracts.json-1227-          "source_section": "Definition",
research/audit/wave7-topology-uniform.proof-contracts.json-1228-          "quote": "A **gauge of pseudometrics** on $X$ is a family $\\mathcal P$ of pseudometrics ([[def-metric-space]]). For finite $F\\subseteq\\mathcal P$ and $\\varepsilon>0$, put $E(F,\\varepsilon)=\\{(x,y):p(x,y)<\\varepsilon\\text{ for every }p\\in F\\}$. If $X\\ne\\varnothing$, these sets form a filter base and generate a uniformity ([[def-filter-base]], [[lem-filter-base-generates]]), called the uniformity **generated by $\\mathcal P$**.",
research/audit/wave7-topology-uniform.proof-contracts.json-1229-          "uses": [
research/audit/wave7-topology-uniform.proof-contracts.json-1230-            "2.1",
research/audit/wave7-topology-uniform.proof-contracts.json-1231-            "2.2"
research/audit/wave7-topology-uniform.proof-contracts.json-1232-          ]
research/audit/wave7-topology-uniform.proof-contracts.json-1233-        }
research/audit/wave7-topology-uniform.proof-contracts.json-1234-      ],
research/audit/wave7-topology-uniform.proof-contracts.json-1235-      "derivations": [
