research/audit/wave7-proof-contracts.json-35823-          "fact": "L4",
research/audit/wave7-proof-contracts.json-35824-          "source": "lem-completely-regular-topologies-come-from-continuous-pseudometrics",
research/audit/wave7-proof-contracts.json-35825-          "source_section": "Statement",
research/audit/wave7-proof-contracts.json-35826-          "quote": "The topology of a nonempty completely regular space is induced by the gauge of pseudometrics $p_f(x,y)=|f(x)-f(y)|$, where $f:X\\to[0,1]$ ranges over continuous maps.",
research/audit/wave7-proof-contracts.json-35827-          "uses": [
research/audit/wave7-proof-contracts.json-35828-            "1.2"
research/audit/wave7-proof-contracts.json-35829-          ]
research/audit/wave7-proof-contracts.json-35830-        },
research/audit/wave7-proof-contracts.json-35831-        {
research/audit/wave7-proof-contracts.json-35832-          "fact": "L4",
research/audit/wave7-proof-contracts.json:35833:          "source": "def-gauge-of-pseudometrics",
research/audit/wave7-proof-contracts.json-35834-          "source_section": "Definition",
research/audit/wave7-proof-contracts.json-35835-          "quote": "For an already given uniformity $\\mathcal U$ on $X$, a pseudometric $p$ is\n**uniformly continuous for $\\mathcal U$** when\n$$\n\\{(x,y):p(x,y)<\\varepsilon\\}\\in\\mathcal U\n$$\nfor every $\\varepsilon>0$. With this terminology, each member of a gauge is\nuniformly continuous for the uniformity generated by that gauge.",
research/audit/wave7-proof-contracts.json-35836-          "uses": [
