research/audit/wave7-proof-contracts.json-32393-          "uses": [
research/audit/wave7-proof-contracts.json-32394-            "1.2"
research/audit/wave7-proof-contracts.json-32395-          ]
research/audit/wave7-proof-contracts.json-32396-        },
research/audit/wave7-proof-contracts.json-32397-        {
research/audit/wave7-proof-contracts.json-32398-          "fact": "L3",
research/audit/wave7-proof-contracts.json:32399:          "source": "def-gauge-of-pseudometrics",
research/audit/wave7-proof-contracts.json-32400-          "source_section": "Definition",
research/audit/wave7-proof-contracts.json-32401-          "quote": "A **gauge of pseudometrics** on $X$ is a family $\\mathcal P$ of pseudometrics ([[def-metric-space]]). For finite $F\\subseteq\\mathcal P$ and $\\varepsilon>0$, put $E(F,\\varepsilon)=\\{(x,y):p(x,y)<\\varepsilon\\text{ for every }p\\in F\\}$. If $X\\ne\\varnothing$, these sets form a filter base and generate a uniformity ([[def-filter-base]], [[lem-filter-base-generates]]), called the uniformity **generated by $\\mathcal P$**.",
research/audit/wave7-proof-contracts.json-32402-          "uses": [
research/audit/wave7-proof-contracts.json-32403-            "1.2"
research/audit/wave7-proof-contracts.json-32404-          ]
research/audit/wave7-proof-contracts.json-32405-        }
research/audit/wave7-proof-contracts.json-32406-      ],
research/audit/wave7-proof-contracts.json-32407-      "derivations": [
research/audit/wave7-proof-contracts.json-32408-        {
research/audit/wave7-proof-contracts.json-32409-          "id": "step-1.1",
--
research/audit/wave7-proof-contracts.json-35105-          "source_section": "Statement",
research/audit/wave7-proof-contracts.json-35106-          "quote": "In ZF, every countably based uniformity has a decreasing symmetric base $(E_n)$ with $E_{n+1}^{\\circ3}\\subseteq E_n$.",
research/audit/wave7-proof-contracts.json-35107-          "uses": [
research/audit/wave7-proof-contracts.json-35108-            "1.1"
research/audit/wave7-proof-contracts.json-35109-          ]
research/audit/wave7-proof-contracts.json-35110-        },
research/audit/wave7-proof-contracts.json-35111-        {
research/audit/wave7-proof-contracts.json-35112-          "fact": "L2",
research/audit/wave7-proof-contracts.json-35113-          "source": "lem-pseudometric-from-a-normal-entourage-sequence",
research/audit/wave7-proof-contracts.json-35114-          "source_section": "Statement",
research/audit/wave7-proof-contracts.json:35115:          "quote": "Given a decreasing symmetric sequence $(E_n)$ with $E_0=X\\times X$ and\n$E_{n+1}^{\\circ3}\\subseteq E_n$, there is a pseudometric $p$ on $X$ such that\n$$\nE_n\\subseteq\\{p\\le2^{-n}\\}\\subseteq E_{n-1}\n$$\nfor every $n\\ge1$. In particular, each set $\\{p<\\varepsilon\\}$ is an\nentourage, so $p$ is uniformly continuous for the original uniformity in the\nsense of [[def-gauge-of-pseudometrics]].",
research/audit/wave7-proof-contracts.json-35116-          "uses": [
research/audit/wave7-proof-contracts.json-35117-            "1.1"
research/audit/wave7-proof-contracts.json-35118-          ]
research/audit/wave7-proof-contracts.json-35119-        },
research/audit/wave7-proof-contracts.json-35120-        {
research/audit/wave7-proof-contracts.json-35121-          "fact": "L3",
research/audit/wave7-proof-contracts.json-35122-          "source": "lem-metric-uniformity-dictionary",
research/audit/wave7-proof-contracts.json-35123-          "source_section": "Statement",
research/audit/wave7-proof-contracts.json-35124-          "quote": "For a metric space $(X,d)$ with $X\\ne\\varnothing$, the sets $E_\\varepsilon=\\{(x,y):d(x,y)<\\varepsilon\\}$, $\\varepsilon>0$, generate a separated uniformity. Its induced topology is the metric topology, and uniform continuity to another metric uniformity is exactly metric uniform continuity.",
research/audit/wave7-proof-contracts.json-35125-          "uses": [
--
research/audit/wave7-proof-contracts.json-35375-        "reviewer": "Alpha",
research/audit/wave7-proof-contracts.json-35376-        "notes": "Audit-Beta captured this A2 contract after reading every numbered step and every cited target section; independent risk review remains for A6."
research/audit/wave7-proof-contracts.json-35377-      }
research/audit/wave7-proof-contracts.json-35378-    },
research/audit/wave7-proof-contracts.json-35379-    "lem-uniformizable-spaces-are-completely-regular": {
research/audit/wave7-proof-contracts.json-35380-      "citations": [
research/audit/wave7-proof-contracts.json-35381-        {
research/audit/wave7-proof-contracts.json-35382-          "fact": "L1",
research/audit/wave7-proof-contracts.json-35383-          "source": "lem-pseudometric-from-a-normal-entourage-sequence",
research/audit/wave7-proof-contracts.json-35384-          "source_section": "Statement",
research/audit/wave7-proof-contracts.json:35385:          "quote": "Given a decreasing symmetric sequence $(E_n)$ with $E_0=X\\times X$ and\n$E_{n+1}^{\\circ3}\\subseteq E_n$, there is a pseudometric $p$ on $X$ such that\n$$\nE_n\\subseteq\\{p\\le2^{-n}\\}\\subseteq E_{n-1}\n$$\nfor every $n\\ge1$. In particular, each set $\\{p<\\varepsilon\\}$ is an\nentourage, so $p$ is uniformly continuous for the original uniformity in the\nsense of [[def-gauge-of-pseudometrics]].",
research/audit/wave7-proof-contracts.json-35386-          "uses": [
research/audit/wave7-proof-contracts.json-35387-            "2.1",
research/audit/wave7-proof-contracts.json-35388-            "3.1"
research/audit/wave7-proof-contracts.json-35389-          ]
research/audit/wave7-proof-contracts.json-35390-        },
research/audit/wave7-proof-contracts.json-35391-        {
research/audit/wave7-proof-contracts.json-35392-          "fact": "L2",
research/audit/wave7-proof-contracts.json-35393-          "source": "def-completely-regular-and-tychonoff-spaces",
research/audit/wave7-proof-contracts.json-35394-          "source_section": "Definition",
research/audit/wave7-proof-contracts.json-35395-          "quote": "**The same condition in the vocabulary of zero sets.** With $f$ as displayed,\n$C \\subseteq Z(f)$ and $x_0 \\in \\operatorname{coz}(f)$\n([[def-zero-sets-and-cozero-sets]]), so complete regularity says: for every\nclosed $C$ and every $x_0 \\notin C$ there is a continuous $f$ whose zero set\ncontains $C$ and whose cozero set contains $x_0$. In particular\n$\\operatorname{coz}(f)$ is an open set containing $x_0$ and disjoint from $C$;\nthat alone is weaker than regularity, and the passage from the function to two\n*disjoint* open sets is the next item.",
--
research/audit/wave7-proof-contracts.json-35549-          "fact": "L2",
research/audit/wave7-proof-contracts.json-35550-          "source": "def-continuous-map-top",
research/audit/wave7-proof-contracts.json-35551-          "source_section": "Definition",
research/audit/wave7-proof-contracts.json-35552-          "quote": "**The same condition with open sets only.** $f$ is continuous at $x$ if and only\nif for every open $V \\subseteq Y$ with $f(x) \\in V$ there is an open\n$U \\subseteq X$ with $x \\in U$ and $f[U] \\subseteq V$. Indeed, if $f$ is\ncontinuous at $x$ and $V$ is such an open set, then $V$ is a neighbourhood of\n$f(x)$, so $f^{-1}[V]$ is a neighbourhood of $x$ and contains an open $U \\ni x$,\nwhich satisfies $f[U] \\subseteq V$. Conversely, given the displayed condition and\na neighbourhood $V$ of $f(x)$, fix open $V_0$ with $f(x) \\in V_0 \\subseteq V$ and\nthen open $U \\ni x$ with $f[U] \\subseteq V_0$; then $x \\in U \\subseteq f^{-1}[V_0] \\subseteq f^{-1}[V]$,\nso $f^{-1}[V]$ is a neighbourhood of $x$. Both forms are used below and are the\nsame statement written twice.",
research/audit/wave7-proof-contracts.json-35553-          "uses": [
research/audit/wave7-proof-contracts.json-35554-            "1.1"
research/audit/wave7-proof-contracts.json-35555-          ]
research/audit/wave7-proof-contracts.json-35556-        },
research/audit/wave7-proof-contracts.json-35557-        {
research/audit/wave7-proof-contracts.json-35558-          "fact": "L3",
research/audit/wave7-proof-contracts.json:35559:          "source": "def-gauge-of-pseudometrics",
research/audit/wave7-proof-contracts.json-35560-          "source_section": "Definition",
research/audit/wave7-proof-contracts.json-35561-          "quote": "A **gauge of pseudometrics** on $X$ is a family $\\mathcal P$ of pseudometrics ([[def-metric-space]]). For finite $F\\subseteq\\mathcal P$ and $\\varepsilon>0$, put $E(F,\\varepsilon)=\\{(x,y):p(x,y)<\\varepsilon\\text{ for every }p\\in F\\}$. If $X\\ne\\varnothing$, these sets form a filter base and generate a uniformity ([[def-filter-base]], [[lem-filter-base-generates]]), called the uniformity **generated by $\\mathcal P$**.",
research/audit/wave7-proof-contracts.json-35562-          "uses": [
research/audit/wave7-proof-contracts.json-35563-            "1.2",
research/audit/wave7-proof-contracts.json-35564-            "2.1"
research/audit/wave7-proof-contracts.json-35565-          ]
research/audit/wave7-proof-contracts.json-35566-        },
research/audit/wave7-proof-contracts.json-35567-        {
research/audit/wave7-proof-contracts.json-35568-          "fact": "L4",
