research/audit/wave7-proof-contracts.json-32263-          "source_section": "Statement",
research/audit/wave7-proof-contracts.json-32264-          "quote": "Assuming dependent choice, for every entourage $U$ there are symmetric\nentourages $(E_n)_{n\\in\\mathbb N}$ such that $E_0=X\\times X$,\n$E_1\\subseteq U$, the sequence is decreasing, and\n$E_{n+1}^{\\circ3}\\subseteq E_n$ for every $n\\in\\mathbb N$.",
research/audit/wave7-proof-contracts.json-32265-          "uses": [
research/audit/wave7-proof-contracts.json-32266-            "1.1"
research/audit/wave7-proof-contracts.json-32267-          ]
research/audit/wave7-proof-contracts.json-32268-        },
research/audit/wave7-proof-contracts.json-32269-        {
research/audit/wave7-proof-contracts.json-32270-          "fact": "L2",
research/audit/wave7-proof-contracts.json-32271-          "source": "lem-pseudometric-from-a-normal-entourage-sequence",
research/audit/wave7-proof-contracts.json-32272-          "source_section": "Statement",
research/audit/wave7-proof-contracts.json:32273:          "quote": "Given a decreasing symmetric sequence $(E_n)$ with $E_0=X\\times X$ and\n$E_{n+1}^{\\circ3}\\subseteq E_n$, there is a pseudometric $p$ on $X$ such that\n$$\nE_n\\subseteq\\{p\\le2^{-n}\\}\\subseteq E_{n-1}\n$$\nfor every $n\\ge1$. In particular, each set $\\{p<\\varepsilon\\}$ is an\nentourage, so $p$ is uniformly continuous for the original uniformity in the\nsense of [[def-gauge-of-pseudometrics]].",
research/audit/wave7-proof-contracts.json-32274-          "uses": [
research/audit/wave7-proof-contracts.json-32275-            "1.1"
research/audit/wave7-proof-contracts.json-32276-          ]
research/audit/wave7-proof-contracts.json-32277-        },
research/audit/wave7-proof-contracts.json-32278-        {
research/audit/wave7-proof-contracts.json-32279-          "fact": "L3",
research/audit/wave7-proof-contracts.json:32280:          "source": "def-gauge-of-pseudometrics",
research/audit/wave7-proof-contracts.json-32281-          "source_section": "Definition",
research/audit/wave7-proof-contracts.json-32282-          "quote": "A **gauge of pseudometrics** on $X$ is a family $\\mathcal P$ of pseudometrics ([[def-metric-space]]). For finite $F\\subseteq\\mathcal P$ and $\\varepsilon>0$, put $E(F,\\varepsilon)=\\{(x,y):p(x,y)<\\varepsilon\\text{ for every }p\\in F\\}$. If $X\\ne\\varnothing$, these sets form a filter base and generate a uniformity ([[def-filter-base]], [[lem-filter-base-generates]]), called the uniformity **generated by $\\mathcal P$**.",
research/audit/wave7-proof-contracts.json-32283-          "uses": [
research/audit/wave7-proof-contracts.json-32284-            "2.1",
research/audit/wave7-proof-contracts.json-32285-            "2.2"
research/audit/wave7-proof-contracts.json-32286-          ]
research/audit/wave7-proof-contracts.json-32287-        }
research/audit/wave7-proof-contracts.json-32288-      ],
research/audit/wave7-proof-contracts.json-32289-      "derivations": [
research/audit/wave7-proof-contracts.json-32290-        {
