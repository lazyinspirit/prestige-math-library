research/audit/wave7-topology-uniform.proof-contracts.json-4769-          "fact": "L4",
research/audit/wave7-topology-uniform.proof-contracts.json-4770-          "source": "lem-completely-regular-topologies-come-from-continuous-pseudometrics",
research/audit/wave7-topology-uniform.proof-contracts.json-4771-          "source_section": "Statement",
research/audit/wave7-topology-uniform.proof-contracts.json-4772-          "quote": "The topology of a nonempty completely regular space is induced by the gauge of pseudometrics $p_f(x,y)=|f(x)-f(y)|$, where $f:X\\to[0,1]$ ranges over continuous maps.",
research/audit/wave7-topology-uniform.proof-contracts.json-4773-          "uses": [
research/audit/wave7-topology-uniform.proof-contracts.json-4774-            "1.2"
research/audit/wave7-topology-uniform.proof-contracts.json-4775-          ]
research/audit/wave7-topology-uniform.proof-contracts.json-4776-        },
research/audit/wave7-topology-uniform.proof-contracts.json-4777-        {
research/audit/wave7-topology-uniform.proof-contracts.json-4778-          "fact": "L4",
research/audit/wave7-topology-uniform.proof-contracts.json:4779:          "source": "def-gauge-of-pseudometrics",
research/audit/wave7-topology-uniform.proof-contracts.json-4780-          "source_section": "Definition",
research/audit/wave7-topology-uniform.proof-contracts.json-4781-          "quote": "For an already given uniformity $\\mathcal U$ on $X$, a pseudometric $p$ is\n**uniformly continuous for $\\mathcal U$** when\n$$\n\\{(x,y):p(x,y)<\\varepsilon\\}\\in\\mathcal U\n$$\nfor every $\\varepsilon>0$. With this terminology, each member of a gauge is\nuniformly continuous for the uniformity generated by that gauge.",
research/audit/wave7-topology-uniform.proof-contracts.json-4782-          "uses": [
research/audit/wave7-topology-uniform.proof-contracts.json-4783-            "1.2"
research/audit/wave7-topology-uniform.proof-contracts.json-4784-          ]
