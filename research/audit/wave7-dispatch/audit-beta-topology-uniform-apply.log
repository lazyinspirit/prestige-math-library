const fs=require('fs');
const rows=fs.readFileSync('research/audit/wave7-topology-uniform.provenance.jsonl','utf8').trim().split(/\\n/).map(JSON.parse).filter(r=>r.evidence"'!=='"'established-knowledge');
for(const r of rows){
 const s=fs.readFileSync("'`items/${r.id}.md`,'"'utf8');
 const fm=s.slice(0,s.indexOf('\\n---',4));
 const lines=fm.split('\\n');
 const i=lines.findIndex(x=>x==='sources:');
 console.log("'`${r.id}'"\\n"'${lines.slice(i, Math.min(lines.length,i+8)).join('"'\\n')}"'`);
}
