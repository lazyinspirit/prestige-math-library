research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-333398-+          "source_section": "Statement",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-333399-+          "quote": "Complete normality is hereditary. Consequently $T_5$ is hereditary.",
