research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log:348768:+          "source": "cor-complete-normality-is-hereditary",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-348769-+          "source_section": "Statement",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-348770-+          "quote": "Complete normality is hereditary. Consequently $T_5$ is hereditary.",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-348771-+          "uses": [
