research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218109-+      "citations": [
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218110-+        {
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218111-+          "fact": "A1",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218112-+          "source": "def-countable-choice",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218113-+          "source_section": "Definition",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218114-+          "quote": "The **Axiom of Countable Choice**, written $\\mathrm{AC}_\\omega$, is the following\nstatement.\n\n> For every family $(X_n)_{n \\in \\mathbb{N}}$ of nonempty sets indexed by\n> $\\mathbb{N}$ there is a function $f$ with domain $\\mathbb{N}$ such that\n> $f(n) \\in X_n$ for every $n \\in \\mathbb{N}$.\n\nEquivalently, in the vocabulary of [[def-choice-function]]: every at most\ncountable family of nonempty sets ([[def-countable]]) has a choice function.",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218115-+          "uses": [
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218116-+            "1.1"
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218117-+          ]
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218118-+        },
--
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218120-+          "fact": "L1",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218121-+          "source": "thm-perfectly-normal-implies-completely-normal",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218122-+          "source_section": "Statement",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218123-+          "quote": "**Assume the Axiom of Countable Choice** ([[def-countable-choice]]). Let\n$(X, \\mathcal{T})$ be a perfectly normal space\n([[def-completely-normal-and-perfectly-normal-spaces]]): $X$ is normal\n([[def-normal-and-t4-spaces]]) and every closed subset of $X$ is a $G_\\delta$,\nequivalently every open subset of $X$ is an $F_\\sigma$\n([[def-g-delta-and-f-sigma-in-a-topological-space]]). Then $X$ is **completely\nnormal**: any two separated sets $A, B \\subseteq X$ ([[def-separated-sets]])\nadmit disjoint open $U \\supseteq A$ and $V \\supseteq B$.\n\nConsequently $T_6$ implies $T_5$.\n\n**No continuous function is constructed anywhere in the proof**, and in\nparticular Urysohn's lemma is not used. All that is consumed is normality,\napplied once to each member of a countable family of closed sets, and the\n$F_\\sigma$ presentation of two open sets.\n\n**Where the choice principle is spent, and why it is not removable as written.**\nStep 4.1 selects, for each $n \\in \\mathbb{N}$ at once, one open set $U_n$ out of\nthe nonempty family that normality provides for the closed set $F_n$, and\nlikewise one $V_n$; normality is an existence statement and supplies no rule for\nsingling out a member, so extracting the two sequences is an application of\n$\\mathrm{AC}_\\omega$ and of nothing stronger. The hypothesis is stated in the\ntheorem rather than hidden in the proof, as this library does everywhere.",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218124-+          "uses": [
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218125-+            "1.1"
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218126-+          ]
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218127-+        },
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218128-+        {
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218129-+          "fact": "L2",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log:218130:+          "source": "cor-complete-normality-is-hereditary",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218131-+          "source_section": "Statement",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218132-+          "quote": "Complete normality is hereditary. Consequently $T_5$ is hereditary.",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-218133-+          "uses": [
