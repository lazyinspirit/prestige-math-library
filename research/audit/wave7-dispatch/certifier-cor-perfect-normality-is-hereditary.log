research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log:264309:+          "source": "cor-complete-normality-is-hereditary",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-264310-+          "source_section": "Statement",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-264311-+          "quote": "Complete normality is hereditary. Consequently $T_5$ is hereditary.",
