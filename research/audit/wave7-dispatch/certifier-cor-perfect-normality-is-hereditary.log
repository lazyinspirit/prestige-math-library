research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-310372-+          "source": "def-countable-choice",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-310373-+          "source_section": "Definition",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-310374-+          "quote": "The **Axiom of Countable Choice**, written $\\mathrm{AC}_\\omega$, is the following\nstatement.\n\n> For every family $(X_n)_{n \\in \\mathbb{N}}$ of nonempty sets indexed by\n> $\\mathbb{N}$ there is a function $f$ with domain $\\mathbb{N}$ such that\n> $f(n) \\in X_n$ for every $n \\in \\mathbb{N}$.\n\nEquivalently, in the vocabulary of [[def-choice-function]]: every at most\ncountable family of nonempty sets ([[def-countable]]) has a choice function.",
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-310375-+          "uses": [
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-310376-+            "1.1"
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-310377-+          ]
research/audit/wave7-dispatch/audit-beta-topology-separation-urysohn.log-310378-+        },
