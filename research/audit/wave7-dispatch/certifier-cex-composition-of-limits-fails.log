research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-13715-          ]
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-13716-        },
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-13717-        {
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-13718-          "fact": "L5",
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-13719-          "source": "cor-of-one-positive",
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-13720-          "source_section": "Statement",
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-13721-          "quote": "In any ordered field $F$ with positive cone $P$, the multiplicative identity\nsatisfies $0 < 1$; that is, $1 \\in P$.",
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-13722-          "uses": [
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-13723-            "1.3",
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-13724-            "4.1"
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-13725-          ]
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-13726-        },
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-13727-        {
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-13728-          "fact": "L5",
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-13729-          "source": "def-ordered-field",
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-13730-          "source_section": "Definition",
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-13731-          "quote": "An **ordered field** is a field $F$ ([[def-field]]) together with a subset\n$P \\subseteq F$, the set of **positive** elements (the *positive cone*),\nsatisfying:\n\n- **(O1) Trichotomy.** For each $x \\in F$, exactly one of the following holds:\n  $x \\in P$, or $x = 0$, or $-x \\in P$.\n- **(O2) Closure.** If $x, y \\in P$ then $x + y \\in P$ and $x \\cdot y \\in P$.\n\nWe write $x > 0$ for $x \\in P$ (read \"$x$ is positive\"), and define the order by\n\n$$a < b \\;:\\Longleftrightarrow\\; b - a \\in P, \\qquad a \\le b \\;:\\Longleftrightarrow\\; a < b \\text{ or } a = b.$$\n\nThus $a > b$ means $b < a$, and $a \\ge b$ means $b \\le a$. An element $x$ with\n$-x \\in P$ (equivalently $x < 0$) is called **negative**.",
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-13732-          "uses": [
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-13733-            "1.3",
