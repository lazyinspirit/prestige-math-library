      url: "https://terrytao.wordpress.com/books/analysis-i/"
    - title: "Non-Archimedean ordered field (Wikipedia)"
      url: "https://en.wikipedia.org/wiki/Non-Archimedean_ordered_field"
pipeline_run: null
