        "2.2",
        "L1",
        "1.1",
        "L2"
      ]
    },
    {
      "id": "step-3.1",
      "claim": "Therefore the standard relations form the asserted separated uniformity. [step 2.3, L3, discharge-construct] ∎",
      "step": "3.1",
      "inputs": [
        "2.3",
        "L3"
      ]
