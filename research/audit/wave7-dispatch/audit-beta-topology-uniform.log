+        {
+          "id": "step-1.1",
+          "claim": "Take $\\widehat X$ to be the uniform space of minimal Cauchy filters and take $\\eta$ from [L2]. [L1, L2, construct]",
+          "step": "1.1",
+          "inputs": [
+            "L2",
+            "L1"
