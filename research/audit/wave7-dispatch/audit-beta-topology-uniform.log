+    "lem-entourages-on-minimal-cauchy-filters-form-a-separated-uniformity": {
+      "citations": [
+        {
+          "fact": "L1",
+          "source": "lem-minimal-cauchy-filter-associated-to-a-cauchy-filter",
+          "source_section": "Statement",
+          "quote": "Every Cauchy filter $\\mathcal F$ canonically determines a unique Cauchy filter $m(\\mathcal F)\\subseteq\\mathcal F$ that has no strictly coarser Cauchy filter.",
+          "uses": [
