    "lem-normal-sequences-of-entourages": {
      "citations": [
        {
          "fact": "L1",
          "source": "lem-symmetric-entourages-form-a-base",
          "source_section": "Statement",
          "quote": "If $\\mathcal U$ is a uniformity on $X$, then its symmetric entourages form a filter base: for every $E\\in\\mathcal U$ there is a symmetric $D\\in\\mathcal U$ with $D\\subseteq E$.",
          "uses": [
            "1.1",
            "3.1"
          ]
        },
        {
          "fact": "L2",
          "source": "def-dependent-choice",
          "source_section": "Definition",
          "quote": "The **Axiom of Dependent Choice**, written $\\mathrm{DC}$, is the following\nstatement.",
          "uses": [
            "3.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "step-1.1",
          "claim": "Given a symmetric entourage $E$, choose a symmetric $R$ with $R^{\\circ2}\\subseteq E$, and then a symmetric $D$ with $D^{\\circ2}\\subseteq R$. Since every entourage contains the diagonal, $D\\subseteq R$, and hence $$ D^{\\circ3}\\subseteq R^{\\circ2}\\subseteq E. $$ Thus there exists a symmetric $D\\subseteq E$ with $D^{\\circ3}\\subseteq E$. [L1, construct]",
          "step": "1.1",
          "inputs": [
            "L1"
          ]
        },
        {
          "id": "step-2.1",
          "claim": "The relation $E\\mathrel R D$ meaning that $D$ is symmetric, $D\\subseteq E$, and $D\\circ D\\circ D\\subseteq E$ is serial by step 1.1. [step 1.1]",
          "step": "2.1",
          "inputs": [
            "1.1"
          ]
        },
