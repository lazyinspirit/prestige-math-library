+      ],
+      "derivations": [
+        {
+          "id": "step-1.1",
+          "claim": "Choose an entourage $U$ with $U[x]\\cap C=\\varnothing$ by [L5]. Using dependent choice, take a normal sequence with $E_0=X\\times X$ and $E_1\\subseteq U$. [L4, L5, choose, construct]",
+          "step": "1.1",
+          "inputs": [
