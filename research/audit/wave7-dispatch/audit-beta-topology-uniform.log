+    "thm-countably-based-uniformity-is-pseudometrizable": {
+      "citations": [
+        {
+          "fact": "L1",
+          "source": "lem-countable-uniform-base-normalisation",
+          "source_section": "Statement",
+          "quote": "In ZF, every countably based uniformity has a decreasing symmetric base $(E_n)$ with $E_{n+1}^{\\circ3}\\subseteq E_n$.",
+          "uses": [
+            "1.1"
+          ]
