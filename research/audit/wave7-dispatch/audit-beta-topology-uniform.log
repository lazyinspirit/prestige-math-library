+        {
+          "id": "step-1.3",
+          "claim": "If $x\\in O\\cap P$, choose entourage balls $E[x]\\subseteq O$ and $F[x]\\subseteq P$; then $(E\\cap F)[x]\\subseteq O\\cap P$, so binary intersections are open. [A1]",
+          "step": "1.3",
