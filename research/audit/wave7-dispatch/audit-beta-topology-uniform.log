research/audit/wave1-real-analysis.provenance.jsonl:35:{"id":"lem-of-hom-order-preserving","statement":"ai-altered","proof":"ai-generated","evidence":"established-knowledge","urls":[],"rationale":"The claim is the standard consequence that positives in a complete ordered field are nonzero squares and field homomorphisms preserve nonzero squares, but no reputable source with this domain-and-codomain formulation surfaced after targeted searches. It is established mathematics with a local proof, not an invented bridge; Alpha independently concurred from the current statement and local derivation at A6.","alpha_concurred":true,"at":"2026-08-03"}

