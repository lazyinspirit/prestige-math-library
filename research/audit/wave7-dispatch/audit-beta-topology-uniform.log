+          "step": "1.1",
+          "inputs": [
+            "A1"
+          ]
+        },
+        {
+          "id": "step-1.2",
+          "claim": "An arbitrary union of open sets is open, because a point in the union lies in one member and retains that member's entourage ball. [A1]",
+          "step": "1.2",
+          "inputs": [
+            "A1"
+          ]
