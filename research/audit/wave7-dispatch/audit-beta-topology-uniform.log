+        },
+        {
+          "fact": "L4",
+          "source": "lem-filter-base-generates",
+          "source_section": "Statement",
+          "quote": "Let $X$ be a set and let $\\mathcal{B}$ be a filter base on $X$\n([[def-filter-base]]), with upward closure",
