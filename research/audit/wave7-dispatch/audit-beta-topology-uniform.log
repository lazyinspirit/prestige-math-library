+            "3.1"
+          ]
+        }
+      ],
+      "derivations": [
+        {
+          "id": "step-1.1",
+          "claim": "For symmetric $E$, put $(\\mathcal F,\\mathcal G)\\in\\widehat E$ when some $A\\in\\mathcal F$ and $B\\in\\mathcal G$ satisfy $A\\times B\\subseteq E$. [construct]",
