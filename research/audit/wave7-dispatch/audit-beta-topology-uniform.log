          ]
        },
        {
          "id": "step-2.1",
          "claim": "Uniform continuity supplies a source entourage $U$ whose pairs map into $V$, so $f[U[x]]\\subseteq V[f(x)]\\subseteq N$. [A1, step 1.1]",
          "step": "2.1",
