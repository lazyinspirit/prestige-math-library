    "cor-compact-domain-maps-are-uniformly-continuous": {
      "citations": [
        {
          "fact": "L1",
          "source": "thm-compact-hausdorff-space-has-a-unique-compatible-uniformity",
          "source_section": "Statement",
          "quote": "A compact Hausdorff topology carries exactly one compatible uniformity.",
          "uses": [
            "2.1"
          ]
