--
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-2265-          "fact": "L4",
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-2266-          "source": "lem-bw-implies-cauchy-complete",
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-2267-          "source_section": "Statement",
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json:2268:          "quote": "Let $F$ be an ordered field with the Bolzano-Weierstrass property (BW) of\n[[def-completeness-properties]]. Then $F$ has Cauchy completeness (CC): every\nCauchy sequence in $F$ converges in $F$.\n\nNo Archimedean hypothesis is needed here, and none is hidden: (BW) already\ncarries the Archimedean property on its own\n([[lem-bw-implies-archimedean]]), but that fact is not used below.",
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-2269-          "uses": [
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-2270-            "1.3"
research/audit/wave7-real-analysis-completeness-limits.proof-contracts.json-2271-          ]
