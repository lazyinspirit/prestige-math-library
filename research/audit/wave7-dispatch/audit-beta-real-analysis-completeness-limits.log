const cache=new Map(),scope=[],contracts={};let citeN=0,stepN=0;
for(const id of ids){const {body}=split(fs.readFileSync("'`items/${id}.md`,'"'utf8'));const ff=facts(body),ss=steps(body);if("'!ss.length)continue;scope.push(id);const citations=[];
 for(const f of ff){const uses=ss.filter(s=>tokens(s.text).includes(f.label)).map(s=>s.id);for(const source of new Set(f.links)){if(!cache.has(source))cache.set(source,licensing(source));const sec=cache.get(source);citations.push({fact:f.label,source,source_section:sec.name,quote:sec.text,uses});citeN++}}
