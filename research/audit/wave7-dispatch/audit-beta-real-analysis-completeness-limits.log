function evidenceStep(ss,re){const s=ss.find(x=>re.test(claim(x.text)));return s?"'`step ${s.id}: ${claim(s.text).slice(0,260)}`:null}
function boundarySheet(body,ss){
 const source=SOURCE_SECTIONS.map(x=>sectionText(body,x)).find(Boolean)??'"'';
 const bicond=/if and only if|\\\\Longleftrightarrow|\\\\iff|equivalent/i.test(source);
 const conv=ss.find(x=>/conversely|reverse implication|for the converse|implies.*other|other direction/i.test(claim(x.text)));
