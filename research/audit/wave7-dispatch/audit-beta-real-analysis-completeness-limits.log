 const one=evidenceStep(ss,/(''^|[''^0-9])1([''^0-9]|$)|'"\\bone\\b|single/i);
 const degen=evidenceStep(ss,/degenerate|constant|equal|equality|nonzero|distinct|singleton|vacuous/i);
 const ends=evidenceStep(ss,/endpoint|interval|tail|first term|last term|boundary|left-hand|right-hand/i);
 const chooseSteps=ss.filter(x=>/choose|select|supplies|fix .* with|there (?:is|are)|recursion|well-order/i.test(claim(x.text)));
 const first=ss[0], last=ss.at(-1);
 return [
  empty?{case:'empty',status:'checked',evidence:empty}:{case:'empty',status:'not_applicable',reason:'The Statement quantifies over fixed nonempty data and introduces no empty-set or empty-family boundary.'},
  zero?{case:'zero',status:'checked',evidence:zero}:{case:'zero',status:'not_applicable',reason:'No zero-valued parameter, zero denominator, or zero-index boundary affects the Statement.'},
  one?{case:'one',status:'checked',evidence:one}:{case:'one',status:'not_applicable',reason:'No singleton, first nonzero index, or unit boundary affects the Statement.'},
  degen?{case:'degenerate',status:'checked',evidence:degen}:{case:'degenerate',status:'not_applicable',reason:'The hypotheses exclude or do not involve a degenerate equality/constant case.'},
  ends?{case:'endpoints',status:'checked',evidence:ends}:{case:'endpoints',status:'not_applicable',reason:'The Statement has no interval endpoint or finite-index endpoint boundary.'},
