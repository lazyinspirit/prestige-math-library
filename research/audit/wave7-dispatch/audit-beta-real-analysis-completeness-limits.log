function split(src){const m=src.match(/"'^---'"\\r?\\n([\\s\\S]*?)\\r?\\n---\\r?\\n?([\\s\\S]*)"'$/);return m?{fm:m[1],body:m[2]}:{fm:'"'',body:src}}
function sectionText(body,h){const e=h.replace(/[.*+?"'^${}()|['"\\]\\\\]/g,'\\\\"'$&'"');return body.match(new RegExp("'`''^##'"\\\\s+"'${e}'"\\\\s*"'$'"\\\\r?\\\\n([\\\\s\\\\S]*?)(?="'^##'"\\\\s+|(?"'!['"\\\\s\\\\S]))"'`,'"'m'))?.[1]??''}
