research/audit/wave7-dispatch/audit-beta-topology-uniform.log-270480-+{"id":"def-cauchy-filter-in-a-uniform-space","statement":"literature-derived","proof":"not-applicable","evidence":"exact-source","urls":["https://math.berkeley.edu/~wodzicki/H104.F13/UniformStructure-alt.pdf","https://encyclopediaofmath.org/wiki/Uniform_space"],"rationale":"The sources use the same requirement that for every entourage a filter member have square contained in it; notation and equivalent cover wording are the only differences.","alpha_concurred":false,"at":"2026-08-08"}
research/audit/wave7-dispatch/audit-beta-topology-uniform.log-270481-+{"id":"lem-convergent-filters-are-cauchy","statement":"literature-derived","proof":"ai-altered","evidence":"exact-source","urls":["https://math.berkeley.edu/~wodzicki/H104.F13/UniformStructure-alt.pdf"],"rationale":"Wodzicki Exercise 41 states exactly that every filter convergent in the uniform topology is Cauchy. The item supplies the standard symmetric-root proof, with a missing direct citation proposed at A3.","alpha_concurred":false,"at":"2026-08-08"}
