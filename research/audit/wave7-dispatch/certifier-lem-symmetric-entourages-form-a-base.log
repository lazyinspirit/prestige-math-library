research/audit/wave7-topology-uniform.proof-contracts.json-51-  "contracts": {
research/audit/wave7-topology-uniform.proof-contracts.json:52:    "lem-symmetric-entourages-form-a-base": {
research/audit/wave7-topology-uniform.proof-contracts.json-53-      "citations": [
research/audit/wave7-topology-uniform.proof-contracts.json-54-        {
research/audit/wave7-topology-uniform.proof-contracts.json-55-          "fact": "A1",
research/audit/wave7-topology-uniform.proof-contracts.json-56-          "source": "def-uniform-space-by-entourages",
research/audit/wave7-topology-uniform.proof-contracts.json-57-          "source_section": "Definition",
research/audit/wave7-topology-uniform.proof-contracts.json-58-          "quote": "A **uniformity** on $X$ is a filter $\\mathcal U$ on $X\\times X$ ([[def-filter]]) such that:\n\n- every $E\\in\\mathcal U$ contains $\\Delta_X$;\n- $E\\in\\mathcal U$ implies $E^{-1}\\in\\mathcal U$;\n- for every $E\\in\\mathcal U$ there is $D\\in\\mathcal U$ with $D\\circ D\\subseteq E$.",
research/audit/wave7-topology-uniform.proof-contracts.json-59-          "uses": [
research/audit/wave7-topology-uniform.proof-contracts.json-60-            "1.1",
research/audit/wave7-topology-uniform.proof-contracts.json-61-            "1.2",
research/audit/wave7-topology-uniform.proof-contracts.json-62-            "2.1",
research/audit/wave7-topology-uniform.proof-contracts.json-63-            "2.2"
research/audit/wave7-topology-uniform.proof-contracts.json-64-          ]
--
research/audit/wave7-topology-uniform.proof-contracts.json-185-          "source": "def-uniform-space-by-entourages",
research/audit/wave7-topology-uniform.proof-contracts.json-186-          "source_section": "Definition",
research/audit/wave7-topology-uniform.proof-contracts.json-187-          "quote": "Let $X$ be a set and write $\\Delta_X=\\{(x,x):x\\in X\\}$ for its diagonal ([[def-the-diagonal-of-a-space]]). For $E\\subseteq X\\times X$, put $E[x]:=\\{y\\in X:(x,y)\\in E\\}$, $E^{-1}:=\\{(y,x):(x,y)\\in E\\}$, and $E\\circ F:=\\{(x,z):\\text{some }y\\text{ has }(x,y)\\in E,(y,z)\\in F\\}$.",
research/audit/wave7-topology-uniform.proof-contracts.json-188-          "uses": [
research/audit/wave7-topology-uniform.proof-contracts.json-189-            "1.1",
research/audit/wave7-topology-uniform.proof-contracts.json-190-            "1.2",
research/audit/wave7-topology-uniform.proof-contracts.json-191-            "1.3",
research/audit/wave7-topology-uniform.proof-contracts.json-192-            "3.1"
research/audit/wave7-topology-uniform.proof-contracts.json-193-          ]
research/audit/wave7-topology-uniform.proof-contracts.json-194-        },
research/audit/wave7-topology-uniform.proof-contracts.json-195-        {
research/audit/wave7-topology-uniform.proof-contracts.json-196-          "fact": "A1",
research/audit/wave7-topology-uniform.proof-contracts.json:197:          "source": "lem-symmetric-entourages-form-a-base",
research/audit/wave7-topology-uniform.proof-contracts.json-198-          "source_section": "Statement",
research/audit/wave7-topology-uniform.proof-contracts.json-199-          "quote": "If $\\mathcal U$ is a uniformity on $X$, then its symmetric entourages form a filter base: for every $E\\in\\mathcal U$ there is a symmetric $D\\in\\mathcal U$ with $D\\subseteq E$. More generally, for every entourage $E$ and every integer $n\\ge 1$, there is a symmetric entourage $D$ whose $n$-fold composite satisfies $D^{\\circ n}\\subseteq E$.",
research/audit/wave7-topology-uniform.proof-contracts.json-200-          "uses": [
research/audit/wave7-topology-uniform.proof-contracts.json-201-            "1.1",
research/audit/wave7-topology-uniform.proof-contracts.json-202-            "1.2",
