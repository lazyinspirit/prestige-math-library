research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-691860-+        {
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-691861-+          "fact": "L1",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-691862-+          "source": "def-real-limit",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-691863-+          "source_section": "Definition",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-691864-+          "quote": "A sequence $(x_k)$ of reals **converges** to $x \\in \\mathbb{R}$ when for\nevery rational $\\varepsilon > 0$ there is $K$ with\n$|x_k - x| < \\hat\\varepsilon$ for all $k \\ge K$. It is **Cauchy** when for\nevery rational $\\varepsilon > 0$ there is $K$ with\n$|x_k - x_l| < \\hat\\varepsilon$ for all $k, l \\ge K$.",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-691865-+          "uses": [
