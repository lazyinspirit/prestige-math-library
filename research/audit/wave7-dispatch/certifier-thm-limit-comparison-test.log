research/audit/wave7-dispatch/audit-beta-real-analysis-series.log:608415:+    "thm-limit-comparison-test": {
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-608416-+      "citations": [
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-608417-+        {
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-608418-+          "fact": "L1",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-608419-+          "source": "def-real-limit",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-608420-+          "source_section": "Definition",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-608421-+          "quote": "A sequence $(x_k)$ of reals **converges** to $x \\in \\mathbb{R}$ when for\nevery rational $\\varepsilon > 0$ there is $K$ with\n$|x_k - x| < \\hat\\varepsilon$ for all $k \\ge K$. It is **Cauchy** when for\nevery rational $\\varepsilon > 0$ there is $K$ with\n$|x_k - x_l| < \\hat\\varepsilon$ for all $k, l \\ge K$.",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-608422-+          "uses": [
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-608423-+            "2.1",
--
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-615122-+          "source_section": "Definition",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-615123-+          "quote": "the finite sum of [[def-finite-sum]]. In particular $s_0 = 0$, the empty sum, and\n$s_{n+1} = s_n + a_n$ for every $n$, those being exactly the two recursion clauses\nthat define the finite sum. Note that $s_n$ is the sum of the $n$ terms\n$a_0, \\dots, a_{n-1}$, so the index $n$ counts terms rather than naming the last\none.",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-615124-+          "uses": [
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-615125-+            "1.3"
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-615126-+          ]
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-615127-+        },
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-615128-+        {
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-615129-+          "fact": "L5",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log:615130:+          "source": "thm-limit-comparison-test",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-615131-+          "source_section": "Statement",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-615132-+          "quote": "1. if $(q_k)$ converges with $\\lim_k q_k = L$ for a real $L > 0$\n   ([[def-real-limit]]), then $\\sum a_k$ converges **if and only if** $\\sum b_k$\n   converges;\n2. if $(q_k)$ converges with $\\lim_k q_k = 0$, then convergence of $\\sum b_k$\n   implies convergence of $\\sum a_k$; equivalently, divergence of $\\sum a_k$\n   implies divergence of $\\sum b_k$;\n3. if $(q_k)$ diverges to $+\\infty$ ([[def-divergence-to-infinity]]), then\n   convergence of $\\sum a_k$ implies convergence of $\\sum b_k$; equivalently,\n   divergence of $\\sum b_k$ implies divergence of $\\sum a_k$.",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-615133-+          "uses": [
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-615134-+            "4.1"
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-615135-+          ]
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-615136-+        }
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-615137-+      ],
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-615138-+      "derivations": [
