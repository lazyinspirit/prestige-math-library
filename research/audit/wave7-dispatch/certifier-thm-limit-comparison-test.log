research/audit/wave7-dispatch/audit-beta-real-analysis-series.log:617480:+    "thm-limit-comparison-test": {
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-617481-+      "citations": [
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-617482-+        {
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-617483-+          "fact": "L1",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-617484-+          "source": "def-real-limit",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-617485-+          "source_section": "Definition",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-617486-+          "quote": "A sequence $(x_k)$ of reals **converges** to $x \\in \\mathbb{R}$ when for\nevery rational $\\varepsilon > 0$ there is $K$ with\n$|x_k - x| < \\hat\\varepsilon$ for all $k \\ge K$. It is **Cauchy** when for\nevery rational $\\varepsilon > 0$ there is $K$ with\n$|x_k - x_l| < \\hat\\varepsilon$ for all $k, l \\ge K$.",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-617487-+          "uses": [
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-617488-+            "2.1",
--
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-624187-+          "source_section": "Definition",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-624188-+          "quote": "the finite sum of [[def-finite-sum]]. In particular $s_0 = 0$, the empty sum, and\n$s_{n+1} = s_n + a_n$ for every $n$, those being exactly the two recursion clauses\nthat define the finite sum. Note that $s_n$ is the sum of the $n$ terms\n$a_0, \\dots, a_{n-1}$, so the index $n$ counts terms rather than naming the last\none.",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-624189-+          "uses": [
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-624190-+            "1.3"
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-624191-+          ]
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-624192-+        },
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-624193-+        {
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-624194-+          "fact": "L5",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log:624195:+          "source": "thm-limit-comparison-test",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-624196-+          "source_section": "Statement",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-624197-+          "quote": "1. if $(q_k)$ converges with $\\lim_k q_k = L$ for a real $L > 0$\n   ([[def-real-limit]]), then $\\sum a_k$ converges **if and only if** $\\sum b_k$\n   converges;\n2. if $(q_k)$ converges with $\\lim_k q_k = 0$, then convergence of $\\sum b_k$\n   implies convergence of $\\sum a_k$; equivalently, divergence of $\\sum a_k$\n   implies divergence of $\\sum b_k$;\n3. if $(q_k)$ diverges to $+\\infty$ ([[def-divergence-to-infinity]]), then\n   convergence of $\\sum a_k$ implies convergence of $\\sum b_k$; equivalently,\n   divergence of $\\sum b_k$ implies divergence of $\\sum a_k$.",
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-624198-+          "uses": [
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-624199-+            "4.1"
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-624200-+          ]
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-624201-+        }
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-624202-+      ],
research/audit/wave7-dispatch/audit-beta-real-analysis-series.log-624203-+      "derivations": [
