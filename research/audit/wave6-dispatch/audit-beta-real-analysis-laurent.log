index 0000000000000000000000000000000000000000..ef3f26a549de1f0df86b79ed40ee07230d84f2a9
--- /dev/null
+++ b/.tmp-build-laurent-contract.mjs
@@ -0,0 +1,211 @@
+import { readFileSync, writeFileSync } from 'node:fs';
+
+const ids = [
+  'lem-laurent-series-ring',
+  'lem-laurent-valuation',
+  'thm-laurent-series-field',
+  'thm-laurent-ordered-field',
+  'lem-laurent-non-archimedean',
+  'cor-laurent-not-lub-complete',
+  'thm-laurent-cauchy-complete',
+  'cor-laurent-nested-intervals',
+  'cex-laurent-nested-intervals-empty',
+];
+
+const boundaryText = {
+  'lem-laurent-series-ring': {
+    empty: ['checked', 'The empty convolution index set is handled explicitly at step 2.1, where it gives coefficient 0 below the product support bound.'],
+    zero: ['checked', 'The zero series is covered at steps 3.1, 3.7, and 4.1; closure, the identity distinction, and additive inverses are all checked coefficientwise.'],
+    one: ['checked', 'The singleton convolution case is the monomial calculation at step 3.5 and the identity calculation at step 3.7.'],
+    degenerate: ['checked', 'If either factor is zero, step 2.1 gives an empty nonzero-term set at every coefficient and step 3.1 retains the zero product in K.'],
+    endpoints: ['checked', 'The lower support endpoints m+n and min(m,n) are included correctly at steps 2.1 and 3.1; only indices strictly below them are forced to vanish.'],
+    'nonempty-choice': ['checked', 'The only nonempty selection is the least element at step 1.1, supplied by well-ordering after an explicit translation to N.'],
+  },
+  'lem-laurent-valuation': {
+    empty: ['not_applicable', 'The valuation and leading-coefficient clauses assume both input series are nonzero, so their supports are nonempty.'],
+    zero: ['checked', 'Zero is excluded where v is used, while possible cancellation f+g=0 is isolated explicitly in the hypothesis of clause 5 and at step 1.6.'],
+    one: ['checked', 'At the single leading index p+q, step 1.2 proves that exactly the pair (p,q) contributes.'],
+    degenerate: ['checked', 'Complete leading-term cancellation at equal valuation is excluded in step 1.5 and handled by the general lower bound at step 1.6 when the sum remains nonzero.'],
+    endpoints: ['checked', 'Steps 1.1 and 1.2 distinguish strict indices below p+q from the endpoint p+q itself.'],
+    'nonempty-choice': ['not_applicable', 'No witness is chosen; all leading indices are already supplied by the nonzero hypotheses and the definition of valuation.'],
+  },
+  'thm-laurent-series-field': {
+    empty: ['not_applicable', 'The inverse construction is only for nonzero f, so its support and leading index are nonempty by the statement.'],
+    zero: ['checked', 'The zero coefficient boundary for u and g is treated at steps 1.1, 3.1, 4.2, and 7.1; the theorem correctly does not invert 0_K.'],
+    one: ['checked', 'For f=1_K, the construction gives p=0, c=1, u=0 and g=1_K; steps 2.1 through 8.1 reduce to the identity calculation.'],
+    degenerate: ['checked', 'The degenerate tail u=0 is admitted: step 2.2 makes all positive powers vanish and step 7.1 gives (1_K-u)g=1_K.'],
+    endpoints: ['checked', 'The split at k<0, k=0, and k>=1 is exhaustive and checked separately at steps 3.1, 4.1, 4.2, and 7.1.'],
+    'nonempty-choice': ['checked', 'The powers u^n are supplied uniquely by recursion at step 1.2, and all coefficient sums used to define g are explicit finite sums at step 3.1.'],
+  },
+  'thm-laurent-ordered-field': {
+    empty: ['not_applicable', 'The positive cone is a defined subset of the nonempty field K; the theorem is not an assertion about an empty carrier.'],
+    zero: ['checked', 'Step 1.1 treats f=0_K separately and proves that neither sign lies in P; step 2.3 also checks the canonical natural n=0.'],
+    one: ['checked', 'Step 1.3 proves iota(1)=1_K and step 2.3 starts the canonical-natural induction at n=0 before passing to n+1.'],
+    degenerate: ['checked', 'The equal-valuation addition case, including possible cancellation, is separated at step 2.1; positivity prevents cancellation there.'],
+    endpoints: ['checked', 'The sign boundary lc(f)=0 cannot occur for a nonzero f by the definition, and step 1.1 handles f=0_K independently.'],
+    'nonempty-choice': ['not_applicable', 'No arbitrary witness is chosen; trichotomy and the three exhaustive valuation cases drive steps 1.1 and 2.1.'],
+  },
+  'lem-laurent-non-archimedean': {
+    empty: ['not_applicable', 'All quantified carriers K, Z, and N are fixed nonempty structures, and valuation is only applied after nonzeroness is established.'],
+    zero: ['checked', 'The case h=0_K is handled explicitly at step 2.1, and n=0 is handled explicitly at step 1.2.'],
+    one: ['checked', 'The first positive monomial and canonical natural are admitted without a special exception at steps 1.1 and 1.2.'],
+    degenerate: ['checked', 'If h vanishes through k, step 2.1 covers both h=0_K and the nonzero valuation-above-k case.'],
+    endpoints: ['checked', 'Clause 4 intentionally differs at the endpoint: step 2.1 assumes vanishing for j<=k, while step 1.3 concludes only vanishing for j<k.'],
+    'nonempty-choice': ['checked', 'Step 2.2 obtains k from the explicit cofinality consequence in L5; the remaining construction is deterministic.'],
+  },
+  'cor-laurent-not-lub-complete': {
+    empty: ['checked', 'Step 1.2 proves A is nonempty by displaying 0_K and 1_K.'],
+    zero: ['checked', 'Step 1.2 includes 0_K in A and step 4.1 treats n=0 separately when proving the smaller element is still an upper bound.'],
+    one: ['checked', 'Step 1.3 uses the explicit member 1_K to force every upper bound s to be positive.'],
+    degenerate: ['checked', 'The possible valuation cases v(s)>0 and v(s)=0 are both refuted at step 2.1, leaving exactly v(s)<0.'],
+    endpoints: ['checked', 'Step 4.2 uses strict coefficient halving c/2<c, so the constructed upper bound cannot coincide with s.'],
+    'nonempty-choice': ['checked', 'Step 2.1 invokes the Archimedean witness n only after c>0 is established; step 3.1 then defines s prime explicitly.'],
+  },
+  'thm-laurent-cauchy-complete': {
+    empty: ['not_applicable', 'A sequence is a total function on N, so it has at least its index-0 term; every threshold set M_k is proved nonempty at step 1.1.'],
+    zero: ['checked', 'The threshold k=0 is included and is used at step 3.2 to obtain one uniform lower support bound for the limit.'],
+    one: ['checked', 'A constant sequence is covered: step 2.1 makes every coefficient stable and step 5.1 gives convergence to that constant series.'],
+    degenerate: ['checked', 'If all terms are 0_K, the constructed L is 0_K at step 2.3 and its support-boundedness and convergence follow at steps 3.2 and 5.1.'],
+    endpoints: ['checked', 'The shift from the strict conclusion j<k+1 to j<=k is made explicitly at step 2.1, and step 5.1 uses vanishing through k to get the strict bound t^-k.'],
+    'nonempty-choice': ['checked', 'Every M_k is nonempty by Cauchyness and N_k is defined as its least element at step 1.1, so no countable choice is used.'],
+  },
+  'cor-laurent-nested-intervals': {
+    empty: ['checked', 'Each interval is nonempty because a_n<=b_n, used at step 1.1, and step 6.1 explicitly constructs a point in the full intersection.'],
+    zero: ['checked', 'The initial interval I_0 and threshold indices equal to 0 are included in the monotonicity and Cauchy arguments at steps 2.1 and 3.1.'],
+    one: ['checked', 'A constant singleton interval sequence has zero lengths; steps 3.1 through 6.1 return its unique endpoint.'],
+    degenerate: ['checked', 'Intervals with a_n=b_n are admitted; step 1.2 proves uniqueness and step 6.1 proves existence without requiring positive length.'],
+    endpoints: ['checked', 'Closed endpoints are retained by the nonstrict inequalities proved at steps 5.1 and 5.2.'],
+    'nonempty-choice': ['checked', 'Step 4.1 uses the existential limit supplied by Cauchy completeness; all later arguments apply to that fixed witness and no repeated choices occur.'],
+  },
+  'cex-laurent-nested-intervals-empty': {
+    empty: ['checked', 'The conclusion is precisely that the full intersection is empty, proved by the incompatible valuation bounds at step 5.1.'],
+    zero: ['checked', 'The endpoint a_0=0_K is handled separately at steps 1.1 and 2.1.'],
+    one: ['checked', 'The endpoint a_1=t^-1 is identified at step 1.1 and supplies positivity of a hypothetical common point at step 3.1.'],
+    degenerate: ['checked', 'Every interval is proved genuinely nonempty at step 2.1, while their common intersection is proved empty at step 5.1.'],
+    endpoints: ['checked', 'All interval inequalities are nonstrict, and equality at an endpoint is included in the contradictions at steps 4.1 and 4.2.'],
+    'nonempty-choice': ['checked', 'The two Archimedean witnesses used at steps 4.1 and 4.2 are licensed by L6 after their positive real inputs are established.'],
+  },
+};
+
+for (const value of Object.values(boundaryText)) {
+  value['iff-forward'] = ['not_applicable', 'The statement is not a biconditional, so there is no forward implication boundary to audit.'];
+  value['iff-reverse'] = ['not_applicable', 'The statement is not a biconditional, so there is no reverse implication boundary to audit.'];
+}
+
+function read(id) {
+  return readFileSync(`items/${id}.md`, 'utf8');
+}
+
+function bodyOf(source) {
+  return source.replace(/^---\n[\s\S]*?\n---\n/, '');
+}
+
+function section(source, name) {
+  const body = bodyOf(source);
+  const match = body.match(new RegExp(`^## ${name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\n\\n([\\s\\S]*?)(?=^## |\\s*$)`, 'm'));
+  if (!match) throw new Error(`missing ${name}`);
+  return match[1].trim();
+}
+
+function sourceSection(id) {
+  const source = read(id);
+  for (const name of ['Statement', 'Statement refuted', 'Definition', 'Example']) {
+    try { return { name, text: section(source, name) }; } catch {}
+  }
+  throw new Error(`no source section for ${id}`);
+}
+
+function tokens(text) {
+  const stop = new Set(['the','and','for','with','that','this','from','then','when','into','every','one','its','are','has','have','not','only','let','exactly','where','which','all']);
+  return new Set((text.toLowerCase().match(/[a-z]{3,}|\\[a-z]+|[a-z]+_[a-z]+/g) ?? []).filter((x) => !stop.has(x)));
+}
+
+function bestQuote(source, factText) {
+  const { name, text } = sourceSection(source);
+  const blocks = text.split(/\n\n+/).map((x) => x.trim()).filter(Boolean);
+  const wanted = tokens(factText.replace(/\[\[[^\]]+\]\]/g, ''));
+  let best = blocks[0];
+  let bestScore = -1;
+  for (const block of blocks) {
+    const have = tokens(block);
+    let score = 0;
+    for (const token of wanted) if (have.has(token)) score += token.length > 6 ? 2 : 1;
+    score /= Math.max(1, Math.sqrt(have.size));
+    if (score > bestScore) { best = block; bestScore = score; }
+  }
+  return { source_section: name, quote: best };
+}
+
+function facts(source) {
+  const block = bodyOf(source).match(/^## Facts & Assumptions\n([\s\S]*?)(?=^## (?:Proof|Counterexample))/m)?.[1] ?? '';
+  return [...block.matchAll(/^\[([LAF]\d+)\] ([\s\S]*?)(?=\n\n\[[LAF]\d+\]|\s*$)/gm)].map((m) => ({
+    label: m[1],
+    text: m[2].trim(),
+    links: [...new Set([...m[2].matchAll(/\[\[([^\]|#]+)(?:#[^\]|]+)?(?:\|[^\]]+)?\]\]/g)].map((x) => x[1]))],
+  }));
+}
+
+function steps(source) {
+  const proof = bodyOf(source).match(/^## (?:Proof|Counterexample)\n([\s\S]*?)(?=^## |\s*$)/m)?.[1] ?? '';
+  return [...proof.matchAll(/^([0-9]+\.[0-9]+) ([\s\S]*?)(?=\n\n[0-9]+\.[0-9]+ |\s*$)/gm)].map((m) => ({ id: m[1], text: m[2].trim() }));
+}
+
+function explicitUses(text, label) {
+  return new RegExp(`(?:^|[^A-Z0-9])${label}(?:$|[^A-Z0-9])`).test(text);
+}
+
+function inputs(text) {
+  const result = [];
+  const push = (value) => { if (!result.includes(value)) result.push(value); };
+  for (const match of text.matchAll(/\b([LAF]\d+)\b/g)) push(match[1]);
+  for (const match of text.matchAll(/\b(?:step|steps)\s+([0-9]+\.[0-9]+)\b/g)) push(`step ${match[1]}`);
+  for (const bracket of text.matchAll(/\[([^\]]+)\]/g)) {
+    for (const raw of bracket[1].split(',')) {
+      const token = raw.trim();
+      if (/^(?:given|construct|choose|algebra|contradiction|discharge-[a-z-]+)$/.test(token)) push(token);
+    }
+  }
+  if (!result.length) push('given');
+  return result;
+}
+
+function boundaries(id) {
+  return Object.entries(boundaryText[id]).map(([name, [status, explanation]]) =>
+    status === 'checked'
+      ? { case: name, status, evidence: explanation }
+      : { case: name, status, reason: explanation });
+}
+
+const contracts = {};
+for (const id of ids) {
+  const source = read(id);
+  const itemSteps = steps(source);
+  const citations = [];
+  for (const fact of facts(source)) {
+    const uses = itemSteps.filter((step) => explicitUses(step.text, fact.label)).map((step) => step.id);
+    for (const target of fact.links) {
+      citations.push({ fact: fact.label, source: target, ...bestQuote(target, fact.text), uses });
+    }
+  }
+  contracts[id] = {
+    citations,
+    derivations: itemSteps.map((step) => ({
+      id: `step-${step.id}`,
+      claim: step.text.replace(/\s*\[[^\]]+\]\s*(?:∎)?$/, '').trim(),
+      step: step.id,
+      inputs: inputs(step.text),
+    })),
+    routine_steps: [],
+    boundaries: boundaries(id),
+    finite_smoke: [],
+  };
+}
+
+const output = {
+  version: 1,
+  level: 'audit-wave6-real-analysis-laurent',
+  scope: ids,
+  contracts,
+};
+
+writeFileSync('research/audit/wave6-real-analysis-laurent.proof-contracts.json', `${JSON.stringify(output, null, 2)}\n`);

apply patch
