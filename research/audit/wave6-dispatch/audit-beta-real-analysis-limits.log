        { "id": "tail-estimate", "claim": "Combine the Cauchy estimate with the triangle bound.", "step": "2.1", "inputs": ["step 1.1", "step 1.2", "algebra"] },
        { "id": "finite-anchor", "claim": "Select a finite maximum covering the prefix and tail anchor.", "step": "2.2", "inputs": ["step 1.1", "choose"] },
