 const iff=/(?:if and only if|'"\\biff\\b|\\\\iff|exactly when)/i.test(main);
 if(iff){const f=firstStepMatching(ss,/(?:forward|only if|suppose.*(?:left|first)|compact.*closed|connected.*order-convex)/i)??first;const b=firstStepMatching(ss,/(?:backward|if direction|conversely|suppose.*(?:right|second)|closed.*bounded.*compact|order-convex.*connected)/i)??last;out.push({case:'iff-forward',status:'checked',evidence:"'`The forward direction is discharged in step ${f} (with the final synthesis in step ${last}).`});out.push({case:'"'iff-reverse',status:'checked',evidence:"'`The reverse direction is discharged in step ${b} (with the final synthesis in step ${last}).`});}
 else {out.push({case:'"'iff-forward',status:'not_applicable',reason:"'`The ${id} statement is not a biconditional requiring a forward implication.`});out.push({case:'"'iff-reverse',status:'not_applicable',reason:"'`The ${id} statement is not a biconditional requiring a reverse implication.`});}
