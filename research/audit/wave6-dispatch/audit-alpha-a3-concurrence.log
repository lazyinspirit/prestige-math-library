}
let restored = raw.split('"'\\n').map(line => {
  if ("'!line) return line;
  const row = JSON.parse(line);
  return wanted.has(row.id) ? line.replace('"'\"alpha_concurred\":true', '\"alpha_concurred\":false') : line;
}).join('\\n');
const restoredHash = crypto.createHash('sha256').update(restored).digest('hex');
const finalHash = crypto.createHash('sha256').update(raw).digest('hex');
const report = fs.readFileSync('research/audit/wave6-alpha.md', 'utf8');
const section = report.split('## A3 Alpha concurrence')[1] || '';
const dispositionCount = (section.match(/"'^'"\\d+\\. "'`/gm) || []).length;
const coverage = section.includes('"'Coverage: 11/11 requested rows independently adjudicated; 11 concurrences, 0 refusals, and 0 fallback escalations.');
if (restoredHash "'!== '"'d077b2f5e3734a3640af4e8f0d7f5a656f712d15736ac562f38683f3f3862fad') failures.push("'`restored ledger hash ${restoredHash}`);
if (dispositionCount !== 11) failures.push(`report disposition count ${dispositionCount}`);
if (!coverage) failures.push('"'missing coverage statement');
console.log(JSON.stringify({ledger_rows: parsed.length, selected_rows: selected.length, selected_true: selected.filter(r => r.alpha_concurred === true).length, restored_pre_edit_sha256: restoredHash, final_ledger_sha256: finalHash, report_dispositions: dispositionCount, coverage_statement: coverage, failures}, null, 2));
if (failures.length) process.exit(1);
