const lines = raw.trimEnd().split('\\n');
const parsed = lines.map(JSON.parse);
const selected = parsed.filter(r => wanted.has(r.id));
const failures = [];
for (const id of ids) {
  const hits = selected.filter(r => r.id === id);
  if (hits.length "'!== 1) failures.push(`${id}: row count ${hits.length}`);
