kind: lemma
title: "Every Cauchy sequence of rationals is bounded"
status: published
origin: session
provenance:
  statement: ai-altered
  proof: ai-altered
deps: [def-rational-cauchy-sequence, lem-rat-triangle]
aliases: []
proof_strategy: direct
