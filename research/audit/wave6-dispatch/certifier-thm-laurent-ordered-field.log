research/audit/wave6-real-analysis-laurent.proof-contracts.json-1337-          "fact": "L3",
research/audit/wave6-real-analysis-laurent.proof-contracts.json-1338-          "source": "thm-of-archimedean",
research/audit/wave6-real-analysis-laurent.proof-contracts.json-1339-          "source_section": "Statement",
research/audit/wave6-real-analysis-laurent.proof-contracts.json:1340:          "quote": "Every complete ordered field $F$ ([[def-complete-ordered-field]]) is Archimedean:\nfor every $x \\in F$ there is a natural number $n \\ge 1$ with $x < n \\cdot 1_F$,\nwhere $n \\cdot 1_F$ is the canonical natural of the ordered field $F$\n([[def-ordered-field]]). Equivalently, the canonical naturals are cofinal in $F$.",
