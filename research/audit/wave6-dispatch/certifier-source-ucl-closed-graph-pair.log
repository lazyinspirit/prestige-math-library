research/audit/wave1-number-theory.provenance.jsonl-16-{"id":"thm-gcd-and-lcm-from-valuations","statement":"ai-altered","proof":"ai-generated","evidence":"semantic-source","urls":["https://www.cs.cmu.edu/~sutner/pdf/60-modari.pdf","https://math.libretexts.org/Bookshelves/Combinatorics_and_Discrete_Mathematics/A_Spiral_Workbook_for_Discrete_Mathematics_%28Kwong%29/05%3A_Basic_Number_Theory/5.06%3A_Fundamental_Theorem_of_Arithmetic"],"rationale":"The sources give the minimum-exponent gcd and maximum-exponent lcm rules. The item adds positivity/definedness and proves that the recipes characterize the library's existing gcd and lcm.","alpha_concurred":false,"at":"2026-08-03"}
research/audit/wave1-number-theory.provenance.jsonl-17-{"id":"lem-p-adic-valuation-on-q","statement":"ai-altered","proof":"ai-generated","evidence":"semantic-source","urls":["https://www.math.uchicago.edu/~may/VIGRE/VIGRE2011/REUPapers/Herwig.pdf","https://www.math.toronto.edu/~ila/Neukirch_Algebraic_number_theory.pdf"],"rationale":"The sources define v_p(a/b)=v_p(a)-v_p(b) on nonzero rationals and state well-definedness, additivity, and the ultrametric inequality. The item reconstructs these through the library's quotient representatives and embeddings.","alpha_concurred":false,"at":"2026-08-03"}
research/audit/wave1-number-theory.provenance.jsonl-18-{"id":"cor-rational-root-of-an-integer-is-an-integer","statement":"ai-altered","proof":"ai-generated","evidence":"semantic-source","urls":["https://www.math.toronto.edu/vtk/246Winter2015/hw6sol.pdf"],"rationale":"The source proves that a rational kth root of a natural integer is an integer by the rational-root theorem. The item gives the signed-integer version in the library's rational embedding and proves it by valuations.","alpha_concurred":false,"at":"2026-08-03"}
