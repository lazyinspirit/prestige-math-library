  console.log(frozenPrompt);
  console.error(`\n[dump-prompt] frozen prompt ${frozenPrompt.length} chars`);
  process.exit(0);
}
if (bools.has("context-hash")) {
  console.log(JSON.stringify({ id, context_sha256: contextSha256, item_sha256: itemSha256 }));
  process.exit(0);
}

