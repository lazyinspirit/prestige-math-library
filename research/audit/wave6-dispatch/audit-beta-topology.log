+    else:
+        by_case["empty"] = {"case":"empty","status":"checked","evidence":f"statement and step {first}: the empty-domain or empty-space instance is vacuous or formula-defined and selects no point"}
+
+    if item_id == "thm-the-closed-graph-criterion-over-a-compact-hausdorff-codomain":
+        by_case["zero"] = {"case":"zero","status":"checked","evidence":"step 6.1 explicitly treats the n=0 finite-subcover intersection as X"}
+    elif item_id in {"fs-a-function-with-closed-graph-is-continuous", "cex-a-closed-graph-without-continuity"}:
+        by_case["zero"] = {"case":"zero","status":"checked","evidence":"steps 1.1 through 4.1 separately treat the function value and graph fibre at x=0"}
+    elif item_id in {"thm-punctured-rn-deformation-retracts-onto-the-sphere", "cor-punctured-rn-homotopy-equivalent-to-the-sphere", "ex-radial-deformation-retraction-of-punctured-rn"}:
