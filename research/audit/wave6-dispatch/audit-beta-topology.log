+        "ex-straight-line-homotopy-between-maps-into-rn": "step 2.1 verifies H(x,0)=f(x) and H(x,1)=g(x)",
+        "ex-intervals-and-euclidean-spaces-are-contractible": "step 2.1 invokes contractions with identity and constant endpoints",
+        "ex-a-point-and-r-are-homotopy-equivalent-not-homeomorphic": "step 2.1 supplies both composite endpoint conditions",
+        "ex-a-two-point-retract-that-is-not-a-deformation-retract": "step 1.2 uses the identity-to-retraction endpoint condition",
+        "ex-a-cylinder-deformation-retracts-onto-an-end": "step 1.3 computes K(-,0), K(-,1), and the fixed-end condition",
+        "ex-radial-deformation-retraction-of-punctured-rn": "step 1.1 checks both homotopy endpoints and the fixed sphere",
+        "ex-path-homotopy-through-straight-segments-in-a-convex-set": "step 1.2 checks both time endpoints and both fixed path endpoints",
+    }
+    choice_checks = {
+        "lem-a-sequence-in-a-hausdorff-space-has-at-most-one-limit": "step 4.1 takes the larger of two already supplied natural numbers, so no family choice is hidden",
+        "thm-the-closed-graph-criterion-over-a-compact-hausdorff-codomain": "step 5.1 applies finite choice only after each indexed set of admissible boxes is proved nonempty",
+        "lem-a-locally-compact-hausdorff-space-has-a-base-of-open-sets-with-compact-closure": "steps 1.1 and 3.1 instantiate witnesses only for the fixed point and fixed neighbourhood",
+        "fs-a-function-with-closed-graph-is-continuous": "step 2.1 fixes a continuity radius only after the cited local continuity statement supplies one",
+        "fs-two-continuous-maps-agreeing-on-a-dense-subset-are-equal": "step 1.3 chooses one irrational from the cited nonempty set; no family of choices is used",
+        "ex-the-diagonal-in-the-cofinite-and-cocountable-topologies": "step 2.1 instantiates one point from the already nonempty intersection U cap W",
+        "ex-two-continuous-real-functions-agreeing-on-the-rationals-are-equal": "step 1.1 instantiates one point and one rational only after the relevant open set and interval are nonempty",
+        "cex-two-maps-into-an-indiscrete-space-agreeing-on-a-dense-set": "steps 1.2 and 1.3 instantiate one rational and one irrational from cited nonempty sets",
+        "ex-separating-a-point-from-a-finite-set-in-a-hausdorff-space": "step 2.1 applies finite choice to sets proved nonempty from the cover condition; n=0 is vacuous",
+        "cor-a-retract-of-a-contractible-space-is-contractible": "step 1.1 uses the single point already supplied by the nullhomotopy witness",
+        "cor-homotopy-equivalence-bijection-on-path-components": "step 1.2 fixes an already quantified point x; it makes no simultaneous choice over components",
+    }
+
+    by_case = {entry["case"]: entry for entry in result}
+    if item_id in fixed_nonempty:
+        by_case["empty"] = {"case":"empty","status":"not_applicable","reason":"the statement fixes or assumes nonempty spaces or named points, so an empty carrier cannot satisfy its hypotheses"}
+    else:
+        by_case["empty"] = {"case":"empty","status":"checked","evidence":f"statement and step {first}: the empty-domain or empty-space instance is vacuous or formula-defined and selects no point"}
+
+    if item_id == "thm-the-closed-graph-criterion-over-a-compact-hausdorff-codomain":
+        by_case["zero"] = {"case":"zero","status":"checked","evidence":"step 6.1 explicitly treats the n=0 finite-subcover intersection as X"}
+    elif item_id in {"fs-a-function-with-closed-graph-is-continuous", "cex-a-closed-graph-without-continuity"}:
+        by_case["zero"] = {"case":"zero","status":"checked","evidence":"steps 1.1 through 4.1 separately treat the function value and graph fibre at x=0"}
+    elif item_id in {"thm-punctured-rn-deformation-retracts-onto-the-sphere", "cor-punctured-rn-homotopy-equivalent-to-the-sphere", "ex-radial-deformation-retraction-of-punctured-rn"}:
+        by_case["zero"] = {"case":"zero","status":"checked","evidence":"the statement excludes the origin and the cited radial formula is used only on the punctured domain"}
+    elif item_id == "ex-separating-a-point-from-a-finite-set-in-a-hausdorff-space":
+        by_case["zero"] = {"case":"zero","status":"checked","evidence":"steps 1.1 through 3.1 allow n=0 and make the finite subcover and finite-choice argument vacuous"}
+    elif item_id in dimensions_at_least_one:
+        by_case["zero"] = {"case":"zero","status":"not_applicable","reason":"the statement assumes n>=1, so the zero-dimensional case is outside its hypotheses"}
+    else:
+        by_case["zero"] = {"case":"zero","status":"not_applicable","reason":"no independently varying cardinal, dimension, norm, or scalar parameter has a separate zero case"}
+
+    if item_id in dimensions_at_least_one:
+        by_case["one"] = {"case":"one","status":"checked","evidence":f"statement and step {first}: the displayed Euclidean formulas remain valid for n=1"}
+    elif item_id in {"thm-hausdorff-iff-the-diagonal-is-closed", "lem-a-sequence-in-a-hausdorff-space-has-at-most-one-limit", "thm-a-compact-hausdorff-space-is-regular-and-normal", "ex-a-finite-hausdorff-space-is-discrete", "ex-separating-a-point-from-a-finite-set-in-a-hausdorff-space"}:
+        by_case["one"] = {"case":"one","status":"checked","evidence":f"statement and step {first}: the singleton-space or singleton-subset instance is included and all separation conditions become vacuous or immediate"}
+    else:
+        by_case["one"] = {"case":"one","status":"not_applicable","reason":"no independently varying cardinal, dimension, or index has a separate one case"}
+
+    if item_id in degenerate_checks:
+        by_case["degenerate"] = {"case":"degenerate","status":"checked","evidence":degenerate_checks[item_id]}
+    else:
+        by_case["degenerate"] = {"case":"degenerate","status":"not_applicable","reason":"the statement has no separate coincident-map, constant-map, singleton, or collapsed-parameter branch"}
+
+    if item_id in endpoint_checks:
+        by_case["endpoints"] = {"case":"endpoints","status":"checked","evidence":endpoint_checks[item_id]}
+    else:
+        by_case["endpoints"] = {"case":"endpoints","status":"not_applicable","reason":"no interval endpoint or one-sided boundary enters the statement or proof"}
+
+    if item_id in choice_checks:
+        by_case["nonempty-choice"] = {"case":"nonempty-choice","status":"checked","evidence":choice_checks[item_id]}
+    else:
+        by_case["nonempty-choice"] = {"case":"nonempty-choice","status":"not_applicable","reason":"the proof uses only formula-defined maps, fixed quantified data, and cited implications; it selects from no asserted nonempty family"}
+    result = [by_case[name] for name in BOUNDARIES]
+    return result
+
+
+manifest = json.load(open(MANIFEST, encoding="utf-8"))
+all_ids = [item["id"] for page in manifest for item in page["items"]]
+# Quote clauses afresh from the current target text. Reusing older contracts can
+# import a clause chosen for a different fact in the same target item.
+bank = collections.defaultdict(list)
+scope = []
+contracts = {}
+diagnostics = []
+for item_id in all_ids:
+    body, _ = body_and_frontmatter(item_id)
+    steps = parse_steps(body)
+    if not steps:
+        continue
+    scope.append(item_id)
+    facts = parse_facts(body)
+    citations = []
+    for fact in facts:
+        uses = [step_id for step_id, text in steps if fact["label"] in tokens(text)]
+        for source in fact["links"]:
+            heading, quote, score = choose_quote(fact["text"], source, bank)
+            citations.append({
+                "fact": fact["label"],
+                "source": source,
+                "source_section": heading,
+                "quote": quote,
+                "uses": uses,
+            })
+            diagnostics.append((score, item_id, fact["label"], source, quote))
+    derivations = []
+    for step_id, claim in steps:
+        inputs = tokens(claim)
+        if not inputs:
+            inputs = ["statement hypotheses and the definitions or objects introduced in this step"]
+        derivations.append({"id":"step-" + step_id, "claim":claim, "step":step_id, "inputs":inputs})
+    contracts[item_id] = {
+        "citations": citations,
+        "derivations": derivations,
+        "routine_steps": [],
+        "boundaries": worksheet(item_id, body, steps),
+        "finite_smoke": [],
+    }
+
+document = {"version":1, "level":"audit-wave6-topology", "scope":scope, "contracts":contracts}
+with open(OUTPUT, "w", encoding="utf-8") as handle:
+    json.dump(document, handle, indent=2, ensure_ascii=False)
+    handle.write("\n")
+
+print(f"wrote {OUTPUT}: {len(scope)} contracts, {sum(len(c['citations']) for c in contracts.values())} citations, {sum(len(c['derivations']) for c in contracts.values())} steps")
+print("lowest quote scores:")
+for score, item_id, fact, source, quote in sorted(diagnostics)[:80]:
+    print(f"{score:6.2f} {item_id} {fact} -> {source}: {quote[:150]}")
