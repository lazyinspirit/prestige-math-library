+        "thm-two-maps-into-a-convex-set-are-homotopic",
+        "cor-convex-subsets-of-rn-are-contractible",
+        "cor-contractible-spaces-are-path-connected",
+        "thm-punctured-rn-deformation-retracts-onto-the-sphere",
