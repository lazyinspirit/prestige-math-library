+        "lem-real-line-is-a-metric-space": [(r".", "2. For $x \\in \\mathbb{R}$")],
+        "lem-real-and-metric-notions-agree": [(r".", "1. **Continuity.**")],
+        "def-homeomorphism-and-open-maps": [(r".", "$f$ is a **homeomorphism**")],
+    }
+    if source not in rules:
+        return None
+    normalized_paragraphs = [normalize(p) for p in re.split(r"\n\s*\n", text) if normalize(p)]
+    for fact_pattern, marker in rules[source]:
+        if not re.search(fact_pattern, fact_for_matching, re.I):
+            continue
+        for paragraph in normalized_paragraphs:
+            if marker in paragraph:
+                return heading, paragraph, score_quote(fact, paragraph)
+    return None
+
+
+def quote_bank():
+    bank = collections.defaultdict(list)
+    for path in glob.glob(os.path.join(ROOT, "research", "**", "*.proof-contracts.json"), recursive=True):
+        if path == OUTPUT:
+            continue
+        try:
+            document = json.load(open(path, encoding="utf-8"))
+        except Exception:
+            continue
+        for contract in document.get("contracts", {}).values():
+            for citation in contract.get("citations", []):
+                if citation.get("source") and citation.get("quote") and citation.get("source_section"):
+                    bank[citation["source"]].append((citation["source_section"], citation["quote"]))
+    return bank
+
+
+def choose_quote(fact, source, bank):
+    heading, text = source_record(source)
+    norm_text = normalize(text)
+    marked = marked_quote(fact, source, heading, text)
+    if marked:
+        return marked
+    choices = []
+    for bank_heading, quote in bank.get(source, []):
+        if bank_heading == heading and normalize(quote) in norm_text:
+            choices.append(quote)
+    choices.extend(candidates(text))
+    quote = max(choices, key=lambda q: score_quote(fact, q))
+    # Avoid duplicating an enormous section when a shorter semantically closer clause exists.
+    if len(quote.split()) > 90:
+        short = [q for q in choices if 3 <= len(q.split()) <= 90]
+        if short:
+            quote = max(short, key=lambda q: score_quote(fact, q))
+    return heading, quote, score_quote(fact, quote)
+
+
+def parse_facts(body):
+    out = []
+    for paragraph in re.split(r"\n\s*\n", section(body, "Facts & Assumptions")):
+        match = re.match(r"^\[([FAL]\d+)\]\s*(.*)$", paragraph.strip(), re.S)
+        if not match:
+            continue
+        out.append({
+            "label": match.group(1),
+            "text": normalize(match.group(2)),
+            "links": re.findall(r"\[\[([^\]|]+)(?:\|[^\]]*)?\]\]", paragraph),
+        })
+    return out
+
+
+def parse_steps(body):
+    out = []
+    for heading in PROOF_HEADINGS:
+        for line in section(body, heading).splitlines():
+            match = re.match(r"^(\d+\.\d+)\s+(.+)$", line)
+            if match:
+                out.append((match.group(1), match.group(2)))
+    return out
+
+
+def tokens(text):
+    out = []
+    for match in re.finditer(r"\b(?:step\s+)?(\d+\.\d+)\b|\b([FAL]\d+)\b", text):
+        token = match.group(1) or match.group(2)
+        if token not in out:
+            out.append(token)
+    return out
+
+
+def first_step_matching(steps, patterns):
+    for step_id, text in steps:
+        if any(re.search(pattern, text, re.I) for pattern in patterns):
+            return step_id
+    return None
+
