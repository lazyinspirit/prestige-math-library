+    }
+    degenerate_checks = {
+        "cor-the-agreement-set-of-two-maps-into-a-hausdorff-space-is-closed": "statement and step 1.1: when the two maps coincide, the agreement set is the whole domain and the same inverse-image identity applies",
+        "cor-two-continuous-maps-into-a-hausdorff-space-agreeing-on-a-dense-set-are-equal": "statement and steps 1.1 through 3.1 include the coincident-map case",
+        "lem-a-sequence-in-a-hausdorff-space-has-at-most-one-limit": "steps 1.1 and 6.1 isolate equality of the two proposed limits as the degenerate conclusion",
+        "ex-a-finite-hausdorff-space-is-discrete": "statement and steps 1.1 through 4.1 remain valid for an empty or one-point finite space",
