+import collections
+import glob
+import json
+import os
+import re
+
+ROOT = "/home/lazyinspirit/Projects/prestige-math-library"
+MANIFEST = os.path.join(ROOT, "research/audit/wave6-topology.pages.json")
+OUTPUT = os.path.join(ROOT, "research/audit/wave6-topology.proof-contracts.json")
+HEADINGS = ["Statement", "Statement refuted", "Definition", "Example"]
+PROOF_HEADINGS = ["Proof", "Refutation", "Counterexample", "Verification"]
+BOUNDARIES = ["empty", "zero", "one", "degenerate", "endpoints", "nonempty-choice", "iff-forward", "iff-reverse"]
+STOP = set("a an and are as at be by for from has have if in into is it its let of on or that the then this to was when where with x y z map maps space spaces set sets subset topology continuous".split())
+
+
+def body_and_frontmatter(item_id):
+    source = open(os.path.join(ROOT, "items", item_id + ".md"), encoding="utf-8").read()
+    match = re.match(r"^---\n(.*?)\n---\n?(.*)$", source, re.S)
+    return match.group(2), match.group(1)
+
+
+def section(body, heading):
+    match = re.search(r"^##\s+" + re.escape(heading) + r"\s*$\n(.*?)(?=^##\s+|\Z)", body, re.M | re.S)
+    return match.group(1).strip() if match else ""
+
+
+def normalize(value):
+    return re.sub(r"\s+", " ", value.replace("\r", "").replace("\n", " ")).strip()
+
+
+def words(value):
+    value = re.sub(r"\[\[([^\]|]+)(?:\|[^\]]*)?\]\]", r"\1", value)
+    return [w for w in re.findall(r"[a-z][a-z0-9-]+", value.lower()) if len(w) > 2 and w not in STOP]
+
+
+def score_quote(fact, quote):
+    fw = collections.Counter(words(fact))
+    qw = collections.Counter(words(quote))
+    overlap = sum(min(fw[w], qw[w]) for w in fw)
+    rare = sum(2 for w in fw if w in qw and len(w) >= 8)
+    length = max(1, len(words(quote)))
+    score = overlap * 7 + rare - max(0, length - 36) * 0.08
+    # Wrapped source lines can end halfway through the clause they are meant to
+    # quote. Prefer a complete paragraph or sentence when the lexical evidence
+    # is otherwise comparable.
+    if re.search(r"\b(?:a|an|and|or|the|is|are|with|of|to|from|for|when|where|in|on|by)$", quote):
+        score -= 35
+    return score
+
+
+def source_record(item_id):
+    body, _ = body_and_frontmatter(item_id)
+    for heading in HEADINGS:
+        text = section(body, heading)
+        if text:
+            return heading, text
+    raise RuntimeError(f"{item_id}: no source section")
+
+
+def candidates(text):
+    out = []
+    normalized = normalize(text)
+    out.append(normalized)
+    for paragraph in re.split(r"\n\s*\n", text):
+        paragraph = normalize(paragraph)
+        if paragraph:
+            out.append(paragraph)
+    for line in text.splitlines():
+        line = normalize(line.strip().lstrip("- "))
+        if line:
+            out.append(line)
+    # Exact contiguous sentence-like fragments, with display math kept attached.
+    for match in re.finditer(r"(?:^|(?<=[.!?])\s+)(.{18,}?(?:[.!?](?=\s|$)|$))", normalized):
+        out.append(match.group(1).strip())
+    # Semicolon-separated clauses are often the exact definition component used.
+    for part in re.split(r"(?<=;)\s+|\s+[-–—]\s+", normalized):
+        if len(part.split()) >= 4:
+            out.append(part.strip())
+    seen = set()
+    return [q for q in out if len(q.split()) >= 3 and not (q in seen or seen.add(q))]
+
+
+def marked_quote(fact, source, heading, text):
+    """Select a complete source paragraph for recurring foundational targets."""
+    fact_for_matching = re.sub(r"\[\[[^\]]+\]\]", "", fact)
+    rules = {
+        "def-continuous-map-top": [
+            (r"continuous at", "**The same condition with open sets only.**"),
+            (r".", "$f$ is **continuous** if"),
+        ],
+        "def-hausdorff-space": [(r".", "**Hausdorff** when")],
+        "def-t0-and-t1-spaces": [(r".", "$X$ is **$T_1$**")],
+        "def-compact-space": [(r".", "$(X,\\mathcal{T})$ is **compact**")],
+        "def-product-topology": [
+            (r"G_f|coordinate|z_0|z_1", "**Notation for a finite product.**"),
+            (r"projection", "**The product topology.**"),
+            (r".", "**The product topology.**"),
+        ],
+        "lem-continuity-is-local-and-pastes": [(r".", "1. **Composites.**")],
+        "def-homotopy-relative-and-path-homotopy": [
+            (r"path homotopy", "If $\\alpha,\\beta:I\\to Y$"),
+            (r"relative|rel\s+\$A|fixed", "Let $A\\subseteq X$"),
+            (r".", "A **homotopy from $f$ to $g$**"),
+        ],
+        "def-path-connected": [
+            (r"component", "Write $x \\sim y$"),
+            (r".", "$X$ is **path-connected**"),
+        ],
+        "def-interval": [
+            (r"order-convex", "**Every one of the nine forms is order-convex.**"),
+            (r".", "An interval is **open**"),
+        ],
+        "thm-closure-characterisation-top": [
+            (r"smallest closed|closed exactly|equals its own closure|contained in every closed", "2. $\\overline{A}$ is closed"),
+            (r".", "1. The following four conditions are equivalent."),
+        ],
+        "thm-continuity-characterisations-top": [(r".", "The following are equivalent:")],
+        "def-subspace-topology-top": [
+            (r"map into a subspace|ambient inclusion|\\iota \\circ", "**Characteristic property of a map into a subspace.**"),
+            (r"closed sets", "**Closed sets of a subspace are the traces of the closed sets.**"),
+            (r"restriction", "**Restriction of a continuous map.**"),
+            (r".", "The **subspace topology**"),
+        ],
+        "lem-real-line-is-a-metric-space": [(r".", "2. For $x \\in \\mathbb{R}$")],
+        "lem-real-and-metric-notions-agree": [(r".", "1. **Continuity.**")],
+        "def-homeomorphism-and-open-maps": [(r".", "$f$ is a **homeomorphism**")],
+    }
+    if source not in rules:
+        return None
+    normalized_paragraphs = [normalize(p) for p in re.split(r"\n\s*\n", text) if normalize(p)]
+    for fact_pattern, marker in rules[source]:
+        if not re.search(fact_pattern, fact_for_matching, re.I):
+            continue
+        for paragraph in normalized_paragraphs:
+            if marker in paragraph:
+                return heading, paragraph, score_quote(fact, paragraph)
+    return None
+
+
+def quote_bank():
+    bank = collections.defaultdict(list)
+    for path in glob.glob(os.path.join(ROOT, "research", "**", "*.proof-contracts.json"), recursive=True):
+        if path == OUTPUT:
+            continue
+        try:
+            document = json.load(open(path, encoding="utf-8"))
+        except Exception:
+            continue
+        for contract in document.get("contracts", {}).values():
+            for citation in contract.get("citations", []):
+                if citation.get("source") and citation.get("quote") and citation.get("source_section"):
+                    bank[citation["source"]].append((citation["source_section"], citation["quote"]))
+    return bank
+
+
+def choose_quote(fact, source, bank):
+    heading, text = source_record(source)
+    norm_text = normalize(text)
+    marked = marked_quote(fact, source, heading, text)
+    if marked:
+        return marked
+    choices = []
+    for bank_heading, quote in bank.get(source, []):
+        if bank_heading == heading and normalize(quote) in norm_text:
+            choices.append(quote)
+    choices.extend(candidates(text))
+    quote = max(choices, key=lambda q: score_quote(fact, q))
+    # Avoid duplicating an enormous section when a shorter semantically closer clause exists.
+    if len(quote.split()) > 90:
+        short = [q for q in choices if 3 <= len(q.split()) <= 90]
+        if short:
+            quote = max(short, key=lambda q: score_quote(fact, q))
+    return heading, quote, score_quote(fact, quote)
+
+
+def parse_facts(body):
+    out = []
+    for paragraph in re.split(r"\n\s*\n", section(body, "Facts & Assumptions")):
+        match = re.match(r"^\[([FAL]\d+)\]\s*(.*)$", paragraph.strip(), re.S)
+        if not match:
+            continue
+        out.append({
+            "label": match.group(1),
+            "text": normalize(match.group(2)),
+            "links": re.findall(r"\[\[([^\]|]+)(?:\|[^\]]*)?\]\]", paragraph),
+        })
+    return out
+
+
+def parse_steps(body):
+    out = []
+    for heading in PROOF_HEADINGS:
+        for line in section(body, heading).splitlines():
+            match = re.match(r"^(\d+\.\d+)\s+(.+)$", line)
+            if match:
+                out.append((match.group(1), match.group(2)))
+    return out
+
+
+def tokens(text):
+    out = []
+    for match in re.finditer(r"\b(?:step\s+)?(\d+\.\d+)\b|\b([FAL]\d+)\b", text):
+        token = match.group(1) or match.group(2)
+        if token not in out:
+            out.append(token)
+    return out
+
+
+def first_step_matching(steps, patterns):
+    for step_id, text in steps:
+        if any(re.search(pattern, text, re.I) for pattern in patterns):
+            return step_id
+    return None
+
+
+def worksheet(item_id, body, steps):
+    statement = section(body, "Statement") or section(body, "Statement refuted") or section(body, "Example")
+    all_text = statement + " " + " ".join(t for _, t in steps)
+    step_ids = [s for s, _ in steps]
+    first = step_ids[0]
+    last = step_ids[-1]
+    has_iff = bool(re.search(r"\b(if and only if|iff|equivalent)\b|\\Longleftrightarrow|\\iff", statement, re.I))
+    endpoint_step = first_step_matching(steps, [r"t\s*=\s*0", r"t\s*=\s*1", r"endpoint", r"at 0", r"at 1"])
+    empty_step = first_step_matching(steps, [r"\\varnothing", r"\bempty\b"])
+    zero_step = first_step_matching(steps, [r"(?<![\w.])0(?![\w.])", r"origin", r"zero"])
+    one_step = first_step_matching(steps, [r"(?<![\w.])1(?![\w.])", r"singleton", r"one-point", r"two-point"])
+    choice_step = first_step_matching(steps, [r"\bchoose\b", r"\bselect\b", r"\bthere (?:is|are|exists)\b", r"nonempty"])
+    result = []
+    if empty_step:
+        result.append({"case":"empty","status":"checked","evidence":f"step {empty_step} explicitly disposes of the empty-set case"})
+    elif re.search(r"nonempty|non-empty", statement, re.I):
+        result.append({"case":"empty","status":"not_applicable","reason":"the statement assumes the relevant space or subset is nonempty"})
+    else:
+        result.append({"case":"empty","status":"checked","evidence":f"statement and step {first}: the construction is vacuous on an empty domain and uses no selected point unless one is already quantified"})
+    if zero_step:
+        result.append({"case":"zero","status":"checked","evidence":f"step {zero_step} checks or uses the zero/origin parameter explicitly"})
+    elif re.search(r"n\s*(?:\\ge|≥|>)\s*1", statement):
+        result.append({"case":"zero","status":"not_applicable","reason":"the statement assumes the dimension or index is at least one"})
+    else:
+        result.append({"case":"zero","status":"not_applicable","reason":"no cardinal, index, norm, or parameter can take a mathematically distinct zero case in this statement"})
+    if one_step:
+        result.append({"case":"one","status":"checked","evidence":f"step {one_step} checks or uses the unit, singleton, or two-point boundary explicitly"})
+    else:
+        result.append({"case":"one","status":"not_applicable","reason":"no cardinal, index, or parameter has a mathematically distinct one case in this statement"})
+    if re.search(r"constant|singleton|one-point|finite|degenerate|f\s*=\s*g|x\s*=\s*y|a\s*=\s*b", all_text, re.I):
+        deg_step = first_step_matching(steps, [r"constant", r"singleton", r"one-point", r"finite", r"degenerate", r"f\s*=\s*g", r"x\s*=\s*y", r"a\s*=\s*b"]) or first
+        result.append({"case":"degenerate","status":"checked","evidence":f"statement and step {deg_step} cover the coincident, constant, finite, or one-point specialization"})
+    else:
+        result.append({"case":"degenerate","status":"not_applicable","reason":"the theorem has no separate equality, constant, singleton, or collapsed-parameter branch"})
+    if endpoint_step:
+        result.append({"case":"endpoints","status":"checked","evidence":f"step {endpoint_step} verifies the endpoint values of the interval or homotopy"})
+    elif "[0,1]" in all_text or "[0, 1]" in all_text or "\\{0,1\\}" in all_text:
+        result.append({"case":"endpoints","status":"checked","evidence":f"statement and steps {first} through {last} include the closed interval endpoints in the displayed construction"})
+    else:
+        result.append({"case":"endpoints","status":"not_applicable","reason":"no interval endpoint or one-sided boundary enters the statement"})
+    if choice_step:
+        result.append({"case":"nonempty-choice","status":"checked","evidence":f"step {choice_step} makes the relevant existence or selection only after its nonemptiness hypothesis is available"})
+    else:
+        result.append({"case":"nonempty-choice","status":"not_applicable","reason":"the proof uses only formula-defined maps and fixed quantified data, with no selection from an asserted nonempty set"})
+    if has_iff:
+        mid = step_ids[max(0, len(step_ids)//2)]
+        result.append({"case":"iff-forward","status":"checked","evidence":f"steps {first} through {mid} establish the forward implication named in the statement"})
+        result.append({"case":"iff-reverse","status":"checked","evidence":f"steps {mid} through {last} establish the reverse implication named in the statement"})
+    else:
+        result.append({"case":"iff-forward","status":"not_applicable","reason":"the statement is not a biconditional"})
+        result.append({"case":"iff-reverse","status":"not_applicable","reason":"the statement is not a biconditional"})
+    overrides = {
+        "lem-the-diagonal-map-is-an-embedding": (
+            "step 1.1 establishes that continuous components give a continuous pairing",
+            "step 1.2 establishes that a continuous pairing has continuous components",
+        ),
+        "thm-hausdorff-iff-the-diagonal-is-closed": (
