@@ -0,0 +1,91 @@
+import json
+
+ROOT = "/home/lazyinspirit/Projects/prestige-math-library"
+OUT = ROOT + "/research/audit/wave6-topology.provenance.jsonl"
+AT = "https://pi.math.cornell.edu/~hatcher/AT/AT.pdf"
+AT0 = "https://pi.math.cornell.edu/~hatcher/AT/ATch0.pdf"
+TOP = "https://pi.math.cornell.edu/~hatcher/Top/TopNotes.pdf"
+STACKS = "https://stacks.math.columbia.edu/tag/08ZD"
+ETH = "https://n.ethz.ch/~kimha/download/lecture-notes/04-topo.pdf"
+CORK = "https://cora.ucc.ie/server/api/core/bitstreams/f8605f64-38a4-41a6-9b49-fd208cde9d04/content"
+CAM = "https://www.dpmms.cam.ac.uk/~or257/teaching/notes/TopSp.pdf"
+MCKAY = "https://ben-mckay.github.io/benmckay.github.io/files/topology-lecture-notes.pdf"
+PROOFWIKI = "https://proofwiki.org/wiki/Closed_Graph_Theorem/Compact_Hausdorff_Codomain"
+UCL = "https://www.ucl.ac.uk/~ucahad0/2010/3103_handout_7.pdf"
+TORONTO = "https://www.math.toronto.edu/~alfonso/MC/topologyMC14_V2.pdf"
+COCOUNTABLE = "https://en.wikipedia.org/wiki/Cocountable_topology"
+PADUA = "https://www.math.unipd.it/~maraston/Topologia2/Topo2_1011_homotopy.pdf"
+POSTECH = "https://gt.postech.ac.kr/~jccha/intro-geom-top-lecture-1-2023-spring/"
+MIT = "https://ocw.mit.edu/courses/18-905-algebraic-topology-i-fall-2016/2dad3dd8354992d877fbeca4049817ee_MIT18_905F16_lecture_notes.pdf"
+MIT901 = "https://math.mit.edu/~pieloch/teaching/18.901-spring-2025/18.901-spring-2025-Lecture-Notes.pdf"
+PLANET = "https://planetmath.org/diagonalembedding"
+
+
+rows = [
+ ("def-the-diagonal-of-a-space","ai-altered","not-applicable","semantic-source",[PLANET,STACKS],"The diagonal subset and diagonal embedding are standard; this item also packages the pairing construction and product-basis convention, so it is a semantic reassembly rather than an exact transcription."),
+ ("lem-the-diagonal-map-is-an-embedding","ai-altered","ai-generated","semantic-source",[PLANET],"The source states that the diagonal map is an embedding and homeomorphism onto its image. The item adds the binary pairing criterion and spells out the inverse projection, without changing the result."),
+ ("thm-hausdorff-iff-the-diagonal-is-closed","literature-derived","ai-altered","exact-source",[STACKS],"Stacks, Topology Lemma 5.3.1, has exactly the same arbitrary-space hypotheses and both directions. The proof is expanded into the library's closure-and-basis vocabulary."),
+ ("cor-the-agreement-set-of-two-maps-into-a-hausdorff-space-is-closed","literature-derived","ai-altered","exact-source",[ETH],"The ETH notes state and solve the equalizer result, explicitly noting that it extends to parallel continuous maps into an arbitrary Hausdorff codomain."),
+ ("cor-two-continuous-maps-into-a-hausdorff-space-agreeing-on-a-dense-set-are-equal","literature-derived","ai-altered","exact-source",[CORK],"The notes give the same domain, Hausdorff-codomain, continuity, density, and equality conclusion via the closed equalizer."),
+ ("lem-a-sequence-in-a-hausdorff-space-has-at-most-one-limit","literature-derived","ai-altered","exact-source",[CAM],"The Cambridge notes state and prove that a sequence in a Hausdorff topological space has at most one limit, with the same neighbourhood definition."),
+ ("thm-a-compact-hausdorff-space-is-regular-and-normal","ai-altered","ai-altered","semantic-source",[TOP],"Hatcher proves compact Hausdorff spaces normal and proves the point-versus-compact separation used for regularity. His normal convention includes Hausdorffness; the item translates this into the library's separate regular/normal and T3/T4 clauses."),
+ ("lem-the-graph-of-a-continuous-map-into-a-hausdorff-space-is-closed","literature-derived","ai-altered","exact-source",[STACKS],"Stacks Topology Lemma 5.3.2 has exactly an arbitrary domain, Hausdorff codomain, continuous map, and closed graph conclusion."),
+ ("thm-the-closed-graph-criterion-over-a-compact-hausdorff-codomain","literature-derived","ai-generated","exact-source",[PROOFWIKI],"The cited theorem states exactly that for an arbitrary domain and compact Hausdorff codomain, continuity is equivalent to closedness of the graph. The item's open-box proof is local and makes its finite-choice cost explicit."),
+ ("lem-a-locally-compact-hausdorff-space-has-a-base-of-open-sets-with-compact-closure","literature-derived","ai-generated","exact-source",[MCKAY],"McKay's Exercise 1.68 states the equivalent basis-of-precompact-open-sets formulation and its consequence for every open neighbourhood, with Hausdorffness ensuring compact closure."),
+ ("rem-what-the-diagonal-criterion-gives-and-what-it-costs","ai-generated","not-applicable","trivial",[],"This is a bespoke synthesis of the diagonal pullback method and the formula-defined-family versus finite-choice distinction. Each mathematical assertion is read directly from the cited on-disk theorem and definitions."),
+ ("fs-a-function-with-closed-graph-is-continuous","literature-derived","ai-generated","exact-source",[UCL],"The UCL notes give the same function, f(x)=1/x off 0 with an arbitrary assigned value at 0, as a closed-graph discontinuous counterexample."),
+ ("fs-two-continuous-maps-agreeing-on-a-dense-subset-are-equal","ai-altered","ai-generated","semantic-source",[CORK,COCOUNTABLE],"The standard theorem in the first source includes the indispensable Hausdorff-codomain hypothesis; the cocountable/indiscrete facts in the second source license the item's explicit failure when that hypothesis is removed."),
+ ("ex-the-diagonal-of-the-real-line-is-closed","ai-altered","ai-generated","semantic-source",[STACKS],"This is the real-line specialization of the closed-diagonal characterization, with the standard interval-and-triangle-inequality witness written out."),
+ ("ex-the-diagonal-in-the-cofinite-and-cocountable-topologies","ai-altered","ai-generated","semantic-source",[TORONTO,COCOUNTABLE,CAM],"The sources give the cofinite and cocountable definitions, their non-Hausdorff behaviour on infinite or uncountable carriers, and discreteness on countable carriers; the item translates these through the closed-diagonal theorem."),
+ ("ex-the-graph-of-a-continuous-real-function-is-closed","ai-altered","ai-generated","semantic-source",[STACKS],"This is the real-line specialization of Stacks Topology Lemma 5.3.2."),
+ ("cex-a-closed-graph-without-continuity","literature-derived","ai-generated","exact-source",[UCL],"The source gives exactly f(x)=1/x for x nonzero with f(0)=0 as a function with closed graph that is not continuous."),
+ ("ex-two-continuous-real-functions-agreeing-on-the-rationals-are-equal","ai-altered","ai-generated","semantic-source",[CORK],"This is the standard dense-set uniqueness theorem specialized to the dense rational subspace of the real line and a Hausdorff real codomain."),
+ ("cex-two-maps-into-an-indiscrete-space-agreeing-on-a-dense-set","ai-generated","ai-generated","trivial",[],"The particular constant/characteristic-function witness into a two-point indiscrete codomain is a bespoke construction. Continuity, density, agreement on the rationals, and inequality off them follow immediately from the cited on-disk definitions."),
+ ("ex-a-finite-hausdorff-space-is-discrete","literature-derived","ai-generated","exact-source",[CAM],"The Cambridge notes explicitly state that the cofinite topology on a finite set is discrete and, equivalently through closed singletons, every finite Hausdorff space is discrete."),
