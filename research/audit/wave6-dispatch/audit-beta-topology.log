+        "ex-the-graph-of-a-continuous-real-function-is-closed",
+        "cex-a-closed-graph-without-continuity",
+        "ex-two-continuous-real-functions-agreeing-on-the-rationals-are-equal",
+        "cex-two-maps-into-an-indiscrete-space-agreeing-on-a-dense-set",
+        "ex-separating-a-point-from-a-finite-set-in-a-hausdorff-space",
+        "cor-contractible-iff-identity-nullhomotopic",
+        "cor-a-retract-of-a-contractible-space-is-contractible",
+        "thm-two-maps-into-a-convex-set-are-homotopic",
+        "cor-convex-subsets-of-rn-are-contractible",
+        "cor-contractible-spaces-are-path-connected",
+        "thm-punctured-rn-deformation-retracts-onto-the-sphere",
+        "cor-punctured-rn-homotopy-equivalent-to-the-sphere",
+        "fs-a-retract-must-be-a-deformation-retract",
+        "fs-homotopy-equivalent-spaces-are-homeomorphic",
+        "ex-intervals-and-euclidean-spaces-are-contractible",
+        "ex-a-point-and-r-are-homotopy-equivalent-not-homeomorphic",
+        "ex-a-two-point-retract-that-is-not-a-deformation-retract",
+        "ex-radial-deformation-retraction-of-punctured-rn",
+        "ex-path-homotopy-through-straight-segments-in-a-convex-set",
+    }
+    dimensions_at_least_one = {
+        "lem-straight-line-homotopies-are-continuous",
+        "thm-two-maps-into-a-convex-set-are-homotopic",
+        "cor-convex-subsets-of-rn-are-contractible",
+        "thm-punctured-rn-deformation-retracts-onto-the-sphere",
+        "cor-punctured-rn-homotopy-equivalent-to-the-sphere",
+        "ex-straight-line-homotopy-between-maps-into-rn",
+        "ex-intervals-and-euclidean-spaces-are-contractible",
+        "ex-radial-deformation-retraction-of-punctured-rn",
+        "ex-path-homotopy-through-straight-segments-in-a-convex-set",
+    }
+    degenerate_checks = {
+        "cor-the-agreement-set-of-two-maps-into-a-hausdorff-space-is-closed": "statement and step 1.1: when the two maps coincide, the agreement set is the whole domain and the same inverse-image identity applies",
+        "cor-two-continuous-maps-into-a-hausdorff-space-agreeing-on-a-dense-set-are-equal": "statement and steps 1.1 through 3.1 include the coincident-map case",
+        "lem-a-sequence-in-a-hausdorff-space-has-at-most-one-limit": "steps 1.1 and 6.1 isolate equality of the two proposed limits as the degenerate conclusion",
+        "ex-a-finite-hausdorff-space-is-discrete": "statement and steps 1.1 through 4.1 remain valid for an empty or one-point finite space",
+        "ex-separating-a-point-from-a-finite-set-in-a-hausdorff-space": "steps 1.1 through 4.1 include the empty and singleton finite-subset cases",
+        "lem-homotopy-reflexive-and-symmetric": "steps 1.1 and 2.1 explicitly construct the constant-in-time homotopy for coincident endpoint maps",
+        "thm-homotopy-equivalence-is-an-equivalence-relation": "step 1.1 explicitly handles the identity-space and identity-map specialization",
+        "lem-straight-line-homotopies-are-continuous": "statement and steps 1.1 through 5.1 remain valid when the two maps coincide or the convex target is a singleton",
+        "thm-two-maps-into-a-convex-set-are-homotopic": "steps 1.1 through 2.1 include the coincident-map and singleton-target cases",
+        "cor-convex-subsets-of-rn-are-contractible": "steps 1.1 and 2.1 include a singleton convex subset",
+        "cor-contractible-spaces-are-path-connected": "steps 2.1 and 3.1 include equal endpoints and one-point spaces",
+        "fs-a-retract-must-be-a-deformation-retract": "steps 1.1 through 2.1 use a genuinely two-point discrete witness; the one-point degeneration would not refute the claim",
+        "fs-homotopy-equivalent-spaces-are-homeomorphic": "steps 1.1 through 3.1 use spaces with genuinely different cardinalities",
+        "ex-straight-line-homotopy-between-maps-into-rn": "steps 1.1 through 2.1 include the case f=g",
