+    result = [by_case[name] for name in BOUNDARIES]
+    return result
+
+
+manifest = json.load(open(MANIFEST, encoding="utf-8"))
+all_ids = [item["id"] for page in manifest for item in page["items"]]
+# Quote clauses afresh from the current target text. Reusing older contracts can
+# import a clause chosen for a different fact in the same target item.
+bank = collections.defaultdict(list)
+scope = []
+contracts = {}
+diagnostics = []
+for item_id in all_ids:
+    body, _ = body_and_frontmatter(item_id)
+    steps = parse_steps(body)
+    if not steps:
+        continue
+    scope.append(item_id)
+    facts = parse_facts(body)
+    citations = []
+    for fact in facts:
+        uses = [step_id for step_id, text in steps if fact["label"] in tokens(text)]
+        for source in fact["links"]:
+            heading, quote, score = choose_quote(fact["text"], source, bank)
+            citations.append({
+                "fact": fact["label"],
+                "source": source,
+                "source_section": heading,
+                "quote": quote,
+                "uses": uses,
+            })
+            diagnostics.append((score, item_id, fact["label"], source, quote))
+    derivations = []
+    for step_id, claim in steps:
+        inputs = tokens(claim)
+        if not inputs:
+            inputs = ["statement hypotheses and the definitions or objects introduced in this step"]
+        derivations.append({"id":"step-" + step_id, "claim":claim, "step":step_id, "inputs":inputs})
+    contracts[item_id] = {
+        "citations": citations,
+        "derivations": derivations,
+        "routine_steps": [],
+        "boundaries": worksheet(item_id, body, steps),
+        "finite_smoke": [],
+    }
+
+document = {"version":1, "level":"audit-wave6-topology", "scope":scope, "contracts":contracts}
+with open(OUTPUT, "w", encoding="utf-8") as handle:
+    json.dump(document, handle, indent=2, ensure_ascii=False)
+    handle.write("\n")
+
+print(f"wrote {OUTPUT}: {len(scope)} contracts, {sum(len(c['citations']) for c in contracts.values())} citations, {sum(len(c['derivations']) for c in contracts.values())} steps")
+print("lowest quote scores:")
+for score, item_id, fact, source, quote in sorted(diagnostics)[:80]:
+    print(f"{score:6.2f} {item_id} {fact} -> {source}: {quote[:150]}")
