+        "ex-path-homotopy-through-straight-segments-in-a-convex-set": "step 1.2 checks both time endpoints and both fixed path endpoints",
+    }
+    choice_checks = {
+        "lem-a-sequence-in-a-hausdorff-space-has-at-most-one-limit": "step 4.1 takes the larger of two already supplied natural numbers, so no family choice is hidden",
