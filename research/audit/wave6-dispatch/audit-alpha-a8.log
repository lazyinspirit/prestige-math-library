for(const n of names){const j=JSON.parse(fs.readFileSync(dir+n,'utf8')); Object.assign(contracts,j.contracts); scope.push(...j.scope); console.log(n,'sha',crypto.createHash('sha256').update(fs.readFileSync(dir+n)).digest('hex'),'scope',j.scope.length,'contracts',Object.keys(j.contracts).length);}
console.log('merged sha',crypto.createHash('sha256').update(fs.readFileSync(dir+'wave6-proof-contracts.json')).digest('hex'),'scope',merged.scope.length,'contracts',Object.keys(merged.contracts).length);
console.log('scope exact',JSON.stringify(scope)===JSON.stringify(merged.scope),'contracts exact',JSON.stringify(contracts)===JSON.stringify(merged.contracts),'unique',new Set(scope).size);
