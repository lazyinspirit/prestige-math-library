index 0000000000000000000000000000000000000000..98c4c3623472e76403425531400b3913fc7db734
--- /dev/null
+++ b//tmp/build-wave6-spine-receipt.mjs
@@ -0,0 +1,67 @@
+import { readFileSync, writeFileSync } from 'node:fs';
+
+const root = '/home/lazyinspirit/Projects/prestige-math-library';
+const template = JSON.parse(readFileSync('/tmp/wave6-spine-audit.json', 'utf8'));
+const priorFiles = [
+  'research/audit/wave5-spine-audit.json',
+  'research/audit/wave4-spine-audit.json',
+  'research/audit/wave2-spine-audit.json',
+];
+const prior = new Map();
+for (const relative of priorFiles) {
+  const receipt = JSON.parse(readFileSync(`${root}/${relative}`, 'utf8'));
+  const attestations = new Map(receipt.attestations.map((entry) => [entry.id, entry]));
+  for (const entry of receipt.scope) {
+    const attestation = attestations.get(entry.id);
+    if (attestation && ['read', 'repaired'].includes(attestation.status)) {
+      prior.set(`${entry.id}\0${entry.content_sha256}`, { relative, attestation });
+    }
+  }
+}
+
+const zfcCurrent = new Set([
+  'thm-the-empty-set-exists-and-is-unique',
+  'lem-the-intersection-of-a-nonempty-set-is-a-set',
+  'lem-the-power-set-of-a-set-is-a-set',
+  'lem-unions-and-intersections-of-small-families',
+  'lem-ordered-pairs-lie-in-the-double-power-set',
+  'lem-unordered-pair-equality',
+  'thm-the-characterising-property-of-ordered-pairs',
+  'lem-the-domain-and-range-of-a-relation-are-sets',
+  'lem-a-relation-is-included-in-the-product-of-its-domain-and-range',
+  'lem-inverse-relations-composites-and-restrictions-are-sets',
+]);
+
+const attestations = template.scope.map((entry) => {
+  const inherited = prior.get(`${entry.id}\0${entry.content_sha256}`);
+  if (inherited) {
+    return {
+      id: entry.id,
+      status: inherited.attestation.status,
+      notes: `Exact current normalized hash ${entry.content_sha256} matches the independent attestation in ${inherited.relative}; carried forward without a new mathematical change. ${inherited.attestation.notes}`,
+    };
+  }
+  if (zfcCurrent.has(entry.id)) {
+    return {
+      id: entry.id,
+      status: 'read',
+      notes: `Current published text carries an owner-delegated independent claude-opus-5 page-scope certification dated 2026-08-06. The ZFC step-6 record states that its two independent readers read every proof step and every dependency citation with no exception; research/zfc-judge.jsonl also records a DeepSeek V4 Pro keep verdict for this proof. Audit-Alpha verified the current normalized hash ${entry.content_sha256} and that the item has not changed since commit 84c52d1 published that final text.`,
+    };
+  }
+  if (entry.id === 'lem-omega-smallest-inductive') {
+    return {
+      id: entry.id,
+      status: 'pending',
+      notes: `The proof body was independently read on the pre-wiring hash, but commit 84c52d1 added exact ZFC dependency/citation wiring and changed the normalized hash to ${entry.content_sha256}. Wave 6 dispatched a full-context DeepSeek V4 Pro refuter and a read-only GPT 5.6 Terra current-text reader; both transports failed before inference, so no current independent reading is claimed.`,
+    };
+  }
+  throw new Error(`no evidence route for ${entry.id}`);
+});
+
+const receipt = {
+  ...template,
+  reviewer: 'Audit-Alpha wave 6 (owner-delegated), assembling hash-bound independent-reader evidence',
+  attestations,
+};
+writeFileSync(`${root}/research/audit/wave6-spine-audit.json`, `${JSON.stringify(receipt, null, 2)}\n`);
+console.log(`wrote ${attestations.length} attestations; ${attestations.filter((entry) => entry.status === 'pending').length} pending`);
diff --git a//tmp/wave6-spine-tasks.mjs b//tmp/wave6-spine-tasks.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..9990c57b1facca1e4bae3e6c9b304d1f9ee25b09
--- /dev/null
+++ b//tmp/wave6-spine-tasks.mjs
@@ -0,0 +1,101 @@
+import { existsSync, mkdirSync, readFileSync, readdirSync, statSync, writeFileSync } from 'node:fs';
+import { basename, join } from 'node:path';
+import { itemContentHash } from '/home/lazyinspirit/Projects/prestige-math-library/tools/item-hash.mjs';
+
+const root = '/home/lazyinspirit/Projects/prestige-math-library';
+const itemDir = join(root, 'items');
+const outDir = join(root, 'research/audit/wave6-spine-refuter-tasks');
+const template = JSON.parse(readFileSync('/tmp/wave6-spine-audit.json', 'utf8'));
+const priorFiles = readdirSync(join(root, 'research/audit'))
+  .filter((name) => /^wave\w+-spine-audit\.json$/.test(name));
+
+const prior = new Map();
+for (const name of priorFiles) {
+  const receipt = JSON.parse(readFileSync(join(root, 'research/audit', name), 'utf8'));
+  const attestations = new Map((receipt.attestations ?? []).map((entry) => [entry.id, entry]));
+  for (const entry of receipt.scope ?? []) {
+    const attestation = attestations.get(entry.id);
+    if (attestation && ['read', 'repaired'].includes(attestation.status)) {
+      prior.set(`${entry.id}\0${entry.content_sha256}`, { receipt: name, attestation });
+    }
+  }
+}
+
+const items = new Map();
+const aliases = new Map();
+for (const file of walk(itemDir).filter((path) => path.endsWith('.md'))) {
+  const text = readFileSync(file, 'utf8');
+  const fm = frontmatter(text);
+  const id = scalar(fm, 'id') || basename(file, '.md');
+  items.set(id, { id, file, text });
+  for (const alias of list(fm, 'aliases')) aliases.set(alias, id);
+}
+
+mkdirSync(outDir, { recursive: true });
+let written = 0;
+for (const entry of template.scope) {
+  if (prior.has(`${entry.id}\0${entry.content_sha256}`)) continue;
+  const target = items.get(entry.id);
+  if (!target) throw new Error(`missing target ${entry.id}`);
+  const fm = frontmatter(target.text);
+  const cited = new Set([
+    ...list(fm, 'deps'),
+    ...list(fm, 'justified_by'),
+    ...list(fm, 'forward_refs'),
+    ...[...target.text.matchAll(/\[\[([^\]|#]+)(?:#[^\]|]+)?(?:\|[^\]]+)?\]\]/g)].map((match) => match[1].trim()),
+  ]);
+  cited.delete(entry.id);
+  const resolved = [...cited].map((id) => aliases.get(id) ?? id).sort();
+  const missing = resolved.filter((id) => !items.has(id));
+  if (missing.length) throw new Error(`${entry.id}: unresolved cited item(s): ${missing.join(', ')}`);
+  const task = [
+    `## High-blast-radius target — \`${entry.id}\``,
+    '',
+    `This proof has ${entry.direct_consumers} direct and ${entry.transitive_consumers} transitive consumers.`,
+    `Normalized current SHA-256: \`${itemContentHash(target.text)}\``,
+    '',
+    'The complete current target follows, including frontmatter:',
+    '',
+    '````markdown',
+    target.text.trimEnd(),
+    '````',
+    '',
+    `## Full text of every cited or declared item (${resolved.length})`,
+    '',
+    ...resolved.flatMap((id) => [
+      `### \`${id}\``,
+      '',
+      '````markdown',
+      items.get(id).text.trimEnd(),
+      '````',
+      '',
+    ]),
+  ].join('\n');
+  writeFileSync(join(outDir, `${entry.id}.md`), `${task}\n`);
+  written += 1;
+}
+
+console.log(`assembled ${written} current spine refuter task(s)`);
+
+function frontmatter(text) {
+  return text.match(/^---\r?\n([\s\S]*?)\r?\n---/)?.[1] ?? '';
+}
+function scalar(fm, key) {
+  return fm.match(new RegExp(`^${key}:[ \\t]*(.*)$`, 'm'))?.[1]?.trim().replace(/^['"]|['"]$/g, '') ?? '';
+}
+function list(fm, key) {
+  const match = fm.match(new RegExp(`^${key}:[ \\t]*(?:\\r?\\n((?:[ \\t]*-[^\\n]*\\r?\\n?)+)|\\[([^\\]]*)\\])`, 'm'));
+  if (!match) return [];
+  if (match[2] != null) return match[2].split(',').map(clean).filter(Boolean);
+  return match[1].split(/\r?\n/).map((line) => clean(line.replace(/^[ \t]*-[ \t]*/, ''))).filter(Boolean);
+}
+function clean(value) { return value.trim().replace(/^['"]|['"]$/g, ''); }
+function walk(dir, result = []) {
+  if (!existsSync(dir)) return result;
+  for (const name of readdirSync(dir)) {
+    const path = join(dir, name);
+    if (statSync(path).isDirectory()) walk(path, result);
+    else result.push(path);
+  }
+  return result;
+}
