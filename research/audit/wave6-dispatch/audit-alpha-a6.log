    // the agent sandboxes do not, and none of it needs judgement.
    precompute: true,
    agents: () => [{ role: 'audit-alpha', brief: 'briefs/audit-alpha.md', label: 'a6', vars: { k: state.wave } }],
  },

  A7: {
    name: 'Paired judge sweep',
