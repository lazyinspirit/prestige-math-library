research/audit/wave10-real-analysis.proof-contracts.json-11753-          "claim": "By [L5], $3 = L(g,U_N) \\le \\underline{\\int_0^3} g \\le J \\le \\overline{\\int_0^3} g \\le U(g,U_N) = 3 + 3/\\iota(M)$ for every natural $M \\ge 1$. [step 1.1, step 2.1, step 2.2, L5]",
research/audit/wave10-real-analysis.proof-contracts.json-11754-          "step": "3.1",
research/audit/wave10-real-analysis.proof-contracts.json-11755-          "inputs": [
