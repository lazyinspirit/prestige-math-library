+  'https://people.eecs.berkeley.edu/~demmel/ma128a_Spr02/LectureNotes/Integration.html': 'UC Berkeley Math 128A, Integration notes',
+  'https://www-users.cse.umn.edu/~voronov/5615-20/pdfs/12-2-1.pdf': 'University of Minnesota MATH 5615, higher derivative test',
+  'https://www.jirka.org/ra/html/sec_ftc.html': 'J. Lebl, Basic Analysis I, Fundamental theorem of calculus',
+  'https://www.jirka.org/ra/html/sec_impropriemann.html': 'J. Lebl, Basic Analysis I, Improper Riemann integrals',
+  'https://www.jirka.org/ra/html/sec_monotonefunc.html': 'J. Lebl, Basic Analysis I, Monotone functions',
+  'https://www.jirka.org/ra/html/sec_mvt.html': 'J. Lebl, Basic Analysis I, Mean value theorem',
+  'https://www.jirka.org/ra/html/sec_rintprop.html': 'J. Lebl, Basic Analysis I, Properties of the Riemann integral',
+  'https://www.jirka.org/ra/html/sec_series.html': 'J. Lebl, Basic Analysis I, Series',
+  'https://www.jirka.org/ra/html/sec_taylor.html': "J. Lebl, Basic Analysis I, Taylor's theorem and related calculus",
+  'https://www.math.cmu.edu/~gautam/c/2026-269/notes/rint.html': 'Carnegie Mellon 21-269, Riemann integration notes',
+  'https://www.math.ucdavis.edu/~hunter/m125b/ch1.pdf': 'UC Davis MATH 125B, Chapter 1 notes',
+  'https://www.math.ucdavis.edu/~kouba/CalcOneDIRECTORY/lhopitaldirectory/LHopital.html': "UC Davis, L'Hopital's rule",
+  'https://www2.hawaii.edu/~gradysw/apex/sec_derivative.html': 'APEX Calculus, The derivative',
+  'https://www2.math.upenn.edu/~ancoop/3600/section-25.html': 'University of Pennsylvania, derivatives and discontinuities',
+  'https://link.springer.com/book/10.1007/978-3-319-17771-7': 'Charles C. Pugh, Real Mathematical Analysis, 2nd ed., Chapter 3, Exercise 35',
+}));
+
+const manifest = JSON.parse(readFileSync(manifestPath, 'utf8'));
+const ids = [...new Set(manifest.flatMap((page) => page.items.map((item) => item.id)))];
+assert(ids.length === 61, `expected 61 scoped ids, got ${ids.length}`);
+
+const rows = readFileSync(ledgerPath, 'utf8').trim().split('\n').map((line) => JSON.parse(line));
+assert(rows.length === 61, `expected 61 ledger rows, got ${rows.length}`);
+assert(new Set(rows.map((row) => row.id)).size === 61, 'ledger ids are not unique');
+assert(ids.every((id) => rows.some((row) => row.id === id)), 'ledger scope differs from manifest');
+
+for (const row of rows) {
+  if (row.id === 'ex-xk-abs-x-smoothness-threshold' || row.id === 'cex-absolute-value-integrable-without-the-function') {
+    assert(row.evidence === 'established-knowledge', `${row.id}: expected established-knowledge before concurrence`);
+    row.alpha_concurred = true;
+  }
+  if (row.id === 'fs-substitution-holds-for-every-integrable-integrand') {
+    row.statement = 'literature-derived';
+    row.proof = 'ai-generated';
+    row.evidence = 'exact-source';
+    row.urls = ['https://link.springer.com/book/10.1007/978-3-319-17771-7'];
+    row.rationale = "Charles C. Pugh, Real Mathematical Analysis, 2nd ed., Chapter 3, Exercise 35(a)--(d), gives the same construction from a fat Cantor set F, psi(x)=integral_0^x dist(t,F) dt, nullity of psi(F), and the Riemann-integrable indicator of psi(F) whose composite with psi is not Riemann integrable. The repository's quantitative content-zero proof and dependency-explicit packaging are local.";
+    row.alpha_concurred = false;
+  }
+}
+
+const statementCounts = Object.fromEntries(['literature-derived', 'ai-altered', 'ai-generated'].map((key) => [key, rows.filter((row) => row.statement === key).length]));
+const evidenceCounts = Object.fromEntries(['exact-source', 'semantic-source', 'established-knowledge', 'trivial', 'none'].map((key) => [key, rows.filter((row) => row.evidence === key).length]));
+assert(JSON.stringify(statementCounts) === JSON.stringify({'literature-derived':24,'ai-altered':26,'ai-generated':11}), `wrong statement census: ${JSON.stringify(statementCounts)}`);
+assert(JSON.stringify(evidenceCounts) === JSON.stringify({'exact-source':24,'semantic-source':24,'established-knowledge':2,'trivial':7,'none':4}), `wrong evidence census: ${JSON.stringify(evidenceCounts)}`);
+assert(new Set(rows.flatMap((row) => row.urls)).size === 27, 'expected 27 distinct ledger URLs');
+assert(rows.every((row) => row.urls.every((url) => sourceTitles.has(url))), 'source-title map is incomplete');
+
+function splitItem(text, id) {
+  const match = text.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
+  assert(match, `${id}: malformed item frontmatter`);
+  return { fm: match[1], body: match[2] };
+}
+
+function addReferences(fm, urls, id) {
+  if (!urls.length) return { fm, added: 0 };
+  const lines = fm.split('\n');
+  const sources = lines.findIndex((line) => line === 'sources:');
+  assert(sources >= 0, `${id}: no sources block`);
+  let end = sources + 1;
+  while (end < lines.length && (/^\s/.test(lines[end]) || lines[end] === '')) end += 1;
+  const current = new Set(lines.slice(sources, end).flatMap((line) => [...line.matchAll(/https?:\/\/[^"\s]+/g)].map((match) => match[0])));
+  const missing = urls.filter((url) => !current.has(url));
+  if (!missing.length) return { fm, added: 0 };
+  const references = lines.slice(sources, end).findIndex((line) => /^  references:(?:\s*\[\])?$/.test(line));
+  assert(references >= 0, `${id}: no sources.references block`);
+  const refIndex = sources + references;
+  if (lines[refIndex].trim() === 'references: []') lines[refIndex] = '  references:';
+  const additions = missing.flatMap((url) => [
+    `    - title: ${JSON.stringify(sourceTitles.get(url))}`,
+    `      url: ${JSON.stringify(url)}`,
+  ]);
+  lines.splice(end, 0, ...additions);
+  return { fm: lines.join('\n'), added: missing.length };
+}
+
+let sourceAssociationsAdded = 0;
+for (const row of rows) {
+  const path = join(repo, 'items', `${row.id}.md`);
+  const original = readFileSync(path, 'utf8');
+  const { fm: originalFm, body } = splitItem(original, row.id);
+  const origin = originalFm.match(/^origin:.*$/m)?.[0];
+  assert(origin, `${row.id}: missing origin`);
+  assert(!/^provenance:/m.test(originalFm), `${row.id}: provenance already present before Wave 11 application`);
+  let fm = originalFm.replace(/^authorship:.*\n?/m, '');
+  const provenance = `provenance:\n  statement: ${row.statement}\n  proof: ${row.proof}`;
+  fm = fm.replace(/^(origin:.*)$/m, `$1\n${provenance}`);
+  const refs = addReferences(fm, row.urls, row.id);
+  fm = refs.fm;
+  sourceAssociationsAdded += refs.added;
+  assert(fm.match(/^origin:.*$/m)?.[0] === origin, `${row.id}: origin changed`);
+  const updated = `---\n${fm}\n---\n${body}`;
+  if (!dryRun) writeFileSync(path, updated);
+}
+
+const contracts = JSON.parse(readFileSync(contractsPath, 'utf8'));
+const affected = [
+  'thm-linearity-of-the-integral',
+  'thm-monotonicity-of-the-integral',
+  'thm-additivity-over-subintervals',
+  'thm-first-mean-value-theorem-for-integrals',
+  'thm-ftc-second-part',
+  'thm-integration-by-parts',
+  'cex-absolute-value-integrable-without-the-function',
+];
+const removedFacts = new Map([
+  ['thm-monotonicity-of-the-integral', new Set(['L5'])],
+  ['thm-additivity-over-subintervals', new Set(['L6'])],
+  ['thm-first-mean-value-theorem-for-integrals', new Set(['L8'])],
+  ['thm-ftc-second-part', new Set(['L8'])],
+  ['thm-integration-by-parts', new Set(['L7'])],
+  ['cex-absolute-value-integrable-without-the-function', new Set(['L9'])],
+]);
+
+function finalItem(id) {
+  if (!dryRun) return splitItem(readFileSync(join(repo, 'items', `${id}.md`), 'utf8'), id);
+  // Dry run happens after the explicit material patches but before provenance is written,
+  // so the current body is already final and provenance does not affect contract parsing.
+  return splitItem(readFileSync(join(repo, 'items', `${id}.md`), 'utf8'), id);
+}
+
+function proofSteps(body, id) {
+  const heading = body.match(/^## (Proof|Verification|Counterexample|Refutation)$/m);
+  assert(heading, `${id}: no proof-like heading`);
+  const start = heading.index + heading[0].length;
+  const rest = body.slice(start);
+  const endMatch = rest.match(/^## /m);
+  const section = endMatch ? rest.slice(0, endMatch.index) : rest;
+  const steps = new Map();
+  for (const match of section.matchAll(/^(\d+\.\d+) (.+)$/gm)) {
+    const step = match[1];
+    const claim = match[2];
+    const inputMatch = claim.match(/\s+\[([^\]\n]+)\](?:\s*∎)?$/);
+    assert(inputMatch, `${id} step ${step}: no terminal input tag`);
+    steps.set(step, { claim, inputs: inputMatch[1].split(',').map((value) => value.trim()) });
+  }
+  return steps;
+}
+
+function factLinks(body) {
+  const factsStart = body.indexOf('## Facts & Assumptions');
+  assert(factsStart >= 0, 'missing Facts & Assumptions');
+  const after = body.slice(factsStart + '## Facts & Assumptions'.length);
+  const proofHeading = after.match(/^## (Proof|Verification|Counterexample|Refutation)$/m);
+  assert(proofHeading, 'missing proof-like heading after facts');
+  const section = after.slice(0, proofHeading.index);
+  const starts = [...section.matchAll(/^\[([AFL]\d+)\] /gm)];
+  const pairs = [];
+  for (let index = 0; index < starts.length; index += 1) {
+    const start = starts[index];
+    const paragraph = section.slice(start.index, starts[index + 1]?.index ?? section.length).trim();
+    for (const link of paragraph.matchAll(/\[\[([^\]|]+)(?:\|[^\]]*)?\]\]/g)) pairs.push(`${start[1]}\u0000${link[1].trim()}`);
+  }
+  return pairs.sort();
+}
+
+for (const id of affected) {
+  const contract = contracts.contracts[id];
+  assert(contract, `${id}: contract missing`);
+  const removed = removedFacts.get(id) ?? new Set();
+  contract.citations = contract.citations.filter((citation) => !removed.has(citation.fact));
+  if (id === 'thm-additivity-over-subintervals') {
+    for (const citation of contract.citations) {
+      if (citation.fact === 'L7') citation.fact = 'L6';
+      else if (citation.fact === 'L8') citation.fact = 'L7';
+    }
+  }
+  const { body } = finalItem(id);
+  const steps = proofSteps(body, id);
+  assert(contract.derivations.length === steps.size, `${id}: derivation/step cardinality changed`);
+  for (const derivation of contract.derivations) {
+    const step = steps.get(derivation.step);
+    assert(step, `${id}: contract step ${derivation.step} missing from final text`);
+    derivation.claim = step.claim;
+    derivation.inputs = step.inputs;
+  }
+  for (const citation of contract.citations) {
+    citation.uses = [...steps].filter(([, step]) => step.inputs.includes(citation.fact)).map(([step]) => step);
+  }
+  const expectedPairs = factLinks(body);
+  const contractPairs = contract.citations.map((citation) => `${citation.fact}\u0000${citation.source}`).sort();
+  assert(JSON.stringify(contractPairs) === JSON.stringify(expectedPairs), `${id}: regenerated Fact/source pairs do not match final text`);
+}
+
+const contractCount = Object.keys(contracts.contracts).length;
+const citationCount = Object.values(contracts.contracts).reduce((sum, contract) => sum + contract.citations.length, 0);
+const derivationCount = Object.values(contracts.contracts).reduce((sum, contract) => sum + contract.derivations.length, 0);
+const routineCount = Object.values(contracts.contracts).reduce((sum, contract) => sum + contract.routine_steps.length, 0);
+const boundaryCount = Object.values(contracts.contracts).reduce((sum, contract) => sum + contract.boundaries.length, 0);
+assert(contractCount === 55, `expected 55 contracts, got ${contractCount}`);
+assert(citationCount === 692, `expected 692 citations, got ${citationCount}`);
+assert(derivationCount === 377, `expected 377 derivations, got ${derivationCount}`);
+assert(routineCount === 0, `expected zero routine steps, got ${routineCount}`);
+assert(boundaryCount === 440, `expected 440 boundaries, got ${boundaryCount}`);
+
+if (!dryRun) {
+  writeFileSync(ledgerPath, `${rows.map((row) => JSON.stringify(row)).join('\n')}\n`);
+  writeFileSync(contractsPath, `${JSON.stringify(contracts, null, 2)}\n`);
+}
+
+console.log(JSON.stringify({
+  dryRun,
+  items: ids.length,
+  source_associations_added: sourceAssociationsAdded,
+  distinct_urls: new Set(rows.flatMap((row) => row.urls)).size,
+  statement_counts: statementCounts,
+  evidence_counts: evidenceCounts,
+  contracts: contractCount,
+  citations: citationCount,
+  derivations: derivationCount,
+  routine_steps: routineCount,
+  boundaries: boundaryCount,
+}, null, 2));
diff --git a//tmp/wave11-a4-validate.mjs b//tmp/wave11-a4-validate.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..b50f7f2204c43200f9ad391d11471d6704faa230
--- /dev/null
+++ b//tmp/wave11-a4-validate.mjs
@@ -0,0 +1,187 @@
+import fs from 'node:fs';
+import path from 'node:path';
+
+const repo = '/home/lazyinspirit/Projects/prestige-math-library';
+const baselineDir = process.argv[2];
+if (!baselineDir) throw new Error('baseline directory required');
+
+const manifest = JSON.parse(fs.readFileSync(path.join(repo, 'research/audit/wave11-real-analysis.pages.json'), 'utf8'));
+const rows = fs.readFileSync(path.join(repo, 'research/audit/wave11-real-analysis.provenance.jsonl'), 'utf8')
+  .trim().split(/\n/).filter(Boolean).map((line) => JSON.parse(line));
+const ledger = new Map(rows.map((row) => [row.id, row]));
+const itemIds = manifest.flatMap((page) => page.items.map((item) => item.id));
+const materialExpected = new Set([
+  'ex-integral-test-applied-to-the-p-series',
+  'thm-linearity-of-the-integral',
+  'thm-monotonicity-of-the-integral',
+  'thm-additivity-over-subintervals',
+  'thm-first-mean-value-theorem-for-integrals',
+  'thm-ftc-second-part',
+  'thm-integration-by-parts',
+  'cex-absolute-value-integrable-without-the-function',
+]);
+
+const errors = [];
+const assert = (condition, message) => { if (!condition) errors.push(message); };
+const split = (source) => {
+  const match = source.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
+  if (!match) throw new Error('frontmatter missing');
+  return { fm: match[1], body: match[2] };
+};
+const block = (fm, key) => {
+  const lines = fm.split('\n');
+  const start = lines.findIndex((line) => new RegExp(`^${key}:`).test(line));
+  if (start < 0) return '';
+  let end = start + 1;
+  while (end < lines.length && (lines[end] === '' || /^\s/.test(lines[end]))) end += 1;
+  return lines.slice(start, end).join('\n').replace(/\n+$/, '');
+};
+const without = (fm, keys) => {
+  let lines = fm.split('\n');
+  for (const key of keys) {
+    const start = lines.findIndex((line) => new RegExp(`^${key}:`).test(line));
+    if (start < 0) continue;
+    let end = start + 1;
+    while (end < lines.length && (lines[end] === '' || /^\s/.test(lines[end]))) end += 1;
+    lines.splice(start, end - start);
+  }
+  return lines.join('\n').replace(/\n+$/, '');
+};
+const scalar = (fm, key) => {
+  const match = fm.match(new RegExp(`^${key}:\\s*(.*)$`, 'm'));
+  return match?.[1]?.trim();
+};
+const nested = (fm, parent, child) => {
+  const section = block(fm, parent);
+  const match = section.match(new RegExp(`^\\s+${child}:\\s*(.*)$`, 'm'));
+  return match?.[1]?.trim();
+};
+const urls = (fm) => new Set([...block(fm, 'sources').matchAll(/^\s+url:\s*["']?([^"'\s]+)["']?\s*$/gm)].map((match) => match[1]));
+const referenceEntries = (fm) => {
+  const lines = block(fm, 'sources').split('\n');
+  const out = [];
+  for (let i = 0; i < lines.length; i += 1) {
+    if (!/^\s+- title:/.test(lines[i])) continue;
+    const entry = [lines[i]];
+    while (i + 1 < lines.length && /^\s{6,}/.test(lines[i + 1]) && !/^\s+- title:/.test(lines[i + 1])) entry.push(lines[++i]);
+    out.push(entry.join('\n'));
+  }
+  return out;
+};
+
+assert(itemIds.length === 61 && new Set(itemIds).size === 61, `scope is ${itemIds.length}/61 or has duplicates`);
+assert(rows.length === 61 && ledger.size === 61, `ledger is ${rows.length}/61 or has duplicates`);
+
+const materialActual = [];
+const reasons = {};
+let factParagraphDeletions = 0;
+let dependencyRemovals = 0;
+let dependencyAdditions = 0;
+
+for (const id of itemIds) {
+  const baseSource = fs.readFileSync(path.join(baselineDir, `item--${id}.md`), 'utf8');
+  const currentSource = fs.readFileSync(path.join(repo, 'items', `${id}.md`), 'utf8');
+  const base = split(baseSource);
+  const current = split(currentSource);
+  const row = ledger.get(id);
+  assert(Boolean(row), `${id}: ledger row missing`);
+  if (!row) continue;
+
+  assert(scalar(base.fm, 'origin') === scalar(current.fm, 'origin'), `${id}: origin changed`);
+  assert(!/^authorship:/m.test(current.fm), `${id}: legacy authorship retained`);
+  assert(nested(current.fm, 'provenance', 'statement') === row.statement, `${id}: statement provenance mismatch`);
+  assert(nested(current.fm, 'provenance', 'proof') === row.proof, `${id}: proof provenance mismatch`);
+
+  const baseUrls = urls(base.fm);
+  const currentUrls = urls(current.fm);
+  const expectedUrls = new Set([...baseUrls, ...row.urls]);
+  assert([...expectedUrls].every((url) => currentUrls.has(url)) && [...currentUrls].every((url) => expectedUrls.has(url)), `${id}: sources.references URL set is not baseline union ledger`);
+  for (const entry of referenceEntries(base.fm)) assert(block(current.fm, 'sources').includes(entry), `${id}: legacy source reference changed or disappeared`);
+
+  const changed = [];
+  if (base.body !== current.body) changed.push('body');
+  if (block(base.fm, 'deps') !== block(current.fm, 'deps')) changed.push('deps');
+  if (block(base.fm, 'verification') !== block(current.fm, 'verification')) changed.push('verification');
+  if (changed.length) {
+    materialActual.push(id);
+    reasons[id] = changed;
+  }
+
+  if (materialExpected.has(id)) {
+    assert(without(base.fm, ['provenance', 'authorship', 'sources', 'deps', 'verification']) === without(current.fm, ['provenance', 'authorship', 'sources', 'deps', 'verification']), `${id}: unauthorized non-material frontmatter changed`);
+    assert(block(current.fm, 'verification') === 'verification:\n  precheck: pass', `${id}: material verification state is not precheck-only`);
+  } else {
+    assert(base.body === current.body, `${id}: pure-retag body changed`);
+    assert(without(base.fm, ['provenance', 'authorship', 'sources']) === without(current.fm, ['provenance', 'authorship', 'sources']), `${id}: pure-retag non-audit frontmatter changed`);
+    assert(block(base.fm, 'verification') === block(current.fm, 'verification'), `${id}: pure-retag verification state changed`);
+  }
+
+  const baseFacts = [...base.body.matchAll(/^\[L\d+\]/gm)].length;
+  const currentFacts = [...current.body.matchAll(/^\[L\d+\]/gm)].length;
+  factParagraphDeletions += baseFacts - currentFacts;
+
+  const manifestItem = manifest.flatMap((page) => page.items).find((item) => item.id === id);
+  const baselineDeps = new Set(manifestItem.deps);
+  const currentDepsText = block(current.fm, 'deps').match(/^deps:\s*\[([\s\S]*?)\]$/)?.[1] ?? '';
+  const currentDeps = new Set(currentDepsText.split(',').map((value) => value.trim().replace(/^['"]|['"]$/g, '')).filter(Boolean));
+  dependencyRemovals += [...baselineDeps].filter((dep) => !currentDeps.has(dep)).length;
+  dependencyAdditions += [...currentDeps].filter((dep) => !baselineDeps.has(dep)).length;
+}
+
+assert(JSON.stringify([...materialActual].sort()) === JSON.stringify([...materialExpected].sort()), `material set mismatch: ${materialActual.join(', ')}`);
+assert(factParagraphDeletions === 6, `fact paragraph deletion count ${factParagraphDeletions} != 6`);
+assert(dependencyRemovals === 6 && dependencyAdditions === 0, `dependency delta is -${dependencyRemovals}/+${dependencyAdditions}, expected -6/+0`);
+
+const authorizedPage = 'properties-of-the-integral-and-the-working-ftc';
+const pageChanges = [];
+for (const page of manifest) {
+  const base = fs.readFileSync(path.join(baselineDir, `page--${page.id}.md`), 'utf8');
+  const current = fs.readFileSync(path.join(repo, 'library/real-analysis', `${page.id}.md`), 'utf8');
+  if (base !== current) pageChanges.push(page.id);
+  if (page.id === authorizedPage) {
+    const oldText = "Taylor's integral remainder needs higher\nderivatives and is deliberately developed with Darboux's theorem, l'Hopital's\nrule, and Taylor expansion rather than on this page. ";
+    const newText = "Taylor's integral remainder needs higher\nderivatives and is not developed on this page. The current\nDarboux/L'Hopital/Taylor page also explicitly excludes the integral remainder.\n";
+    assert(base.includes(oldText), 'authorized page baseline sentence not found');
+    assert(current === base.replace(oldText, newText), 'authorized page has a change beyond A3 replacement');
+  } else assert(base === current, `${page.id}: unauthorized Wave 11 page change`);
+}
+assert(JSON.stringify(pageChanges) === JSON.stringify([authorizedPage]), `page change set mismatch: ${pageChanges.join(', ')}`);
+
+const contracts = JSON.parse(fs.readFileSync(path.join(repo, 'research/audit/wave11-real-analysis.proof-contracts.json'), 'utf8'));
+const contractRows = Object.values(contracts.contracts);
+const contractCounts = {
+  items: contractRows.length,
+  citations: contractRows.reduce((sum, contract) => sum + contract.citations.length, 0),
+  derivations: contractRows.reduce((sum, contract) => sum + contract.derivations.length, 0),
+  routine_steps: contractRows.reduce((sum, contract) => sum + (contract.routine_steps?.length ?? 0), 0),
+  boundaries: contractRows.reduce((sum, contract) => sum + contract.boundaries.length, 0),
+};
+assert(JSON.stringify(contractCounts) === JSON.stringify({ items: 55, citations: 692, derivations: 377, routine_steps: 0, boundaries: 440 }), `contract counts mismatch: ${JSON.stringify(contractCounts)}`);
+
+const statementCounts = Object.groupBy(rows, (row) => row.statement);
+const evidenceCounts = Object.groupBy(rows, (row) => row.evidence);
+const provenanceCounts = {
+  statement: Object.fromEntries(Object.entries(statementCounts).map(([key, value]) => [key, value.length])),
+  evidence: Object.fromEntries(Object.entries(evidenceCounts).map(([key, value]) => [key, value.length])),
