diff --git a//tmp/wave13_apply_provenance.cjs b//tmp/wave13_apply_provenance.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..5e6d4ec878d9807bc7259cc58b15bae014e5b4d5
--- /dev/null
+++ b//tmp/wave13_apply_provenance.cjs
@@ -0,0 +1,100 @@
+const fs = require('fs');
+const YAML = require('yaml');
+
+const root = '/home/lazyinspirit/Projects/prestige-math-library';
+const manifestPath = `${root}/research/audit/wave13-real-analysis.pages.json`;
+const ledgerPath = `${root}/research/audit/wave13-real-analysis.provenance.jsonl`;
+const pages = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
+const scope = [...new Set(pages.flatMap((page) => page.items.map((item) => item.id)))];
+const rows = fs.readFileSync(ledgerPath, 'utf8').trim().split(/\n/).map(JSON.parse);
+const byId = new Map(rows.map((row) => [row.id, row]));
+
+if (scope.length !== 76 || rows.length !== 76 || byId.size !== 76) {
+  throw new Error(`scope/ledger cardinality mismatch: ${scope.length}/${rows.length}/${byId.size}`);
+}
+for (const id of scope) {
+  if (!byId.has(id)) throw new Error(`missing ledger row: ${id}`);
+}
+for (const id of byId.keys()) {
+  if (!scope.includes(id)) throw new Error(`out-of-scope ledger row: ${id}`);
+}
+
+const titles = new Map([
+  ['https://encyclopediaofmath.org/wiki/Power_series', 'Power series, Encyclopedia of Mathematics'],
+  ['https://ocw.mit.edu/courses/18-100c-real-analysis-fall-2012/1058808e5cb57c986118333f8b6fa0d7_MIT18_100CF12_l11sum.pdf', 'MIT 18.100C, Lecture 11: Power Series'],
+  ['https://encyclopediaofmath.org/wiki/Cauchy-Hadamard_theorem', 'Cauchy-Hadamard theorem, Encyclopedia of Mathematics'],
+  ['https://personal.colby.edu/~erandles/papers/Past_Courses/Supplementary_Notes.pdf', 'E. Randles, Supplementary Notes for Real Analysis'],
+  ['https://sites.math.northwestern.edu/scg479/courses/notes/lecture-notes-320-2.pdf', 'Northwestern Math 320-2 lecture notes'],
+  ['https://encyclopediaofmath.org/wiki/Analytic_function', 'Analytic function, Encyclopedia of Mathematics'],
+  ['https://encyclopediaofmath.org/wiki/Ces%C3%A0ro_summation_methods', 'Cesàro summation methods, Encyclopedia of Mathematics'],
+  ['https://math.rice.edu/~semmes/math322.pdf', 'S. Semmes, Rice Math 322 notes'],
+  ['https://encyclopediaofmath.org/wiki/Tauberian_theorems', 'Tauberian theorems, Encyclopedia of Mathematics'],
+  ['https://www.jirka.org/ra/html/sec_rirect.html', 'J. Lebl, Basic Analysis, Riemann Integral in Several Variables'],
+  ['https://www.jirka.org/ra/html/sec_outermeasure.html', 'J. Lebl, Basic Analysis, Outer Measure and Null Sets'],
+  ['https://www.jirka.org/ra/html/sec_riemannlebesgue.html', 'J. Lebl, Basic Analysis, The Riemann-Lebesgue Criterion'],
+  ['https://www.jirka.org/ra/html/sec_jordansets.html', 'J. Lebl, Basic Analysis, Jordan Measurable Sets'],
+  ['https://www.math.cmu.edu/~gautam/sj/teaching/2017-18/268-multid-calc/pdfs/canez-calculus.pdf', 'A. Cañez, multivariable calculus notes'],
+  ['https://www.math.utah.edu/~treiberg/M3225_Final_Solutions.pdf', 'A. Treibergs, MATH 3225 final solutions'],
+  ['https://www.whitman.edu/Documents/Academics/Mathematics/Hardman.pdf', 'Whitman College real analysis notes'],
+  ['https://studylib.net/doc/28170627/analysis-on-manifolds--advanced-books-classics-----james-...', 'J. Munkres, Analysis on Manifolds, Jordan content terminology'],
+]);
+
+function sourcesBlock(sources) {
+  const refs = sources.references || [];
+  const lines = ['sources:', '  scraped: []'];
+  if (refs.length === 0) {
+    lines.push('  references: []');
+  } else {
+    lines.push('  references:');
+    for (const ref of refs) {
+      lines.push(`    - title: ${JSON.stringify(ref.title)}`);
+      lines.push(`      url: ${JSON.stringify(ref.url)}`);
+    }
+  }
+  return `${lines.join('\n')}\n`;
+}
+
+for (const id of scope) {
+  const row = byId.get(id);
+  const itemPath = `${root}/items/${id}.md`;
+  const text = fs.readFileSync(itemPath, 'utf8');
+  const match = text.match(/^---\n([\s\S]*?)\n---\n/);
+  if (!match) throw new Error(`frontmatter missing: ${id}`);
+  let frontmatter = match[1];
+  if (/^provenance:/m.test(frontmatter)) throw new Error(`provenance already present: ${id}`);
+  if (!/^origin: (pipeline|session)$/m.test(frontmatter)) throw new Error(`origin missing: ${id}`);
+
+  const parsed = YAML.parse(frontmatter);
+  if (!parsed.sources || !Array.isArray(parsed.sources.scraped) || !Array.isArray(parsed.sources.references)) {
+    throw new Error(`sources malformed: ${id}`);
+  }
+  if (parsed.sources.scraped.length !== 0) throw new Error(`unexpected scraped source: ${id}`);
+
+  const refs = parsed.sources.references.map((ref) => ({title: ref.title, url: ref.url}));
+  const seen = new Set(refs.map((ref) => ref.url));
+  for (const url of row.urls) {
+    const title = titles.get(url);
+    if (!title) throw new Error(`missing title mapping for ${url}`);
+    if (!seen.has(url)) {
+      refs.push({title, url});
+      seen.add(url);
+    }
+  }
+
+  frontmatter = frontmatter.replace(/^authorship:.*\n/m, '');
+  frontmatter = frontmatter.replace(
+    /^(origin: (?:pipeline|session))$/m,
+    `$1\nprovenance:\n  statement: ${row.statement}\n  proof: ${row.proof}`,
+  );
+
+  const sourcesStart = frontmatter.search(/^sources:/m);
+  const pipelineStart = frontmatter.search(/^pipeline_run:/m);
+  if (sourcesStart < 0 || pipelineStart < 0 || pipelineStart <= sourcesStart) {
+    throw new Error(`sources/pipeline anchors missing: ${id}`);
+  }
+  frontmatter = `${frontmatter.slice(0, sourcesStart)}${sourcesBlock({references: refs})}${frontmatter.slice(pipelineStart)}`;
+  const updated = `---\n${frontmatter}\n---\n${text.slice(match[0].length)}`;
+  fs.writeFileSync(itemPath, updated);
+}
+
+console.log(`applied provenance and ledger URL references to ${scope.length} Wave 13 items`);
diff --git a//tmp/wave13_update_contracts.cjs b//tmp/wave13_update_contracts.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..f7f316b4f0422e458a5954f274ead817de950078
