diff --git a/items/thm-jordan-boundary-criterion.md b/items/thm-jordan-boundary-criterion.md
index e5018d4885430aba1fcd282d07b28c0c9fe95261..279d6e2ebb451311c95d42f40b6a4244cb3602e2
--- a/items/thm-jordan-boundary-criterion.md
