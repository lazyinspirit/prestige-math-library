const fs = require('fs');
const path = require('path');
const YAML = require('yaml');

const root = '/home/lazyinspirit/Projects/prestige-math-library';
const baselineRoot = process.argv[2];
if (!baselineRoot) throw new Error('usage: node wave13_verify_apply.cjs <git-archive-root>');

const pages = JSON.parse(fs.readFileSync(`${root}/research/audit/wave13-real-analysis.pages.json`, 'utf8'));
const ids = [...new Set(pages.flatMap((page) => page.items.map((item) => item.id)))];
const rows = fs.readFileSync(`${root}/research/audit/wave13-real-analysis.provenance.jsonl`, 'utf8').trim().split(/\n/).map(JSON.parse);
const byId = new Map(rows.map((row) => [row.id, row]));
const contracts = JSON.parse(fs.readFileSync(`${root}/research/audit/wave13-real-analysis.proof-contracts.json`, 'utf8'));
const materialExpected = new Set([
  'ex-geometric-power-series-and-an-interior-reexpansion',
  'thm-jordan-boundary-criterion',
  'thm-lebesgue-criterion-in-rn',
]);
const ignoredKeys = new Set(['provenance', 'sources', 'authorship', 'verification', 'pipeline_run', 'generation']);
const errors = [];
const pure = [];
const material = [];

function split(text) {
  const match = text.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
  if (!match) throw new Error('frontmatter split failed');
  return {fm: YAML.parse(match[1]), body: match[2]};
}
function stable(value) { return JSON.stringify(value); }

if (pages.length !== 4) errors.push(`page count ${pages.length}`);
if (ids.length !== 76) errors.push(`item count ${ids.length}`);
if (rows.length !== 76 || byId.size !== 76) errors.push(`ledger cardinality ${rows.length}/${byId.size}`);
if (contracts.scope.length !== 62 || Object.keys(contracts.contracts).length !== 62) {
  errors.push(`contract cardinality ${contracts.scope.length}/${Object.keys(contracts.contracts).length}`);
}

for (const id of ids) {
  const row = byId.get(id);
  if (!row) { errors.push(`${id}: missing ledger row`); continue; }
  const current = split(fs.readFileSync(`${root}/items/${id}.md`, 'utf8'));
  const baseline = split(fs.readFileSync(path.join(baselineRoot, 'items', `${id}.md`), 'utf8'));
  if (current.fm.origin !== baseline.fm.origin) errors.push(`${id}: origin changed`);
  if (current.fm.authorship !== undefined) errors.push(`${id}: legacy authorship retained`);
  if (current.fm.provenance?.statement !== row.statement || current.fm.provenance?.proof !== row.proof) {
    errors.push(`${id}: provenance mismatch`);
  }
  const refs = current.fm.sources?.references;
  if (!Array.isArray(refs) || refs.some((ref) => typeof ref.title !== 'string' || !ref.title || typeof ref.url !== 'string' || !ref.url)) {
    errors.push(`${id}: malformed source references`);
  } else {
    const urls = new Set(refs.map((ref) => ref.url));
    for (const url of row.urls) if (!urls.has(url)) errors.push(`${id}: ledger URL absent: ${url}`);
  }

  const reasons = [];
  if (current.body !== baseline.body) reasons.push('body text');
  for (const key of new Set([...Object.keys(current.fm), ...Object.keys(baseline.fm)])) {
    if (ignoredKeys.has(key)) continue;
    if (stable(current.fm[key]) !== stable(baseline.fm[key])) reasons.push(key);
  }
  if (reasons.length) material.push({id, reasons}); else pure.push(id);

  if (!materialExpected.has(id) && stable(current.fm.verification) !== stable(baseline.fm.verification)) {
    errors.push(`${id}: pure-retag verification state changed`);
  }
  if (materialExpected.has(id)) {
    if (current.fm.verification?.audited !== undefined) errors.push(`${id}: stale audited retained`);
    if (current.fm.verification?.judge !== undefined) errors.push(`${id}: stale judge retained`);
  }
}

for (const row of rows) if (!ids.includes(row.id)) errors.push(`${row.id}: ledger row outside scope`);
const actualMaterial = new Set(material.map((entry) => entry.id));
for (const id of materialExpected) if (!actualMaterial.has(id)) errors.push(`${id}: expected material id classified pure`);
for (const id of actualMaterial) if (!materialExpected.has(id)) errors.push(`${id}: unexpected material id`);

const provenance = {
  statement: rows.reduce((out, row) => ((out[row.statement] = (out[row.statement] || 0) + 1), out), {}),
  proof: rows.reduce((out, row) => ((out[row.proof] = (out[row.proof] || 0) + 1), out), {}),
  evidence: rows.reduce((out, row) => ((out[row.evidence] = (out[row.evidence] || 0) + 1), out), {}),
};
const distinctLedgerUrls = new Set(rows.flatMap((row) => row.urls));

console.log(JSON.stringify({
  ok: errors.length === 0,
  errors,
  counts: {pages: pages.length, items: ids.length, contracts: contracts.scope.length, pure: pure.length, material: material.length, created: 0, distinctLedgerUrls: distinctLedgerUrls.size},
  material: material.sort((a, b) => a.id.localeCompare(b.id)),
  pure: pure.sort(),
  provenance,
}, null, 2));
process.exit(errors.length ? 1 : 0);
const materialExpected = new Set([
  'ex-geometric-power-series-and-an-interior-reexpansion',
  'thm-jordan-boundary-criterion',
  'thm-lebesgue-criterion-in-rn',
]);
const ignoredKeys = new Set(['provenance', 'sources', 'authorship', 'verification', 'pipeline_run', 'generation']);
const errors = [];
const pure = [];
const material = [];

function split(text) {
  const match = text.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
  if (!match) throw new Error('frontmatter split failed');
  return {fm: YAML.parse(match[1]), body: match[2]};
}
function stable(value) { return JSON.stringify(value); }

if (pages.length !== 4) errors.push(`page count ${pages.length}`);
if (ids.length !== 76) errors.push(`item count ${ids.length}`);
if (rows.length !== 76 || byId.size !== 76) errors.push(`ledger cardinality ${rows.length}/${byId.size}`);
if (contracts.scope.length !== 62 || Object.keys(contracts.contracts).length !== 62) {
  errors.push(`contract cardinality ${contracts.scope.length}/${Object.keys(contracts.contracts).length}`);
}

for (const id of ids) {
  const row = byId.get(id);
  if (!row) { errors.push(`${id}: missing ledger row`); continue; }
  const current = split(fs.readFileSync(`${root}/items/${id}.md`, 'utf8'));
  const baseline = split(fs.readFileSync(path.join(baselineRoot, 'items', `${id}.md`), 'utf8'));
  if (current.fm.origin !== baseline.fm.origin) errors.push(`${id}: origin changed`);
  if (current.fm.authorship !== undefined) errors.push(`${id}: legacy authorship retained`);
  if (current.fm.provenance?.statement !== row.statement || current.fm.provenance?.proof !== row.proof) {
    errors.push(`${id}: provenance mismatch`);
  }
  const refs = current.fm.sources?.references;
  if (!Array.isArray(refs) || refs.some((ref) => typeof ref.title !== 'string' || !ref.title || typeof ref.url !== 'string' || !ref.url)) {
    errors.push(`${id}: malformed source references`);
  } else {
    const urls = new Set(refs.map((ref) => ref.url));
    for (const url of row.urls) if (!urls.has(url)) errors.push(`${id}: ledger URL absent: ${url}`);
  }

  const reasons = [];
  if (current.body !== baseline.body) reasons.push('body text');
  for (const key of new Set([...Object.keys(current.fm), ...Object.keys(baseline.fm)])) {
    if (ignoredKeys.has(key)) continue;
    if (stable(current.fm[key]) !== stable(baseline.fm[key])) reasons.push(key);
  }
  if (reasons.length) material.push({id, reasons}); else pure.push(id);

  if (!materialExpected.has(id) && stable(current.fm.verification) !== stable(baseline.fm.verification)) {
    errors.push(`${id}: pure-retag verification state changed`);
  }
  if (materialExpected.has(id)) {
    if (current.fm.verification?.audited !== undefined) errors.push(`${id}: stale audited retained`);
    if (current.fm.verification?.judge !== undefined) errors.push(`${id}: stale judge retained`);
  }
}

for (const row of rows) if (!ids.includes(row.id)) errors.push(`${row.id}: ledger row outside scope`);
const actualMaterial = new Set(material.map((entry) => entry.id));
for (const id of materialExpected) if (!actualMaterial.has(id)) errors.push(`${id}: expected material id classified pure`);
for (const id of actualMaterial) if (!materialExpected.has(id)) errors.push(`${id}: unexpected material id`);

const provenance = {
  statement: rows.reduce((out, row) => ((out[row.statement] = (out[row.statement] || 0) + 1), out), {}),
  proof: rows.reduce((out, row) => ((out[row.proof] = (out[row.proof] || 0) + 1), out), {}),
  evidence: rows.reduce((out, row) => ((out[row.evidence] = (out[row.evidence] || 0) + 1), out), {}),
};
const distinctLedgerUrls = new Set(rows.flatMap((row) => row.urls));

console.log(JSON.stringify({
  ok: errors.length === 0,
  errors,
  counts: {pages: pages.length, items: ids.length, contracts: contracts.scope.length, pure: pure.length, material: material.length, created: 0, distinctLedgerUrls: distinctLedgerUrls.size},
  material: material.sort((a, b) => a.id.localeCompare(b.id)),
  pure: pure.sort(),
  provenance,
}, null, 2));
process.exit(errors.length ? 1 : 0);

diff --git a//tmp/wave13_apply_provenance.cjs b//tmp/wave13_apply_provenance.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..5e6d4ec878d9807bc7259cc58b15bae014e5b4d5
--- /dev/null
+++ b//tmp/wave13_apply_provenance.cjs
@@ -0,0 +1,100 @@
+const fs = require('fs');
+const YAML = require('yaml');
+
+const root = '/home/lazyinspirit/Projects/prestige-math-library';
+const manifestPath = `${root}/research/audit/wave13-real-analysis.pages.json`;
+const ledgerPath = `${root}/research/audit/wave13-real-analysis.provenance.jsonl`;
+const pages = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
+const scope = [...new Set(pages.flatMap((page) => page.items.map((item) => item.id)))];
+const rows = fs.readFileSync(ledgerPath, 'utf8').trim().split(/\n/).map(JSON.parse);
+const byId = new Map(rows.map((row) => [row.id, row]));
+
+if (scope.length !== 76 || rows.length !== 76 || byId.size !== 76) {
+  throw new Error(`scope/ledger cardinality mismatch: ${scope.length}/${rows.length}/${byId.size}`);
+}
+for (const id of scope) {
+  if (!byId.has(id)) throw new Error(`missing ledger row: ${id}`);
+}
+for (const id of byId.keys()) {
+  if (!scope.includes(id)) throw new Error(`out-of-scope ledger row: ${id}`);
+}
+
+const titles = new Map([
+  ['https://encyclopediaofmath.org/wiki/Power_series', 'Power series, Encyclopedia of Mathematics'],
+  ['https://ocw.mit.edu/courses/18-100c-real-analysis-fall-2012/1058808e5cb57c986118333f8b6fa0d7_MIT18_100CF12_l11sum.pdf', 'MIT 18.100C, Lecture 11: Power Series'],
+  ['https://encyclopediaofmath.org/wiki/Cauchy-Hadamard_theorem', 'Cauchy-Hadamard theorem, Encyclopedia of Mathematics'],
+  ['https://personal.colby.edu/~erandles/papers/Past_Courses/Supplementary_Notes.pdf', 'E. Randles, Supplementary Notes for Real Analysis'],
+  ['https://sites.math.northwestern.edu/scg479/courses/notes/lecture-notes-320-2.pdf', 'Northwestern Math 320-2 lecture notes'],
+  ['https://encyclopediaofmath.org/wiki/Analytic_function', 'Analytic function, Encyclopedia of Mathematics'],
+  ['https://encyclopediaofmath.org/wiki/Ces%C3%A0ro_summation_methods', 'Cesàro summation methods, Encyclopedia of Mathematics'],
+  ['https://math.rice.edu/~semmes/math322.pdf', 'S. Semmes, Rice Math 322 notes'],
+  ['https://encyclopediaofmath.org/wiki/Tauberian_theorems', 'Tauberian theorems, Encyclopedia of Mathematics'],
+  ['https://www.jirka.org/ra/html/sec_rirect.html', 'J. Lebl, Basic Analysis, Riemann Integral in Several Variables'],
+  ['https://www.jirka.org/ra/html/sec_outermeasure.html', 'J. Lebl, Basic Analysis, Outer Measure and Null Sets'],
+  ['https://www.jirka.org/ra/html/sec_riemannlebesgue.html', 'J. Lebl, Basic Analysis, The Riemann-Lebesgue Criterion'],
+  ['https://www.jirka.org/ra/html/sec_jordansets.html', 'J. Lebl, Basic Analysis, Jordan Measurable Sets'],
+  ['https://www.math.cmu.edu/~gautam/sj/teaching/2017-18/268-multid-calc/pdfs/canez-calculus.pdf', 'A. Cañez, multivariable calculus notes'],
+  ['https://www.math.utah.edu/~treiberg/M3225_Final_Solutions.pdf', 'A. Treibergs, MATH 3225 final solutions'],
+  ['https://www.whitman.edu/Documents/Academics/Mathematics/Hardman.pdf', 'Whitman College real analysis notes'],
+  ['https://studylib.net/doc/28170627/analysis-on-manifolds--advanced-books-classics-----james-...', 'J. Munkres, Analysis on Manifolds, Jordan content terminology'],
+]);
+
+function sourcesBlock(sources) {
+  const refs = sources.references || [];
+  const lines = ['sources:', '  scraped: []'];
+  if (refs.length === 0) {
+    lines.push('  references: []');
+  } else {
+    lines.push('  references:');
+    for (const ref of refs) {
+      lines.push(`    - title: ${JSON.stringify(ref.title)}`);
+      lines.push(`      url: ${JSON.stringify(ref.url)}`);
+    }
+  }
+  return `${lines.join('\n')}\n`;
+}
+
+for (const id of scope) {
+  const row = byId.get(id);
+  const itemPath = `${root}/items/${id}.md`;
+  const text = fs.readFileSync(itemPath, 'utf8');
+  const match = text.match(/^---\n([\s\S]*?)\n---\n/);
+  if (!match) throw new Error(`frontmatter missing: ${id}`);
+  let frontmatter = match[1];
+  if (/^provenance:/m.test(frontmatter)) throw new Error(`provenance already present: ${id}`);
+  if (!/^origin: (pipeline|session)$/m.test(frontmatter)) throw new Error(`origin missing: ${id}`);
+
+  const parsed = YAML.parse(frontmatter);
+  if (!parsed.sources || !Array.isArray(parsed.sources.scraped) || !Array.isArray(parsed.sources.references)) {
+    throw new Error(`sources malformed: ${id}`);
+  }
+  if (parsed.sources.scraped.length !== 0) throw new Error(`unexpected scraped source: ${id}`);
+
+  const refs = parsed.sources.references.map((ref) => ({title: ref.title, url: ref.url}));
+  const seen = new Set(refs.map((ref) => ref.url));
+  for (const url of row.urls) {
+    const title = titles.get(url);
+    if (!title) throw new Error(`missing title mapping for ${url}`);
+    if (!seen.has(url)) {
+      refs.push({title, url});
+      seen.add(url);
+    }
+  }
+
+  frontmatter = frontmatter.replace(/^authorship:.*\n/m, '');
+  frontmatter = frontmatter.replace(
+    /^(origin: (?:pipeline|session))$/m,
+    `$1\nprovenance:\n  statement: ${row.statement}\n  proof: ${row.proof}`,
+  );
+
+  const sourcesStart = frontmatter.search(/^sources:/m);
+  const pipelineStart = frontmatter.search(/^pipeline_run:/m);
+  if (sourcesStart < 0 || pipelineStart < 0 || pipelineStart <= sourcesStart) {
+    throw new Error(`sources/pipeline anchors missing: ${id}`);
+  }
+  frontmatter = `${frontmatter.slice(0, sourcesStart)}${sourcesBlock({references: refs})}${frontmatter.slice(pipelineStart)}`;
+  const updated = `---\n${frontmatter}\n---\n${text.slice(match[0].length)}`;
+  fs.writeFileSync(itemPath, updated);
+}
+
+console.log(`applied provenance and ledger URL references to ${scope.length} Wave 13 items`);
diff --git a//tmp/wave13_update_contracts.cjs b//tmp/wave13_update_contracts.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..f7f316b4f0422e458a5954f274ead817de950078
--- /dev/null
+++ b//tmp/wave13_update_contracts.cjs
@@ -0,0 +1,81 @@
+const fs = require('fs');
+
+const root = '/home/lazyinspirit/Projects/prestige-math-library';
+const contractPath = `${root}/research/audit/wave13-real-analysis.proof-contracts.json`;
+const document = JSON.parse(fs.readFileSync(contractPath, 'utf8'));
+
+function sourceSection(id, heading) {
+  const text = fs.readFileSync(`${root}/items/${id}.md`, 'utf8');
+  const body = text.replace(/^---\n[\s\S]*?\n---\n/, '');
+  const escaped = heading.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+  const match = body.match(new RegExp(`^##\\s+${escaped}\\s*$\\n([\\s\\S]*?)(?=^##\\s+|(?![\\s\\S]))`, 'm'));
+  if (!match) throw new Error(`missing ${heading} in ${id}`);
+  return match[1].trim();
+}
+
+function boundary(contract, name) {
+  const entry = contract.boundaries.find((row) => row.case === name);
+  if (!entry) throw new Error(`missing boundary ${name}`);
+  return entry;
+}
+
+const jordan = document.contracts['thm-jordan-boundary-criterion'];
+for (const citation of jordan.citations.filter((row) => row.fact === 'L3')) {
+  citation.uses = ['1.1', '1.2'];
+}
+const jordanStep = jordan.derivations.find((row) => row.step === '1.1');
+jordanStep.claim = 'By [L3], choose a closed bounding rectangle $Q_0$ for $E$ and enlarge every coordinate interval by a fixed positive margin to obtain a nondegenerate rectangle $Q$ with $\\overline E\\subseteq Q_0\\subseteq\\operatorname{int}Q$. By [L1] and [L2], $E$ is Jordan measurable exactly when $\\partial E$ is null.';
+jordanStep.inputs = ['L1', 'L2', 'L3', 'given', 'choose'];
+Object.assign(boundary(jordan, 'nonempty-choice'), {
+  status: 'checked',
+  evidence: 'step 1.1: [L3] supplies a closed bounding rectangle before the proof chooses and enlarges it by a fixed positive margin.',
+});
+delete boundary(jordan, 'nonempty-choice').reason;
+Object.assign(boundary(jordan, 'iff-forward'), {
+  status: 'checked',
+  evidence: 'Statement and steps 1.1 and 2.1: the forward implication follows through the indicator-integrability and compact-boundary equivalences.',
+});
+delete boundary(jordan, 'iff-forward').reason;
+Object.assign(boundary(jordan, 'iff-reverse'), {
+  status: 'checked',
+  evidence: 'Statement and steps 1.1 and 2.1: the reverse implication follows through the same checked equivalences in reverse.',
+});
+delete boundary(jordan, 'iff-reverse').reason;
+
+const lebesgue = document.contracts['thm-lebesgue-criterion-in-rn'];
+if (lebesgue.citations.some((row) => row.fact === 'L6')) throw new Error('L6 already exists');
+const lastL1 = lebesgue.citations.reduce((index, row, current) => row.fact === 'L1' ? current : index, -1);
+lebesgue.citations.splice(lastL1 + 1, 0, {
+  fact: 'L6',
+  source: 'cor-archimedean-reciprocal',
+  source_section: 'Statement',
+  quote: sourceSection('cor-archimedean-reciprocal', 'Statement'),
+  quote_selection: 'full-source-section',
+  uses: ['6.1'],
+});
+const lebesgueStep = lebesgue.derivations.find((row) => row.step === '6.1');
+lebesgueStep.claim = 'By [L1] and [L6], $D=\\bigcup_{r\\ge1}S_{1/r}$. Countable-union closure makes $D$ null, with countable choice used exactly through [[lem-null-sets-in-rn-closed-under-subsets-and-countable-unions]] and [[def-countable-choice]]. Together with step 5.1, this proves both directions using cover-nullity only.';
+lebesgueStep.inputs = ['step 5.1', 'step 3.2', 'L1', 'L6'];
+
+const geometric = document.contracts['ex-geometric-power-series-and-an-interior-reexpansion'];
+for (const citation of geometric.citations.filter((row) => row.fact === 'L2')) {
+  citation.uses = ['2.1'];
+}
+const geometricStep = geometric.derivations.find((row) => row.step === '2.1');
+geometricStep.claim = 'The general results in [L2] show qualitatively that the sum re-expands about $c$ and that the nonzero denominator there has a local reciprocal series. To identify that series and its full convergence interval directly, use $1-x=(1-c)(1-(x-c)/(1-c))$ and $1-c>0$, and apply [L1] with $t=(x-c)/(1-c)$. This gives the second formula precisely when $|x-c|<1-c$.';
+geometricStep.inputs = ['L1', 'L2'];
+
+const indicator = document.contracts['thm-jordan-content-and-indicator-integrability'];
+Object.assign(boundary(indicator, 'iff-forward'), {
+  status: 'checked',
+  evidence: 'Statement and steps 1.1, 2.1, and 3.1: equality of the Jordan contents implies equality of the lower and upper indicator integrals.',
+});
+delete boundary(indicator, 'iff-forward').reason;
+Object.assign(boundary(indicator, 'iff-reverse'), {
+  status: 'checked',
+  evidence: 'Statement and steps 1.1, 2.1, and 3.1: equality of the lower and upper indicator integrals implies equality of the Jordan contents.',
+});
+delete boundary(indicator, 'iff-reverse').reason;
+
+fs.writeFileSync(contractPath, `${JSON.stringify(document, null, 2)}\n`);
+console.log('updated four Wave 13 proof contracts exactly as authorized at A3');
