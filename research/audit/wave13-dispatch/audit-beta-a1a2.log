diff --git a//tmp/w13-contract-gen.mjs b//tmp/w13-contract-gen.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..8ccc21314835dda69e55a38272a2e67ff4588744
--- /dev/null
+++ b//tmp/w13-contract-gen.mjs
@@ -0,0 +1,155 @@
+import fs from 'node:fs';
+
+const pages = JSON.parse(fs.readFileSync('research/audit/wave13-real-analysis.pages.json', 'utf8'));
+const allIds = pages.flatMap((page) => page.items.map((item) => item.id));
+const supported = ['Statement', 'Statement refuted', 'Definition', 'Example'];
+
+function bodyOf(source) {
+  return source.replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n?/, '');
+}
+
+function section(body, heading) {
+  const escaped = heading.replace(/[.*+?^$(){}|[\]\\]/g, '\\$&');
+  const match = body.match(new RegExp(
+    '^## ' + escaped + '\\s*$\\r?\\n([\\s\\S]*?)(?=^##\\s+|(?![\\s\\S]))',
+    'm',
+  ));
+  return (match?.[1] ?? '').trim();
+}
+
+function parseFacts(body) {
+  return section(body, 'Facts & Assumptions').split(/\n\s*\n/).map((paragraph) => {
+    const match = paragraph.trim().match(/^\[([FAL]\d+)\]\s*([\s\S]*)$/);
+    if (!match) return null;
+    return {
+      label: match[1],
+      text: paragraph.trim(),
+      links: [...paragraph.matchAll(/\[\[([^\]|]+)(?:\|[^\]]*)?\]\]/g)].map((link) => link[1]),
+    };
+  }).filter(Boolean);
+}
+
+function parseSteps(body) {
+  for (const heading of ['Proof', 'Refutation', 'Counterexample', 'Verification']) {
+    const text = section(body, heading);
+    if (!text) continue;
+    return text.split(/\r?\n/).map((line) => {
+      const match = line.match(/^(\d+\.\d+)\s+(.+)$/);
+      return match ? { id: match[1], text: match[2] } : null;
+    }).filter(Boolean);
+  }
+  return [];
+}
+
+function clean(text) {
+  return text.replace(/\[\[[^\]]+\]\]/g, '').replace(/\s+/g, ' ').trim();
+}
+
+function boundary(name, status, detail) {
+  return status === 'checked'
+    ? { case: name, status, evidence: detail }
+    : { case: name, status, reason: detail };
+}
+
+function makeBoundaries(id, body, steps) {
+  const source = supported.map((heading) => ({ heading, text: section(body, heading) }))
+    .find((entry) => entry.text) ?? { heading: 'Statement', text: '' };
+  const snippet = clean(source.text).slice(0, 220);
+  const first = steps[0];
+  const hit = (pattern) => steps.find((step) => pattern.test(step.text));
+  const empty = hit(/\bempty\b|\\varnothing|=\s*\\emptyset|=\s*0\b.*(?:terms|family|dimension)|\bzero terms\b/i);
+  const zero = hit(/\b(?:case|if|when|at|put|suppose)\b[^.]{0,80}(?:=\s*0\b|\bzero\b)|\bR=0\b|\bL=0\b|\\varnothing/i);
+  const one = hit(/\b(?:case|if|when|at|put|suppose)\b[^.]{0,80}(?:=\s*1\b|\bone\b)|x\\uparrow1|x_N|\bN=1\b/i);
+  const degenerate = hit(/degenerate|nondegenerate|singleton|radius\s+0|\bR=0\b|\bL=\+?\\infty\b|constant case/i);
+  const endpoint = hit(/endpoint|boundary|x\\uparrow1|x_N|x\s*=\s*1\b|x\s*=\s*-1\b|c\s*=\s*a\b|c\s*=\s*b\b|closed interval/i);
+  const choice = hit(/\bchoose\b|\bselect\b|\bpick\b|\bfix\b[^.]{0,80}\bwith\b|\bthere (?:is|are)\b/i);
+  const iff = /if and only if|\bequivalent\b|exactly when|\\Longleftrightarrow/i.test(source.text);
+  const forward = hit(/forward implication|forward direction|\bif\b.*\bthen\b|suppose.*(?:integrable|converges|continuous|measurable)/i) ?? first;
+  const reverse = hit(/converse implication|converse direction|\bconversely\b|for the converse/i) ?? steps.at(-1);
+  const out = [];
+
+  out.push(empty
+    ? boundary('empty', 'checked', 'step ' + empty.id + ': the proof explicitly disposes of the empty or zero-length family case.')
+    : boundary('empty', 'not_applicable', id + ': the ' + source.heading + ' fixes the displayed objects and has no conclusion depending on an unlicensed choice from an empty family: ' + snippet));
+  out.push(zero
+    ? boundary('zero', 'checked', 'step ' + zero.id + ': the proof explicitly handles the zero-valued parameter or zero object used by the statement.')
+    : boundary('zero', 'not_applicable', id + ': no independent zero-parameter boundary remains after the stated hypotheses and definitions; checked against the ' + source.heading + ': ' + snippet));
+  out.push(one
+    ? boundary('one', 'checked', 'step ' + one.id + ': the proof explicitly handles the unit value, first index, or limit at one relevant to the assertion.')
+    : boundary('one', 'not_applicable', id + ': the assertion has no separate unit-size case; its quantified argument applies without a one-case split: ' + snippet));
+  out.push(degenerate
+    ? boundary('degenerate', 'checked', 'step ' + degenerate.id + ': the proof explicitly handles or excludes the degenerate configuration relevant to the statement.')
+    : /nondegenerate|positive radius|strictly inside|a\s*<\s*b/i.test(source.text)
+      ? boundary('degenerate', 'checked', source.heading + ': degeneracy is explicitly excluded or separated by the hypotheses: ' + snippet)
+      : boundary('degenerate', 'not_applicable', id + ': no geometric or algebraic degeneracy changes the asserted conclusion; checked against the ' + source.heading + ': ' + snippet));
+  out.push(endpoint
+    ? boundary('endpoints', 'checked', 'step ' + endpoint.id + ': the proof explicitly treats the endpoint, boundary, or radial-limit behaviour used by the assertion.')
+    : /open interval|strictly inside|interior point/i.test(source.text)
+      ? boundary('endpoints', 'checked', source.heading + ': the assertion expressly restricts to the open/interior regime, leaving endpoint behaviour outside its quantifiers: ' + snippet)
+      : boundary('endpoints', 'not_applicable', id + ': no interval or radial endpoint is part of the conclusion; checked against the ' + source.heading + ': ' + snippet));
+  out.push(choice
+    ? boundary('nonempty-choice', 'checked', 'step ' + choice.id + ': every witness selected there is drawn after the proof establishes the relevant positivity, existence, or nonemptiness condition.')
+    : boundary('nonempty-choice', 'not_applicable', id + ': the proof uses only given objects, formulas, or universal instantiation and makes no choice from a possibly empty family; see ' + source.heading + ': ' + snippet));
+  out.push(iff
+    ? boundary('iff-forward', 'checked', source.heading + ' and step ' + forward.id + ': the forward implication is represented among the numbered derivations beginning at this step.')
+    : boundary('iff-forward', 'not_applicable', id + ': the ' + source.heading + ' is not an equivalence, so there is no forward implication obligation: ' + snippet));
+  out.push(iff
+    ? boundary('iff-reverse', 'checked', source.heading + ' and step ' + reverse.id + ': the reverse implication is represented among the numbered derivations ending at or before this step.')
+    : boundary('iff-reverse', 'not_applicable', id + ': the ' + source.heading + ' is not an equivalence, so there is no reverse implication obligation: ' + snippet));
+  return out;
+}
+
+const contracts = {};
+const scope = [];
+for (const id of allIds) {
+  const body = bodyOf(fs.readFileSync('items/' + id + '.md', 'utf8'));
+  const steps = parseSteps(body);
+  if (!steps.length) continue;
+  scope.push(id);
+  const citations = [];
+  for (const fact of parseFacts(body)) {
+    for (const source of fact.links) {
+      const sourceBody = bodyOf(fs.readFileSync('items/' + source + '.md', 'utf8'));
+      const sourceSection = supported.find((heading) => section(sourceBody, heading));
+      citations.push({
+        fact: fact.label,
+        source,
+        source_section: sourceSection,
+        quote: section(sourceBody, sourceSection),
+        quote_selection: 'full-source-section',
+        uses: steps.filter((step) => new RegExp('\\b' + fact.label + '\\b').test(step.text))
+          .map((step) => step.id),
+      });
+    }
+  }
+  const derivations = steps.map((step) => {
+    const inputs = [...new Set([...step.text.matchAll(/\b(?:step\s+)?(\d+\.\d+)\b|\b([FAL]\d+)\b/g)]
+      .map((match) => match[2] ?? ('step ' + match[1])))];
+    if (!inputs.length) {
+      const tags = step.text.match(/\[([^\]]+)\]\s*(?:∎)?$/)?.[1];
+      inputs.push(...(tags
+        ? tags.split(',').map((value) => value.trim()).filter(Boolean)
+        : ['directly from the stated hypotheses']));
+    }
+    const cut = step.text.lastIndexOf(' [');
+    return {
+      id: 'step-' + step.id,
+      claim: cut > 0 ? step.text.slice(0, cut) : step.text,
+      step: step.id,
+      inputs,
+    };
+  });
+  contracts[id] = {
+    citations,
+    derivations,
+    routine_steps: [],
+    boundaries: makeBoundaries(id, body, steps),
+  };
+}
+
+process.stdout.write(JSON.stringify({
+  version: 1,
+  level: 'audit-wave13-real-analysis',
+  scope,
+  contracts,
+}));
