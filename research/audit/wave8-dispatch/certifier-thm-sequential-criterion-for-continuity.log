    28	      url: "https://www.jirka.org/ra/html/sec_limoffunc.html"
    29	    - title: "Limit of a function (Wikipedia)"
    30	      url: "https://en.wikipedia.org/wiki/Limit_of_a_function"
    31	    - title: "W. Rudin, Principles of Mathematical Analysis, 3rd ed., Ch. 4 (Thm 4.2)"
    32	      url: "https://en.wikipedia.org/wiki/Principles_of_Mathematical_Analysis"
