research/audit/wave8-real-analysis-absolute-convergence.provenance.jsonl-13-{"id":"thm-mertens","statement":"ai-altered","proof":"ai-altered","evidence":"semantic-source","urls":["https://faculty.etsu.edu/gardnerr/4217/notes/7-2.pdf"],"rationale":"Gardner's Theorem 7-17 gives Mertens' one-absolutely-convergent-factor hypothesis and the product-of-sums conclusion. The item packages the theorem with a local finite triangular identity and expanded proof. This live source supersedes the inaccessible JHU real-analysis PDF.","alpha_concurred":false,"at":"2026-08-09"}
