justified_by: []
aliases: []
landmark: false
short: "$\\mathbb{R}\\setminus\\mathbb{Q}$ uncountable"
proof_strategy: contradiction
verification:
  precheck: pass
  verified:
    model: claude-opus-5
    verdict: certify
