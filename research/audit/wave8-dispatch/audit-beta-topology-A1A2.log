+          "inputs": [
+            "F2",
+            "choose"
+          ]
+        },
+        {
+          "id": "step-2-1",
+          "claim": "The nonempty traces $V\\cap A$ for $V\\in\\mathcal V$ cover $A$, are open in $A$, and refine $\\mathcal U$: a $V$ meeting $A$ cannot be contained in $X\\setminus A$, so its containing member of $\\mathcal W$ is an ambient representative of a member of $\\mathcal U$. [F1, step 1.1, step 1.2]",
+          "step": "2.1",
+          "inputs": [
+            "F1",
+            "1.1",
+            "1.2"
+          ]
