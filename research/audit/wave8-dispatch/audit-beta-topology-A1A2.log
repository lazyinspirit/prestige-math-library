+          "id": "step-2-1",
+          "claim": "Put $C'_\\alpha:=C_\\alpha\\setminus\\overline{\\mathcal G_\\alpha}$. Each $C'_\\alpha$ is open and refines $C_\\alpha$. [step 1.1, construct]",
+          "step": "2.1",
+          "inputs": [
+            "1.1",
+            "construct"
