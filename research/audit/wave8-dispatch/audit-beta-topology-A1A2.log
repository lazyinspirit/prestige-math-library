+    "cor-metric-spaces-admit-subordinate-partitions-of-unity": {
+      "citations": [
+        {
+          "fact": "L1",
+          "source": "thm-stone-metric-spaces-are-paracompact",
+          "source_section": "Statement",
+          "quote": "Assume the Axiom of Choice. Every metric space is paracompact.",
