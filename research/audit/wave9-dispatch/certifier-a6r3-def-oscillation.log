research/audit/wave9-real-analysis.proof-contracts.json:6020:          "id": "ex-thomae-values-and-oscillation-computed-step-1-1",
research/audit/wave9-real-analysis.proof-contracts.json-6021-          "claim": "Claim 1: for an integer $m$ one has $\\iota(1)\\,m = m \\in \\mathbb{Z}$, so $1 \\in Q(m)$ and $q(m) = 1$, the least element of a set of naturals $\\ge 1$ containing $1$; hence $t(m) = 1/\\iota(1) = 1$. The case $m = 0$ is included. [A1, L2]",
research/audit/wave9-real-analysis.proof-contracts.json-6022-          "step": "1.1",
