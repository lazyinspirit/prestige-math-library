      {
        "id": "ex-masked-diffusion-single-token-posterior",
        "kind": "example",
        "title": "One-token posterior on a finite mask schedule",
        "deps": [
          "def-finite-masking-diffusion-chain",
          "thm-masking-chain-posterior"
        ],
        "justified_by": [],
        "dependency_level": 3,
        "statement": "Take $V=\\{a,b\\}$, $L=1$, $N=2$, $\\alpha_0=1$, $\\alpha_1=1/2$, $\\alpha_2=0$, and clean token $X=a$. At the reverse pair $(s,t)=(1,2)$, observing $Z_2=m$ has probability one and the true posterior assigns probability $1/2$ to $Z_1=a$ and $1/2$ to $Z_1=m$. At the reverse pair $(s,t)=(0,1)$, conditional on the positive-probability event $Z_1=m$, the true posterior removes the mask with probability one."
