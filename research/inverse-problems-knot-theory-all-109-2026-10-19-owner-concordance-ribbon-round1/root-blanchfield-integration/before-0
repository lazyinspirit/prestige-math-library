        "justified_by": [],
        "proof_strategy": "direct",
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "Tim D. Cochran, Kent E. Orr, and Peter Teichner, Knot concordance, Whitney towers and L²-signatures, §2.1",
              "url": "https://arxiv.org/pdf/math/9908117"
            },
            {
              "title": "C. Löh, Geometric Group Theory: An Introduction",
              "url": "https://loeh.app.uni-regensburg.de/teaching/ggt_ws1415/lecture_notes_old.pdf"
            }
          ]
        },
        "statement": "Let $k$ be a commutative field and let $H\\trianglelefteq G$ be a normal subgroup with torsion-free abelian quotient $G/H$. If $k[H]$ has no zero divisors, then $k[G]$ has no zero divisors. The group extension need not split; neither finite generation of $G/H$ nor an order on all of $G$ is assumed.",
        "dependency_level": 1
      },
      {
        "id": "lem-ptfa-groups-have-finite-folner-sets",
        "kind": "lemma",
        "title": "PTFA groups satisfy the finite Folner condition without a choice hypothesis",
        "deps": [
          "def-poly-torsion-free-abelian-group",
          "def-folner-set-and-folner-condition",
          "lem-finitely-generated-torsion-free-abelian-freeness-without-choice"
        ],
        "justified_by": [],
        "proof_strategy": "direct",
        "provenance": {
          "statement": "ai-altered",
          "proof": "ai-altered"
        },
        "sources": {
          "references": [
            {
              "title": "Tim D. Cochran, Kent E. Orr, and Peter Teichner, Knot concordance, Whitney towers and L²-signatures, §2.1",
              "url": "https://arxiv.org/pdf/math/9908117"
            },
            {
              "title": "C. Löh, Geometric Group Theory: An Introduction",
              "url": "https://loeh.app.uni-regensburg.de/teaching/ggt_ws1415/lecture_notes_old.pdf"
            }
          ]
        },
        "statement": "Every group admitting a finite subnormal series with torsion-free abelian factors satisfies the left Folner condition: for each finite subset $S$ and each $\\varepsilon>0$ there exists a finite nonempty subset $F$ with $|sF\\triangle F|<\\varepsilon|F|$ for every $s\\in S$. This assertion requires no countability or finite-generation hypothesis and no choice axiom. More generally the finite Folner condition is preserved by arbitrary group extensions whose kernel and quotient satisfy it.",
        "dependency_level": 1
      },
      {
        "id": "thm-ptfa-group-rings-are-ore-domains",
        "kind": "theorem",
        "title": "PTFA group rings embed in skew fields of fractions",
        "deps": [
