          "lem-ptfa-groups-have-finite-folner-sets",
          "lem-folner-group-ring-domains-have-ore-fractions"
        ],
        "justified_by": [],
        "dependency_level": 2,
        "proof_strategy": "direct",
        "provenance": {
          "statement": "literature-derived",
          "proof": "ai-altered"
        },
        "sources": {
          "scraped": [],
          "references": [
            {
              "title": "Tim D. Cochran, Kent E. Orr, and Peter Teichner, “Knot concordance, Whitney towers and L²-signatures”",
              "url": "https://arxiv.org/pdf/math/9908117",
              "locator": "§2.1, Proposition 2.5; the proof cites the PTFA group-ring Ore theorem"
            }
          ]
        },
        "statement": "Let G be a PTFA group and let QG be its group ring over the rational field. Then QG has no zero divisors and satisfies both the left and right Ore conditions. Consequently QG embeds in a skew field of fractions in which every nonzero element of QG is invertible."
