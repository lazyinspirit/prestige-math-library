        "id": "lem-finitely-generated-torsion-free-abelian-freeness-without-choice",
        "kind": "lemma",
        "title": "Finite torsion-free abelian freeness by explicit rational coordinates without choice",
        "deps": [
          "def-group",
          "def-vector-space",
          "thm-rat-field",
          "lem-subgroups-of-z-are-cyclic"
        ],
        "justified_by": [],
        "proof_strategy": "direct",
        "provenance": {
