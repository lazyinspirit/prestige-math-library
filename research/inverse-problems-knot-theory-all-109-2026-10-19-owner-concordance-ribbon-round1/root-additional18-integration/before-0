      {
        "id": "lem-ore-localization-is-flat-and-detects-module-torsion",
        "kind": "lemma",
        "title": "Ore localization is flat and detects module torsion",
        "deps": [
          "def-ring",
          "def-division-ring",
          "def-left-and-right-modules",
