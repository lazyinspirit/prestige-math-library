{
  "version": 1,
  "scope": [
    "thm-bonferroni-simultaneous-coverage",
    "thm-bonferroni-familywise-error-control",
    "ex-bonferroni-simultaneous-coverage-with-dependent-intervals",
    "ex-discrete-superuniform-p-value-and-global-null"
  ],
  "contracts": {
    "thm-bonferroni-simultaneous-coverage": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-statistical-experiment",
          "source_section": "Definition",
          "quote": "An **experiment** is a measurable space $(\\mathcal X,\\mathcal A)$, a set $\\Theta$ of parameter labels, and a family $(P_\\theta)_{\\theta\\in\\Theta}$ of probability measures on $(\\mathcal X,\\mathcal A)$ ([[def-measurable-space]], [[def-probability-measure]]). The measures $P_\\theta$ are the sampling laws.",
          "uses": ["2.1"]
        },
        {
          "fact": "F2",
          "source": "def-confidence-set-and-coverage",
          "source_section": "Definition",
          "quote": "A **confidence-set procedure** is a map $C:\\mathcal X\\to\\mathcal P(\\Theta)$, where $\\mathcal P(\\Theta):=\\{A:A\\subseteq\\Theta\\}$, such that, for every $\\eta\\in\\Theta$, its membership section $$C_\\eta:=\\{x\\in\\mathcal X:\\eta\\in C(x)\\}$$ belongs to $\\mathcal A$. Its **coverage at $\\theta$** is $c_C(\\theta):=P_\\theta(C_\\theta)$",
          "uses": ["1.1"]
        },
        {
          "fact": "F3",
          "source": "lem-probability-measure-basic-identities",
          "source_section": "Statement",
          "quote": "4. $\\mathbb P(\\bigcup_n A_n)\\le\\sum_{n=0}^\\infty \\mathbb P(A_n)$, and for every natural $m$, $$\\mathbb P\\left(\\bigcup_{n<m}A_n\\right)\\le\\sum_{n<m}\\mathbb P(A_n).$$",
          "uses": ["1.1", "2.1"]
        }
      ],
      "derivations": [
        {
          "id": "induced-confidence-sections",
          "claim": "The coordinate set procedures induce measurable confidence sets for the full parameter, and their miss-event probabilities are at most the allocated alpha_i.",
          "step": "1.1",
          "inputs": ["given", "A1", "F2", "F3"]
        },
        {
          "id": "joint-union-bound",
          "claim": "The joint miss event is a finite union, so its probability is at most the sum of marginal miss probabilities and the joint coverage is at least one minus alpha.",
          "step": "2.1",
          "inputs": ["given", "F1", "F3", "step 1.1"]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {"case": "empty", "status": "checked", "evidence": "If every miss event is empty, the union has probability zero; step 2.1 still yields coverage one."},
        {"case": "zero", "status": "checked", "evidence": "When alpha is zero, all nonnegative alpha_i are zero; steps 1.1 and 2.1 give zero total miss probability."},
        {"case": "one", "status": "checked", "evidence": "For m=1, step 2.1 is the single marginal coverage bound."},
        {"case": "degenerate", "status": "checked", "evidence": "Step 2.1 permits identical or otherwise dependent miss events; no independence premise enters the union bound."},
        {"case": "endpoints", "status": "checked", "evidence": "The assumptions include alpha_i in [0,1] and alpha in [0,1]; steps 1.1 and 2.1 also cover the endpoints."},
        {"case": "nonempty-choice", "status": "not_applicable", "reason": "The proof constructs induced sets from fixed maps and makes no choice from a family of nonempty sets."},
        {"case": "iff-forward", "status": "not_applicable", "reason": "The statement is a one-way coverage implication, not an equivalence."},
        {"case": "iff-reverse", "status": "not_applicable", "reason": "The statement is a one-way coverage implication, not an equivalence."}
      ]
    },
    "thm-bonferroni-familywise-error-control": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-null-valid-p-value-and-fwer-fdr",
          "source_section": "Definition",
          "quote": "For $\\theta\\in\\Theta$, the **true-null index set** is $$I_0(\\theta):=\\{i\\in[m]:\\theta\\in H_{0i}\\}.$$ A fixed deterministic multiple-testing rule is a family of measurable rejection events $D_i\\in\\mathcal A$, one for each $i\\in[m]$. Its total number of rejections and number of false rejections at parameter $\\theta$ are $$R:=\\sum_{i=1}^m\\mathbf1_{D_i},\\qquad V_\\theta:=\\sum_{i\\in I_0(\\theta)}\\mathbf1_{D_i}.$$ Its **familywise error rate (FWER)** at $\\theta$ is $P_\\theta(V_\\theta\\ge1)$",
          "uses": ["1.1", "2.1"]
        },
        {
          "fact": "F2",
          "source": "thm-p-value-superuniformity",
          "source_section": "Statement",
          "quote": "For every $\\alpha\\in[0,1]$, the deterministic test with rejection function $$\\varphi_\\alpha(x)=\\mathbf 1_{\\{p(x)\\le\\alpha\\}}$$ satisfies $$P_\\theta(p(X)\\le\\alpha)=E_\\theta[\\varphi_\\alpha(X)]\\le\\alpha \\qquad(\\theta\\in\\Theta_0).$$",
          "uses": ["1.1"]
        },
        {
          "fact": "F3",
          "source": "lem-probability-measure-basic-identities",
          "source_section": "Statement",
          "quote": "4. $\\mathbb P(\\bigcup_n A_n)\\le\\sum_{n=0}^\\infty \\mathbb P(A_n)$, and for every natural $m$, $$\\mathbb P\\left(\\bigcup_{n<m}A_n\\right)\\le\\sum_{n<m}\\mathbb P(A_n).$$",
          "uses": ["2.1"]
        }
      ],
      "derivations": [
        {
          "id": "pointwise-null-thresholds",
          "claim": "Every true-null rejection event at the Bonferroni threshold is measurable and has probability at most alpha divided by m.",
          "step": "1.1",
          "inputs": ["given", "F1", "F2"]
        },
        {
          "id": "familywise-union-bound",
          "claim": "The event of at least one true-null rejection is the union of the true-null threshold events and has probability at most alpha.",
          "step": "2.1",
          "inputs": ["given", "F1", "F3", "step 1.1"]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {"case": "empty", "status": "checked", "evidence": "Step 2.1 explicitly treats I_0(theta) empty: both the rejection event and sum are empty and FWER is zero."},
        {"case": "zero", "status": "checked", "evidence": "At alpha=0, step 1.1 gives zero probability for each true-null threshold event, and step 2.1 gives FWER zero."},
        {"case": "one", "status": "checked", "evidence": "For m=1 the threshold is alpha and the bound in step 2.1 is the single p-value bound."},
        {"case": "degenerate", "status": "checked", "evidence": "Step 2.1 includes both the global-null case |I_0|=m and the case |I_0|=0; it does not assume independence."},
        {"case": "endpoints", "status": "checked", "evidence": "Alpha=0 and alpha=1 are allowed in the Given clause; step 1.1 verifies alpha/m lies in the p-value validity domain."},
        {"case": "nonempty-choice", "status": "not_applicable", "reason": "The proof uses the given finite index family and makes no nonempty-choice selection."},
        {"case": "iff-forward", "status": "not_applicable", "reason": "The theorem asserts an upper bound and no equivalence."},
        {"case": "iff-reverse", "status": "not_applicable", "reason": "The theorem asserts an upper bound and no equivalence."}
      ]
    },
    "ex-bonferroni-simultaneous-coverage-with-dependent-intervals": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-statistical-experiment",
          "source_section": "Definition",
          "quote": "An **experiment** is a measurable space $(\\mathcal X,\\mathcal A)$, a set $\\Theta$ of parameter labels, and a family $(P_\\theta)_{\\theta\\in\\Theta}$ of probability measures on $(\\mathcal X,\\mathcal A)$ ([[def-measurable-space]], [[def-probability-measure]]).",
          "uses": ["1.1"]
        },
        {
          "fact": "F2",
          "source": "def-confidence-set-and-coverage",
          "source_section": "Definition",
          "quote": "A **confidence-set procedure** is a map $C:\\mathcal X\\to\\mathcal P(\\Theta)$, where $\\mathcal P(\\Theta):=\\{A:A\\subseteq\\Theta\\}$, such that, for every $\\eta\\in\\Theta$, its membership section $$C_\\eta:=\\{x\\in\\mathcal X:\\eta\\in C(x)\\}$$ belongs to $\\mathcal A$. Its **coverage at $\\theta$** is $c_C(\\theta):=P_\\theta(C_\\theta)$",
          "uses": ["1.1"]
        },
        {
          "fact": "F3",
          "source": "thm-bonferroni-simultaneous-coverage",
          "source_section": "Statement",
          "quote": "Then, for every $\\theta\\in\\Theta$, $$P_\\theta\\{\\psi_i(\\theta)\\in C_i(X)\\text{ for every }i\\in[m]\\}\\ge1-\\alpha.$$ Thus the family of marginal confidence sets has simultaneous coverage at least $1-\\alpha$. No independence assumption is needed.",
          "uses": ["2.1"]
        }
      ],
      "derivations": [
        {
          "id": "marginal-coverage",
          "claim": "Each interval has measurable membership sections and contains the true parameter for nine of the ten equally likely outcomes.",
          "step": "1.1",
          "inputs": ["given", "A1", "F1", "F2"]
        },
        {
          "id": "dependent-joint-coverage",
          "claim": "The two membership events coincide, so exact joint coverage is nine tenths and it meets the Bonferroni lower bound four fifths.",
          "step": "2.1",
          "inputs": ["given", "A1", "F3", "step 1.1"]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {"case": "empty", "status": "not_applicable", "reason": "This worked model fixes two nonempty interval procedures; the example does not consider an empty family."},
        {"case": "zero", "status": "not_applicable", "reason": "The example fixes alpha_1=alpha_2=1/10 and does not vary the error allocation to zero."},
        {"case": "one", "status": "not_applicable", "reason": "The example specifically illustrates two identical coverage events rather than a single interval."},
        {"case": "degenerate", "status": "checked", "evidence": "Step 2.1 handles the degenerate dependence case where both membership events are identical."},
        {"case": "endpoints", "status": "not_applicable", "reason": "The example uses interior error allocations and makes no endpoint claim."},
        {"case": "nonempty-choice", "status": "not_applicable", "reason": "The finite model and interval procedures are explicitly given; no choice is used."},
        {"case": "iff-forward", "status": "not_applicable", "reason": "The example verifies coverage values and does not assert an equivalence."},
        {"case": "iff-reverse", "status": "not_applicable", "reason": "The example verifies coverage values and does not assert an equivalence."}
      ]
    },
    "ex-discrete-superuniform-p-value-and-global-null": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-statistical-experiment",
          "source_section": "Definition",
          "quote": "An **experiment** is a measurable space $(\\mathcal X,\\mathcal A)$, a set $\\Theta$ of parameter labels, and a family $(P_\\theta)_{\\theta\\in\\Theta}$ of probability measures on $(\\mathcal X,\\mathcal A)$ ([[def-measurable-space]], [[def-probability-measure]]).",
          "uses": ["1.1"]
        },
        {
          "fact": "F2",
          "source": "def-null-valid-p-value-and-fwer-fdr",
          "source_section": "Definition",
          "quote": "It is **valid for $H_{0i}$** when $$P_\\theta\\{x:p_i(x)\\le u\\}\\le u\\qquad(\\theta\\in H_{0i},\\ 0\\le u\\le1).$$",
          "uses": ["1.1", "1.2", "2.1"]
        },
        {
          "fact": "F3",
          "source": "thm-bonferroni-familywise-error-control",
          "source_section": "Statement",
          "quote": "Then, for every $\\theta$ in the parameter space, $$P_\\theta\\{\\text{at least one true null is rejected}\\}=P_\\theta(V_\\theta\\ge1)\\le\\alpha.$$\nThe bound holds for every true-null configuration, including the global null and configurations with false nulls, and for arbitrary dependence among the p-values.",
          "uses": ["2.1"]
        }
      ],
      "derivations": [
        {
          "id": "discrete-validity",
          "claim": "The four-point discrete uniform variable has cumulative probability floor(4u)/4, which is at most u, so each p-value is valid whenever its null is true.",
          "step": "1.1",
          "inputs": ["given", "A1", "F1", "F2", "algebra"]
        },
        {
          "id": "global-null-rates",
          "claim": "At theta=0 the p-values are identical, and the rejection event occurs with probability one quarter; because both nulls are true, FDR equals FWER.",
          "step": "1.2",
          "inputs": ["given", "A1", "F2", "algebra"]
        },
        {
          "id": "mixed-null-rates",
          "claim": "At theta=1 only the second null is true; its rejection event has probability one quarter and its false discovery proportion is one half on that event, giving FDR one eighth, while strong Bonferroni FWER control remains at most one half.",
          "step": "2.1",
          "inputs": ["given", "A1", "F2", "F3", "step 1.2", "algebra"]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {"case": "empty", "status": "not_applicable", "reason": "Both parameter values in this worked example have at least one true null; the general theorem separately covers no true nulls."},
        {"case": "zero", "status": "not_applicable", "reason": "The example fixes alpha=1/2 and does not vary the rejection threshold to zero."},
        {"case": "one", "status": "not_applicable", "reason": "The example uses a family of two hypotheses to compare global and mixed configurations."},
        {"case": "degenerate", "status": "checked", "evidence": "Step 1.2 checks the perfectly dependent identical-p-value case under the global null."},
        {"case": "endpoints", "status": "checked", "evidence": "Step 1.1 includes U=1 and verifies superuniformity for every u in the closed interval [0,1]."},
        {"case": "nonempty-choice", "status": "not_applicable", "reason": "All four atoms and both laws are explicitly listed; no choice is made."},
        {"case": "iff-forward", "status": "not_applicable", "reason": "The example compares error rates and does not assert an equivalence."},
        {"case": "iff-reverse", "status": "not_applicable", "reason": "The example compares error rates and does not assert an equivalence."}
      ]
    }
  }
}
