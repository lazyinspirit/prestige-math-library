{
  "version": 1,
  "scope": [
    "lem-benjamini-hochberg-leave-one-out-identity",
    "thm-benjamini-hochberg-independent-fdr",
    "ex-benjamini-hochberg-fdr-versus-fwer"
  ],
  "contracts": {
    "lem-benjamini-hochberg-leave-one-out-identity": {
      "citations": [
        {
          "fact": "F1",
          "source": "alg-benjamini-hochberg-step-up-procedure",
          "source_section": "Definition",
          "quote": "Reject exactly the hypotheses at ranks $1,\\ldots,R$. If the set in the maximum is empty, then $R=0$ and no hypothesis is rejected.",
          "uses": ["3.1", "4.1", "4.2"]
        },
        {
          "fact": "F2",
          "source": "def-measurable-function-between-measurable-spaces",
          "source_section": "Definition",
          "quote": "A function $f : X \\to Y$ is **measurable** when $$f^{-1}(B) \\in \\mathcal{A} \\qquad \\text{for every } B \\in \\mathcal{B}.$$",
          "uses": ["1.1", "2.1"]
        },
        {
          "fact": "F3",
          "source": "def-borel-sigma-algebra",
          "source_section": "Definition",
          "quote": "The **Borel sigma-algebra of $X$** is the sigma-algebra generated by its open sets: $$\\mathcal B(X):=\\sigma_X(\\mathcal T).$$",
          "uses": ["1.1"]
        }
      ],
      "derivations": [
        {
          "id": "order-statistic-measurability",
          "claim": "For every k and a, the k-th order statistic sublevel event is a finite union of finite intersections of coordinate sublevel events; these are measurable by the Borel and preimage definitions, including after deleting a coordinate.",
          "step": "1.1",
          "inputs": ["given", "F2", "F3"]
        },
        {
          "id": "threshold-count-measurability",
          "claim": "The finite candidate indicators and their maxima define measurable R and S_i, and S_i is measurable with respect to the sigma-algebra generated by the other coordinates.",
          "step": "2.1",
          "inputs": ["F2", "step 1.1"]
        },
        {
          "id": "rejection-threshold-equivalence",
          "claim": "The step-up rejection ranks are exactly the indices whose values are at most Rq/m, including R=0, 0<R<m, and R=m.",
          "step": "3.1",
          "inputs": ["F1", "step 2.1"]
        },
        {
          "id": "forward-leave-one-out-identity",
          "claim": "If P_i is at most (S_i+1)q/m, then R=S_i+1 and i is rejected.",
          "step": "4.1",
          "inputs": ["given", "F1", "step 3.1"]
        },
        {
          "id": "reverse-leave-one-out-identity",
          "claim": "If i is rejected, then P_i cannot exceed (S_i+1)q/m.",
          "step": "4.2",
          "inputs": ["F1", "step 3.1"]
        },
        {
          "id": "pointwise-contribution-formula",
          "claim": "Combining the two rejection directions gives I_i/(R vee 1)=1{P_i <= (S_i+1)q/m}/(S_i+1).",
          "step": "5.1",
          "inputs": ["step 4.1", "step 4.2"]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {"case": "empty", "status": "checked", "evidence": "The statement allows m=1, so the leave-one-out family is empty and S_i=0; see the statement and steps 2.1 and 4.1."},
        {"case": "zero", "status": "checked", "evidence": "A value P_i=0 satisfies the first threshold because q>0; step 3.1 includes this case."},
        {"case": "one", "status": "checked", "evidence": "For m=1, S_i=0 and the rule has only rank 1; see the statement and steps 3.1 and 4.1."},
        {"case": "degenerate", "status": "checked", "evidence": "Tied and constant values are covered by the ordered-value argument, and no tie can cross the final threshold; see step 3.1."},
        {"case": "endpoints", "status": "checked", "evidence": "The algorithm assumes 0<q<1; step 3.1 explicitly handles P_i=0, and P_i=1 exceeds every rejection threshold."},
        {"case": "nonempty-choice", "status": "checked", "evidence": "Steps 1.1 and 2.1 use finite unions, intersections, and maxima over finite index sets; no choice is used."},
        {"case": "iff-forward", "status": "not_applicable", "reason": "The identity is proved as a pointwise equivalence of rejection and a threshold event, but no separate iff theorem is asserted."},
        {"case": "iff-reverse", "status": "not_applicable", "reason": "The identity is proved as a pointwise equivalence of rejection and a threshold event, but no converse theorem beyond that identity is asserted."}
      ],
      "finite_checks": []
    },
    "thm-benjamini-hochberg-independent-fdr": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-false-discovery-rate-and-familywise-error-rate",
          "source_section": "Definition",
          "quote": "and the **false discovery rate** is $$\\operatorname{FDR}:=\\mathbb E_P\\!\\left[\\frac{V}{R\\vee1}\\right].$$",
          "uses": ["4.1"]
        },
        {
          "fact": "F2",
          "source": "alg-benjamini-hochberg-step-up-procedure",
          "source_section": "Definition",
          "quote": "Reject exactly the hypotheses at ranks $1,\\ldots,R$. If the set in the maximum is empty, then $R=0$ and no hypothesis is rejected.",
          "uses": ["1.1"]
        },
        {
          "fact": "F3",
          "source": "def-p-value",
          "source_section": "Definition",
          "quote": "A **p-value statistic** is a statistic $p:\\mathcal X\\to[0,1]$",
          "uses": ["1.1"]
        },
        {
          "fact": "F4",
          "source": "def-independent-random-elements",
          "source_section": "Definition",
          "quote": "The family $(X_i)_{i\\in I}$ is **independent** when the sigma-algebras $(\\sigma(X_i))_{i\\in I}$ are independent in the sense of [[def-independent-sigma-algebras-and-events]].",
          "uses": ["1.1"]
        },
        {
          "fact": "F5",
          "source": "thm-grouping-independent-sigma-algebras",
          "source_section": "Statement",
          "quote": "Then the sigma-algebras $\\mathcal G_0,\\dots,\\mathcal G_{m-1}$ are independent.",
          "uses": ["1.1"]
        },
        {
          "fact": "F6",
          "source": "thm-independent-random-elements-have-product-joint-law",
          "source_section": "Statement",
          "quote": "Then $X$ is a random element of $\\left(\\prod_{i<n}S_i,\\bigotimes_{i<n}\\Sigma_i\\right)$, and its law is the finite product of the marginal laws: $$\\mathbb P_X=\\bigotimes_{i<n}\\mathbb P_{X_i}.$$",
          "uses": ["1.1", "2.1"]
        },
        {
          "fact": "F7",
          "source": "lem-benjamini-hochberg-leave-one-out-identity",
          "source_section": "Statement",
          "quote": "Then $S_i$ is measurable with respect to the sigma-algebra generated by the other coordinates and, pointwise, $$\\frac{I_i}{R\\vee1}=\\frac{\\mathbf 1\\{P_i\\le(S_i+1)q/m\\}}{S_i+1}.$$",
          "uses": ["1.1", "3.1"]
        },
        {
          "fact": "F8",
          "source": "cor-expectation-of-an-indicator-is-probability",
          "source_section": "Statement",
          "quote": "Then the indicator $\\mathbf 1_A$ satisfies $$\\mathbb E[\\mathbf 1_A]=\\mathbb P(A).$$",
          "uses": ["3.1"]
        },
        {
          "fact": "F9",
          "source": "cor-expectation-linearity-monotonicity-and-modulus-bound",
          "source_section": "Statement",
          "quote": "For scalars $a,b$, $$\\mathbb E[aX+bY]=a\\,\\mathbb E[X]+b\\,\\mathbb E[Y].$$",
          "uses": ["3.1", "4.1"]
        },
        {
          "fact": "F10",
          "source": "def-expectation-of-a-nonnegative-or-integrable-random-variable",
          "source_section": "Definition",
          "quote": "If $X:\\Omega\\to[0,+\\infty]$ is measurable, its **expectation** is the extended-valued integral $$\\mathbb E[X]:=\\int_\\Omega X\\,d\\mathbb P\\in[0,+\\infty].$$",
          "uses": ["3.1"]
        }
      ],
      "derivations": [
        {
          "id": "leave-one-out-independence",
          "claim": "For each true-null i, the exact-uniform p-value is independent of the leave-one-out statistic S_i, so their joint law factors.",
          "step": "1.1",
          "inputs": ["given", "A1", "F2", "F3", "F4", "F5", "F6", "F7"]
        },
        {
          "id": "uniform-leave-one-out-event",
          "claim": "For each r, P(p_i <= (r+1)q/m, S_i=r)=((r+1)q/m)P(S_i=r).",
          "step": "2.1",
          "inputs": ["A1", "F6", "step 1.1"]
        },
        {
          "id": "single-null-fdr-contribution",
          "claim": "The expected false-discovery-fraction contribution of each true-null hypothesis is q/m after summing the leave-one-out partition.",
          "step": "3.1",
          "inputs": ["F7", "F8", "F9", "F10", "step 2.1"]
        },
        {
          "id": "total-fdr-bound",
          "claim": "Summing over the finite true-null set yields FDR=(m0/m)q<=q.",
          "step": "4.1",
          "inputs": ["F1", "F9", "step 3.1"]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {"case": "empty", "status": "checked", "evidence": "If I_0(theta) is empty, the finite sum in step 4.1 is zero, so FDR=0."},
        {"case": "zero", "status": "checked", "evidence": "False-null p-values may be degenerate at zero; the pointwise identity and threshold factorization still apply in steps 1.1–3.1."},
        {"case": "one", "status": "checked", "evidence": "For m=1 the leave-one-out statistic is S_i=0 and step 3.1 gives contribution q for a true null; step 4.1 handles m_0=0."},
        {"case": "degenerate", "status": "checked", "evidence": "False-null laws may be atomic or constant; the proof uses only independence and exact uniformity for true nulls, as stated and used in steps 1.1–3.1."},
        {"case": "endpoints", "status": "checked", "evidence": "The level satisfies 0<q<1; every t_r=(r+1)q/m is at most q<1 in step 2.1, and the uniform law includes p-value endpoints."},
        {"case": "nonempty-choice", "status": "checked", "evidence": "The proof uses finite groups, finite products, and finite sums only; see steps 1.1 and 4.1 and the final Remarks."},
        {"case": "iff-forward", "status": "not_applicable", "reason": "The theorem is a one-way FDR identity and bound, not an equivalence."},
        {"case": "iff-reverse", "status": "not_applicable", "reason": "The theorem is a one-way FDR identity and bound, not an equivalence."}
      ],
      "finite_checks": []
    },
    "ex-benjamini-hochberg-fdr-versus-fwer": {
      "citations": [
        {
          "fact": "F1",
          "source": "def-false-discovery-rate-and-familywise-error-rate",
          "source_section": "Definition",
          "quote": "The **false discovery proportion** is $$\\operatorname{FDP}:=\\frac{V}{R\\vee1},\\qquad R\\vee1:=\\max(R,1),$$ and the **false discovery rate** is $$\\operatorname{FDR}:=\\mathbb E_P\\!\\left[\\frac{V}{R\\vee1}\\right].$$",
          "uses": ["2.1", "3.1"]
        },
        {
          "fact": "F2",
          "source": "alg-benjamini-hochberg-step-up-procedure",
          "source_section": "Definition",
          "quote": "Reject exactly the hypotheses at ranks $1,\\ldots,R$. If the set in the maximum is empty, then $R=0$ and no hypothesis is rejected.",
          "uses": ["1.1"]
        },
        {
          "fact": "F3",
          "source": "def-independent-random-elements",
          "source_section": "Definition",
          "quote": "The family $(X_i)_{i\\in I}$ is **independent** when the sigma-algebras $(\\sigma(X_i))_{i\\in I}$ are independent in the sense of [[def-independent-sigma-algebras-and-events]].",
          "uses": ["1.1"]
        },
        {
          "fact": "F4",
          "source": "def-p-value",
          "source_section": "Definition",
          "quote": "A **p-value statistic** is a statistic $p:\\mathcal X\\to[0,1]$",
          "uses": ["1.1"]
        },
        {
          "fact": "F5",
          "source": "thm-benjamini-hochberg-independent-fdr",
          "source_section": "Statement",
          "quote": "For every $q\\in(0,1)$, the BH rule in [[alg-benjamini-hochberg-step-up-procedure]] satisfies $$\\operatorname{FDR}_\\theta=\\frac{m_0(\\theta)}{m}q\\le q.$$",
          "uses": ["2.1"]
        }
      ],
      "derivations": [
        {
          "id": "two-test-rejection-count",
          "claim": "The first rank always passes and the second passes exactly when P_1<=1/2, giving two rejections in the first event and one false rejection otherwise.",
          "step": "1.1",
          "inputs": ["given", "A1", "F2", "F3", "F4"]
        },
        {
          "id": "fdr-fwer-calculation",
          "claim": "The two cases give FDP 1/2 or zero, hence FDR=1/4 and FWER=1/2; the theorem bound is attained.",
          "step": "2.1",
          "inputs": ["given", "A1", "F1", "F5", "step 1.1"]
        },
        {
          "id": "global-null-identity",
          "claim": "When all hypotheses are true, V=R and the FDP is the indicator of at least one rejection, so FDR=FWER.",
          "step": "3.1",
          "inputs": ["A2", "F1"]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {"case": "empty", "status": "checked", "evidence": "The global-null comparison in step 3.1 includes R=0, where the defined FDP and the at-least-one-rejection indicator both vanish."},
        {"case": "zero", "status": "checked", "evidence": "The false-null p-value is the degenerate value zero; step 1.1 handles its first-rank rejection."},
        {"case": "one", "status": "checked", "evidence": "The example has exactly one true null, and step 2.1 computes its contribution to FDP."},
        {"case": "degenerate", "status": "checked", "evidence": "P_2 is constant at zero; the rank calculation in step 1.1 remains valid, including the probability-zero tie P_1=0."},
        {"case": "endpoints", "status": "checked", "evidence": "q=1/2 is interior; P_1=0 and P_1=1 are included in the uniform model, and the rejection cases in step 1.1 use the closed threshold."},
        {"case": "nonempty-choice", "status": "checked", "evidence": "The model fixes two named hypotheses, one uniform random variable, and one constant p-value; all calculations are explicit in steps 1.1 and 2.1."},
        {"case": "iff-forward", "status": "not_applicable", "reason": "The example compares two error rates and does not state an equivalence."},
        {"case": "iff-reverse", "status": "not_applicable", "reason": "The example compares two error rates and does not state an equivalence."}
      ],
      "finite_checks": []
    }
  }
}
