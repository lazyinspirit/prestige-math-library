    "thm-chebyshev-lobatto-interpolation-near-best-weighted-error": {
      "citations": [
        {
          "fact": "F1",
          "source": "thm-chebyshev-interpolation-near-best-error-bound",
          "source_section": "Statement",
          "quote": "For either Chebyshev node family, every $n\\geq0$, and every\n$f\\in C[-1,1]$,\n$$\\|f-I_n^\\sigma f\\|_\\infty \\leq (1+\\Lambda_n^\\sigma)E_n(f).$$\nHere $E_n$ is the best degree-$n$ uniform error and $\\Lambda_n^\\sigma$\nis the operator norm defined in\n[[def-best-uniform-polynomial-approximation-error-and-chebyshev-interpolants]].",
          "uses": [
            "2.1"
          ]
        },
        {
          "fact": "F2",
          "source": "def-chebyshev-arcsine-weighted-l2-pairing",
          "source_section": "Definition",
          "quote": "For continuous real functions $f,g$ on $[-1,1]$, define\n$$\n\\langle f,g\\rangle_C:=\\int_0^\\pi f(\\cos\\theta)g(\\cos\\theta)\\,d\\theta,\\qquad \\|f\\|_C^2:=\\langle f,f\\rangle_C.\n$$\nThis is the arcsine-weighted pairing on the compact Chebyshev interval: in the variable $x=\\cos\\theta$ its weight is $\\omega_C(x)=(1-x^2)^{-1/2}$ for $-1<x<1$. The angular integral is the endpoint convention, so no endpoint value of the singular density is required.",
          "uses": [
            "1.1"
          ]
        }
      ],
      "derivations": [
        {
          "id": "step-1-1",
          "claim": "For every $\\theta\\in[0,\\pi]$, $|h(\\cos\\theta)|\\le\\|h\\|_\\infty$. Integrating its square in [F2] gives $\\|h\\|_C^2\\le\\pi\\|h\\|_\\infty^2$ and hence $\\|h\\|_C\\le\\sqrt{\\pi}\\|h\\|_\\infty$.",
          "step": "1.1",
          "inputs": [
            "given",
            "F2",
            "algebra"
          ]
        },
        {
          "id": "step-2-1",
          "claim": "Apply step 1.1 to $h=f-I_N^Lf$, then use the uniform near-best bound [F1]. The result is $\\|f-I_N^Lf\\|_C\\le\\sqrt{\\pi}(1+\\Lambda_N^L)E_N(f)$.",
          "step": "2.1",
          "inputs": [
            "given",
            "F1",
            "step 1.1",
            "algebra"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "thm-chebyshev-lobatto-interpolation-near-best-weighted-error has no empty-set or empty-interval branch beyond its explicit hypotheses."
        },
        {
          "case": "zero",
          "status": "checked",
          "evidence": "Statement includes a zero mode/index, handled in step 1.1."
