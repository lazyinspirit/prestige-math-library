      "finite_checks": [
        {
          "id": "four-point-even-grid-nyquist-check",
          "claim": "The N=4 interpolant p=1+2cos(x)+3sin(x)-4cos(2x) has samples (-1,8,-5,2), and D4 returns (3,-2,-3,2).",
