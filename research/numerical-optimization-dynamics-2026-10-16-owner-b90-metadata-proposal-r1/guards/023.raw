    "thm-chebyshev-dirichlet-collocation-status-and-system": {
      "citations": [
        {
          "fact": "F1",
          "source": "alg-chebyshev-dirichlet-bvp-collocation-boundary-elimination",
          "source_section": "Definition",
          "quote": "Input an integer $N\\ge2$, real functions $a,b,f$ given at the Chebyshev–Gauss–Lobatto nodes $x_j=\\cos(j\\pi/N)$, and endpoint data $g_-,g_+\\in\\mathbb R$. The continuous BVP being discretized is\n$$\n-u''(x)+a(x)u'(x)+b(x)u(x)=f(x),\\quad -1<x<1,\\qquad u(-1)=g_-,\\quad u(1)=g_+.\n$$\nThe finite algorithm uses only the values at the nodes and does not assume a continuous BVP solvability theorem. Construct the Chebyshev differentiation matrix $D_N$ by [[alg-chebyshev-gauss-lobatto-differentiation-matrix]] and set $D_N^{(2)}=D_ND_N$. For each interior row $i=1,\\ldots,N-1$ and each column $j=0,\\ldots,N$, put\n$$\nC_{ij}=-(D_N^{(2)})_{ij}+a(x_i)(D_N)_{ij}+b(x_i)\\delta_{ij}.\n$$\nLet $A=(C_{ij})_{1\\le i,j\\le N-1}$ and $r_i=f(x_i)-C_{i0}g_+-C_{iN}g_-$. If $A$ is singular, return status singular-interior-matrix and the matrix $A$. If $A$ is invertible, solve $AU_I=r$, set $U_0=g_+$ and $U_N=g_-$, and return success with $U=(U_0,U_1,\\ldots,U_N)$. This exact-arithmetic finite solve asserts no unconditional nonsingularity, stability, convergence, or PDE error bound.",
          "uses": [
            "1.1",
            "2.1",
            "2.2"
          ]
        },
        {
          "fact": "F2",
          "source": "thm-chebyshev-gauss-lobatto-differentiation-is-exact",
          "source_section": "Statement",
          "quote": "Let $N\\ge1$, let $U_j\\in\\mathbb R$ be data on the nodes $x_j=\\cos(j\\pi/N)$, and let $p$ be the unique polynomial of degree at most $N$ with $p(x_j)=U_j$. The matrix [[alg-chebyshev-gauss-lobatto-differentiation-matrix]] satisfies\n$$\n(D_NU)_i=p'(x_i),\\qquad 0\\le i\\le N.\n$$\nIn particular, applying $D_N$ twice gives $p''(x_i)$ at each node.",
          "uses": [
            "1.2"
          ]
        },
        {
          "fact": "F3",
          "source": "thm-invertible-matrix-theorem",
          "source_section": "Statement",
          "quote": "For $A\\in M_n(F)$, the following are equivalent:\n\n1. $A$ is invertible;\n2. $x\\mapsto Ax$ is a linear isomorphism;\n3. $N(A)=\\{0\\}$;\n4. $\\operatorname{rank}(A)=n$;\n5. $A$ has a pivot in every row and every column;\n6. the RREF of $A$ is $I_n$;\n7. for every $b\\in F^n$, the equation $Ax=b$ has exactly one solution.",
          "uses": [
            "2.2"
          ]
        }
      ],
      "derivations": [
        {
          "id": "step-1-1",
          "claim": "On a success branch the algorithm sets $U_0=g_+$ and $U_N=g_-$ and solves $AU_I=r$ for the interior vector $U_I=(U_1,\\ldots,U_{N-1})$.",
          "step": "1.1",
          "inputs": [
            "given",
            "F1"
          ]
        },
        {
          "id": "step-1-2",
          "claim": "By [F2], $D_NU$ and $D_N^{(2)}U$ are respectively the first and second derivatives of the degree-at-most-$N$ nodal interpolant evaluated at the nodes.",
          "step": "1.2",
          "inputs": [
            "given",
            "F2"
          ]
        },
        {
          "id": "step-2-1",
          "claim": "Expanding the $i$th row of the full expression using [F1] gives $\\sum_{j=1}^{N-1}C_{ij}U_j+C_{i0}g_++C_{iN}g_-=f(x_i),$ which is exactly the reduced equation $AU_I=r$ with the definition of $r_i$. Combined with step 1.2, this is the stated collocation equation at every interior node.",
          "step": "2.1",
          "inputs": [
            "given",
            "F1",
            "step 1.1",
            "step 1.2",
            "algebra"
          ]
        },
        {
          "id": "step-2-2",
          "claim": "Since the success branch has invertible $A$, [F3] gives exactly one interior vector solving $AU_I=r$. The prescribed endpoint values then give exactly one full nodal vector. The singular branch returns its declared status and asserts nothing about solvability of its right-hand side.",
          "step": "2.2",
          "inputs": [
            "given",
            "F1",
            "F3",
            "step 1.1",
            "algebra"
          ]
        },
        {
          "id": "step-3-1",
          "claim": "Steps 1.1–2.2 prove the success claim and the stated singular-matrix limit.",
          "step": "3.1",
          "inputs": [
            "step 1.1",
            "step 1.2",
            "step 2.1",
            "step 2.2"
          ]
        }
      ],
      "routine_steps": [],
      "boundaries": [
        {
          "case": "empty",
          "status": "not_applicable",
          "reason": "thm-chebyshev-dirichlet-collocation-status-and-system has no empty-set or empty-interval branch beyond its explicit hypotheses."
        },
        {
          "case": "zero",
          "status": "not_applicable",
          "reason": "thm-chebyshev-dirichlet-collocation-status-and-system excludes a zero size/degree by its stated lower bound, or has no zero parameter."
        },
        {
          "case": "one",
          "status": "not_applicable",
          "reason": "thm-chebyshev-dirichlet-collocation-status-and-system has no separate one-size regime beyond the stated parameter range."
        },
        {
          "case": "degenerate",
          "status": "not_applicable",
          "reason": "thm-chebyshev-dirichlet-collocation-status-and-system has no additional degenerate interval or collapsed-grid branch beyond its stated hypotheses."
        },
        {
          "case": "endpoints",
          "status": "checked",
          "evidence": "Statement and step 3.1 include the stated interval or grid endpoints."
        },
        {
          "case": "nonempty-choice",
          "status": "checked",
          "evidence": "Statement and steps 1.1 and 3.1 use explicit finite data or theorem-provided witnesses; the axiom_use field records the applicable choice branch."
        },
        {
          "case": "iff-forward",
          "status": "not_applicable",
          "reason": "thm-chebyshev-dirichlet-collocation-status-and-system states a one-way estimate, identity, exactness claim or worked computation, not an iff."
