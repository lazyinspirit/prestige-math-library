  "all_initial_findings_resolved": [
    {
      "id": "R1-PL-prism-product",
      "status": "resolved",
      "independent_reason": "Finite PL base-skeleton construction matches fiber endpoint maps on rectangles and triangle prisms; coning corresponding boundary fans with equal base coordinates preserves projection on every simplex. Deck-equivariant cell choices descend the middle section and give the required PL product or one-sided PL core."
    },
    {
      "id": "R1-empty-ball-remainder",
      "status": "resolved",
      "independent_reason": "Punctured closed positive-genus remainders contain loops essential in the original surface; boundary-disk cutoff remainders retain the original fundamental group. Injection excludes these remainders and all other nondisk/nonsphere components from the surgery ball, validating the empty-ball isotopies."
    },
    {
      "id": "R1-hierarchy-family-transfer",
      "status": "resolved",
      "independent_reason": "The entire subfamily V contained in P is used. All outside components miss P and the relevant F boundary arc, so a boundary-compression disk disjoint from V would be disjoint from the whole S1. The simultaneous product classification now applies without a componentwise assumption."
    },
    {
      "id": "R1-joint-PL-cutoff",
      "status": "resolved",
      "independent_reason": "The cutoff min(s,lambda(r)) is jointly PL after a finite parameter-square subdivision. Its composition with the supplied jointly PL face isotopy is PL, including the level-preserving inverse."
    },
    {
      "id": "R1-relative-annulus-end-charts",
      "status": "resolved",
      "independent_reason": "A finite link-disk construction supplies the S-compatible boundary collar. The inward graph-prism embedding moves inner boundary contacts into intS while preserving core classes. A sufficiently low collar-height level is one circle by the finite zero-boundary fans; its projection is embedded at that single height and misses \u2202S. Truncation plus vertical annulus gives a neat outer end. Proper-arc hemisphere/half-link disk parameters then give actual relative product charts before the collar theorem is invoked."
    }
  ],
